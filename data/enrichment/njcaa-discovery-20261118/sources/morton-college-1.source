    <script>
        window.show_section = function (element, args) {
            function show(id) {
                document.getElementById(id).style.removeProperty('display');
                element.remove();
            };

            var component = args.component;
            var section = args.extra().show_section;

            if (component && component.type === 'content-stream') {
                var stream = args.data();

                if (!stream || !stream.length) {
                    return;
                }

                stream = stream.filter(function (item) {
                    if (item.type === 'tweet' || item.type === 'facebook' || item.type === 'instagram') {
                        return true;
                    }
                });

                if (!stream.length) {
                    return;
                }
            }

            if (Array.isArray(section)) {
                for (i = 0; i < section.length; i++) {
                    show(section[i]);
                }
            } else {
                show(section);
            };

            try {
                window.AOS.refreshHard();
            } catch(e) {

            }
            
            window.dispatchEvent(new Event('resize'));
        };

        require(['jquery'], function($){
            $('.s-stories').on('click', '.showcase-play-button', function (e) {
                console.log('clicked')
                $('.s-stories .c-stories__next').slick('slickPause');
            });
        });

        require(['jquery', 'knockout', 'https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js', 'headroom', 'jquery-headroom', 'jquery-ui'], function ($, ko, AOS) {
            $(function () {
                $('.tabs').tabs();

                var checkBindingsInterval = setInterval(function(){
                    if(!!ko.dataFor($('body')[0])) {
                        clearInterval(checkBindingsInterval);
                        setTimeout(function(){
                            window.AOS = AOS;
                            window.AOS.init();
                            var docHeight = $(document).height();
                            setInterval(function() {
                                var docHeightTemp = $(document).height();

                                if (docHeight !== docHeightTemp) {
                                    docHeight = docHeightTemp;
                                    window.AOS.refresh();
                                };
                            }, 250);
                        }, 1000);
                    }
                }, 100);

                var video_check_interval_timeout = 0;
                var video_check_interval = setInterval(function () {
                    var $player = $('.c-videos__player'),
                        $container = $('.c-videos__selected');
                    if ($player.length) {
                        clearInterval(video_check_interval);

                        $(window).resize(function () {
                            var main_nav_height = $('main-navigation').outerHeight();

                            $(window).scroll(function () {
                                var container_height = $container.height(),
                                    container_offset = $container[0].getBoundingClientRect(),
                                    viewport_height = document.documentElement.clientHeight;

                                if ((container_offset.top - viewport_height) > 0) {
                                    $container.addClass('should-pin');
                                }
                                else if ( (container_offset.top * -1) > (container_height + main_nav_height) ) {
                                    $container.addClass('should-pin')
                                }
                                else {
                                    $container.removeClass('should-pin');
                                }

                            }).trigger('scroll');
                        }).trigger('resize');
                    }
                    else {
                        video_check_interval_timeout++;
                    }

                    if (video_check_interval_timeout > 200) {
                        clearInterval(video_check_interval);
                    }
                }, 100);
            });
        });
    </script>

