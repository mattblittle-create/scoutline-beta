cademic-honors.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":11,"locked_ranking":false,"id":556,"content_id":"556","content_title":"Ten Queensborough Winter/Spring Sport Athletes Receive CUNY All-Academic Honors","content_date":"2025-07-02T16:49:00","content_url":"https://qcctigers.com/news/2025/7/2/baseball-ten-queensborough-winter-spring-sport-athletes-receive-cuny-all-academic-honors.aspx","content_image_url":"https://qcctigers.com/images/2025/11/21/new_8550360.png","date":"2025-07-02T16:49:00"},{"title":"Sandberg Signs with Long Island Ducks, Records Win in Debut on Same Day","title_in_rotator":true,"sub_headline":null,"teaser":"Former Queensborough Community College All-American pitcher Ryan Sandberg has signed a professional contract with the Long Island Ducks organization of the Atlantic League of Professional Baseball (ALPB). Making his team debut on the same day that his signing was announced, Sandberg recorded a win in his one inning of shutout relief where he retired all three batters that he faced. Earlier this year, Sandberg spent time with the Milwaukee Brewers organization in Spring Training, making one appearance in a Spring Training game before being released.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"BB","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2025/6/18/mlb_7446180.png","image_focal_point":null,"image_alt_text":"LID","video":null,"url":"/news/2025/5/27/baseball-sandberg-signs-with-long-island-ducks-records-win-in-debut-hours-later.aspx","redirec