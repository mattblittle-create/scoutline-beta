                        <img class="main-logo" data-bind="attr: {src: $component.bucket + '/images/responsive_2023/logo-primary.png'}" alt="">
                        <img class="secondary-logo" data-bind="attr: {src: $component.bucket + '/images/responsive_2023/logo-secondary.png'}" alt="">
                    </a>
                </div>
                <div class="c-navigation__container left c2 flex flex-align-center flex-justify-end">
                    <ul class="c-navigation__level-1 flex flex-align-center flex-justify-between w-100" data-bind="fastForEach: data">
                        <!-- ko if: $index() > 2 -->
                        <li data-bind="
                        attr: { 
                            'class': ko.computed(function() { return class_name ? class_name + ' c-navigation__item c-navigation__item--level-1': 'c-navigation__item c-navigation__item--level-1' })
                        },
                        css: {
                            'c-navigation__parent': items && items.length > 0
                        },
                        event: {
                            mouseover: function(data, event) {
                                let currentTarget = event.currentTarget;
