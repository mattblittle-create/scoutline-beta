}
.bcdrn2h0v-modal__browsers--text:last-child {
  padding-top: 4px;
}
.bcdrn2h0v-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
  display: block;
  padding: 0 16px;
