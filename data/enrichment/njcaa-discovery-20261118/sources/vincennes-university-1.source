	#chatTitle {
		opacity: 0;
		transform: translateY(10px);
		transition: opacity 0.5s ease, transform 0.5s ease;
		/* Styles to make it look like a speech bubble */
		background: #007bff;
		color: white;
		padding: 8px 12px;
		border-radius: 10px;
		position: fixed;
		bottom: 120px; /* Position it above the chat bubble */
		right: 20px;
		z-index: 999;
	}

	#chatTitle.is-visible {
		opacity: 1;
		transform: translateY(0);
	}


	#privacy-link {
		position: fixed;
		/* Position it exactly inside the chat window area */
		bottom: 124px; /* Adjust this to sit right above the text input */
		right: 35px;   /* Centers it slightly from the right edge */
		z-index: 1000; /* Must be higher than messenger */
		font-size: 10px important!;
		font-family: 'Google Sans', sans-serif;
		color: #003A5D;
		/*text-decoration: underline;
		background: rgba(255, 255, 255, 0.9);
		padding: 4px 8px;
		border-radius: 4px;
		border: 1px solid #E0E7ED;*/
		pointer-events: auto;
		display: none; /* Hidden by default 
		text-transform: capitalize !important;*/
	}
	#privacy-link a:visited{		
		color: #222 !important;		
	}
	/* Hide link when the chat is closed (Optional) */
	df-messenger:not([expanded="true"]) + #privacy-link {
		display: none;
	}
	:host(.border-top) .input-container {
		padding-bottom: 25px;
	}
</style><script>
      /**
       * This script waits for the messenger component to be fully loaded
       * before sending the 'Welcome_on_Open' intent signal to Dialogflow.
       */
      const messenger = document.querySelector('#blazer-bot');

      messenger.addEventListener('df-messenger-loaded', () => {
          // 1. Optional: Automatically expand the chat window 
          // messenger.expand(); 

          // 2. Trigger the intent via the event name we set in the console
          // Note: Ensure 'Welcome_on_Open' is added to the 'Events' section of your intent.
          messenger.triggerIntent('Welcome_on_Open');
          
          console.log("Chatbot loaded and Welcome Intent triggered.");
      });
	  
	 document.addEventListener('DOMContentLoaded', () => {
		const messenger2 = document.querySelector('df-messenger');
		const chattitle = document.getElementById('chatTitle');

		// Configurable timings
		const DELAY_SHOW_MS = 5000;
		const DELAY_HIDE_MS = 15000;

		let showTimerId;
		let hideTimerId;

		// Helper to hide the popup and clear all pending timers
		const killPopup = () => {
			if (chattitle) {
				chattitle.classList.remove('is-visible'); // Use a class for smooth fade-out
				setTimeout(() => { chattitle.style.display = 'none'; }, 500); // Remove from flow after fade
			}
			clearTimeout(showTimerId);
			clearTimeout(hideTimerId);
		};

		// Listen for messenger load to trigger welcome intent
		messenger2?.addEventListener('df-messenger-loaded', () => {
			// Note: use triggerIntent for cleaner logic than renderCustomText
			messenger.triggerIntent('Welcome_on_Open');
			console.log("VU Blazer Bot initialized.");
			// 2. Inject the Privacy Link into the Shadow DOM
			const shadow = messenger.shadowRoot;
			const chatWrapper = shadow.querySelector('.df-messenger-wrapper');
			const privacyLink = document.getElementById('privacy-link');

			if (chatWrapper && privacyLink) {
				// We move the link inside the bot's internal container
				chatWrapper.appendChild(privacyLink);
				privacyLink.style.display = 'block';
			}

			console.log("VU Blazer Bot initialized and Privacy Link injected.");
		});
		


		// Handle Open/Close state in one place
		window.addEventListener('df-chat-open-changed', (event) => {
			const isChatOpen = event.detail.isOpen;
			const privacyLink = document.getElementById('privacy-link');
			console.log(`Chat is ${isChatOpen ? 'open' : 'closed'}`);

			if (isChatOpen) {
					// Delay showing the link by 300ms to match the animation
				setTimeout(() => {
					if (privacyLink) privacyLink.style.display = 'block';
				}, 300);
			}
			else {
				// Optional: Hide the link again when the chat is minimized
				if (privacyLink) privacyLink.style.display = 'none';
			}
		
			// If they open the chat, they don't need the "Hey look at me" popup anymore
			killPopup();

			// Remember that they've interacted so we don't bug them again this session
			sessionStorage.setItem('bot_interacted', 'true');
		});

		// Initial Trigger Logic
		if (chattitle && !sessionStorage.getItem('bot_interacted')) {
			chattitle.style.display = 'none';

			showTimerId = setTimeout(() => {
				chattitle.style.display = 'inline-block';
				// Trigger a CSS animation
				setTimeout(() => chattitle.classList.add('is-visible'), 10);
			}, DELAY_SHOW_MS);

			hideTimerId = setTimeout(() => {
				killPopup();
			}, DELAY_HIDE_MS);
		}
	});
		
</script></p>
