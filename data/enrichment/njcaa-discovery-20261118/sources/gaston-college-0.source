(function () {
  var standaloneQuery = "(display-mode: standalone)";
  var devParam = "enablePwaNavigation";
  var devStorageKey = "vnn-ace:enable-pwa-navigation";
  var enableDevOverride = false;

  function getDevOverride() {
    if (!enableDevOverride) return false;

    try {
      var override = new URLSearchParams(window.location.search).get(devParam);

      if (override === "true") {
        window.localStorage.setItem(devStorageKey, "true");
        return true;
      }

      if (override === "false") {
        window.localStorage.removeItem(devStorageKey);
        return false;
      }

      return window.localStorage.getItem(devStorageKey) === "true";
    } catch (_error) {
      return false;
    }
  }

