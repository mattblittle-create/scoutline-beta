lege Athletics.","type":null,"byline":null,"app_exclusive":false,"sport_display":"General","sport":{"id":2,"title":"General","abbreviation":"GEN","shortname":"general","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"general","gender":"g","youtube":"PLBZXhBju0buvidMz_OuzuaMuuTf14enJg","facebook":"www.Facebook.com/MacombAthletics","twitter":"MacombMonarchs","instagram":"macombmonarchs","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2024/7/18/njcaa_academic_web_copy.jpg","image_focal_point":null,"image_alt_text":"2023-24 NJCAA Academic Awards","video":null,"url":"/news/2024/7/18/general-four-teams-30-student-athletes-earn-national-academic-recognition.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":47,"locked_ranking":false,"id":640,"content_id":"640","content_title":"Four Teams, 30 Student-Athletes Earn National Academic Recognition","content_date":"2024-07-18T13:55:00","content_url":"https://macombmonarchs.com/news/2024/7/18/general-four-teams-30-student-athletes-earn-national-academic-recognition.aspx","content_image_url":"https://macombmonarchs.com/images/2024/7/18/njcaa_academic_web_copy.jpg","date":"2024-07-18T13:55:00"},{"title":"Macomb Athletics Unveils New Logo and Brand Identity","title_in_rotator":true,"sub_headline":"Same Name. New Look. A New Era.","teaser":"<p class=\"MsoNormal\"><strong>WARREN, Mich. –</strong> Same name. New look. A new era.</p>\r\n","type":null,"byline":null,"app_exclusive":false,"sport_display":"General","sport":{"id":2,"title":"General","abbreviation":"GEN","shortname":"general","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"general","gender":"g","youtube":"PLBZXhBju0buvidMz_OuzuaMuuTf14enJg","facebook":"www.Facebook.