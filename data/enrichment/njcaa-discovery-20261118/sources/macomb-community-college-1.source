scontent-dfw5-1.xx&edm=AJdBtusEAAAA&_nc_gid=aYEGlhPr18jsPQheSWUeoQ&_nc_tpa=Q5bMBQINQzQh5lSJ4xLA-1F4iCB36tEFYXP5UVdeuCmadw69jd9v54YKWdciHCeqkycyzxDJ1Wlk&oh=00_AQRJA3zQO40muIXf6nnPnxUEmIVXyEJymcYmdBJn8H22QA&oe=6B0353C7","link":"https://www.facebook.com/236861683020804","category":"School Sports Team","website":"http://www.MacombMonarchs.com/","username":"MacombMonarchs","description":"","can_post":"","type":""}},"location_name":null},{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Macomb Announces Return of Open Track Nights; Expanded Offering Begins October 19","title_in_rotator":true,"sub_headline":"The Athletics & Expo Center will be host to 27 open track dates across the months of October, November, December, January, February and March.","teaser":"<strong>WARREN, Mich. –</strong> Macomb Community College Athletics is excited to announce the return of Open Track Nights at the Athletics & Expo Center! This year's Open Track slate offers 27 opportunities for the community to utilize the indoor track between the months of October and March. The announcement was made by head cross country and track & field coach, <dfn><a data-airgap-id=\"48\" href=\"https://macombmonarchs.com/sports/mens-cross-country/roster/coaches/matt-fecht/10\" rel=\"smarttag\" rev=\"10\">Matt Fecht</a></dfn>, on Friday (Oct. 16). High jump and pole vault pits are not available until mid-November as we continue to transition back into the building. Open Track Nights will run from 6:30 p.m. - 9:30 p.m. on the dates listed below, unless otherwise noted.","type":null,"byline":null,"app_exclusive":false,"sport_display":"General, Men's Cross Country, Women's Cross Country, Women's Track & Field, Men's Track & Field","sport":{"id":4,"title":"Men's Cross Country","abbreviation":"MXC","shortname":"mcross","short_title":"Men's XC","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"mcross","gender":"m","youtube":"PLBZXhBju0buvidMz_OuzuaMuuTf14enJg","face