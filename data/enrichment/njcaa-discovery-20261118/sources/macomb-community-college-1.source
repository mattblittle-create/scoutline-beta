<script>
    var obj = {"start":0,"count":1,"name":"top-stories-primary","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{"sports":[{"id":1,"title":"Baseball"},{"id":2,"title":"General"},{"id":3,"title":"Men's Basketball"},{"id":4,"title":"Men's Cross Country"},{"id":12,"title":"Men's Track & Field"},{"id":5,"title":"Softball"},{"id":6,"title":"Women's Basketball"},{"id":7,"title":"Women's Cross Country"},{"id":11,"title":"Women's Track & Field"},{"id":8,"title":"Women's Volleyball"},{"id":10,"title":"Wrestling"}]},"context":null,"dummy":false,"type":"stories","id":"0ca9e1c9-07b2-4190-b8b4-426bc7773bce","data":[{"title":"Macomb Announces Return of Open Track Nights; Expanded Offering Begins October 19","title_in_rotator":true,"sub_headline":"The Athletics & Expo Center will be host to 27 open track dates across the months of October, November, December, January, February and March.","teaser":"<strong>WARREN, Mich. –</strong> Macomb Community College Athletics is excited to announce the return of Open Track Nights at the Athletics & Expo Center! This year's Open Track slate offers 27 opportunities for the community to utilize the indoor track between the months of October and March. The announcement was made by head cross country and track & field coach, <dfn><a data-airgap-id=\"48\" href=\"https://macombmonarchs.com/sports/mens-cross-country/roster/coaches/matt-fecht/10\" rel=\"smarttag\" rev=\"10\">Matt Fecht</a></dfn>, on Friday (Oct. 16). High jump and pole vault pits are not available until mid-November as we continue to transition back into the building. Open Track Nights will run from 6:30 p.m. - 9:30 p.m. on the dates listed below, unless otherwise noted.","type":null,"byline":null,"app_exclusive":false,"sport_display":"General, Men's Cross Country, Women's Cross Country, Women's Track & Field, Men's Track & Field","sport":{"id":4,"title":"Men's Cross Country","abbreviation":"MXC","shortname":"mcross","short_title":"Men's XC","global_spo