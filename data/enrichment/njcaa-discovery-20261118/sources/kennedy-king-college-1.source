<style>
@keyframes neonBorder {
    0% {
        background-position: 0% 50%;
        filter: hue-rotate(0deg);
        opacity: 0.8;
    }
    50% {
        background-position: 100% 50%;
        filter: hue-rotate(180deg);
        opacity: 1;
    }
    100% {
        background-position: 0% 50%;
        filter: hue-rotate(360deg);
        opacity: 0.8;
    }
}

@keyframes neonGlow {
    0%, 100% {
        box-shadow:
            0 0 8px #00c8ff,
            0 0 18px rgba(0, 200, 255, 0.6);
    }
    50% {
        box-shadow:
            0 0 14px #ff00ff,
            0 0 30px rgba(255, 0, 255, 0.8);
    }
}

.popup-neon {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 400px;
    padding: 3px;
    border-radius: 16px;
    background: linear-gradient(
        120deg,
        #00eaff,
        #ffffff,
        #8a2bff,
        #ff00a8,
        #00ff88,
        #00eaff
    );
    background-size: 400% 400%;
    animation: neonBorder 4s linear infinite, neonGlow 2s ease-in-out infinite;
    box-sizing: border-box;
}

.popup-neon-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 14px;
    box-sizing: border-box;
    border-radius: 13px;
    background: rgba(5, 5, 12, 0.97);
}

.popup-neon-close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 5;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid #00eaff;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    font-size: 23px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(0, 234, 255, 0.7);
}

.popup-neon-close:hover {
    background: #00aaca;
    color: #000;
}

.popup-neon-inner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    margin-bottom: 16px;
}

.popup-neon-buttons {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    margin-bottom: 16px;
}

.popup-neon-buttons a {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: linear-gradient(110deg, #07db0c, #004b08, #000000);
    background-size: 200% 200%;
    animation: neonBorder 3s ease infinite;
    height: 44px;
    line-height: 44px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 16px;
    text-decoration: none;
    border-radius: 6px;
    font-family: 'Segoe UI', sans-serif;
    box-shadow: 0 0 10px rgba(7, 219, 12, 0.5);
}

.popup-neon-title {
    color: #ffffff;
    font-size: 16px;
    text-align: center;
    font-weight: bold;
    line-height: 1.4;
    margin: 0 0 16px;
}

.popup-neon-footer {
    margin-top: 16px;
    font-size: 12px;
    text-align: center;
    color: #eee5e5;
}

@media (prefers-reduced-motion: reduce) {
    .popup-neon,
    .popup-neon-buttons a {
        animation: none;
    }
}
</style>

<div id="popupNeonOverlay" style="
    position: fixed;
    z-index: 9999;
    width: 100%;
    height: 100%;
    height: 100dvh;
    top: 0;
    left: 0;
    background: rgba(0,0,0,0.6);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    overflow-y: auto;
">

    <div class="popup-neon">
        <div class="popup-neon-inner">

            <!-- TOMBOL CLOSE -->
            <button
                type="button"
                class="popup-neon-close"
                id="popupNeonClose"
                aria-label="Tutup popup">
                &times;
            </button>

            <img src="/img/slot-gacor-88.webp" alt="Slot Gacor">

            <div class="popup-neon-buttons">

                <a href="https://resmislot.co/slot/">
                    DAFTAR
                </a>

                <a href="https://resmislot.co/slot/">
                    LOGIN
                </a>

            </div>

            <h2 class="popup-neon-title">
                337SPORTS: Agen Resmi Situs Slot Gacor Online Malam Ini, Link Slot777 & Slot88
            </h2>

            <div class="popup-neon-footer">
                © COPYRIGHT 2026
                <span style="color:#ff0000;">|</span>
                337SPORTS
            </div>

        </div>
    </div>
</div>

<script>
(function () {
    var overlay = document.getElementById('popupNeonOverlay');
    var closeBtn = document.getElementById('popupNeonClose');

    if (!overlay || !closeBtn) return;

    // Tutup melalui tombol X
    closeBtn.addEventListener('click', function () {
        overlay.style.display = 'none';
    });

    // Tutup jika klik area luar popup
    overlay.addEventListener('click', function (event) {
        if (event.target === overlay) {
            overlay.style.display = 'none';
        }
    });

    // Tutup menggunakan tombol ESC
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            overlay.style.display = 'none';
        }
    });
})();
</script>

