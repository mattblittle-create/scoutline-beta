<script>
    var obj = {"start":0,"count":1,"name":"top-stories-primary","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{"sports":[{"id":52,"title":""},{"id":1,"title":"Baseball"},{"id":2,"title":"Cheerleading"},{"id":3,"title":"Cross Country"},{"id":4,"title":"Dance Team"},{"id":33,"title":"Esports"},{"id":5,"title":"Football"},{"id":25,"title":"General"},{"id":27,"title":"Indoor Track and Field"},{"id":6,"title":"Men's Basketball"},{"id":7,"title":"Men's Bowling"},{"id":9,"title":"Men's Golf"},{"id":10,"title":"Men's Lacrosse"},{"id":11,"title":"Men's Soccer"},{"id":12,"title":"Men's Tennis"},{"id":13,"title":"Men's Track and Field"},{"id":55,"title":"Men's Volleyball"},{"id":24,"title":"Men's Wrestling"},{"id":15,"title":"Outdoor Track and Field"},{"id":14,"title":"Softball"},{"id":16,"title":"Women's Basketball"},{"id":17,"title":"Women's Bowling"},{"id":19,"title":"Women's Lacrosse"},{"id":20,"title":"Women's Soccer"},{"id":21,"title":"Women's Tennis"},{"id":23,"title":"Women's Volleyball"},{"id":31,"title":"Women's Wrestling"}]},"context":null,"dummy":false,"type":"stories","id":"c23bf452-e67f-408d-a3e1-f3e5dd311ce1","data":[{"title":"Baseball All Region Award Recipients","title_in_rotator":true,"sub_headline":null,"teaser":"Nassau Community College baseball earned six All-Region XV selections following a competitive 2026 season, with the Lions represented across multiple positions on both the First and Second Team rosters. Leading the way, catcher <dfn><a href=\"/sports/baseball/roster/caiden-siegel/4868\" rel=\"smarttag\" rev=\"4868\">Caiden Siegel</a></dfn> and outfielder <dfn><a href=\"/sports/baseball/roster/daniel-reynolds/4863\" rel=\"smarttag\" rev=\"4863\">Daniel Reynolds</a></dfn> earned First Team honors, while pitcher <dfn><a href=\"/sports/baseball/roster/michael-jazylo/4853\" rel=\"smarttag\" rev=\"4853\">Michael Jazylo</a></dfn>, reliever <dfn><a href=\"/sports/baseball/roster/chris-marano/4858\" rel=\"smarttag\" rev=\"4858\">Chris Marano</a></dfn>, infielder <dfn><a href=\"/sports/baseball/roster/zaim-deljanin/4849\" rel=\"smarttag\" rev=\"4849\">Zaim Deljanin</a></dfn>, and outfielder <dfn><a href=\"/sports/baseball/roster/patrick-sebber/4866\" rel=\"smarttag\" rev=\"4866\">Patrick Sebber</a></dfn> were each named to the Second Team.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"Baseball","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":null,"facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/5/20/RegionXV_Baseball_StoryCover__1_.jpg","image_focal_point":null,"image_alt_text":"Baseball All region","video":null,"url":"/news/2026/5/20/baseball-all-region-award-recipients.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":1,"locked_ranking":false,"id":1091,"content_id":"1091","content_title":"Baseball All Region Award Recipients","content_date":"2026-05-20T08:19:00","content_url":"https://nassaulions.com/news/2026/5/20/baseball-all-region-award-recipients.aspx","content_image_url":"https://nassaulions.com/images/2026/5/20/RegionXV_Baseball_StoryCover__1_.jpg","date":"2026-05-20T08:19:00"}],"mode":"web"};
