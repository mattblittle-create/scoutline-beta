										            { 'breakpoint': 540, 'image': images.large.url + '?width=768&height=432&mode=crop&scale=both&anchor=topcenter&format=jpg&quality=80' },
										            { 'breakpoint': 0, 'image': images.large.url + '?width=540&height=304&mode=crop&scale=both&anchor=topcenter&format=jpg&quality=80' }
									            ]}, alt: title">
                        </picture>
                    </div>
