                            <!-- <div class="c-videos__divider"></div> -->
                            <div class="c-videos__date" data-bind="formatDate:date, format:'MMMM D, YYYY'"></div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
        
    </div>
    <!-- /ko -->
<!-- /ko -->

<!-- /ko -->
<!-- /ko --></script><script type='text/html' id='template-galleries'><!-- ko if: !data().length -->
