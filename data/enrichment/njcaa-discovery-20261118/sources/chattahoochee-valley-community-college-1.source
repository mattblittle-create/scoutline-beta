    </script>

    <script type="text/javascript">
        // Can also be used with $(document).ready()
        $(window).load(function () {
            $('#flexslider-v3').flexslider({
                animation: "slide",
                animationSpeed: 300,
                slideshow: true,
                controlsContainer: $(".custom-controls-container"),
                customDirectionNav: $(".custom-navigation a"),
