<script>
(function () {
  'use strict';

  /**
   * Fix reCAPTCHA iframe accessibility issue
   * Removes role="presentation" when title="reCAPTCHA"
   */
  function fixRecaptchaIframe() {
    const iframes = document.querySelectorAll(
      'iframe[title="reCAPTCHA"][role="presentation"]'
    );

    iframes.forEach((iframe) => {
      iframe.removeAttribute('role');
    });
  }

  /**
   * Run fix when DOM is ready
   */
  function initFix() {
    fixRecaptchaIframe();

    // Observe DOM changes (for dynamically injected reCAPTCHA)
    const observer = new MutationObserver((mutations) => {
      let shouldRun = false;

      for (const mutation of mutations) {
        if (mutation.addedNodes.length > 0) {
          shouldRun = true;
          break;
        }
      }

      if (shouldRun) {
        fixRecaptchaIframe();
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    // Optional: stop observing after some time (performance safety)
    setTimeout(() => {
      observer.disconnect();
    }, 30000); // 30 seconds
  }

  /**
   * Ensure script runs after DOM is loaded
   */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFix);
  } else {
    initFix();
  }
})();
</script>

