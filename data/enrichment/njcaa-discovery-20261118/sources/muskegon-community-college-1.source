<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".advgb-tab-body").forEach(function(el) {

    // Fix ARIA issue
    el.setAttribute("role", "tabpanel");

    // Make focusable
    el.setAttribute("tabindex", "0");

    // Ensure it is treated as scrollable by Lighthouse
    const style = window.getComputedStyle(el);
    if (style.overflow === "visible") {
      el.style.overflow = "auto";
    }

  });
});
</script>

<script>
jQuery(document).ready(function ($) {

  var mobileMq = window.matchMedia('(max-width: 768px)');
  var lightboxStyleId = 'mcc-mobile-lightbox-styles';

  function injectLightboxStyles() {
    if (document.getElementById(lightboxStyleId)) {
      return;
    }

    var css =
      '#mcc-mobile-lightbox.custom-lightbox{' +
        'position:fixed;top:0;left:0;width:100%;height:100%;z-index:999999;' +
        'display:grid;place-items:center;' +
        'padding:0.75rem;box-sizing:border-box;margin:0;border:0;' +
        'background:rgba(0,0,0,0.92);overflow:hidden;' +
        'touch-action:none;overscroll-behavior:contain;' +
        '-webkit-tap-highlight-color:transparent;' +
      '}' +
      '#mcc-mobile-lightbox.custom-lightbox .custom-lightbox-content{' +
        'display:flex;align-items:center;justify-content:center;' +
        'width:100%;height:100%;max-width:100%;max-height:100%;' +
        'margin:0;padding:0;border:0;line-height:0;text-align:center;' +
      '}' +
      '#mcc-mobile-lightbox.custom-lightbox .custom-lightbox-image{' +
        'display:block;box-sizing:border-box;width:auto;height:auto;' +
        'max-width:100%;max-height:100%;margin:0 auto;padding:0;border:0;' +
        'object-fit:contain;object-position:center center;' +
      '}';

    var style = document.getElementById(lightboxStyleId);
    if (style) {
      style.textContent = css;
      return;
    }

    style = document.createElement('style');
    style.id = lightboxStyleId;
    style.type = 'text/css';
    style.appendChild(document.createTextNode(css));
    document.head.appendChild(style);
  }

  function getDisplayImageUrl($img) {
    return $img.attr('src') || $img.attr('data-src') || ($img[0] && $img[0].currentSrc) || '';
  }

  function unwrapTriggers() {
    $('a.lightbox-trigger').each(function () {
      $(this).replaceWith($(this).contents());
    });
  }

  function closeLightbox() {
    $('#mcc-mobile-lightbox').remove();
    $(document).off('touchmove.mccLightbox');
  }

  function openLightbox(imageUrl, altText, fallbackUrl) {
    if (!imageUrl) {
      return;
    }

    injectLightboxStyles();
    closeLightbox();

    var safeUrl = imageUrl.replace(/"/g, '&quot;');
    var safeAlt = (altText || '').replace(/"/g, '&quot;');
    var safeFallback = (fallbackUrl || '').replace(/"/g, '&quot;');

    var $lightbox = $(
      '<div id="mcc-mobile-lightbox" class="custom-lightbox" role="dialog" aria-modal="true">' +
        '<div class="custom-lightbox-content">' +
          '<img class="custom-lightbox-image" src="' + safeUrl + '" alt="' + safeAlt + '">' +
        '</div>' +
      '</div>'
    );

    $('body').append($lightbox);

    $(document).on('touchmove.mccLightbox', function (e) {
      if ($(e.target).closest('#mcc-mobile-lightbox').length) {
        e.preventDefault();
      }
    });

    var $overlayImg = $lightbox.find('img');

    if (safeFallback) {
      $overlayImg.on('error', function () {
        $(this).off('error').attr('src', safeFallback);
      });
    }
  }

  if (mobileMq.addEventListener) {
    mobileMq.addEventListener('change', function () {
      if (!mobileMq.matches) {
        unwrapTriggers();
        closeLightbox();
      }
    });
  }

  $(document).on('click', 'figure.lightbox-img img, .lightbox-img img', function (e) {
    if (!mobileMq.matches) {
      return;
    }

    e.preventDefault();
    e.stopPropagation();

    var $img = $(this);
    var imageUrl = getDisplayImageUrl($img);
    var altText = $img.attr('alt') || '';

    if (!imageUrl) {
      return;
    }

    setTimeout(function () {
      openLightbox(imageUrl, altText, imageUrl);
    }, 0);
  });

  $(document).on('click', '#mcc-mobile-lightbox', function (e) {
    e.preventDefault();
    closeLightbox();
  });

  unwrapTriggers();
});
</script>


