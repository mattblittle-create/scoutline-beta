}

/* new */
.filter-list {
  display: flex;
  flex-wrap: wrap;
  flex-direction: column;
  margin-bottom: 50px;
  padding: 0px;
}
.filter-list .list-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 100%;
  border-top: 1px solid rgba(0, 0, 0, 0.2);
  padding: 5px 0px 5px 0px;
  gap:10px;
}
.filter-list .image {
  width: 45px !important;
  margin-left: 0 !important;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 10px;
}
.filter-list .image img {
  width: 45px;
  height: 45px;
  flex-shrink: 0;
  object-fit: cover;
}
.filter-list a{
  color: #000000;
  text-decoration: underline;
  font-weight: 400;
}
.filter-list a:hover{
  text-decoration: none;
}
.filter-list .email a svg{
  fill: #000000;
  height: 16px;
  width: 16px;
}
.filter-list .name {
    width: 20%;
}
.filter-list .role {
  width: 20%;
}
.filter-list .role span {
  padding-right: 5px;
}
.filter-list .department {
  width: 30%;
}
.filter-list .department span {
  padding-right: 5px;
}
.filter-list .email {
  width: 7%;
}
.filter-list .phone {
  width: 15%;
}
.filter-list .room {
  width: 5%;
}

.filter-list .phone svg {
  height: 16px;
  width: 16px;
  fill: #000000;
}

.faculty-header {
  display: flex;
  padding: 0 !important;
  gap:10px;
}

.faculty-header .image {
  width: 45px;
  font-weight: bold;
  margin-right: 10px;
}
.faculty-header .name {
  width: 20%;
  font-weight: bold;
}
.faculty-header .role {
  width: 20%;
  font-weight: bold;
}
.faculty-header .department {
  width: 30%;
  font-weight: bold;
}
.faculty-header .email {
  width: 7%;
  font-weight: bold;
}
.faculty-header .phone {
  width: 15%;
  font-weight: bold;
}
.faculty-header .room {
  width: 5%;
  font-weight: bold;
}

.faculty-detail{display:flex;}
.faculty-detail .overview{margin-top:20px;}
.faculty-detail .image{margin-right:5%;width:20%;}
.faculty-detail .faculty-Details{width:75%;}
.faculty-detail .label{font-weight:bold;}

.faculty-detail .detail-image {
  margin-right: 5%;
  width: 30%;
}

.faculty-detail .faculty-details {
  width: 100%;
}

.faculty-detail a {
  text-decoration: underline;
  color: #03246A;
  padding-left: 5px;
}


@media (max-width: 1200px) {
  .faculty-header {
    display: none;
  }
  .filter-list .list-item:first-of-type {
    border-top: 0;
  }
  .filter-list .list-item {
    flex-direction: column;
    align-items: flex-start;
    padding: 15px 0px 15px 0px;
  }
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
  .filter-list .list-item .name {
    font-size: 20px;
  }
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
  
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
  .filter-list .department::before {
    content: "Department:";
    padding-right: 5px;
  }
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
  .filter-list .email::before {
    content: "Email:";
    padding-right: 5px;
  }
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
  .filter-list .phone::before {
    content: "Phone:";
    padding-right: 5px;
  }
  .filter-list .list-item > div {
    width: calc(100% - 60px);
    margin-left: 60px;
  }
}


.nameofitem a {
  text-decoration: none;
}
.nameofitem a:hover {
  text-decoration: underline ! IMPORTANT;
}

body.page-template-template-staff-directory .faculty-header {
  font-size: 18px;
}
section.main_wrap_news .news_detail a {
  margin-left: 0px !important;
}
