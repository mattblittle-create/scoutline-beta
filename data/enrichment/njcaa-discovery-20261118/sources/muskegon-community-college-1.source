<script>
    $(document).ready(function(){
        var isPaused = false;

        $('#carouselControl').click(function(){
            if (isPaused) {
                $('#main-slider-banner').carousel('cycle');
                 $('#carouselIcon').attr('src', '/wp-content/themes/planeteriaweb/img/icon_pause.svg');
            } else {
                $('#main-slider-banner').carousel('pause');
                $('#carouselIcon').attr('src', '/wp-content/themes/planeteriaweb/img/icon_play.svg');
            }
            isPaused = !isPaused;
        });
    });
