function generateCaptcha()
{
	$("#contact-form").remove('input[name="token"]');
	$("#contact-form").remove('input[name="captcha_action"]');
	grecaptcha.ready(function() {
		grecaptcha.execute('6Lfc5f0hAAAAAHe9xT8gHAkoenf-YZrAR13mfsYc', {action: 'contact_form'}).then(function(token) {
			$("#contact-form").prepend('<input type="hidden" name="token" value="' + token + '">');
			$("#contact-form").prepend('<input type="hidden" name="captcha_action" value="contact_form">');
		});
	});
}
function generateCaptcha1()
{
	$("#contact-form1").remove('input[name="token"]');
	$("#contact-form1").remove('input[name="captcha_action"]');
	grecaptcha.ready(function() {
		grecaptcha.execute('6Lfc5f0hAAAAAHe9xT8gHAkoenf-YZrAR13mfsYc', {action: 'contact_form1'}).then(function(token) {
			$("#contact-form1").prepend('<input type="hidden" name="token" value="' + token + '">');
			$("#contact-form1").prepend('<input type="hidden" name="captcha_action" value="contact_form1">');
		});
	});
}
