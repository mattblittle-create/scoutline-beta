<script type="text/javascript">
$(document).ready(function(){
  grecaptcha.ready(function() {
      grecaptcha.execute('6Lfc5f0hAAAAAHe9xT8gHAkoenf-YZrAR13mfsYc', {action: 'homepage'}).then(function(form_id) {
        $('#form_id').val(form_id);
