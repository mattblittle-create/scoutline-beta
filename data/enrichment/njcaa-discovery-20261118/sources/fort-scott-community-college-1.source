            <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src="/sports/sball/2025-26/2026_East_Week_7.png?max_width=1172&useS3=true" alt="KJCCC Baseball East Division 1 Players of the Week - Week 7" width="1172" height="660" />
    
</div>
