<script type="speculationrules">
{"prerender":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/wp-dccc/*","/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prerender, .no-prerender a"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"moderate"}]}
</script>
<script>
// Copyright Allied Pixel 2025

(() => {
  'use strict';

  let ready = false;

  const poll = setInterval(() => {
    const iframe   = document.getElementById('alliedpixel-iframe');
    const modal    = document.getElementById('alliedpixel-modal');
    const overlay  = document.getElementById('alliedpixel-overlay');
    const button   = document.getElementById('alliedpixel-vertical-button');
    const closeBtn = document.getElementById('alliedpixel-modal-close');

    if (!iframe || !modal || !overlay) return;
    if (ready) return;
    ready = true;
    clearInterval(poll);

    // Pass parent URL to iframe
    const url = new URL(iframe.src);
    url.searchParams.set('parentUrl', window.location.href);
    iframe.src = url.toString();

    // Open / close helpers
    const open = () => {
      overlay.style.display = 'block';
      modal.style.display   = 'block';
    };

    const close = () => {
      overlay.style.display = 'none';
      modal.style.display   = 'none';
    };

    // Close on overlay, close button, or clicking outside content
    overlay.addEventListener('click', close);
    if (closeBtn) closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });

    // Re-open button
    if (button) button.addEventListener('click', open);

    // Listen for close from iframe
    window.addEventListener('message', (e) => {
      if (e.data && e.data.action === 'CLOSE_ALLIEDPIXEL_MODAL') close();
    });

    // Show on first visit (cookie check)
    const hasCookie = document.cookie.includes('alliedpixelrapidvideo=true');
    if (!hasCookie) {
      open();
      const now    = new Date();
      const expiry = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 0);
      document.cookie = 'alliedpixelrapidvideo=true; expires=' + expiry.toUTCString() + '; path=/';
    }
  }, 200);
})();

</script><script id="wp-importmap" type="importmap">
{"imports":{"@wordpress/route":"https://www.dccc.edu/wp-includes/js/dist/script-modules/route/index.min.js?ver=ef851c0f4dda0d1dd359","@wordpress/video-conversion/worker":"https://www.dccc.edu/wp-includes/js/dist/script-modules/video-conversion/worker.min.js?ver=4d3627c45251ceb4f9a2","@wordpress/vips/worker":"https://www.dccc.edu/wp-includes/js/dist/script-modules/vips/worker.min.js?ver=7e33cd8c4128731126e8"}}
