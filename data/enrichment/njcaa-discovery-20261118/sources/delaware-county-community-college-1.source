        <label for="description">Description</label>
        <div class="description-container">
          <textarea id="description" name="description" rows="6" cols="33" placeholder="Enter description" maxlength="250"></textarea>
          <div class="char-count">0/250</div>
        </div>
        <span class="error-text hidden"></span>
      </div>

      <div class="action">
        <button class="submit dccc-button dccc-button_color_yellow" type="submit">Submit</button>
        <button class="cancel dccc-button dccc-button_color_white">Cancel</button>
      </div>
    </form>
  </div>
