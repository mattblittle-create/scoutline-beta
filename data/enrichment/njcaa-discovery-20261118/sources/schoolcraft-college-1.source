		</form>
	</div>
	-->

	<script>
		// add legacy content blurb with suggested url on load
		function suggestLegacyContentLink() {
			const container = document.getElementById('legacy-content');
			const hyperlink = document.getElementById('legacy-content-link-placeholder');
			const path = window.location.pathname;
			const queryString = window.location.search;

			hyperlink.setAttribute('href', 'https://home.schoolcraft.edu' + path + queryString);
			hyperlink.textContent = 'home.schoolcraft.edu' + path + queryString;
			container.style.display = 'block';
		}
		window.addEventListener('DOMContentLoaded', suggestLegacyContentLink);

		function setSearchLocation(input) {
			// This may need to be adjusted for the non-production WP Engine sites in the future
			const host = window.location.host;
			let oldHost;
			let thisIsTheNewSite = true;
			if (host.includes('wpengine.com') || host.includes('.local')) {
				thisIsTheNewSite = false;
			}

			const form = document.getElementById('search-form-404');

			switch (input.value) {
				case 'home.schoolcraft.edu':
					if (thisIsTheNewSite) {
						oldHost = "https://home.schoolcraft.edu";
					} else {
						oldHost = "https://www.schoolcraft.edu";
					}
					// sample url
					// https://www.schoolcraft.edu/detail-pages/search-results/?indexCatalogue=entire-sc-site-%2B-subsites&searchQuery=test+search&wordsMode=0
					// we'll add the other URL params onsubmit
					form.action = oldHost + '/detail-pages/search-results/';
					// do we want old search to open in new window?
					// form.target = "_blank";
					break;
				default:
					form.action = "/";
					// form.target = "";
			}
		}

		function customSearch(form) {
			if (form.searchLocation.value === 'home.schoolcraft.edu') {
				// Copy the search keywords to the field named for Sitefinity
				const searchQueryInput = document.createElement("input");
				searchQueryInput.setAttribute("type", "hidden");
				searchQueryInput.setAttribute("name", "searchQuery");
				searchQueryInput.setAttribute("value", form.s.value);
				form.appendChild(searchQueryInput);

				// Create a few other hidden fields for Sitefinity required fields
				const wordsModeInput = document.createElement("input");
				wordsModeInput.setAttribute("type", "hidden");
				wordsModeInput.setAttribute("name", "wordsMode");
				wordsModeInput.setAttribute("value", "0");
				form.appendChild(wordsModeInput);

				const indexCatalogueInput = document.createElement("input");
				indexCatalogueInput.setAttribute("type", "hidden");
				indexCatalogueInput.setAttribute("name", "indexCatalogue");
				indexCatalogueInput.setAttribute("value", "entire-sc-site-+-subsites");
				form.appendChild(indexCatalogueInput);
			}
		}
	</script>

