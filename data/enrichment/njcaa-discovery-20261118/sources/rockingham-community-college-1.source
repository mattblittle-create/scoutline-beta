<style type="text/css">
body:not(.wp-admin) a {
  text-decoration: underline;
}

th {
	font-weight: 700 !important;
	text-transform: uppercase !important;
}

.mobile-menu-toggle {
	text-decoration: none !important;
}

.icon-information {
	text-decoration: none !important;
}

.bg-highlight {
	background-color: #C25700 !important;
}

.text-highlight {
