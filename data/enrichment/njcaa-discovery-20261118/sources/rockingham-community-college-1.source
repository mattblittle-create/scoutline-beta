        margin-top: 100px;
    }
}

@media (min-width: 640px) {
    .slide .bg-rcc-icon {
        /* right column */
        min-height: 380px;
    }
}

@media (min-width: 768px) {
    .slide .bg-rcc-icon {
        /* right column */
        min-height: 410px;
    }
