<!-- start Simple Custom CSS and JS -->
<style type="text/css">
/* Hero Slider Layout */
.hero-slider {
  position: relative;
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  overflow: hidden;
}

.hero-slider__track {
  display: flex;
  transition: transform 500ms ease;
}

/* SHORTER HEIGHT: Set to 420px */
.hero-slider__slide {
  min-width: 100%;
  display: grid;
  grid-template-columns: 1fr 1.3fr !important;
}

.hero-slider__media {
  position: relative;
  background: #000;
}

.hero-slider__media img,
.hero-slider__media video {
  width: 100%;
  height: 100% !important;
  object-fit: cover;
  display: block;
}

.hero-slider__panel {
  background: #0f4f3f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.hero-slider__inner { max-width: 480px; text-align: center; }

.hero-slider__title {
  font-size: clamp(24px, 3vw, 40px);
  margin: 0 0 10px;
  color: #fff !important;
}

.hero-slider__subheading {
  font-size: 17px;
  margin: 0 0 20px;
  color: #fff !important;
}

.hero-slider__button {
  display: inline-block;
  padding: 12px 24px;
  background: #b45a00;
  color: #fff;
  text-decoration: none;
  font-weight: bold;
}

/* Controls & Dots */
.hero-slider__controls {
  position: absolute;
  right: 20px;
  top: 20px;
  display: flex;
  gap: 8px;
  z-index: 10;
}

.hero-slider__toggle, .hero-slider__nav {
  background: rgba(0,0,0,0.5);
  color: #fff;
  border: none;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  cursor: pointer;
}

.hero-slider__dots {
  position: absolute;
  right: 25px;
  top: 65px;
  display: flex;
  gap: 8px;
  z-index: 10;
}

.hero-slider__dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: rgba(255,255,255,0.3); border: none;
}

.hero-slider__dot[aria-current="true"] { background: #fff; }
/*
@media (max-width: 1310px) {
	.hero-slider__media img,
	.hero-slider__media video {
	  width: 100%;
	  height: 100% !important;
	}
}
*/
@media (max-width: 900px) {
  .hero-slider__slide { 
	  grid-template-columns: 1fr !important; 
	  min-height: auto !important; 
	}
	/*
	.hero-slider__viewport {
		height: 75vh !important;
	}*/
	/*
	.hero-slider__media img {
		object-fit: contain !important;
	}*/
}

@media (max-width: 550px) {
	.hero-slider__media img {
		object-fit: cover !important;
	}
}

</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style type="text/css">
/* Mobile: stack main content first */
@media (max-width: 767px) {

  .row:has(> .section-sidebar):has(> .section-body-border) {
    display: flex;
    flex-direction: column;
  }

  .row:has(> .section-sidebar):has(> .section-body-border) > .section-body-border {
    order: 1;
  }

  .row:has(> .section-sidebar):has(> .section-body-border) > .section-sidebar {
    order: 2;
  }

  .row:has(> .section-sidebar):has(> .section-body-border) > .section-sidebar,
  .row:has(> .section-sidebar):has(> .section-body-border) > .section-body-border {
    width: 100%;
    max-width: 100%;
  }
}

</style>
<!-- end Simple Custom CSS and JS -->
