            Search calendar events
        </label>

        <input
            type="search"
            id="calendar_search"
            name="search"
            value=""
            placeholder="Search for events"
        >

       <input
    type="hidden"
    name="cal_month"
    value="11"
>

<input
    type="hidden"
    name="cal_year"
    value="2026"
>
        <button type="submit">
            Find Events
        </button>

        
    </form>

    <nav
        class="calendar-view-navigation"
        aria-label="Calendar views"
          style="font-size:20px;"
    >
