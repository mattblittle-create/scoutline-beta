            List
        </a>
&nbsp;
        <strong><u>Month</u></strong>
&nbsp;
        <a
            href="/calendar-events/calendar-day/?calendar_date=2026-11-18"
        >
            Day
        </a>
    </nav>

</div>

<div class="calendar_full_container">
    <div class="calendar_filters">
        <h3 style="border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#e7e8e8;">Filters</h3>
        <div class="calendar-accordion">

        <!-- Calendars -->
        <div class="accordion-item">
            <h2 class="accordion-heading">
                <button type="button"
                        class="accordion-trigger"
                        id="calendars-button"
                        aria-expanded="false"
                        aria-controls="calendars-panel">
                    <span>Calendars</span>
                    <span class="accordion-icon" aria-hidden="true"></span>
                </button>
            </h2>

            <div id="calendars-panel"
                 class="accordion-panel"
                 role="region"
                 aria-labelledby="calendars-button"
                 hidden>
                <!-- Calendar checkboxes go here -->
                
                    <!-- Calendars -->
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="type"
                        value="Athletics"
                    >
                    Athletics
                </label><br>

                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="type"
                        value="Board of Trustees Meetings"
                    >
                    Board of Trustees Meetings
                </label><br>

                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="type"
                        value="College Closed Days"
                    >
                    College Closed Days
                </label><br>

                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="type"
                        value="College Committee Meetings"
                    >
                    College Committee Meetings
                </label><br>

                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="type"
                        value="College Events"
                    >
                    College Events
                </label><br>

                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="type"
                        value="Important Dates and Deadlines"
                    >
                    Important Dates & Deadlines
                </label><br>
            </div>
        </div>

        <!-- Location -->
        <div class="accordion-item">
            <h2 class="accordion-heading">
                <button type="button"
                        class="accordion-trigger"
                        id="location-button"
                        aria-expanded="false"
                        aria-controls="location-panel">
                    <span>Location</span>
                    <span class="accordion-icon" aria-hidden="true"></span>
                </button>
            </h2>

            <div id="location-panel"
                 class="accordion-panel"
                 role="region"
                 aria-labelledby="location-button"
                 hidden>

                <!-- Location options go here -->
               <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="map-location"
                        value="ONC"
                    >
                    On Campus
                </label>

                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="map-location"
                        value="ETC"
                    >
                    Effingham Technology Center
                </label>
            </div>
        </div>

        <!-- Day -->
        <div class="accordion-item">
            <h2 class="accordion-heading">
                <button type="button"
                        class="accordion-trigger"
                        id="day-button"
                        aria-expanded="false"
                        aria-controls="day-panel">
                    <span>Day</span>
                    <span class="accordion-icon" aria-hidden="true"></span>
                </button>
            </h2>

            <div id="day-panel"
                 class="accordion-panel"
                 role="region"
                 aria-labelledby="day-button"
                 hidden>

                <!-- Day options go here -->
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Sunday"
                    >
                    Sunday
                </label>
                <br>
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Monday"
                    >
                    Monday
                </label>
                <br>
                 <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Tuesday"
                    >
                    Tuesday
                </label>
                <br>
                 <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Wednesday"
                    >
                    Wednesday
                </label>
                <br>
                 <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Thursday"
                    >
                    Thursday
                </label>
                <br>
                 <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Friday"
                    >
                    Friday
                </label>
                <br>
                 <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="day"
                        value="Saturday"
                    >
                    Saturday
                </label>

                
            </div>
        </div>

        <!-- Time -->
        <div class="accordion-item">
            <h2 class="accordion-heading">
                <button type="button"
                        class="accordion-trigger"
                        id="time-button"
                        aria-expanded="false"
                        aria-controls="time-panel">
                    <span>Time</span>
                    <span class="accordion-icon" aria-hidden="true"></span>
                </button>
            </h2>

            <div id="time-panel"
                 class="accordion-panel"
                 role="region"
                 aria-labelledby="time-button"
                 hidden>

                <!-- Time options go here -->
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="time"
                        value="All Day"
                    >
                    All Day
                </label>
                <br>
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="time"
                        value="Morning"
                    >
                    Morning
                </label>
                <br>
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="time"
                        value="Afternoon"
                    >
                    Afternoon
                </label>
                <br>
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="time"
                        value="Evening"
                    >
                    Evening
                </label>
                <br>
                <label>
                    <input
                        type="checkbox"
                        class="calendar-filter"
                        data-filter-group="time"
                        value="Night"
                    >
                    Night
                </label>
            </div>
        </div>

        </div>
    </div>
    <div class="calendar_main">
        <div class="calendar-nav">

    <div class="calendar-month-header">
<a
    href="?cal_month=10&amp;cal_year=2026"
    class="calendar-arrow"
    aria-label="Previous month"
>
    &#10094;
</a>

        <h2 class="calendar-month-heading">
            November 2026        </h2>

       <a
    href="?cal_month=12&amp;cal_year=2026"
    class="calendar-arrow"
    aria-label="Next month"
>
    &#10095;
</a>

    </div>

</div>
        <table class="calendar">
            <caption class="sr-only">
                <h3>November 2026</h3>            </caption>

            <thead>
                <tr>
                    <th scope="col" class="calendar_day">S</th>
                    <th scope="col" class="calendar_day">M</th>
                    <th scope="col" class="calendar_day">T</th>
                    <th scope="col" class="calendar_day">W</th>
                    <th scope="col" class="calendar_day">T</th>
                    <th scope="col" class="calendar_day">F</th>
                    <th scope="col" class="calendar_day">S</th>
                </tr>
            </thead>

       
