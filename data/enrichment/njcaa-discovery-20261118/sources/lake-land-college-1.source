<script>
document.addEventListener('DOMContentLoaded', function () {
    const accordionTriggers = document.querySelectorAll(
        '.calendar-accordion .accordion-trigger'
    );

    accordionTriggers.forEach(function (trigger) {
        trigger.addEventListener('click', function () {
            const panelId = trigger.getAttribute('aria-controls');
            const panel = document.getElementById(panelId);
            const isExpanded =
                trigger.getAttribute('aria-expanded') === 'true';

            trigger.setAttribute(
                'aria-expanded',
                isExpanded ? 'false' : 'true'
            );

            panel.hidden = isExpanded;
        });
    });

    const filterCheckboxes = document.querySelectorAll(
        '.calendar-filter'
    );

    const calendarEvents = document.querySelectorAll(
        '.calendar-event'
    );

    function getCheckedValues(groupName) {
        return Array.from(
            document.querySelectorAll(
                '.calendar-filter[data-filter-group="' +
                groupName +
                '"]:checked'
            )
        ).map(function (checkbox) {
            return checkbox.value.trim().toLowerCase();
        });
    }

    function filterCalendarEvents() {
        const selectedTypes = getCheckedValues('type');
        const selectedLocations = getCheckedValues('map-location');
        const selectedDays = getCheckedValues('day');
        const selectedTimes = getCheckedValues('time');

        calendarEvents.forEach(function (eventElement) {
            const eventType = (
                eventElement.dataset.eventType || ''
            ).trim().toLowerCase();

            const eventLocation = (
                eventElement.dataset.eventLocation || ''
            ).trim().toLowerCase();

            const eventDay = (
                eventElement.dataset.eventDay || ''
            ).trim().toLowerCase();

            const eventTime = (
                eventElement.dataset.eventTime || ''
            ).trim();

            const matchesType =
                selectedTypes.length === 0 ||
                selectedTypes.includes(eventType);

            const matchesLocation =
                selectedLocations.length === 0 ||
                selectedLocations.some(function (location) {
                    return eventLocation.includes(location);
                });

            const matchesDay =
                selectedDays.length === 0 ||
                selectedDays.includes(eventDay);

            const matchesTime =
                selectedTimes.length === 0 ||
                selectedTimes.some(function (timeRange) {
                    return eventMatchesTime(
                        eventTime,
                        timeRange
                    );
                });

            eventElement.hidden = !(
                matchesType &&
                matchesLocation &&
                matchesDay &&
                matchesTime
            );
        });

        updateEmptyDays();
    }

    function eventMatchesTime(eventTime, selectedRange) {
        if (!eventTime) {
            return selectedRange === 'all day';
        }

        const hour = parseInt(eventTime.split(':')[0], 10);

        if (Number.isNaN(hour)) {
            return false;
        }

        switch (selectedRange) {
            case 'morning':
                return hour >= 5 && hour < 12;

            case 'afternoon':
                return hour >= 12 && hour < 17;

            case 'evening':
                return hour >= 17 && hour < 21;

            case 'night':
                return hour >= 21 || hour < 5;

            default:
                return false;
        }
    }

    function updateEmptyDays() {
        const calendarCells = document.querySelectorAll(
            '.calendar tbody td:not(.empty)'
        );

        calendarCells.forEach(function (cell) {
            const events = cell.querySelectorAll(
                '.calendar-event'
            );

            const visibleEvents = Array.from(events).filter(
                function (eventElement) {
                    return !eventElement.hidden;
                }
            );

            cell.classList.toggle(
                'no-matching-events',
                events.length > 0 && visibleEvents.length === 0
            );
        });
    }

    filterCheckboxes.forEach(function (checkbox) {
        checkbox.addEventListener(
            'change',
            filterCalendarEvents
        );
    });
});
</script></p>



<div style="height:100px" aria-hidden="true" class="wp-block-spacer"></div>



<p class="wp-block-paragraph"></p>

			</main>
			<style>
    .contact-us-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 2rem 0 2.5rem;
        padding-right: calc(var(--bs-gutter-x)* .5);
        padding-left: calc(var(--bs-gutter-x)* .5);
    }
    .contact-us-title {
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.2rem;
        margin: 0;
    }
    .contact-us-departments {
        display: flex;
        flex-wrap: wrap;
        column-gap: 1.6rem;
        row-gap: 2.4rem;

        & .contact-us-department {
            flex-grow: 1;
            flex-basis: 45%;
        }

        & .contact-title {
            margin: -0.3rem 0 0.5rem;
        }
        & .contact-us-name {
            margin-bottom: 0.7rem;
        }
    }
    .contact-info {
        display: flex;
        flex-wrap: wrap;
        column-gap: 4rem;
        row-gap: 1rem;
    }
    .icon-flex {
        display: flex;
        gap: 0.8rem;
        align-items: center;
    }
    .contact-icon {
        width: 1.5rem;
        height: 1.5rem;
        display: flex;
        justify-content: center;
        align-items: center;

        & svg {
            width: 100%;
            height: 100%;

            & path {
                fill: #212529;
            }
        }
    }
    .contact-label {
        font-size: 1.2rem;
    }
    .contact-title {
        color: #5b5b5b;
    }
</style>


		</div>

	</div>

</div>


