<script>
(function () {
  function addAriaLabelsToBannersAndHeaders() {
    var selectors = [
      'header',             // all <header> elements
    ];

    var elements = document.querySelectorAll(selectors.join(','));

    elements.forEach(function (el) {
      if (el.hasAttribute('aria-label')) return;

      var labelSource =
        el.querySelector('h1, h2, h3, h4, h5, h6') ||
        el.querySelector('.title, .heading, .page-title');

      if (!labelSource) return;

      var labelText = labelSource.textContent.trim();
      if (!labelText) return;

      el.setAttribute('aria-label', labelText);
    });
  }

  if (document.readyState === 'complete') {
    addAriaLabelsToBannersAndHeaders();
  } else {
    window.addEventListener('load', addAriaLabelsToBannersAndHeaders);
  }
})();
</script>



 

 

