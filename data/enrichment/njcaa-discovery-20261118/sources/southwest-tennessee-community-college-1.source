<script>
(function() {
    var rotator = document.querySelector('.mod-news-rotator.style3');
    if (!rotator) return;

    // Find slide elements produced by mod-news-rotator-style*.vm / Slick
    var slides = rotator.querySelectorAll('.seats .seat, .seats .slide, .seats li');

    slides.forEach(function(slide, i) {
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-roledescription', 'slide');
        slide.setAttribute('aria-label', 'slide');

        if (i === 0) {
            slide.setAttribute('aria-current', 'true');
        }
    });
})();
</script>


