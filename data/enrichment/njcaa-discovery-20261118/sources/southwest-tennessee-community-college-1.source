<script>
window.addEventListener('load', function () {
  // This runs after the page and resources are fully loaded
  document.querySelectorAll('li[role="menuitem"]').forEach(function (li) {
    li.removeAttribute('role');
  });
  
  document.querySelectorAll('[role="menubar"]').forEach(function (liB) {
    liB.removeAttribute('role');
  });
  
  document.querySelectorAll('[role="menu"]').forEach(function (liC) {
    liC.removeAttribute('role');
  });
  
  document.querySelectorAll(' .mod-roster .roster thead .sortable').forEach(function (btn) {
      var text = (btn.textContent || '').trim();
      btn.setAttribute('aria-label', 'Sort by ' + text);
      btn.removeAttribute('role');
      btn.removeAttribute('title');
    });

  document.querySelectorAll('a.venue').forEach(function (link) {
    var span = link.querySelector('span');
    if (!span) return;

    var text = (span.textContent || '').trim().toUpperCase(); // "H", "A", "N"

    if (text === 'H') {
      span.style.color = '#cb0505';       
    } else if (text === 'A' || text === 'N') {
      span.style.color = '#002244';       
    }
  });
  
  document.querySelectorAll('th.pinned-col').forEach(function (th) {
    if (!th.textContent.trim()) {
      th.textContent = 'Table Header'; 
    }
  });
});
</script><script type='text/javascript' src='/info/ga/include.js' async data-uid='UA-1939879-1'></script>


