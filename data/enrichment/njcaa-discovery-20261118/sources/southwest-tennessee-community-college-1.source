<script>
(function () {
  function labelGalleryLinks() {
    document.querySelectorAll('.galleries .gallery .heading > a').forEach(function (link) {
      var labelEl = link.querySelector('.title .text') || link.querySelector('.text');
      if (!labelEl) return;

      var text = labelEl.textContent.trim();
      if (!text) return;

      // Only add if aria-label is missing
      if (!link.hasAttribute('aria-label')) {
        link.setAttribute('aria-label', text);
      }
    });
  }

  if (document.readyState === 'complete') {
    labelGalleryLinks();
  } else {
    window.addEventListener('load', labelGalleryLinks);
  }
})();
</script>
                </section>
            </div>
        </div>
    </div>
</div>

