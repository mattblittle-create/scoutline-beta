<script>try{var s=localStorage.getItem('squarespace-announcement-bar'),c=Static.SQUARESPACE_CONTEXT,d=document.documentElement;if(c.showAnnouncementBar&&!(s&&JSON.parse(s).closed)){d.classList.add('sqs-announcement-bar-reserved-space');var h=c.websiteSettings.announcementBarSettings.text;if(typeof h=='string')d.style.setProperty('--sqs-announcement-bar-text',JSON.stringify(new DOMParser().parseFromString(h,'text/html').body.textContent.replace(/\s+/g,' ').trim()))}}catch(e){}</script><script type="application/ld+json">{"url":"https://www.cccollege.edu","name":"Community Christian College","description":"\u003cp class=\"\" style=\"white-space:pre-wrap;\"> \u003cstrong>cCc\u003c/strong> is a minority serving institution\u003cstrong> \u003c/strong>with a commitment to providing inner city youth with a real chance at success.  cCc meets the students where they are and brings them to a level of reading, writing, and comprehension that will make the transfer to a four-year college much easier.  (You can\u2019t graduate from cCc by taking multiple choice tests only.)   TRACS, cCc\u2019s accreditor, just awarded cCc another 10 years. \u003cstrong>Our tuition rate and athletic fee are extremely affordable and currently there are no book costs\u003c/strong>.  cCc offers a fixed curriculum that rotates every 18 months.  This means that a student can graduate with an associate degree in 18 months if they stay on schedule.   (Compare any of these options with that offered at your local community colleges.)\u003c/p>","@context":"http://schema.org","@type":"WebSite"}</script><script type="application/ld+json">{"legalName":"Community Christian College","address":"1174 Nevada Street\nRedlands, CA, 92374\nUnited States","email":"registrar@cccollege.edu","telephone":"909.253.7707","sameAs":["https://www.facebook.com/cccsaints"],"@context":"http://schema.org","@type":"Organization"}</script><script type="application/ld+json">{"address":"1174 Nevada Street\nRedlands, CA, 92374\nUnited S