<script>
    var obj = {"start":0,"count":8,"name":"","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{"sports":[{"id":1,"title":"Baseball"},{"id":10,"title":"Esports"},{"id":2,"title":"General"},{"id":3,"title":"Men's Basketball"},{"id":4,"title":"Men's Soccer"},{"id":8,"title":"Softball"},{"id":6,"title":"Women's Basketball"},{"id":9,"title":"Women's Soccer"},{"id":7,"title":"Women's Volleyball"}]},"context":null,"dummy":false,"type":"stories","id":"3574739f-f0f5-4d99-8070-9e5e4a73b93c","data":[{"title":"Lincoln Land Athletics Opens Nominations for 2027 Hall of Fame Class","title_in_rotator":true,"sub_headline":null,"teaser":"<b>SPRINGFIELD, IL.</b> — Lincoln Land Athletics is now accepting nominations for its 2027 Hall of Fame Class.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, General, Men's Basketball, Women's Basketball, Women's Volleyball, Softball, Women's Soccer","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"BB","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/8/19/2027_-__p__strong_Hall_of_Fame_Class__strong___p__-_Landscape.jpg","image_focal_point":null,"image_alt_text":"2027 Hall of Fame Class for Lincoln Land.","video":null,"url":"/news/2026/8/19/baseball-lincoln-land-athletics-opens-nominations-for-2027-hall-of-fame-class.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":1,"locked_ranking":false,"id":4910,"content_id":"4910","content_title":"Lincoln Land Athletics Opens Nominations for 2027 Hall of Fame Class","content_date":"2026-08-19T10:46:00","content_url":"https://lincolnlandloggers.com/news/2026/8/19/baseball-lincoln-land-athletics-opens-nominations-for-2027-hall-of-fame-class.aspx","content_image_url":"https://lincolnlandloggers.com/images/2026/8/19/2027_-__p__strong_Hall_of_Fame_Class__strong___p__-_Landscape.jpg","date":"2026-08-19T10:46:00"},{"title":"46 Lincoln Land Community College Student-Athletes Earn NJCAA All-Academic Honors","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>46 Student-Athletes Recognized for Excellence in the Classroom</strong>. The Lincoln Land Community College Athletic Department is proud to honor <strong>46 student-athletes</strong> who have been named to the <strong>2025-2026 NJCAA All-Academic Teams</strong>, recognizing their outstanding academic performance during the past academic year. These honors celebrate student-athletes who not only excel in competition but also demonstrate exceptional discipline and commitment to their studies. ","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, General, Men's Basketball, Women's Basketball, Women's Volleyball, Softball, Women's Soccer","sport":{"id":2,"title":"General","abbreviation":"GEN","shortname":"general","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"general","gender":"g","youtube":"","facebook":"https://www.facebook.com/LLCCAthletics/","twitter":"LLCCAthletics","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/8/5/46_-__p__strong_Lincoln_Land_Academic_All-Americans__strong___p__-_Landscape.jpg","image_focal_point":null,"image_alt_text":"46 Lincoln Land Community College Student-Athletes Earn NJCAA All-Academic Honors","video":null,"url":"/news/2026/8/5/general-46-lincoln-land-community-college-student-athletes-earn-njcaa-all-academic-honors.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":2,"locked_ranking":false,"id":4909,"content_id":"4909","content_title":"46 Lincoln Land Community College Student-Athletes Earn NJCAA All-Academic Honors","content_date":"2026-08-05T10:02:00","content_url":"https://lincolnlandloggers.com/news/2026/8/5/general-46-lincoln-land-community-college-student-athletes-earn-njcaa-all-academic-honors.aspx","content_image_url":"https://lincolnlandloggers.com/images/2026/8/5/46_-__p__strong_Lincoln_Land_Academic_All-Americans__strong___p__-_Landscape.jpg","date":"2026-08-05T10:02:00"},{"title":"33rd Annual Baseball Golf Outing","title_in_rotator":true,"sub_headline":null,"teaser":"The 33rd Annual Lincoln Land Community College Baseball Team Golf Outing will be held on Friday, September 18, 2026, at the Rail Golf Course in Springfield, Illinois. The LLCC Baseball team has had many successes, and numerous players have gone on to play professional baseball. The program is committed to providing opportunities for local talent to compete at the highest level. With strong community support, LLCC has been able to reach many goals. This event is just one way of fundraising that helps support the LLCC Baseball program. Making a contribution is important to our students and to the continued growth and success of the baseball program. Participants may register individually or as a team of four. If you are unable to join us for the outing but would still like to support the LLCC baseball team, please check out our various sponsorship opportunities. If you have any questions please contact Steve Torricelli at steven.torricelli@llcc.edu.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, General","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"BB","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/7/28/Golf_Outing_-_Loggers_Baseball_-_Landscape.jpg","image_focal_point":null,"image_alt_text":"LLCC baseball golf outing. 9/18/26 | 9am | The Rail Golf Course","video":null,"url":"/news/2026/7/28/33rd-annual-baseball-golf-outing.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":3,"locked_ranking":false,"id":4908,"content_id":"4908","content_title":"33rd Annual Baseball Golf Outing","content_date":"2026-07-28T14:27:00","content_url":"https://lincolnlandloggers.com/news/2026/7/28/33rd-annual-baseball-golf-outing.aspx","content_image_url":"https://lincolnlandloggers.com/images/2026/7/28/Golf_Outing_-_Loggers_Baseball_-_Landscape.jpg","date":"2026-07-28T14:27:00"},{"title":"Lincoln Land Community College Athletics Spring GPA","title_in_rotator":true,"sub_headline":null,"teaser":"Spring 2026 at Lincoln Land Community College showcased a powerful balance between academics and athletics. Across six programs, student-athletes completed <strong>1,419 credit hours</strong> and earned a strong <strong>3.26 overall GPA</strong>, proving their commitment beyond competition.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, General, Men's Basketball, Women's Basketball, Women's Volleyball, Softball, Women's Soccer","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"BB","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/5/28/GPA_-_Two_-_Landscape-3.jpg","image_focal_point":null,"image_alt_text":"LLCC athletic gpa 3.26.","video":null,"url":"/news/2026/5/28/baseball-lincoln-land-community-college-athletics-spring-gpa.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":4,"locked_ranking":false,"id":4905,"content_id":"4905","content_title":"Lincoln Land Community College Athletics Spring GPA","content_date":"2026-05-28T14:42:00","content_url":"https://lincolnlandloggers.com/news/2026/5/28/baseball-lincoln-land-community-college-athletics-spring-gpa.aspx","content_image_url":"https://lincolnlandloggers.com/images/2026/5/28/GPA_-_Two_-_Landscape-3.jpg","date":"2026-05-28T14:42:00"},{"title":"Cox Named to Region 24 All-Region Team","title_in_rotator":true,"sub_headline":null,"teaser":"<p data-end=\"308\" data-start=\"0\">Camden Cox capped off an incredible season by earning a spot on the Region 24 All-Region Team as one of the top outfielders in the conference. Known for his consistency at the plate and flawless defense in the field, Camden became a key piece of his team's success all season long.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, General","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"BB","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/5/15/Football_Score_Update_-_Landscape-2.jpg","image_focal_point":null,"image_alt_text":"LLCC baseball player Cox hitting. All-Region Team.","video":null,"url":"/news/2026/5/15/baseball-cox-named-to-region-24-all-region-team.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":5,"lo