                <div class="c-awards__media">
                    <img class="c-awards__image lazyload" data-bind="attr: { 'data-src': image + '?width=200&height=275&mode=crop&scale=both&format=jpg&quality=80', alt: name }" />
                </div>
                <div class="c-awards__text flex flex-column flex-justify-center">
