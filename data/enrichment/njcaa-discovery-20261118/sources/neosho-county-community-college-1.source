<script>
    var obj = {"start":10,"count":6,"name":"stories--list","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{"sports":[{"id":1,"title":"Baseball"},{"id":13,"title":"Cheerleading"},{"id":5,"title":"Cross Country/Track & Field"},{"id":12,"title":"Dance"},{"id":2,"title":"Men's Basketball"},{"id":3,"title":"Men's Soccer"},{"id":11,"title":"SHO SPIRIT"},{"id":4,"title":"Softball"},{"id":16,"title":"Sports Medicine"},{"id":6,"title":"Women's Basketball"},{"id":7,"title":"Women's Soccer"},{"id":8,"title":"Women's Volleyball"},{"id":9,"title":"Wrestling"}]},"context":null,"dummy":false,"type":"stories","id":"209d73d2-2420-4215-aa03-e8bd586261bd","data":[{"title":"Panthers Drop First Two Against Northeast Nebraska","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS-</strong> The Panthers struggled in the first two games against Northeast, taking the loss in both contests. In game one, the final score was 8-1, and the final in game two was 15-6. Struggles on both sides of the ball plagued the Panthers as they were unable to keep pace with the Hawks offensively. In game 1, the lone run came off the bat of JD Troutman who had a RBI double that scored Carson Hilton. In a 2-1 contest going into the 7th inning, the Hawks scored 6 runs and the Panthers were unable to answer. In game 2, the offense produced 6 runs off of 6 hits but 2 untimely errors by the defense and 15 hits allowed, led to Northeast scoring 15 of their own runs. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null