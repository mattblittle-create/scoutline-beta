location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":168,"prefix":null,"name":null,"title":"NE Nebraska","image":"/images/logos/Northeast_Community_College_Logo.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6190,"status":"L","team_score":"6","opponent_score":"15","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6190","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":11,"locked_ranking":false,"id":3787,"content_id":"3787","content_title":"Panthers Drop First Two Against Northeast Nebraska","content_date":"2026-02-15T19:11:00","content_url":"https://goneosho.com/news/2026/2/15/baseball-panthers-drop-first-two-against-northeast-nebraska.aspx","content_image_url":"https://goneosho.com/images/2026/2/15/Brody_Dinges_vs_NE_NEB.jpeg","date":"2026-02-15T19:11:00"},{"title":"Neosho Completes Opening Weekend Sweep","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS-</strong> The Panthers complete the opening weekend sweep against Ottawa. In game 1, the final score was 14-3 and in game 2, the final was 12-1. In game 2, the offense got going early and continued the production in every inning. Four different Panther hitters had multiple hits with the last big one coming from Dylan Burks with a grand slam to complete the run rule. On the mound, Austin O'Gorman earned his first win of the year, throwing 5 innings, allowing 3 hits, 3 runs and striking out 5. In game 2, the story was much of the same from the hitters. Four different Panthers had multiple hit games with JD Troutman hitting 2 home runs. Maverick Williamson also added a long ball to reach the run rule. Zach Grossnickle got the start on the mound in the final game of the series and earned his first win of the season. Grossnickle threw 5 innings, allowing 4 hits, 1 run, while collecting 2 strikeouts. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/2/7/JD_Troutman_vs._Ottawa_2-7-26.jpeg","image_focal_point":null,"image_alt_text":"JD Troutman hitting against Ottawa. ","video":null,"url":"/news/2026/2/7/baseball-neosho-completes-opening-weekend-sweep.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6188,"game_pregame_story_id":null,"game_postgame_story_id":3776,"date":"2026-02-07T12:00:00","end_date":null,"date_utc":"2026-02-07T18:00:00Z","end_date_utc":null,"time":"12:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":61,"prefix":null,"name":null,"title":"Ottawa University JV","image":"/images/logos/p10.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6188,"status":"W","team_score":"14","opponent_score":"3","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6188","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null},{"id":6158,"game_pregame_story_id":null,"game_postgame_story_id":3776,"date":"2026-02-07T14:00:00","end_date":null,"date_utc":"2026-02-07T20:00:00Z","end_date_utc":null,"time":"2:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":61,"prefix":null,"name":null,"title":"Ottawa University JV","image":"/images/logos/p10.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6158,"status":"W","team_score":"12","opponent_score":"1","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6158","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":12,"locked_ranking":false,"id":3776,"content_id":"3776","content_title":"Neosho Completes Opening Weekend Sweep","content_date":"2026-02-07T16:50:00","content_url":"https://goneosho.com/news/2026/2/7/baseball-neosho-completes-opening-weekend-sweep.aspx","content_image_url":"https://goneosho.com/images/2026/2/7/JD_Troutman_vs._Ottawa_2-7-26.jpeg","date":"2026-02-07T16:50:00"},{"title":"Panthers Open Season 2-0","title_in_rotator":true,"sub_headline":null,"teaser":"Chanute, KS- The Panthers open the season with a doubleheader sweep at home against Ottawa. Game 1, the final score was 1-0 and game 2 was 10-5. In game 1, the offense struggled to get much of anything going on with the lone run coming from a JD Troutman RBI double that scored Cole Spears. Will Burger got the start and earned his first win of the season, throwing 5 innings allowing just 2 hits with no runs and 7 strikeouts. In game 2, the offense found it's footing scoring 10 runs off 11 hits. Carson Hilton, Maverick Williamson, and Larsen Koester each collected multi-hit games with 6 combined runs scored. Cayden Neuharth got the win out of the bullpen throwing 3.2 innings in relief. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/2/6/Will_Burger_vs_Ottawa_2-6-26.jpeg","image_focal_point":null,"image_alt_text":"Will Burger pitching vs Ottawa.","video":null,"url":"/news/2026/2/6/baseball-panthers-open-season-2-0.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6157,"game_pregame_story_id":null,"game_postgame_story_id":3775,"date"