ub_headline":null,"teaser":"<strong>Chanute, KS-</strong> The Panthers drop a game at home against Butler. The final score was 8-4. The offense scored 2 runs in the bottom of the first thanks to a 2 RBI double from Luke Briley. The other 2 runs came in the 7th inning off the bat of Carson Hilton who had a 2 RBI single. The Panthers scored 4 runs off of 6 hits in the contest but unfortunately were unable to keep pace with the Grizzlies. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/3/17/Carson_vs_Butler.jpeg","image_focal_point":null,"image_alt_text":"Carson Hilton hitting against Butler. ","video":null,"url":"/news/2026/3/17/baseball-panthers-fall-against-butler.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6170,"game_pregame_story_id":null,"game_postgame_story_id":3808,"date":"2026-03-17T15:00:00","end_date":null,"date_utc":"2026-03-17T20:00:00Z","end_date_utc":null,"time":"3:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":10,"prefix":null,"name":null,"title":"Butler","image":"/images/logos/Butlet-CC.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6170,"status":"L","team_score":"4","opponent_score":"8","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6170","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":6,"locked_ranking":false,"id":3808,"content_id":"3808","content_title":"Panthers Fall Against Butler","content_date":"2026-03-17T18:57:00","content_url":"https://goneosho.com/news/2026/3/17/baseball-panthers-fall-against-butler.aspx","content_image_url":"https://goneosho.com/images/2026/3/17/Carson_vs_Butler.jpeg","date":"2026-03-17T18:57:00"},"location_name":null},{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Neosho Wins First Conference Weekend Against Labette","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS-</strong> The Panthers won both games of the home doubleheader against Labette. The final was a 19-6 run rule after 5 innings and the final in game 2 was 5-1. In game 1, the Panthers scored in every inning they went to the plate. The big inning was in the bottom of the 3rd when the offense pushed across 12 runs in the inning. In total the Panthers scored 19 runs off of 13 hits. 5 hitters collected multiple hits in the contest. Zach Grossnickle got the win on the mound, bringing his season win total to 3. In game 2, both offenses were relatively quiet compared to the previous game with the Panthers scoring 5 runs off of 4 hits. Austin O'Gorman earned his 2nd victory of the season after throwing 7 innings, allowing just 4 hits with no runs and a season high 12 strikeouts. ","type":"postgame","byline":null,"app_