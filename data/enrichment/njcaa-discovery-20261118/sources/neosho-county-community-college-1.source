core":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6166","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":8,"locked_ranking":false,"id":3802,"content_id":"3802","content_title":"Panthers Open Conference With Split","content_date":"2026-03-05T20:46:00","content_url":"https://goneosho.com/news/2026/3/5/baseball-panthers-open-conference-with-split.aspx","content_image_url":"https://goneosho.com/images/2026/3/5/Mav_vs_Labette_2026.jpeg","date":"2026-03-05T20:46:00"},{"title":"Panthers Fall Short At NEO","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Miami, OK-</strong> The Panthers fall short on the road against NEO by the final score of 14-10. In a back and forth contest, the Panthers were able to score 10 runs off of 9 hits. Luke Briley and Gabriel Rice collected multiple hits and multiple RBI on the afternoon. In the end, unfortunately the Panther offense wasn't able to keep pace with the NEO offense who scored 14 runs off 14 hits. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/2/20/NEO_pic.jpeg","image_focal_point":null,"image_alt_text":"AD Miller and JD Troutman turn a double play. ","video":null,"url":"/news/2026/2/20/baseball-panthers-fall-short-at-neo.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6191,"game_pregame_story_id":null,"game_postgame_story_id":3793,"date":"2026-02-20T14:00:00","end_date":null,"date_utc":"2026-02-20T20:00:00Z","end_date_utc":null,"time":"2:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"A","neutral_hometeam":false,"location":"Miami, OK","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":54,"prefix":null,"name":null,"title":"NEO","image":"/images/logos/NEO_AM.png"},"media":{"video":null,"video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6191,"status":"L","team_score":"10","opponent_score":"14","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6191","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":9,"locked_ranking":false,"id":3793,"content_id":"3793","content_title":"Panthers Fall Short At NEO","content_date":"2026-02-20T21:16:00","content_url":"https://goneosho.com/news/2026/2/20/baseball-panthers-fall-short-at-neo.aspx","content_image_url":"https://goneosho.com/images/2026/2/20/NEO_pic.jpeg","date":"2026-02-20T21:16:00"},{"title":"Neosho Drops Final Two Against Northeast Nebraska","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS- </strong>The Panthers lose the final two games against Northeast Nebraska to end the series. In game 1, the final score was 9-7 and the final in game 2 was 14-6. In game 1, the Panthers took a 3-2 lead going into the 5th inning before the Hawks were able to put up a 6 spot. Northeast would go on to add another run in the top of the 7th to go up 9-3. The Panthers didn't go down without a fight, putting up 4 runs of their own in the bottom of the 7th, unfortunately falling short. In game 2, Northeast jumped out to a 9 run lead after their first two innings on offense and the Panthers were unable to catch back up. Three Panthers hit the long ball in game 2 with 1 each coming from Larsen Koester, Luke Briley and Tucker Akins. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/2/16/Tucker_Akins_vs_NE_NEB.jpeg","image_focal_point":null,"image_alt_text":"Tucker Akins hitting a home run. ","video":null,"url":"/news/2026/2/16/baseball-neosho-drops-final-two-against-northeast-nebraska.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6189,"game_pregame_story_id":null,"game_postgame_story_id":3788,"date":"2026-02-16T12:00:00","end_date":null,"date_utc":"2026-02-16T18:00:00Z","end_date_utc":null,"time":"12:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":168,"prefix":null,"name":null,"title":"NE Nebraska","image":"/images/logos/Northeast_Community_College_Logo.png"},"m