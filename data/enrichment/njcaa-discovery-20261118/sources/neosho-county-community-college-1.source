<script>
    var obj = {"start":0,"count":8,"name":"all","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{},"context":null,"dummy":false,"type":"content-stream","id":"2db31227-aa85-4ddb-9cf1-ed4d209e215b","data":{"stream":[{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Coach Murry Inducted Into NJCAA Baseball Hall Of Fame","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Grand Junction, CO-  </strong>Head Coach Steve Murry was inducted into the NJCAA Hall of Fame in Grand Junction, Colorado at the World Series. During his 40 year stint, the Panthers have won 1254 games,Jayhawk Conference Championships in 1994, 2003, 2006 and 2016 and Jayhawk Conference Eastern Division Sub-Regional Championships in 1999, 2006, 2011, 2012, 2013, & 2016. The Panthers set a school record with 51 wins in 2016.The Panthers also won Region VI Champions in 2003, 2012, and 2013, qualifying for the World Series all three years. They were also Regional Runner-up in 1999, 2001, and 2017. In those 40 years, his teams have combined for over 50,000 hours of community service. Coach Murry will return this fall for his 41st season. ","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/8/3/Steve_Murry_HOF.jpeg","image_focal_point":null,"image_alt_text":"Steve Murry Hall of Fame ceremony. ","video":null,"url":"/news/2026/6/1/coach-murry-inducted-into-njcaa-baseball-hall-of-fame.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":1,"locked_ranking":false,"id":3820,"content_id":"3820","content_title":"Coach Murry Inducted Into NJCAA Baseball Hall Of Fame","content_date":"2026-06-01T11:03:00","content_url":"https://goneosho.com/news/2026/6/1/coach-murry-inducted-into-njcaa-baseball-hall-of-fame.aspx","content_image_url":"https://goneosho.com/images/2026/8/3/Steve_Murry_HOF.jpeg","date":"2026-06-01T11:03:00"},"location_name":null},{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Seventeen Panther Baseball Players Named to NJCAA All-Academic Teams","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS- </strong>The Panther baseball team had 17 players (listed below) named to the NJCAA All-Academic teams. A combined team GPA of 3.70 was 1st in the KJCCC and 8th best in the NJCAA. ","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/7/30/KJCCC_All_Academic.jpeg","image_focal_point":null,"image_alt_text":"Baseball NJCAA All-Academic players.","video":null,"url":"/news/2026/7/30/seventeen-panther-baseball-players-named-to-njcaa-all-academic-teams.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":2,"locked_ranking":false,"id":3818,"content_id":"3818","content_title":"Seventeen Panther Baseball Players Named to NJCAA All-Academic Teams","content_date":"2026-07-30T14:43:00","content_url":"https://goneosho.com/news/2026/7/30/seventeen-panther-baseball-players-named-to-njcaa-all-academic-teams.aspx","content_image_url":"https://goneosho.com/images/2026/7/30/KJCCC_All_Academic.jpeg","date":"2026-07-30T14:43:00"},"location_name":null},{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Neosho County Student-Athletes Earn KJCCC All-Academic Honors","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>CHANUTE, Kan.</strong> – Neosho County Community College is proud to announce that 94 student-athletes have been named to the 2025-26 Kansas Jayhawk Community College Conference (KJCCC) All-Academic Team, recognizing their outstanding achievements in the classroom while competing in one of the nation's premier junior college athletic conferences.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, Men's Basketball, Men's Soccer, Softball, Cross Country/Track & Field, Women's Basketball, Women's Soccer, Women's Volleyball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/7/30/All-Academic_Awards_-_Landscape.jpg","image_focal_point":null,"image_alt_text":"2025-26 KJCAA All-Academic Honors","video":null,"url":"/news/2026/7/30/baseball-neosho-county-student-athletes-earn-kjccc-all-academic-honors.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":3,"locked_ranking":false,"id":3817,"content_id":"3817","content_title":"Neosho County Student-Athletes Earn KJCCC All-Academic Honors","content_date":"2026-07-30T13:01:00","content_url":"https://goneosho.com/news/2026/7/30/baseball-neosho-county-student-athletes-earn-kjccc-all-academic-honors.aspx","content_image_url":"https://goneosho.com/images/2026/7/30/All-Academic_Awards_-_Landscape.jpg","date":"2026-07-30T13:01:00"},"location_name":null},{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Panthers Sweep At Allen, Win Series 3-1","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Iola, KS-</strong> The Panthers won both games of the doubleheader in Iola against Allen to win the series 3-1. The final in game 1 was 20-16 and the final in game 2 was 14-8. In game 1, the offense scored 20 runs off of 17 hits and put up at least 1 run in every inning. 7 Panther hitters recorded multiple hits with Maverick Williamson and Gabe Rice both hitting a home run. Zach Grossnickle got his 5th win of the season on the mound. In game 2, the offense stayed hot scoring 14 runs off of 15 hits. 5 Panther hitters recorded multiple hits with 2 more long balls coming from Carson Hilton and Tucker Akins. Carter Liezert earned his 1st victory of the season after throwing 5 innings out of the bullpen. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/3/22/Blake_vs_Allen.jpeg","image_focal_point":null,"image_alt_text":"Blake Ellis hitting against Allen.","video":null,"url":"/news/2026/3/21/baseball-panthers-sweep-at-allen-win-series-3-1.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6200,"game_pregame_story_id":null,"game_postgame_story_id":3810,"date":"2026-03-21T13:00:00","end_date":null,"date_utc":"2026-03-21T18:00:00Z","end_date_utc":null,"time":"1:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"A","neutral_hometeam":false,"location":"Iola, KS","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":3,"prefix":null,"name":null,"title":"Allen ","image":"/images/logos/Allen-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6200,"status":"W","team_score":"20","opponent_score":"16","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6200","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null},{"id":6172,"game_pregame_story_id":null,"game_postgame_story_id":3810,"date":"2026-03-21T15:00:00","end_date":null,"date_utc":"2026-03-21T20:00:00Z","end_date_utc":null,"time":"3:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"A","neutral_hometeam":false,"location":"Iola, KS","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":3,"prefix":null,"name":null,"title":"Allen ","image":"/images/logos/Allen-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6172,"status":"W","team_score":"14","opponent_score":"8","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6172","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":4,"locked_ranking":false,"id":3810,"content_id":"3810","content_title":"Panthers Sweep At Allen, Win Series 3-1","content_date":"2026-03-21T22:30:00","content_url":"https://goneosho.com/news/2026/3/21/baseball-panthers-sweep-at-allen-win-series-3-1.aspx","content_image_url":"https://goneosho.com/images/2026/3/22/Blake_vs_Allen.jpeg","date":"2026-03-21T22:30:00"},"location_name":null},{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Neosho Splits Opener Against Allen","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS-</strong> The Panthers split the first doubleheader at home against Allen. The final score of game 1 was 8-1 in a losing effort but the team bounced back in game 2 to win 16-5. In game 1, the Panthers jumped out to a 1-0 lead in the bottom of the 1st thanks to a RBI from Luke Briley. Unfortunately, that was the only scoring from the offense in the game. In game 2, the story was a little bit different as the Panthers scored 16 runs off of 13 hits. Of those 13 hits, 9 of them were for extra bases including 4 home runs, 2 of which came from JD Troutman. Maverick Williamson and Tucker Akins were responsible for the other 2 long balls. On the mound, Cayden Neuharth earned his 4th victory of the season after throwing 6 innings with 9 strikeouts. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/3/19/Tucker_vs_Allen.jpeg","image_focal_point":null,"image_alt_text":"Tucker Akins with a home run against Allen. ","video":null,"url":"/news/2026/3/19/baseball-neosho-splits-opener-against-allen.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6171,"game_pregame_story_id":null,"game_postgame_story_id":3809,"date":"2026-03-19T13:00:00","end_date":null,"date_utc":"2026-03-19T18:00:00Z","end_date_utc":null,"time":"1:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":3,"prefix":null,"name":null,"title":"Allen ","image":"/images/logos/Allen-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6171,"status":"L","te