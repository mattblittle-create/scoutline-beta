e from Luke Briley. The other 2 runs came in the 7th inning off the bat of Carson Hilton who had a 2 RBI single. The Panthers scored 4 runs off of 6 hits in the contest but unfortunately were unable to keep pace with the Grizzlies. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/3/17/Carson_vs_Butler.jpeg","image_focal_point":null,"image_alt_text":"Carson Hilton hitting against Butler. ","video":null,"url":"/news/2026/3/17/baseball-panthers-fall-against-butler.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6170,"game_pregame_story_id":null,"game_postgame_story_id":3808,"date":"2026-03-17T15:00:00","end_date":null,"date_utc":"2026-03-17T20:00:00Z","end_date_utc":null,"time":"3:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":10,"prefix":null,"name":null,"title":"Butler","image":"/images/logos/Butlet-CC.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6170,"status":"L","team_score":"4","opponent_score":"8","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6170","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":6,"locked_ranking":false,"id":3808,"content_id":"3808","content_title":"Panthers Fall Against Butler","content_date":"2026-03-17T18:57:00","content_url":"https://goneosho.com/news/2026/3/17/baseball-panthers-fall-against-butler.aspx","content_image_url":"https://goneosho.com/images/2026/3/17/Carson_vs_Butler.jpeg","date":"2026-03-17T18:57:00"},{"title":"Neosho Wins First Conference Weekend Against Labette","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS-</strong> The Panthers won both games of the home doubleheader against Labette. The final was a 19-6 run rule after 5 innings and the final in game 2 was 5-1. In game 1, the Panthers scored in every inning they went to the plate. The big inning was in the bottom of the 3rd when the offense pushed across 12 runs in the inning. In total the Panthers scored 19 runs off of 13 hits. 5 hitters collected multiple hits in the contest. Zach Grossnickle got the win on the mound, bringing his season win total to 3. In game 2, both offenses were relatively quiet compared to the previous game with the Panthers scoring 5 runs off of 4 hits. Austin O'Gorman earned his 2nd victory of the season after throwing 7 innings, allowing just 4 hits with no runs and a season high 12 strikeouts. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/3/8/O_Gorman_vs_Labette.jpeg","image_focal_point":null,"image_alt_text":"Austin O'Gorman pitching against Labette. ","video":null,"url":"/news/2026/3/8/baseball-neosho-wins-first-conference-weekend-against-labette.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6167,"game_pregame_story_id":null,"game_postgame_story_id":3805,"date":"2026-03-08T13:00:00","end_date":null,"date_utc":"2026-03-08T18:00:00Z","end_date_utc":null,"time":"1:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":45,"prefix":null,"name":null,"title":"Labette ","image":"/images/logos/Labette-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6167,"status":"W","team_score":"19","opponent_score":"6","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6167","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null},{"id":6196,"game_pregame_story_id":null,"game_postgame_story_id":3805,"date":"2026-03-08T15:00:00","end_date":null,"date_utc":"2026-03-08T20:00:00Z","end_date_utc":null,"time":"3:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":45,"prefix":null,"name":null,"title":"Labette ","image":"/images/logos/Labette-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6196,"status":"W","team_score":"5","opponent_score":"1","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6196","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":7,"locked_ranking":false,"id":3805,"content_id":"3805","content_title":"Neosho Wins First Conference Weekend Against Labette","content_date":"2026-03-08T20:34:00","content_url":"https://goneosho.com/news/2026/3/8/baseball-neosho-wins-first-conference-weekend-against-labette.aspx","content_image_url":"https://goneosho.com/images/2026/3/8/O_Gorman_vs_Labette.jpeg","date":"2026-03-08T20:34:00"},{"title":"Panthers Open Conference With Split","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Parsons, KS- </strong>The Panthers opened their conference schedule with a split against Labette. The first game was a 4-0 loss but bounced back in game 2 with a 17-3 run rule. In game 1, the offense struggled to get much of anything going resulting in no runs and a loss. In game 2, the Panthers flipped a switch. On the mound, Cayden Neuharth earned the victory after throwing 5 innings, while allowing just 1 unearned run and 4 hits. The offense came out of the gate swinging with 1 run in the 1st, followed by 4 run innings in the 2nd, 4th, 5th and 6th. The Panthers totaled 17 runs off of 16 hits in the contest. 5 hitters collected multi-hit games. Maverick Williamson lead the way with 3 hits, 2 runs scored and 8 RBI. Luke Briley collected 2 hits, 1 run scored and 3 RBI. Both Panther Sophomore's added a home run to their season total. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/3/5/Mav_vs_Labette_2026.jpeg","image_focal_point":null,"image_alt_text":"Maverick Williamson with a grand slam. ","video":null,"url":"/news/2026/3/5/baseball-panthers-open-conference-with-split.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6195,"game_pregame_story_id":null,"game_postgame_story_id":3802,"date":"2026-03-05T13:00:00","end_date":null,"date_utc":"2026-03-05T19:00:00Z","end_date_utc":null,"time":"1:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"A","neutral_hometeam":false,"location":"Parsons, KS","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":45,"prefix":null,"name":null,"title":"Labette ","image":"/images/logos/Labette-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6195,"status":"L","team_score":"0","opponent_score":"4","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6195","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null},{"id":6166,"game_pregame_story_id":null,"game_postgame_story_id":3802,"date":"2026-03-05T15:00:00","end_date":null,"date_utc":"2026-03-05T21:00:00Z","end_date_utc":null,"time":"3:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"A","neutral_hometeam":false,"location":"Parsons, KS","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":true,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":45,"prefix":null,"name":null,"title":"Labette ","image":"/images/logos/Labette-Community-College.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6166,"status":"W","team_score":"17","opponent_score":"3","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6166","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":8,"locked_ranking":false,"id":3802,"content_id":"3802","content_title":"Panthers Open Conference With Split","content_date":"2026-03-05T20:46:00","content_url":"https://goneosho.com/news/2026/3/5/baseball-panthers-open-conference-with-split.aspx","content_image_url":"https://goneosho.com/images/2026/3/5/Mav_vs_Labette_2026.jpeg","date":"2026-03-05T20:46:00"},{"title":"Panthers Fall Short At NEO","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Miami, OK-</strong> The Panthers fall short on the road against NEO by the final score of 14-10. In a back and forth contest, the Panthers were able to score 10 runs off of 9 hits. Luke Briley and Gabriel Rice collected multiple hits and multiple RBI on the afternoon. In the end, unfortunately the Panther offense wasn't able to keep pace with the NEO offense who scored 14 runs off 14 hits. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/2/20/NEO_pic.jpeg","image_focal_point":null,"image_alt_text":"AD Miller and JD Troutman turn a double play. ","video":null,"url":"/news/2026/2/20/baseball-panthers-fall-short-at-neo.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6191,"game_pregame_story_id":null,"game_postgame_story_id":3793,"date":"2026-02-20T14:00:00","end_date":null,"date_utc":"2026-02-20T20:00:00Z","end_date_utc":null,"time":"2:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"A","neutral_hometeam":false,"location":"Miami, OK","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":54,"prefix":null,"name":null,"title":"NEO","image":"/images/logos/NEO_AM.png"},"media":{"video":null,"video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"custom3":null,"gamefiles":null,"program":null,"program_text":null},"story":null,"result":{"game_id":6191,"status":"L","team_score":"10","opponent_score":"14","prescore":null,"postscore":null,"bid":null,"boxscore":"/boxscore.aspx?id=6191","line_scores":null},"game_facility":null,"promotion":null,"event_image":null,"pac_tickets":null}],"gallery_id":0,"writer":null,"ranking":9,"locked_ranking":false,"id":3793,"content_id":"3793","content_title":"Panthers Fall Short At NEO","content_date":"2026-02-20T21:16:00","content_url":"https://goneosho.com/news/2026/2/20/baseball-panthers-fall-short-at-neo.aspx","content_image_url":"https://goneosho.com/images/2026/2/20/NEO_pic.jpeg","date":"2026-02-20T21:16:00"},{"title":"Neosho Drops Final Two Against Northeast Nebraska","title_in_rotator":true,"sub_headline":null,"teaser":"<strong>Chanute, KS- </strong>The Panthers lose the final two games against Northeast Nebraska to end the series. In game 1, the final score was 9-7 and the final in game 2 was 14-6. In game 1, the Panthers took a 3-2 lead going into the 5th inning before the Hawks were able to put up a 6 spot. Northeast would go on to add another run in the top of the 7th to go up 9-3. The Panthers didn't go down without a fight, putting up 4 runs of their own in the bottom of the 7th, unfortunately falling short. In game 2, Northeast jumped out to a 9 run lead after their first two innings on offense and the Panthers were unable to catch back up. Three Panthers hit the long ball in game 2 with 1 each coming from Larsen Koester, Luke Briley and Tucker Akins. ","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PLgE5laRexONXXPMiLaKQtSJCr_wWlUP-R","facebook":"https://www.facebook.com/groups/NeoshoBaseball/","twitter":"GoNeoshoBasebal","instagram":"nc_baseball","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/2/16/Tucker_Akins_vs_NE_NEB.jpeg","image_focal_point":null,"image_alt_text":"Tucker Akins hitting a home run. ","video":null,"url":"/news/2026/2/16/baseball-neosho-drops-final-two-against-northeast-nebraska.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[{"id":6189,"game_pregame_story_id":null,"game_postgame_story_id":3788,"date":"2026-02-16T12:00:00","end_date":null,"date_utc":"2026-02-16T18:00:00Z","end_date_utc":null,"time":"12:00 P.M.","is_doubleheader":false,"allday":false,"tbd":false,"team_prefix":"","status":"O","location_indicator":"H","neutral_hometeam":false,"location":"Hudson Field","conference":null,"conference_abbrev":null,"conference_logo":null,"is_conference":false,"show_atvs":false,"is_spotlight":false,"type":"recent","tournament":null,"sport":null,"schedule":null,"opponent":{"id":168,"prefix":null,"name":null,"title":"NE Nebraska","image":"/images/logos/Northeast_Community_College_Logo.png"},"media":{"video":"https://team1sports.com/neosho/","video_text":null,"audio":null,"audio_text":null,"stats":null,"tickets":null,"game_note":null,"game_promotion_name":null,"tv":null,"tv_image":null,"tv_image_link":null,"radio":null,"custom1":null,"custom2":null,"cu