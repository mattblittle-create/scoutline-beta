                                    <button id="component-headlines-116-toggle-carousel" aria-label="stop slide rotation" class="btn carousel-control-pp pp  pause "><span class="fa fa-pause"></span> <span class="text visually-hidden">Play/Pause</span></button>
        <script>
            $(function() {
                var paused = 0;
                $("#component-headlines-116-carousel").carousel({
                    interval: 8000,
                    pause: false
                });

                $('#component-headlines-116-toggle-carousel').click(function() {
                    var state = (paused) ? 'cycle' : 'pause';
                    paused = (paused) ? 0 : 1;
                    $("#component-headlines-116-carousel").carousel(state);
                    $(this).find('.fa').toggleClass('fa-play fa-pause');
                });
            })
        </script>
                        <script>
        $(function() {
            let carousel = document.querySelector('#component-headlines-116-carousel');
            let bsCarousel = bootstrap.Carousel.getOrCreateInstance(carousel);

            // Sync right-column indicator active state with carousel position
            carousel.addEventListener('slide.bs.carousel', (event) => {
                let items = document.querySelector("#component-headlines-116-indicators").children;
                items.item(event.from).classList.remove("active");
                items.item(event.to).classList.add("active");
            });

            // Navigate to article when link inside indicator is activated
            $("#component-headlines-116-indicators li a.item-link").on("click", function(e) {
                e.preventDefault();
                window.location.href = $(this).attr('href');
            });

            // Keyboard support: Enter or Space switches the slide via indicator items
            $("#component-headlines-116-indicators li").on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    $(this).trigger("click");
                }
            });

                        // Pause autoplay on hover or focus; resume when interaction ends
            var isHovered = false;
            var isFocused = false;
            var resumeTimer = null;
            var indicators = document.querySelector('#component-headlines-116-indicators');

            function tryResume() {
                clearTimeout(resumeTimer);
                resumeTimer = setTimeout(function() {
                    if (!isHovered && !isFocused) {
                        var $ppBtn = $('#component-headlines-116-toggle-carousel');
                        if ($ppBtn.length === 0 || $ppBtn.hasClass('pause')) {
                            bsCarousel.cycle();
                        }
                    }
                }, 50);
            }

            $(carousel).add(indicators).on('mouseenter', function() {
                isHovered = true;
                clearTimeout(resumeTimer);
                bsCarousel.pause();
            }).on('mouseleave', function() {
                isHovered = false;
                tryResume();
            });

            $(carousel).add(indicators).on('focusin', function() {
                isFocused = true;
                clearTimeout(resumeTimer);
                bsCarousel.pause();
            }).on('focusout', function() {
                setTimeout(function() {
                    var active = document.activeElement;
                    isFocused = carousel.contains(active) || indicators.contains(active);
                    if (!isFocused) tryResume();
                }, 10);
            });
                    })
    </script>
