    <script>
        require(['jquery', 'slick'], function($) {

            // Update active story slides
            if ($('.s-stories__featured stories-component').length) {
                observedNodeStories = $('.s-stories__featured stories-component')[0];
                var listObserverStories = new MutationObserver(function(){
                    listObserverStories.disconnect();

                    if ($(window).width() < 1280) { return }

                    $('.c-stories--featured').on('beforeChange', function(event, slick, currentSlide, nextSlide){
                        var $list      = $('.c-stories__list');
                        var $all_items = $('.c-stories__list li');
                        var $next_item = $('.c-stories__list li:eq('+ nextSlide +')');

                        $list.animate({
                            scrollTop: $list.scrollTop() + $next_item.position().top
                        }, 500);
                    });

                });
                listObserverStories.observe(observedNodeStories, {attributes: true, childList: true});
            }
        });
    </script>


