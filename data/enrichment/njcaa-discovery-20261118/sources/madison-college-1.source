<script>
    var obj = {"start":0,"count":6,"name":"","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{"sports":[{"id":14,"title":"Alumni"},{"id":1,"title":"Baseball"},{"id":10,"title":"Camps & Clinics"},{"id":12,"title":"Esports"},{"id":3,"title":"General"},{"id":4,"title":"Men's Basketball"},{"id":5,"title":"Men's Golf"},{"id":6,"title":"Men's Soccer"},{"id":13,"title":"ONEPACK"},{"id":7,"title":"Softball"},{"id":8,"title":"Women's Basketball"},{"id":15,"title":"Women's Golf"},{"id":11,"title":"Women's Soccer"},{"id":9,"title":"Women's Volleyball"}]},"context":null,"dummy":false,"type":"stories","id":"701114e2-798f-4cf2-b0a0-9da17da5b723","data":[{"title":"Madison College Athletic Hall of Fame inducts Class of 2026","title_in_rotator":true,"sub_headline":"Longtime women's basketball coach recognized alongside four-member induction class","teaser":"The Madison College Athletic <a href=\"/honors/hall-of-fame?type=class_induction\">Hall of Fame</a> inducted a four-member Class of 2026 on Thursday night as the kickoff event for the Athletics Alumni Weekend, an annual event held the second weekend in October. The group includes former student-athletes Shane Ellis (men's basketball), Brandon Gibis (baseball), Patrick Houlihan (men's soccer), and Brock Roder (men's basketball). Gibis was also presented his plaque for 2026 induction into the Region 4 Hall of Fame, while longtime women's basketball coach Mike Mayfield was presented with the Doug Redsten Memorial Service Award. The ceremony was held at Diane's Delicious Diner on the Truax Campus.","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, Men's Basketball, Men's Soccer, Alumni","sport":{"id":14,"title":"Alumni","abbreviation":"Alumni","shortname":"alumni","short_title":"Alumni","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"alumni","gender":" ","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"