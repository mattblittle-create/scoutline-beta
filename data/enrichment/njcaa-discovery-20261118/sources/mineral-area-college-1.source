        <script>

$(document).ready(function() {
    
    var el = $('#nav')
    console.log(el)
    var bounds = el.offset().top + 3;
    $(window).on('scroll', function(e) {
        var scrolled = $(window).scrollTop();

            if (scrolled > bounds) {
                    console.log('scrolled down')
                    console.log('scrolled ' + scrolled)
                    console.log('bounds ' + bounds)
            }

            if (scrolled < bounds) {
                   console.log('up')
                   console.log('scrolled ' + scrolled)
                    console.log('bounds ' + bounds)
            }
    });
})
    
</script>

