               	<div class="journal-content-article" id="article_331278_443301_1.0">	<div id="content-wrap">	<h2>	ATHLETICS</h2>
</div></div><script type="text/javascript">/*<![CDATA[*/function _56_INSTANCE_hWb3_getEditRequestPopup(b){var a=new Liferay.Popup({title:"Request for change",position:["center",50],modal:true,width:500,draggable:false,height:350,url:b})};/*]]>*/</script></div></div><script type="text/javascript">/*<![CDATA[*/Liferay.Portlet.onLoad({canEditTitle:false,columnPos:2,isStatic:"end",namespacedId:"p_p_id\u005f\u0035\u0036\u005f\u0049\u004e\u0053\u0054\u0041\u004e\u0043\u0045\u005f\u0068\u0057\u0062\u0033\u005f",portletId:"\u0035\u0036\u005f\u0049\u004e\u0053\u0054\u0041\u004e\u0043\u0045\u005f\u0068\u0057\u0062\u0033"});/*]]>*/</script></div><div id="p_p_id_66_INSTANCE_G7m4_" class="portlet-boundary portlet-boundary_66_  portlet-web-proxy" >	<a id="p_66_INSTANCE_G7m4"></a>	<div class="portlet-borderless-container" style="">	<div>	</div></div><script type="text/javascript">/*<![CDATA[*/Liferay.Portlet.onLoad({canEditTitle:false,columnPos:3,isStatic:"end",namespacedId:"p_p_id\u005f\u0036\u0036\u005f\u0049\u004e\u0053\u0054\u0041\u004e\u0043\u0045\u005f\u0047\u0037\u006d\u0034\u005f",portletId:"\u0036\u0036\u005f\u0049\u004e\u0053\u0054\u0041\u004e\u0043\u0045\u005f\u0047\u0037\u006d\u0034"});/*]]>*/</script></div><div id="p_p_id_56_INSTANCE_1mvK_" class="portlet-boundary portlet-boundary_56_  portlet-journal-content" >	<a id="p_56_INSTANCE_1mvK"></a>	<div class="portlet-borderless-container" style="">	<div>
 
                
               	<div class="journal-content-article" id="article_427615_5647160_1.0">	<div id="content-wrap">	<p>	<strong style="font-family:arial,helvetica,sans-serif; font-size:13.3333px"><a href="http://athletics.lakelandcc.edu" style="color: rgb(0, 51, 153); font-size: 10pt !important;" target="_blank">Click here to visit Lakeland's Athletic web site</a></strong></p>	<p class="customize-lead">	Lakeland Community College is proud to offer seven varsity athletic teams. Women's sports include volleyball, basketball, and softball. On the men's side, Lakeland offers soccer, basketball and&nbsp;baseball. Lakeland's team is known as the Lakers and they participate in Region XII of the NJCAA and the Ohio Community College Athletic Conference (OCCAC).</p>	<p>	Throughout the years, Lakeland has won many conference championships and participated in nationals several times. The athletic department strongly supports the academic mission of the institution and looks to create an environment that promotes excellence in the classroom, on the courts/fields, and in the community.</p>	<table cellpadding="5" style="margin-left:auto; margin-right:auto; width:100%">	<tbody>	<tr><td class="page-subheader">	<a href="http://athletics.lakelandcc.edu/sports/bsb/index" target="_blank">Men's Baseball</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="http://athletics.lakelandcc.edu/sports/bsb/index" target="_blank">News</a> | <a href="http://athletics.lakelandcc.edu/sports/bsb/index" target="_blank">Roster</a> | <a href="http://athletics.lakelandcc.edu/sports/bsb/index" target="_blank">Schedule/Results</a> | <a href="http://athletics.lakelandcc.edu/sports/bsb/index" target="_blank">Coaches</a></td></tr><tr><td class="page-subheader">	<a href="http://athletics.lakelandcc.edu/sports/mbkb/index" target="_blank">Men's Basketball</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="http://athletics.lakelandcc.edu/sports/mbkb/index" target="_blank">News</a> | <a href="http://athletics.lakelandcc.edu/sports/mbkb/index" target="_blank">Roster</a> | <a href="http://athletics.lakelandcc.edu/sports/mbkb/index" target="_blank">Schedule/Results</a> | <a href="http://athletics.lakelandcc.edu/sports/mbkb/index" target="_blank">Coaches</a></td></tr><tr><td class="page-subheader">	<a href="http://athletics.lakelandcc.edu/sports/msoc/index" target="_blank">Men's Soccer</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="http://athletics.lakelandcc.edu/sports/msoc/index" target="_blank">News</a> | <a href="http://athletics.lakelandcc.edu/sports/msoc/index" target="_blank">Roster</a> | <a href="http://athletics.lakelandcc.edu/sports/msoc/index" target="_blank">Schedule/Results</a> | <a href="http://athletics.lakelandcc.edu/sports/msoc/index" target="_blank">Coaches</a></td></tr><tr><td class="page-subheader">	<a href="http://athletics.lakelandcc.edu/sports/wbkb/index">Women's Basketball</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="http://athletics.lakelandcc.edu/sports/wbkb/index">News</a> | <a href="http://athletics.lakelandcc.edu/sports/wbkb/index">Roster</a> | <a href="http://athletics.lakelandcc.edu/sports/wbkb/index">Schedule/Results</a> | <a href="http://athletics.lakelandcc.edu/sports/wbkb/index">Coaches</a></td></tr><tr><td class="page-subheader">	<a href="https://athletics.lakelandcc.edu/sports/wsoc/index" target="_blank">Women's Soccer</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="https://athletics.lakelandcc.edu/sports/wsoc/index" target="_blank">News</a> | <a href="https://athletics.lakelandcc.edu/sports/wsoc/2021-22/roster" target="_blank">Roster</a> | <a href="https://athletics.lakelandcc.edu/sports/wsoc/2021-22/schedule" target="_blank">Schedule/Results</a> | <a href="https://athletics.lakelandcc.edu/information/directory/index" target="_blank">Coaches</a></td></tr><tr><td class="page-subheader">	<a href="http://athletics.lakelandcc.edu/sports/sball/index" target="_blank">Women's Softball</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="http://athletics.lakelandcc.edu/sports/sball/index" target="_blank">News</a> | <a href="http://athletics.lakelandcc.edu/sports/sball/index" target="_blank">Roster</a> | <a href="http://athletics.lakelandcc.edu/sports/sball/index" target="_blank">Schedule/Results</a> | <a href="http://athletics.lakelandcc.edu/sports/sball/index" target="_blank">Coaches</a></td></tr><tr><td class="page-subheader">	<a href="http://athletics.lakelandcc.edu/sports/wvball/index" target="_blank">Women's Volleyball</a></td></tr><tr><td style="padding-bottom:20px;">	<a href="http://athletics.lakelandcc.edu/sports/wvball/index" target="_blank">News</a> | <a href="http://athletics.lakelandcc.edu/sports/wvball/index" target="_blank">Roster</a> | <a href="http://athletics.lakelandcc.edu/sports/wvball/index" target="_blank">Schedule/Results</a> | <a href="http://athletics.lakelandcc.edu/sports/wvball/index" target="_blank">Coaches</a></td></tr></tbody>	</table></div></div><script type="text/javascript">/*<![CDATA[*/function _56_INSTANCE_1mvK_getEditRequestPopup(b){var a=new Liferay.Popup({title:"Request for change",position:["center",50],modal:true,width:500,draggable:false,height:350,url:b})};/*]]>*/</script></div></div><script type="text/javascript">/*<![CDATA[*/Liferay.Portlet.onLoad({canEditTitle:false,columnPos:4,isStatic:"end",namespacedId:"p_p_id\u005f\u0035\u0036\u005f\u0049\u004e\u0053\u0054\u0041\u004e\u0043\u0045\u005f\u0031\u006d\u0076\u004b\u005f",portletId:"\u0035\u0036\u005f\u0049\u004e\u0053\u0054\u0041\u004e\u0043\u0045\u005f\u0031\u006d\u0076\u004b"});/*]]>*/</script></div></div></div><div class="column-4 lfr-column spacebar2 " id="column-3"> <div class="lfr-portlet-column" id="layout-column_column-3">	<div id="p_p_id_56_INSTANCE_B5Br_" class="portlet-boundary portlet-boundary_56_  portlet-journal-content" >	<a id="p_56_INSTANCE_B5Br"></a>	<div class="portlet-borderless-container" style="">	<div>
 
                
