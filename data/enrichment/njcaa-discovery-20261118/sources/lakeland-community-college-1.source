<script type='text/javascript'>
    var CGU = jQuery.fn;
    var SlideCount = 1;
CGU.extend({
  SplitID : function()
  {
    return this.attr('id').split('-').pop();
  },
  Slideshow : {
    Ready : function()
    {
      jQuery('div.tmpSlideshowControl')
        .hover(
          function() {
            jQuery(this).addClass('tmpSlideshowControlOn');
          },
          function() {
            jQuery(this).removeClass('tmpSlideshowControlOn');
          }
        )
        .click(
          function() {
            CGU.Slideshow.Interrupted = true;
            jQuery('div.tmpSlide').hide();
            jQuery('div.tmpSlideshowControl').removeClass('tmpSlideshowControlActive');
            jQuery('div#tmpSlide-' + jQuery(this).SplitID()).show()
            jQuery(this).addClass('tmpSlideshowControlActive');
          }
        );
      this.Counter = 1;
      this.Interrupted = false;
      this.Transition();
    },
    Transition : function()
    {
      if (this.Interrupted) {
        return;
      }
      this.Last = this.Counter - 1;
      if (this.Last < 1) {
        this.Last = SlideCount;
      }
      jQuery('div#tmpSlide-' + this.Last).fadeOut(
        'slow',
        function() {
          jQuery('div#tmpSlideshowControl-' + CGU.Slideshow.Last).removeClass('tmpSlideshowControlActive');
          jQuery('div#tmpSlideshowControl-' + CGU.Slideshow.Counter).addClass('tmpSlideshowControlActive');
          jQuery('div#tmpSlide-' + CGU.Slideshow.Counter).fadeIn('slow');
          CGU.Slideshow.Counter++;
          if (CGU.Slideshow.Counter >SlideCount) {
            CGU.Slideshow.Counter = 1;
          }
          setTimeout('CGU.Slideshow.Transition();', 5000);
        }
      );
    }
  }
});
jQuery(document).ready(
  function() {
    CGU.Slideshow.Ready();
  }
);
    
    </script><div id="banner-cont">
