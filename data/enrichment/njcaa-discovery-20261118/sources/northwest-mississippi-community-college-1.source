<!-- /ko --></script><script type='text/html' id='template-search'><!-- ko if: name() === 'nav-search' -->
    <div class="component c-search c-search--popout" role="search" data-bind="css: {'is-open': toggled()}">
        <button type="button" class="c-search__toggle" aria-label="Toggle search form" data-bind="click: toggleSearch, attr: {'aria-expanded': toggled() ? 'true' : 'false'}, css: {'is-toggled' : toggled()}">
            <i class="sf-search-2-minimal"></i>
