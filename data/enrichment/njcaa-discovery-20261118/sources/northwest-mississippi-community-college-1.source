                        <!-- ko case: status === 'C' -->
                            <span class="c-events__final">Cancelled</span>  
                        <!-- /ko -->
                        <!-- ko case: $else -->
                            <span class="c-events__final">Final</span>
                        <!-- /ko -->
                    <!-- /ko -->
                <!-- /ko -->
            </div>
            <div class="c-events__body flex flex-column">
                <div class="c-events__team-container flex flex-align-center flex-justify-between">
