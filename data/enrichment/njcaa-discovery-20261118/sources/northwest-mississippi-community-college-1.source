    <script>
        require(["knockout", "jquery", "moment", "binding-handlers"], function (ko, $) {
            var vm = function () {
                var self = this;
                    self.liveEvents = ko.observableArray();
                    self.archiveEvents = ko.observableArray();
                    self.selectedMedia = ko.observable();
                    self.gameDate = ko.observable(new Date());
                    self.category = ko.observable();
                    self.categories = ko.observableArray();
                    self.date_utc = ko.observable(new Date());
                    self.sport = ko.observable();
                    self.sports = ko.observableArray();

                $.get("/services/allaccess.ashx/media/get", { type:"Live", count:8 })
                    .done(function(resp){
                        self.liveEvents(resp);
                    });

            };

            ko.applyBindings(new vm(), $('.live-video-list')[0]);

        });
    </script>

            </main>
            

