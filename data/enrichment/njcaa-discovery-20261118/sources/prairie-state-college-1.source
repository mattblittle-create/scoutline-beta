<script>
    var obj = {"start":0,"count":6,"name":"top-stories-sport","sport_id":null,"count_breakpoints":"[{\"breakpoint\":0,\"count\":3},{\"breakpoint\":1025,\"count\":6}]","css_class":"","pinned_id":"","extra":{"sports":[{"id":1,"title":"Baseball"},{"id":2,"title":"General"},{"id":3,"title":"Men's Basketball"},{"id":4,"title":"Men's Soccer"},{"id":5,"title":"Men's Tennis"},{"id":6,"title":"Softball"},{"id":7,"title":"Women's Basketball"},{"id":8,"title":"Women's Soccer"},{"id":13,"title":"Women's Tennis"},{"id":9,"title":"Women's Volleyball"}]},"context":null,"dummy":false,"type":"stories","id":"b04f6f5d-70d3-4350-a8ca-62ad0f681de0","data":[{"title":"Contreras Blasts Help Close Out Regular Season With Bang","title_in_rotator":true,"sub_headline":null,"teaser":"<span style=\"font-family:tahoma;\"><strong><span style=\"color:#006400;\">MILWAUKEE, Wis. ---</span> </strong>Sophomore <dfn><a href=\"/sports/baseball/roster/jesser-contreras/977\" rel=\"smarttag\" rev=\"977\">Jesser Contreras</a></dfn> (The Vine Christian Academy, FLORIDA) blasted a pair of long home runs, the second coming in the 11<sup>th</sup> inning Sunday as the Prairie State baseball team downed Bryant & Stratton 12-11 Sunday afternoon. </span>","type":null,"byline":"Chris Kuchta ","app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":null,"global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":null,"instagram":null,"pinterest":null,"tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/5/5/JESSER_FOR_B_AND_S.jpg","image_focal_point":null,"image_alt_text":"Jesser Contreras 2026","video":null,"url":"/news/2026/5/5/baseball-contreras-blasts-help-close-out-regular-season-with-bang.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":1,"locked_ranking":false,"id":783,"content_id":"783","content_title":"Contreras Blasts Help Close Out Regular Season With Bang","content_date":"2026-05-05T09:12:00","content_url":"https://prairiestateathletics.com/news/2026/5/5/baseball-contreras-blasts-help-close-out-regular-season-with-bang.aspx","content_image_url":"https://prairiestateathletics.com/images/2026/5/5/JESSER_FOR_B_AND_S.jpg","date":"2026-05-05T09:12:00"},{"title":"PSC Earns Splits With McHenry and Illinois Valley","title_in_rotator":true,"sub_headline":null,"teaser":"<span style=\"font-family:tahoma;\"><strong><span style=\"color:#006400;\">OGLESBY, Ill. ---</span> </strong>Led by solid pitching and timely hitting, the Prairie State baseball team earned a pair of splits in recent action, taking a game from both Illinois Skyway Conference foe McHenry and NJCAA Region 4 counterpart Illinois Valley.</span>","type":null,"byline":"Chris Kuchta ","app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":null,"global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":null,"instagram":null,"pinterest":null,"tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/4/14/CRABTREE_FOR_WEEKEND_RECAP_BASEBALL.jpg","image_focal_point":null,"image_alt_text":"Crabtree 1st base 2026","video":null,"url":"/news/2026/4/14/baseball-psc-earns-splits-with-mchenry-and-illinois-valley.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":2,"locked_ranking":false,"id":780,"content_id":"780","content_title":"PSC Earns Splits With McHenry and Illinois Valley","content_date":"2026-04-14T15:26:00","content_url":"https://prairiestateathletics.com/news/2026/4/14/baseball-psc-earns-splits-with-mchenry-and-illinois-valley.aspx","content_image_url":"https://prairiestateathletics.com/images/2026/4/14/CRABTREE_FOR_WEEKEND_RECAP_BASEBALL.jpg","date":"2026-04-14T15:26:00"},{"title":"Pioneers Fall to Elgin on Road","title_in_rotator":true,"sub_headline":null,"teaser":"<span style=\"font-family:tahoma;\"><strong><span style=\"color:#006400;\">ELGIN, Ill. ---</span> </strong>Sophomore catcher <dfn><a href=\"/sports/baseball/roster/juan-pinuelas/980\" rel=\"smarttag\" rev=\"980\">Juan Pinuelas</a></dfn> (Goliath Academy, MEXICO) continued to swing a red-hit bat, but it wasn't enough as the Prairie State baseball team dropped both ends of an Illinois Skyway Conference doubleheader with Elgin.</span>","type":null,"byline":"Chris Kuchta ","app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":null,"global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":null,"instagram":null,"pinterest":null,"tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/4/9/JUAN_PINEULAS_FOR_ELGIN_STORY.jpg","image_focal_point":null,"image_alt_text":"Juan Pinealas 2026","video":null,"url":"/news/2026/4/9/baseball-pioneers-fall-to-elgin-on-road.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":3,"locked_ranking":false,"id":778,"content_id":"778","content_title":"Pioneers Fall to Elgin on Road","content_date":"2026-04-09T16:51:00","content_url":"https://prairiestateathletics.com/news/2026/4/9/baseball-pioneers-fall-to-elgin-on-road.aspx","content_image_url":"https://prairiestateathletics.com/images/2026/4/9/JUAN_PINEULAS_FOR_ELGIN_STORY.j