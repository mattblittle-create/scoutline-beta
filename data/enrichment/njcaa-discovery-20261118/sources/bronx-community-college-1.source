dolfo-dejesus-announces-resignation.aspx","content_image_url":"https://bronxbroncos.com/images/2026/6/18/Adolfo_Retirement_Story_Final.png","date":"2026-06-18T12:10:00"},{"title":"Bronx Community College student-athletes honored Thursday evening at 2025-2026 Athletics Banquet","title_in_rotator":true,"sub_headline":null,"teaser":"<span style=\"font-size:14px;\"><span style=\"font-family:verdana;\">The Bronx Community College Department of Athletics honored its student-athletes on Thursday, May 14, at the institution's annual Athletics Banquet. The event was held on campus, at the Roscoe Brown Student Center, and featured over 50 student-athletes and coaches, as well as members of the institution's administration.</span></span>","type":null,"byline":null,"app_exclusive":false,"sport_display":"Baseball, Men's Basketball, Men's Soccer, Women's Basketball, Women's Volleyball","sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"2023 Spring Baseball","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"PL10PnELL-EobWpFZop6FaM5oUvDIsY-MC","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/5/18/454545454545454.jpg","image_focal_point":null,"image_alt_text":"2025-2026 MEC Athletics Banquet Group Photo","video":null,"url":"/news/2026/5/18/baseball-bronx-community-college-student-athletes-honored-thursday-evening-at-2025-2026-athletics-banquet.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":4,"locked_ranking":false,"id":4504,"content_id":"4504","content_title":"Bronx Community College student-athletes honored Thursday evening at 2025-2026 Athletics Banquet","content_date":"2026-05-18T12:15:00","content_url":"https://bro