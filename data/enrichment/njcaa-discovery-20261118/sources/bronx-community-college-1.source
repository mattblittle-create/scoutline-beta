<!-- ko if: name() === 'instagram-scroll' -->
<div class="component c-instagram c-instagram--list" data-bind="afterBind: {foreach: data, callback: perfectScrollbar}" data-perfectScrollbar-options="{suppressX: true}">
    <div class="c-instagram__item ">
        <div class="c-instagram__item-inner">
            <a class="c-instagram__link" data-bind="attr: {href: link}">
                <img class="c-instagram__image" data-bind="attr: { src: images.standard_resolution.url, alt: caption ? caption.text : 'No Instagram caption available'}" />
            </a>
        </div>
        <div class="c-instagram__user flex flex-align-center">
            <img class="c-instagram__user-picture" data-bind="attr: {src: user.profile_picture, alt:user.full_name + ' Profile\'s'}">
            <div class="c-instagram__user-screen" data-bind="text:'@' + user.username"></div>
        </div>
    </div>
</div>
<!-- /ko -->

<!-- ko if: name() === 'instagram-mobile' -->
<div class="component c-instagram c-instagram--list" data-bind="fastForEach: data">
