mZCkc2LwVesROcIwk-6QSCRUCOHjWkV7WjALkiG6RkpjXOfUo&_nc_zt=23&_nc_ht=scontent-dfw5-1.xx&edm=AKIiGfEEAAAA&_nc_gid=slmNtU_5Q6w9ImB9dMXsrA&_nc_tpa=Q5bMBQLO-EUDZuAJz55UJUehYGHuVtU6LwYMTJXacCck1YoVOaZUjOe2srXL-w3dRZNYdOJZ3K_x&oh=00_AQRgaXf1KN7wUR_CnCNHCHgylkO9VqIrIHB1x0oMGX0a6g&oe=6B0395F8","id":"319384001504847_1690287019772568","from":{"Key":"319384001504847","Value":"Bronx CC Athletics"},"message":"The Bronx Community College men's soccer team will look to extend its winning streak to four matches, as the Broncos will host the Senators of SUNY Ulster this afternoon at Ohio Field. Start-time is scheduled for 4:00pm. Let's go Broncos! <a href=\"https://www.facebook.com/hashtag/MatchDay\">#MatchDay</a> <a href=\"https://www.facebook.com/hashtag/bronx\">#bronx</a> <a href=\"https://www.facebook.com/hashtag/NJCAARegionXV\">#NJCAARegionXV</a> ##NCAA","privacy":{"Key":"Public","Value":"EVERYONE"},"type":"","description":"","full_picture":"https://scontent-dfw5-1.xx.fbcdn.net/v/t39.30808-6/842902218_1690286879772582_7017430085909437218_n.jpg?stp=dst-jpg_s720x720_tt6&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=127cfc&_nc_ohc=KUD3oAB95EcQ7kNvwEgLMNj&_nc_oc=AdpGbeeLz8hqGhyuEHmZCkc2LwVesROcIwk-6QSCRUCOHjWkV7WjALkiG6RkpjXOfUo&_nc_zt=23&_nc_ht=scontent-dfw5-1.xx&edm=AKIiGfEEAAAA&_nc_gid=slmNtU_5Q6w9ImB9dMXsrA&_nc_tpa=Q5bMBQLO-EUDZuAJz55UJUehYGHuVtU6LwYMTJXacCck1YoVOaZUjOe2srXL-w3dRZNYdOJZ3K_x&oh=00_AQRgaXf1KN7wUR_CnCNHCHgylkO9VqIrIHB1x0oMGX0a6g&oe=6B0395F8","link":"","created_time":"2026-10-08T08:57:57-05:00","updated_time":"0001-01-01T00:00:00","is_published":true,"is_hidden":false,"permalink_url":"https://www.facebook.com/477122557755693/posts/1690287019772568","like_count":"0","link_to_post":"https://facebook.com/319384001504847_1690287019772568","page":{"id":"319384001504847","name":"Bronx CC Athletics","picture":"https://scontent-dfw5-2.xx.fbcdn.net/v/t39.30808-1/211199869_3901670216609523_8685976092319493666_n.jpg?stp=cp0_dst-jpg_s50x50_tt6&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=f907e8&_nc_ohc=QiSCedH5C28Q7kNvwHvxVGk&_nc_oc=AdrhCWgJfsEYTBzejFjnHEmlYV3An3cleWXCidYs4pXV4aZTLihdqJ3d52aCq8DTvmM&_nc_zt=24&_nc_ht=scontent-dfw5-2.xx&edm=AJdBtusEAAAA&_nc_gid=7dFkZi6zXr-QwSGEvcpHEQ&_nc_tpa=Q5bMBQLGMwnDDl2nfx9IOgY1zdunFZzdyizi0nniQKw9twwVfV6EklJMzxEdUsV5PPJ6xIN76EZ_&oh=00_AQSGyebjL1FfOU6f7IQ7OmghJ8_R08kRTHdd43oWuduukg&oe=6B035F16","link":"https://www.facebook.com/319384001504847","category":"Campus Building","website":"http://www.bcc.cuny.edu/athletics/","username":"BronxCommunityCollegeAthletics","description":"","can_post":"","type":""}},{"content_id":"319384001504847_1689385246529412","content_title":"The Bronx Community College Broncos continued their impressive turnaround on Tuesday afternoon, cruising to a 5-2 victory over the Queensborough Community College Tigers at Ohio Field.\n\nThe victory marked Bronx's third consecutive triumph and fourth win in its last five contests, as the Broncos have quickly reversed their fortunes after opening the season with an 0-2-1 record. Bronx improved to 4-3-1 on the season with the win, while Queensborough fell to 1-8.\n\nFive different players scored goals for the Broncos, including Omar Sillah, Fnu Eselecha Ndemalalue, David Santa, Hanif Soule, and Tawfiq Amin. \n\n<a href=\"https://bronxbroncos.com/news/2026/10/7/mens-soccer-broncos-stay-hot-offensively-with-5-2-drubbing-of-queensborough-winning-streak-extends-to-three-matches.aspx\">https://bronxbroncos.com/news/2026/10/7/mens-soccer-broncos-stay-hot-offensively-with-5-2-drubbing-of-queensborough-winning-streak-extends-to-three-matches.aspx</a>","content_date":"2026-10-07T12:27:35-05:00","content_url":"https://www.facebook.com/477122557755693/posts/1689385246529412","content_image_url":"","id":"319384001504847_1689385246529412","from":{"Key":"319384001504847","Value":"Bronx CC Athletics"},"message":"The Bronx Community College Broncos continued their impressive turnaround on Tuesday afternoon, cruising to a 5-2 victory over the Queensborough Community College Tigers at Ohio Field.\n\nThe victory marked Bronx's third consecutive triumph and fourth win in its last five contests, as the Broncos have quickly reversed their fortunes after opening the season with an 0-2-1 record. Bronx improved to 4-3-1 on the season with the win, while Queensborough fell to 1-8.\n\nFive different players scored goals for the Broncos, including Omar Sillah, Fnu Eselecha Ndemalalue, David Santa, Hanif Soule, and Tawfiq Amin. \n\n<a href=\"https://bronxbroncos.com/news/2026/10/7/mens-soccer-broncos-stay-hot-offensively-with-5-2-drubbing-of-queensborough-winning-streak-extends-to-three-matches.aspx\">https://bronxbroncos.com/news/2026/10/7/mens-soccer-broncos-stay-hot-offensively-with-5-2-drubbing-of-queensborough-winning-streak-extends-to-three-matches.aspx</a>","privacy":{"Key":"Public","Value":"EVERYONE"},"type":"","description":"","full_picture":"","link":"","created_time":"2026-10-07T12:27:35-05:00","updated_time":"0001-01-01T00:00:00","is_published":true,"is_hidden":false,"permalink_url":"https://www.facebook.com/477122557755693/posts/1689385246529412","like_count":"2","link_to_post":"https://facebook.com/319384001504847_1689385246529412","page":{"id":"319384001504847","name":"Bronx CC Athletics","picture":"https://scontent-dfw5-2.xx.fbcdn.net/v/t39.30808-1/211199869_3901670216609523_8685976092319493666_n.jpg?stp=cp0_dst-jpg_s50x50_tt6&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=f907e8&_nc_ohc=QiSCedH5C28Q7kNvwHvxVGk&_nc_oc=AdrhCWgJfsEYTBzejFjnHEmlYV3An3cleWXCidYs4pXV4aZTLihdqJ3d52aCq8DTvmM&_nc_zt=24&_nc_ht=scontent-dfw5-2.xx&edm=AJdBtusEAAAA&_nc_gid=7dFkZi6zXr-QwSGEvcpHEQ&_nc_tpa=Q5bMBQLGMwnDDl2nfx9IOgY1zdunFZzdyizi0nniQKw9twwVfV6EklJMzxEdUsV5PPJ6xIN76EZ_&oh=00_AQSGyebjL1FfOU6f7IQ7OmghJ8_R08kRTHdd43oWuduukg&oe=6B035F16","link":"https://www.facebook.com/319384001504847","category":"Campus Building","website":"http://www.bcc.cuny.edu/athletics/","username":"BronxCommunityCollegeAthletics","descript