t-dfw6-2.cdninstagram.com/v/t51.82787-15/838352146_18386868460227401_4589481395126815644_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=yNixmaQMvdwQ7kNvwFEabwb&_nc_oc=AdqmD-NzQZN2KrUdSZGvbfmAmjc_6m3Q36HBkkZHHQub_40fkb9rrLVpa0LlVcvkBbs&_nc_zt=23&_nc_ht=scontent-dfw6-2.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSHXgJc5aF0-Pi0CF_xecKFxnKR-LxrBAj4o3lZZLOYRQ&oe=6B03850C"}},"caption":{"id":"","text":"The @bcccuny men's soccer team returns to the pitch this afternoon, as the Broncos will host @qcc_athletics at Ohio Field. Start-time for the clash between the two rivals is scheduled for 4pm. Lets go Broncos!!","created_time":null,"from":null},"video":null,"user":{"id":"17841406822028048","full_name":"Bronx CC Athletics","profile_picture":"https://scontent-dfw5-1.xx.fbcdn.net/v/t51.2885-15/210055709_961197861382577_4747689542934436102_n.jpg?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=7d201b&_nc_ohc=GjmPO4eT2CEQ7kNvwFbOoYE&_nc_oc=Adp0yh_Pvl1exqJXA8E8UkNzy3DWJSuMR7Nrcqkohztr05okhZj5HOAyzhtSsaMADqM&_nc_zt=23&_nc_ht=scontent-dfw5-1.xx&edm=AJ-jyNUEAAAA&oh=00_AQQIMe0NXOnSg09n0trO0nVGB0RtsjUTSmvOuvTzPfXNAw&oe=6B035F61","username":"bronxathletics"},"date":"2026-10-06T09:28:02-05:00","created_time":1791278882.0},{"content_id":"17869029453645751","content_title":"Bronx Community College men’s basketball is entering a new era under first-year head coach Howie Harrison Jr., who is focused on building a new culture and returning the Broncos to prominence.\n\nThe Broncos will hold tryouts Tuesday, September 29, and Wednesday, September 30, from 5-7 p.m. in the Alumni Gym at Bronx Community College. Students interested in participating must be enrolled full time at Bronx Community College.\n\nHarrison Jr. brings a strong emphasis on discipline, accountability, player development and team culture as he begins his first season at the helm. The tryouts will provide an opportunity for full-time students to compete for a spot while becoming part of a program that is working to establish a renewed standard of excellence.\n\nFor more information, contact Dr. Howie Harrison Jr. at Howie.harrison12@gmail.com","content_date":"2026-09-25T11:04:12-05:00","content_url":"https://www.instagram.com/p/Ddt2G9GRboV/","content_image_url":"https://scontent-dfw5-3.cdninstagram.com/v/t51.82787-15/825469249_18385090633227401_1377793651348041094_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=boBWfq995lUQ7kNvwFHHgUM&_nc_oc=Adr3LQ36z2rJyoeb_pwVIdC5GBpqX2HTJDfHRQZKIy3jV8i35lDw5uLIpbbO3SIU0uc&_nc_zt=23&_nc_ht=scontent-dfw5-3.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSi-NLpEwZXnfZO52tEuvje19860VBalg2H5rVQzWo8yg&oe=6B0380AA","link":"https://www.instagram.com/p/Ddt2G9GRboV/","id":"17869029453645751","tags":[],"comments":[],"likes":{"count":64},"images":{"thumbnail":null,"low_resolution":{"width":null,"height":null,"url":"https://scontent-dfw5-3.cdninstagram.com/v/t51.82787-15/825469249_18385090633227401_1377793651348041094_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=boBWfq995lUQ7kNvwFHHgUM&_nc_oc=Adr3LQ36z2rJyoeb_pwVIdC5GBpqX2HTJDfHRQZKIy3jV8i35lDw5uLIpbbO3SIU0uc&_nc_zt=23&_nc_ht=scontent-dfw5-3.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSi-NLpEwZXnfZO52tEuvje19860VBalg2H5rVQzWo8yg&oe=6B0380AA"},"standard_resolution":{"width":null,"height":null,"url":"https://scontent-dfw5-3.cdninstagram.com/v/t51.82787-15/825469249_18385090633227401_1377793651348041094_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=boBWfq995lUQ7kNvwFHHgUM&_nc_oc=Adr3LQ36z2rJyoeb_pwVIdC5GBpqX2HTJDfHRQZKIy3jV8i35lDw5uLIpbbO3SIU0uc&_nc_zt=23&_nc_ht=scontent-dfw5-3.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSi-NLpEwZXnfZO52tEuvje19860VBalg2H5rVQzWo8yg&oe=6B0380AA"}},"caption":{"id":"","text":"Bronx Community College men’s basketball is entering a new era under first-year head coach Howie Harrison Jr., who is focused on building a new culture and returning the Broncos to prominence.\n\nThe Broncos will hold tryouts Tuesday, September 29, and Wednesday, September 30, from 5-7 p.m. in the Alumni Gym at Bronx Community College. Students interested in participating must be enrolled full time at Bronx Community College.\n\nHarrison Jr. brings a strong emphasis on discipline, accountability, player development and team culture as he begins his first season at the helm. The tryouts will provide an opportunity for full-time students to compete for a spot while becoming part of a program that is working to establish a renewed standard of excellence.\n\nFor more information, contact Dr. Howie Harrison Jr. at Howie.harrison12@gmail.com","created_time":null,"from":null},"video":null,"user":{"id":"17841406822028048","full_name":"Bronx CC Athletics","profile_picture":"https://scontent-dfw5-1.xx.fbcdn.net/v/t51.2885-15/210055709_961197861382577_4747689542934436102_n.jpg?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=7d201b&_nc_ohc=GjmPO4eT2CEQ7kNvwFbOoYE&_nc_oc=Adp0yh_Pvl1exqJXA8E8UkNzy3DWJSuMR7Nrcqkohztr05okhZj5HOAyzhtSsaMADqM&_nc_zt=23&_nc_ht=scontent-dfw5-1.xx&edm=AJ-jyNUEAAAA&oh=00_AQQIMe0NXOnSg09n0trO0nVGB0RtsjUTSmvOuvTzPfXNAw&oe=6B035F61","username":"bronxathletics"},"date":"2026-09-25T11:04:12-05:00","created_time":1790334252.0},{"content_id":"17896415082670117","content_title":"The Bronx Community College Broncos have put together a strong stretch of home soccer, earning back-to-back victories at Ohio Field with a 4-0 shutout of the SUNY Orange Colts on Thursday, September 17, followed by a 5-2 triumph over the Dutchess Falcons on Thursday, September 24. \n\nThe two victories showcased the Broncos' ability to generate consistent offensive pressure while also taking care of business defensively, as Bronx has outscored its opponents by a combined 9-2 during the two-match winning streak.\n\nTo read the full recap of these triumphs, visit the official website of the Broncos at BronxBroncos.com!","content_date":"2026-09-25T10:39:14-05:00","content_url":"https://www.instagram.com/p/DdtzSisRs0N/","content_image_url":"https://scontent-dfw5-3.cdninstagram.com/v/t51.82787-15/825425944_18385086547227401_3080205125062974317_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=gNsdFHpWnOkQ7kNvwF6yU9t&_nc_oc=AdoStkYXMGsGk3ms-HIBlmOjzjhsVIAiP6QBBgOyF7BJ3LFn6pZV8SdUtbzIEEkPmqw&_nc_zt=23&_nc_ht=scontent-dfw5-3.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQT4MNjyuXvPrEVnVAEnrjnih1pCv_hgJtTVQ2exELWErQ&oe=6B0377DE","link":"https://www.instagram.com/p/DdtzSisRs0N/","id":"17896415082670117","tags":[],"comments":[],"likes":{"count":56},"images":{"thumbnail":null,"low_resolution":{"width":null,"height":null,"url":"https://scontent-dfw5-3.cdninstagram.com/v/t51.82787-15/825425944_18385086547227401_3080205125062974317_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=gNsdFHpWnOkQ7kNvwF6yU9t&_nc_oc=AdoStkYXMGsGk3ms-HIBlmOjzjhsVIAiP6QBBgOyF7BJ3LFn6pZV8SdUtbzIEEkPmqw&_nc_zt=23&_nc_ht=scontent-dfw5-3.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQT4MNjyuXvPrEVnVAEnrjnih1pCv_hgJtTVQ2exELWErQ&oe=6B0377DE"},"standard_resolution":{"width":null,"height":null,"url":"https://scontent-dfw5-3.cdninstagram.com/v/t51.82787-15/825425944_18385086547227401_3080205125062974317_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=gNsdFHpWnOkQ7kNvwF6yU9t&_nc_oc=AdoStkYXMGsGk3ms-HIBlmOjzjhsVIAiP6QBBgOyF7BJ3LFn6pZV8SdUtbzIEEkPmqw&_nc_zt=23&_nc_ht=scontent-dfw5-3.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQT4MNjyuXvPrEVnVAEnrjnih1pCv_hgJtTVQ2exELWErQ&oe=6B0377DE"}},"caption":{"id":"","text":"The Bronx Community College Broncos have put together a strong stretch of home soccer, earning back-to-back victories at Ohio Field with a 4-0 shutout of the SUNY Orange Colts on Thursday, September 17, followed by a 5-2 triumph over the Dutchess Falcons on Thursday, September 24. \n\nThe two victories showcased the Broncos' ability to generate consistent offensive pressure while also taking care of business defensively, as Bronx has outscored its opponents by a combined 9-2 during the two-match winning streak.\n\nTo read the full recap of these triumphs, visit the official website of the Broncos at BronxBroncos.com!","created_time":null,"from":null},"video":null,"user":{"id":"17841406822028048","full_name":"Bronx CC Athletics","profile_picture":"https://scontent-dfw5-1.xx.fbcdn.net/v/t51.2885-15/210055709_961197861382577_4747689542934436102_n.jpg?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=7d201b&_nc_ohc=GjmPO4eT2CEQ7kNvwFbOoYE&_nc_oc=Adp0yh_Pvl1exqJXA8E8UkNzy3DWJSuMR7Nrcqkohztr05okhZj5HOAyzhtSsaMADqM&_nc_zt=23&_nc_ht=scontent-dfw5-1.xx&edm=AJ-jyNUEAAAA&oh=00_AQQIMe0NXOnSg09n0trO0nVGB0RtsjUTSmvOuvTzPfXNAw&oe=6B035F61","username":"bronxathletics"},"date":"2026-09-25T10:39:14-05:00","created_time":1790332754.0},{"content_id":"18129479101685469","content_title":"The Bronx Community College men's soccer team picked up its first victory of the 2026 campaign on Saturday, earning a hard-fought 5-3 triumph over Rockland Community College at Ohio Field\n\nFor the game, Leiver Palacio finished with two goals and an assist, while David Santa contributed a goal and an assist. Fnu Eselecha Ndemalalue and Konate each added a tally, and goalkeeper Ramon Caldera turned in a strong performance, recording 10 saves in the victory.\n\nTo read the full recap, visit the official website of the Broncos at BronxBroncos.com!","content_date":"2026-09-13T05:30:54-05:00","content_url":"https://www.instagram.com/p/DdOWeQ_JpIj/","content_image_url":"https://scontent-dfw6-1.cdninstagram.com/v/t51.82787-15/808156177_18383162833227401_40691051607618802_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=-fK1ocP5LpsQ7kNvwF0skiE&_nc_oc=AdqcDgp78sTZJIeWV1CHLiT2lLOXDXIz0c9jM4LUZCpCg5-LjQ9VNO2T-cBS8DHjL58&_nc_zt=23&_nc_ht=scontent-dfw6-1.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSn71FvGn9OlvADjVV7wdfE0EjDps0sBW9MiLfxrLaarQ&oe=6B037E79","link":"https://www.instagram.com/p/DdOWeQ_JpIj/","id":"18129479101685469","tags":[],"comments":[],"likes":{"count":78},"images":{"thumbnail":null,"low_resolution":{"width":null,"height":null,"url":"https://scontent-dfw6-1.cdninstagram.com/v/t51.82787-15/808156177_18383162833227401_40691051607618802_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=-fK1ocP5LpsQ7kNvwF0skiE&_nc_oc=AdqcDgp78sTZJIeWV1CHLiT2lLOXDXIz0c9jM4LUZCpCg5-LjQ9VNO2T-cBS8DHjL58&_nc_zt=23&_nc_ht=scontent-dfw6-1.cdninstagram.com&edm=AFF3FJ0EAAAA&_nc_gid=ils4CotxPKZRRaWxS-Fp8Q&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSn71FvGn9OlvADjVV7wdfE0EjDps0sBW9MiLfxrLaarQ&oe=6B037E79"},"standard_resolution":{"width":null,"height":null,"url":"https://scontent-dfw6-1.cdninstagram.com/v/t51.82787-15/808156177_18383162833227401_40691051607618802_n.heic?stp=dst-jpg_e35_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmd