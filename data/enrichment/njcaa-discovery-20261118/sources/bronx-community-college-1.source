                <img class="c-instagram__user-picture" data-bind="attr: {src: user.profile_picture, alt:user.full_name + ' Profile\'s'}">
                <div class="c-instagram__user-screen" data-bind="text:'@' + user.username"></div>
            </div>
        </div>
    </div>
<!-- /ko --></script><script type='text/html' id='template-facebook'><div class="s-social__header flex flex-align-center flex-justify-between">
    <h2 class="text-uppercase"><i class="sf-facebook-square"></i>Facebook</h2>
    <a class="text-uppercase" href="https://www.facebook.com/BronxCommunityCollegeAthletics/" target="_blank">Like</a>
</div>

<!-- ko if: name() === 'facebook-scroll' -->
<div class="component c-facebook c-facebook--list" data-bind="afterBind: {foreach: data, callback: perfectScrollbar}" data-perfectScrollbar-options="{suppressX: true}">
    <div class="c-facebook__item">
        <div class="c-facebook__item-sizer">
            <div class="c-facebook__item-inner">
                <div class="c-facebook__user flex flex-align-center">
                    <img class="c-facebook__user-logo" data-bind="attr: {src: page.picture, alt: page.name + '\'s profile'}">
                    <div class="c-facebook__user-name" data-bind="text:  page.name"></div>
                </div>
                
                <div class="c-facebook__body">
                    <!-- ko if: message -->
                        <div data-bind="html: message"></div>
                    <!-- /ko -->
                    <!-- ko if: !message && description -->
                        <div data-bind="html: description"></div>
                    <!-- /ko -->
                </div>
                <!-- ko if: full_picture --> 
                <div class="c-facebook__media flex flex-align-center flex-justify-center" data-bind="css: {'is-open': selected()}">
                    <img class="c-facebook__image" data-bind="attr: { src: full_picture, alt: 'facebook post' }" />
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>
<!-- /ko -->

<!-- ko if: name() === 'facebook-mobile' -->
<div class="component c-facebook c-facebook--list" data-bind="fastForEach: data">
        <div class="c-facebook__item">
            <div class="c-facebook__item-sizer">
                <div class="c-facebook__item-inner">
                    <div class="c-facebook__user flex flex-align-center">
                        <img class="c-facebook__user-logo" data-bind="attr: {src: page.picture, alt: page.name + '\'s profile'}">
                        <div class="c-facebook__user-name" data-bind="text:  page.name"></div>
                    </div>
                    
                    <div class="c-facebook__body">
                        <!-- ko if: message -->
                            <div data-bind="html: message"></div>
                        <!-- /ko -->
                        <!-- ko if: !message && description -->
                            <div data-bind="html: description"></div>
                        <!-- /ko -->
                    </div>
                    <!-- ko if: full_picture --> 
                    <div class="c-facebook__media flex flex-align-center flex-justify-center" data-bind="css: {'is-open': selected()}">
                        <img class="c-facebook__image" data-bind="attr: { src: full_picture, alt: 'facebook post' }" />
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
    <!-- /ko --></script><script type='text/html' id='template-youtube'><div class="s-social__header flex flex-align-center flex-justify-between">
        <h2 class="text-uppercase"><i class="sf-youtube"></i>YouTube</h2>
        <a class="text-uppercase" href="https://www.youtube.com/channel/UCz6WNalrS4OdhKd7QOzUbAA" target="_blank">Subscribe</a>
    </div>

<!-- ko if: name() === 'youtube-scroll' -->
    <div class="component c-videos c-videos--list">
        <!-- ko if: selectedVideo() -->
            <div class="showcase-modal" data-bind="showcasePlayer: selectedVideo().showcase, modal :true, videoContainer: '.showcase-modal__player'">
                <div class="showcase-modal__inner">
                    <div class="showcase-modal__player"></div>
    
                    <button type="button" class="showcase-modal__close" data-bind="click: selectedVideo().showcase().closeVideo" aria-label="Close video modal">
                        <i class="sf-close"></i>
                    </button>
                </div>
            </div>
        <!-- /ko -->

        <div class="c-videos__list" data-bind="afterBind: {foreach: data, callback: perfectScrollbar}" data-perfectScrollbar-options="{suppressX: true}">
            <div class="c-videos__item">
                <div class="c-videos__item-sizer">
                    <div class="c-videos__item-inner">
                        <div class="c-videos__media-container relative">
                            <div class="c-videos__media relative" data-bind="click: $component.switchVideo">
                                <img class="c-videos__image" data-bind="attr: {src: images.medium, alt: title}" />
                                <button type="button" class="c-videos__play-btn" data-bind="click: $component.switchVideo, attr: {'aria-label': 'Play video ' + title}">Play Video</button>
                            </div>
                        </div>
                        <div class="c-videos__title" data-bind="text: title"></div>
                        <div class="c-videos__details flex flex-align-center flex-justify-between">
                            <div class="c-videos__date" data-bind="formatDate:date, format:'MMMM D'"></div>      
                            <div class="c-videos__views" data-bind="text: views + ' Views'"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<!-- /ko -->

<!-- ko if: name() === 'youtube-mobile' -->
<div class="component c-videos c-videos--list">
        <!-- ko if: selectedVideo() -->
            <div class="showcase-modal" data-bind="showcasePlayer: selectedVideo().showcase, modal :true, videoContainer: '.showcase-modal__player'">
                <div class="showcase-modal__inner">
                    <div class="showcase-modal__player"></div>
    
                    <button type="button" class="showcase-modal__close" data-bind="click: selectedVideo().showcase().closeVideo" aria-label="Close video modal">
                        <i class="sf-close"></i>
                    </button>
                </div>
            </div>
        <!-- /ko -->

        <div class="c-videos__list" data-bind="fastForEach: data">
            <div class="c-videos__item">
                <div class="c-videos__item-sizer">
                    <div class="c-videos__item-inner">
                        <div class="c-videos__media-container relative">
                            <div class="c-videos__media relative" data-bind="click: $component.switchVideo">
                                <img class="c-videos__image" data-bind="attr: {src: images.medium, alt: title}" />
                                <button type="button" class="c-videos__play-btn" data-bind="click: $component.switchVideo, attr: {'aria-label': 'Play video ' + title}">Play Video</button>
                            </div>
                        </div>
                        <div class="c-videos__title" data-bind="text: title"></div>
                        <div class="c-videos__details flex flex-align-center flex-justify-between">
                            <div class="c-videos__date" data-bind="formatDate:date, format:'MMMM D'"></div>      
                            <div class="c-videos__views" data-bind="text: views + ' Views'"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<!-- /ko --></script><script type='text/html' id='template-galleries'><div class="component c-galleries c-galleries--grid flex flex-wrap" data-bind="fastForEach: data">
        <div class="c-galleries__item">
            <a class="c-galleries__link" data-bind="attr: {href:url, title: 'View gallery ' + title}">
                <div class="c-galleries__media-container">
                    <div class="c-galleries__media relative">
                        <picture class="c-galleries__picture" data-bind="html5Picture: { 'images': [
                                                    { 'breakpoint': 540, 'image': images.large.url + '?width=768&height=432&mode=crop&anchor=topcenter' },
                                                    { 'breakpoint': 0, 'image': images.large.url + '?width=540&height=304&mode=crop&anchor=topcenter' }
                                                ]}, alt: title">
                        </picture>
                        <div class="c-galleries__details flex flex-justify-between flex-align-center">
                            <!-- ko if: sport && sport.title -->
                                <div class="c-galleries__sport text-uppercase" data-bind="text: sport.title"></div>
                            <!-- /ko -->
                            <!-- ko if: title -->
                                <div class="c-galleries__title" data-bind="text: title"></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
    <!-- ko if: moreToLoad -->
    <div class="load-more__container text-center">
        <button class="load-more__button" data-bind="click: loadMore, text: isLoadingMore() ? 'Loading...' : 'Load More'">Load More</button>
    </div>
    <!-- /ko --></script><script type='text/html' id='template-events'><!-- ko if: !data().length -->
<p class="no-events">There are currently no upcoming events.</p>
<!-- /ko -->
<!-- ko if: name() === 'events--desktop' -->
<div class="component c-events c-events--list-logos" data-bind="afterBind: {foreach: data, callback: perfectScrollbar}" data-perfectScrollbar-options="{suppressX: true}">
        <div class="c-events__item flex flex-align-center relative">
            <div class="c-events__sport" data-bind="text: sport.title"></div>
            <!-- ko if: opponent.image -->
            <img class="c-events__opponent-logo" data-bind="attr: { src: opponent.image + '?width=55', alt: opponent.title }" />
            <!-- /ko -->
            <!-- ko if: !opponent.image -->
            <img class="c-events__opponent-logo" data-bind="attr: { alt: opponent.title, src: $component.bucket + '/images/responsive/cal_logo_default.png' }" />
            <!-- /ko -->
            <div class="flex flex-column">
                <div class="flex">
                    <span class="c-events__atvs" data-bind="text: atVs"></span><span class="c-events__opponent truncate" data-bind="text: opponent.title"></span>
                </div>
                <div class="c-events__location" data-bind="text: location"></div>
            </div>
            <div class="flex flex-column c-events__date-time">
                <div class="c-events__time" data-bind="text: time"></div>
                <div class="c-events__date" data-bind="formatDate:date, format:'MM.DD.YYYY'"></div>
            </div>
        
            <!-- ko if: (type === 'upcoming' && (media.audio || media.video || media.stats || media.tickets)) -->
                <button type="button" class="c-events__toggle" data-bind="click: toggleGame, css: {'is-toggled': selected()},
                attr: {
                    'aria-expanded': selected() ? 'true' : 'false'
                },
                event: {
                    keyup: function(data, event) {
                        if(event.key == 'Enter') {
                            toggleGame()
                        }
                        if(event.key == 'Escape') {
                            closeGame();
                        }
                    }
                }
                " aria-label="Toggle game links">
                    <i class="sf-plus"></i>
                </button>
            <!-- /ko -->

             <!-- ko if: (type === 'upcoming' && (media.audio || media.video || media.stats || media.tickets))  -->
        <div class="c-events__media-wrap" data-bind="css: {'is-open': selected()}"> 
                <ul class="c-events__media reset-list flex flex-align-center flex-justify-center">
                    <!-- ko if: media.audio -->
                        <li class="c-events__media-item">
                            <a class="c-events__media-link" data-bind="attr: { href: media.audio },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                <i class="sf-microphone"></i>
                                <span class="accessible-hide">
                                    Live audio for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span>
                                </span>
                            </a>
                        </li>
                    <!-- /ko -->
                    <!-- ko if: media.video -->
                        <li class="c-events__media-item">
                            <a class="c-events__media-link" data-bind="attr: { href: media.video },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                <i class="sf-video"></i>
                                <span class="accessible-hide">
                                    Live video for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                </span>
                            </a>
                        </li>
                    <!-- /ko -->
                     <!-- ko if: media.stats -->
                        <li class="c-events__media-item">
                            <a class="c-events__media-link" data-bind="attr: { href: media.stats },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                <i class="sf-stats"></i>
                                <span class="accessible-hide">
                                    Live stats for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                </span>
                            </a>
                        </li>
                    <!-- /ko -->
                    <!-- ko if: media.tickets -->
                        <li class="c-events__media-item">
                            <a class="c-events__media-link" data-bind="attr: { href: media.tickets },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                <i class="sf-tickets"></i>
                                <span class="accessible-hide">
                                    Buy tickets for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                </span>
                            </a>
                        </li>
                    <!-- /ko -->
                </ul>
            </div>
            <!-- /ko -->
        
        </div>
</div>
<!-- /ko -->

<!-- ko if: name() === 'events--mobile' -->
<div class="component c-events c-events--list-logos" data-bind="fastForEach: data">
        <div class="c-events__item flex flex-align-center relative">
            <div class="c-events__sport" data-bind="text: sport.title"></div>
            <!-- ko if: opponent.image -->
            <img class="c-events__opponent-logo" data-bind="attr: { src: opponent.image + '?width=55', alt: opponent.title }" />
            <!-- /ko -->
