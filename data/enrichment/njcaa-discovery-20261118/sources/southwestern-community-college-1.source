     <div id="tabs2_facebook" class="pane pane1">
    <div class="overflow clearfix"><iframe src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fswcciowa&tabs=timeline&width=432&height=472&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=false&appId" style="width:432px; height:472px; border:none; overflow:hidden" allowTransparency="true" allow="encrypted-media"></iframe>

</div>
  </div>
    

			
    	      <a href="#tabs2_instagram" class="tab_title tab_title2" data-tab="true">Instagram</a>
      
     <div id="tabs2_instagram" class="pane pane2">
    <div class="overflow clearfix"><div class="instagram-wrapper">
    


<div class="instagram-feed" data-module="instagram-feed" data-handle="southwestern_athletics,swcciowa"  data-scrollable="true" data-snap="true" data-scroll-direction="horizontal" >
    <div class="feed clearfix">
        <ul class="clearfix"></ul>
    </div>
</div>

</div></div>
  </div>
    

			
    	      <a href="#tabs2_twitter" class="tab_title tab_title3" data-tab="true">Twitter</a>
      
     <div id="tabs2_twitter" class="pane pane3">
    <div class="overflow clearfix">


<div class="twitter-feed list" data-module="twitter-feed" data-handle="/social-stream twitterStream" data-view="list" >
    <div class="feed">
        <div class="clearfix">
            <script type="text/template" id="twitter-template">
                
                                    <div class="head">
                        <h1>Tweets</h1>
                    </div>
                                <% _.each( statuses, function( item ){ %>
                    <article class="tweet clearfix" aria-labelledby="<%- item.id_str %>">
                        <div class="info">
                            <div class="userinfo">
                                <a href="https://www.twitter.com/<%- item.user.screen_name %>" target="_blank">
                                    <span class="icon gicon-twitter"></span>
                                    <span class="logo"><img src="<%- item.user.profile_image_url_https %>" alt=""></span>                                
                                    <span class="title"><%- item.user.name %></span>
                                    <span class="user"><%- item.user.screen_name %></span>
                                </a>
                            </div>
                            <div class="tweet-info">
                                                                    <div class="text" id="<%- item.id_str %>"><%= item.linkedText %></div>
                                                                <% if (item.media_entities.length) { %>
									<div class="thumb" data-src="<%- item.media_entities[0].media_url_https %>" data-alt="<%- item.media_entities[0].alt_text %>"></div>
                                <% } %>
                                                            </div>
                            <div class="links">
                                <a href="https://twitter.com/intent/tweet?in_reply_to=<%- item.id_str %>" class="icon gicon-reply action-button" role="button" aria-label="reply this tweet created by <%- item.user.screen_name %> on <%- item.date %> <%- item.time %>" target="blank"><span class="text">Reply</span></a>
                                <a href="https://twitter.com/intent/retweet?tweet_id=<%- item.id_str %>" class="icon gicon-retweet action-button" role="button" target="blank" aria-label="retweet this tweet created by <%- item.user.screen_name %> on <%- item.date %> <%- item.time %>"><span class="text">Retweet</span></a>
                                <a href="https://twitter.com/intent/favorite?tweet_id=<%- item.id_str %>" class="icon gicon-favorite action-button" role="button" target="blank" aria-label="favorite this tweet created by <%- item.user.screen_name %> on <%- item.date %> <%- item.time %>"><span class="text">Favorite</span></a>
                                <span class="date"><%- item.date %></span>
                            </div>                        
                        </div>
                    </article>
                <% }); %>
            </script>
		</div>
    </div> </div> 
</div>
  </div>
    

</div>
</div>



<script>
(function($) {
$(function() {

var api;
var root = $('#social-tabs');
var tabs = root.children('.tabs');
var panes = root.children('.panes').children('.pane');
var tabTitles = root.children('.panes').children('.tab_title[data-tab]');

api = tabs.tabs(panes, {
    current: 'active',
	tabs: 'a[data-tab]',
    initialIndex: 0,
    onBeforeClick: function(e, i) {
        tabs.removeClass('state' + (this.getIndex() + 1)).addClass('state' + (i + 1));
        tabTitles.removeClass('active').eq(i).addClass('active');
        panes.removeClass('active').eq(i).addClass('active');
    },
	onClick: function() {
		$(document).trigger("ui_updated");
	}
}).data('tabConfig', { 'initialIndex': 0 }).data('tabs');

tabTitles.click(function(e) {
  e.preventDefault();
  if (typeof api !== 'undefined') {
    api.click(tabTitles.index(this));
  }
});

});
})(jQuery);
</script>
