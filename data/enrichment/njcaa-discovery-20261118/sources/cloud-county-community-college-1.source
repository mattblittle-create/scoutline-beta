    var obj = {"start":0,"count":8,"name":"all","sport_id":null,"count_breakpoints":null,"css_class":"","pinned_id":"","extra":{},"context":null,"dummy":false,"type":"content-stream","id":"b836c9d0-4282-4223-9379-e177945bf46d","data":{"stream":[{"type":"story","featured":false,"pinned_id":null,"data":{"title":"Six Cloud County Baseball Players Sign with NCAA Division I Programs","title_in_rotator":true,"sub_headline":null,"teaser":"Six members of the Cloud County Community College baseball program signed their national letters of intent this week to NCAA Division I schools. Sophomore pitchers Evan Dugdale and <dfn><a href=\"/sports/baseball/roster/ian-razak/2793\" rel=\"smarttag\" rev=\"2793\">Ian Razak</a></dfn> both signed with the University of Oklahoma, sophomore catcher and outfielder <dfn><a href=\"/sports/baseball/roster/kellan-burke/2786\" rel=\"smarttag\" rev=\"2786\">Kellan Burke</a></dfn> signed with the University of Nebraska, freshman pitcher Santino Arranaga signed with the University of Oregon, sophomore pitcher <dfn><a href=\"/sports/baseball/roster/jackson-fox/2787\" rel=\"smarttag\" rev=\"2787\">Jackson Fox</a></dfn> will be going to Southeast Missouri State University, and sophomore outfielder <dfn><a href=\"/sports/baseball/roster/brody-seidl/2784\" rel=\"smarttag\" rev=\"2784\">Brody Seidl</a></dfn> with Omaha University.","type":null,"byline":"Toby Nosker, Sports Information Director","app_exclusive":false,"sport_display":"Baseball","sport":{"id":1,"title":"Baseball","abbreviation":"BASE","shortname":"baseball","short_title":"Baseball","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"baseball","gender":"m","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/11/12/IMG_7719.JPG","image_focal_point":null,"image_alt_text":"Six Cloud County Baseball Pl