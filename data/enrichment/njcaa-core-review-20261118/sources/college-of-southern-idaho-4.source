                                                    </li>
                                                <!-- /ko -->
                                            <!-- /ko -->

                                            <!-- ko case: type === 'Z' || type === 'B' || type === 'C' --> 
                                                <li class="sidearm-form-field sidearm-form-field-checkbox-list" data-bind="css: { 'sidearm-form-field-required': required }, visible: is_visible()">
                                                    <fieldset class="sidearm-form-field-fieldset">
