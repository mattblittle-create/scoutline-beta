document.addEventListener('click', function(e) {

    const link = e.target.closest(
        '.epkb-ai-chat-message-content a'
    );

    if (!link) {
        return;
    }

    const href = link.href;

    if (!href) {
        return;
    }

    try {

        const url = new URL(href);

        const isExternal =
            url.hostname !== window.location.hostname;

        const isFile =
            /\.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip)$/i.test(
                url.pathname
            );

        if (isExternal || isFile) {

            e.preventDefault();

            window.open(
                href,
                '_blank',
                'noopener,noreferrer'
            );
        }

    } catch(err) {}

}, true);

</script>
<script>
document.addEventListener('DOMContentLoaded', function() {

    document.querySelectorAll('form').forEach(function(form) {

        const searchField = form.querySelector(
            'input[type="search"], input[name="s"], input[name="awsm_job_spec[keyword]"]'
        );

        if (!searchField) {
            return;
        }

        // Add accessibility attributes
        searchField.setAttribute('required', 'required');
        searchField.setAttribute('aria-required', 'true');

        // Add aria-label if one doesn't already exist
        if (!searchField.hasAttribute('aria-label')) {
            searchField.setAttribute('aria-label', 'Search');
        }

        form.addEventListener('submit', function(e) {

            if (searchField.value.trim() === '') {

                e.preventDefault();
                e.stopPropagation();

                searchField.focus();

                searchField.style.borderColor = '#d63638';
                searchField.setAttribute('aria-invalid', 'true');

                searchField.placeholder = 'Type something to search...';

                // Create accessible error message
                let errorId = 'search-error-message';

                let existingError = document.getElementById(errorId);

                if (!existingError) {

                    let error = document.createElement('div');
                    error.id = errorId;
                    error.setAttribute('role', 'alert');
                    error.style.color = '#d63638';
                    error.style.marginTop = '5px';
                    error.textContent = 'Please enter a search term.';

                    searchField.parentNode.appendChild(error);

                    searchField.setAttribute(
                        'aria-describedby',
                        errorId
                    );
                }

            } else {

                searchField.removeAttribute('aria-invalid');

                let existingError = document.getElementById('search-error-message');
                if (existingError) {
                    existingError.remove();
                }

            }

        });

    });

});
</script>

