<!-- wp:media-text {"align":"","mediaId":153030,"mediaLink":"https://www.swic.edu/community/community-education/community-workshops/seams-and-things-beginners-sewing-class/","mediaType":"image","imageFill":true,"className":"blue-bg"} -->
<div class="wp-block-media-text is-stacked-on-mobile is-image-fill blue-bg"><figure class="wp-block-media-text__media" style="background-image:url(https://www.swic.edu/wp-content/uploads/2024/11/Seams-and-Things-Beginners-Sewing-Class.jpg);background-position:50% 50%"><img src="https://www.swic.edu/wp-content/uploads/2024/11/Seams-and-Things-Beginners-Sewing-Class.jpg" alt="Woman Sewing" class="wp-image-153030 size-full"/></figure><div class="wp-block-media-text__content"><!-- wp:heading {"textAlign":"center","className":"mt-5 bluebar"} -->
<h2 class="wp-block-heading has-text-align-center mt-5 bluebar">Seams and Things<br>Sewing Workshop</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center">$100, 5 session Workshop</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><strong>Date &amp; Time</strong><br>Every Wednesday, May 28 - June 25, 2025<br>5 PM - 6 PM</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><strong>Location</strong><br>Belleville Campus Information Science Bldg.<br>2500 Carlyle Avenue<br>Belleville, IL 62221<br>Room 2020</p>
<!-- /wp:paragraph -->

<!-- wp:buttons {"layout":{"type":"flex","justifyContent":"center"}} -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="#register">Register Today</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div></div>
<!-- /wp:media-text -->

<!-- wp:media-text {"align":"","mediaPosition":"right","mediaId":159707,"mediaLink":"https://www.swic.edu/community/community-education/community-workshops/health-occupation-pathways-experience-2025/","mediaType":"image","imageFill":false,"className":"blue-bg"} -->
<div class="wp-block-media-text has-media-on-the-right is-stacked-on-mobile blue-bg"><div class="wp-block-media-text__content"><!-- wp:heading {"textAlign":"center","className":"mt-5 bluebar"} -->
<h2 class="wp-block-heading has-text-align-center mt-5 bluebar">H.O.P.E - Health Occupations Pathway Experience</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center">Incoming high school sophomores, juniors and seniors: Join us at the Red Bud campus for a hands-on experience in healthcare careers.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><strong>Date &amp; Time</strong><br>June 25 and 26, 2025<br>9 AM - 3 PM</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><strong>Location</strong><br>SWIC Red Bud Campus<br>500 W S 4th St.<br>Red Bud, IL 62278</p>
<!-- /wp:paragraph -->

<!-- wp:buttons {"layout":{"type":"flex","justifyContent":"center"}} -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="https://forms.office.com/Pages/ResponsePage.aspx?id=Aicsm5cp2UiVFkf51EXOfgVoCDjBOwtFsp_nsSacOf1UNlhETDVZNkFZVDNTNFhSWEdWSzgzNElMMy4u" target="_blank" rel="noreferrer noopener">Register Today</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons --></div><figure class="wp-block-media-text__media"><img src="https://www.swic.edu/wp-content/uploads/2025/06/health-occupation-pathways-experience-2025.jpg" alt="H.O.P.E. - Healthcare Occupations Pathway Experience flyer" class="wp-image-159707 size-full"/></figure></div>
<!-- /wp:media-text -->

