<div class="wp-block-media-text has-media-on-the-right is-stacked-on-mobile is-image-fill blue-bg"><div class="wp-block-media-text__content"><!-- wp:heading {"textAlign":"center","className":"mt-5 bluebar"} -->
<h2 class="wp-block-heading has-text-align-center mt-5 bluebar">3D Photo Workshop</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center">Join the 3D Photo Workshop to learn how to take and share 3D photos using your phone!</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center">Date, Time, and Location to be decided based on registration.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center","className":"link-fix"} -->
<p class="has-text-align-center link-fix">For more information, contact <a href="mailto:karl.kindt@swic.edu">karl.kindt@swic.edu</a></p>
<!-- /wp:paragraph -->

