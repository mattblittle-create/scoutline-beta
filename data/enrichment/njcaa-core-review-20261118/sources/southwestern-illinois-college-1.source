<div class="wp-block-media-text is-stacked-on-mobile blue-bg"><figure class="wp-block-media-text__media"><img src="https://www.swic.edu/wp-content/uploads/2025/06/Soul-Journey-Book-Club-Updated-6-9-Flyer.jpg" alt="Project READ Soul Journey Virtual Book Club" class="wp-image-159701 size-full"/></figure><div class="wp-block-media-text__content"><!-- wp:heading {"textAlign":"center","className":"mt-5 bluebar"} -->
<h2 class="wp-block-heading has-text-align-center mt-5 bluebar">Soul Journey<br>Virtual Book Club</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center">Discovering Purpose Through Reading<br>Presented by Community Education<br>&amp; Project READ</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><strong>Date &amp; Time</strong><br>Every Wednesday, June 25 - July 23, 2025<br>5:30 PM - 6:30 PM</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center">Register to Receive Meeting Link</p>
<!-- /wp:paragraph -->

