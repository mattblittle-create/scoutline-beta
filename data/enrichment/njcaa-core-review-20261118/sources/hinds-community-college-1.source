			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Nathan Werremeyer","value":1125},{"label":"Kelly Murphy","value":10},{"label":"Jonathan Nevol","value":1127},{"label":"Dylan Foley","value":1171},{"label":"Morgan Carr","value":1172},{"label":"Kadin Maddox","value":1185},{"label":"General Information","value":1132},{"label":"Dan Rives","value":1118},{"label":"Triston  Hickman","value":1209},{"label":"Gunnar Dennis","value":1210},{"label":"Dylan Coleman","value":1211},{"label":"Jonathan Nevol","value":1127},{"label":"Rodrick Sikes","value":1201},{"label":"Lauren Morrow","value":1208},{"label":"Keshuna Luckett","value":1212},{"label":"Chris  Jones","value":1193},{"label":"Omarr Conner","value":59},{"label":"Terrance Pope","value":1194},{"label":"Micah Lewis","value":1196},{"label":"Quentin  Saulsberry","value":1197},{"label":"Esaias Guthrie","value":1214},{"label":"Chad Davis","value":1140},{"label":"Ernie Rogers","value":19},{"label":"Robert Gardner","value":1144},{"label":"Humberto Pelaez","value":1181},{"label":"Lydia Sutcliffe","value":101},{"label":"Tom Toulson","value":1187},{"label":"Elliot  Duffy","value":1215},{"label":"Sophie Crudi","value":1216},{"label":"Mike Grzanich","value":28},{"label":"John Plummer","value":86},{"label":"Megan Robertson","value":1161},{"label":"Jacki Millet","value":53},{"label":"Judith Humphrey","value":1206},{"label":"Jacki Millet","value":53},{"label":"Judith Humphrey","value":1206},{"label":"Reginald Dillon","value":23},{"label":"Trajan (TJ) Johnson","value":1190},{"label":"Reginald Dillon","value":23},{"label":"Trajan (TJ) Johnson","value":1190},{"label":"Melva Burks","value":1169},{"label":"Kadin Maddox","value":1185},{"label":"Will McBeth","value":1158},{"label":"Katie Aycock","value":1117},{"label":"Hillary Staten","value":1199}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

