  padding: 24px;
  background-color: rgba(0, 0, 0, 0.85);
}
.bjgptwxxx__inner {
  background-color: white;
  color: #2a2b2c;
  width: 100%;
  max-width: 500px;
  border-radius: 2px;
  line-height: 1.875;
  font-size: 1rem;
  max-height: 100%;
  max-width: 700px;
}
.bjgptwxxx__body {
  padding: 24px;
}
.bjgptwxxx-modal__title {
  position: relative;
  padding-left: 24px;
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1;
}
.bjgptwxxx-modal__title::after {
  content: '';
  display: block;
  width: 48px;
  height: 2px;
  background-color: black;
  margin-top: 8px;
}
.bjgptwxxx-modal__text a {
  color: black;
}
.bjgptwxxx-modal__learn {
  color: black;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5rem;
}
.bjgptwxxx-modal__learn a {
  color: black;
}
.bjgptwxxx-modal__browsers {
  padding-top: 12px;
  margin: 0 -6px;
}
.bjgptwxxx-modal__browsers-button {
  flex: 1 0 auto;
  text-decoration: none;
  border-radius: 6px;
  background: whitesmoke;
  border-radius: 35px;
  padding: 12px;
  margin: 0 6px;
  border: 1px solid #d9d9d9;
