}
.bjgptwxxx-modal__browsers-button:hover {
  background: #d9d9d9;
}
.bjgptwxxx-modal__browsers--upgrade {
  line-height: 1;
  padding: 0 12px;
}
.bjgptwxxx-modal__browsers--text {
  font-size: 14px;
  color: #2a2b2c;
  font-weight: 400;
}
.bjgptwxxx-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.bjgptwxxx-modal__browsers--text:last-child {
  padding-top: 4px;
}
.bjgptwxxx-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
  display: block;
  padding: 0 16px;
  color: black;
  width: 100%;
  margin-top: 8px;
  transition: .25s;
  line-height: 28px;
  height: 28px;
  font-size: 14px;
}
.bjgptwxxx-banner__consent:hover {
  background-color: black;
  color: white;
}

