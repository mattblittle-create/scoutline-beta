}
.b0mzwxr1q-modal__browsers--upgrade {
  line-height: 1;
  padding: 0 12px;
}
.b0mzwxr1q-modal__browsers--text {
  font-size: 14px;
  color: #2a2b2c;
  font-weight: 400;
}
.b0mzwxr1q-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.b0mzwxr1q-modal__browsers--text:last-child {
  padding-top: 4px;
}
.b0mzwxr1q-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
  display: block;
