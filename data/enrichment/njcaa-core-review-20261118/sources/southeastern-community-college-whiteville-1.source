<script id="scc-hero-slider-js-js-after">
(function () {
  function initSlider(root) {
    var track = root.querySelector('.scc-hero-slider__track');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
    if (!track || slides.length === 0) return;

    var dotsWrap = root.querySelector('.scc-hero-slider__dots');
    var liveRegion = root.querySelector('[data-live]');
    var autoplayToggle = root.querySelector('.scc-hero-slider__autoplay-toggle');

    var total = slides.length;
    var index = 0;

    var autoplayEnabled = root.getAttribute('data-autoplay') === 'true';
    var autoplaySpeed = parseInt(root.getAttribute('data-autoplay-speed'), 10) || 6000;
    var pauseOnHover = root.getAttribute('data-pause-on-hover') === 'true';
    var autoplayTimer = null;
    var isPaused = !autoplayEnabled;

    // Create dots
    var dots = [];
    if (dotsWrap) {
      dotsWrap.innerHTML = '';
      slides.forEach(function (_, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'scc-hero-slider__dot';
        b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        b.addEventListener('click', function (e) {
          e.preventDefault();
          goTo(i);
          restartAutoplay();
        });
        dotsWrap.appendChild(b);
        dots.push(b);
      });
    }

    function updateAutoplayButton() {
      if (!autoplayToggle) return;

      autoplayToggle.setAttribute('aria-pressed', isPaused ? 'true' : 'false');
      autoplayToggle.setAttribute('aria-label', isPaused ? 'Play autoplay' : 'Pause autoplay');
      autoplayToggle.innerHTML = isPaused
		  ? '<i class="fas fa-play" aria-hidden="true"></i><span class="sr-only">Play autoplay</span>'
		  : '<i class="fas fa-pause" aria-hidden="true"></i><span class="sr-only">Pause autoplay</span>';
    }

    function announce() {
      if (!liveRegion) return;
      liveRegion.textContent = 'Slide ' + (index + 1) + ' of ' + total;
    }

    function update() {
      track.style.transform = 'translateX(-' + (index * 100) + '%)';

      slides.forEach(function (s, i) {
        s.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });

      if (dots.length) {
        dots.forEach(function (d, i) {
          d.setAttribute('aria-current', i === index ? 'true' : 'false');
        });
      }

      // Pause non-active videos
      slides.forEach(function (s, i) {
        s.querySelectorAll('video').forEach(function (v) {
          try {
            if (i === index) {
              v.play().catch(function(){});
            } else {
              v.pause();
            }
          } catch (e) {}
        });
      });

      announce();
      updateAutoplayButton();
    }

    function goTo(i) {
      index = (i + total) % total;
      update();
    }

    function nextSlide() {
      goTo(index + 1);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function startAutoplay() {
      if (!autoplayEnabled || isPaused || total < 2) return;
      stopAutoplay();
      autoplayTimer = setInterval(function () {
        nextSlide();
      }, autoplaySpeed);
    }

    function restartAutoplay() {
      if (!autoplayEnabled || isPaused || total < 2) return;
      startAutoplay();
    }

    // Arrow navigation
    root.addEventListener('click', function (e) {
      var prevBtn = e.target.closest('.scc-hero-slider__nav--prev');
      var nextBtn = e.target.closest('.scc-hero-slider__nav--next');

      if (prevBtn && root.contains(prevBtn)) {
        e.preventDefault();
        goTo(index - 1);
        restartAutoplay();
        return;
      }

      if (nextBtn && root.contains(nextBtn)) {
        e.preventDefault();
        goTo(index + 1);
        restartAutoplay();
        return;
      }
    });

    // Play / pause toggle
    if (autoplayToggle) {
      autoplayToggle.addEventListener('click', function (e) {
        e.preventDefault();
        isPaused = !isPaused;

        if (isPaused) {
          stopAutoplay();
        } else {
          startAutoplay();
        }

        updateAutoplayButton();
      });
    }

    // Keyboard navigation
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(index - 1);
        restartAutoplay();
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(index + 1);
        restartAutoplay();
      }
      if (e.key === ' ' && document.activeElement === autoplayToggle) {
        e.preventDefault();
        autoplayToggle.click();
      }
    });

    // Pause on hover
    if (pauseOnHover) {
      root.addEventListener('mouseenter', function () {
        if (!isPaused) stopAutoplay();
      });

      root.addEventListener('mouseleave', function () {
        if (!isPaused) startAutoplay();
      });
    }

    // Pause when tab/window inactive, resume when active
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        stopAutoplay();
      } else if (!isPaused) {
        startAutoplay();
      }
    });

    update();
    startAutoplay();
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-scc-hero-slider="true"]').forEach(function (slider) {
      initSlider(slider);
    });
  });
})();
//# sourceURL=scc-hero-slider-js-js-after
</script>
