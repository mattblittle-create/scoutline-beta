<!-- ============================================================
  SCC Custom "Back to Top" Button — replaces Impreza's built-in toplink
  
  INSTALL:
  1. Impreza Theme Options → toggle the built-in "Back to Top" Button OFF
     (so the two don't overlap).
  2. Paste this ENTIRE block into:
     Theme Options → Advanced Settings → "Custom HTML code before </body>"
     (Or split it: <style> into Custom CSS, the rest into the footer code box.)
  
  Behavior matches the Impreza settings in your screenshot:
  - Appears after scrolling 100vh
  - Smooth scroll to top over 1000ms
  - Bottom-left, sits above the accessibility widget
============================================================ -->

<style>
  #scc-toplink {
    position: fixed;
    left: 15px;
    bottom: 95px; /* clears the accessibility widget; lower to 15px if you remove it */
    z-index: 9999;

    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 18px 0 14px;

    background: #F68A1F;          /* SCC orange — swap for exact brand hex if different */
    color: #fff;
    border: none;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(3, 44, 83, 0.25);

    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;

    /* hidden state */
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity .3s ease, transform .3s ease, visibility .3s, background-color .2s ease;
  }

  #scc-toplink.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #scc-toplink:hover {
    background: #d97812; /* slightly darker orange on hover */
  }

  #scc-toplink:focus-visible {
    outline: 3px solid #032C53; /* SCC navy focus ring */
    outline-offset: 2px;
  }

  #scc-toplink svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Icon-only square on small screens */
  @media (max-width: 600px) {
    #scc-toplink {
      width: 48px;
      padding: 0;
      justify-content: center;
    }
    #scc-toplink .scc-toplink-label {
      display: none;
    }
  }
</style>

<button type="button" id="scc-toplink" aria-label="Back to top">
  <svg viewBox="0 0 448 512" aria-hidden="true" fill="currentColor">
    <!-- Font Awesome angle-up -->
    <path d="M201.4 137.4c12.5-12.5 32.8-12.5 45.3 0l160 160c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L224 205.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l160-160z"/>
  </svg>
  <span class="scc-toplink-label">Back to Top</span>
</button>

<script>
(function () {
  var btn = document.getElementById('scc-toplink');
  if (!btn) return;

  var SHOW_AFTER_VH = 1;      // 100vh, same as the Impreza setting
  var SCROLL_DURATION = 1000; // ms, same as Impreza's smooth scroll duration

  function toggleVisibility() {
    var threshold = window.innerHeight * SHOW_AFTER_VH;
    btn.classList.toggle('is-visible', window.scrollY > threshold);
  }

  window.addEventListener('scroll', toggleVisibility, { passive: true });
  window.addEventListener('resize', toggleVisibility, { passive: true });
  toggleVisibility();

  btn.addEventListener('click', function () {
    // Respect reduced-motion preference
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.scrollTo(0, 0);
      return;
    }

    var start = window.scrollY;
    var startTime = null;

    // easeInOutQuad — close to Impreza's default easing
    function ease(t) {
      return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    }

    function step(timestamp) {
      if (startTime === null) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / SCROLL_DURATION, 1);
      window.scrollTo(0, Math.round(start * (1 - ease(progress))));
      if (progress < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  });
})();
</script>

<!-- ============================================================
  Hash-free smooth scroll to sections
  
  Paste into the same place as the back-to-top snippet:
  Theme Options → Advanced Settings → "Custom HTML code before </body>"
  
  What it does:
  1. Clicks on same-page #section links smooth-scroll WITHOUT
     the #id ever appearing in the URL.
  2. If someone lands on the page WITH a hash in the URL
     (e.g., a link from another page), it scrolls them to the
     section, then removes the hash from the address bar.
  
  Works site-wide; only same-page anchor links are affected.
============================================================ -->

<script>
(function () {
	var SCROLL_DURATION = 1000; // ms, matches the back-to-top button
	var HEADER_OFFSET   = 120;  // px — adjust to your sticky header height

	function prefersReducedMotion() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function smoothScrollTo(targetY) {
		if (prefersReducedMotion()) {
			window.scrollTo(0, targetY);
			return;
		}
		var start = window.scrollY;
		var distance = targetY - start;
		var startTime = null;

		function ease(t) {
			return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
		}

		function step(timestamp) {
			if (startTime === null) startTime = timestamp;
			var progress = Math.min((timestamp - startTime) / SCROLL_DURATION, 1);
			window.scrollTo(0, Math.round(start + distance * ease(progress)));
			if (progress < 1) requestAnimationFrame(step);
		}

		requestAnimationFrame(step);
	}

	function scrollToElement(el) {
		var targetY = el.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET;
		smoothScrollTo(Math.max(0, targetY));
	}

	/* 1) Intercept clicks on same-page anchor links.
	      Capture phase (true) so this runs before Impreza's own
	      smooth-scroll handler. */
	document.addEventListener('click', function (e) {
		var link = e.target.closest('a[href*="#"]');
		if (!link) return;

		var url = new URL(link.href, window.location.href);

		// Only same-page links with a real hash
		if (url.pathname !== window.location.pathname || !url.hash || url.hash === '#') return;

		var target = document.getElementById(url.hash.slice(1));
		if (!target) return;

		e.preventDefault();
		e.stopPropagation();
		scrollToElement(target);
	}, true);

	/* 2) Handle arrival with a hash in the URL:
	      scroll to the section, then clean the address bar. */
	window.addEventListener('load', function () {
		if (!window.location.hash) return;

		var target = document.getElementById(window.location.hash.slice(1));
		if (!target) return;

		// Small delay so late-loading content (images, embeds) doesn't shift the target
		setTimeout(function () {
			scrollToElement(target);
			history.replaceState(null, '', window.location.pathname + window.location.search);
		}, 300);
	});
})();
</script>
</body>
</html>
