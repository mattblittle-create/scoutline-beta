<script>
(function () {
    var SECTION = '#page-content > .l-section';

    function findTarget(main) {
        // 1. Section after the breadcrumbs section
        var crumbs = main.querySelector('.g-breadcrumbs');
        var crumbSection = crumbs && crumbs.closest(SECTION);
        if (crumbSection && crumbSection.nextElementSibling) return crumbSection.nextElementSibling;
        // 2. Section containing the first H1
        var h1 = main.querySelector('h1');
        var h1Section = h1 && h1.closest(SECTION);
        // 3. Fallback
        return h1Section || main;
    }

    // Window + capture phase runs BEFORE the site's document-level
    // anchor smooth-scroll handler, which otherwise swallows this click.
    window.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('#skip-link');
        if (!link) return;
        var main = document.getElementById('page-content');
        if (!main) return;

        e.preventDefault();
        e.stopImmediatePropagation();

        var target = findTarget(main);
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');

        // Header is fixed; its bottom edge already includes the admin bar when logged in
        var header = document.getElementById('page-header');
        var offset = header ? header.getBoundingClientRect().bottom : 0;
        var y = target.getBoundingClientRect().top + window.scrollY - offset;

        target.focus({ preventScroll: true });
        window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
    }, true);
})();
</script>
