<!-- start Simple Custom CSS and JS -->
<script>
(function () {
  function labelRecaptcha() {
    document
      .querySelectorAll('textarea.g-recaptcha-response:not([aria-label])')
      .forEach(function (el) {
        el.setAttribute('aria-label', 'reCAPTCHA verification (hidden)');
      });
  }
  // Run once the DOM is ready...
  if (document.readyState !== 'loading') {
    labelRecaptcha();
  } else {
    document.addEventListener('DOMContentLoaded', labelRecaptcha);
  }
  // ...and keep watching, since reCAPTCHA injects/refreshes this element after load.
  new MutationObserver(labelRecaptcha).observe(document.documentElement, {
    childList: true,
    subtree: true,
  });
})();

</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style>
   /* ============================================================
   SCC Annual Report — Page Template Styles
   Southeastern Community College | 2023-2024
   ============================================================ */

:root {
  --scc-navy:   #002D5D;
  --scc-blue:   #005cb9;
  --scc-dark:   #1f2a44;
  --scc-orange: #E8731A;
  --scc-white:  #ffffff;
  --scc-light:  #f4f6f9;
  --scc-text:   #333333;
  --scc-muted:  #666666;
  --font:       'Poppins', sans-serif;
  --max-w:      1200px;
}

[id] {
  scroll-margin-top: 120px;
}

html {
  scroll-behavior: smooth;
}

/* ============================================================
   BASE
   ============================================================ */
.ar-page {
  font-family: var(--font);
  color: var(--scc-text);
  line-height: 1.6;
}

.ar-page *,
.ar-page *::before,
.ar-page *::after {
  box-sizing: border-box;
}

.ar-page img {
  display: block;
  max-width: 100%;
}

.ar-container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 32px;
}

.ar-section-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--scc-blue);
  margin-bottom: 12px;
}



/* ============================================================
   1. HERO
   ============================================================ */
.ar-hero {
  position: relative;
  height: 760px;
  overflow: hidden;
	margin-top: 120px;
}

.ar-hero__bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}

.ar-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 45, 93, 0.45) 0%,
    rgba(0, 45, 93, 0.82) 100%
  );
  display: flex;
  align-items: flex-end;
  padding: 0 0 64px;
}

.ar-hero__content {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 32px;
}

.ar-hero__label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 14px;
}

.ar-hero h1 {
  font-size: clamp(36px, 5.5vw, 68px);
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1.05;
  margin: 0;
  max-width: 760px;
}

/* ============================================================
   1b. TABLE OF CONTENTS
   ============================================================ */
.ar-toc {
  background: var(--scc-navy);
  padding: 48px 0;
}

.ar-toc__heading {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  margin: 0 0 24px;
}

.ar-toc__heading-white{
	color: #fff;
}

.ar-toc__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.ar-toc__link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
}

.ar-toc__link:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--scc-orange);
}

.ar-toc__num {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 700;
  color: var(--scc-orange);
  letter-spacing: 0.5px;
}

.ar-toc__title {
  font-size: 14px;
  font-weight: 500;
  color: var(--scc-white);
  line-height: 1.3;
}

@media (max-width: 960px) {
  .ar-toc__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 480px) {
  .ar-toc__grid {
    grid-template-columns: 1fr;
  }
}

/* ============================================================
   2. INTRO / TITLE
   ============================================================ */
.ar-intro {
  padding: 72px 0 48px;
  text-align: left;
}

.ar-intro h2 {
  font-size: clamp(30px, 4vw, 52px);
  font-weight: 800;
  color: var(--scc-navy);
  margin: 0 0 8px;
  line-height: 1.1;
}

.ar-intro .ar-sub {
  font-size: 18px;
  font-weight: 400;
  color: var(--scc-muted);
  margin: 0 0 28px;
}

.ar-intro p {
  font-size: 17px;
  line-height: 1.8;
  color: var(--scc-text);
  max-width: auto;
  margin: 0 auto;
}

/* ============================================================
   3. TWO-COLUMN NARRATIVE
   ============================================================ */
.ar-narrative {
  padding: 72px 0;
}

.ar-narrative--bg-light {
  background: var(--scc-light);
}

.ar-narrative--bg-navy {
  background: var(--scc-navy);
}

.ar-narrative--bg-navy .ar-section-label {
  color: rgba(255, 255, 255, 0.6);
}

.ar-narrative--bg-navy h2,
.ar-narrative--bg-navy p,
.ar-narrative--bg-navy li {
  color: var(--scc-white);
}

.ar-narrative__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: top;
}

.ar-narrative__grid--reverse {
  direction: rtl;
}

.ar-narrative__grid--reverse > * {
  direction: ltr;
}

.ar-narrative__image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.ar-grad-masonry {
  column-count: 2;
  column-gap: 8px;
}

.ar-grad-masonry__item {
  break-inside: avoid;
  margin-bottom: 8px;
  overflow: hidden;
  border-radius: 4px;
}

.ar-grad-masonry__item img {
  width: 100%;
  height: auto;
  display: block;
}

.ar-narrative__image--with-badge {
  position: relative;
}

.ar-aspen-badge {
  position: absolute !important;
  top: 0px;
  left: 0px;
  width: 180px !important;
  height: auto !important;
  object-fit: contain !important;
}

.button-section {
	margin-top: 40px;
}

.ar-narrative__content h2 {
  font-size: clamp(24px, 3vw, 38px);
  font-weight: 700;
  color: var(--scc-navy);
  line-height: 1.2;
  margin: 0 0 20px;
}

.ar-narrative__content p {
  font-size: 16px;
  line-height: 1.8;
  color: var(--scc-text);
  margin-bottom: 16px;
}

.ar-narrative__content p:last-child {
  margin-bottom: 0;
}

.ar-narrative__content ul {
  margin: 16px 0 0;
  padding-left: 20px;
}

.ar-narrative__content ul li {
  font-size: 16px;
  line-height: 1.7;
  color: var(--scc-text);
  margin-bottom: 8px;
}

.ar-narrative__content .ar-signature {
  font-size: 16px;
  font-weight: 600;
  color: var(--scc-navy);
  margin-top: 24px;
  line-height: 1.4;
}

.ar-narrative__content .ar-signature span {
  font-weight: 400;
  font-size: 14px;
  color: var(--scc-muted);
}

/* ============================================================
   4. FULL-WIDTH IMAGE BREAK
   ============================================================ */
.ar-fullwidth-image {
  height: 900px;
  overflow: hidden;
}

.ar-fullwidth-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* ============================================================
   5. RECOGNITION / STATS LIST (UNCW "Seahawk Stats" style)
   ============================================================ */
.ar-recognition {
  padding: 72px 0;
  background: #fff;
}

.ar-recognition h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 800;
  color: var(--scc-navy);
  margin: 0 0 32px;
}

.ar-recognition__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.ar-recognition__list li {
  font-size: 16px;
  line-height: 1.6;
  color: var(--scc-text);
  padding: 14px 0 14px 28px;
  border-bottom: 1px solid #dde3ea;
  position: relative;
}

.ar-recognition__list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10px;
  height: 10px;
  background: var(--scc-orange);
  border-radius: 50%;
}

.ar-recognition__list li:first-child {
  border-top: 1px solid #dde3ea;
}

.ar-recognition__list a {
  color: var(--scc-blue);
  text-decoration: none;
  font-weight: 500;
}

.ar-recognition__list a:hover {
  text-decoration: underline;
}

/* ============================================================
   6. STUDENT DEMOGRAPHICS
   ============================================================ */
.ar-demo {
  background: var(--scc-white);
}

.ar-demo__band {
  background: var(--scc-navy);
  padding: 52px 0 40px;
  position: relative;
  overflow: hidden;
}

.ar-demo__band::after {
  content: '';
  position: absolute;
  /* Pre-rotation: width becomes visual height, height becomes visual width */
  width: 240px;    /* slightly taller than band height for full bleed coverage */
  height: 1200px;  /* visual width after rotation — extends ~halfway across band */
  top: 50%;
  right: 0;
  transform: translateY(-50%) rotate(90deg);
  background-image: url('https://sccnc.edu/wp-content/uploads/2026/06/Patterns_SCC-2.svg');
  background-size: 100% 100%;
  background-repeat: no-repeat;
  filter: brightness(0) invert(1);
  opacity: 0.06;
  mix-blend-mode: screen;
  pointer-events: none;
}

.ar-demo__band .ar-container {
  position: relative;
  z-index: 1;
}

.ar-demo__band h2 {
  font-size: clamp(26px, 3vw, 40px);
  font-weight: 800;
  color: var(--scc-white);
  margin: 8px 0 6px;
  line-height: 1.1;
}

.ar-demo__band p {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.65);
  margin: 0;
}

/* Dark navy top zone: line chart + pie/KPIs ---------------- */
.ar-demo__top {
  background: var(--scc-navy);
  color: var(--scc-white);
  padding: 48px 0 32px;
  position: relative;
  overflow: hidden;
}

.ar-demo__top::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 340px;
  height: 100%;
  background-image: url('https://sccnc.edu/wp-content/uploads/2026/06/Patterns_SCC-2.svg');
  background-size: cover;
  background-position: center right;
  background-repeat: no-repeat;
  filter: brightness(0) invert(1);
  opacity: 0.05;
  pointer-events: none;
}

.ar-demo__top .ar-container {
  position: relative;
  z-index: 1;
}

.ar-demo__top-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
  gap: 48px;
  align-items: center;
}

/* Enrollment growth line chart (left) --------------------- */
.ar-demo__growth {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ar-demo__growth-headline {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ar-demo__growth-pct {
  font-size: clamp(48px, 5.5vw, 72px);
  font-weight: 800;
  font-style: italic;
  color: #7CB8E0;
  line-height: 1;
}

.ar-demo__growth-desc {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #7CB8E0;
  line-height: 1.35;
}

.ar-demo__line-chart {
  width: 100%;
  height: auto;
  display: block;
  margin-top: 12px;
}

.ar-demo__line-year {
  fill: rgba(255, 255, 255, 0.65);
  font-size: 12px;
  font-weight: 500;
  font-family: inherit;
}

.ar-demo__line-val {
  fill: var(--scc-white);
  font-size: 15px;
  font-weight: 800;
  font-family: inherit;
}

/* Gender pie + KPI snapshot (right) ---------------------- */
.ar-demo__snapshot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

.ar-demo__pie-wrap {
  width: 220px;
  height: 220px;
}

.ar-demo__pie {
  width: 100%;
  height: 100%;
  display: block;
}

.ar-demo__pie-num {
  fill: var(--scc-white);
  font-size: 9px;
  font-weight: 800;
  font-family: inherit;
}

.ar-demo__pie-cap {
  fill: rgba(255, 255, 255, 0.9);
  font-size: 4px;
  font-weight: 500;
  font-family: inherit;
  letter-spacing: 0.5px;
}

.ar-demo__snapshot-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  width: 100%;
}

.ar-demo__snapshot-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.ar-demo__snapshot-num {
  display: block;
  font-size: 40px;
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1;
}

.ar-demo__snapshot-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6px;
}

.ar-demo__caption {
  text-align: center;
  font-size: 13px;
  font-style: italic;
  color: rgba(255, 255, 255, 0.6);
  margin: 32px 0 0;
}

/* Blue ethnicity zone (bottom) ----------------------------- */
/*.ar-demo__ethnicity-wrap {
  background: var(--scc-blue);
  color: var(--scc-white);
  padding: 48px 0 56px;
	display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
}*/

.ar-demo__ethnicity-wrap {
  background: var(--scc-blue);
  color: var(--scc-white);
  padding: 72px 0;
  margin: 0 auto;
	max-width: var(--max-w)
}

.ar-demo__ethnicity-wrap img{
width: 536px;
height: 346px;}

.ar-demo__ethnicity-title {
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 800;
  color: var(--scc-white);
  margin: 0 0 28px;
  line-height: 1.1;
}

.ar-container__ethnicity{
	padding: 0 32px;
	max-width: 100vw !important;
	margin: 0 !important; 
}

.ar-demo__eth-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ar-demo__eth-row {
  display: grid;
  grid-template-columns: 200px 1fr 60px;
  align-items: center;
  gap: 16px;
}

.ar-demo__eth-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--scc-white);
  line-height: 1.3;
  text-align: right;
}

.ar-demo__eth-track {
  height: 26px;
  background: rgba(255, 255, 255, 0.08);
}

.ar-demo__eth-fill {
  height: 100%;
  background: var(--scc-navy);
  transition: width 0.4s ease;
  min-width: 2px;
}

.ar-demo__eth-pct {
  font-size: 14px;
  font-weight: 700;
  color: var(--scc-white);
  text-align: left;
}

@media (max-width: 900px) {
  .ar-demo__top-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .ar-demo__eth-row {
    grid-template-columns: 150px 1fr 50px;
    gap: 12px;
  }
}

@media (max-width: 600px) {
  .ar-demo__top {
    padding: 36px 0 24px;
  }

  .ar-demo__snapshot-stats {
    gap: 20px;
  }

  .ar-demo__pie-wrap {
    width: 180px;
    height: 180px;
  }

  .ar-demo__eth-row {
    grid-template-columns: 110px 1fr 44px;
    gap: 10px;
  }

  .ar-demo__eth-name {
    font-size: 12px;
  }

  .ar-demo__line-year {
    font-size: 14px;
  }

  .ar-demo__line-val {
    font-size: 17px;
  }
}

/* ============================================================
   6b. STATS GRID (large numbers — kept for other uses)
   ============================================================ */
.ar-stats {
  padding: 72px 0;
  background: var(--scc-navy);
}

.ar-stats__header {
  text-align: center;
  margin-bottom: 48px;
}

.ar-stats__header .ar-section-label {
  color: rgba(255, 255, 255, 0.6);
}

.ar-stats__header p {
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  color: var(--scc-white);
  margin: 0;
}

.ar-stats__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  text-align: center;
}

.ar-stats__grid-bottom {
	margin-top: 20px;
}

.ar-stats__grid-bottom .ar-stats__grid {
	display: grid;
  	grid-template-columns: repeat(3, 1fr);
  	gap: 32px;
  	text-align: center;
}

.ar-stats__item {
  padding: 32px 16px;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.ar-stats__number {
  display: block;
  font-size: clamp(42px, 5vw, 64px);
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1;
}

.ar-stats__label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 10px;
}

.ar-stats__group{
	display: flex;
	flex-direction: row;
	justify-content: center;
	gap: 2rem;}

.ar-stats__group img{
width: 50px;}

#general-ed-img{
width: 65px;
margin-left: -35px;}

#nursing-img{
	width: 65px;
}

/* ============================================================
   6. Enrollment GRID (large numbers)
   ============================================================ */
.ar-enrollment {
  padding: 72px 0;
  background: var(--scc-navy);
	position: relative;
  overflow: hidden;
}

.ar-enrollment::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 260px;
  background-image: url('https://sccnc.edu/wp-content/uploads/2026/06/Patterns_SCC-2.svg');
  background-size: auto 100%;
  background-repeat: no-repeat;
  background-position: left top;
  opacity: 0.15;
  pointer-events: none;
}

.ar-enrollment::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 260px;
  background-image: url('https://sccnc.edu/wp-content/uploads/2026/06/Patterns_SCC-2.svg');
  background-size: auto 100%;
  background-repeat: no-repeat;
  background-position: left top;
  filter: brightness(0) invert(1);
  opacity: 0.06;
  mix-blend-mode: screen;
  transform: scaleX(-1);
  pointer-events: none;
}

.ar-enrollment .ar-container {
  position: relative;
  z-index: 1;
}


.ar-stats__header {
  text-align: center;
  margin-bottom: 48px;
}

.ar-stats__header .ar-section-label {
  color: rgba(255, 255, 255, 0.6);
}

.ar-stats__header p {
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  color: var(--scc-white);
  margin: 0;
}

.ar-stats__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  text-align: center;
}

.ar-stats__grid-bottom {
	margin-top: 20px;
}

.ar-stats__grid-bottom .ar-stats__grid {
	display: grid;
  	grid-template-columns: repeat(3, 1fr);
  	gap: 32px;
  	text-align: center;
}

.ar-stats__item {
  padding: 32px 16px;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.ar-stats__number {
  display: block;
  font-size: clamp(42px, 5vw, 64px);
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1;
}

.ar-stats__label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* ============================================================
   7. FACTOID CALLOUT (textured background, bold numbers)
   ============================================================ */
.ar-factoids {
  padding: 72px 0;
  background: var(--scc-light);
  position: relative;
}

.ar-factoids--textured {
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23002D5D' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.ar-factoids__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  text-align: center;
}

.ar-factoids__item {
  padding: 40px 24px;
}

.ar-factoids__number {
  display: block;
  font-size: clamp(40px, 5vw, 60px);
  font-weight: 800;
  color: var(--scc-navy);
  line-height: 1;
  margin-bottom: 10px;
}

.ar-factoids__label {
  display: block;
  font-size: 15px;
  font-weight: 500;
  color: var(--scc-muted);
}


/* ============================================================
   7. FACTOID CALLOUT (textured background, bold numbers)
   ============================================================ */
.ar-factoids-workforce {
  padding: 72px 0;
  background: var(--scc-blue);
  position: relative;
}

.ar-factoids--textured {
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23002D5D' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.ar-factoids__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  text-align: center;
}

.ar-factoids__item {
  padding: 40px 24px;
}

.ar-factoids__number {
  display: block;
  font-size: clamp(40px, 5vw, 60px);
  font-weight: 800;
  color: var(--scc-navy);
  line-height: 1;
  margin-bottom: 10px;
}

.ar-factoids__label {
  display: block;
  font-size: 15px;
  font-weight: 500;
  color: var(--scc-muted);
}

/* ============================================================
   8. GIVING / CAMPAIGN CALLOUT
   ============================================================ */
.ar-giving {
  padding: 72px 0;
  background: var(--scc-light);
}

.ar-giving__inner {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 60px;
  align-items: start;
}

.ar-giving__content h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--scc-navy);
  line-height: 1.2;
  margin: 0 0 20px;
}

.ar-giving__content p {
  font-size: 16px;
  line-height: 1.8;
  color: var(--scc-text);
  margin-bottom: 14px;
}

.ar-giving__callout {
  background: var(--scc-navy);
  color: var(--scc-white);
  padding: 40px 32px;
  text-align: center;
  margin-top: 128px;
}

.ar-giving__callout-number {
  display: block;
  font-size: clamp(36px, 4vw, 52px);
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1.1;
  margin-bottom: 8px;
}

.ar-giving__callout-label {
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.75);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.ar-giving__breakdown {
  margin-top: 32px;
  border-top: 1px solid #dde3ea;
}

.ar-giving__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #dde3ea;
  font-size: 15px;
  color: var(--scc-text);
}

.ar-giving__row span:last-child {
  font-weight: 600;
  color: var(--scc-navy);
}

.ar-giving__board {
  margin-top: 64px;
  padding-top: 20px;
}

.ar-giving__board-title {
  font-family: var(--font);
  font-size: 22px;
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 24px;
  letter-spacing: 0.5px;
}

.ar-giving__board-list {
  list-style: none;
  margin: 0;
  padding: 0;
  columns: 3;
  column-gap: 32px;
}

.ar-giving__board-list li {
  font-size: 20px;
  line-height: 1.55;
  color: var(--scc-text);
  padding: 6px 0;
  break-inside: avoid;
}

.ar-giving__board-list li strong {
  font-weight: 600;
  color: var(--scc-navy);
}

.ar-giving__board-list li em {
  font-size: 19px;
  color: var(--scc-muted);
  font-style: italic;
}

@media (max-width: 768px) {
  .ar-giving__board-list {
    columns: 2;
    column-gap: 24px;
  }

  .ar-giving__board {
    margin-top: 48px;
    padding-top: 32px;
  }
}

@media (max-width: 480px) {
  .ar-giving__board-list {
    columns: 1;
  }
}


/* ============================================================
   9. AWARDS CARDS
   ============================================================ */
.ar-awards {
  padding: 72px 0;
  background: var(--scc-light);
}

.ar-awards h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 12px;
}

.ar-awards .ar-awards-sub {
  font-size: 16px;
  color: var(--scc-muted);
  margin: 0 0 48px;
  max-width: 640px;
}

.ar-awards__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.ar-award-card {
  background: var(--scc-white);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.ar-award-card__image {
  height: auto;
  overflow: hidden;
  flex-shrink: 0;
}

.ar-award-card__image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.ar-award-card__body {
  padding: 28px 24px 32px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.ar-award-card__type {
  display: block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--scc-orange);
  margin-bottom: 8px;
}

.ar-award-card__name {
  font-size: 20px;
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 4px;
}

.ar-award-card__role {
  font-size: 14px;
  color: var(--scc-muted);
  margin: 0 0 14px;
  font-style: italic;
}

.ar-award-card__desc {
  font-size: 14px;
  line-height: 1.7;
  color: var(--scc-text);
  margin: 0 0 20px;
}

.ar-link-wrapper {
  margin-top: auto;
}

.ar-icon {
  color: #005CB9;
  margin-left: 18px;
}

.ar-icon:after {
  background: #005CB9;
  position: absolute;
  display: block;
  height: 3px;
  width: 18px;
  content: '';
  border-radius: 3px;
  transform: translate(-10px, -9.5px);
  transition: 0.3s all;
}


.ar-link.hover {
  color: #005CB9 !important;
  font-weight: 500;
}

.ar-link.hover a,
.ar-link.hover {
  transition: 0.3s all ease;
  color: #005CB9 !important;
  font-size: 16px;
  font-weight: 500;
}

.ar-link.hover .ar-icon,
.ar-link.hover i {
  color: #005CB9;
}

.ar-link.hover .ar-icon:after,
.ar-link.hover i:after {
  background: #005CB9 !important;
}

.ar-link .fa-chevron-right:before {
  position: relative;
  left: 0;
  transition: 0.3s all;
}

.ar-link:hover .fa-chevron-right:before {
  left: 13px;
}

.ar-link:hover .ar-icon:after {
  width: 32px;
}

/* Employee Awards sub-section */

.ar-section-divider {
  border: none;
  border-top: 1px solid #d9dde3;
  margin: 56px 0 48px;
}

.ar-employee-awards__heading {
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 32px;
}

.ar-employee-awards__list {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.ar-employee-award-item {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 32px;
  align-items: start;
}

.ar-employee-award-item__image {
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.ar-employee-award-item__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ar-employee-award-item__content {
  display: flex;
  flex-direction: column;
}

/* ============================================================
   NEW LEADERSHIP (Board of Trustees)
   ============================================================ */

.ar-new-leadership {
  padding: 72px 0;
  background: var(--scc-light);
}

.ar-new-leadership h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 12px;
}

.ar-new-leadership__sub {
  font-size: 16px;
  color: var(--scc-muted);
  margin: 0 0 48px;
  max-width: 640px;
}

.ar-new-leadership__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.ar-new-leadership-card {
  background: var(--scc-white);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.ar-new-leadership-card__image {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--scc-navy);
}

.ar-new-leadership-card__image img {
  display: block;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.ar-new-leadership-card__body {
  padding: 28px 24px 32px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.ar-new-leadership-card__type {
  display: block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--scc-orange);
  margin-bottom: 8px;
}

.ar-new-leadership-card__name {
  font-size: 20px;
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 4px;
}

.ar-new-leadership-card__role {
  font-size: 14px;
  color: var(--scc-muted);
  margin: 0 0 14px;
  font-style: italic;
}

.ar-new-leadership-card__desc {
  font-size: 14px;
  line-height: 1.7;
  color: var(--scc-text);
  margin: 0;
}


/* ============================================================
   10. LEADERSHIP CARDS CAROUSEL / GRID
   ============================================================ */
.ar-leadership {
  padding: 72px 0;
  background: var(--scc-white);
  overflow: hidden;
}

.ar-leadership__header {
  margin-bottom: 48px;
}

.ar-leadership__header h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 8px;
}

.ar-leadership__header p {
  font-size: 16px;
  color: var(--scc-muted);
  margin: 0;
}

.ar-leadership__track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.ar-leader-card {
  background: var(--scc-light);
  padding: 28px 24px;
  border-left: 4px solid var(--scc-navy);
}

.ar-leader-card__name {
  font-size: 17px;
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 4px;
}

.ar-leader-card__title {
  font-size: 13px;
  color: var(--scc-muted);
  line-height: 1.5;
}

/* ============================================================
   11. CTA BUTTONS
   ============================================================ */
.ar-cta {
  padding: 72px 0;
  background: var(--scc-navy);
  text-align: center;
}

.ar-cta h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--scc-white);
  margin: 0 0 40px;
}

.ar-cta__buttons {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

.ar-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 16px 32px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  font-family: var(--font);
  font-size: 15px;
  font-weight: 600;
  color: #fff !important;
  text-decoration: none;
  letter-spacing: 0.5px;
  transition: background 0.2s, border-color 0.2s;
}

.ar-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--scc-orange);
  color: var(--scc-white);
}

/* ============================================================
   12. ARCHIVE LINK
   ============================================================ */
.ar-archive {
  padding: 32px 0 48px;
  text-align: center;
  background: var(--scc-navy);
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.ar-archive a {
  font-size: 15px;
  color: #fff !important;
  text-decoration: none;
}

.ar-archive a:hover {
  color: var(--scc-white);
  text-decoration: underline;
}
/* ============================================================
   13. FULL-WIDTH GIVING HIGHLIGHT (like UNCW campaign section)
   ============================================================ */
.ar-highlight-band {
  padding: 72px 0;
  background: var(--scc-blue);
  color: var(--scc-white);
}

.ar-highlight-band--bg-image {
  background-size: cover;
  background-position: center;
}

.ar-highlight-band--robeson {
  background-image:
    linear-gradient(
      to bottom,
      rgba(0, 45, 93, 0.70) 0%,
      rgba(0, 45, 93, 0.92) 100%
    ),
    url('https://sccnc.edu/wp-content/uploads/2026/06/Robeson.jpg');
  background-size: cover;
  background-position: center;
  background-color: var(--scc-navy);
}

.ar-highlight-band--prison {
  background-image:
    linear-gradient(
      to bottom,
      rgba(0, 45, 93, 0.70) 0%,
      rgba(0, 45, 93, 0.92) 100%
    ),
    url('https://sccnc.edu/wp-content/uploads/2026/06/Prison-Education.jpg');
  background-size: cover;
  background-position: top center;
  background-color: var(--scc-navy);
}

.ar-highlight-band--truck {
  background-image:
    linear-gradient(
      to bottom,
      rgba(0, 45, 93, 0.70) 0%,
      rgba(0, 45, 93, 0.92) 100%
    ),
    url('https://sccnc.edu/wp-content/uploads/2026/02/628432762_1444191101039349_1064285836287456423_n-1024x683.jpg');
  background-size: cover;
  background-position: center;
  background-color: var(--scc-navy);
}

.ar-highlight-band__inner {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 60px;
  align-items: center;
}

.ar-highlight-band h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--scc-white);
  margin: 0 0 20px;
}

.ar-highlight-band p {
  font-size: 16px;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 14px;
}

.ar-highlight-band__stat {
  text-align: center;
  border: 2px solid rgba(255, 255, 255, 0.3);
  padding: 40px 28px;
}

.ar-highlight-band__stat-number {
  display: block;
  font-size: clamp(42px, 5vw, 60px);
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1;
  margin-bottom: 8px;
}

.ar-highlight-band__stat-label {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* ============================================================
   STRATEGIC PLAN RESULTS — Horizontal Timeline
   ============================================================ */
.ar-strategic {
  background: var(--scc-navy);
  color: var(--scc-white);
}

.ar-strategic__header-band {
  padding: 72px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.ar-strategic__header-band .ar-section-label {
  color: var(--scc-orange);
}

.ar-strategic__header-band h2 {
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 800;
  color: var(--scc-white);
  margin: 0 0 12px;
  line-height: 1.1;
}

.ar-strategic__header-band p {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
}

.ar-strategic__body {
  padding: 0 0 80px;
  background: var(--scc-white);
}

.ar-strategic__timeline {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  position: relative;
}

#strategic-partnerships-grid{
	background: #002d5d;
}

#strategic-partnerships-grid .ar-section-label{
	color: var(--scc-orange);
}

#strategic-partnerships-grid h2{
	color: var(--scc-white);
	margin-bottom: 42px;
}

#strategic-partnerships-grid .ar-awards-sub{
	color: var(--scc-white);
}
/* Horizontal connecting line — top: 40px padding + 28px (half of 56px dot) */
.ar-strategic__timeline::before {
  content: '';
  position: absolute;
  top: 68px;
  left: 12.5%;
  right: 12.5%;
  height: 4px;
  background: #dde3ea;
  z-index: 0;
}

.ar-strategic__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 24px 0;
}

.ar-strategic__item + .ar-strategic__item {
  border-left: 1px solid #e2e8f0;
}

.ar-strategic__dot {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--scc-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  margin-bottom: 32px;
  box-shadow: 0 0 0 6px rgba(0, 92, 185, 0.15);
}

.ar-strategic__dot span {
  font-size: 20px;
  font-weight: 800;
  color: var(--scc-white);
  line-height: 1;
}

.ar-strategic__card {
  width: 100%;
}

.ar-strategic__title {
  font-size: 17px;
  font-weight: 700;
  color: var(--scc-navy);
  margin: 0 0 14px;
  line-height: 1.25;
}

.ar-strategic__goal {
  font-size: 13px;
  line-height: 1.7;
  color: var(--scc-text);
  margin-bottom: 16px;
}

.ar-strategic__goal strong {
  color: var(--scc-navy);
  font-weight: 600;
}

.ar-strategic__target {
  font-size: 13px;
  color: var(--scc-text);
  margin-bottom: 20px;
  padding: 10px 14px;
  background: var(--scc-light);
  border-left: 3px solid var(--scc-orange);
  line-height: 1.55;
}

.ar-strategic__target span {
  display: block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--scc-orange);
  margin-bottom: 4px;
}

.ar-strategic__results-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--scc-navy);
  margin: 0 0 8px;
}

.ar-strategic__results-text {
  font-size: 13px;
  line-height: 1.75;
  color: var(--scc-text);
  margin: 0;
}

@media (max-width: 960px) {
  .ar-strategic__timeline {
    grid-template-columns: repeat(2, 1fr);
  }

  .ar-strategic__timeline::before {
    display: none;
  }

  .ar-strategic__item + .ar-strategic__item {
    border-left: none;
  }

  .ar-strategic__item:nth-child(odd) {
    border-right: 1px solid #e2e8f0;
  }

  .ar-strategic__item:nth-child(3),
  .ar-strategic__item:nth-child(4) {
    border-top: 1px solid #e2e8f0;
    padding-top: 40px;
    margin-top: 0;
  }
}

@media (max-width: 560px) {
  .ar-strategic__timeline {
    grid-template-columns: 1fr;
  }

  .ar-strategic__item:nth-child(odd) {
    border-right: none;
  }

  .ar-strategic__item {
    border-top: 1px solid #e2e8f0 !important;
    padding-top: 36px !important;
    align-items: flex-start;
  }

  .ar-strategic__item:first-child {
    border-top: none !important;
  }
}

/* ============================================================
   14. FULL PRESIDENT'S LETTER
   ============================================================ */
/*.ar-letter {
  padding: 80px 0 88px;
  background: var(--scc-white);
}*/

.ar-letter{
	padding: 20px 0;
  background: var(--scc-white);
}

.ar-letter__inner {
  max-width: 960px;
  margin: 0 auto;
}

.ar-letter__accordion {
  border-bottom: 3px solid var(--scc-navy);
}

.ar-letter__accordion > summary {
  list-style: none;
  cursor: pointer;
}

.ar-letter__accordion > summary::-webkit-details-marker {
  display: none;
}

.ar-letter__accordion > summary:focus-visible {
  outline: 3px solid var(--scc-orange);
  outline-offset: 4px;
}

.ar-letter__header {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 28px;
  align-items: center;
  padding-bottom: 10px;
  transition: opacity 0.2s ease;
}

/*.ar-letter__header {
  display: grid;
  grid-template-columns: 150px 1fr auto;
  gap: 28px;
  align-items: center;
  padding-bottom: 24px;
  transition: opacity 0.2s ease;
}*/

.ar-letter .ar-container{
margin: 0;
padding: 0;}

.ar-letter__accordion > summary.ar-letter__header:hover .ar-letter__header-text h2 {
  color: var(--scc-orange);
}

.ar-letter__toggle {
  font-size: 22px;
  color: var(--scc-navy);
  transition: transform 0.3s ease, color 0.2s ease;
  justify-self: end;
  padding-right: 4px;
}

.ar-letter__accordion[open] .ar-letter__toggle {
  transform: rotate(180deg);
}

.ar-letter__accordion > summary:hover .ar-letter__toggle {
  color: var(--scc-orange);
}

.ar-letter__body {
  padding-top: 40px;
  animation: ar-letter-fade 0.35s ease;
}

@keyframes ar-letter-fade {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ar-letter__header-image {
  width: 150px;
  height: 150px;
  overflow: hidden;
  flex-shrink: 0;
}

.ar-letter__header-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}

.ar-letter__header-text {
  display: flex;
  flex-direction: column;
}

/*.ar-letter__header h2 {
  font-size: clamp(26px, 3vw, 40px);
  font-weight: 800;
  color: var(--scc-navy);
  margin: 8px 0 0;
  line-height: 1.15;
}*/

.ar-letter__header h2 {
  font-size: 28px !important;
  font-weight: 800;
  color: var(--scc-navy);
  margin: 8px 0 0;
  line-height: 1.15;
}

@media (max-width: 600px) {
  .ar-letter__header {
    grid-template-columns: 110px 1fr auto;
    gap: 20px;
  }

  .ar-letter__header-image {
    width: 110px;
    height: 110px;
  }

  .ar-letter__toggle {
    font-size: 18px;
  }
}

@media (max-width: 420px) {
  .ar-letter__header {
    grid-template-columns: 90px 1fr auto;
    gap: 16px;
    text-align: left;
  }

  .ar-letter__header-image {
    width: 90px;
    height: 90px;
  }
}

.ar-letter p {
  font-size: 17px;
  line-height: 1.85;
  color: var(--scc-text);
  margin-bottom: 22px;
}

.ar-letter__list {
  font-size: 17px;
  line-height: 1.85;
  color: var(--scc-text);
  margin: 0 0 22px;
  padding-left: 22px;
  list-style: disc;
}

.ar-letter__list li {
  margin-bottom: 6px;
}

.ar-letter__list li::marker {
  color: var(--scc-orange);
}

.ar-letter__signature {
  margin-top: 40px;
  padding-top: 32px;
  border-top: 1px solid #dde3ea;
}

.ar-letter__signature p {
  margin-bottom: 2px;
  font-size: 16px;
}

.ar-letter__signature p:first-child {
  font-size: 18px;
  color: var(--scc-navy);
}

.ar-letter__signature p:last-child {
  color: var(--scc-muted);
  font-size: 14px;
  margin-bottom: 0;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 960px) {
  .ar-narrative__grid,
  .ar-narrative__grid--reverse {
    grid-template-columns: 1fr;
    direction: ltr;
    gap: 40px;
  }

  .ar-narrative__image img {
    height: 300px;
  }

  .ar-narrative__second-image img {
    height: 300px;
	  margin-top: 10px;
  }

  .ar-stats__grid,
  .ar-factoids__grid,
  .ar-awards__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .ar-giving__inner,
  .ar-highlight-band__inner {
    grid-template-columns: 1fr;
  }

  .ar-leadership__track {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .ar-container {
    padding: 0 20px;
  }

  .ar-hero {
    height: 420px;
  }

  .ar-stats__grid,
  .ar-factoids__grid {
    grid-template-columns: 1fr;
  }

  .ar-awards__grid {
    grid-template-columns: 1fr;
  }

  .ar-leadership__track {
    grid-template-columns: 1fr;
  }

  .ar-cta__buttons {
    flex-direction: column;
    align-items: center;
  }
}


/* ============================================================
   REGISTRATION
   ============================================================ */
.ar-registration {
  padding: 80px 0;
  background: var(--scc-light);
}

.ar-registration__intro {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 60px;
}


.ar-registration__lead {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--scc-text);
}

.ar-registration__columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  margin-bottom: 60px;
}

.ar-registration__col {
  background: var(--scc-white);
  border-top: 6px solid var(--scc-orange);
  padding: 40px 32px;
  box-shadow: 0 4px 18px rgba(0, 45, 93, 0.08);
}

.ar-registration__col-title {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--scc-navy);
  margin: 0 0 28px;
  padding-bottom: 16px;
  border-bottom: 2px solid var(--scc-light);
}

.ar-registration__steps {
  list-style: none;
  padding: 0;
  margin: 0;
}

.ar-registration__step {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  padding: 18px 0;
  border-bottom: 1px solid var(--scc-light);
}

.ar-registration__step:last-child {
  border-bottom: none;
}

.ar-registration__step-num {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--scc-orange);
  background: rgba(232, 115, 26, 0.08);
  padding: 8px 14px;
  border-radius: 4px;
  height: fit-content;
  white-space: nowrap;
}

.ar-registration__step-text {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--scc-text);
  margin: 4px 0 0;
}

.ar-registration__step-text a {
  color: var(--scc-blue);
}

.ar-registration__callouts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  margin-bottom: 60px;
}

.ar-registration__qr,
.ar-registration__counseling {
  background: var(--scc-navy);
  color: var(--scc-white);
  padding: 40px 32px;
}

.ar-registration__counseling {
  background: var(--scc-blue);
}

.ar-registration__qr h3,
.ar-registration__counseling h3 {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 1.4rem;
  color: var(--scc-white);
  margin: 12px 0 16px;
  line-height: 1.3;
}

.ar-registration__qr p,
.ar-registration__counseling p {
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
  margin: 0 0 24px;
}

.ar-registration__qr .ar-section-label,
.ar-registration__counseling .ar-section-label {
  color: rgba(255, 255, 255, 0.65);
}

.ar-registration__dates {
  background: var(--scc-navy);
  color: var(--scc-white);
  padding: 48px 40px;
}

.ar-registration__dates h3 {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 1.8rem;
  color: var(--scc-white);
  margin: 12px 0 32px;
}

.ar-registration__dates .ar-section-label {
  color: rgba(255, 255, 255, 0.65);
}

.ar-registration__dates-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 18px;
}

.ar-registration__date {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 24px;
  padding: 20px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.ar-registration__date:last-child {
  border-bottom: none;
}

.ar-registration__date-day {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  color: var(--scc-orange);
}

.ar-registration__date-label {
  font-size: 1rem;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.92);
}

@media (max-width: 900px) {
  .ar-registration__columns,
  .ar-registration__callouts {
    grid-template-columns: 1fr;
  }

  .ar-registration__intro h2 {
    font-size: 2.2rem;
  }

  .ar-registration__date {
    grid-template-columns: 1fr;
    gap: 6px;
  }
}

@media (max-width: 600px) {
  .ar-registration {
    padding: 50px 0;
  }

  .ar-registration__intro h2 {
    font-size: 1.8rem;
  }

  .ar-registration__step {
    grid-template-columns: 1fr;
  }

  .ar-registration__step-num {
    width: fit-content;
  }
}


/* ============================================================
   NC RECONNECT
   ============================================================ */
.ar-nc-reconnect {
  padding: 80px 0;
  background: var(--scc-white);
}


.ar-nc-reconnect__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

.ar-nc-reconnect__image {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.ar-nc-reconnect__image img {
  width: 100%;
  height: auto;
  display: block;
}

.ar-nc-reconnect__badge {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: var(--scc-white);
  padding: 14px 22px;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  color: var(--scc-navy);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
}



.ar-nc-reconnect__content p {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--scc-text);
  margin: 0 0 18px;
}

@media (max-width: 900px) {
  .ar-nc-reconnect__grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .ar-nc-reconnect__content h2 {
    font-size: 1.8rem;
  }
}

/* ============================================================
   STUDENT SPOTLIGHT VIDEOS
   ============================================================ */
.ar-spotlight-videos {
  padding: 80px 0;
  background: var(--scc-navy);
  color: var(--scc-white);
}

.ar-spotlight-videos__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

.ar-spotlight-videos h2 {
	color: #fff;
}

.ar-spotlight-videos__image {
  position: relative;
}

.ar-spotlight-videos__image img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.ar-spotlight-videos__content .ar-section-label {
  color: rgba(255, 255, 255, 0.65);
}

.ar-spotlight-videos__content p {
  font-size: 16px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
  margin: 0 0 8px;
}

.ar-spotlight-videos__logos {
  display: flex;
  align-items: center;
  gap: 36px;
  margin-top: 44px;
  padding-top: 32px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  flex-wrap: wrap;
}

.ar-spotlight-videos__logo {
  height: 64px;
  width: auto;
  object-fit: contain;
  display: block;
}

@media (max-width: 900px) {
  .ar-spotlight-videos__grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }
}

@media (max-width: 600px) {
  .ar-spotlight-videos {
    padding: 56px 0;
  }

  .ar-spotlight-videos__logos {
    gap: 24px;
    margin-top: 32px;
    padding-top: 24px;
  }

  .ar-spotlight-videos__logo {
    height: 48px;
  }
}



/* ============================================================
   BUDGET DONUT CHARTS
   ============================================================ */
.ar-budget {
  padding: 80px 0;
}

.ar-budget--dark {
  background: var(--scc-navy);
  color: var(--scc-white);
}

.ar-budget--light {
  background: var(--scc-blue);
  color: var(--scc-white);
}

.ar-budget__header {
  margin-bottom: 40px;
}

.ar-budget__header .ar-section-label {
  color: rgba(255, 255, 255, 0.65);
}

.ar-budget__title {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 2.5rem;
  margin: 0;
  color: var(--scc-white);
}

.ar-budget__layout {
  display: grid;
  grid-template-columns: minmax(260px, 360px) 1fr;
  gap: 60px;
  align-items: center;
}

.ar-donut {
  width: 100%;
  height: auto;
  max-width: 360px;
  display: block;
  margin: 0 auto;
}

.ar-donut__ring {
  fill: none;
  stroke-width: 18;
}

.ar-donut__center-label {
  font-family: 'Poppins', sans-serif;
  font-size: 6px;
  fill: var(--scc-white);
  opacity: 0.85;
}

.ar-donut__center-num {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 8px;
  fill: var(--scc-white);
}

.ar-budget__legend {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px 40px;
}

.ar-budget__legend-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.ar-budget__legend-dot {
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  margin-top: 6px;
}

.ar-budget__legend-text {
  display: flex;
  flex-direction: column;
}

.ar-budget__legend-label {
  font-family: 'Poppins', sans-serif;
  font-weight: 500;
  font-size: 0.95rem;
  color: var(--scc-white);
  opacity: 0.9;
}

.ar-budget__legend-value {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--scc-white);
  margin-top: 2px;
}

@media (max-width: 900px) {
  .ar-budget__layout {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .ar-budget__title {
    font-size: 2rem;
  }
}

@media (max-width: 600px) {
  .ar-budget__legend {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .ar-budget__title {
    font-size: 1.6rem;
  }
}


/* ============================================================
   MOBILE PASS — global responsive cleanup
   ============================================================ */

/* Tablet landscape and below */
@media (max-width: 960px) {
  /* Generous section padding eats too much vertical space on mobile */
  .ar-recognition,
  .ar-letter,
  .ar-strategic__header-band,
  .ar-stats,
  .ar-enrollment,
  .ar-highlight-band,
  .ar-giving,
  .ar-awards,
  .ar-new-leadership,
  .ar-cta {
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .ar-narrative {
    padding: 56px 0;
  }

  .ar-budget,
  .ar-registration,
  .ar-nc-reconnect {
    padding: 56px 0;
  }

  /* Full-width image breaks at fixed 900px ruin mobile flow */
  .ar-fullwidth-image {
    height: 460px;
  }

  /* New Leadership cards stack to 2 cols then 1 below */
  .ar-new-leadership__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* Employee/Student spotlight items: stack image above content */
  .ar-employee-award-item {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .ar-employee-award-item__image {
    aspect-ratio: 16 / 9;
    max-height: 320px;
  }

  /* Decorative side patterns on enrollment can overflow */
  .ar-enrollment::before,
  .ar-enrollment::after {
    width: 120px;
  }

  /* Demographics rotated decoration too dominant on narrow widths */
  .ar-demo__band::after {
    width: 180px;
    opacity: 0.04;
  }

  /* Hero scroll-margin doesn't need 120px on smaller viewports */
  [id] {
    scroll-margin-top: 90px;
  }
}

/* Phone landscape and below */
@media (max-width: 768px) {
  .ar-hero {
    height: 520px;
    margin-top: 80px;
  }

  .ar-hero__overlay {
    padding-bottom: 40px;
  }

  .ar-toc {
    padding: 32px 0;
  }

  .ar-container {
    padding: 0 24px;
  }

  /* Awards / new leadership / strategic cards: collapse to 1 col */
  .ar-new-leadership__grid {
    grid-template-columns: 1fr;
  }

  .ar-fullwidth-image {
    height: 320px;
  }

  /* Demographics col padding tighter on mobile */
  .ar-demo__col {
    padding: 32px 24px 36px;
  }

  /* Letter typography */
  .ar-letter {
    padding: 56px 0 64px;
  }

  .ar-letter p {
    font-size: 16px;
    line-height: 1.75;
  }

  /* Giving rows wrap label + value */
  .ar-giving__row {
    flex-wrap: wrap;
    gap: 4px 0;
    font-size: 14px;
  }

  /* Recognition list - tighter spacing */
  .ar-recognition__list li {
    padding: 12px 0 12px 24px;
    font-size: 15px;
  }

  /* Strategic plan card body padding */
  .ar-strategic__item {
    padding: 32px 20px 0;
  }

  /* Highlight band stat sits below at mobile, give breathing room */
  .ar-highlight-band__stat {
    padding: 28px 20px;
  }

  /* Registration step number stays inline but smaller */
  .ar-registration__col {
    padding: 28px 22px;
  }

  .ar-registration__dates {
    padding: 36px 24px;
  }

  .ar-registration__intro {
    margin-bottom: 40px;
  }

  /* Foundation callout shrinks */
  .ar-giving__callout {
    padding: 32px 24px;
  }

  /* CTA buttons full width on mobile */
  .ar-cta__buttons .ar-btn {
    width: 100%;
    max-width: 280px;
  }

  /* Donut text needs to be smaller as chart shrinks */
  .ar-donut__center-num {
    font-size: 8px;
  }

  /* NC Reconnect badge smaller */
  .ar-nc-reconnect__badge {
    padding: 10px 16px;
    font-size: 0.95rem;
  }

  /* Section labels tighten */
  .ar-section-label {
    font-size: 12px;
    letter-spacing: 2px;
  }

  /* Award card image height reduces */
  .ar-award-card__image {
    height: 220px;
  }
}

/* Small phones */
@media (max-width: 480px) {
  .ar-container {
    padding: 0 18px;
  }

  .ar-hero {
    height: 460px;
    margin-top: 70px;
  }

	.ar-hero__bg {
		object-position: top left !important;
	}

  .ar-hero h1 {
    font-size: 32px;
  }

  .ar-hero__overlay {
    padding-bottom: 32px;
  }

  /* Section padding tightens further */
  .ar-recognition,
  .ar-letter,
  .ar-stats,
  .ar-enrollment,
  .ar-highlight-band,
  .ar-giving,
  .ar-awards,
  .ar-new-leadership,
  .ar-cta,
  .ar-narrative,
  .ar-budget,
  .ar-registration,
  .ar-nc-reconnect {
    padding-top: 44px;
    padding-bottom: 44px;
  }

  /* Stats grid: bottom inner also collapses to 1 col */
  .ar-stats__grid,
  .ar-stats__grid-bottom .ar-stats__grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .ar-stats__item {
    padding: 24px 16px;
  }

  /* Hide side patterns on small phones — too cluttered */
  .ar-enrollment::before,
  .ar-enrollment::after {
    display: none;
  }

  .ar-demo__band::after {
    display: none;
  }

  /* Demographics: tighten headcount + KPIs */
  .ar-demo__band {
    padding: 36px 0 28px;
  }

  .ar-demo__headcount-num {
    font-size: 40px;
  }

  /* Awards / cards: image shorter */
  .ar-award-card__image {
    height: 200px;
  }

  /* Letter typography tightens */
  .ar-letter__header h2 {
    font-size: 22px;
  }

  .ar-letter p {
    font-size: 15px;
  }

  /* TOC link padding tighter */
  .ar-toc__link {
    padding: 12px 14px;
    gap: 10px;
  }

  .ar-toc__title {
    font-size: 13px;
  }

  /* Strategic card */
  .ar-strategic__header-band {
    padding: 44px 0 36px;
  }

  .ar-strategic__body {
    padding-bottom: 44px;
  }

  .ar-strategic__card {
    padding: 0;
  }

  /* Registration adjustments */
  .ar-registration__intro h2 {
    font-size: 1.6rem;
  }

  .ar-registration__col {
    padding: 24px 20px;
  }

  .ar-registration__col-title {
    font-size: 1.25rem;
    margin-bottom: 20px;
    padding-bottom: 12px;
  }

  .ar-registration__qr,
  .ar-registration__counseling {
    padding: 32px 22px;
  }

  .ar-registration__qr h3,
  .ar-registration__counseling h3 {
    font-size: 1.2rem;
  }

  .ar-registration__dates h3 {
    font-size: 1.4rem;
  }

  /* NC Reconnect tight grid gap on stack */
  .ar-nc-reconnect__grid {
    gap: 24px;
  }

  .ar-nc-reconnect__content h2 {
    font-size: 1.5rem;
  }

  .ar-nc-reconnect__badge {
    bottom: 12px;
    right: 12px;
    padding: 8px 12px;
    font-size: 0.85rem;
  }

  /* Donut: shrink center text to fit total amount */
  .ar-donut__center-num {
    font-size: 7px;
  }

  /* Full-width image breaks further reduce */
  .ar-fullwidth-image {
    height: 240px;
  }

  /* Highlight band stat shrinks */
  .ar-highlight-band__stat {
    padding: 24px 18px;
  }

  .ar-highlight-band__stat-number {
    font-size: 38px;
  }

  /* Giving callout shrinks */
  .ar-giving__callout {
    padding: 28px 20px;
  }

  .ar-giving__callout-number {
    font-size: 32px;
  }

  /* Leader card padding tighter */
  .ar-leader-card {
    padding: 20px 18px;
  }

  /* Narrative content h2 tightens */
  .ar-narrative__content h2 {
    font-size: 22px;
    line-height: 1.25;
  }

  /* Narrative image height shorter on phones */
  .ar-narrative__image img {
    height: 240px;
  }

  /* Smaller scroll margin to match smaller fixed header */
  [id] {
    scroll-margin-top: 72px;
  }

  /* Section labels even smaller */
  .ar-section-label {
    font-size: 11px;
    letter-spacing: 1.5px;
  }
}

.ar-archive .ar-link-wrapper{
	margin-bottom: 1rem;
}

.ar-archive .ar-letter__accordion{
	background: #002d5d;
}

.ar-archive .ar-container{
	background: #002d5d;
}

.ar-archive .ar-letter{
	background: #002d5d;
}

.ar-archive .ar-letter__header-text h2{
	color: var(--scc-white);
}

.ar-archive .fa-chevron-down{
	color: var(--scc-white);
}</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style>
/* =========================================
   SCC HERO SLIDER – LAYOUT & BASE STYLES
   ========================================= */

/* Full-width breakout */
.scc-hero-slider {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  position: relative;
  overflow: hidden;
  height: auto;
	max-height: 90vh !important;
}

body {
  overflow-x: hidden;
}

/* Viewport & track */
.scc-hero-slider__viewport {
  overflow: hidden;
  position: relative;
}

.scc-hero-slider__track {
  display: flex;
  transition: transform 0.6s ease;
  will-change: transform;
}

/* =========================================
   SLIDE LAYOUT
   ========================================= */

.scc-hero-slider__slide {
  min-width: 100%;
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  min-height: 460px;
  align-items: stretch;
}

/* Ensure correct order */
.scc-hero-slider__panel { order: 1; }
.scc-hero-slider__media { order: 2; }

/* =========================================
   AUTOPLAY TOGGLE
   ========================================= */

.scc-hero-slider__bottom-ui {
  position: absolute;
  left: clamp(40px, 6vw, 80px);
  bottom: clamp(40px, 6vw, 80px);
  display: flex;
  align-items: center;
  gap: 14px;
  z-index: 10;
}

.scc-hero-slider__bottom-ui .scc-hero-slider__dots {
  position: static;
  left: auto;
  bottom: auto;
}
.scc-hero-slider__autoplay-toggle {
  position: absolute;
  top: 50%;
  left: 100%; /* near right edge of left panel */
  transform: translateY(-50%);
  width: 52px;
  height: 52px;
  font-size: 18px;
  border: 2px solid #fff;
  border-radius: 50% !important;
  background: transparent !important;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  box-shadow: none !important;
	margin-left: 20px !important;
}

.scc-hero-slider__autoplay-toggle span[aria-hidden="true"] {
  font-size: 18px;
  line-height: 1;
}

.scc-hero-slider__autoplay-toggle:hover,
.scc-hero-slider__autoplay-toggle:focus {
  background: rgba(255,255,255,0.12) !important;
  color: #fff;
}

@media (max-width: 1024px) {
  .scc-hero-slider__bottom-ui {
    left: 50% !important;
    transform: translateX(-50%);
    bottom: 20px !important;
  }
  
  .scc-hero-slider__autoplay-toggle {
    display: none !important;
  }

  .scc-hero-slider__dots {
    left: auto !important;
    bottom: auto !important;
  }
}

/* =========================================
   LEFT PANEL (CONTENT)
   ========================================= */


.scc-hero-slider__panel {
  color: #ffffff;
  display: flex;
  align-items: center;
  padding: clamp(40px, 6vw, 90px);
  position: relative; /* Needed for centered arrows */
  background: #4c6fb4; /* default fallback */
}

.scc-hero-slider__panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("https://sccnc.edu/wp-content/uploads/2026/03/SCC_Primary_Logo_Slider-Bg.svg");
  background-repeat: no-repeat;
  background-size: 420px auto;
  background-position: left -90px center;
  opacity: 0.08;
  pointer-events: none;
  z-index: 1;
}

/* =========================================
   WATERMARK TOGGLE
   When the ACF "watermark" true/false field is
   set to false, this class is added to the panel
   and hides the ::before SVG watermark entirely.
   ========================================= */

.scc-hero-slider__panel--no-watermark::before {
  display: none;
}

.scc-hero-slider__panel--light-blue {
  background: #005cb9;
}

.scc-hero-slider__panel--dark-blue {
  background: #002D5D;
}

.scc-hero-slider__panel--turquoise {
  background: #ff6b00; /* placeholder - swap once you have final hex */
}

.scc-hero-slider__inner {
  max-width: 560px;
  width: 100%;
  margin: 0 auto;
}

/* Headline */
.scc-hero-slider__title {
  font-size: clamp(36px, 4vw, 56px);
	font-family: 'Poppins', sans-serif !important;
  line-height: 1.1;
  font-weight: 800;
  margin-bottom: 18px;
  color: #ffffff;
}

/* Subheading */
.scc-hero-slider__subheading {
  font-size: clamp(16px, 1.4vw, 20px);
  line-height: 1.6;
  margin-bottom: 28px;
  color: #ffffff;
	font-weight: 700;
  opacity: 1;
}

/* Buttons */
.scc-hero-slider__buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
	position: relative;
	z-index: 4;
}

.scc-hero-slider__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200px;
  padding: 14px 26px;
  font-weight: 700;
  text-decoration: none;
  border-radius: 2px;
  background: #ffffff;
  color: #1f2a44;
  transition: all 0.25s ease;
}

.scc-hero-slider__button:hover {
  background: #1f2a44;
  color: #ffffff;
}

.scc-hero-slider__button--secondary {
  background: transparent;
  color: #ffffff;
  border: 2px solid #ffffff;
}

.scc-hero-slider__button--secondary:hover {
  background: #ffffff;
  color: #1f2a44;
}

/* BUTTON COLOR SYSTEM */


.button-link.scc-btn--orange {
background:#FF6B00 !important;
border-color:#FF6B00;
color:white;
}

.button-link.scc-btn--light-blue {
background:#005cb9 !important;
border-color:#005cb9;
color:white;
}

.button-link.scc-btn--dark-blue {
background:#002D5D !important;
border-color:#002D5D;
color:white;
}

.button-link.scc-btn--turquoise {
background:#002d5d !important;
border-color:#002d5d;
color:white;
}

/* Hover states */

.button-link.scc-btn--orange:hover{
background:#FF9015 !important;
border-color:#FF9015;
}

.button-link.scc-btn--light-blue:hover{
background:#3f5fa0 !important;
border-color:#3f5fa0;
}

.button-link.scc-btn--dark-blue:hover{
background:#001f42 !important;
border-color:#001f42;
}

.button-link.scc-btn--turquoise:hover{
background:#3d7d77 !important;
border-color:#3d7d77;
}

/* =========================================
   RIGHT PANEL (MEDIA)
   ========================================= */

.scc-hero-slider__media {
  position: relative;
  height: 100%;
	width: 100%;
  background: #0b0b0b; /* fallback color behind contain */
  display: flex;
  overflow: hidden;
}

.scc-hero-slider__media img,
.scc-hero-slider__media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Optional soft overlay */
.scc-hero-slider__media::after {
  content: "";
  position: absolute;
  inset: 0;
/*
  background: linear-gradient(
    to left,
    rgba(0,0,0,0.15),
    rgba(0,0,0,0.35)
  );
*/
  pointer-events: none;
}

/* =========================================
   NAVIGATION CONTROLS (UPDATED)
   ========================================= */

/* Arrows centered vertically inside left panel */


/* Controls container */
.scc-hero-slider__controls {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 5;
}

/* Individual arrows */
.scc-hero-slider__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: auto;
	background: transparent !important;
	box-shadow: none !important;
	color: #fff;              /* arrow color */
  cursor: pointer;
}

/* LEFT arrow */
.scc-hero-slider__nav--prev {
  left: 20px; /* adjust this number */
}

/* RIGHT arrow */
.scc-hero-slider__nav--next {
  right: 20px; /* adjust this number */
}

.scc-hero-slider__icon {
  width: 30px;
  height: 30px;
  display: block;

  fill: currentColor !important;   /* 👈 important */
  stroke: none !important;
}
/* ========================================= 
DOT NAVIGATION 
========================================= */ 

.scc-hero-slider__dots { 
	position: absolute; 
	left: clamp(40px, 6vw, 80px); 
	bottom: clamp(40px, 6vw, 80px); 
	display: flex; gap: 10px; z-index: 10; 
} 
.scc-hero-slider__dot { 
	width: 14px; 
	height: 14px; 
	border-radius: 50% !important; 
	border: solid 2px #fff;
	border: none; 
	background: #fff; 
	cursor: pointer; 
} 
.scc-hero-slider__dot[aria-current="true"] { 
	background: transparent !important; 
	border: solid 2px #FF6B00 !important;
}


/* =========================================
   RESPONSIVE
   ========================================= */
/*
@media (max-width: 1024px) {
  .scc-hero-slider__slide {
    grid-template-columns: 1fr;
  }

  .scc-hero-slider__media {
    min-height: 320px;
  }
}
*/

@media (max-width: 1024px) {
  .scc-hero-slider__slide{
    grid-template-columns: 1fr;
    grid-template-rows: auto auto; /* media row then panel row */
  }

  .scc-hero-slider__media{
    grid-column: 1;
    grid-row: 1;
    min-height: 320px; /* keep your existing behavior */
  }

  .scc-hero-slider__panel{
    grid-column: 1;
    grid-row: 2;
  }
  
  .scc-hero-slider__nav--next {
		right: 5px !important;
  }
	
	.scc-hero-slider__nav--prev {
		left: 5px !important;
	}
	
	.scc-hero-slider__dots {
		left: 48% !important;
		bottom: 20px !important;
	}
}

@media (max-width: 600px) {
  .scc-hero-slider__title {
    font-size: 32px;
  }

  .scc-hero-slider__buttons {
    flex-direction: column;
    align-items: flex-start;
  }

  .scc-hero-slider__button {
    width: 100%;
  }
}

/* =========================================
   SCREEN READER ONLY
   ========================================= */

.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0,0,0,0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}



</style>
