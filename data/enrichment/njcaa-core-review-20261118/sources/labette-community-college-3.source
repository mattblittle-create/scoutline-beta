<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.owl-nav').forEach(function (nav) {
    const prevButton = nav.querySelector('.owl-prev');
    const nextButton = nav.querySelector('.owl-next');

    if (prevButton) {
      // Remove invalid ARIA role
      prevButton.removeAttribute('role');

      // Add accessible name
      prevButton.setAttribute('aria-label', 'Previous slide');

      // Hide icon from screen readers
      const icon = prevButton.querySelector('i');
      if (icon) {
        icon.setAttribute('aria-hidden', 'true');
      }
    }

    if (nextButton) {
      nextButton.removeAttribute('role');
      nextButton.setAttribute('aria-label', 'Next slide');

      const icon = nextButton.querySelector('i');
      if (icon) {
        icon.setAttribute('aria-hidden', 'true');
      }
    }
  });
});
</script> 
