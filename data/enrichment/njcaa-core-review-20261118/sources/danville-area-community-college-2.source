                                    menuItems.forEach((element) => {
                                        if(!currentTarget.isSameNode(element)) {
                                            let navdata = ko.dataFor(element);
                                            navdata.closeMenuItem();
                                        }
                                    });
    
                                    toggleMenuItem();
                                  },
                                  css: {'is-toggled':isItemOpen() },
                                  attr: {
