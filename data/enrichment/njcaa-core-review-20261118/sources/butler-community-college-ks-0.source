    <picture class="img-placeholder">
        <img src="/giving/Website_Ads/ALUMNI_INFO-_SCROLLLING_BANNER.jpg?max_width=auto&max_height=auto&crop=false" alt="Alumni" class="lazyloaded img-fluid mx-auto" loading="lazy" />
