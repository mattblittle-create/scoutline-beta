            $(function() {
                var paused = 0;

                $('#component-headlines-870-toggle-slider').click(function() {
                    var state = (paused) ? 'slickPlay' : 'slickPause';
                    paused = (paused) ? 0 : 1;
                    $("#component-headlines-870 .slick-slider").slick(state);
                    $(this).find('.fa').toggleClass('fa-play fa-pause');
                });
            })
        </script>
