			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Daequon Montreal","value":126},{"label":"Bobbi Stannard","value":209},{"label":"Kelli Temple","value":194},{"label":"Kaleb Jones","value":127},{"label":"Alexa Torbert","value":124},{"label":"Rachel Eldredge","value":154},{"label":"Patrick Hoxsey","value":210},{"label":"Boomer Walker","value":15},{"label":"Bruer Webster","value":202},{"label":"Kelton Caldwell","value":203},{"label":"Jeff Reinert","value":83},{"label":"Dawson Henshaw","value":130},{"label":"Matt Moorhouse","value":206},{"label":"Chase Roy","value":207},{"label":"Brendan Wheeler","value":190},{"label":"Reggie Larry","value":101},{"label":"Taliyah Clark","value":196},{"label":"Reylene Abbott","value":120},{"label":"Kendra Harpel","value":208},{"label":"Janae Richardson","value":125},{"label":"Zak Montoya","value":173},{"label":"Scott Scholes","value":174},{"label":"Katie Christensen","value":175},{"label":"Julie Wright-Leggett","value":28},{"label":"Sebastian Talamantes","value":200},{"label":"Skyler Ludlow","value":201},{"label":"Steve Birnie","value":9},{"label":"Kelly Wardell","value":62},{"label":"Kindle Purdy","value":189},{"label":"Julee Smith","value":179},{"label":"Mitch Pollock","value":180},{"label":"Ty Roland","value":205},{"label":"Alex Ferreira","value":140},{"label":"Andrew Zaleski","value":153},{"label":"Angel Navarrete","value":199},{"label":"Yves Mushiga","value":204},{"label":"Nick Baumert","value":8},{"label":"Gracie Walters","value":195},{"label":"Bri Holcomb","value":197},{"label":"Travis  Bunker","value":136},{"label":"Andria Parker","value":157},{"label":"Kevin Allred","value":188},{"label":"Natany Felix Guimarães","value":191},{"label":"Bailey Peña","value":193},{"label":"Raygen Bartel","value":183}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

			</main>

