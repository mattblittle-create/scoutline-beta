src='https://tag.simpli.fi/sifitag/a570336d-ba81-4b29-b3c9-5e0e78b7198d'></script>

        

        
        <script type="text/javascript">
            $(document).ready(function () {

                $('#search-form').on("submit", function (e) {
                    e.preventDefault();

                    var terms = $(this).find('input[name="terms"]').val();
                    var searchResults = $(this).attr('action') + "?terms=" + terms;

                    //$('#search-form-mobile input').attr('placeholder', terms);
                    $('#loading').show();
                    $.get(searchResults, function (data) {

                        $('#ajax-wrapper').html(data);
                        $('#loading').hide();

                        //$('#ajax-wrapper-mobile').html(data);
                    });



                });

                $('#search-form-mobile').on("submit", function (e) {
                    e.preventDefault();
                    var terms = $(this).find('input[name="terms"]').val();
                    var searchResults = $(this).attr('action') + "?terms=" + terms;

                    //$('#search-form input').attr('placeholder', terms);
                    $('#loading-Mobile').show();

                    $.get(searchResults + "&view=mobile", function (data) {
                        //$('#ajax-wrapper').html(data);
                        $('#ajax-wrapper-mobile').html(data);
                        $('#loading-Mobile').hide();

                    });
                });

                $('.ticker').ticker();

            });
        </script>
    
