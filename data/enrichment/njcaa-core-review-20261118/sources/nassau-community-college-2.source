								                        <div class="sidearm-roster-player-extra-stats-tabs">
									                        <ul class="flex" data-bind="foreach: stats">
										                        <li data-bind="text: title, clickBubble: false, click: $parent.selectStatCategory, css: { 'sidearm-roster-player-extra-stats-tabs-selected': selected }"></li>
									                        </ul>

									                        <!-- ko foreach: stats -->
										                        <div class="sidearm-roster-player-extra-stats-category" data-bind="visible: selected">
											                        <table class="sidearm-table">
												                        <caption class="hide">Player Statistics</caption>
												                        <thead>
													                        <tr data-bind="foreach: headings">
														                        <th scope="col" data-bind="text: $data">Statistic</th>
													                        </tr>
												                        </thead>
												                        <tbody>
													                        <!-- ko foreach: data -->
														                        <tr>
															                        <!-- ko foreach: $data -->
																                        <td data-bind="click: function() { return true; }, clickBubble: false, html: value, attr: { 'data-label': label }"></td>
															                        <!-- /ko -->
														                        </tr>
													                        <!-- /ko -->
												                        </tbody>
											                        </table>
										                        </div>
									                        <!-- /ko -->
								                        </div>
							                        </div>

						                        <!-- /ko -->

						                        <!-- ko if: !stats() && stories() -->
							                        <div class="sidearm-roster-player-extra-stories-only row pad">
								                        <div class="sidearm-roster-player-extra-stories columns">
                                                            
                                                                <h4 class="sidearm-roster-player-extra-heading">Headlines</h4>
                                                            
									                        <ul class="flex flex-column medium-flex-row row" data-bind="foreach: stories">
										                        <li class="x-small-12 medium-4 columns sidearm-roster-player-extra-story">
											                        <!-- ko if: image -->
											                        <div class="sidearm-roster-player-stories-media hide-on-small-down">
												                        <img data-bind="attr: { src: image + '?width=400&height=200&mode=crop' }" alt="">
											                        </div>
											                        <!-- /ko -->
											                        <span data-bind="formatDate: date, format: 'MMM. D'"></span>
											                        <p class="sidearm-roster-player-stories-headline">
												                        <a data-bind="click: function() { return true; }, clickBubble: false, text: headline, attr: { href: url }"></a>
											                        </p>
										                        </li>
									                        </ul>
								                        </div>
							                        </div>
							
						                        <!-- /ko -->

						                        <!-- ko if: stats() && stories() -->

							                        <div class="sidearm-roster-player-extra-stats-stories flex flex-wrap row">

								                        <div class="sidearm-roster-player-extra-stats x-small-12 large-8 columns">
									                        <ul class="flex" data-bind="foreach: stats">
										                        <li data-bind="click: $parent.selectStatCategory, clickBubble: false, css: { 'sidearm-roster-player-extra-stats-tabs-selected' : selected }">
											                        <span class="hide-on-medium" data-bind="text: title_short"></span>
											                        <span class="hide-on-small-down" data-bind="text: title"></span>
										                        </li>
									                        </ul>

									                        <!-- ko foreach: stats -->
										                        <div class="sidearm-roster-player-extra-stats-category" data-bind="visible: selected">
											                        <table class="sidearm-table">
												                        <caption class="hide">Player Statistics</caption>
												                        <thead class="text-smaller-on-small-down">
													                        <tr data-bind="foreach: headings">
														                        <th scope="col" class="text-left text-uppercase" data-bind="text: $data">Statistic</th>
													                        </tr>
												                        </thead>
												                        <tbody>
													                        <!-- ko foreach: data -->
														                        <tr>
															                        <!-- ko foreach: $data -->
																                        <td data-bind="click: function() { return true; }, clickBubble: false, html: value, attr: { 'data-label': label }"></td>
															                        <!-- /ko -->
														                        </tr>
													                        <!-- /ko -->
												                        </tbody>
											                        </table>

											                        <div class="flex flex-justify-between">
												                        <p class="text-italic">* Last 5 games played</p>  
												                        <!-- ko ifnot: $parent.hideBio -->
                                                                        <p>
                                                                            <a class="text-uppercase" data-bind="click: function() { return true; }, clickBubble: false, attr: { href: $parent.url }"><span class="icon-stats"></span> Full Bio</a>
                                                                        </p>
                                                                        <!-- /ko -->
											                        </div>
										                        </div>
									                        <!-- /ko -->
								                        </div>

								                        <div class="sidearm-roster-player-extra-stories x-small-12 large-4 columns">
									                        
