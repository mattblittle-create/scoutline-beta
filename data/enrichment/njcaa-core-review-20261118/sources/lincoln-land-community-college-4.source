            altcha-widget {
                z-index: 9000;
                position: fixed;
                bottom: 14px;
                right: -186px;
                transition: right 0.3s ease;
                box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
            }

            altcha-widget.visible {
                right: 0;
            }

            .altcha {
                background-color: #fff !important;
                padding: 0.7rem !important;
            }

            .altcha[data-state="error"] {
                --altcha-color-border: #f23939;
            }

            .altcha * {
                font-size: 8px;
            }

            .altcha-main {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 !important;
            }

            altcha-widget {
                --altcha-color-base: #ffffff;
                --altcha-color-border: #AEAEAE;
                --altcha-color-border-focus: #0073E6;
                --altcha-border-width: 1px;
                --altcha-border-radius: 4px;
            }

            .altcha-checkbox {
                display: none;
            }

            .altcha-label {
                display: none;
            }

            .altcha-error {
                margin-top: 4px !important;
            }

            .altcha-error svg {
                display: none;
            }

            .altcha-logo {
                opacity: 1;
                color: #1D1DC9 !important;
            }

            .altcha-logo svg {
                height: 20px;
                width: 20px;
            }

            .altcha-footer {
                display: block;
                margin-top: 4px !important;
                text-align: center;
                padding: 0 !important;
                color: #49494A !important;
            }

            .altcha-footer a {
                display: block;
                color: #49494A !important;
            }
        </style>
<altcha-widget challengeurl="https://llcc.tfaforms.net/api_v2/altcha/challenge" auto="onsubmit"></altcha-widget><script>
            var altchaWidget = document.querySelector('altcha-widget');
            altchaWidget.addEventListener('load', function () {
                requestAnimationFrame(function() {
                    altchaWidget.classList.add('visible');
                });

                altchaWidget.setAttribute('strings', JSON.stringify({ error: 'Verification failed.'}));
                altchaWidget.querySelector('.altcha-checkbox')?.remove();
                altchaWidget.querySelector('.altcha-label')?.remove();
            });

            altchaWidget.addEventListener('statechange', function (e) {
                if (e.detail.state === 'error') {
                    altchaWidget.reset();
                }
            });
        </script>
