                                            <dd data-bind="text: stadium"></dd>
                                        <!-- /ko -->
										<!-- ko if: location -->
                                            <dt>Location: </dt>
                                            <dd data-bind="text: location"></dd>
                                        <!-- /ko -->

                                        <!-- ko if: attendance && attendance != 0 -->
