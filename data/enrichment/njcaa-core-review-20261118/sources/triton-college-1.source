			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"A.J. Blahut","value":45},{"label":"Tim McKinney","value":10},{"label":"Emily-Jo Anderson","value":36},{"label":"Yaren Hernandez","value":50},{"label":"Andrew  Schroeder","value":115},{"label":"Darvell Burgess","value":73},{"label":"Kevin Barnes","value":102},{"label":"Nicole Foley","value":74},{"label":"Nick   Oliva","value":125},{"label":"Jessica   Blum ","value":126},{"label":"Ernest Radcliffe","value":85},{"label":"DeShawnte Carraway","value":121},{"label":"Kendall Radcliffe","value":99},{"label":"Michael  Woodard","value":90},{"label":"Rob Holloway","value":94},{"label":"Nick  Rocco","value":132},{"label":"Aaron Rolle","value":131},{"label":"Grant   Raedle","value":93},{"label":"Alan Brown","value":136},{"label":"Piotr Sliwa","value":2},{"label":"Alex Gomez","value":83},{"label":"Michal Szaflarski","value":129},{"label":"Jason Guevarra","value":76},{"label":"Sarah Guevarra","value":77},{"label":"Anthony Beacham","value":123},{"label":"Chris Butz","value":101},{"label":"Shamar Pugh","value":111},{"label":"Angel Nava","value":113},{"label":"Alonzo Smiley","value":135},{"label":"Drew Winston","value":54},{"label":"Tim McKinney","value":10},{"label":"Mitch  Fluker","value":55},{"label":"Jimsie Simmons","value":91},{"label":"Salvador Rivera","value":133},{"label":"Araic Anderson","value":124},{"label":"Francisco Estrada","value":62},{"label":"Ian Chacon","value":105},{"label":"Maria Ortega","value":130},{"label":"Ken Jurasz","value":21},{"label":"Taylor Lang","value":71},{"label":"Alyssa  Stramaglia","value":117},{"label":"Michala Belter","value":134},{"label":"Hailey Jurasz","value":118},{"label":"Ashley  Mendelson","value":119},{"label":"Jason Guevarra","value":76},{"label":"Sarah Guevarra","value":77},{"label":"Anthony Beacham","value":123},{"label":"Guy Lum","value":61},{"label":"Isabelle Adduci","value":127},{"label":"Norman Kwong","value":128}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

