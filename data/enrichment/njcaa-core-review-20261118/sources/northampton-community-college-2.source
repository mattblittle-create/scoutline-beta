                                                                        href: url, 
                                                                        'aria-label': ($parents[1].items[0].separator === 0 ? '' : $parents[1].items[0].title + ' ') + $parent.title + ' ' + title, 
                                                                        'aria-hidden': !url ? 'true' : 'false', 
                                                                        tabindex: $parents[2].isItemOpen() ? 0 : -1
                                                                    },
                                                                    event: {
