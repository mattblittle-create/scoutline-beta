</div></script><script type='text/html' id='template-navigation'><!-- ko if: name() === 'main-nav' -->
	<div class="main-nav" data-bind="css: {'mobile' : xlargeDown}">
		<!-- ko switch -->
			<!-- ko case: xlargeUp -->				
				<div class="main-navigation">
					<a class="logo" href="/index.aspx"></a>
					<ul class="main-navigation-level-1" data-bind="foreach: data">
						    <li data-bind="css: class_name" class="main-navigation-level-1-item">
