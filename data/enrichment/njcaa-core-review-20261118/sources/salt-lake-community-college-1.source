<script type="text/javascript">
    if (typeof airgap !== 'undefined') {
        window.airgap.ready((airgap) => {
            airgap.addEventListener('consent-change', ({ detail: { consent, oldConsent } }) => {
                if (
                    oldConsent.purposes['Functional'] == false &&
                    consent.purposes['Functional'] == true
                ) {
                    airgap.setConsent(window.airgapScriptLoadEvent, {
                        Functional: false,
                    });
                }
            });
        }); 
    }

    document.addEventListener("DOMContentLoaded", function () {
        if ('airgap' in window && 'transcend' in window) {
            const cpraButton = document.getElementById('cpra_button');
            cpraButton.onclick = (e) => {
                e.preventDefault();
                transcend.showConsentManager({ viewState: 'AcceptAllRejectAllToggle' });
            };

            window.airgap.ready(async (airgap) => {
                //await airgap.sync();
                let userConsent = airgap.getConsent();
                console.info('airgap --> userConsent', userConsent);                
            });
        }
    });
</script>

                    </div>
                </div>
            </footer>
			 
             <section id="stickybar">
                 <div class="row">
                     <div class="scoreboard">
                        <header>Bruins Scoreboard</header>
                        <div id="scoreboard"></div>
                    </div>
                 </div>
             </section>
        
<script type="text/javascript">window.accessibility_focus_outline_style = 'solid'; window.accessibility_focus_outline_color = '#00FFFF'; window.accessibility_focus_outline_width = '5px'; window.accessibility_light_mode = 'true'.toLowerCase();</script></form>
        <script>
            require(["knockout", "jquery",, "jquery-ui", "config", "binding-handlers", "slick", "headroom", "jquery-headroom"], function (ko, $) { 
                $('#navigation').headroom('destroy').removeData('headroom').headroom({ offset: 30});
                $.getScript("https://s3.amazonaws.com/assets.sidearmsports.com/common/js/jquery.scoreboard.js").done(function(){
                   $("#scoreboard").scoreboard({
                        "width":620, // container width
                        "height":25, // container height
                        "btns": "https://s3.amazonaws.com/assets.sidearmsports.com/common/images/scoreboard_buttons_black", // button set, optional defaults to white
                        "bx": 27, // button left offset
                        "by": 7, // button top offset
                        "tx": 90, // ticker left offset
                        "ty": 0, // ticker top offset
                        "th": 23, // ticker height
                        "tw": 570 // ticker width
                   });
               });
                $(window).scroll(function(){
                    if($(window).scrollTop()>150){
                        $("#stickybar").clearQueue().animate({bottom:"0"}, 300)
                    }
                    if($(window).scrollTop()<150){
                        $("#stickybar").clearQueue().animate({bottom:"-100%"}, 300)
                    }
                });
            });
            require(['jquery'], function() {
                $(function(){
                    $('#header').on("keypress", '#search .search-input input[type="text"]', function(e) {
                        if (e.keyCode == 13) {
                            e.preventDefault();
                            window.location='/searchresults.aspx?cx=016306950182310286156%3a2cpyn1swnvw&q=' + $("#search .search-input input[type='text']").val()+  '&sa=Search&cof=FORID%3A11#1141';   
                            return false;
                        }
                    }); 

                    $('#header').on("click", "#search .search-button input[type='submit']", function(e){
                        e.preventDefault();
                        window.location='/searchresults.aspx?cx=016306950182310286156%3a2cpyn1swnvw&q=' + $("#search .search-input input[type='text']").val()+  '&sa=Search&cof=FORID%3A11#1141';   
                            return false;
                    });

                    $('#header').on("click", "#search-btn >i", function(){
                        $(this).parent().toggleClass("active")
                    });
                });
            });
