			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Gary  Veron","value":178},{"label":"Ron Loghry","value":174},{"label":"Lisa  Peshell","value":4},{"label":"Paula Nielson-Williams","value":131},{"label":"Spencer Porter","value":171},{"label":"Averi Stover","value":177},{"label":"Lindsey Lunt","value":188},{"label":"Adrianna Fowler","value":189},{"label":"David Nelson","value":16},{"label":"Glen Spencer","value":114},{"label":"Cole Gambill","value":159},{"label":"Chris Shelton","value":158},{"label":"Dusty  Nielsen","value":176},{"label":"Dave Rice","value":160},{"label":"Parker Van Dyke","value":194},{"label":"Dave  Hammer","value":169},{"label":"Jimmy Henry-Dempster","value":199},{"label":"Kenzie Newton","value":190},{"label":"Tanesha  Daniels","value":191},{"label":"Megan Vera","value":192},{"label":"Abby  Butler","value":200},{"label":"Christien  Crynes","value":201},{"label":"Griffin  Humphreys","value":182},{"label":"Cody  Jones","value":184},{"label":"Courtney Frerichs","value":187},{"label":"Mark Davis","value":81},{"label":"Trentin Atkin","value":142},{"label":"Conner Mitchell","value":185},{"label":"Amy Lepeilbet","value":133},{"label":"Marli Berg","value":140},{"label":"Makaylie Moore","value":141},{"label":"Kaytlin Bradley","value":193},{"label":"Tara Rodrick","value":61},{"label":"Megan Reed","value":99},{"label":"Shelby Shurtliff","value":183},{"label":"Ben Farrar","value":172},{"label":"Lauren  Spendlove","value":173},{"label":"Mariah Lopez","value":195},{"label":"Ken  Brooke","value":196},{"label":"Kaysen Korth","value":197},{"label":"Miranda Mansfield","value":198},{"label":"Corinne Cleverly","value":204},{"label":"Shay Goulding Meurer","value":119},{"label":"Chris Tellesbo","value":127},{"label":"Kim Hawkey","value":186},{"label":"Shay Goulding Meurer","value":119},{"label":"David Read","value":117},{"label":"Jeff Sosa","value":148}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

            </main>
            
            

