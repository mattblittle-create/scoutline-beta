							                            <!-- ko if: schedule_roster_news_links -->
							                                <!-- ko foreach: schedule_roster_news_links -->
							                                    <a class="main-navigation-schedule-roster-news" data-bind="text: title, attr: { href: url }, css: class_name"></a>
							                                <!-- /ko -->
							                            <!-- /ko -->
							                            <!-- ko if: social_media_links -->
							                                <!-- ko foreach: social_media_links -->
							                                    <a class="main-navigation-social" data-bind="text: title, attr: { href: url }, css: class_name"></a>
							                                <!-- /ko -->
							                            <!-- /ko -->
							                        <!-- /ko -->
							                    </li>
							                    <!-- ko if: ($index() === ($parent.items.length - 1) && $parentContext.$index() === 1) -->
			                                        <!-- ko if: $parents[1].ad -->
			                                            <div class="navigation-ad" style="margin: 20px 0 0 0;" data-bind="css: $parents[1].ad.css_class">
			                                                <a data-bind="attr: { href: $parents[1].ad.link }">
			                                                    <picture data-bind="html5Picture:$parents[1].ad.picture"></picture>
			                                                </a>
			                                            </div>
			                                        <!-- /ko -->
			                                    <!-- /ko -->
							                </ul>
							                <!-- /ko -->
							                <div class="dropdown-ad">
							                	<ads-component params="{ name: 'cs-sportnav-eb52c1' }"></ads-component>
							                </div>
						                </div>
						            </div>
						        <!-- /ko -->

						        <!-- ko if: url != "" -->
						            <a data-bind="html: title, attr: { href: url }"></a>
						        <!-- /ko -->
						    </li>
					</ul>
				</div>
			<!-- /ko -->
			
			<!-- ko case: $else -->
				<div class="mobile_menu">
					<a href="/index.aspx"><img src="/images/mobile_logo.png"></a>
				    <i class="icon-menu" data-bind="click: openMenu"></i>
				    <div class="off-canvas-menu" data-bind="css: { 'open': isMenuOpen }">
				        <div class="close-menu">
				            <i class="icon-cancel" data-bind="click: closeMenu"></i>
				        </div>
				    
				        <ul class="level-1 small" data-bind="foreach: data">
				            <!-- ko if: id != '9' -->
				            <li data-bind="css: class_name">
				                <!-- ko if: url === "" -->
				                    <a class="parent" data-bind="css: { 'open': isItemOpen }, html: title, click: toggleMenuItem"></a>
				                    
				                    <ul class="level-2" data-bind="css: { 'open': isItemOpen }, foreach: items">
				                        <!-- ko ifnot: separator -->
				                            <li>
				                                <a data-bind="html: title, attr: { href: url }"></a>
				                            </li>
				                        <!-- /ko -->
				                        <!-- ko if: separator -->
				                            <li class="separator">
				                                <a data-bind="html: title"></a>
				                            </li>
				                        <!-- /ko -->
				                    </ul>
				                <!-- /ko -->
				                <!-- ko if: url != "" -->
				                    <a data-bind="html: title, attr: { href: url }"></a>
				                <!-- /ko -->
				            </li>
				            <!-- /ko -->
				        </ul>
				    </div>
				</div>
			<!-- /ko -->
		<!-- /ko -->		
	</div>
<!-- /ko -->

<!-- ko if: name() === 'sports-nav' -->
<!-- ko switch -->
    <!-- ko case: xlargeUp -->
	<section class="sport-nav">
		<div class="row">
			<ul class="level-1 large" data-bind="foreach: data">
				<!-- ko if: items != null && items.length > 0 -->
					<li class="dropdown" data-bind="css: class_name">
						<div>
						<!-- ko if: url === "" -->
							<a data-bind="html: title"></a>
						<!-- /ko -->
