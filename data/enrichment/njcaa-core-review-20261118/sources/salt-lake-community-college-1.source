	            <!-- /ko -->

    		    <!-- ko case: $else -->
					<a data-bind="text: sport.abbreviation, attr: { href: '/index.aspx?path=' + sport.shortname }"></a>
	            <!-- /ko -->
	        <!-- /ko -->
		</div>
		<ul class="flex flex-justify-between">
        	<i data-bind="click: toggleMenu, css: { 'icon-menu': !isMenuOpen(),  'icon-cancel': isMenuOpen }"></i>
		</ul>

        <div class="dropdown-menu">
            <ul class="level-1" data-bind="foreach: data">
                <!-- ko if: items != null && items.length > 0 -->
                <li class="" data-bind="css: { 'mobile-navigation-parent': items.length > 0, 'mobile-navigation-item-open': isItemOpen }">
                    <a class="flex flex-justify-between" data-bind="text: title, click: toggleMenuItem">
                    </a>
                    <ul class="level-2" data-bind="foreach: items, visible: isItemOpen">
                        <li>
                            <a data-bind="attr: { href: url }, text: title, clickBubble: false"></a>
                        </li>
                    </ul>
                </li>
                <!-- /ko -->
                <!-- ko if: items === null || items.length === 0 -->
                    <li data-bind="css: class_name">
