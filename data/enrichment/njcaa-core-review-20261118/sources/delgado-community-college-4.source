            <!-- ko switch -->
            <!-- ko case: mediumUp -->
            <a class="c-navigation__sport-link c-navigation__url"
                data-bind="text: sport.title, attr: { href: data()[0].url != '#' ? data()[0].url : '/index.aspx?path=' + sport.shortname }"></a>
            <!-- /ko -->
            <!-- ko case: $else -->
            <a class="c-navigation__sport-link c-navigation__url"
                data-bind="text: sport.abbreviation, attr: { href: data()[0].url != '#' ? data()[0].url : '/index.aspx?path=' + sport.shortname }"></a>
            <!-- /ko -->
            <!-- /ko -->
        </li>

