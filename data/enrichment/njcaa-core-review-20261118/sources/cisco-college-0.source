        <script>
            $(function() {
                var paused = 0;

                $('#component-headlines-52-toggle-slider').click(function() {
                    var state = (paused) ? 'slickPlay' : 'slickPause';
                    paused = (paused) ? 0 : 1;
                    $("#component-headlines-52 .slick-slider").slick(state);
                    $(this).find('.fa').toggleClass('fa-play fa-pause');
                });
            })
        </script>
        </div>
        <script>
        $(function() {
            $('#component-headlines-52 .slick-slider').slick({
                "centerMode"    : false,
                "arrows"        : true,
                "dots"          : false,
                "autoplay"      : true,
                "autoplaySpeed" : 8000,
                "slidesToShow"  : 1,
                "slidesToScroll": 1,
                "infinite"      : false,
                "pauseOnHover"  : true,
                "pauseOnFocus"  : true,
                "prevArrow"     : "#component-headlines-52-controls .prev",
                "nextArrow"     : "#component-headlines-52-controls .next",
                "responsive"    : [{
                    "breakpoint": 1199,
                    "settings": {
                        "slidesToShow":  1 ,
                        "slidesToScroll":  1                     }}, {
                    "breakpoint": 991,
                    "settings": {
                        "slidesToShow":  1 ,
                        "slidesToScroll":  1                     }}, {
                    "breakpoint": 767,
                    "settings": {
                        "centerMode"  : false,
                        "infinite"    : false,
                        "slidesToShow":  1 ,
                        "slidesToScroll":  1                     }}, {
                    "breakpoint": 575,
                    "settings": {
                        "centerMode"  : false,
                        "infinite"    : false,
                        "slidesToShow":  1 ,
                        "slidesToScroll":  1                     }}
                ]

            });
        });
    </script>
        <script>
        $(function() {
            var slickSelector = $('#component-headlines-52 .slick-slider');
            var navSelector = $('#component-headlines-52 .slick-nav-item');
            var activeClass = "slick-active";
            
            if (slickSelector.length && navSelector.length && slickSelector.hasClass('slick-initialized')) {
                var slickInstance = slickSelector.slick('getSlick');
                
                navSelector.on('click', function(e) {
                    var clickedIndex = $(this).index();
                    if (slickInstance && slickInstance.currentSlide != clickedIndex) {
                        slickSelector.slick('slickGoTo', clickedIndex);
                        navSelector.removeClass(activeClass).eq(clickedIndex).addClass(activeClass);
                    }
                });
                
                slickSelector.on('afterChange', function(e, slick) {
                    navSelector.removeClass(activeClass).eq(slick.currentSlide).addClass(activeClass);
                })
            }
        })
    </script>

