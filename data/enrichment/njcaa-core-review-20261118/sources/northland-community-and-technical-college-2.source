    SNIPPET: WE ARE GO SOCIAL MEDIA FEED
---------------------------------------------- */
.s-contentstream__header-text {
    font-size: 4rem!important;}





.section-social-header__text { 
font-family: 'Saira', sans-serif!important;
/*font-size: 72px!important;*/
font-weight: 700!important;
font-style: italic;
letter-spacing: -1px;}

.section-social .section-social-header__links a {
font-family: 'Saira', sans-serif!important;
	color: white;
	background-color: #FF0000;
	font-size: 14px;
	transition: 0.3s;
	border-radius: 6px;}
.section-social .section-social-header__links a:hover {
	background-color: white;
	color: #FF0000;}

.section-social .twitter-list .twitter-list__actions a:hover {
	color: #FF0000;}

.section-social .slick-prev:hover:after,
.section-social .slick-next:hover:after {
	color: #FF0000;
	transition: 0.3s;}




/* ----------------------------------------------
    SNIPPET: PLAYER OF THE WEEK
---------------------------------------------- */
.section-aotw {
font-family: 'Saira', sans-serif !important;
}
.section-aotw .aotw-list .aotw-list__details {
  color: #01203f;
  text-transform: uppercase;
  font-family: 'Saira', sans-serif !important;
  font-size: 18px;
}
.section-aotw .aotw-list .aotw-list__firstname {
	margin: 4px 0 0;
font-family: 'Saira', sans-serif !important;
	font-size: 20px;
	font-weight: 500;
	font-style: italic;
	line-height:9px;}
.section-aotw .aotw-list .aotw-list__lastname {
	margin: 0;
font-family: 'Saira', sans-serif !important;
	font-size: 35px;
	font-weight: 700;
	color: #FF0000 !important;
	font-style: italic;
	letter-spacing: -1px;}
.section-aotw .aotw-list .aotw-list__sport {
	margin: 0;
	font-size: 15px;
	color: #000a28;
	font-weight: 300;
	letter-spacing: 1px;}

.section-aotw .aotw-list-mobile .slick-prev:hover,
.section-aotw .aotw-list-mobile .slick-next:hover {
