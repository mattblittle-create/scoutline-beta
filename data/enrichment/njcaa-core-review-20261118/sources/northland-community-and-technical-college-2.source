/* ----------------------------------------------
    STORIES: 
---------------------------------------------- */

.sidearm-story-template-header h1 {
	font-family: 'Saira', sans-serif!important;
	padding: 0px 0px 0px;
font-size: 65px;	
font-weight: 700;}
.sidearm-story-template-header h2 {
	/* font-family: 'Saira', sans-serif!important; */
font-family: 'Montserrat', sans-serif !important;
	padding: 15px 0px 0px;
	font-size: 25px;/* 30px */
	font-weight: normal;}
.sidearm-story-template-header p {
	padding: 0px 0px 0px;
	font-size: 12px!important;
	font-weight: normal;}
.sidearm-story-template-header p a {
	font-weight: bold;}

.sidearm-story-template-text,
.sidearm-story-template-text,
.sidearm-common-bio-full {
font-family: 'Saira', sans-serif;
font-size: 18px;
line-height: calc(1.0em + 0.5vw);}

.sidearm-story-template-text a,
.sidearm-common-bio-full a {
	font-weight: bold;}


blockquote {
margin: 4em 3em;}

.quotation{
  font-size: 36px;
  //margin: 0 auto;
  quotes: "\201C""\201D""\2018""\2019";
  padding: 0px 20px;
  line-height: 1.4;}

.quotation:before {
  content: open-quote;
  display: inline;
  height: 0;
  line-height: 0;
  left: -10px;
  position: relative;
  top: 30px;
  color: #ccc;
  font-size: 3em;
}
.quotation::after {
  content: close-quote;
  display: inline;
  height: 0;
  line-height: 0;
  left: 10px;
  position: relative;
  top: 35px;
  color: #ccc;
  font-size: 3em;
}
.byline{
  margin:0;
padding-left: 20px;
  text-align: left;
  font-size: 1.0em;
  font-style: italic;
}




/* ----------------------------------------------
    STORIES: Sport Files??
---------------------------------------------- */

.article-content { min-height: 450px!important;font-family: 'Saira', sans-serif;}
.article-share-links {display: none !important;}


.article-content a,
.sidearm-story-template-content a { color: #009cde!important;font-weight: bold;}
.article-content a:hover,
.sidearm-story-template-content a:hover { color: #FF0000!important;}


.sidearm-story-custom-share-links a { color: #FFFFFF!important;}
.sidearm-story-custom-share-links a:hover { color: #000000!important;}

.sidearm-story-custom-share-pinterest { display:none!important;}



.print-friendly-story-button {display: none;}

.sidearm-story-template-gen-1 .sidearm-story-template-related-section .sidearm-story-template-related-section-header:before,
.sidearm-story-template-gen-2 .sidearm-story-template-related-section .sidearm-story-template-related-section-header:before,
.sidearm-story-template-gen-3 .sidearm-story-template-related-section .sidearm-story-template-related-section-header:before {
  background-color: #FF0000;
}




.boiler {margin: 25px 0px 0px;}
.boiler p {
	padding: 15px 0px;
font-family: 'Montserrat', sans-serif !important;	
font-size: 12px;
	line-height: 20px;
	font-weight: 300;
	color: #333333;}


/* =================================================
   STORIES
================================================= */

.section-topstories .topstories-list .topstories-list__headline > a:hover {
  color: #FF0000;
}
.section-topstories .topstories-list ul.slick-dots li.slick-active button,
.section-topstories .topstories-list ul.slick-dots li button:hover {
  background-color: #FF0000;
  border-color: #FF0000;
  transition: 0.3s;
}








/* =================================================
   
ROSTERS

================================================= */

/* ----------------------------------------------
    ROSTER: TEAM ROSTER PAGE
---------------------------------------------- */

.sidearm-roster-player-container		{font-family: 'Saira', sans-serif;}
.sidearm-roster-coaches,
.sidearm-roster-coach-details		{font-family: 'Saira', sans-serif;}
.sidearm-roster-default-template .sidearm-roster-coach-name p { color: #01203f;}
.sidearm-roster-default-template .sidearm-roster-coach-link a {color: #01203f; font-weight 700!important;}


.sidearm-roster-player-name a 		{color:#01203f!important;}
.sidearm-roster-player-name a:hover 	{color:#FF0000!important;}
.sidearm-roster-default-template .sidearm-roster-player-name .sidearm-roster-player-jersey span {background-color: #01203f;}

.sidearm-roster-default-template .sidearm-roster-player-toggle:before {
  border-bottom: 2rem solid #FF0000;}
.sidearm-roster-default-template .sidearm-roster-player.show-extra .sidearm-roster-player-toggle:before {border-bottom-color: #cccccc;}
.sidearm-roster-default-template .sidearm-roster-player-extra-heading {
font-family: 'Saira', sans-serif;
background-color: #FF0000;
  color: white;
  padding: 5px 10px;}
.sidearm-roster-default-template .sidearm-roster-player-bio .sidearm-roster-player-bio a {color: #01203f!important; font-weight bold!important;}
.sidearm-roster-default-template .sidearm-roster-player-bio .sidearm-roster-coach-bio a {color: #01203f!important; font-weight bold!important;}


.sidearm-list-card-item		{font-family: 'Saira', sans-serif;}
.sidearm-roster-default-template .sidearm-roster-player-name .sidearm-roster-player-jersey span {background-color: #0C2340;color: #FFFFFF;}
.sidearm-roster-card-template-1 .sidearm-roster-player-jersey {background-color: #FF0000;}


.sidearm-roster-default-template .sidearm-roster-player-name p a {
  color: #01203f!important;
}
.sidearm-roster-default-template .sidearm-roster-player-name p a:hover,
.sidearm-roster-default-template .sidearm-roster-player-name p a:active {
  color: #FF0000!important;
}






/* ----------------------------------------------
    ROSTER: PLAYER PROFILES
---------------------------------------------- */
.sidearm-roster-player-view .sidearm-roster-player-header-plain .sidearm-roster-player-heading {background-color: #01203f!important;}
.sidearm-roster-player-view .sidearm-roster-player-heading {background-color: rgba(255, 0, 0, 0.75);}
.sidearm-roster-player-view .sidearm-roster-player-heading .sidearm-roster-player-jersey-number {
  background-color: #FF0000;
  color: white;
}


.sidearm-roster-card-template-1 .sidearm-roster-player-name-container:after {
  background-color: #FF0000;
}



.sidearm-roster-default-template .sidearm-roster-player-name .sidearm-roster-player-jersey span.sidearm-roster-player-captain {
  background-color: #FF0000;/* B09043 C99700 */
  color: white;}
.sidearm-roster-card-template-1 .sidearm-roster-player-captain {
color: #FF0000;/* C99700*/
font-size: 1.25em;}




.sidearm-common-bio .sidearm-common-bio-heading {
  background-color:#01203f!important;
  color: white;}

.sidearm-roster-player-view .sidearm-roster-player-fields {
font-family: 'Saira', sans-serif!important;
}






.sidearm-roster-player-view .sidearm-responsive-tabs > ul {
font-family: 'Saira', sans-serif;  
 margin: 0;
  padding: 0 16px;
  list-style: none;
border-bottom: 4px solid #01203f; /* FF0000*/
  background-color: #f2f2f2;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li {
  display: inline-block;
  padding: 8px 16px;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li > a {
  text-decoration: none;
  color: #01203f;
  font-weight: bold;
  text-transform: uppercase;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li > a:focus {
  outline: none;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li.ui-tabs-active {
  background-color: #01203f;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li.ui-tabs-active > a {
  color: white;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li:active {
  background-color: #01203f;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > ul > li:active > a {
  color: white;
}
.sidearm-roster-player-view .sidearm-responsive-tabs > section {
  padding: 16px 0;
}








.sidearm-roster-default-template .sidearm-roster-player-bio a,
.sidearm-roster-default-template .sidearm-roster-coach-link a {
font-weight:bold;
color: #000a1c;
}
.sidearm-roster-default-template .sidearm-roster-player-bio a:before {
font-family: sidearm_font;
}
.sidearm-roster-default-template .sidearm-roster-player-bio a:active,
.sidearm-roster-default-template .sidearm-roster-player-bio a:hover,
.sidearm-roster-default-template .sidearm-roster-coach-link a:active,
.sidearm-roster-default-template .sidearm-roster-coach-link a:hover {
  text-decoration: none;
color: #FF0000;
}




.sidearm-common-bio-full a { font-weight:bold; color: #000a1c;}


.sidearm-roster-player-template-default.sidearm-roster-player-view .sidearm-roster-player-header-action .sidearm-roster-player-header-action-photos-credit {display:none;}


