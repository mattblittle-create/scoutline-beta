.sidearm-schedule-record 				{font-family: 'Saira', sans-serif;}
.sidearm-schedule-game-row 				{ min-height: 150px!important;}
.sidearm-schedule-game-home 			{font-family: 'Saira', sans-serif; background-color:#FF0000!important}
