.sidearm-calendar .sidearm-calendar-schedule-day h4 {
	background-color: #FF0000;
	padding: 8px;}
.sidearm-calendar .sidearm-calendar-schedule-event-opponent-details .sidearm-calendar-schedule-event-opponent-home {
	background-color: #FF0000;
	color: white;}
.sidearm-calendar .sidearm-calendar-schedule-event-opponent-details .sidearm-calendar-schedule-event-opponent-away {
	background-color: #cccccc;
	color: white;}
.sidearm-calendar .sidearm-calendar-schedule-event-opponent-details .sidearm-calendar-schedule-event-opponent-title {
	font-size: 1.5em;
	line-height: 1.1;
	text-transform: uppercase;
	font-weight: bold;}


.sidearm-calendar .sidearm-calendar-chooser-date-selected {
  background-color: #FF0000;}

.sidearm-calendar .sidearm-calendar-schedule-day h4 {
  background-color: #FF0000;}

.sidearm-calendar .sidearm-calendar-schedule-event-opponent-details .sidearm-calendar-schedule-event-opponent-home {
  background-color: #FF0000;}

.sidearm-calendar .sidearm-calendar-table thead {
  background-color: #FF0000;}
.sidearm-calendar .sidearm-calendar-table-cell-event.sidearm-calendar-table-cell-event-home {
  border-left: 4px solid #FF0000;}

.sidearm-calendar .sidearm-calendar-table-cell-toggle-button:active {
  background-color: #FF0000;}

.sidearm-calendar .sidearm-calendar-table-cell-toggle-button:before {
    background-color: #FF0000;}



