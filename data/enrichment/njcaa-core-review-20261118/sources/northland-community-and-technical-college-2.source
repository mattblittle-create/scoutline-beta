.sidearm-schedule-game-opponent-date 	{font-family: 'Saira', sans-serif; font-style: italic; color:#000000!important}
.sidearm-schedule-game-opponent-name 	{font-family: 'Saira', sans-serif; color:#000000!important}
.sidearm-schedule-game-opponent-name a 	{font-family: 'Saira', sans-serif; color:#000000!important}
.sidearm-schedule-game-location 		{font-family: 'Saira', sans-serif; color:#000000!important}
.sidearm-schedule-game-result 			{font-family: 'Saira', sans-serif; font-style: normal!important; color:#000000!important}
.sidearm-schedule-tournament p 			{font-family: 'Saira', sans-serif;font-size: 22px!important;line-height: 32px!important;}

.sidearm-schedule-game-links li {padding: 10px 0;}

.sidearm-schedule-game-links-audio,
.sidearm-schedule-game-links-tickets,
.sidearm-schedule-game-links-gamefile,
.sidearm-schedule-game-links-gamefiles,
