text-transform: none;  
text-decoration: none;
  color: #0344DC;}


.sidearm-schedule .sidearm-schedule-game .sidearm-schedule-game-links a:hover,
.sidearm-schedule .sidearm-schedule-game .sidearm-schedule-game-links a:active {
