}




/* ----------------------------------------------
    SNIPPET: TEAM HOME SCHEDULE
---------------------------------------------- */

.section-events .game-list .game-list__media a,
.section-results .game-list .game-list__media a {
  text-decoration: none;
  color: #FF0000;
  transition: 0.3s;
}


.section-events .game-filter select,
.section-results .game-filter select {
  border-radius: 6px;
  background: #FF0000 url('/images/sport_filter_bg.png') no-repeat center right; /* b50e1a */
  color: white;
  text-transform: capitalize;
font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 13px;
  max-width: 180px;
}



.section-events-ads .tabs > ul li {
  margin-right: 48px;
  text-transform: uppercase;
 font-family: 'Saira', sans-serif;
	font-weight: 700;
  font-size: 28px;/* 28px */
  line-height: 1;
  height: 34px;
}
.section-events-ads .tabs > ul li a {
  display: block;
  text-decoration: none;
  color: #BABAC4;
  transition: 0.3s;
}
.section-events-ads .tabs > ul li.ui-tabs-active a,
.section-events-ads .tabs > ul li a:hover {
  color: #01203f; /* 000a28 */
  transition: 0.3s;
}



.section-events .game-list .game-list__item,
.section-results .game-list .game-list__item {
  color: #01203f;
 font-family: 'Saira', sans-serif;
}


.section-events .game-list .game-list__sport,
.section-results .game-list .game-list__sport {
  font-size: 12px;
  font-weight: 500;
font-style: italic;
}

.section-events .game-list .game-list__sport-opponent,
.section-results .game-list .game-list__sport-opponent {
  font-weight: 500;
}
.section-events .game-list .game-list__location,
.section-results .game-list .game-list__location {
  font-size: 13px;
}


.section-events .game-list__comp-link,
.section-results .game-list__comp-link {
  background-color: white;
  color: #01203f;
 font-family: 'Saira', sans-serif;
  font-weight: 700;
  font-size: 15px;
  transition: 0.3s;
}
.section-events .game-list__comp-link:nth-last-child(2),
.section-results .game-list__comp-link:nth-last-child(2) {
  border-right: 1px solid #e1e1e1;
}
.section-events .game-list__comp-link:hover,
.section-results .game-list__comp-link:hover {
  background-color: #FF0000; /* 0C2340 */
  color: white;
}


.ps-container > .ps-scrollbar-x-rail > .ps-scrollbar-x {
	background-color: #FF0000;}
.ps-container > .ps-scrollbar-y-rail > .ps-scrollbar-y {
	border-radius: 6px;
	background-color: #FF0000;}












