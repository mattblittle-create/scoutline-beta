@import url("https://fonts.googleapis.com/css?family=Saira:400,500,700");

@font-face {
    font-family: 'GintoNordBold';
    src: url('http://www.northlandcollege.edu/_fonts/ginto-nord/ginto-nord-bold.eot');
    src: url('http://www.northlandcollege.edu/_fonts/ginto-nord/ginto-nord-bold.eot?#iefix') format('embedded-opentype'),
        url('http://www.northlandcollege.edu/_fonts/ginto-nord/ginto-nord-bold.woff2') format('woff2'),
        url('http://www.northlandcollege.edu/_fonts/ginto-nord/http://www.northlandcollege.edu/_fonts/ginto-nord/ginto-nord-bold.woff') format('woff'),
        url('http://www.northlandcollege.edu/_fonts/ginto-nord/ginto-nord-bold.ttf') format('truetype'),
        url('http://www.northlandcollege.edu/_fonts/ginto-nord/ginto-nord-bold.svg#.') format('svg');
    font-weight: bold;
    font-style: normal;
}


/* ----------------------------------------------
    Brand Colors
---------------------------------------------- */
/* -- 
	Space Blue: #01203F
	Horizon Red: #FF0000
	Flight Blue: #0344DC
	Shuttle White: #FFFFFF
	Frontier Silver: #BABAC4
	International Orange: #FF4F00
--  */


.sidearm-calendar-subscribe,
.sidearm-calendar-subscribe__toggle {background-color:#FF0000;}
.sidearm-calendar-subscribe__toggle:hover {background-color:#BABAC4;}

.sidearm-story-template-image-credit {display:none !important;}



/* ----------------------------------------------
   TYPOGRAPY : STANDARD
---------------------------------------------- */

body {font-family: 'Saira', sans-serif;}

h1{ font-family: 'Saira', sans-serif!important;}
h2,
h2.page-title,
.sidearm-opponent-history__table h2.sidearm-opponent-history__table-title {
	margin: 0;
	width: 100%;
	padding: 0px 0px 25px ;
	font-family: 'Saira', sans-serif!important;
	font-size: 40px;/* 50px */
	font-weight: 700;
	color: #000000;
	z-index: 2;
	letter-spacing: -1px;}
h3 {
	margin: 0;
	width: 100%;
	padding:25px 0px 5px ;
	font-size: 28px;
	font-weight: 700;
	z-index: 2;
	letter-spacing: -1px;}

.noprint a {font-weight: bold; }
.noprint a:hover {color: #FF0000;}

.article-wrapper .article-image.no-img .article-headline {
	position: static;
	color: #000a28;
	padding: 24px 48px;
	font-family: 'Saira', sans-serif!important;
	text-shadow: none;
	border: 1px solid #ebebeb;
	border-bottom: none;}
.article-wrapper .article-headline {
	padding: 0 80px;
	font-family: 'Saira', sans-serif!important;
	font-size: 40px;
	font-weight: 700;
	letter-spacing: -1px;}




/* =================================================
   
TABLES

================================================= */


/* ----------------------------------------------
    TABLES : STANDARD
---------------------------------------------- */

thead tr.red th { background-color: #FF0000; color: #FFFFFF!important}
.oddrow td { background-color: #FFFFFF;}
.evenrow td { background-color: #F2F2F2;}
td.bold { font-weight: bold!important;}

.sidearm-table thead.sidearm-primary th {
	background-color: #FF0000;
}
.sidearm-table[sortable-table] thead th[scope=colgroup],
.sidearm-table.sortable-table thead th[scope=colgroup] {
	background-color: #FF0000;
}
.sidearm-table[class*="collapse"].accordion tbody tr th:not([scope=colgroup]):after,
.sidearm-table[class*="collapse"].accordion tfoot tr th:not([scope=colgroup]):after {
	border-left: 0.3333em solid #FF0000;
}
.sidearm-table[class*="collapse"].accordion tbody tr.expanded,
.sidearm-table[class*="collapse"].accordion tfoot tr.expanded {
	background-color: #FF0000;
}
.sidearm-pager > span {
	background-color: #FF0000;
}
.sidearm-ad-blocker-message button {
	background-color: #FF0000;
}

.sidearm-table.collapse-on-medium th,
.sidearm-table.collapse-on-medium td {
	height: 30px;
	line-height: 30px;}

.sidearm-table th,
.sidearm-table td {
	font-size: 1.1em;}

.sidearm-table thead th {
	font-style: normal;
}
.sidearm-table tbody tr th[scope=colgroup] {
	font-style: normal;
}
.sidearm-table th a {
	color: #000a28 !important;
	font-weight:400;
}
.sidearm-table th a:hover {
	color: #FF0000!important;
}
.sidearm-pager > *:not([disabled]):not(span):hover {
	background-color: #FFFFFF;
}


/* ----------------------------------------------
    TABLES : OPPONENT HISTORY
---------------------------------------------- */




/* =================================================
   
MASTER HEADERS

================================================= */

/* ----------------------------------------------
    MASTER HD: MAIN HEADER
---------------------------------------------- */

.main-header {
	/*-webkitbox-shadow: 0 5px 3px rgba(0, 0, 0, 0.2);
	-moz-box-shadow: 0 5px 3px rgba(0, 0, 0, 0.2);
	box-shadow: 0 5px 3px rgba(0, 0, 0, 0.2);*/
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	z-index: 400;	}


.main-navigation {
	font-family: 'Saira', sans-serif;	
	background-color: #FFFFFF;
	position: relative;
	z-index: 400;
	box-shadow: none!important;
	border-top: 3px solid #e1e1e1!important;}
.main-navigation .main-nav-desktop .level-1 > li {
	border-right: 0px solid #e1e1e1;
	height: 100px;
	line-height: 100px;
	font-family: 'Saira', sans-serif;
	color: #01203F;
	text-transform: uppercase;
	font-size: 19px;
	font-weight: 700;}
.main-navigation .main-nav-desktop .level-1 > li:first-child { 
	border-left: 0px solid #e1e1e1!important;}
.main-navigation .main-nav-desktop .level-1 > li.spacer + li {
	border-left: 0px solid #e1e1e1!important;}
.main-navigation .main-nav-desktop .level-1 > li > a {
	letter-spacing: -1px;
	color: #01203F;
	display: block;
	text-decoration: none;
	padding: 0 10px;}
.main-navigation .main-nav-desktop .level-1 > li:hover > a {
	color: #FFFFFF;
	background-color: #FF0000;
	text-decoration: none;
	transition: 0.3s;}


.main-navigation .main-nav-desktop .level-1 > li:hover .level-2 {
	left: 0;
	opacity: 1;
	-moz-transition: opacity 0.25s ease-in-out;
	-webkit-transition: opacity 0.25s ease-in-out;
	transition: opacity 0.3s ease-in-out;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) {
	display: flex;
	display: -webkit-flex;
	padding-right: 12px;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a {
	font-weight: 300;
	font-size: 12px;
	padding: 0 0 0 12px;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a:first-child {
	margin-right: auto;
	font-weight: 700;
	font-size: 14px;}



.main-navigation .main-nav-mobile .main-nav-mobile-offcanvas .level-1 > li > a:hover,
.main-navigation .main-nav-mobile .main-nav-mobile-offcanvas .level-1 > li > a.open {
	color: #FFFFFF;
	transition: 0.3s;}
.main-navigation .main-nav-mobile .main-nav-mobile-offcanvas .level-2 ul li .separator {
	font-family: 'Saira', sans-serif; 
	color: #FF0000;}



/* ----------------------------------------------
    MASTER HD: DROP DOWN MENU
---------------------------------------------- */

.main-navigation .main-nav-desktop .level-2 {
	background-color: #0344DC; /* 0344DC 01203F */	
	border-top: 3px solid #FF0000!important;
	border-bottom: 0px solid #FF0000 !important;}

.main-navigation .main-nav-desktop .level-2:before {
	content: "";
	display: block;
	width: 100%;
	height: 6px;
	position: absolute;
	top: -6px;
	left: 0;
	box-shadow: none!important;}


.main-navigation .main-nav-desktop .level-2 li.separator {
	color: #01203F !important;
	font-size: 25px;
	padding: 15px 5px 5px;
	line-height: 1.5;
	text-transform: uppercase;
	letter-spacing: 0px;}
.main-navigation .main-nav-desktop .level-2 li.separator:hover {
	background: none;}



.main-navigation .main-nav-desktop .level-2 li {
	line-height: 38px;
	font-family: 'Saira', sans-serif!important;	
	font-size: 18px;
	font-weight: 700;
	border-bottom: 1px solid #172f52!important;}
.main-navigation .main-nav-desktop .level-2 li:hover {
	background-color: #01203F;
	transition: 0.3s;}


.main-navigation .main-nav-desktop .level-2 a {
	text-transform: none !important;
	color: #FFFFFF;
	font-family: 'Saira', sans-serif;
	font-size: 18px !important;
	font-weight: normal !important;}
.main-navigation .main-nav-desktop .level-2 a:hover {
	color: #FFFFFF; 
	text-decoration: none;}



.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a:first-child {
	margin-right: auto;
	font-weight: normal !important;
	font-size: 18px !important;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a:first-child:hover {
	color: #FFFFFF;	
	text-decoration: none !important;}


.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a {
	font-weight: normal !important;
	font-size: 15px !important;
	padding: 0 0 0 16px;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a:hover {
	color: #FF0000;
	text-decoration: underline;}



.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.main-navigation-social {
	white-space: nowrap;
	/* font-family: 'Saira', sans-serif !important;*/
	font-family: sidearm_font !important;
	overflow: hidden;
	width:30px;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.main-navigation-social:hover {
	text-decoration: none;
	color: #FF0000;}


.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.main-navigation-social:before {
	font-family: sidearm_font !important;
	margin-right: 30px;
	font-size: 18px!important;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.facebook:before {
	font-family: sidearm_font !important;	 
	content: '\e805';
	color: #FFFFFF;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.twitter:before {
	font-family: sidearm_font !important;	
	content: '\e825';
	color: #FFFFFF;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.instagram:before {
	font-family: sidearm_font !important;	
	content: '\e825';
	color: #FFFFFF;}

.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.instagram,
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.tickets {
	content: '\e825';
	color: #FFFFFF;	
	/*display: none;*/}


.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.facebook:hover:before {
	font-family: sidearm_font !important;	 
	color: #FF0000;
	text-decoration: none !important;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.twitter:hover:before {
	font-family: sidearm_font !important;	
	color: #FF0000;
	text-decoration: none !important;}
.main-navigation .main-nav-desktop .level-1 > li.nav-sports .level-2 li:not(.separator) a.instagram:hover:before {
	font-family: sidearm_font !important;	
	color: #FF0000;
	text-decoration: none !important;}





/* ----------------------------------------------
    MASTER HD: SUB TEAM NAVIGATION
---------------------------------------------- */

.sport-navigation {
	background-color: #0344DC;
	position: relative;
	z-index: 300;}
.sport-navigation .sport-nav-desktop {
	height: 65px;}



.sport-navigation .sport-nav-desktop .level-1 > li.sport-home {
	margin-top: -20px;	
	margin-left: 0;
	margin-right: auto;
	font-family: 'Saira', sans-serif!important;	
	font-size: 30px!important;
	letter-spacing: -1px;
	font-weight: 700!important;
	text-transform:uppercase!important;
	color: #FF0000;}
.sport-navigation .sport-nav-desktop .level-1 > li.sport-home > a {
	font-family: 'Saira', sans-serif!important;
	color: #fffffff !important;
	font-weight: 700!important;
	text-transform:uppercase!important;}
.sport-navigation .sport-nav-desktop .level-1 > li.sport-home > a:hover {
	color: #FF0000 !important;}




.sport-navigation .sport-nav-desktop .level-1 > li {
	height: 65px;
	position: relative;
	font-family: 'Saira', sans-serif!important;	
	color: #FFFFFF;
	text-transform:uppercase!important;
	font-size: 15px;}
.sport-navigation .sport-nav-desktop .level-1 > li > a {
	/*font-family: 'Montserrat', sans-serif!important;*/
	font-family: 'Saira', sans-serif!important;
	font-weight:bold;
	text-decoration: none;
	text-transform:uppercase!important;
	color: #FFFFFF;
	display: block;
	height: 20px;
	line-height: 20px;
	border-right: 1px solid #FFFFFF;
	margin: 23px 0 0;
	padding: 0 12px;
	transition: 0.3s;}
.sport-navigation .sport-nav-desktop .level-1 > li:hover > a {
	color: #FFFFFF;
	transition: 0.3s;}

.sport-navigation .sport-nav-desktop .level-1 > li:last-child > a {
	border-right: none;
	padding-right: 5px;}










.sport-navigation li a {
	font-family: 'Saira', sans-serif!important;	
	text-transform: capitalize !important; 
	font-weight: bold;
	color: #FFFFFF;}
.sport-navigation li a:hover { 
	color: #FF0000!important;}
a.additional-links { 
	font-weight: normal; 
	color: #FFFFFF!important;}
.sport-navigation .parent > .additional-links:after {
	content: '\e865';
	display: inline-block;
	font-family: sidearm_font!important;
	font-weight: normal!important;
	color: #FFFFFF;
	font-size: 12px;
	margin-left: 5px;
	transition: 0.3s;}
.sport-navigation .parent:hover .additional-links:after { 
	color: #FFFFFF;
	font-weight: normal!important;}

.sport-navigation .sport-nav-desktop .level-1 > li:hover .level-2 {
	left: auto;
	right: 0;
}
.sport-navigation .sport-nav-desktop .level-2 {
	position: absolute;
	top: 100%;
	left: -99999px;
	padding: 24px;
	min-width: 300px;
	background-color: white;
	font-weight: 700;
}
.sport-navigation .sport-nav-desktop .level-2 li {
	color: #01203F;
	line-height: 35px;
	font-size: 15px;
}
.sport-navigation .sport-nav-desktop .level-2 li a {
	text-decoration: none;
	font-family: 'Saira', sans-serif!important;
	font-weight: normal!important;
	color: #01203F;
	display: block;
	padding: 0 10px;
	transition: 0.3s;
	border-bottom: 1px solid #e1e1e1!important;
}
.sport-navigation .sport-nav-desktop .level-2 li a:hover {
	background-color: #FF0000;
	color: #FFFFFF!important;
}


.sport-navigation .sport-nav-mobile .level-1 > li:hover > a {
	color: #FFFFFF;
}

.sport-navigation .sport-nav-mobile .sport-nav-mobile-offcanvas .offcanvas-level-1 > li > a:hover,
.sport-navigation .sport-nav-mobile .sport-nav-mobile-offcanvas .offcanvas-level-1 > li > a.open {
	color: #01203F;
}
.sport-navigation .sport-nav-mobile .sport-nav-mobile-offcanvas .offcanvas-level-2 ul li .separator {
	color: #FFFFFF;
}









