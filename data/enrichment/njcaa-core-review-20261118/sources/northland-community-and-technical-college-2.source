/* ----------------------------------------------
    SNIPPET: SCOREBOARD HEADER TICKER
---------------------------------------------- */

.section-scoreboard .scoreboard-header select {
  border-radius: 6px!important;
  background: #FF0000 url('/images/sport_filter_bg.png') no-repeat center right!important;
  color: white;
  text-transform: capitalize;
font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 13px;
/*  height: 40px;
  line-height: 40px; */
  max-width: 160px;
}

.section-scoreboard .scoreboard-header .scoreboard-header__schedule:hover {
  color: #FF0000!important;
}

.section-scoreboard .scoreboard-list .scoreboard__overlay {
  background-color: #FF0000!important;
}




.section-scoreboard .scoreboard-header .scoreboard-header__schedule {
  color: #4d4d4d;
  text-transform: uppercase;
  font-family: 'Saira', sans-serif!important;
font-size: 12px;
  font-weight: 700;
  margin-top: 7px;
  text-decoration: none;
  transition: 0.3s;
font-style: italic!important;
}
.section-scoreboard .scoreboard-header .scoreboard-header__schedule:hover {
  color: #FF0000;
}



.section-scoreboard .scoreboard-list .scoreboard__sport {
color: #FF0000!important;  
font-weight: 700;
font-style: italic!important;
}



/* ----------------------------------------------
    SNIPPET: FAN POLL
---------------------------------------------- */

.section-poll .poll-container__header {
	font-family: 'Saira'!important;
	color: #FF0000!important;
	font-weight: 700!important;
	font-style: italic!important;
	/*font-size: 55px;
	line-height:45px;
	margin: 15px 0 15px;*/}

.section-poll .poll-item .choices input[type="radio"]:checked,
.section-poll .poll-item .results input[type="radio"]:checked {
	background-color: #FF0000;
	transition: 0.3s;}
.section-poll .poll-item .question {
	color: #01203f;
	font-weight: 500;
	text-transform: none;
	text-align: left!important;
	font-size: 22px;
	line-height:26px;
	margin: 25px 0;}
.section-poll .poll-item .choices,
.section-poll .poll-item .results {
	font-family: 'Montserrat', sans-serif!important;
	font-size: 19px;
	text-transform: none!important;
	font-weight: 300;}
.section-poll .poll-item .vote-btn {
	border: none;
	background: none;
	margin: 0;
  padding: 0;
  border-radius: 6px;
  -webkit-appearance: none;
  -moz-appearance: none;
  -ms-appearance: none;
  -o-appearance: none;
  border: none;
  outline: none;
  background: none;
  margin: 15px 0;
  padding: 0;
  border-radius: 6px;
  display: inline-block;
  padding: 10px 20px;
  background-color: #FF0000;
  color: white;
font-family: 'Saira', sans-serif;
  text-transform: uppercase;
  font-weight: 700;
  font-size: 16px;
  line-height: 36px;
  transition: 0.3s;
}




