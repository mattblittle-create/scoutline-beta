												                        <img data-bind="attr: { src: image + '?width=400&height=200&mode=crop' }" alt="">
											                        </div>
											                        <!-- /ko -->
											                        <span data-bind="formatDate: date, format: 'MMM. D'"></span>
											                        <p class="sidearm-roster-player-stories-headline">
												                        <a data-bind="click: function() { return true; }, clickBubble: false, text: headline, attr: { href: url }"></a>
											                        </p>
										                        </li>
									                        </ul>
								                        </div>
							                        </div>
							
						                        <!-- /ko -->

						                        <!-- ko if: stats() && stories() -->

