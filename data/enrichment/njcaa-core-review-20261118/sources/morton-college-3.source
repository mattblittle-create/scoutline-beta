}
.bomg5ijxq-modal__text a {
  color: black;
}
.bomg5ijxq-modal__learn {
  color: black;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5rem;
}
.bomg5ijxq-modal__learn a {
  color: black;
}
.bomg5ijxq-modal__browsers {
  padding-top: 12px;
