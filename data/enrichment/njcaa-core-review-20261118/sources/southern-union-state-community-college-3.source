                    <article class="mt-5">
                         <div class="container">
                                <div class="row">
                                   <section class="col-md-8 co-lg-9 order-1 order-md-0">
                                   	<h3 style="text-align: center;"><img alt="su logo" src="/content/userfiles/images/SU_Athletics.jpg" style="width: 250px; height: 218px;" /></h3>

<h3 style="text-align: center;"><strong>SOUTHERN UNION STATE COMMUNITY COLLEGE<br />
SPRING&nbsp;2023 BASEBALL SCHEDULE<font face="times new roman, times, serif">&nbsp;</font></strong></h3>

<p style="text-align: center;"><a href="/content/userfiles/files/SOUTHERN%20UNION%202023%20SPRING%20BASEBALL%20SCHEDULE.pdf"><span class="btn btn-blue">PDF PRINT SCHEDULE</span></a></p>

<table role="presentation" border="1" cellpadding="3" cellspacing="3" class="table table-striped table-bordered table-hover table-condensed" style="background-color:#ffffff;">
	<tbody>
		<tr>
			<td style="background-color: rgb(153, 153, 153);"><strong>Date</strong></td>
			<td style="background-color: rgb(153, 153, 153);"><strong>Opponent</strong></td>
			<td style="background-color: rgb(153, 153, 153);"><strong>Location</strong></td>
			<td style="background-color: rgb(153, 153, 153);"><strong>Time&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</strong></td>
			<td style="background-color: rgb(153, 153, 153);"><strong>Score</strong></td>
		</tr>
		<tr>
			<td colspan="2" rowspan="1"><b>JANUARY</b></td>
			<td>&nbsp;</td>
			<td>&nbsp;</td>
			<td>&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;"><strong>SAT 28</strong></td>
			<td>
			<p style="text-align: center;"><strong>DH VS GORDON ST</strong></p>
			</td>
			<td>
			<p style="text-align: center;"><b>WADLEY, AL&nbsp;</b></p>
			</td>
			<td>
			<p style="text-align: center;"><strong>2:00 PM</strong></p>
			</td>
			<td>&nbsp;</td>
		</tr>
		<tr>
			<td><strong>FEBRUARY</strong></td>
			<td style="text-align: center;">&nbsp;</td>
			<td style="text-align: center;">&nbsp;</td>
			<td style="text-align: center;">&nbsp;</td>
			<td style="text-align: center;">&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;"><b>FRI 3</b></td>
			<td style="text-align: center;">
			<p><strong>3 WAY VS LBW/CALHOUN</strong></p>
			</td>
			<td style="text-align: center;"><strong>WADLEY, AL</strong></td>
			<td style="text-align: center;">
			<p><strong>12:00 PM&nbsp; -&nbsp; SOUTHERN UNION VS CALHOUN<br />
			2:30 PM - CALHOUN VS LBW&nbsp;<br />
			5:00 PM- SOUTHERN UNION VS LBW</strong></p>
			</td>
			<td style="text-align: center;">&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;"><strong>SAT 4</strong></td>
			<td style="text-align: center;"><strong>3 WAY VS LBW/CALHOUN</strong></td>
			<td style="text-align: center;"><strong>WADLEY, AL</strong></td>
			<td style="text-align: center;">
			<p><strong>11:00 AM - SOUTHERN UNION VS CALHOUN<br />
			1:30 PM &ndash; LBW VS SOUTHERN UNION</strong></p>
			</td>
			<td style="text-align: center;">&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;">TUES 7</td>
			<td style="text-align: center;">GORDON STATE</td>
			<td style="text-align: center;">BARNESVILLE, GA</td>
			<td style="text-align: center;">2:00 PM EST</td>
			<td style="text-align: center;">&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;">SAT 11</td>
			<td style="text-align: center;">SOUTH GA ST</td>
			<td style="text-align: center;">DOUGLAS, GA</td>
			<td style="text-align: center;">2:00 PM EST</td>
			<td style="text-align: center;">&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;"><strong>FRI 17</strong></td>
			<td style="text-align: center;"><strong>SU INVITATIONAL</strong></td>
			<td style="text-align: center;"><strong>WADLEY, AL</strong></td>
			<td style="text-align: center;">
			<p><strong>11:00 AM&nbsp; CHATT VALLEY&nbsp; VS JOHN A LOGAN</strong></p>

			<p><strong>2:30 PM SOUTHERN UNION VS SPARTANBURG METHODIST</strong></p>
			</td>
			<td style="text-align: center;">&nbsp;</td>
		</tr>
		<tr>
			<td style="text-align: center;"><strong>SAT 18</strong></td>
			<td style="text-align: center;"><strong>SU INVITATIONAL</strong></td>
			<td style="text-align: center;"><strong>WADLEY, AL</strong></td>
