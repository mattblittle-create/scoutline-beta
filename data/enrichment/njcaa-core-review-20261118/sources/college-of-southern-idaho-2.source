                <a href="/index.aspx" class="header-logo">
                    <img src="/images/responsive/main_logo.png" alt="College of Southern Idaho Golden Eagles - Go To Homepage" />
                </a>

                <ul class="level-1 flex flex-align-center flex-justify-end" data-bind="foreach: data">
                    <li data-bind="css: class_name" class="main-navigation-level-1-item">
                        <!-- ko if: columns.length === 0 -->
                            <!-- ko if: url === "" -->
                                <a data-bind="html: title"></a>
                            <!-- /ko -->

                            <!-- ko if: url != "" -->
