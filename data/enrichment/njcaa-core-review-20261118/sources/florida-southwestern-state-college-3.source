<script>
(function () {
	if (typeof window === "undefined" || window.__psScheduleJumpBound) return;
	window.__psScheduleJumpBound = true;

	function revealFromHash() {
		var hash = window.location.hash;
		if (!hash || hash.indexOf("#event-") !== 0) return;
		var target;
		try { target = document.querySelector(hash); } catch (err) { return; }
		if (!target) return;

		var panel = target.closest(".collapse:not(.show)");
		if (panel) {
			if (window.bootstrap && window.bootstrap.Collapse) {
				window.bootstrap.Collapse.getOrCreateInstance(panel).show();
			} else {
				panel.classList.add("show");
			}
			var toggle = document.querySelector('[data-bs-toggle="collapse"][href="#' + panel.id + '"], [data-bs-toggle="collapse"][data-bs-target="#' + panel.id + '"]');
			if (toggle) toggle.setAttribute("aria-expanded", "true");
		}

						window.setTimeout(function () {
			target.scrollIntoView({ block: "start", behavior: "auto" });
		}, panel ? 350 : 0);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", revealFromHash);
	} else {
		revealFromHash();
	}
	window.addEventListener("hashchange", revealFromHash);
}());
</script>

<script>
(function () {
	if (typeof window === "undefined" || window.__psScheduleEventCardBound) return;
	window.__psScheduleEventCardBound = true;

	document.addEventListener("click", function (e) {
		if (!e.target || !e.target.closest) return;
				if (e.target.closest("a, button, input, select, textarea, label, summary, [role='button']")) return;
		var card = e.target.closest(".card[data-event-url]");
		if (!card) return;
				if (window.getSelection && String(window.getSelection()).length > 0) return;
		var url = card.getAttribute("data-event-url");
		if (url) window.location.href = url;
	});
}());
</script>

