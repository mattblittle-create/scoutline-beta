			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Lauren Ferullo","value":273},{"label":"Joe Fox","value":117},{"label":"Ben Brown","value":7},{"label":"Justin Studnicky","value":301},{"label":"Mackenzie Ondersma","value":282},{"label":"Brandon Wilber","value":300},{"label":"Whitney Marsh","value":202},{"label":"Sue Goeman","value":200},{"label":"Megan Smith","value":304},{"label":"Andrew Rolls","value":364},{"label":"Joslynne Bogner","value":406},{"label":"Alex Ehnis","value":310},{"label":"Matthew Quillan","value":298},{"label":"Mike Eddington","value":154},{"label":"Mike Cupples","value":218},{"label":"Logan Lee","value":314},{"label":"Adam Sokolove","value":374},{"label":"Sharon Becker","value":156},{"label":"Rob Hyde","value":281},{"label":"Joe Fox","value":117},{"label":"DeQuaveon Stuckey","value":274},{"label":"Danyel Bibbs","value":395},{"label":"Zachary Carlson","value":397},{"label":"Deleon Brown","value":398},{"label":"Bashir Neely","value":407},{"label":"Chris Sobieck","value":342},{"label":"Chuck White","value":278},{"label":"Steve Roersma","value":279},{"label":"Samara Kolehouse","value":307},{"label":"Eric Hardin","value":387},{"label":"Scott Huebler","value":370},{"label":"Karen Roersma","value":302},{"label":"Chip Will","value":1},{"label":"David Rawles","value":131},{"label":"Lexi Heavner","value":394},{"label":"Jasmine Wellet","value":405},{"label":"David Glazier","value":116},{"label":"Mike Janikowski","value":303},{"label":"Danny Robinson","value":312},{"label":"Doug Barrow","value":386},{"label":"Alex Mendoza","value":393},{"label":"Kyle Grew","value":399},{"label":"Anthony Bowie","value":396},{"label":"Joseph Liblong","value":401},{"label":"Luke Ruff","value":403},{"label":"Lauren Helzer","value":400},{"label":"Gabe Miller","value":402}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

			</main>

