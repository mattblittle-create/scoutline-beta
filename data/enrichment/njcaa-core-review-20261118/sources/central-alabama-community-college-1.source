<div class="col-12 col-md-4">
<div style="max-width:320px;margin:0 auto;">
<p class="text-white mb-2"><strong>Website Appearance</strong></p>
<button aria-pressed="false" class="form-control form-control-sm" id="cacc-dark-mode-toggle" style="background-color:#ffffff;color:#333333;border-radius:4px;cursor:pointer;" type="button">☾ Enable Dark Mode</button>

<p class="text-white mb-0 mt-2" style="font-size:0.85rem;">Customize your viewing experience</p>
</div>
</div>
</div>
</div>
<script>
(function () {
 'use strict';
 var key='cacc-dark-mode', root=document.documentElement;
 if(window.caccThemeController){window.caccThemeController.refresh();return;}
 var enabled=false;
 try {enabled=localStorage.getItem(key)==='true';}catch(e){}
 root.classList.toggle('cacc-dark-mode',enabled);
 function sync(){
  root.classList.toggle('cacc-dark-mode',enabled);
  document.body.classList.toggle('cacc-dark-mode',enabled);
  document.querySelectorAll('#cacc-dark-mode-toggle,#cacc-header-theme-toggle').forEach(function(b){
   b.setAttribute('aria-label','Dark mode');
   b.setAttribute('aria-pressed',String(enabled));
   b.title=enabled?'Switch to light mode':'Switch to dark mode';
   var icon=b.querySelector('.cacc-theme-icon');
   if(icon)icon.textContent=enabled?'☀':'☾';
   else b.textContent=enabled?'☀ Enable Light Mode':'☾ Enable Dark Mode';
  });
  document.querySelectorAll('.header-wrapper .logo img').forEach(function(img){
   if(!img.hasAttribute('data-cacc-original-src')){
    if(!/\/central-alabama-community-college-logo(?:-white)?\.svg(?:[?#].*)?$/.test(img.getAttribute('src')||''))return;
    img.setAttribute('data-cacc-original-src',img.getAttribute('src'));
   }
   var next=enabled?'/img/central-alabama-community-college-logo-white.svg':img.getAttribute('data-cacc-original-src');
   if(img.getAttribute('src')!==next)img.setAttribute('src',next);
  });
 }
 function refresh(){
  var menu=document.querySelector('.header-wrapper .btn-toggle-offcanvas');
  if(menu){
   var li=menu.closest('li');
   if(li&&!document.getElementById('cacc-header-theme-toggle')){
    var item=document.createElement('li');item.id='cacc-header-theme-item';item.className='list-inline-item';
    item.innerHTML='<button type="button" id="cacc-header-theme-toggle" aria-label="Dark mode" aria-pressed="false"><span class="cacc-theme-icon" aria-hidden="true">☾</span></button>';
    li.before(item);
   }
  }
  sync();
 }
 function toggle(){enabled=!enabled;try{localStorage.setItem(key,String(enabled));}catch(e){}refresh();}
 window.toggleCaccDarkMode=toggle;
 window.caccThemeController={refresh:refresh};
 document.addEventListener('click',function(e){
  if(e.target instanceof Element&&e.target.closest('#cacc-dark-mode-toggle,#cacc-header-theme-toggle')){e.preventDefault();toggle();}
 });
 window.addEventListener('storage',function(e){if(e.key===key||e.key===null){enabled=e.newValue==='true';refresh();}});
 window.addEventListener('pageshow',refresh);
 refresh();
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',refresh,{once:true});
})();
</script> 
			
