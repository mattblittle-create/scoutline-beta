                        <div class="footer-logos__logo">
                            <a href="http://region4sports.com/landing/index" target="_blank">
                                <img src="https://dxbhsrqyrr690.cloudfront.net/sidearm.nextgen.sites/harper.sidearmsports.com/images/responsive_2019/logos_njcaa_region4.png" alt="National Junior College Athletic Association Region 4">
                            </a>
