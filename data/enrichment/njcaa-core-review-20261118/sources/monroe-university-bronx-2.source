                                    blur:  function() { closeGame(); } 
                                }">
                                        <i class="icon-list-bullet"></i>
                                        <span class="accessible-hide">Boxscore</span>
                                    </a>
                                </li>
                            <!-- /ko -->
                        <!-- /ko -->
                    </ul>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
<!-- /ko --></script><script type='text/html' id='template-events'><!-- ko ifnot: data().length -->
