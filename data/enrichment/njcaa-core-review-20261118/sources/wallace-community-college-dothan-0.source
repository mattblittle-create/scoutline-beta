<script></script>    <script>
    (function () {
        // GTranslate may build its picker after load (or after first interaction), so patch links as they appear
        function patch() {
            document.querySelectorAll('.gt_switcher a[href="#"]:not([role])').forEach(function (a) {
                a.setAttribute('role', 'button');
                a.addEventListener('keydown', function (e) {
                    if (e.key === ' ') { e.preventDefault(); a.click(); }
                });
            });
            // Siteimprove's logged-in overlay button is already labelled ("View issues"); its icon is decorative
            document.querySelectorAll('button.si-button svg:not([aria-hidden])').forEach(function (svg) {
                svg.setAttribute('aria-hidden', 'true');
            });
        }
        patch();
        new MutationObserver(patch).observe(document.body, { childList: true, subtree: true });
    })();
    </script>
        <script>
    (function () {
        var controls = {
            '#close-welcome-tool': 'Close chat greeting',
            '.siteglue-chat-widget .chat-slide': 'Open live chat',
            '#mobile_chat_box .mcb-col-l': 'Open live chat'
        };
        function patch() {
            // The greeting bubble's "Questions? Let's Chat!" is an <h4> that breaks the page's heading order; make it a styled paragraph
            document.querySelectorAll('.chat-welcome-tooltip h4').forEach(function (h) {
                var p = document.createElement('p');
                p.className = 'pcp-chat-welcome-title';
                p.innerHTML = h.innerHTML;
                h.replaceWith(p);
            });
            Object.keys(controls).forEach(function (sel) {
                document.querySelectorAll(sel).forEach(function (el) {
                    if (el.hasAttribute('data-pcp-kb')) return;
                    el.setAttribute('data-pcp-kb', '');
                    el.setAttribute('role', 'button');
                    el.setAttribute('tabindex', '0');
                    el.setAttribute('aria-label', controls[sel]);
                    el.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); }
                    });
                });
            });
        }
        patch();
        new MutationObserver(patch).observe(document.body, { childList: true, subtree: true });
    })();
    </script>
