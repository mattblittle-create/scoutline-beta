        <!-- TEMP - MOVE TO MAIN WHEN APPROVED -->
        <style>
            header {

            }
            header .desktop.nav-menus nav #menu-primary-navigation-1,
            header .desktop.nav-menus nav #menu-primary-navigation-1 > li,
            header .desktop.nav-menus nav #menu-primary-navigation-1 > li > a {
                height: auto !important;
            }
            header .desktop.nav-menus nav #menu-primary-navigation-1 > li > a {
                display: flex !important;
                align-items: center !important;
                height: 68px !important;
            }
            header .logo-box img {
                height: 106px !important;
            }
            header nav#primary-navigation {
                height: 0px !important;
                margin-bottom: -4rem;
            }
            header .desktop.nav-menus {

            }
            header .desktop.nav-menus .rule {
                display: none;
            }
            header .desktop.nav-menus .top-menus {
                background-color: var(--maroon);
                color: white;
                padding: 1rem 2rem;
            }
            header nav#primary-navigation {
                margin-bottom: 0rem;
            }
            main.home #campus-calendar .label {
                top: calc(100% - 27px) !important;
                padding: 0.75rem 3rem 0.75rem 3rem;
            }
            main.home #campus-calendar h2 {
                text-shadow: 0px 0px 15px #333;
            }
            main.home #campus-calendar .label::after {
                display: none;
            }
            section#card-grid {
                margin-top: 2rem;
            }
            section#quick-links .headings-container {
                border-left: 5px solid var(--maroon);
                padding-left: 1rem;
            }
            section#quick-links .grid-container,
            section#card-grid .grid-container {
                grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
                column-gap: 2rem;
                row-gap: 2rem;
            }
            section#quick-links .quick-link,
            section#card-grid .card {
                flex: 1 0 calc(20%);
                min-width: 300px;
                max-width: 100%;
                text-align: center;
                border-top: 5px solid var(--maroon);
                font-weight: 700;
                box-shadow: 0px 0px 15px 5px #eee;
            }
            section#split-content,
            section#card-grid {
                margin-bottom: 2rem;
            }

            section#split-content .image-block .bg-image {
                border-radius: 0.333rem;
            }
            .slide-img {
            	display: flex;
                width: 100%;
                aspect-ratio: 2/1;
                max-height: 80vh;
            	background-position: center;
                background-size: cover;
                background-repeat: no-repeat;
            }
            .grid-item,
            .flex-item {
                max-width: 100%;
            }
            input.search-field {
                background-color: #913d50;
                border: none;
                border-radius: 4px !important;
                color: white !important;
                height: 40px;
                font-family: tablet-gothic, sans-serif;
                font-size: 16px;
                text-align: center;
            }
            input.search-field::placeholder {
                color: white !important;
            }
            input.search-submit {
                display: none;
            }
            .menu-item-251,
            .menu-item-26159 {
                margin-right: 0rem;
            }
            .desktop .top-menus li {
                height: 38px;
                padding: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .nav-menus #top-menu ul {
                gap: 0rem;
            }

            .nav-menus #utility-menu ul {
                gap: 0rem;
            }
            @media only screen and (max-width: 480px) {
                section#quick-links .grid-container,
                section#card-grid .grid-container {
                    grid-template-columns: repeat(auto-fit, minmax(100%, 1fr));
                }
                .events-container .flex-wrapper {
                    justify-content: center;
                    text-align: center;
                }
            }

            li.flex-active-slide .kb-image {
                -webkit-animation: kenburns 15s ease infinite;
                animation: kenburns 15s ease infinite;
            }

            @-webkit-keyframes kenburns {
                0% {
                    -webkit-transform: scale(1) translate(0, 0);
                    transform: scale(1) translate(0, 0);
                }
                100% {
                    -webkit-transform: scale(1.15) translate(-5%, -5%);
                    transform: scale(1.15) translate(-5%, -5%);
                }
            }

            @keyframes kenburns {
                0% {
                    transform: scale(1) translate(0, 0);
                }
                100% {
                    transform: scale(1.15) translate(-5%, -5%);
                }
            }

            .desktop.nav-menus #top-menu ul {
                gap: 0rem !important;
            }

            .desktop.nav-menus #utility-menu ul {
                gap: 0rem !important;
            }
            .desktop.nav-menus .menu-item-251 {
                margin-left: 1rem !important;
                margin-right: 1.5rem !important;
            }
            .desktop.nav-menus .top-menus {
                padding: 1rem 2rem 1rem 1rem !important;
            }

        </style>



