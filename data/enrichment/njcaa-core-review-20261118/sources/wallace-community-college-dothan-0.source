<style>
	.wcc-404 {
		display: flex;
		flex-direction: column;
		gap: 28px;
		max-width: 1000px;
	}
	.wcc-404 > * { margin-top: 0; margin-bottom: 0; }
	.wcc-404 h1 { margin: 0; }
	.wcc-404__eyebrow {
		margin: 0 0 .35rem;
		color: var(--maroon, #8E1537);
		font-weight: 700;
		font-size: .85rem;
		letter-spacing: .12em;
		text-transform: uppercase;
	}
	.wcc-404__lead { font-size: 1.125rem; line-height: 1.6; max-width: 680px; }

	.wcc-404__search {
		display: flex;
		max-width: 560px;
		border: 4px solid var(--light-gray, #D7D2CB);
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
	}
	.wcc-404__search:focus-within { border-color: var(--maroon, #8E1537); }
	.wcc-404__search input[type="search"] {
		flex: 1;
		min-width: 0;
		padding: 14px 16px;
		border: 0;
		font: inherit;
		font-size: 1rem;
		background: transparent;
		-webkit-appearance: none;
		appearance: none;
	}
	.wcc-404__search input[type="search"]:focus { outline: none; }
	.wcc-404__search button {
		display: inline-flex;
		align-items: center;
		gap: .5rem;
		padding: 0 22px;
		border: 0;
		background: var(--maroon, #8E1537);
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.wcc-404__search button:hover,
	.wcc-404__search button:focus-visible { background: #6f102b; }

	.wcc-404__divider {
		width: 60px;
		height: 3px;
		margin: 8px 0;
		background: var(--maroon, #8E1537);
	}
	.wcc-404__heading {
		margin: 0;
		color: var(--maroon, #8E1537);
		font-family: var(--font-family-secondary, 'abril-titling-narrow', sans-serif);
		font-size: 1.6rem;
		font-weight: 700;
	}

	.wcc-404__links {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		grid-auto-rows: 1fr;
		margin-top: -14px;
		gap: 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.wcc-404__links li { margin: 0; padding: 0; }
	.wcc-404__links li::before { content: none; }
	.wcc-404__links a {
		display: flex;
		align-items: center;
		gap: .75rem;
		height: 100%;
		box-sizing: border-box;
		padding: 14px 18px;
		border: 4px solid var(--light-gray, #D7D2CB);
		border-radius: 12px;
		background: var(--maroon, #8E1537);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
		transition: background-color .15s ease, border-color .15s ease;
	}
	.wcc-404__links a:hover,
	.wcc-404__links a:focus-visible {
		background: #6f102b;
		border-color: var(--maroon, #8E1537);
		color: #fff;
	}
	.wcc-404__links a:focus-visible { outline: 3px solid #000; outline-offset: 2px; }
	.wcc-404__links i { width: 1.25em; text-align: center; font-size: 1.1rem; }

	.wcc-404__help { margin: 0; color: var(--dark-gray, #707070); }
	.wcc-404__help a { color: var(--maroon, #8E1537); text-decoration: underline; }
</style>

    
