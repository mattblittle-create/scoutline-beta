    <style>
    #wcc-alert-banner {
    display: none;
    box-sizing: border-box;
    width: 100%;
    max-width: 1200px;
    margin: 12px auto 18px;
    background: #ffffff;
    border: 4px solid #8e1537;
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(0,0,0,.20);
    overflow: hidden;
    font-family: Arial, Helvetica, sans-serif;
    }

    #wcc-alert-banner.wcc-visible {
    display: block;
    }

    /* Maroon header */
    #wcc-alert-banner .wcc-alert-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #8e1537;
    color: var(--secondary-background-color) !important;
    text-align: center;
    padding: 14px 20px 16px;
    }

    /* White Wallace logo */
    #wcc-alert-banner .wcc-alert-logo {
    display: block;
    width: 82px;
    max-width: 80%;
    height: auto;
    margin: 0 auto 7px;
    object-fit: contain;
    }

    /* Override theme heading colors */
    #wcc-alert-banner .wcc-alert-header h2,
    #wcc-alert-banner .wcc-alert-header p,
    #wcc-alert-banner .wcc-alert-heading,
    #wcc-alert-banner .wcc-alert-subheading {
    color: var(--secondary-background-color) !important;
    text-shadow: none !important;
    }

    #wcc-alert-banner .wcc-alert-heading,
    #wcc-alert-banner .wcc-alert-subheading {
    color: white !important;
    text-shadow: none !important;
    }

    #wcc-alert-banner .wcc-alert-heading {
    margin: 0 0 5px !important;
    padding: 0 !important;
    font-family: Arial, Helvetica, sans-serif !important;
    font-size: 30px !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    letter-spacing: .4px;
    text-align: center !important;
    }

    #wcc-alert-banner .wcc-alert-subheading {
    margin: 0 !important;
    padding: 0 !important;
    font-family: Arial, Helvetica, sans-serif !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    line-height: 1.4 !important;
    text-align: center !important;
    }

    /* White message panel */
    #wcc-alert-banner .wcc-alert-message-wrap {
    padding: 20px 28px 22px;
    background: #ffffff;
    }

    #wcc-alert-banner .wcc-alert-message {
    color: var(--fixed-dark-color) !important;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.6;
    text-align: center;
    overflow-wrap: anywhere;
    }

    #wcc-alert-banner .wcc-alert-message iframe {
    display: block;
    width: 100%;
    min-height: 45px;
    border: 0;
    background: transparent;
    }

    #wcc-alert-banner .wcc-alert-preview {
    color: var(--fixed-dark-color);
    font: inherit;
    text-align: center;
    }

    /* Mobile styling */
    @media (max-width: 650px) {
    #wcc-alert-banner {
    margin: 10px auto 14px;
    }

    #wcc-alert-banner .wcc-alert-header {
    padding: 12px 14px;
    }

    #wcc-alert-banner .wcc-alert-logo {
    width: 68px;
    margin-bottom: 6px;
    }

    #wcc-alert-banner .wcc-alert-heading {
    font-size: 24px !important;
    }

    #wcc-alert-banner .wcc-alert-subheading {
    font-size: 14px !important;
    }

    #wcc-alert-banner .wcc-alert-message-wrap {
    padding: 16px;
    }

    #wcc-alert-banner .wcc-alert-message {
    font-size: 18px;
    }
    }
    </style>

    <!-- Wallace Alert Banner -->
    <section
    id="wcc-alert-banner"
    aria-label="Wallace Community College Emergency Alerts">

    <div class="wcc-alert-header">

    <img
    class="wcc-alert-logo"
    src="https://wallace.edu/wp-content/uploads/2026/05/White-WCC-Logo-Copy-1.png"
    alt="Wallace Community College logo"
    width="82">

    <h2 class="wcc-alert-heading"
    style="color: white !important;">
    Wallace Alert
    </h2>

    <p class="wcc-alert-subheading"
    style="color: white !important;">
    Important Campus Notification
    </p>

    </div>

    <div class="wcc-alert-message-wrap">
    <div class="wcc-alert-message"
    id="wcc-alert-message">
    </div>
    </div>

    </section>

    <script>
    (function () {
    "use strict";

    const banner =
    document.getElementById("wcc-alert-banner");

    const container =
    document.getElementById("wcc-alert-message");

    if (!banner || !container) return;

    const widgetURL =
    "https://s3.amazonaws.com/widgets.omnilert.net/" +
    "aa63d382dfc10043fe45bd4f3c4c8cb9-12922";

    const refreshInterval = 120000;

    const previewMode =
    new URLSearchParams(window.location.search)
    .get("wcc_alert_preview") === "1";

    const emptyMessages = [
    "",
    "no alerts",
    "no active alerts",
    "no current alerts",
    "there are no active alerts",
    "there are no current alerts"
    ];

    let currentFrame = null;
    let observer = null;

    function setVisible(visible) {
    banner.classList.toggle(
    "wcc-visible",
    visible
    );
    }

    /* Preview without publishing an alert */
    if (previewMode) {
    const preview = document.createElement("div");
    preview.className = "wcc-alert-preview";

    preview.textContent =
    "TEST ALERT: This is a preview of how an " +
    "emergency notification will appear on the " +
    "Wallace Community College website.";

    container.appendChild(preview);
    setVisible(true);
    return;
    }

    function inspectWidget(frame) {
    if (frame !== currentFrame) return;

    try {
    const doc = frame.contentDocument;

    if (!doc || !doc.body) {
    setVisible(false);
    return;
    }

    const text = (doc.body.innerText || "")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();

    const hasMessage =
    text.length > 0 &&
    !emptyMessages.includes(text);

    setVisible(hasMessage);

    if (hasMessage) {
    frame.style.height = Math.max(
    doc.body.scrollHeight,
    doc.documentElement.scrollHeight,
    60
    ) + "px";
    }

    } catch (error) {
    setVisible(false);
    }
    }

    function loadWidget() {
    if (observer) {
    observer.disconnect();
    observer = null;
    }

    setVisible(false);
    container.replaceChildren();

    const frame = document.createElement("iframe");

    frame.title = "Live Wallace emergency alerts";
    frame.setAttribute("scrolling", "no");
    frame.setAttribute("loading", "eager");

    currentFrame = frame;

    frame.srcdoc = `
    <!doctype html>
    <html lang="en">
    <head>
    <meta name="viewport"
    content="width=device-width,initial-scale=1">

    <style>
    html, body {
    margin: 0;
    padding: 0;
    background: transparent;
    overflow-wrap: anywhere;
    }

    body, body * {
    color: var(--fixed-dark-color) !important;
    font-family: Arial, Helvetica, sans-serif !important;
    font-size: 22px !important;
    font-weight: 600 !important;
    line-height: 1.6 !important;
    text-align: center !important;
    }

    p {
    margin: 0 0 10px;
    }

    a {
    color: var(--color-dark-red-hover) !important;
    text-decoration: underline !important;
    text-underline-offset: 4px;
    font-weight: 700 !important;
    }

    a:focus-visible {
    outline: 3px solid #8e1537;
    outline-offset: 3px;
    }

    @media (max-width: 650px) {
    body, body * {
    font-size: 18px !important;
    }
    }
    </style>
    </head>

    <body>
    <script src="${widgetURL}"><\/script>
    </body>
    </html>`;

    frame.addEventListener("load", function () {
    if (frame !== currentFrame) return;

    try {
    const doc = frame.contentDocument;

    if (!doc || !doc.body) return;

    observer = new MutationObserver(function () {
    inspectWidget(frame);
    });

    observer.observe(doc.body, {
    childList: true,
    subtree: true,
    characterData: true
    });

    inspectWidget(frame);

    } catch (error) {
    setVisible(false);
    }
    });

    container.appendChild(frame);
    }

    loadWidget();

    /* Refresh just the widget every 2 minutes */
    setInterval(function () {
    if (!document.hidden) {
    loadWidget();
    }
    }, refreshInterval);

    /* Check when visitor returns to tab */
    document.addEventListener(
    "visibilitychange",
    function () {
    if (!document.hidden) {
    loadWidget();
    }
    }
    );

    })();
    </script>
    <body class="error404 wp-embed-responsive wp-theme-blankslate wp-child-theme-wallacecommunitycollege site-wrapper wpb-js-composer js-comp-ver-9.1 vc_responsive">
