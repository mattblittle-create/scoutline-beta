            --gf-color-primary-lighter: #B03A5B !important;
            --gf-color-primary-contrast: #fff !important;
            --gf-color-primary-contrast-rgb: 255, 255, 255 !important;
            /* GF also bakes the blue into these control-level copies */
            --gf-color-in-ctrl-primary: #8E1537 !important;
            --gf-color-in-ctrl-primary-rgb: 142, 21, 55 !important;
            --gf-ctrl-accent-color: #8E1537 !important;
            --gf-ctrl-btn-bg-color-ctrl: #8E1537 !important;
            --gf-ctrl-btn-bg-color-focus-ctrl: #8E1537 !important;
            --gf-ctrl-btn-bg-color-disabled-ctrl: #8E1537 !important;
            --gf-ctrl-choice-check-color: #8E1537 !important;
            --gf-ctrl-date-picker-cell-content-bg-color-selected: #8E1537 !important;
            --gf-ctrl-date-picker-cell-content-border: 1px solid #8E1537 !important;
            --gf-ctrl-file-zone-icon-color: #8E1537 !important;
            --gf-ctrl-select-dropdown-option-shadow-hover: inset 3px 0 0 #8E1537 !important;
            --gf-ctrl-multiselect-selected-item-bg-color: #8E1537 !important;
            --gf-field-img-choice-card-check-ind-bg-color: #8E1537 !important;
            --gf-field-img-choice-no-card-check-ind-bg-color: #8E1537 !important;
            --gf-field-pg-prog-bar-bg-color-blue: #8E1537 !important;
        }

        /* Submit / Next buttons = site .button.small.bg-maroon */
        .gform_wrapper .gform_footer input[type="submit"],
        .gform_wrapper .gform_footer button[type="submit"],
        .gform_wrapper .gform_footer .gform_button,
        .gform_wrapper .gform_page_footer .gform_next_button,
        .gform_wrapper .gform_page_footer input[type="submit"],
        .gform_wrapper .gform_page_footer button[type="submit"] {
            background-color: #8E1537 !important;
            border: 2px solid #8E1537 !important;
            border-radius: 0 !important;
            color: #fff !important;
            font-family: var(--font-family-secondary), sans-serif !important;
            font-size: 22px !important;
            font-weight: 400 !important;
            line-height: 1.2 !important;
            height: auto !important;
            min-height: 44px;
            padding: calc(0.75rem - 2px) calc(3rem - 2px) calc(1rem - 2px) !important;
            box-shadow: none !important;
            text-transform: none !important;
            cursor: pointer;
        }

        .gform_wrapper .gform_footer input[type="submit"]:hover,
        .gform_wrapper .gform_footer button[type="submit"]:hover,
        .gform_wrapper .gform_footer .gform_button:hover,
        .gform_wrapper .gform_page_footer .gform_next_button:hover,
        .gform_wrapper .gform_page_footer input[type="submit"]:hover,
        .gform_wrapper .gform_page_footer button[type="submit"]:hover {
            background-color: #8E1537 !important;
            border-color: #8E1537 !important;
        }

        /* Previous button: maroon outline */
        .gform_wrapper .gform_page_footer .gform_previous_button {
            background-color: #fff !important;
            border: 2px solid #8E1537 !important;
            border-radius: 0 !important;
            color: #8E1537 !important;
            font-family: var(--font-family-secondary), sans-serif !important;
            font-size: 22px !important;
            font-weight: 400 !important;
            line-height: 1.2 !important;
            height: auto !important;
            padding: calc(0.75rem - 2px) calc(3rem - 2px) calc(1rem - 2px) !important;
            box-shadow: none !important;
        }

        .gform_wrapper .gform_footer input:focus-visible,
        .gform_wrapper .gform_footer button:focus-visible,
        .gform_wrapper .gform_page_footer input:focus-visible,
        .gform_wrapper .gform_page_footer button:focus-visible {
            outline: 3px solid orange !important;
