        <!-- Main Dropdown Menu -->
        <script>
            $(document).ready(function() {
                $('.nav-menus ul li').hover(function() {
                    $(this).find('.sub-menu').css('display', 'flex');
                }, function() {
                    $(this).find('.sub-menu').css('display', 'none');
                });
            });
        </script>

        <!-- Subpage Navigation -->
        <script>
            $(document).ready(function() {
                $('.subpage-navigation .navigation-header').click(function() {
                    $(this).parent().toggleClass('open');
                });
            });
        </script>

        <!-- Main Menu Burger Icon -->
        <script>
            $(document).ready(function() {
                $('header .burger-icon').click(function() {
                    $(this).toggleClass('open');
                    $('.site-wrapper-for-menu').toggleClass('open');
                    $('.main-menu-mobile').toggleClass('open');
                    $('body').toggleClass('scroll-lock');
                    $('html').toggleClass('scroll-lock');
                });
            });

            // Submenu Toggle
            $(document).ready(function () {
                $('.main-menu-mobile #menu-primary-navigation li').on('click', function (e) {
                    var $li = $(this);
                    var rect = this.getBoundingClientRect();

                    // Adjust this number to match the visual clickable area around your plus icon
                    var pseudoAreaWidth = 90;

                    var clickedPseudoArea = e.clientX >= rect.right - pseudoAreaWidth;

                    if (clickedPseudoArea) {
                        $li.toggleClass('open');
                    }
                });
            });

        </script>


