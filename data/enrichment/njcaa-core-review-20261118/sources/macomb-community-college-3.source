            }).on('click', '#sidearm-schedule-header-print-button', function (e) {

                var url = $(this).attr("href") + "";

                if (url.indexOf("/documents/") > -1) {
                    return;
                }

                e.preventDefault();

                if (/([?|&]location=)[^\&]*/.test(url)) {
