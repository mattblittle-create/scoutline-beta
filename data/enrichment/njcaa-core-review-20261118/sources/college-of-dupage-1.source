			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Ryan Kaiser","value":57},{"label":"Rich  Dawkins","value":80},{"label":"Kelsey Plefka","value":101},{"label":"Beverly Smith","value":3},{"label":"Layne Engel","value":24},{"label":"Evan Harvey","value":163},{"label":"Brian Yaeger","value":166},{"label":"Matt Cousins","value":25},{"label":"Steph Nichols","value":138},{"label":"Ian Welsh","value":85},{"label":"John Pangan","value":62},{"label":"Tarah Geye","value":171},{"label":"Emily Dierking","value":119},{"label":"Kyle Honn","value":161},{"label":"Shawnee Ardies-Morales","value":107},{"label":"Pat Leahy","value":106},{"label":"Joe Kuhn","value":86},{"label":"Chris Bode","value":169},{"label":"Kristin Ison","value":146},{"label":"Merric Young","value":167},{"label":"Mallory Dominguez","value":95},{"label":"Kelly Kibler","value":126},{"label":"Nick Keeling","value":165},{"label":"Floyd Turner","value":121},{"label":"Alex Grossman","value":140},{"label":"Jenn Schulmeister","value":139},{"label":"Tyler White","value":160},{"label":"Kendrick Thomas","value":159},{"label":"Matthew Rahn","value":31},{"label":"Trevor Cipriano","value":32},{"label":"Joel  Beard","value":109},{"label":"Dean Pauley","value":51},{"label":"J.R. Niklos","value":68},{"label":"Joe Furco","value":157},{"label":"Sushane Kumar","value":114},{"label":"Nolan Bernat","value":112},{"label":"Billy Stoynoff","value":155},{"label":"Jordan Westerkamp","value":156},{"label":"Matt Cotiguala","value":130},{"label":"Michael Simon","value":173},{"label":"Jojo  Holmes","value":174},{"label":"Jason  Hyatt","value":10},{"label":"Bill Sanford","value":97},{"label":"Evan Clement","value":141},{"label":"Dylan Cook","value":143},{"label":"Matt Hanna","value":82},{"label":"Mike Bona","value":110},{"label":"Alyssa Arce","value":152},{"label":"Salvador Tamayo","value":175},{"label":"Caitlin Yurkovich","value":176},{"label":"Sydney Heinrich","value":172},{"label":"Shannon Fuller","value":122},{"label":"Leigh Farina","value":177},{"label":"Jim Bowers","value":14},{"label":"Mark Ververka","value":158},{"label":"Mallory Dominguez","value":95},{"label":"Kelly Kibler","value":126},{"label":"Nick Keeling","value":165},{"label":"Gustavo Alvarez","value":147},{"label":"Justin Rivers","value":148},{"label":"Kenny  Brown","value":149},{"label":"Floyd Turner","value":121},{"label":"Tolis Koskinaris","value":13},{"label":"Frank  Martinez","value":36},{"label":"Cynthia  Martinez","value":78},{"label":"Braden Woods","value":93}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

