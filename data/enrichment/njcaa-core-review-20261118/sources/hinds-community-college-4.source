                                                    <label class="sidearm-form-field-label" data-bind="html: title + (required ? $parent.requiredAbbr : ''), attr: { 'for': 'field-' + id }"></label>
                                                    <span class="sidearm-form-validation-message" data-bind="validationMessage: value"></span>
                                                    <textarea class="sidearm-form-field-input-required" data-bind="attr: { 'id': 'field-' + id, required: (required ? required : null) }, value: value, disable: $parent.isSubmitting"></textarea>
                                                </li>
                                            <!-- /ko -->

                                            <!-- ko case: type === 'D' --> 
                                                <li class="sidearm-form-field sidearm-form-field-date" data-bind="css: { 'sidearm-form-field-required': required }, visible: is_visible()">
                                                    <label class="sidearm-form-field-label" data-bind="html: title + (required ? $parent.requiredAbbr : ''), attr: { 'for': 'field-' + id }"></label>
                                                    <span class="sidearm-form-validation-message" data-bind="validationMessage: value"></span>
                                                    <div class="sidearm-form-field-date-container">
                                                        <input class="sidearm-form-field-input" type="text" data-bind="attr: { 'id': 'field-' + id }, pikaday: value, format: 'MM/DD/YYYY', showDefaultDate: show_current_date, disable: $parent.isSubmitting">
                                                    </div>
                                                </li>
                                            <!-- /ko -->

                                            <!-- ko case: type === '-' -->
                                                <li class="sidearm-form-field sidearm-form-field-separator" data-bind="visible: is_visible()"> 
                                                    <p role="heading" aria-level="2" data-bind="html: title">
                                                </li>
                                            <!-- /ko -->

                                        <!-- /ko -->
                                    <!-- /ko -->
                                    <!-- ko if: isCouponAvailable -->
                                    <li class="sidearm-form-field sidearm-form-field-text">
                                        <label class="sidearm-form-field-label" for="coupon-code">Coupon Code</label>
                                        <div class="sidearm-form-field-coupon">
                                            <div class="coupon-inputs">
                                                <input id="coupon-code" class="sidearm-form-field-input" data-bind="value: couponCodeText, disable: couponCodeApplied || isSubmitting">
                                                <button class="sidearm-form-button sidearm-form-button-submit" data-bind="text: couponCodeApplied() ? 'Clear' : 'Apply', click: couponCodeApplied() ? clearCoupon : applyCoupon, enable: isOpenForSubmission, css: { 'sidearm-form-button-submitting' : isSubmitting }">
                                                </button>
                                            </div>
                                            <div class="sidearm-form-coupon-message" data-bind="css: { 'sidearm-form-coupon-error' : couponCodeMessageHasError }, visible: couponCodeMessage">
                                                <span data-bind="text: couponCodeMessage"></span>
                                                <span data-bind="formatCurrency: discountTotal, visible: discountTotal"></span>
                                            </div>
                                        </div>
                                    </li>
                                    <!-- /ko -->
                                    <!-- ko if: isPaymentEnabled -->
                                        <li class="sidearm-form-field sidearm-form-payment-amount-container">
                                            <div class="sidearm-form-payment-amount">Amount Due: <span data-bind="formatCurrency: paymentTotal"></span></div>
                                        </li>
                                    <!-- /ko -->
                                    <li class="sidearm-form-field sidearm-form-buttons">
                                        <button class="sidearm-form-button sidearm-form-button-submit" data-bind="text: submitButtonText, click: submitForm, disable: isSubmitting, enable: isOpenForSubmission, css: { 'sidearm-form-button-submitting' : isSubmitting }">
                                        </button>
                                    <br><br>
                                    <p class="sidearm-form-recaptcha-disclaimer">This site is protected by reCAPTCHA and the 
                                            <a href="https://policies.google.com/privacy">Google Privacy Policy</a> and
