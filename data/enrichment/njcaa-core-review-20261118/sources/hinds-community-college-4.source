                                            <!-- ko case: type === 'T' || type == 'N' --> 
                                                <li class="sidearm-form-field sidearm-form-field-text" data-bind="css: { 'sidearm-form-field-required': required }, visible: is_visible()">
                                                    <label class="sidearm-form-field-label" data-bind="html: title + (required ? $parent.requiredAbbr : ''), attr: { 'for': 'field-' + id }"></label>
                                                    <span class="sidearm-form-validation-message" data-bind="validationMessage: value"></span>
                                                    <input class="sidearm-form-field-input sidearm-form-field-input-required" data-bind="attr: { 'id': 'field-' + id, type: is_email_field ? 'email' : 'text', 'maxlength': max_length, 'size': size, required: (required ? required : null) }, css: { 'auto-width': size }, value: value, validationElement: value, disable: $parent.isSubmitting">
                                                </li>
                                            <!-- /ko -->

                                            <!-- ko case: type === 'Y' || type === '5' || type === 'R' --> 
                                                <li class="sidearm-form-field sidearm-form-field-radio-list" data-bind="css: { 'sidearm-form-field-required': required, 'sidearm-form-field-yes-no': type === 'Y' }, visible: is_visible()">
                                                    <fieldset class="sidearm-form-field-fieldset">
                                                        <legend data-bind="html: title + (required ? $parent.requiredAbbr : '')"></legend>
                                                        <span class="sidearm-form-validation-message" data-bind="validationMessage: value"></span>

                                                        <ol class="sidearm-form-field-options" data-bind="foreach: options">
                                                            <li>
                                                                <input type="radio" data-bind="attr: { 'name': 'field-' + $parent.id, 'id': 'field-' + $parent.id + '-' + id }, checked: $parent.value, checkedValue: $rawData, disable: $root.isSubmitting">
                                                                <label data-bind="attr: { 'for': 'field-' + $parent.id + '-' + id }, html: title"></label>
                                                            </li>
                                                        </ol>
                                                    </fieldset>
                                                </li>
                                                <!-- ko if: show_other_answer -->
                                                    <li class="sidearm-form-field sidearm-form-field-text other-answer-container" data-bind="visible: show_other_answer">
