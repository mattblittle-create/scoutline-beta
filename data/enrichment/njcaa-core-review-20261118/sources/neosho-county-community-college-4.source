                <div class="ads-container on-focus-outline" data-bind="afterBind: { callback: function() { $component.slick($element, slickOptions) }, foreach: ad.campaigns }">
                    <div class="ad multi-ad" data-bind="css: css_class">   
                        <!-- ko if: link === '' || link === '#' -->
