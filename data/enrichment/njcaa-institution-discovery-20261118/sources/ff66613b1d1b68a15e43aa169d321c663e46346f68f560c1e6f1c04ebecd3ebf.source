				<div class="et_pb_module et_pb_blurb et_pb_blurb_3 equalizethis  et_pb_text_align_center  et_pb_blurb_position_top et_pb_bg_layout_dark">
				
				
				
				
				<div class="et_pb_blurb_content">
					<div class="et_pb_main_blurb_image"><span class="et_pb_image_wrap et_pb_only_image_mode_wrap"><img loading="lazy" decoding="async" width="790" height="496" src="https://www.clevelandstatecc.edu/wp-content/uploads/2024/03/Cleveland-State-Program-Spotlight-Nursing.jpg" alt="Cleveland State Program Spotlight Nursing" srcset="https://www.clevelandstatecc.edu/wp-content/uploads/2024/03/Cleveland-State-Program-Spotlight-Nursing.jpg 790w, https://www.clevelandstatecc.edu/wp-content/uploads/2024/03/Cleveland-State-Program-Spotlight-Nursing-480x301.jpg 480w" sizes="(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 790px, 100vw" class="et-waypoint et_pb_animation_top et_pb_animation_top_tablet et_pb_animation_top_phone wp-image-29" /></span></div>
					<div class="et_pb_blurb_container">
						<h4 class="et_pb_module_header"><span>Nursing</span></h4>
						<div class="et_pb_blurb_description"><p>Nursing is designed to prepare students for employment to practice as a professional registered nurse (RN) in public, private, and governmental healthcare sectors.</p></div>
					</div>
				</div>
			</div><div class="et_pb_button_module_wrapper et_pb_button_1_wrapper et_pb_button_alignment_center et_pb_module ">
				<a class="et_pb_button et_pb_button_1 et_pb_bg_layout_dark" href="https://www.clevelandstatecc.edu/academic-programs/healthcare/nursing/">Learn More</a>
			</div>
			</div><div class="et_pb_column et_pb_column_1_4 et_pb_column_7  et_pb_css_mix_blend_mode_passthrough">
				
				
				
				
				<div class="et_pb_module et_pb_blurb et_pb_blurb_4 equalizethis  et_pb_text_align_center  et_pb_blurb_position_top et_pb_bg_layout_dark">
				
				
				
				
				<div class="et_pb_blurb_content">
