<style id="wp-custom-css">
.header__nav__menu > li > a {
    	   font-size: 13px;
}
.main {
    margin-top: 0px;
}
.article {
    margin-top: 30px;
}

.header__nav__search form {
   z-index: 999999;
}
</style>
<style id="wp-add-custom-css-single" type="text/css">
@-webkit-keyframes sdb04 {
  0% {
    -webkit-transform: rotate(-45deg) translate(0, 0);
  }
  20% {
    -webkit-transform: rotate(-45deg) translate(-10px, 10px);
  }
  40% {
    -webkit-transform: rotate(-45deg) translate(0, 0);
  }
}
@keyframes sdb04 {
  0% {
    transform: rotate(-45deg) translate(0, 0);
  }
  20% {
    transform: rotate(-45deg) translate(-10px, 10px);
  }
  40% {
    transform: rotate(-45deg) translate(0, 0);
  }
}

.video-container {
      display: flex;
      flex-direction: column;
      max-height: 75vh;
      position: relative;
}

.panels_2023 {
  background: #f4f4f4;
  margin: 100px auto;
}

.panels_2023  .content-top {
    margin-top: 50px;
}

.panels_2023  .content-bottom {
    margin-bottom: 100px;
    margin-top: 50px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.panels_2023  .content-bottom a {
    align-self: stretch;
    display: flex;
    margin: 0;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    font-family: 'Arboria-Black';
    font-size: 16px;
}

.panel__item__title {
    background: #183856; /*#7d0608;*/
    color: #fff;
    padding: 16px 18px;
    font-family: 'Minion Pro';
    font-size: 24px;
}

.panels_2023 .content-bottom a {
background: #183856;
}

.panels_2023 .content-bottom a:hover {
color: #ea4036;
}

.panel__item__content {
    position: relative;
}

.panel__item__content .description {
    position: absolute;
    top: 0;
    left: 0;
    background: rgb(0,0,0,0.6);
    color: #fff;
    padding: 20px;
    font-size: 13px;
    visibility: hidden;
    transition: visibility 0s, opacity 1s linear;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

@media (max-width: 768px) {
   .panel__item__content .description  {
         justify-content: flex-start;
        padding: 8px 20px;
   }

    .panel__item__content .description h5 {
        font-size: 13px!important;
        margin: 4px 0!important;
    }
}

.panel__item__content .description h5 {
    font-weight: bold;
    font-size: 16px;
    font-family: 'Arboria-Black';
    margin: 12px 0px;
}

.panel__item__content .description p {
    font-family: 'Arboria-Black';
}

.panels_2023 .panels__item {
     height: 340px;
     margin-bottom: 30px;
}

.panels_2023 .panels__item:hover .description {
    visibility: visible;
    height: 100%;
    width: 100%;
}
.panels_2023 .panels__item a:hover img {
-webkit-transform: none;
    -ms-transform: none;
    transform: none;
}

.panels_2023 .panels__item .fa-chevron-right {
  float: right;
  margin-top: 4px;
    margin-top: 8px;
    font-size: 14px;
}

.panels_2023 .panels__item:hover .fa-chevron-right {
-webkit-transform: rotate(90deg);
    -moz-transform: rotate(90deg);
    -o-transform: rotate(90deg);
    -ms-transform: rotate(90deg);
    transform: rotate(90deg);
}

.panels_2023 .panels__grid {
   margin-left: auto;
   margin-right: auto;
   justify-content: center;
}

.panels_2023 .section-first-title {
   font-family: 'Arboria-Black';
   font-size: 25px;
   margin-bottom: 0;
}

.panels_2023 .section-second-title {
        font-family: 'Minion Pro';
    font-size: 60px;
}

.boxes__grid {
    display: flex;
    justify-content: space-evenly;
    align-items: stretch;
    flex-wrap: wrap;
}

.boxes__grid  .box__item {
   flex: 1 0 21%; 
    margin: 0 6px;
   background-color:  #f4f4f4;
   position: relative;
   display: flex;
   flex-direction: column;
}

@media (max-width: 768px ) {
    .boxes__grid .box__item {
        flex: 1 0 100%;
        margin-bottom: 15px; 
    }
}

@media (min-width: 768px ) and (max-width: 1280px) {
   .boxes__grid .box__item {
        flex: 1 0 45%;
        margin-bottom: 15px; 
    }

}
.boxes__grid  .box__item div {
   color: #183856;
}

.boxes__grid  .box__item div a:hover {
  color: #ea4036;
}

.boxes__grid .box__item .btn {
  background: #183856;
  padding-left: 1.2em;
  padding-right: 1.2em;
}

.boxes__grid  .box__item .box__item__title {
text-align: center;
    font-family: 'Minion Pro';
    font-size: 34.41px;
    line-height: 1;
    margin: 20px auto;
    padding: 0 10px;
}

.boxes__grid  .box__item .box__item__image>img {
  width: 100%;
}

.box__item__headline {
    font-size: 18px;
    font-family: 'Arboria-Black';
    text-align: center;
    padding: 10px 0;
}

.box__item__content {
    align-items: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 40px;
}

.box__item__content .description {
    font-family: 'Arboria-Black';
    text-align: center;
    font-size: 18px;
    padding: 22px;
}

.box__item__content a {
    margin-top: 15px;
}


body .latest-events {
  background: #e1eaf3;
}

body .latest-events time span { 
  display: none;
} 

body .latest-events aside {
  background: #fff;
} 

.cta-static {
  background: #183856;
  margin: 0 0 0 auto;
  width: 75%;
  position: relative;
  top: -82px;
  z-index: 9;
}

@media ( min-width: 980px) and (max-width: 1400px) {
  .cta-static {
    width: 90%;
  }
  .cta-static .left h2 {
    font-size: 38px;
  }
  .cta-static .left .links a {
    font-size: 14px;
  }
}

@media (max-width: 980px) {
  .cta-static .left .links a {
    font-size: 12px;
  } 
}

@media (max-width: 480px) {
  .cta-static {
    width: 100%;
  }
}

.cta-static .absolute-static {
  display: flex;
  justify-content: space-between;
}

.cta-static .left {
  padding: 35px 45px;
  width: 50%;
}

.cta-static .left h2 {
  color: #fff;
  display: inline-block;
  font-family: '';
  font-family: 'Minion Pro';
  font-size: 48px;
}

.cta-static .right {
  width: 50%;
  justify-content: flex-end;
  display: flex;
  align-items: center;
  padding-right: 8%;
}

.cta-static .right a.btn {
    background: #e5cdcc;
    color: #183856;
    font-family: 'Arboria-Black';
    font-size: 19px;
    letter-spacing: 3px;
    font-weight: 300;
    padding: 15px 20px;
}

.cta-static .right a:hover {
  color: #ea4036;
}

.cta-static .left .links {
    display: flex;
    justify-content: space-between;
}

@media (min-width: 980px) {
    .cta-static .left .links {
       width: 90%;
    }
}

.cta-static .left .links a {
   color: #fff;
    font-family: 'Arboria-Black';
    font-size: 16px;
}

.cta-static .left .links a:hover {
   color: #ea4036;
}

.cta-static .left .links i {
       font-size: 14px;
    margin-right: 10px;
    color: rgb(255,255,255,0.4);
}

.outer-video-container {
    position: relative;
}

.inner-video-container .overlay {
    position: absolute;
    width: 100%;
    height: 99%;
    z-index: 1;
    background: rgb(0,0,0,0.3);
}

.trigger_main_video {
    display: flex;
    justify-content: center;
    cursor: pointer;
    align-items: center;
    height: 100%;
}

.scrollable_main_content {
    position: relative;
}

a.scroll_arrow span {
        position: absolute;
    top: 0;
    left: 50%;
    width: 40px;
    height: 40px;
    margin-left: -12px;
    border-left: 2px solid #183856; /*#7e0302;*/
    border-bottom: 2px solid #183856;
    -webkit-transform: rotate(-45deg);
    transform: rotate(-45deg);
    -webkit-animation: sdb04 2s infinite;
    animation: sdb04 2s infinite;
    box-sizing: border-box;
}

a.scroll_arrow span:first-child {
    margin-top: -18px;
}

.news_2023__title {
    text-align: center;
    font-family: 'Arboria-Black';
    font-size: 24px;
    color: #7e0303;
    margin-bottom: 100px;
}

.news_2023 .news__grid__item {
    box-shadow: 2px 8px 8px 0px rgb(0 0 0 / 15%);
   -webkit-box-shadow: 2px 8px 8px 0px rgb(0 0 0 / 15%);
   margin: 0 15px 20px;
}

.news_2023 .news__grid {
    width: 75%;
    margin: 0 auto;
    padding: 0 20px;
}

.news_2023 .slick-prev {
     font-size: 120px;
    color: #7e0302;
    position: absolute;
    left: -20%;
    display: flex;
    height: 100%;
    align-items: center;
    cursor: pointer;
}

.news_2023 .slick-next {
    font-size: 120px;
    color: #7e0302;
    position: absolute;
    right: -20%;
    display: flex;
    height: 100%;
    align-items: center;
    cursor: pointer;
    top: 0;
}

.slick-dots li button {
    font-size: 0;
    line-height: 0;
    display: block;
    width: 20px;
    height: 20px;
    padding: 5px;
    cursor: pointer;
    color: transparent;
    border: 0;
    outline: none;
    background: transparent;
    background: #B3B3B3;
    border-radius: 50%;
}

.slick-dots li button:before {
    font-family: 'slick';
    font-size: 6px;
    line-height: 20px;
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    content: '•';
    text-align: center;
    opacity: .25;
    color: black;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.slick-dots {
    width: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
    text-align: center;
}

.slick-dots li {
    display: inline-block;
    margin-right: 10px;
}

.slick-dots li.slick-active button {
    background: #7e0302;
}

.news_2023 .news__grid__item .thumb , .news_2023 .news__grid__item .thumb img {
  max-height: 220px;
}

.news_2023 .news__grid__item .content {
       padding: 30px 28px;
    position: relative;
}

.news_2023 .news__grid__item .content .title {
    margin-bottom: 22px;
font-size: 1.2em;
    font-family: 'Arboria-Black';
}

.news_2023 .news__grid__item .title a {
    font-family: 'Minion Pro';
    color: #000;
    font-size: 28px
}

.news_2023 .news__grid__item .content .cat {
    font-family: 'Arboria-Black';
    font-size: 15px;
   color: #7e0303;
   margin-bottom: 22px;
}

.news_2023 .news__grid__item .content a.btn {
    display: inline-block;
    font-family: 'Arboria-Black';
   font-size: 0.8em;
    margin-top: 100px;
}

.news_2023 .news__grid__item .content .place {
    display: block;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid #7e0303;
position: absolute;
    bottom: 85px;
    width: 90%;
}


video::-webkit-media-controls {
  display: none;
}
video::-webkit-media-controls-play-button {}

video::-webkit-media-controls-volume-slider {}

video::-webkit-media-controls-mute-button {}

video::-webkit-media-controls-timeline {}

video::-webkit-media-controls-current-time-display {}


.latest-events__grid {
       margin-left: -20px!important;
    margin-right: -20px!important;
    width: calc(100% + 40px);
}

.latest-events {
    padding: 20px 0;
    margin-top: 60px;
}

.latest-events__grid .slick-list {
    padding: 0 70px 0 70px;
}

.latest-events__grid .slick-list .slick-slide {
   position:relative;
   margin: 0 10px;
}
.latest-events__item a {
    width: 100%!important;
}

.latest-events .slick-prev {
    font-size: 52px;
    color: #fff;
    position: absolute;
    left: 15px;
    display: flex;
    align-items: center;
    cursor: pointer;
    top: 2px;
    z-index: 8888;
}

.latest-events .slick-next {
    font-size: 52px;
    color: #fff;
    position: absolute;
    right: 15px;
    display: flex;
    align-items: center;
    cursor: pointer;
    top: 2px;
    z-index: 8888;
}

@media (min-width: 768px) {
.latest-events .slick-next, .latest-events .slick-prev {
    font-size: 58px;
}

.latest-events__grid .slick-list {
    padding: 0 110px;
}
}

.latest-events__item a strong {
     font-family: 'Arboria-Black';
}

.latest-events__item a time {
display: flex;
    justify-content: center;
    flex-direction: column-reverse;
    align-items: center;
    padding: 10px 0;
font-size: 28px;
background: #183856;
}

body .latest-events aside {
    flex: 1 0 100%;
    flex-basis: fit-content;
    display: flex;
    flex-grow: 1;
    align-self: normal;
    flex-direction: column;
    justify-content: center;
word-break: break-word;
    flex-wrap: wrap;
color: #183856;
}

@media (max-width: 768px) {
body .latest-events aside {
     max-width: 250px;
}
}

@media (min-width: 768px) {
body .latest-events aside {
     max-width: 280px;
}
}

.latest-events__item.slick-slide:not(.slick-active) a:after {
    content: " ";
    width: 100%;
    height: 100%;
    z-index: 2;
    background: rgb(0,0,0,0.2);
    position: absolute;
    top: 0;
}

@media (max-width: 768px) {
.outer-video-container {
    margin-left: -20px;
    margin-right: -20px;
}
.cta-static {
       width: 115% !important;
    top: -6px;
    margin-left: -20px;
    margin-right: -20px;
}
.cta-static .left {
     padding: 15px;
    width: 70%;
}
.cta-static .left .links {
    justify-content: flex-start;
margin: 0 -5px;
}

.cta-static .left .links a {
    font-size: 10px;
    margin-right: 10px;
    vertical-align: top;
    display: flex;
}
.cta-static .left h2 {
         font-size: 25px;
}
.cta-static .left .links i {
    margin-right: 2px;
}

.cta-static .right {
    width: 30%;
    padding-right: 0;
    justify-content: flex-start;
}

.cta-static .right a.btn {
     font-size: 11px;
    padding: 10px;
    letter-spacing: 1px;
margin: 0;
    width: 100%;
}

.scrollable_main_content {
    margin-top: 20px;
    padding-bottom: 20px;
}

.trigger_main_video {
    max-width: 30%;
    margin: 0 auto;
}

.panels_2023 .panels__item {
    height: 310px;
}

.panels_2023 .content-bottom {
   flex-direction: column;
}

.panels_2023 .content-bottom a {
    margin-bottom: 15px;
    align-self: auto;
}

.news_2023 .slick-next , .news_2023 .slick-prev {
    display: none!important;
}

.news_2023 .news__grid {
    width: 100%;
}

#sb_instagram {
    margin-top: -100px;
}

}

.featured__grid__item aside {
padding: 20px;
}
.featured__grid__item strong {
display: none;
}
/*
.featured__grid__item aside strong {
    display: block;
    width: 170px;
    max-width: auto;
    margin-bottom: 10px;
    position: relative;
}*/

.article, .main {
  flex-direction: column;
}

rs-layer-wrap a {
   background: #183856!important;
}

rs-layer-wrap a:hover {
  color: #ea4036!important;
}

.banner {
display: none;
}

@media (max-width: 768px) {
.main {
 margin-top: 0;
}
}
</style>
</head>

