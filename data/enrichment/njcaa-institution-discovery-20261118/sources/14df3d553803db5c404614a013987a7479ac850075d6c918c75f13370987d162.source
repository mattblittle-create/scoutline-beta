            <script>var debugMode = false; var defaultView = "upcoming events.replace(/[^A-Za-z0-9]/g, "-")"; function getBlockEvents(data) { return new Promise(function (resolve) { $.each(data, function (i, v) { eventList += eventRefreshHomeHTML(v); }); resolve({ data: data, events: eventList }); }) } function eventRefreshSidebarHTML(v, col) { eventItem = ''; eventItem += '<a class="event-item" href="' + v.url + '">'; eventItem += '<div class="event-date"><span class="event-month">' + moment(v.startDate).format("MMM") + '</span><span class="event-day">' + moment(v.startDate).format("D") + '</span></div>'; eventItem += '<div class="event-details">'; eventItem += '<h3 class="event-title"><span>' + v.title + '</span></h3>'; eventItem += '<p class="event-time">' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd) + '</p>'; eventItem += '</div>'; eventItem += '</a>'; return eventItem; } function eventRefreshHomeHTML(v, col) { eventItem = ''; eventItem += '<div class="small-12 medium-6 large-3 columns event-card">'; eventItem += '<a class="event-item" href="' + v.url + '">'; eventItem += '<div class="event-date">'; eventItem += '<span class="event-month">' + moment(v.startDate).format("MMM") + '</span>'; eventItem += '<span class="event-day">' + moment(v.startDate).format("D") + '</span>'; eventItem += '</div>'; eventItem += '<div class="event-details">'; eventItem += '<h3 class="event-title"><span>' + v.title + '</span></h3>'; eventItem += '<p class="event-time">' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd) + '</p>'; eventItem += '</div>'; eventItem += '</a>'; eventItem += '</div>'; return eventItem; } function eventCustomHTML(v, col) { eventItem = ''; eventItem += '<div class="events columns">'; eventItem += '<div class="date-sec">'; eventItem += '<span>' + moment(v.startDate).format("MMM") + '</span>'; eventItem += '<p>' + moment(v.startDate).format("D") + '</p>'; eventItem += '</div>'; eventItem += '<div class="cal-info">'; eventItem += '<h3>'; eventItem += '<a href="' + v.url + '" target="_parent">'; eventItem += v.title; eventItem += '</a>'; eventItem += '</h3>'; eventItem += '<p>' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd); if (v.location != undefined) { eventItem += ' ' + v.location; } eventItem += '</p>'; eventItem += '</div>'; eventItem += '</div>'; return eventItem; } function eventCustomProgramHTML(v, col) { eventItem = ''; eventItem += '<li><a href="' + v.url + '" target="_parent">'; eventItem += v.title; eventItem += '</a>'; eventItem += ' - ' + moment(v.startDate).format("MMM").toUpperCase() + ' ' + moment(v.startDate).format("D") + ' ' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd); if (v.location != undefined) { eventItem += ' ' + v.location; } eventItem += '</li>'; return eventItem; } function dateOutputCustom(startDateIn, endDateIn, type) { if (moment(startDateIn).isSame(endDateIn, 'day')) { if (type == "full") { var dateOutput = moment(startDateIn).format('MMMM D, YYYY'); } else { var dateOutput = moment(startDateIn).format('MMM D YYYY'); } } else { if (moment(startDateIn).isSame(endDateIn, 'year')) { if (moment(startDateIn).isSame(endDateIn, 'month')) { var dateOutput = moment(startDateIn).format('MMM D') + ' - ' + moment(endDateIn).format('D YYYY'); } else { var dateOutput = moment(startDateIn).format('MMM D') + ' - ' + moment(endDateIn).format('MMM D YYYY'); } } else { var dateOutput = moment(startDateIn).format('MMM D YYYY') + ' - ' + moment(endDateIn).format('MMM D YYYY'); } } return dateOutput; } function imageOutputCustom(image, startDateIn){ if (image) { var imageOuput = '<div class="event-image" style="background-image:url(' + image.url + ');"></div>'; } else { var imageOuput = '<div class="event-image date-img"><div class="month">' + moment(startDateIn).format('MMM') + '</div><div class="day">' + moment(startDateIn).format('D') + '<div class="weekday">' + imgWeekDay(moment(startDateIn).isoWeekday()) + '</div></div></div>'; } return imageOuput; } function timeOutputCustom(startDateIn, endDateIn, allDayIn, originalStart, originalEnd) { if (allDayIn === "true") { var timeOutput = 'All Day'; } else { var timeOutput = ""; var startDateInM = moment(startDateIn); var originalStartM = moment(originalStart); var endDateInM = moment(endDateIn); var originalEndM = moment(originalEnd); var startDateStdOffset; /*Fix to remove daylight savings time*/ if (!moment().isDST()) { if (startDateInM.isSame(originalStartM)) { startDateStdOffset = originalStartM.utcOffset(); } else { startDateStdOffset = startDateInM.utcOffset(); } var endDateStdOffset; if (endDateInM.isSame(originalStartM)) { endDateStdOffset = originalEndM.utcOffset(); } else { endDateStdOffset = endDateInM.utcOffset(); } var startDateInOffsetM = startDateInM.utcOffset(startDateStdOffset); var endDateInOffsetM = endDateInM.utcOffset(endDateStdOffset); } else { var startDateInOffsetM = originalStartM; var endDateInOffsetM = originalEndM; } timeOutput += startDateInOffsetM.format('h'); if (startDateInOffsetM.format('mm') != "00") { timeOutput += startDateInOffsetM.format(':mm'); } if (startDateIn == endDateIn || startDateInOffsetM.format('A') != endDateInOffsetM.format('A')) { timeOutput += startDateInOffsetM.format(' A').replace('AM', 'a.m.').replace('PM', 'p.m.'); } if(startDateIn != endDateIn) { timeOutput += '-'; timeOutput += endDateInOffsetM.format('h'); if (endDateInOffsetM.format('mm') != "00") { timeOutput += endDateInOffsetM.format(':mm'); } timeOutput += endDateInOffsetM.format(' A').replace('AM', 'a.m.').replace('PM', 'p.m.'); } } return timeOutput; } var currentDataURL = "https://www.mchenry.edu/events/_data/current-live.json"; var hhEventsType = "filter"; var hhEventsLimit = 4; var hhEventsWidth = "${hhEventsWidth}"; var hhEvents = []; var filter1Text = [ ]; var filter2Text = [ ]; var filter3Text = [ ]; var filter10Text = [ "yes"]; var filter1 = true; var filter2 = true; var filter3 = true; var filter4 = false; var filter5 = false; var filter6 = false; var filter7 = false; var filter8 = false; var filter9 = false; var filter10 = true; var hhEventsFilterLogic = "Or"; var filterTexts = [ filter1Text,filter2Text,filter3Text,false,false,false,false,false,false,filter10Text ]; var filterTextsAll = _.flatMap(_.compact(filterTexts)); function afterHHEventsLoad(){ $('.hh-events.hh-events-block .event .title').matchHeight(); }</script>        <script src="https://www.mchenry.edu/events/_files/js/hh-events.js"></script>

			
<button type="button" id="report-bug-btn" class="report-bug-btn" aria-label="Report a bug on this page">
  Report a Bug
</button>

<style>
:root {
  /* Easy-tweak knobs — change these, not the JS below.
     Defaults to the site's --red-primary/--white so it matches the refresh
     palette out of the box, but the values are hardcoded here (not var()-linked
     to _refresh/style.css) so this button keeps working even if that stylesheet
     isn't loaded on a given page. */
  --report-bug-bg: #c60f13;
  --report-bug-bg-hover: #9e0c0f;
  --report-bug-text: #ffffff;
  --report-bug-font-size: 0.9rem;
  --report-bug-padding: 0.85rem 0.6rem;
  --report-bug-radius: 6px;
  --report-bug-top: 60%;
  --report-bug-z: 999;
}

.report-bug-btn {
  position: fixed;
  top: var(--report-bug-top);
  right: 0;
  transform: translateY(-50%);
  z-index: var(--report-bug-z);
  background-color: var(--report-bug-bg);
  color: var(--report-bug-text);
  font-size: var(--report-bug-font-size);
  font-family: inherit;
  line-height: 1.2;
  padding: var(--report-bug-padding);
  border: none;
  /* Rounded only on the side facing into the page, so it reads as a tab
     clipped to the edge rather than a floating pill. */
  border-radius: var(--report-bug-radius) 0 0 var(--report-bug-radius);
  cursor: pointer;
  box-shadow: -2px 2px 6px rgba(0, 0, 0, 0.25);
  writing-mode: vertical-rl;
  text-orientation: mixed;
  letter-spacing: 0.02em;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.report-bug-btn:hover {
  background-color: var(--report-bug-bg-hover);
  /* Slide out slightly toward the content on hover — the "peek tray" cue. */
  transform: translateY(-50%) translateX(-4px);
}

.report-bug-btn:focus-visible {
  outline: 3px solid #ffbf47;
  outline-offset: 2px;
  transform: translateY(-50%) translateX(-4px);
}

/* Phones: anchor from the bottom, just above the right-edge stack (chat FAB 56px
   + 12px gap + back-to-top 44px, both in _refresh/style.css / bottom-scripts.vm),
   instead of a % from the top. A % collides with that stack on short screens
   (iPhone SE, 667px tall). Same --chat-fab-bottom fallback chain as .to-top, so
   the tab tracks the stack if the FAB moves. */
@media (max-width: 39.9375em) {
  .report-bug-btn {
    top: auto;
    bottom: calc(var(--chat-fab-bottom, calc(var(--sticky-cta-height, 5rem) + 1rem)) + 56px + 12px + 44px + 16px);
    transform: none;
    font-size: 0.8rem;
    padding: 0.7rem 0.5rem;
  }
  .report-bug-btn:hover,
  .report-bug-btn:focus-visible {
    transform: translateX(-4px);
  }
}
</style>

<script>
(function () {
  "use strict";

  // Base form URL only — no query string here. buildFeedbackUrl() below appends
  // the real page_url/user_agent/screen_size/viewport params via URLSearchParams.
  // Fillout's dashboard shows an example URL with "?page_url=xxxxx&..." placeholders
  // tacked on for reference — don't paste that part; it collides with the params
  // we add below and causes duplicate query keys.
  var FORM_URL = "https://forms.fillout.com/t/r71t8wwmQmus";

  var POPUP_NAME = "reportBugPopup";
  var POPUP_FEATURES = "width=500,height=700,resizable=yes,scrollbars=yes,status=no,toolbar=no,menubar=no,location=no";

  function buildFeedbackUrl() {
    var params = new URLSearchParams();
    params.set("page_url", window.location.href);
    params.set("user_agent", navigator.userAgent);
    params.set("screen_size", screen.width + "x" + screen.height);
    params.set("viewport", window.innerWidth + "x" + window.innerHeight);
    return FORM_URL + "?" + params.toString();
  }

  function openFeedbackForm() {
    var url = buildFeedbackUrl();
    var popup = null;

    try {
      popup = window.open(url, POPUP_NAME, POPUP_FEATURES);
    } catch (e) {
      popup = null;
    }

    if (!popup) {
      window.open(url, "_blank");
      return;
    }

    popup.focus();
  }

  function init() {
    var btn = document.getElementById("report-bug-btn");
    if (!btn) {
      return;
    }
    btn.addEventListener("click", openFeedbackForm);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>


			
   <!-- Google Translate Integration with improved reliability -->
	<script>
		// @ts-nocheck
		var googleTranslateRetryCount = 0;
		var googleTranslateMaxRetries = 3;
		var googleTranslateInitialized = false;

		function googleTranslateElementInit() {
			if (googleTranslateInitialized) return;

			var element = document.getElementById("google_translate_element");
			if (!element) {
				console.warn("Google Translate: Element not found");
				return;
			}

			try {
				new google.translate.TranslateElement(
					{ pageLanguage: "en", includedLanguages: "en,es,pl", autoDisplay: false },
					"google_translate_element",
				);

				googleTranslateInitialized = true;

				// Mark as loaded once widget appears
				function checkLoaded() {
					var translateElements = document.querySelectorAll("#google_translate_element");
					translateElements.forEach(function (el) {
						if (
							el &&
							(el.querySelector(".goog-te-combo") || el.querySelector(".goog-te-gadget"))
						) {
							el.classList.add("loaded");
						}
					});
				}

				// Check at multiple intervals to handle varying load times
				[50, 150, 300, 500, 1000].forEach(function (delay) {
					setTimeout(checkLoaded, delay);
				});
			} catch (e) {
				console.warn("Google Translate initialization error:", e);
			}
		}

		// Load Google Translate script with error handling and retry logic
		function loadGoogleTranslateScript() {
			if (googleTranslateInitialized) return;

			var existingScript = document.getElementById("google-translate-script");
			if (existingScript) {
				existingScript.remove(); // Remove failed script to allow retry
			}

			var script = document.createElement("script");
			script.id = "google-translate-script";
			script.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
			script.async = true;

			script.onerror = function () {
				console.warn(
					"Google Translate script failed to load (attempt " +
						(googleTranslateRetryCount + 1) +
						")",
				);
				if (googleTranslateRetryCount < googleTranslateMaxRetries) {
					googleTranslateRetryCount++;
					// Exponential backoff: 1s, 2s, 4s
					setTimeout(loadGoogleTranslateScript, Math.pow(2, googleTranslateRetryCount) * 1000);
				}
			};

			document.head.appendChild(script);
		}

		// Start loading when DOM is ready
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", loadGoogleTranslateScript);
		} else {
			loadGoogleTranslateScript();
		}
	</script>
	<script>
		// @ts-nocheck
		$(".translation-links a").click(function () {
			var lang = $(this).data("lang");
			var $frame = $(".goog-te-menu-frame:first");
			if (!$frame.size()) {
				alert("Error: Could not find Google translate frame.");
				return false;
			}
			$frame
				.contents()
				.find(".goog-te-menu2-item span.text:contains(" + lang + ")")
				.get(0)
				.click();
			return false;
		});
	</script>
	<script>
		// @ts-nocheck
		jQuery(document).ready(function () {
			if (jQuery("#program-sidebar").length > 0 && jQuery("#program-banner").length > 0) {
				jQuery("#program-sidebar").css("min-height", jQuery("#program-banner").outerHeight());
			}
		});
	</script>
	<script>
		// Back to top: one button injected on every refresh page (styles: .to-top in
		// _refresh/style.css). A page qualifies with 3+ screens of content, footer excluded;
		// the button shows past 1.5 screens of scroll and hides again above 1 screen.
		// Length is re-measured on resize, so opening accordions can switch it on.
		// Opt a page out with class "no-back-to-top" on <body>.
		(function () {
			var MIN_SCREENS = 3;
			var SHOW_AT = 1.5;
			var HIDE_AT = 1;

			function init() {
				if (document.body.classList.contains("no-back-to-top")) return;

				var link = document.createElement("a");
				link.className = "to-top";
				link.href = "#startcontent";
				// The svg carries its own xmlns so it still draws if a page is ever served as
				// XHTML (these templates declare the XHTML namespace).
				link.innerHTML =
					'<span class="to-top__label">Back to top</span>' +
					'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>';
				document.body.appendChild(link);

				var footerMain = document.querySelector(".footer-main");
				var footer = footerMain ? footerMain.closest("footer") : null;
				var eligible = false;
				var shown = false;
				var ticking = false;

				function measure() {
					var footerHeight = footer ? footer.offsetHeight : 0;
					eligible = document.documentElement.scrollHeight - footerHeight >= MIN_SCREENS * window.innerHeight;
				}

				function update() {
					ticking = false;
					var vh = window.innerHeight;
					var y = window.pageYOffset;
					var next = eligible && (shown ? y > HIDE_AT * vh : y > SHOW_AT * vh);
					if (next !== shown) {
						shown = next;
						link.classList.toggle("to-top--visible", shown);
					}
				}

				function schedule() {
					if (!ticking) {
						ticking = true;
						window.requestAnimationFrame(update);
					}
				}

				function remeasure() {
					measure();
					schedule();
				}

				window.addEventListener("scroll", schedule, { passive: true });
				window.addEventListener("resize", remeasure);
				if ("ResizeObserver" in window) {
					new ResizeObserver(remeasure).observe(document.body);
				}

				// Scroll to the very top (header included), then put keyboard focus on the
				// page title so keyboard and screen-reader users land where sighted users look.
				link.addEventListener("click", function (event) {
					event.preventDefault();
					var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
					var target = document.getElementById("startcontent");
					if (target) {
						if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
						target.focus({ preventScroll: true });
					}
				});

				remeasure();
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", init);
			} else {
				init();
			}
		})();
	</script>

		</div>
	</body>
</html>