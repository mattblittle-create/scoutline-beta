            	                                                	<li aria-controls="card-content-jimstockwell-3-2" aria-expanded="false" aria-label="Jim Stockwell, Instructor. Click to expand and read their story." class="spotlight-card" data-spotlight-id="jimstockwell-3-2" tabindex="0">
