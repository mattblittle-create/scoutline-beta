            <ul aria-label="Student and community spotlights" class="spotlights-cards">
                                                                	<li aria-controls="card-content-taiyastewart-3-1" aria-expanded="false" aria-label="Taiya Stewart, Student. Click to expand and read their story." class="spotlight-card" data-spotlight-id="taiyastewart-3-1" tabindex="0">
