      <style>

			#home_slider_vid {
			width: 100%;
			top: -300px;
			position: relative;

			}
			@media (max-width:1195px){	
			#home_slider_vid {
			width: 100%;
			top: -200px;
			position: relative;

			}
			}
			@media (max-width:840px){	
			#home_slider_vid {
			width: 100%;
			top: -100px;
			position: relative;

			}
			}
			@media (max-width:740px){	
			#home_slider_vid {
			width: 100%;
			top: -50px;
			position: relative;

			}
			}
			@media (max-width:620px){	
			#home_slider_vid {
			width: 100%;
			top: -25px;
			position: relative;

			}
			}
			.home_slider_cover {
			height: 25vh;
			object-fit: cover;
			}	

			h2, h2 a, .h2, .h2 a {
			color: #000000;
			font-size: 30px;
			line-height: 38px;
			font-weight: 400;
			text-transform: none;
			}

			p {
			color: white;
			font-size: 15px;
			line-height: 22px;
			font-style: normal;
			font-weight: 400;
			}
			.flex-caption-vid.black {
			background-color: rgba(0, 0, 0, 0.6);
			}
			.flexslider .slides iframe {
			width: 100%;
			height: 31vw !important;
			display: block;
			}

			@media screen and (max-width: 600px) {
			.flexslider .slides li {
			position: relative;
			overflow: hidden;
			}


			.flexslider .slides iframe {
			width: auto;
			height: 66vw !important;
			position: relative;
			left: 50%;
			-webkit-transform: translate(-50%, 0);
			-moz-transform: translate(-50%, 0);
			-ms-transform: translate(-50%, 0);
			-o-transform: translate(-50%, 0);
			transform: translate(-50%, 0);
			}
			}

			.flex-caption-vid {
			width: 100%;
			padding: .4%;
			color: #fff;
			text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.3);
			font-size: 14px;
			line-height: 18px;
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;

			box-sizing: border-box;
			}

			.flex-caption-vid.black {
			background-color: rgba(0, 0, 0, 0.6);
			}



			.flex-caption.black{
			background-color: rgba (0, 0, 0, 0.6);
			display: none;
			}

			@media (max-width: 600px){
			.flex-viewport {
			max-height: 160px;
			}
			.flexslider .slides img {
			width: 100%;

			height:auto !important;
			}
			#home_slider_vid {
			width: 600px;

			overflow: hidden;
			left: -70px;
			top: -40px;
			}

			}
			
			.flexslider.hide-direction-nav .slides > li > a {
			display: block;
			aspect-ratio: 19 / 6;
			overflow: hidden;
			}

			.flexslider.hide-direction-nav .slides > li > a > img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			}
		</style>
      
      
