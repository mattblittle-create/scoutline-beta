    <script data-no-optimize="1" data-no-minify="1">
    (function () {
        // Search & Filter Pro 3.x overrides these globally once the page is translated and swallows
        // any call whose reference node is a <font>, which breaks Google Translate's own restore and
        // freezes the page on the next language switch. Keep the native methods.
        ['insertBefore', 'replaceChild'].forEach(function (m) {
            var d = Object.getOwnPropertyDescriptor(Element.prototype, m) || Object.getOwnPropertyDescriptor(Node.prototype, m);
            if (!d || typeof d.value !== 'function') return;
            var native = d.value;
            Object.defineProperty(Element.prototype, m, { configurable: true, enumerable: d.enumerable, get: function () { return native; }, set: function () {} });
        });

        function waitForGT(cb, tries) {
            if (window.__GT && window.__GT.translator) return cb();
            if ((tries || 0) > 100) return;
            setTimeout(function () { waitForGT(cb, (tries || 0) + 1); }, 100);
        }

        // GTranslate calls __GT before its library has loaded if the visitor picks a language quickly.
        document.addEventListener('DOMContentLoaded', function () {
            var orig = window.doGTranslate;
            if (typeof orig !== 'function') return;
            window.doGTranslate = function () {
                var args = arguments;
                if (!window.gt_translate_script || (window.__GT && window.__GT.translator)) return orig.apply(this, args);
                waitForGT(function () { orig.apply(window, args); });
            };
        });

        // Google Translate does not pick up content inserted later, so re-apply the current language
        // whenever Search & Filter finishes loading new results.
        function retranslate() {
            if (!/\btranslated-(ltr|rtl)\b/.test(document.documentElement.className)) return;
            var l;
            try { l = JSON.parse(localStorage.getItem('__GT_TRANSLATE_LANGS')); } catch (e) {}
            if (!l || !l.srcLang || !l.tgtLang || l.srcLang === l.tgtLang) return;
            waitForGT(function () {
                window.__GT.translator.revert();
                window.__GT.translator.translate(l.srcLang, l.tgtLang);
            });
        }
        var timer;
        var observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
                var m = mutations[i];
                if (m.oldValue && m.oldValue.indexOf('search-filter-query--loading') !== -1 && !m.target.classList.contains('search-filter-query--loading')) {
