<script id="wpconsent-frontend-js-js-extra">
var wpconsent = {"consent_duration":"30","css_url":"https://iowalakes.edu/wp-content/plugins/wpconsent-cookies-banner-privacy-suite/build/frontend.css","css_version":"f4e66e7f66819695cf34","default_allow":"","consent_type":"optin","manual_toggle_services":"","slugs":["essential","statistics","marketing"],"enable_consent_banner":"1","enable_script_blocking":"1","enable_content_blocking":"0","enable_consent_floating":"","enable_shared_consent":"","cookie_domain":"","accept_button_enabled":"1","cancel_button_enabled":"1","preferences_button_enabled":"1","respect_gpc":"","gpc_toast_message":"GPC Signal Honored","gpc_toast_duration":"10000","debug":{"consent_mode_enabled":true,"default_owner":"wpconsent","docs":{"consent_mode":"https://wpconsent.com/docs/google-consent-mode-v2/?utm_source=liteplugin&utm_medium=debug&utm_campaign=consent-mode","gtg":"https://wpconsent.com/docs/troubleshooting-google-tag-gateway-gtg-with-wpconsent/?utm_source=liteplugin&utm_medium=debug&utm_campaign=gtg"},"strings":{"title":"WPConsent Consent Mode debug report","how_to_run":"Run WPConsent.debug() in this console at any time, or load any page with ?wpconsent_consent_debug=1 to see this report again.","consent_mode_enabled":"Google Consent Mode is enabled in WPConsent.","consent_mode_disabled":"Google Consent Mode is disabled in WPConsent. Enable it under WPConsent \u003E Settings in the Google Consent Mode section if you use Google tags.","owner_sitekit":"Site Kit by Google has its own Consent Mode enabled, so WPConsent leaves the default consent state to Site Kit.","owner_none":"No Google service is configured in WPConsent, so WPConsent did not output a default consent state. Add your Google services under WPConsent \u003E Settings \u003E Cookies, or run the scanner, so the default is set before your tags load.","owner_wpconsent":"WPConsent sets the default consent state in the page head.","datalayer_missing":"window.dataLayer does not exist on this page, so no Google tag or consent command has run yet.","default_found":"WPConsent default consent command found in dataLayer at position %s.","default_found_other":"A default consent command from another integration was found in dataLayer at position %s.","default_missing":"No default consent command was found in dataLayer.","head_script_not_run":"The WPConsent consent script did not run in the page head. Check that the theme calls wp_head() and that no optimization plugin delays or removes inline scripts.","developer_id_found":"WPConsent developer ID found in dataLayer at position %s.","developer_id_missing":"WPConsent developer ID was not found in dataLayer.","first_tag_found":"First Google tag activity in dataLayer at position %1$s: %2$s","first_tag_none":"No Google tag activity was found in dataLayer.","scripts_before_none":"No Google tag script was loaded before the WPConsent consent script.","scripts_before_found":"These Google tag scripts were already in the page before the WPConsent consent script ran. Make sure they do not fire before the default consent state is set (the dataLayer order below shows what actually happened):","scripts_now":"Google tag scripts found in the page now:","scripts_now_none":"No Google tag script (gtag.js or gtm.js) was found in the page.","verdict_ok":"OK: the default consent state was set before any Google tag fired.","verdict_late":"LATE: a Google tag fired before the default consent state was set.","verdict_missing":"MISSING: Google tags are running on this page but no default consent state was set.","verdict_no_tags":"No Google tag activity was detected on this page, so there is nothing to check yet. Load a page where your Google tags run and try again.","verdict_disabled":"Google Consent Mode is disabled, so WPConsent is not sending consent signals to Google tags.","late_explanation":"The first hit of a tag that fires before the default consent state is sent without the visitor's consent choice, which Google flags as a late consent implementation. Make sure the tag is loaded after the WPConsent consent script, for example by letting WPConsent block it or by moving the snippet below wp_head().","missing_explanation":"Without a default consent state, Google tags assume consent is granted. Make sure the WPConsent consent script is output in the page head: the theme must call wp_head() and no optimization plugin may delay or remove inline scripts.","gtg_check":"First check whether the tag is served through Google tag gateway, which changes how and from where the tag is loaded. See: %s","consent_mode_docs":"Learn how WPConsent implements Google Consent Mode: %s","tcf_title":"IAB TCF","tcf_disabled":"IAB TCF is not enabled on this site, so no TCF stub is expected.","tcf_api_found":"window.__tcfapi is available (status: %s).","tcf_api_missing":"window.__tcfapi is not available. The TCF stub did not run in the page head.","tcf_stub_before":"The TCF stub was defined before the first Google tag activity.","tcf_stub_after":"The TCF stub was defined after the first Google tag activity, so that tag could not read the TCF signal when it fired.","tcf_stub_not_recorded":"The WPConsent TCF stub did not record when it ran, so its timing could not be checked.","tcf_stub_no_tags":"No Google tag activity was found, so there is nothing to compare the TCF stub timing against.","datalayer_table":"dataLayer entries (Google tag activity and consent commands are marked):","column_position":"Position","column_type":"Type","column_entry":"Entry","type_wpconsent_default":"WPConsent consent default","type_other_default":"Consent default (other)","type_consent_update":"Consent update","type_wpconsent_developer":"WPConsent developer ID","type_google_tag":"Google tag","type_other":"Other"}}};
//# sourceURL=wpconsent-frontend-js-js-extra
</script>
