                  <h1 class="title">Start HERE. Go ANYWHERE.</h1>
                  
                  <p>Your future starts at Garden City Community College, where opportunity, affordability,
                     and personalized support help you succeed.</p>
                  
                  <p>&nbsp;<a class="d-btn btn-primary" style="font-size: 20px; padding: 4px 28px; border-radius: 9999px;" href="/admissions/home.html">Start HERE&nbsp;&nbsp;&nbsp;&nbsp;</a></p>
                  </div>
            </div>
         </section>
         <p><a id="program-finder-main"></a></p>
         
         <section class="program-finder section-padding-sm d-bg-broncbuster-gold">
            <div class="container">
               <div class="row">
                  <div class="col-12 col-lg-10 offset-lg-1">
                     <div class="row program-finder-row">
                        <div class="col-12 col-lg-5 text-center"><img class="program-finder-image" src="/_resources/images/logos/broncbuster-logo.png" alt="Cowboy riding a horse"></div>
                        <div class="col-12 col-lg-7 program-finder-content">
                           <div>
                              
                              <h2 class="title">Discover Your Path</h2>
                              
                              <p>Explore 50+ programs designed to help you reach your goals, build your skills, and
                                 take the next step toward your future.</p>
                              </div>
                           <form action="/academics/programs/index.html" id="programFinderForm" class="select-box"><label for="programFinder" class="sr-only">Choose a Program</label><div class="select-wrapper"><select name="program" id="programFinder">
                                    <option value="placeholder">I am interested in...</option><option value="Agriculture">Agriculture</option><option value="Arts & Communication">Arts & Communication</option><option value="Business & Administration">Business & Administration</option><option value="Fully Online Programs">Fully Online Programs</option><option value="Health Professions">Health Professions</option><option value="Other Educational Opportunities">Other Educational Opportunities</option><option value="STEM">STEM</option><option value="Social Sciences & Education">Social Sciences & Education</option><option value="Trade & Industry">Trade & Industry</option></select></div><button type="submit" class="d-btn btn-primary"><span>Browse Programs</span></button></form><a href="/academics/programs/" class="d-hyperlink hyperlink-arrow-sm">View all Programs</a></div>
                     </div>
                  </div>
               </div>
            </div>
         </section>
         
