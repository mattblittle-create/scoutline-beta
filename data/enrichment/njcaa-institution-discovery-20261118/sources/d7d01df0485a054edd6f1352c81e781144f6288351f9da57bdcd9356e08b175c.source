      		<script>
			document.addEventListener("DOMContentLoaded", function() {
				const today = new Date();
				today.setHours(0, 0, 0, 0);

				const eventCards = document.querySelectorAll(".event-cards-row > div");
				
				eventCards.forEach(cardContainer => {
					const dateSpan = cardContainer.querySelector(".date");
					if (dateSpan) {
						let text = dateSpan.textContent.trim();
						let datePart = text.split('|')[0].trim();
						
						if (!datePart.includes("20")) {
							datePart += ", " + new Date().getFullYear();
						}
						
						const eventDate = new Date(datePart);
						
						if (!isNaN(eventDate)) {
							if (eventDate < today) {
								cardContainer.style.display = "none";
							}
						}
					}
				});
			});
		</script>
      		<script>
			setInterval(function() {
			  var host = document.getElementById('moderncampuspathwayspersonas');
			  if (host) {
			    if (host.shadowRoot) {
			      if (!host.shadowRoot.getElementById('round-fix-v2')) {
			        var s = document.createElement('style');
			        s.id = 'round-fix-v2';
			        s.textContent = '.personas, .personas * { font-family: Montserrat, sans-serif !important; } .grid-item { border-radius: 14px !important; border: 1px solid rgba(78,49,45,0.12) !important; } .title { font-weight: 700 !important; font-size: 18px !important; line-height: 1.3 !important; }';
			        host.shadowRoot.appendChild(s);
			      }
			    }
			  }
			}, 300);
		</script>
      		<script>
			document.addEventListener("DOMContentLoaded", function() {
			  /* Collapse empty anchor paragraph above Program Finder */
			  var anchorP = document.getElementById("program-finder-main");
			  if (anchorP) {
			    if (anchorP.parentNode) {
			      if (anchorP.parentNode.tagName === "P") {
			        anchorP.parentNode.style.margin = "0";
			        anchorP.parentNode.style.padding = "0";
			        anchorP.parentNode.style.height = "0";
			        anchorP.parentNode.style.overflow = "hidden";
			      }
			    }
			  }

			  /* Modern Smooth Scroll-Reveal (IntersectionObserver) for Checkerboard, Fast Facts, and Headings */
			  var revealTargets = document.querySelectorAll("main h2, section:not(.hero-banner):not(.program-finder) .row, section.cta-banner");
			  if ("IntersectionObserver" in window) {
			    var observer = new IntersectionObserver(function(entries) {
			      entries.forEach(function(entry) {
			        if (entry.isIntersecting) {
			          entry.target.classList.add("is-visible");
			          observer.unobserve(entry.target);
			        }
			      });
			    }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });

			    revealTargets.forEach(function(el) {
			      el.classList.add("gccc-reveal");
			      observer.observe(el);
			    });
			  }
			});
		</script>
