            <script>
window.addEventListener("load", function() {
    var checkShadow = setInterval(function() {
        var widgetContainer = document.querySelector('#moderncampuspathwayspersonas');
        
        if (widgetContainer) {
            if (widgetContainer.shadowRoot) {
                if (widgetContainer.shadowRoot.querySelector('.grid-item')) {
                    clearInterval(checkShadow);
                    
                    var shadowStyles = document.createElement('style');
                    shadowStyles.textContent = '.grid-link, .grid-link:hover, .grid-link:focus { text-decoration: none !important; } .grid-item { position: relative; transition: transform 0.2s ease, box-shadow 0.2s ease; } .grid-item:hover { transform: translateY(-3px); box-shadow: 0 6px 12px rgba(0,0,0,0.08); } .grid-link::after { content: \'\'; position: absolute; inset: 0; z-index: 10; }';
                    
                    widgetContainer.shadowRoot.appendChild(shadowStyles);
                }
            }
        }
    }, 150);
});
</script></h1>
         
         <h2 style="text-align: center;">GCCC at a Glance</h2>
         
         <section class="fast-facts section-margin-half">
            <div class="container">
               <div class="fast-facts-row">
                  <div class="fast-fact-card"><span class="number">$7 M+</span><span class="text">Scholarships &amp; Grants Awarded Annually</span></div>
                  <div class="fast-fact-card"><span class="number">25+</span><span class="text">Clubs &amp; Organizations</span></div>
                  <div class="fast-fact-card"><span class="number">16:1</span><span class="text">Student-to-Faculty Ratio</span></div>
                  <div class="fast-fact-card"><span class="number">50+</span><span class="text">Programs &amp; Pathways</span></div>
               </div>
            </div>
         </section>
         
         <h2 style="text-align: center;">Experience GCCC</h2>
         
