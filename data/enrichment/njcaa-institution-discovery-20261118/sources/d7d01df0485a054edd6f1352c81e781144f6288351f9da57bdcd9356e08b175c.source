      <style>
section.hero-banner + p,
p:has(> a#program-finder-main) {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

section.hero-banner .hero-content,
section.hero-banner .hero-banner-content,
section.hero-banner .banner-content,
section.hero-banner .container > div > div {
  border-radius: 14px !important;
  border: 1px solid rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(1px);
  -webkit-backdrop-filter: blur(1px);
}

.gccc-reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}

.gccc-reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .gccc-reveal {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}

section.checkerboard .row > div,
.checkerboard .row > div {
  overflow: hidden;
}

section.checkerboard img,
.checkerboard img {
  transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) !important;
}

section.checkerboard .row:hover img,
.checkerboard .row:hover img {
  transform: scale(1.035);
}

section.program-finder.d-bg-broncbuster-gold {
  background-color: #FFC700 !important;
  background-image: linear-gradient(135deg, #ffd438 0%, #FFC700 55%, #e6b300 100%) !important;
  padding-top: 32px !important;
  padding-bottom: 32px !important;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  position: relative;
  z-index: 1;
}

section.program-finder > .container {
  max-width: 1140px;
  background: transparent !important;
  border-radius: 0 !important;
  padding: 0 20px !important;
  box-shadow: none !important;
  border: none !important;
}

section.program-finder .col-lg-10.offset-lg-1 {
  margin-left: 0 !important;
  width: 100% !important;
}

section.program-finder .program-finder-row {
  align-items: center !important;
}

section.program-finder .program-finder-image {
  max-width: 195px !important;
  margin: 0 auto !important;
  filter: drop-shadow(0 6px 14px rgba(78, 49, 45, 0.18));
}

section.program-finder .program-finder-content {
  align-self: center !important;
  row-gap: 14px !important;
  background: rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 24px 28px !important;
  border-radius: 14px !important;
  border: 1px solid rgba(255, 255, 255, 0.65);
}

section.program-finder .select-box {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 10px !important;
}

section.program-finder .select-wrapper {
  position: relative !important;
  display: block !important;
  width: 100% !important;
  max-width: 280px !important;
  height: auto !important;
  flex: 1 1 240px !important;
  margin: 0 !important;
}

section.program-finder .select-wrapper select {
  height: 38px !important;
  font-size: 14px !important;
  padding: 0 36px 0 16px !important;
}

section.program-finder .select-wrapper::after {
  top: 19px !important; 
  right: 14px !important;
  font-size: 13px !important;
}

section.program-finder .select-box button,
section.program-finder .select-box .d-btn {
  background-color: var(--broncbuster-brown, #4E312D) !important;
  color: #ffffff !important;
  border-radius: 100px !important;
  height: 38px !important; 
  min-height: 0 !important;
  min-width: 0 !important; 
  width: auto !important;
  padding: 0 18px !important;
  font-size: 14px !important;
  font-weight: 600 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;
  border: 2px solid var(--broncbuster-brown, #4E312D) !important;
  opacity: 1 !important;
  margin: 0 !important;
  position: relative !important;
  white-space: nowrap !important;
  flex: 0 0 auto !important;
}

section.program-finder .select-box button::after,
section.program-finder .select-box .d-btn::after {
  position: static !important;
  transform: none !important;
  margin-left: 4px !important;
  font-size: 12px !important;
  right: auto !important;
  top: auto !important;
  display: inline-block !important;
  line-height: 1 !important;
}

section.program-finder a.d-hyperlink {
  font-weight: 700 !important;
  color: var(--broncbuster-brown, #4E312D) !important;
  text-decoration: underline;
  text-underline-offset: 4px;
}

@media (max-width: 991.5px) {
  section.program-finder.d-bg-broncbuster-gold {
    margin-top: 0 !important;
    padding: 16px 12px !important;
  }

  section.program-finder > .container {
    padding: 20px 16px !important;
    border-radius: 16px !important;
  }

  section.program-finder .program-finder-content {
    padding: 20px 18px !important;
  }

  section.program-finder .select-box {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 12px !important;
  }

  section.program-finder .select-wrapper {
    flex: none !important;
    max-width: 100% !important;
    width: 100% !important;
    height: 48px !important;
  }

  section.program-finder .select-box button,
  section.program-finder .select-box .d-btn {
    width: 100% !important;
  }
}
	  @media (max-width: 768px) {
    .fast-facts .fast-facts-row {
      display: flex !important;
      flex-wrap: nowrap !important;
      justify-content: flex-start !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      padding: 8px 16px 18px 16px;
    }

    .fast-facts .fast-fact-card {
      flex: 0 0 72% !important;
      max-width: 250px !important;
      scroll-snap-align: center;
      margin: 0 !important;
      padding: 28px 16px !important;
    }
  }
</style>
      
