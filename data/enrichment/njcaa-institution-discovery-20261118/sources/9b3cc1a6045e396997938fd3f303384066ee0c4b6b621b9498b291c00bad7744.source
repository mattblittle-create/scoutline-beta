<style id="wp-custom-css">
h2 {font-size: 4rem;}
h3 {font-size: 2.2rem; font-weight: 700;}

.accordion-heading {
    font-size: 2rem;
    margin-bottom: 0;
    vertical-align: middle;
	font-weight:600;
}

.accordion-item {
    padding: 1.2rem 0;
}

.wp-block-navigation .current-menu-item a {
    color: #670140 !important; /* Changes active link to burgundy */
    font-weight: 600;
}

.propagate-cards__child:not(.is-horizontal-layout) {
    text-align: left;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}


/* HIDE SUBMIT BUTTON FINANCIAL AID CONTACT FORM */
#gform_submit_button_55 {
    display: none;
}

/* ROUNDED CORNERS  */
.rounded-corners {border-radius: 10px;
overflow: hidden}


/* SECONDARY QUICK-LINKS FOR MAIN NAVIGATION PAGES  */


.quick-links:has(.quick-links-secondary) .quick-links__content {
  padding-left:0!important;
}


.quick-links-secondary .quick-links__child {
  margin-bottom: 0.75em; /* Adjust as needed */
  padding-left: 0 !important;
  margin-left: 0 !important;
}


.quick-links-secondary a{
    font-size: 1.7rem;
	font-weight:500;
	  transition: font-weight 0.3s ease
}


.quick-links-secondary a:hover{

	font-weight:600;
}

/* disables pattern on left  */
.quick-links:has(.quick-links-secondary) .quick-links__pattern {
  display: none !important;
}

/* Styled List Links on Main Navigation pages  */

.links-list {list-style-type: none !important;
padding-left: 0 !important;
}

.links-list li {border-bottom: 0.09375rem solid rgba(200, 200, 200, .5); padding-top:.5em!important;; padding-bottom:.5em!important;

}

.links-list a {text-decoration:none; color: #670140
}

.prop-tabs-block__child.active {
    padding:2em
}


/* POST-PAGES BLOCK - Keep featured images natural dimension  */
.gb-block-post-grid .gb-block-post-grid-image img {
    width: auto;
    height: auto;
    max-width: 100%;
    object-fit: cover;
    display: block;
}


.directory-table td:nth-child(2) {
    font-size: 14px;
	width:25%
}

.department-contact__content {
    background-color: #fff;
    border-radius: 4px;
    padding: 16px;
}

/* LIBRARY CHAT WIDGET */
.lcs_slide_out-r {
    top: 65%!important;
    right: -400px;
}

.post-list .post-item {
    margin-bottom: 50px;
    margin-bottom: 0rem;
}

.program-item .post-item__image {
height:75%;
}

.program-item__title {
    font-weight: bold;
    font-size: 2rem;

}

.wp-block-table th {
    border: 1px solid #000;
    padding: .5em;
	background:#670140;
	color:#fff
}


.featured-events--secondary .event-item__title, .events--list .event-list-item__title {
    font-size: 32px;
    font-size: 2.5rem;
    color: #670140;
    margin: 0 0 16px;
    line-height: 1.2;
}

.accordion-caret {
    color: #6c1d45!important;
}

.accordion-heading {
color: #000;
}


@media (min-width: 769px) {
    .page-header__content h1 {
        font-size: 5rem;
    }
}

.site-header #main-navigation .sub-menu-container {
    background-color: #3d0021;;
}


.site-header ul>li.mega-menu-secondary .sub-menu__menu li a {
    font-size: 2rem; 
}




.site-header ul>li.mega-menu-secondary .sub-menu__menu li a .menu-description {
    padding-top: 10px;
    padding-top: .5rem;
    line-height: 1.3;
}



.wp-block-separator {
    border: none;
    border-top: 1.5px solid #ccc;
margin: 2em 0
}




#gform_submit_button_43 {display:none}

/* Hidden Content */

.hidden-content {
   display:none;
}

/* Masonry Grid */

.is-style-masonry{
   display:block !important;
}

.is-style-masonry .wp-block-image{
   width:100% !important;
   margin-bottom:var(--wp--style--unstable-gallery-gap) !important;
}

.is-style-masonry.columns-1 {
   -webkit-columns: 1; /* Chrome, Safari, Opera */
   -moz-columns: 1; /* Firefox */
   columns: 1; /* Standard syntax */
}

.is-style-masonry.columns-2 {
   -webkit-columns: 2; /* Chrome, Safari, Opera */
   -moz-columns: 2; /* Firefox */
   columns: 2; /* Standard syntax */
}

.is-style-masonry.columns-3 {
   -webkit-columns: 3; /* Chrome, Safari, Opera */
   -moz-columns: 3; /* Firefox */
   columns: 3; /* Standard syntax */
}

.is-style-masonry.columns-4 {
   -webkit-columns: 4; /* Chrome, Safari, Opera */
   -moz-columns: 4; /* Firefox */
   columns: 4; /* Standard syntax */
}

.is-style-masonry.columns-5 {
   -webkit-columns: 5; /* Chrome, Safari, Opera */
   -moz-columns: 5; /* Firefox */
   columns: 5; /* Standard syntax */
}

.is-style-masonry.columns-6 {
   -webkit-columns: 6; /* Chrome, Safari, Opera */
   -moz-columns: 6; /* Firefox */
   columns: 6; /* Standard syntax */
}

.is-style-masonry.columns-7 {
   -webkit-columns: 7; /* Chrome, Safari, Opera */
   -moz-columns: 7; /* Firefox */
   columns: 7; /* Standard syntax */
}

.is-style-masonry.columns-8 {
   -webkit-columns: 8; /* Chrome, Safari, Opera */
   -moz-columns: 8; /* Firefox */
   columns: 8; /* Standard syntax */
}


[class*="botpress--button-container--"] {
		z-index: 99 !important;
}
</style>
