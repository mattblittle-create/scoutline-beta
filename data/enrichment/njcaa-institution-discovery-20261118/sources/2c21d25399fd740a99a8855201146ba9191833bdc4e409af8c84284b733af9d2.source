               <!-- Cards Grid -->
               
               <div class="cards-grid">
                  
                  
                  <div class="card-wrapper" role="group" aria-label="Viewbook in English" tabindex="0" aria-expanded="false">
                     
                     <div class="card-inner" style="justify-self: left">
                        
                        <!-- Front -->
                        
                        <div class="card-front" aria-hidden="false">
                           <img src="/_resources/images/viewbook-in-english.webp" alt="A smiling Trinidad State College student">
                           
                           <div class="card-front-body">
                              
                              <div aria-hidden="true" class="card-badge">TSC</div>
                              
                              <div>
                                 
                                 <h3>Viewbook</h3>
                                 </div>
                              <a href="https://online.fliphtml5.com/aoxbf/xddp/#p=1" target="_blank" rel="noopener noreferrer" class="card-btn" aria-label="Download Viewbook in English (opens in new tab)">
                                 Download Viewbook
                                 </a>
                              </div>
                           </div>
                        
                        <!-- Back — aria-hidden until flipped -->
                        
                        <div class="card-back" aria-hidden="true">
                           
                           <blockquote>
                              "Trinidad State College helped me discover my passion and build
                              the skills I needed for a successful career."
                              </blockquote>
                           <cite>— Current Student</cite>
                           <a href="https://online.fliphtml5.com/aoxbf/xddp/#p=1" target="_blank" rel="noopener noreferrer" class="card-btn" aria-label="Get your Viewbook in English (opens in new tab)">
                              Get Your Viewbook
                              </a>
                           </div>
                        
                        </div>
                     </div>
                  <!-- /English Card -->
                  
                  <!-- ── Spanish Card -->
                  
                  <div class="card-wrapper" role="group" aria-label="Folleto Informativo en Español" tabindex="0" aria-expanded="false">
                     
                     <div class="card-inner" style="justify-self: right;">
                        
                        <!-- Front -->
                        
                        <div class="card-front" aria-hidden="false">
                           <img src="/_resources/images/viewbook-en-espanol.webp" alt="Una estudiante de Trinidad State College sonriendo">
                           
                           <div class="card-front-body">
                              
                              <div aria-hidden="true" class="card-badge">TSC</div>
                              
                              <div>
                                 
                                 <h3>Folleto Informativo</h3>
                                 </div>
                              <a href="https://www.flipsnack.com/trinidadstate1925/tsc-viewbook-spanish.html" target="_blank" rel="noopener noreferrer" class="card-btn" aria-label="Descargar Folleto Informativo en Español (abre en nueva pestaña)">
                                 Descargar Viewbook
                                 </a>
                              </div>
                           </div>
                        
                        <!-- Back — aria-hidden until flipped -->
                        
                        <div class="card-back" aria-hidden="true">
                           
                           <blockquote>
                              "Trinidad State College me ayudó a descubrir mi pasión y
                              desarrollar las habilidades necesarias para una carrera exitosa."
                              </blockquote>
                           <cite>— Estudiante Actual</cite>
                           <a href="https://www.flipsnack.com/trinidadstate1925/tsc-viewbook-spanish.html" target="_blank" rel="noopener noreferrer" class="card-btn" aria-label="Obtén tu Folleto Informativo en Español (abre en nueva pestaña)">
                              Obtén tu Folleto
                              </a>
                           </div>
                        
                        </div>
                     </div>
                  <!-- /Spanish Card -->
                  
                  </div>
               <!-- /cards-grid -->
               
               <!-- Hint text -->
               
               <p class="card-hint">
                  <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                  Hover over cards to see more (or tap on mobile, or press Enter/Space with keyboard)
                  </p>
               
               </div>
            </section>
         
         <script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {

  var cardWrappers = document.querySelectorAll('.card-wrapper');

  cardWrappers.forEach(function (wrapper) {
    var front = wrapper.querySelector('.card-front');
    var back  = wrapper.querySelector('.card-back');
	// Set initial tabindex state — back links hidden from tab order on load
    back.querySelectorAll('a, button').forEach(function(el) { el.setAttribute('tabindex', '-1'); });

    // ── Flip helpers
	function flipOpen() {
      wrapper.classList.add('is-flipped');
      wrapper.setAttribute('aria-expanded', 'true');
      front.setAttribute('aria-hidden', 'true');
      back.setAttribute('aria-hidden', 'false');
      front.querySelectorAll('a, button').forEach(function(el) { el.setAttribute('tabindex', '-1'); });
      back.querySelectorAll('a, button').forEach(function(el) { el.removeAttribute('tabindex'); });
    }

    function flipClose() {
      wrapper.classList.remove('is-flipped');
      wrapper.setAttribute('aria-expanded', 'false');
      front.setAttribute('aria-hidden', 'false');
      back.setAttribute('aria-hidden', 'true');
      front.querySelectorAll('a, button').forEach(function(el) { el.removeAttribute('tabindex'); });
      back.querySelectorAll('a, button').forEach(function(el) { el.setAttribute('tabindex', '-1'); });
    }

    // ── Hover (desktop)
    wrapper.addEventListener('mouseenter', flipOpen);
    wrapper.addEventListener('mouseleave', flipClose);

    // ── Keyboard: Enter or Space flips the card (WCAG 2.1.1)
    wrapper.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault(); // prevent page scroll on Space
        if (wrapper.classList.contains('is-flipped')) {
          flipClose();
        } else {
          flipOpen();
        }
      }
      // Escape always closes
      if (e.key === 'Escape') {
        flipClose();
      }
    });

    // ── Click/tap (mobile) — don't flip when clicking a link
    wrapper.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') return;
      if (wrapper.classList.contains('is-flipped')) {
        flipClose();
      } else {
        flipOpen();
      }
    });
  });

});
</script>
         
         <div class="section bg-gray">
            <div class="container">
               
               <p style="text-align: center;"><i class="fa-solid fa-lightbulb"></i> To view all events, click "Event Type," "All Events."</p>
               
               <omnicms-calendar data-calendar-id="98d6d30f-ac61-4e4f-8169-66b3f87b9221" data-css="/_resources/css/calendar.css" data-featured="true">
                  </omnicms-calendar>
               <script>(function (src) {if (document.querySelector(`script[src="${src}"]`) !== null) return;const s = document.createElement('script');s.async = true;s.src = src;s.id = 'omnicms-calendar';document.getElementsByTagName("head")[0].appendChild(s);})('https://widget.calendar.moderncampus.net/app.js');</script>
               <script>
/*  */
(function () {
  var EXTRA = 16;       /* breathing room below the sticky header, in pixels */
  var FALLBACK = 160;   /* used only if the header can't be found */
  var WINDOW_MS = 5000; /* how long after a click to watch for the widget's scrolls */
  var armedUntil = 0;
  var nativeScrollTo = window.scrollTo;

  function isEventRoute() { return /^#event-details\//.test(window.location.hash); }
  function arm() { armedUntil = Date.now() + WINDOW_MS; }
  function armed() { return Date.now() < armedUntil; }

  function headerOffset() {
    var h = document.querySelector('.siteHeader');
    return (h ? h.offsetHeight : FALLBACK) + EXTRA;
  }

  /* Corrects the widget's two scrolls: skips the jump to the top, offsets the jump back down */
  window.scrollTo = function (a, b) {
    if (armed()) {
      var isObj = (a !== null && typeof a === 'object');
      var y = isObj ? a.top : b;
      if (typeof y === 'number') {
        if (y === 0) return;
        armedUntil = 0;
        var newY = Math.max(0, y - headerOffset());
        if (isObj) return nativeScrollTo.call(window, Object.assign({}, a, { top: newY }));
        return nativeScrollTo.call(window, a, newY);
      }
    }
    return nativeScrollTo.apply(window, arguments);
  };

  /* Clicks inside the featured calendar, including Enter on a focused link */
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (t && t.closest && t.closest('omnicms-calendar[data-featured="true"]')) arm();
  }, true);

  /* Back/forward buttons */
  window.addEventListener('hashchange', function () {
    if (isEventRoute()) arm();
  });

  /* Links that arrive with an event already in the URL, like the slider */
  if (isEventRoute()) arm();
})();
/*  */
</script></div>
         </div>
         
         <div class="section bg-bright-blue-middle">
            <div class="container">
               
               <p>
                  <div class="col-lg-3"><div class="card shadow"><div class="image-overlay"><div class="card-img-top" style="background-image: url(&apos;https://trinidadstate.edu/images/coperr_kitchen_2026.webp&apos;);"></div></div><div class="card-body"><a href="/news/2026/1013.html"><p>Trinidad State College Announces Open House for New COPERR Student-Built Home</p></a></div></div></div><div class="col-lg-3"><div class="card shadow"><div class="image-overlay"><div class="card-img-top" style="background-image: url(&apos;https://trinidadstate.edu/images/logo_ts_color_01.jpg&apos;);"></div></div><div class="card-body"><a href="/news/2026/0812.html"><p>Trinidad State College Receives $125,000 Grant from The Denver Foundation’s Reisher Scholars Program</p></a></div></div></div><div class="col-lg-3"><div class="card shadow"><div class="image-overlay"><div class="card-img-top" style="background-image: url(&apos;/images/logo_cdhe_02.png&apos;);"></div></div><div class="card-body"><a href="/news/2026/0731.html"><p>Return on Higher Education Remains Strong for Colorado Students</p></a></div></div></div><div class="col-lg-3"><div class="card shadow"><div class="image-overlay"><div class="card-img-top" style="background-image: url(&apos;/_resources/images/news_banner_01.jpg&apos;);"></div></div><div class="card-body"><a href="/news/2026/0729.html"><p>Colorado Opportunity Scholarship Initiative Awards $6.8 Million to Support Colorado Students in Pursuing Their Postsecondary Education</p></a></div></div></div> 
                  </p>
               <!-- MODERN CAMPUS NEWS - HORIZONTAL SCROLL WRAPPER -->
               <script>
/*  */
(function() {
    // Only run on homepage - skip on /news/ page
  if (window.location.pathname.includes('/news/')) {
    console.log('Skipping news carousel on news archive page');
    return;
  }
	
  function createHorizontalNews() {
    // Try to find either news structure
    let newsContainer = document.querySelector('.col-md-6.col-lg-7');
    let newsItems = newsContainer ? newsContainer.querySelectorAll('.news-list') : [];

    // If not found, look for the News Feed snippet structure
    if (newsItems.length === 0) {
      const allCards = document.querySelectorAll('.card');

      if (allCards.length > 0) {
        const newsCards = [];
        allCards.forEach(function(card) {
          const hasLink = card.querySelector('a');
          const hasBgImg = card.querySelector('[style*="background-image"]');
          const hasImg = card.querySelector('img');
          const hasCardImgTop = card.querySelector('.card-img-top');

          if (hasLink && (hasBgImg || hasImg || hasCardImgTop)) {
            newsCards.push(card);
          }
        });

        if (newsCards.length > 0) {
          newsContainer = newsCards[0].closest('.row') || newsCards[0].closest('.container') || newsCards[0].parentElement;
          newsItems = newsCards;
        }
      }
    }

    if (!newsContainer || newsItems.length === 0) {
      return false;
    }

    // ── Outer section wrapper
    const wrapper = document.createElement('section');
    wrapper.className = 'newsWrapper';
    // Label the section so screen readers announce it as a landmark
    wrapper.setAttribute('aria-label', 'Trinidad State in the News');

    // ── Header
    const header = document.createElement('div');
    header.className = 'news-header';
    // h2 is appropriate here as a sub-section heading
    header.innerHTML = '<h2>Trinidad State in the News!</h2>'
      + '<a href="/news" class="news-view-all">View All News</a>';

    // ── Live region: announces scroll position changes to screen readers
    const liveRegion = document.createElement('div');
    liveRegion.setAttribute('aria-live', 'polite');
    liveRegion.setAttribute('aria-atomic', 'true');
    liveRegion.className = 'news-sr-only';
    liveRegion.id = 'news-live-region';

    // ── Carousel container
    const container = document.createElement('div');
    container.className = 'news-carousel-container';

    // role="region" + aria-label makes this a named scrollable landmark
    const carousel = document.createElement('div');
    carousel.className = 'news-carousel';
    carousel.setAttribute('role', 'region');
    carousel.setAttribute('aria-label', 'News articles');
    // tabindex="0" so the scroll container itself can receive focus
    // for arrow key scrolling when no card link is focused
    carousel.setAttribute('tabindex', '0');

    const track = document.createElement('div');
    track.className = 'news-track';

    // Build cards
    newsItems.forEach(function(item) {
      const card = createCard(item);
      if (card) track.appendChild(card);
    });

    // ── Nav buttons
    const prev = document.createElement('button');
    prev.type = 'button';
    prev.className = 'news-nav news-nav-prev';
    prev.setAttribute('aria-label', 'Scroll to previous news articles');
    // aria-controls links the button to the scrollable region it controls
    prev.setAttribute('aria-controls', 'news-carousel-track');

    // Use SVG chevrons instead of HTML entities for consistent rendering
    prev.innerHTML = '<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>';

    const next = document.createElement('button');
    next.type = 'button';
    next.className = 'news-nav news-nav-next';
    next.setAttribute('aria-label', 'Scroll to next news articles');
    next.setAttribute('aria-controls', 'news-carousel-track');
    next.innerHTML = '<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>';

    // Give the track an ID so aria-controls can reference it
    track.id = 'news-carousel-track';

    // ── Scroll helper with live region update
    function getCardWidth() {
      var firstCard = track.querySelector('.news-card');
      return firstCard ? firstCard.offsetWidth + 30 : 410; // 30 = gap
    }

    function updateLiveRegion() {
      var cards = track.querySelectorAll('.news-card');
      if (cards.length === 0) return;
      var cardWidth = getCardWidth();
      var scrollLeft = carousel.scrollLeft;
      var visibleWidth = carousel.offsetWidth;
      var firstVisible = Math.round(scrollLeft / cardWidth) + 1;
      var lastVisible = Math.min(
        Math.round((scrollLeft + visibleWidth) / cardWidth),
        cards.length
      );
      liveRegion.textContent = 'Showing articles ' + firstVisible + ' to ' + lastVisible + ' of ' + cards.length;
    }

    prev.addEventListener('click', function() {
      carousel.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
      setTimeout(updateLiveRegion, 600);
    });

    next.addEventListener('click', function() {
      carousel.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
      setTimeout(updateLiveRegion, 600);
    });

    // ── Arrow key navigation on the carousel container (WCAG 2.1.1)
    // This block now actually executes — in the original it was after
    // a return statement and was completely unreachable dead code.
    carousel.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev.click();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        next.click();
      }
    });

    carousel.appendChild(track);
    container.appendChild(prev);
    container.appendChild(carousel);
    container.appendChild(next);
    wrapper.appendChild(header);
    wrapper.appendChild(liveRegion);
    wrapper.appendChild(container);

    newsContainer.parentNode.replaceChild(wrapper, newsContainer);
    return true;
  }

  function createCard(item) {
    let img, link, title, date, desc;

    if (item.classList.contains('news-list') || item.querySelector('.news-list')) {
      img   = item.querySelector('img');
      link  = item.querySelector('a');
      title = item.querySelector('h2');
      date  = item.querySelector('.title-decorative');
      desc  = item.querySelector('p');
    } else if (item.classList.contains('card')) {
      const bgDiv = item.querySelector('.card-img-top, [style*="background-image"]');
      link = item.querySelector('a');
      desc = item.querySelector('p');

      if (bgDiv && bgDiv.style.backgroundImage) {
        const bgUrl = bgDiv.style.backgroundImage.slice(5, -2);
        img = { src: bgUrl, alt: '' };
      } else if (item.querySelector('img')) {
        img = item.querySelector('img');
      }

      if (link) {
        const linkText = link.textContent || link.querySelector('p').textContent;
        title = { innerHTML: linkText, textContent: linkText };
      }
    }

    if (!img || !link) return null;

    const titleText = (title && title.textContent) ? title.textContent.trim() : '';

    // ── Card: article element gives semantic meaning to AT
    // No tabindex on the card itself — focus belongs on the link inside
    const card = document.createElement('article');
    card.className = 'news-card';
    // aria-label on article gives screen readers a concise card name
    if (titleText) card.setAttribute('aria-label', titleText);

    // ── Image: decorative since the title link already describes the article
    const imgWrap = document.createElement('div');
    imgWrap.className = 'news-card-image';
    imgWrap.setAttribute('aria-hidden', 'true'); // whole image wrap is decorative

    const cardImg = document.createElement('img');
    cardImg.src = typeof img.src === 'string' ? img.src : (img.getAttribute ? img.getAttribute('src') : img.src);
    cardImg.alt = ''; // empty alt = decorative; title link conveys the content
    imgWrap.appendChild(cardImg);

    // ── Content
    const content = document.createElement('div');
    content.className = 'news-card-content';

    const cat = document.createElement('div');
    cat.className = 'news-card-category';
    cat.setAttribute('aria-hidden', 'true'); // "News" label is visual chrome, not meaningful
    cat.textContent = 'News';

    const h3 = document.createElement('h3');
    h3.className = 'news-card-title';
    h3.innerHTML = title ? (title.innerHTML || title.textContent) : '';

    // Wrap description in a fixed-height container so the gradient
    // fade sits inside it and the footer stays at a consistent baseline
    const descWrap = document.createElement('div');
    descWrap.className = 'news-card-desc-wrap';

    const p = document.createElement('p');
    p.className = 'news-card-desc';
    if (desc) p.textContent = desc.textContent;
    descWrap.appendChild(p);

    const footer = document.createElement('div');
    footer.className = 'news-card-footer';

    // ── Date: emoji replaced with visually hidden text for screen readers
    const dateDiv = document.createElement('div');
    dateDiv.className = 'news-card-date';
    if (date) {
      // Decorative calendar icon, hidden from AT
      const icon = document.createElement('span');
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = '📅 ';
      // Visually hidden label that screen readers will actually read
      const srDate = document.createElement('span');
      srDate.className = 'news-sr-only';
      srDate.textContent = 'Published: ';
      const dateText = document.createTextNode(date.textContent.trim());
      dateDiv.appendChild(icon);
      dateDiv.appendChild(srDate);
      dateDiv.appendChild(dateText);
    }

    // ── "Read more" link with descriptive aria-label (WCAG 2.4.6)
    const readMore = document.createElement('a');
    readMore.className = 'news-card-link';
    readMore.href = link.href;
    readMore.textContent = 'Read More';
    if (titleText) {
      readMore.setAttribute('aria-label', 'Read more about: ' + titleText);
    }

    footer.appendChild(dateDiv);
    footer.appendChild(readMore);
    // Spacer grows to fill remaining card height, pinning footer to bottom
    const spacer = document.createElement('div');
    spacer.className = 'news-card-spacer';

    content.appendChild(cat);
    content.appendChild(h3);
    content.appendChild(descWrap);
    content.appendChild(spacer);
    content.appendChild(footer);
    card.appendChild(imgWrap);
    card.appendChild(content);

    // ── Hover: CSS handles the transform; JS only needed for image scale
    // since the image is inside a separate div. Reduced-motion is handled
    // in CSS via prefers-reduced-motion.
    card.addEventListener('mouseenter', function() {
      card.classList.add('is-hovered');
    });
    card.addEventListener('mouseleave', function() {
      card.classList.remove('is-hovered');
    });

    return card;
  }

  // Poll for dynamically loaded content
  function tryInitialize() {
    var attempts = 0;
    var maxAttempts = 10;
    var checkInterval = setInterval(function() {
      attempts++;
      var success = createHorizontalNews();
      if (success || attempts >= maxAttempts) {
        clearInterval(checkInterval);
      }
    }, 500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tryInitialize);
  } else {
    tryInitialize();
  }
})();

// ── Inject CSS
var styleSheet = document.createElement('style');
styleSheet.textContent = `

/* Visually hidden utility — readable by screen readers, invisible on screen */
.news-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.newsWrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 40px 20px;
}

.news-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  flex-wrap: wrap;
  gap: 20px;
}

.news-header h2 {
  font-size: 2.5rem;
  color: #ffffff;
  font-weight: 600;
  margin: 0;
}

/* "View All News" button-style link */
.news-view-all,
a.news-view-all:link,
a.news-view-all:visited {
  background: transparent !important;
  color: #ffffff !important;   /* white on dark bg = passes contrast */
  border: 2px solid #ffffff;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none !important;
  transition: background 0.3s;
  display: inline-block;
}

a.news-view-all:hover,
a.news-view-all:focus {
  background: rgba(255, 255, 255, 0.15) !important;
  color: #ffffff !important;
}

/* Focus ring — gold matches TSC brand and is visible on both dark and light bg */
.news-view-all:focus-visible {
  outline: 3px solid #f5c131;
  outline-offset: 3px;
}

.news-carousel-container {
  position: relative;
  padding: 0 50px;
  isolation: isolate;
}

.news-carousel {
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
  padding-bottom: 20px;
  /* Focus ring on the scroll container for arrow key navigation */
  border-radius: 4px;
}

.news-carousel::-webkit-scrollbar {
  display: none;
}

.news-carousel:focus-visible {
  outline: 3px solid #f5c131;
  outline-offset: 3px;
}

.news-track {
  display: flex;
  gap: 30px;
  padding: 10px 0;
}

/* ── Nav buttons */
.news-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 50px;
  height: 50px;
  background: white;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  color: #003763;        /* #003763 on white = ~10:1 */
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s, color 0.3s;
}

.news-nav:hover {
  background: #f5c131;
  color: #003763;        /* #003763 on #f5c131 = ~7:1 */
}

.news-nav:focus-visible {
  outline: 3px solid #f5c131;
  outline-offset: 3px;
}

.news-nav-prev { left:  -20px; }
.news-nav-next { right: -20px; }

/* ── Cards */
.news-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
  flex: 0 0 380px;
  height: 550px;
  display: flex;
  flex-direction: column;
  box-shadow: none;
}

.news-card.is-hovered {
  transform: translateY(-10px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
}

.news-card.is-hovered .news-card-image img {
  transform: scale(1.1);
}

.news-card-image {
  height: 260px;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 0 10px 0px #888888;
}

.news-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
  object-position: 50% 20%;
}

.news-card-content {
  padding: 25px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.news-card-category {
  color: #3C78B3;           /* decorative label, aria-hidden */
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 0;
}

.news-card-title {
  font-size: 1.3rem;
  color: #003763;           /* #003763 on white = ~10:1 */
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 12px;
  /* Fixed height = exactly 2 lines (1.3rem * 1.4 * 2 = 3.64rem).
     This means a 1-line title reserves the same space as a 2-line title,
     so the desc and footer always start at the same vertical position. */
  height: 3.64rem;
  flex-shrink: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-card-desc-wrap {
  /* Fixed height clips the description at the same point on every card.
     flex-shrink:0 means it never collapses on short content. */
  height: 80px;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.news-card-desc-wrap::after {
  /* Gradient fade signals there is more text — transparent top to white bottom */
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 48px;
  background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 100%);
  pointer-events: none;
}

.news-card-desc {
  font-size: 0.95rem;
  color: #333;
  line-height: 1.6;
  margin: 0;
}

/* Spacer between desc and footer — absorbs leftover card height so the
   footer is always pinned to the bottom of the card content area */
.news-card-spacer {
  flex: 1;
}

.news-card-footer {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15px;
  border-top: 2px solid #3C78B3;
}

.news-card-date {
  font-size: 0.85rem;
  color: #595959;           /* same upgrade as desc */
}

/* "Read More" link */
.news-card-link {
  color: #003763;           /* #003763 on white = ~10:1 */
  font-weight: 600;
  text-decoration: none;
}

.news-card-link:hover {
  color: #b8860b;           /* darker gold on white = 4.6:1 (original #f5c131 = only 1.3:1 — fails!) */
  text-decoration: underline;
}

.news-card-link:focus-visible {
  outline: 3px solid #f5c131;
  outline-offset: 2px;
  border-radius: 2px;
}

/* ── Responsive */
@media (max-width: 968px) {
  .news-card {
    flex: 0 0 330px;
    height: 543px;
  }
  .newsWrapper {
    padding: 30px 15px;
  }
  .news-carousel-container {
    padding: 0 40px;
  }
  .news-nav-prev { left:  -10px; }
  .news-nav-next { right: -10px; }
}

@media (max-width: 640px) {
  .newsWrapper { padding: 15px; }
  .news-carousel-container { padding: 0; }
  .news-nav {
    width: 45px;
    height: 45px;
  }
  .news-nav-prev { left:  -8px; }
  .news-nav-next { right: -8px; }
  .news-header { justify-content: center !important; }
  .news-header h2 { font-size: 2rem; text-align: center !important; }
}

/* ── Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .news-carousel {
    scroll-behavior: auto;
  }
  .news-card,
  .news-card-image img,
  .news-nav {
    transition: none;
  }
  .news-card.is-hovered {
    transform: none;
  }
  .news-card.is-hovered .news-card-image img {
    transform: none;
  }
}
`;

document.head.appendChild(styleSheet);
/*  */
</script></div>
         </div>
