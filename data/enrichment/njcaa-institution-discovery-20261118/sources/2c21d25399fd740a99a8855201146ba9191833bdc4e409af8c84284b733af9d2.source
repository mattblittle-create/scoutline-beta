                        <button type="button" class="tsc-tab-btn" role="tab" id="tscTab2" aria-controls="tscSlide2" aria-selected="false" tabindex="-1"><span class="tsc-tab-num" aria-hidden="true">03</span>Scholarships</button>
                        <button type="button" class="tsc-tab-btn" role="tab" id="tscTab3" aria-controls="tscSlide3" aria-selected="false" tabindex="-1"><span class="tsc-tab-num" aria-hidden="true">04</span>Academic Advising</button>
