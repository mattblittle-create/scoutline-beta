                     <div class="tsc-arrows">
                        <button type="button" id="tscPause" class="tsc-arr" aria-label="Pause slideshow"><i class="fa-solid fa-pause" aria-hidden="true"></i></button>
                        <button type="button" id="tscPrev" class="tsc-arr" aria-label="Previous slide"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                        <button type="button" id="tscNext" class="tsc-arr" aria-label="Next slide"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                        </div>
