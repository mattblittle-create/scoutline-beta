.hero-video {
  position: relative;
  overflow: hidden;
  padding-bottom: 38%;
  isolation: isolate;
}
.hero-video::before {
  content: "";
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 4;
  background: linear-gradient(180deg, rgba(0,55,99,1), rgba(60,120,179,0.8));
  clip-path: polygon(0% 0%, 4% 0%, 15% 50%, 4% 100%, 0% 100%, 0% 77%, 6% 50%, 0% 23%);
}
.hero-video::after {
  content: "";
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 4;
  background: linear-gradient(180deg, rgba(0,55,99,.8), rgba(60,120,179,0.8));
  clip-path: polygon(78% 0%, 83% 0%, 93% 50%, 83% 100%, 78% 100%, 88% 50%);
}
.hero-video iframe {
  position: absolute;
  top: -23%;
  left: 0;
  width: 100%;
  height: 150%;
  z-index: 1;
}
/* Poster sits above the video and only fades once Vimeo reports real playback */
.hero-video-poster {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-color: #001830;
  background-image: url('/images/berg_01.jpg');
  background-size: cover;
  background-position: center;
  z-index: 2;
  transition: opacity 0.8s ease;
}
.hero-video-poster.hidden {
  opacity: 0;
  pointer-events: none;
}
.hero-video-btn {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  z-index: 10;
  width: 45px;
  height: 45px;
  background-color: #003763;
  border: 2px solid #ffffff;
  border-radius: 50%;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background-color 0.2s;
}
.hero-video-btn.loaded {
  display: flex;
}
.hero-video-btn:hover { background-color: #3C78B3; }
.hero-video-btn:focus-visible {
  outline: 3px solid #F0BF2E;
  outline-offset: 3px;
}
.hero-video-btn svg { pointer-events: none; }
@media (prefers-reduced-motion: reduce) {
  .hero-video-poster { transition: none; }
  .mc-magic-btn-wrap { animation: none !important; opacity: 1 !important; }
  .mc-magic-btn-wrap .mc-bubble { animation: none !important; }
}
.mc-magic-btn-wrap {
  position: absolute;
  right: 2%;
  top: 50%;
  z-index: 5;
  line-height: 1;
  pointer-events: auto;
  opacity: 0;
  animation: mc-slideUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 8s both;
}
.mc-magic-btn-wrap .mc-btn {
  position: relative;
  padding: 14px 42px;
  font-size: 27px;
  font-weight: bold;
  color: white;
  border: none;
  border-radius: 50px;
  cursor: pointer;
  overflow: hidden;
  background: #003763;
  display: inline-block;
  z-index: 1;
  transition: transform 0.2s ease;
  text-decoration: none;
  white-space: nowrap;
  isolation: isolate;
}
.mc-magic-btn-wrap .mc-btn span {
  position: relative;
  z-index: 4;
}
.mc-magic-btn-wrap .mc-btn:active { transform: scale(0.96); }
.mc-magic-btn-wrap .mc-btn::before {
  content: "";
  background: #003763;
  border-radius: inherit;
  height: calc(100% - 4px);
  width: calc(100% - 4px);
  position: absolute;
  top: 2px; left: 2px;
  z-index: 4;
  opacity: 0;
  transform: scale(0.95);
  transition: all 0.5s ease;
}
.mc-magic-btn-wrap .mc-btn:hover::before {
  opacity: 1;
  transform: scale(1);
}
@keyframes mc-slideUp {
  0%   { opacity: 0; transform: translateY(calc(-50% + 60px)); }
  100% { opacity: 1; transform: translateY(-50%); }
}
.mc-magic-btn-wrap .mc-bubbles {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}
.mc-magic-btn-wrap .mc-bubble {
  position: absolute;
  width: 150px; height: 150px;
  border-radius: 50%;
  filter: blur(10px);
  pointer-events: none;
  will-change: transform;
}
/* Negative delays keep the staggered offsets but let every bubble move right away */
.mc-magic-btn-wrap .mc-bubble-1 { background: #3C78B3; top: -20%; left: -10%; animation: mc-moveUpRight 6s ease-in-out infinite; }
.mc-magic-btn-wrap .mc-bubble-2 { background: #F0BF2E; top: 0%;   left: 10%;  animation: mc-moveDownLeft 5s ease-in-out infinite; animation-delay: -1s; }
.mc-magic-btn-wrap .mc-bubble-3 { background: #F0BF2E; top: 20%;  left: 50%;  animation: mc-moveRight 4s ease-in-out infinite; animation-delay: -2s; }
.mc-magic-btn-wrap .mc-bubble-4 { background: #3C78B3; top: -20%; left: 70%;  animation: mc-moveUpLeft 7s ease-in-out infinite; animation-delay: -3s; }
.mc-magic-btn-wrap .mc-bubble-5 { background: #3C78B3; top: 30%;  left: -10%; animation: mc-moveDownRight 3s ease-in-out infinite; animation-delay: -4s; }
.mc-magic-btn-wrap .mc-bubble-6 { background: #003763; top: -10%; left: 30%;  animation: mc-moveLeft 8s ease-in-out infinite; animation-delay: -0.5s; }
.mc-magic-btn-wrap .mc-bubble-7 { background: #003763; top: 40%;  left: 60%;  animation: mc-moveUp 6s ease-in-out infinite; animation-delay: -1.5s; }
/* Bubbles rest by default; they swirl during the 5-second intro and on hover or keyboard focus */
.mc-magic-btn-wrap .mc-bubble { animation-play-state: paused; }
.mc-magic-btn-wrap.mc-swirl .mc-bubble,
.mc-magic-btn-wrap .mc-btn:hover .mc-bubble,
.mc-magic-btn-wrap .mc-btn:focus-visible .mc-bubble { animation-play-state: running; }
@keyframes mc-moveUpRight {
  0%   { transform: translate(0,0); }        25% { transform: translate(100%,-100%); }
  50%  { transform: translate(-50%,50%); }   75% { transform: translate(50%,-50%); }
  100% { transform: translate(0,0); }
}
@keyframes mc-moveDownLeft {
  0%   { transform: translate(0,0); }        25% { transform: translate(-100%,100%); }
  50%  { transform: translate(50%,-50%); }   75% { transform: translate(-50%,50%); }
  100% { transform: translate(0,0); }
}
@keyframes mc-moveRight {
  0%   { transform: translate(0,0); }        25% { transform: translate(100%,0); }
  50%  { transform: translate(-100%,50%); }  75% { transform: translate(50%,-50%); }
  100% { transform: translate(0,0); }
}
@keyframes mc-moveUpLeft {
  0%   { transform: translate(0,0); }        25% { transform: translate(-100%,-100%); }
  50%  { transform: translate(50%,50%); }    75% { transform: translate(-50%,-50%); }
  100% { transform: translate(0,0); }
}
@keyframes mc-moveDownRight {
  0%   { transform: translate(0,0); }        25% { transform: translate(100%,100%); }
  50%  { transform: translate(-50%,-50%); }  75% { transform: translate(50%,50%); }
  100% { transform: translate(0,0); }
}
@keyframes mc-moveLeft {
  0%   { transform: translate(0,0); }        25% { transform: translate(-100%,0); }
  50%  { transform: translate(100%,-50%); }  75% { transform: translate(-50%,50%); }
  100% { transform: translate(0,0); }
}
@keyframes mc-moveUp {
  0%   { transform: translate(0,0); }        25% { transform: translate(0,-100%); }
  50%  { transform: translate(50%,50%); }    75% { transform: translate(-50%,-50%); }
  100% { transform: translate(0,0); }
}
@media (max-width: 768px) {
  .mc-magic-btn-wrap .mc-btn { font-size: 14px; padding: 12px 20px; }
}
/**/
</style>
         
         
         <div class="hero-video">
            
            <!-- Poster stays visible until the video is actually playing -->
            
            <div class="hero-video-poster" aria-hidden="true"></div>
            
            <!-- Magic Button -->
            
            <div class="mc-magic-btn-wrap">
               <a href="https://trinidadstate.edu/apply/index.html" class="mc-btn">
                  
                  <div class="mc-bubbles" aria-hidden="true">
                     
                     <div class="mc-bubble mc-bubble-1"></div>
                     
                     <div class="mc-bubble mc-bubble-2"></div>
                     
                     <div class="mc-bubble mc-bubble-3"></div>
                     
                     <div class="mc-bubble mc-bubble-4"></div>
                     
                     <div class="mc-bubble mc-bubble-5"></div>
                     
                     <div class="mc-bubble mc-bubble-6"></div>
                     
                     <div class="mc-bubble mc-bubble-7"></div>
                     </div>
                  <span>Apply Now</span>
                  </a>
               </div>
            
            <!-- Play/Pause toggle: starts in the Play state and only switches when Vimeo confirms playback -->
            <button class="hero-video-btn" id="hero-video-btn" type="button" aria-label="Play background video">
               <svg xmlns="http://www.w3.org/2000/svg" id="hero-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true" style="display:none;">
                  
                  <rect x="5" y="3" width="4" height="18" rx="1"/>
                  
                  <rect x="15" y="3" width="4" height="18" rx="1"/>
                  </svg>
               <svg xmlns="http://www.w3.org/2000/svg" id="hero-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                  
                  <polygon points="5,3 21,12 5,21"/>
                  </svg>
               </button>
            
            </div>
         
         <script type="text/javascript">
//
(function () {
  var VIMEO_SRC = 'https://player.vimeo.com/video/1175291668?h=a3d3e14e2b&title=0&byline=0&portrait=0&color=8dc7dc&autoplay=1&muted=1&loop=1&background=1';
  var API_SRC   = 'https://player.vimeo.com/api/player.js';
  var DELAY_MS  = 2000;

  var wrap = document.querySelector('.hero-video');
  if (!wrap) return;

  /* Grab every element up front so nothing is used before it exists */
  var poster    = wrap.querySelector('.hero-video-poster');
  var btn       = document.getElementById('hero-video-btn');
  var iconPause = document.getElementById('hero-icon-pause');
  var iconPlay  = document.getElementById('hero-icon-play');

  var reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  var player  = null;
  var loading = false;

  function setPlayingState(isPlaying) {
    if (!btn) return;
    btn.setAttribute('aria-label', isPlaying ? 'Pause background video' : 'Play background video');
    iconPause.style.display = isPlaying ? '' : 'none';
    iconPlay.style.display  = isPlaying ? 'none' : '';
  }

  function hidePoster() {
    if (poster) poster.classList.add('hidden');
  }

  /* Load Vimeo's official Player API once; if it is blocked, the poster simply stays */
  function loadApi(onReady, onFail) {
    if (window.Vimeo && window.Vimeo.Player) { onReady(); return; }
    var s = document.createElement('script');
    s.src = API_SRC;
    s.async = true;
    s.onload = function () {
      if (window.Vimeo && window.Vimeo.Player) { onReady(); } else { onFail(); }
    };
    s.onerror = onFail;
    document.head.appendChild(s);
  }

  function createPlayer() {
    var iframe = document.createElement('iframe');
    iframe.id = 'hero-vimeo';
    iframe.src = VIMEO_SRC;
    iframe.title = 'Decorative background video';
    iframe.setAttribute('aria-hidden', 'true');
    iframe.setAttribute('tabindex', '-1');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
    wrap.insertBefore(iframe, wrap.firstChild);

    player = new window.Vimeo.Player(iframe);

    /* Button reflects what the player is really doing */
    player.on('play',  function () { setPlayingState(true); });
    player.on('pause', function () { setPlayingState(false); });
    player.on('ended', function () { setPlayingState(false); });

    /* Poster hides only once frames are actually advancing */
    player.on('playing', hidePoster);
    player.on('timeupdate', function (data) {
      if (data && data.seconds > 0) hidePoster();
    });

    return player;
  }

  function showButton() {
    if (btn) btn.classList.add('loaded');
  }

  function hideButton() {
    if (btn) btn.classList.remove('loaded');
  }

  /* Button: ask the player for its real state before toggling */
  if (btn) {
    btn.addEventListener('click', function () {
      if (!player) {
        if (loading) return;
        loading = true;
        loadApi(function () {
          createPlayer();
          player.play().catch(function () {});
        }, function () {
          loading = false;
          hideButton();
        });
        return;
      }
      player.getPaused().then(function (paused) {
        return paused ? player.play() : player.pause();
      }).catch(function () {});
    });
  }

  function start() {
    if (reduceMotion) {
      /* Respect the setting: no autoplay, but offer an opt-in Play button */
      showButton();
      return;
    }
    loading = true;
    loadApi(function () {
      createPlayer();
      player.ready().then(showButton).catch(function () {});
    }, function () {
      loading = false;
    });
  }

  if (document.readyState === 'complete') {
    setTimeout(start, DELAY_MS);
  } else {
    window.addEventListener('load', function () {
      setTimeout(start, DELAY_MS);
    });
  }
}());

/* Apply Now bubbles: swirl for 5 seconds after the button slides in, then rest until hover or focus */
(function () {
  var SWIRL_MS = 5000;
  var btnWrap = document.querySelector('.mc-magic-btn-wrap');
  if (!btnWrap) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var started = false;
  function swirl() {
    if (started) return;
    started = true;
    btnWrap.classList.add('mc-swirl');
    setTimeout(function () {
      btnWrap.classList.remove('mc-swirl');
    }, SWIRL_MS);
  }

  btnWrap.addEventListener('animationend', function (e) {
    if (e.target === btnWrap && e.animationName === 'mc-slideUp') swirl();
  });

  /* Backup in case animationend never fires (slide-up is 8s delay + 0.7s) */
  setTimeout(swirl, 9000);
}());
//
</script>
         <!-- TSC Popup Alert Modal - Global Include -->
         <!-- Remove or disable this asset when construction access changes -->
         
         <style>
  @keyframes tsc-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes tsc-fade-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  @keyframes tsc-slide-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes tsc-slide-down {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(16px); }
  }
  #tsc-construction-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: #00000099;
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  #tsc-construction-overlay.tsc-visible {
    display: flex;
    animation: tsc-fade-in 0.3s ease both;
  }
  #tsc-construction-overlay.tsc-visible #tsc-construction-modal {
    animation: tsc-slide-up 0.35s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }
  #tsc-construction-overlay.tsc-hiding {
    display: flex;
    animation: tsc-fade-out 0.25s ease both;
  }
  #tsc-construction-overlay.tsc-hiding #tsc-construction-modal {
    animation: tsc-slide-down 0.2s ease both;
  }
  #tsc-construction-modal {
    background-color: #003763;
    border-top: 6px solid #F0BF2E;
    border-radius: 6px;
    padding: 28px 32px;
    max-width: 580px;
    width: 100%;
    position: relative;
    box-shadow: 0 8px 40px #00000066;
  }
  #tsc-construction-dismiss {
    position: absolute;
    top: 12px;
    right: 14px;
    background: none;
    border: none;
    cursor: pointer;
    color: #ffffff;
    font-size: 22px;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 4px;
    font-family: var(--tsc-ui);
  }
  #tsc-construction-dismiss:hover {
    background-color: #3C78B3;
  }
  #tsc-construction-dismiss:focus {
    outline: 2px solid #F0BF2E;
    outline-offset: 2px;
  }
  #tsc-construction-img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
    margin: 10px 0 14px 0;
  }
  #tsc-construction-close-btn {
    display: inline-block;
    margin-top: 20px;
    background-color: #F0BF2E;
    color: #003763;
    border: none;
    border-radius: 4px;
    padding: 10px 24px;
    font-size: 15px;
    font-weight: bold;
    font-family: var(--tsc-ui);
    cursor: pointer;
  }
  #tsc-construction-close-btn:hover {
    background-color: #ffffff;
    color: #003763;
  }
  #tsc-construction-close-btn:focus {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }
</style>
         
         
         <div id="tsc-construction-overlay" role="dialog" aria-modal="true" aria-labelledby="tsc-construction-title">
            
            <div id="tsc-construction-modal">
               <button id="tsc-construction-dismiss" aria-label="Dismiss notice">×</button>
               
               <div style="display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                  
                  <div style="flex-shrink: 0; margin-top: 4px;">
                     <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" style="font-size: 30px; color: #F0BF2E;"></i>
                     </div>
                  
                  <div style="flex: 1; min-width: 200px;">
                     
                     <p style="margin: 0 0 4px 0; font-size: 14px; font-weight: bold; letter-spacing: 0.12em; text-transform: uppercase; color: #F0BF2E;">Exciting News for Alamosa</p>
                     <!-- Image: comment out or swap src when reusing for a different announcement -->
                     <img id="tsc-construction-img" src="/images/alamosa_construction.webp" alt="Alamosa Campus construction site">
                     
                     <p id="tsc-construction-title" style="margin: 0 0 12px 0; font-size: 20px; font-weight: bold; color: #ffffff; line-height: 1.3;">Big Things Are Happening at the Alamosa Campus!</p>
                     
                     <p style="margin: 0 0 8px 0; font-size: 15px; color: #ffffff; line-height: 1.6;">We are thrilled to share that the TSC Alamosa Campus is undergoing the <strong>largest renovation in our history</strong> — and we cannot wait for you to see the results. While we build a better campus for
                        our students and community, <strong>campus access is available via Bell Ave only</strong>.</p>
                     
                     <p style="margin: 0; font-size: 15px; color: #F0BF2E; font-weight: bold;">This is a several-months journey toward something amazing. Thank you for your patience
                        and support along the way!</p>
                     <button id="tsc-construction-close-btn">Got It — Let's Go!</button>
                     </div>
                  </div>
               </div>
            </div>
         
         <script>
(function() {
  var STORAGE_KEY = 'tsc_alamosa_construction_dismissed';
  if (localStorage.getItem(STORAGE_KEY)) return;

  var overlay = document.getElementById('tsc-construction-overlay');
  if (overlay.parentElement !== document.body) {
    document.body.appendChild(overlay);
  }
  var dismissBtn = document.getElementById('tsc-construction-dismiss');
  var closeBtn = document.getElementById('tsc-construction-close-btn');

  function dismiss() {
    overlay.classList.remove('tsc-visible');
    overlay.classList.add('tsc-hiding');
    overlay.addEventListener('animationend', function handler() {
      overlay.classList.remove('tsc-hiding');
      overlay.style.display = 'none';
      overlay.setAttribute('aria-hidden', 'true');
      overlay.removeEventListener('animationend', handler);
    });
    localStorage.setItem(STORAGE_KEY, '1');
  }

  overlay.classList.add('tsc-visible');
  overlay.removeAttribute('aria-hidden');
  closeBtn.focus();

  dismissBtn.addEventListener('click', dismiss);
  closeBtn.addEventListener('click', dismiss);

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) dismiss();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') dismiss();
  });
})();
</script>
         
