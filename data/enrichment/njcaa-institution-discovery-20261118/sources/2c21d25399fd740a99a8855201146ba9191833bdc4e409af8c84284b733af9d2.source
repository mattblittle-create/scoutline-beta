<!-- Cookie Consent Banner for Trinidad State -->
<div id="cookie-banner" role="region" aria-label="Cookie consent" style="display: none; position: fixed; bottom: 0; width: 100%; background: #222; color: #fff; padding: 15px; text-align: center; z-index: 9999; font-size: 14px; border-top: 3px solid #F0BF2E;">
    <span>Trinidad State uses cookies to enhance your experience. By continuing to visit this site you agree to our
    <a href="/about/web_policies.html" style="color: #F0BF2E; text-decoration: underline;">Web Policies</a>.</span>
    <button type="button" id="cookie-banner-dismiss" style="margin-left: 20px; background: #F0BF2E; color: #000; border: none; padding: 5px 15px; cursor: pointer; font-weight: bold; border-radius: 3px;">I Understand</button>
</div>
<script>
    (function () {
        function dismissCookieBanner() {
            localStorage.setItem('ts_cookie_consent', 'dismissed');
            var banner = document.getElementById('cookie-banner');
            if (banner) banner.style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', function () {
            var banner = document.getElementById('cookie-banner');
            var btn = document.getElementById('cookie-banner-dismiss');
            if (!banner || !btn) return;
            if (localStorage.getItem('ts_cookie_consent') !== 'dismissed') {
                banner.style.display = 'block';
            }
            btn.addEventListener('click', dismissCookieBanner);
        });
    })();
</script>

<!-- Program Page Curriculum Dropdown Panels -->
<script>
(function () {
  if (!window.cisPanelToggle) {
    function cisPanelToggle(id) { var el = document.getElementById(id); if (el) el.classList.toggle('open'); }
    window.cisPanelToggle = cisPanelToggle;
  }
})();
