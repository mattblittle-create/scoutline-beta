                  <div id="tscProgress" class="tsc-progress" aria-hidden="true"></div>
                  </div>
               
               <script>//
(function () {
  'use strict';

  const AUTOPLAY_MS = 6000; /* milliseconds per slide */

  const slider = document.querySelector('.tsc-slider');
  if (!slider) return;

  const slidesWrap = slider.querySelector('.tsc-slides');
  const slides     = slider.querySelectorAll('.tsc-slide');
  const tablist    = slider.querySelector('.tsc-tab-nav');
  const tabBtns    = slider.querySelectorAll('.tsc-tab-btn');
  const badge      = slider.querySelector('#tscBadge');
  const progress   = slider.querySelector('#tscProgress');
  const pauseBtn   = slider.querySelector('#tscPause');
  const pauseIcon  = pauseBtn.querySelector('i');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let current = 0;
  let rafId = null;
  let startTime = 0;
  let userPaused  = reduceMotion.matches; /* pause button, or reduced-motion preference */
  let hoverPaused = false;
  let focusPaused = false;

  function isPaused() {
    return userPaused || hoverPaused || focusPaused;
  }

  /* Announce slide changes only when the user is in control, not during autoplay */
  function updateLive() {
    slidesWrap.setAttribute('aria-live', isPaused() ? 'polite' : 'off');
  }

  function render() {
    slides.forEach(function (slide, i) {
      const on = i === current;
      slide.classList.toggle('active', on);
      slide.inert = !on; /* hidden slides: links not focusable, content not read */
    });
    tabBtns.forEach(function (btn, i) {
      const on = i === current;
      btn.classList.toggle('active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
      btn.tabIndex = on ? 0 : -1;
    });
    badge.textContent = String(current + 1).padStart(2, '0');
  }

  function goTo(index, moveFocus) {
    current = ((index % slides.length) + slides.length) % slides.length;
    render();
    if (moveFocus) tabBtns[current].focus();
    resetProgress();
  }

  /* Autoplay progress bar */
  function stop() {
    cancelAnimationFrame(rafId);
    rafId = null;
    updateLive();
  }

  function tick(now) {
    const pct = Math.min(((now - startTime) / AUTOPLAY_MS) * 100, 100);
    progress.style.width = pct + '%';
    if (pct < 100) {
      rafId = requestAnimationFrame(tick);
    } else {
      goTo(current + 1, false);
    }
  }

  function resetProgress() {
    cancelAnimationFrame(rafId);
    rafId = null;
    progress.style.transition = 'none';
    progress.style.width = '0%';
    updateLive();
    if (isPaused()) return;
    startTime = performance.now();
    rafId = requestAnimationFrame(tick);
  }

  function resume() {
    if (isPaused()) { updateLive(); } else { resetProgress(); }
  }

  /* Pause / play button */
  function setUserPaused(state) {
    userPaused = state;
    pauseBtn.setAttribute('aria-label', state ? 'Play slideshow' : 'Pause slideshow');
    pauseIcon.className = state ? 'fa-solid fa-play' : 'fa-solid fa-pause';
    if (state) { stop(); } else { resume(); }
  }
  pauseBtn.addEventListener('click', function () { setUserPaused(!userPaused); });

  /* Respect a reduced-motion setting that changes while the page is open */
  reduceMotion.addEventListener('change', function (e) { setUserPaused(e.matches); });

  /* Pause on hover / focus */
  slider.addEventListener('mouseenter', function () { hoverPaused = true; stop(); });
  slider.addEventListener('mouseleave', function () { hoverPaused = false; resume(); });
  slider.addEventListener('focusin', function () { focusPaused = true; stop(); });
  slider.addEventListener('focusout', function (e) {
    /* Only resume when focus actually leaves the slider, not when it moves between buttons */
    if (!slider.contains(e.relatedTarget)) { focusPaused = false; resume(); }
  });

  /* Prev / next */
  slider.querySelector('#tscPrev').addEventListener('click', function () { goTo(current - 1, false); });
  slider.querySelector('#tscNext').addEventListener('click', function () { goTo(current + 1, false); });

  /* Tabs */
  tabBtns.forEach(function (btn, i) {
    btn.addEventListener('click', function () { goTo(i, false); });
  });

  /* Keyboard: arrow keys, Home, End within the tab list */
  tablist.addEventListener('keydown', function (e) {
    let next = null;
    if (e.key === 'ArrowRight') next = current + 1;
    else if (e.key === 'ArrowLeft') next = current - 1;
    else if (e.key === 'Home') next = 0;
    else if (e.key === 'End') next = slides.length - 1;
    if (next === null) return;
    e.preventDefault();
    goTo(next, true);
  });

  /* Touch / swipe (horizontal only, so vertical page scrolling isn't hijacked) */
  let touchX = 0, touchY = 0;
  slider.addEventListener('touchstart', function (e) {
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
  }, { passive: true });
  slider.addEventListener('touchend', function (e) {
    const dx = touchX - e.changedTouches[0].clientX;
    const dy = touchY - e.changedTouches[0].clientY;
    if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy)) {
      goTo(dx > 0 ? current + 1 : current - 1, false);
    }
  });

  /* Boot */
  render();
  setUserPaused(userPaused);
})();
//
</script>
               </div>
         </div>
         <style type="text/css">
.card-flip-container {
  width: 100%;
  height: auto;
  background: linear-gradient(90deg, #003763 0%, #3C78B3 50%, #003763 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 0px;
  font-family: var(--tsc-body);
}

.card-flip-inner {
<!--   max-width: 1200px; -->
  width: 100%;
}

.card-flip-header {
  text-align: center;
  margin-bottom: 50px;
}

.card-flip-header h2 {
  font-size: 2.5rem;
  color: #ffffff;
  margin: 0 0 10px 0;
  font-weight: 600;
}

.card-flip-header p {
  font-size: 1.1rem;
  color: #ffffff;
  margin: 0;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 40px;
  perspective: 1000px;
}

/* ── Card wrapper */
.card-wrapper {
  height: 610px;
  position: relative;
}

.card-inner {
  width: 100%;
  height: 100%;
  max-width: 500px;
  position: relative;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.6s;
  cursor: pointer;
}

/* Flipped state — applied via JS on hover, focus, and click/Enter/Space */
.card-wrapper.is-flipped .card-inner {
  transform: rotateY(180deg);
}

.card-front,
.card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* ── Front face */
.card-front {
  display: flex;
  flex-direction: column;
  background: white;
}

.card-front img {
  height: 72%;
  width: 100%;
  object-fit: cover;
  object-position: center;
}

.card-front-body {
  padding: 30px;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
}

/* TSC badge — aria-hidden so AT doesn't read "T S C" redundantly */
.card-badge {
  position: absolute;
  top: -40px;
  right: 30px;
  background: #F0BF2E;
  width: 80px;
  height: 80px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #000000;
  font-size: 1.5rem;
  box-shadow: 0 4px 15px rgba(244, 179, 36, 0.4);
}

.card-front-body h3 {
  font-size: 1.8rem;
  color: #1a3a52;
  margin: 0 0 10px 0;
  font-weight: 600;
}

/* ── Back face */
.card-back {
  transform: rotateY(180deg);
  background: #f4f4f4;
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.card-back blockquote {
  font-size: 1.1rem;
  font-style: italic;
  margin: 0 0 12px 0;
  line-height: 1.6;
  color: #1a3a52;
  padding: 0;
  border: none;
}

.card-back cite {
  display: block;
  font-size: 0.9rem;
  color: #2c4a60;
  margin: 0 0 30px 0;
  font-style: normal;
}

/* ── Shared button/link styles
   a.card-btn:link and :visited beat Modern Campus global anchor overrides */
a.card-btn,
a.card-btn:link,
a.card-btn:visited {
  background: #003763 !important;
  color: #ffffff !important;
  border: none;
  padding: 15px 30px;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-decoration: none !important;
  display: inline-block;
  text-align: center;
  transition: background 0.3s, transform 0.2s, box-shadow 0.2s;
}

a.card-btn:hover,
a.card-btn:focus {
  background: #3C78B3 !important;
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 5px 20px rgba(26, 58, 82, 0.3);
}

/* Visible focus ring on links */
a.card-btn:focus-visible {
  outline: 3px solid #F0BF2E;
  outline-offset: 3px;
}

/* Focus ring on the card wrapper itself for keyboard flip trigger */
.card-wrapper:focus-visible {
  outline: 3px solid #F0BF2E;
  outline-offset: 4px;
  border-radius: 20px;
}

/* ── Hint text */
.card-hint {
  text-align: center;
  margin-top: 30px;
  color: #f4f4f4;
  font-size: 1rem;
}

/* ── Reduced motion: disable the flip animation entirely. */
@media (prefers-reduced-motion: reduce) {
  .card-inner {
    transition: none !important;
  }
}

/* ── Responsive */
@media (max-width: 768px) {
  .card-flip-container {
    padding: 40px 0;
  }
  .card-flip-header h2 {
    font-size: 2rem;
    padding: 0 15px;
  }
  .card-wrapper {
    height: 470px;
  }
  .card-front-body h3 {
    font-size: 1.5rem;
  }
}
</style>
         
         
         <section class="card-flip-container">
            
            <div class="container card-flip-inner">
               
               <!-- Section Header -->
               
               <div class="card-flip-header">
                  
                  <h2>Discover Trinidad State College</h2>
                  
