                        <button type="button" class="tsc-tab-btn" role="tab" id="tscTab5" aria-controls="tscSlide5" aria-selected="false" tabindex="-1"><span class="tsc-tab-num" aria-hidden="true">06</span>COSI Achieve</button>
                        <button type="button" class="tsc-tab-btn" role="tab" id="tscTab6" aria-controls="tscSlide6" aria-selected="false" tabindex="-1"><span class="tsc-tab-num" aria-hidden="true">07</span>Artist Lecture Series</button>
