<script>
    (function() {
        const observer = new MutationObserver(() => {
            const breadcrumb = document.querySelector('.fusion-breadcrumbs');
            if (!breadcrumb) return;

            const links = breadcrumb.querySelectorAll('a');
            links.forEach(link => {
                if (link.textContent.trim() === 'Pages') {
                    link.textContent = 'Home';
                }
            });

            // Stop observing once we've replaced it
            observer.disconnect();
        });

        observer.observe(document.body, { childList: true, subtree: true });
    })();
    </script><script id="imagesloaded-js" src="https://sunybroome.edu/wp-includes/js/imagesloaded.min.js?ver=5.0.0"></script>
