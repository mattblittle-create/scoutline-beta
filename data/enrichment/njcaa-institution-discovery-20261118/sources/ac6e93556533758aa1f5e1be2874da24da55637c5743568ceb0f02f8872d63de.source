    <script>
                                            function flyins(){
    
                  var fHeight= $('.flyin1').height();
                
                  /* Flyin text */
                  var arrPrograms = ['Healthcare', 'Business &amp; IT', 'Agriculture', 'English, Arts &amp; Humanities', 'Hospitality', 'Industrial Tech', 'Math, Science &amp; More' ];
                  var topInc = (fHeight/arrPrograms.length)-45;
                  var counter = 0;
                  
                  var timer = setInterval(function(){
                    if(counter===0){
                      topInc = topInc/2;
                    }
                
                    $(".flyin1").append("<span class='fly-item val"+counter+"' style='right:-500px;opacity:.3;top:"+topInc+"px;'>"+arrPrograms[counter]+"</span>");
                    topInc=topInc+(fHeight/arrPrograms.length);
                
                    $(".val"+counter).animate({ left:"20%" },700);
                    counter++;
                
                     if (counter === arrPrograms.length) {
                          clearInterval(timer);
                      }
                
                  },300);
                }
            
            
                                    function flyins2(){
                  var fHeight2= $('.flyin2').height();
                  var arrLife = ['50+ Clubs, Organizations, and Groups', 'Events', 'Athletics', 'Rec &amp; Intramurals' ];
                  var topInc2 = (fHeight2/arrLife.length)-45;
                  var counter2 = 0;
                
                  var timer2 = setInterval(function(){
                
                    if(counter2===0){
                      topInc2 = topInc2/2;
                    }
                
                    $(".flyin2").append("<span class='fly-item val2"+counter2+"' style='right:120%;top:"+topInc2+"px;'>"+arrLife[counter2]+"</span>");
                    topInc2=topInc2+(fHeight2/arrLife.length);
                
                
                    $(".val2"+counter2).animate({ right:"20%" },700);
                    counter2++;
                
                     if (counter2 === arrLife.length) {
                          clearInterval(timer2);
                      }
                
                  },300); 
                }
            
            
            </script>
