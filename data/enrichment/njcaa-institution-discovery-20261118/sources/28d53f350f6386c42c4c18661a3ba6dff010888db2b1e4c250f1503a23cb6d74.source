         <section aria-label="student success" class="studentSuccess" style="margin-bottom: 6rem; position: relative; background: url(/_images/info-bg.jpg); background-size: cover">
            		
            <div class="gradientOverlay"></div>
            		
            <div class="studentInfo">
               			
               <h2>Student Success</h2>
               			<span class="studentName">Judea Parks</span>
               			<span class="studentMajor">Major: Automotive technology Graduate</span>
               			
               <div class="studentQuote">
                  				
                  <p>
                     					"My teachers were very understanding. I struggled a little bit with the electrical
                     aspect of cars, but my teachers were there every time I had a question. They were
                     amazing."
                     				</p>
                  			</div>
               			<a href="https://www.arkansasnext.com/article/141342/meet-the-pro-judea-parks-automotive-technician" class="ctaBtn dark">Read More</a>
