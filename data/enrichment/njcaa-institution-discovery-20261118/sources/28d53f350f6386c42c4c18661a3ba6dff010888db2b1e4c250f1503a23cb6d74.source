      <main id="skipToContent" role="main">
         	
         <section aria-label="Page Impact Area" class="impact wrap">
            		
            <div>
               			<!-- NOTE: Video Image and Poster Image are dynamic. -->
               			<picture>
                  				<!-- NOTE: Optional Mobile Image Source -->
                  				
                  				<!-- NOTE: Base Required Image -->
                  				<img width="1920" height="750" src="/_images/impact-images/homepage-banner.jpg" alt="National Park College Student Commons building with a mountain view in the distance.">
                  			</picture>
               			
               <div class="videoTexture">
                  				<video autoplay="" class="defer init" controls="" id="homeVideo" loop="" muted="" playsinline="" poster="/_images/impact-images/homepage-banner.jpg" title="Video Title Example">
                     					<!-- NOTE: Video Source DATA-SRC video is dynamic. -->
                     					
                     <source data-src="/_images/impact-videos/campus-drone.mp4" src="#">
                     					
                     <p>Your browser does not support the HTML5 video</p>
                     				</video>
                  			</div>
               			
               <div class="caption center">
                  				
                  <div class="wrapper">
                     					
                     <div class="captionContent">
                        						<!-- NOTE: Overlay Title, Overlay Subheading, and Link Text are dynamic. -->
                        						<!-- NOTE: If Title is first slide it is H1, and subsequent slides are H2. -->
                        						
                        <h1>There's A Place For <span class="highlight">You</span></h1>
                        						<!-- IF: Overlay Subheading -->
                        						<span class="subtext">at National Park College</span>
                        						<!-- END IF: Overlay Content -->                              
                        					</div>
                     				</div>
                  			</div> 
               		</div>
            		<button id="playButton"><span>Pause Home Video</span></button>
            	</section>
         
         
         	
         <section aria-label="NPC is affordable" class="intro columns">
            		
            <div class="wrapper">
               			
               <div class="two">
                  				
                  <div class="cell">
                     					
                     <div class="headBox">
                        						
                        <h2>Close to home <span class="highlight">about half the cost</span></h2>
                        					</div>
                     					
                     <div class="wysiwygContent">
                        						
                        <p>Attend college in a beautiful resort community in the Ouachita mountains, minutes
                           away from five lakes, unique downtown shopping, and award-winning dining. The Spa
                           City is full of history, outdoor adventures, exciting events, a thriving art community,
                           and local flavor. Once you visit, you will see why more than 35,000 residents love
                           to call Hot Springs home.<br><br>The fourth largest community college in the state, National Park College serves approximately
                           7,000 students per year enrolled in college courses, workforce training, and adult
                           education classes.<br><br>At NPC, you become part of a tight-knit group we call Nighthawk Nation, a place where
                           everyone can receive a supportive college experience at about half the cost of the
                           average university. Read about our <a href="/about/nighthawk-code.aspx">Nighthawk Code</a>.</p>
                        					</div>
                     				</div>
                  				
                  <div class="cell">
                     					<img loading="lazy" alt="state of Arkansas map" src="/_images/ar-map-college-distance.png">
                     				</div>
                  			</div>
               		</div>
            		
            <div class="arrowGraphic">
               			<span>Located in <span class="highlight">Hot Springs, AR</span></span>
               		</div>
            	</section>
          
         
         
         
         	
         <section aria-label="Our Campus your home" class="featured columns">
            		
            <div class="wrapper">
               			
               <div class="headBox centered">
                  				<span class="title">Our Campus <span class="highlight">Your Home</span></span>
                  			</div>
               			
               <div class="three">
                  				
                  <div class="cell">
                     	<img loading="lazy" alt="Person sitting in a library looking at a book and taking notes." src="/_images/home-admissions.png">
                     	
                     <div class="overlay">
                        		<span class="overlayTitle">Admissions</span>
                        		<a href="/admissions-aid/default.aspx" class="ctaBtn dark" title="Learn More">Learn More</a>
                        	</div>
                     	
                     <div class="gradientOverlay"></div>
                     </div>
                  <div class="cell">
                     	<img loading="lazy" alt="NPC's men's basketball player going up for a shot against defenders." src="/_images/home-athletics.png">
                     	
                     <div class="overlay">
                        		<span class="overlayTitle">Athletics</span>
                        		<a href="/student-life-services/athletics/default.aspx" class="ctaBtn dark" title="Learn More">Learn More</a>
                        	</div>
                     	
                     <div class="gradientOverlay"></div>
                     </div>
                  <div class="cell">
