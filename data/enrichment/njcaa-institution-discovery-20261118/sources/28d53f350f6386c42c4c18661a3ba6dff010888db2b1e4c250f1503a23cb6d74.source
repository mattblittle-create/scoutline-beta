                     <div class="overlay">
                        		<span class="overlayTitle">Student Services</span>
                        		<a href="/student-life-services/default.aspx" class="ctaBtn dark" title="Learn More">Learn More</a>
                        	</div>
                     	
                     <div class="gradientOverlay"></div>
                     </div>
                  			</div>
               		</div>
            	</section>
         
          
         
         
         	
         <section aria-label="infographics" class="fullInfographics columns" style="background: url(/_images/info-bg.jpg); background-size: cover">
            		
            <div class="wrapper">
               			
               <div class="three">
                  				
                  <div class="cell">
                     	<img loading="lazy" alt="Icon of people" src="/_images/people-icon.png">
                     	<span class="figure">Over 90%</span>
                     	<span class="blurb">of NPC students receive some type of financial aid</span>
                     	
                     </div>
                  <div class="cell">
                     	<img loading="lazy" alt="Icon of a envelope" src="/_images/email-icon.png">
                     	<span class="figure">$8 Million</span>
                     	<span class="blurb">NPC awards over in grants &amp; scholarships</span>
                     	
                     </div>
                  <div class="cell">
                     	<img loading="lazy" alt="Icon of a garduation cap." src="/_images/school-icon.png">
                     	<span class="figure">$4950</span>
                     	<span class="blurb">NPC Annual Tuition &amp; Fees*</span>
                     	<span class="blurb smallText">*Based on 15 credit hours per semester, in-country tuition and fees for 2024-2025.</span>
                     </div>
                  			</div>
               		</div>
            		
            <div class="colorOverlay"></div>
            		
            <div class="ctaBox">
               			<span>Apply online at</span>
               			<a href="/admissions-aid/financial-aid/scholarships/default.aspx">NP.EDU/SCHOLARSHIPS</a>
               		</div>
            	</section>
          
         
         
         	
         <section aria-label="Programs at NPC" class="academics columns">
            		
            <div class="wrapper">
               			
               <div class="two">
                  				
                  <div class="cell">
                     					
                     <div class="headBox">
                        						
                        <h2>Academic <span class="highlight">Programs</span></h2>
                        					</div>
                     					
                     <div class="wysiwygContent">
                        						
                        <p>From affordable tuition to high-demand skills, NPC provides the tools needed to achieve
                           your potential. We offer two-year degrees and certificates both on campus and online,
                           and bachelor's degrees on campus through a partnership with the University of Arkansas
                           Monticello.</p>
                        					</div>
                     					
                     <div class="searchTitle">Find Your Major at National Park College</div>
                     					
                     <div class="programSearch">
                        						
                        <form onsubmit="programSearch()" id="searchBoxMobile">
                           							<!-- <input name="cx" type="hidden" value="5771a433cf0364b7b">
<input name="ie" type="hidden" value="UTF-8"> -->
