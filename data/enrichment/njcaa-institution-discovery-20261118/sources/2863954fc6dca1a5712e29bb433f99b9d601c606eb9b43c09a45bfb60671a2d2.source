<!-- About Us -->
<section id="about" class="uk-block uk-block-primary">
  <div class="uk-container uk-container-center uk-text-center">
    <h2 style="display: none;">About the College</h2>
    <p class="mission uk-text-contrast">Cecil College is an inclusive, open-access college committed to academic excellence and service to the greater region. The College provides a supportive learning environment to a diverse body of students as they build the skills and knowledge to achieve academic success, prepare to transfer, and enter the workforce. Further, Cecil College fosters intellectual, professional, and personal development through lifelong learning opportunities, the arts, and community engagement.</p>
    <!-- Stats last updated Sep 2022 -->
    <div class="uk-margin-large" data-uk-slideset="{small: 2, medium: 2, large: 3, animation: 'slide-horizontal'}">
      <div class="uk-slidenav-position">
        <a href="" class="uk-slidenav uk-slidenav-previous" data-uk-slideset-item="previous" role="button" aria-label="Previous slideset"></a>
        <ul class="uk-grid uk-slideset uk-text-center uk-text-contrast uk-text-uppercase">
          <li><span class="number" style="padding: 0 25px;">98%</span> of students surveyed would recommend Cecil College</li>
          <li><span class="number">13:1</span> student to faculty ratio<br>&nbsp;</li>
          <li><span class="number">20+</span> clubs and sports teams<br>&nbsp;</li>
          <li><span class="number">75+</span> degree and certificate programs<br>&nbsp;</li>
          <li><span class="number">2,200+</span> credit students annually<br>&nbsp;</li>
          <li><span class="number">3,100+</span> non-credit students annually<br>&nbsp;</li>
          <li><span class="number">295</span> associate degrees awarded in 2025<br>&nbsp;</li>
          <li><span class="number">43</span> certificates awarded in 2025<br>&nbsp;</li>
          <li><span class="number">63%</span> PAR student graduation/transfer rate<br>&nbsp;</li>
        </ul>
        <a href="" class="uk-slidenav uk-slidenav-next" data-uk-slideset-item="next" role="button" aria-label="Next slideset"></a>
      </div>
      <ul class="uk-slideset-nav uk-dotnav uk-flex-center uk-margin-top" aria-hidden="true"></ul>
    </div>
    <div class="uk-text-center uk-margin-large-top">
      <a class="uk-button cc-button-primary uk-text-uppercase" href="/about-us">Learn more about us</a>
    </div>
  </div>
</section>

