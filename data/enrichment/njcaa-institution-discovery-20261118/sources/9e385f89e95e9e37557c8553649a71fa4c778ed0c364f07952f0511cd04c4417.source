         <script>
             $(document).ready(function() {
                 $(".cms-slideshow").each(function(index,element) {
                     var $cmsSlideshow = $(this);

                     

                    $cmsSlideshow.find(".slick-prev").on("click",function(e) {
                         $cmsSlideshow.slick("prev");
                    })
     
                    $cmsSlideshow.find(".slick-next").on("click",function(e) {
                         $cmsSlideshow.slick("next");
                    })

                     
                         var animateCaption = function($caption,delay,animation) {
                              $caption.hide();
                              setTimeout(function(e) {    
                                   $caption.addClass("animated "+animation+"").show();
                              },delay);
                         }

                         $cmsSlideshow.on("init", function(e, slick, currentSlide, nextSlide) {
                              var $caption = $cmsSlideshow.find(".slick-active .caption[data-animation]"),
                                   delay = $caption.data("delay") * 1000,
                                   animation = $caption.data("animation");

                              animateCaption($caption,delay,animation);
                         }).on("beforeChange", function(e, slick, currentSlide, nextSlide) {
                              var $caption = $cmsSlideshow.find('.item[data-slick-index="' + nextSlide + '"]').find(".caption[data-animation]"),
                                   delay = $caption.data("delay") * 1000,
                                   animation = $caption.data("animation");

                              animateCaption($caption,delay,animation);
                         })
                        
                 })
                 
             });
         </script>
     
