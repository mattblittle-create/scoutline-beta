<script>
document.addEventListener('DOMContentLoaded', () => {
document.querySelectorAll('a[href="#menu-paying for college"]').forEach(link => {
const newUrl = 'https://mgccc.edu/paying-for-college/';
// Update href
link.setAttribute('href', newUrl);
// Override any preventDefault behavior
link.addEventListener('click', function (e) {
e.stopImmediatePropagation(); // stops other handlers
window.location.href = newUrl;
});
});
});
</script><style id="wp-custom-css">
/* Header Adjustment*/
.site-header {
	padding-top: 0px !important;
}

body.logged-in .site-header {
  padding-top: 32px !important;
}

/* Fix local anchors menu issue */
html {scroll-padding-top: 100px;}

/* Remove FormStack Badge */
[class^="StyledReferralBadge"]{display:none;}

/* Ensure -> does not wrap  on Quick Links */
.btn--link:after{display:inline}

.hide, .comment {display:none;}

.nowrap, a[href^="tel:"] {white-space: nowrap;}

.nc-sara-box {
padding: 10px;
background-color: whitesmoke;
font-size:85%;	
}


/* Remove unsuspend transients link */
li#wp-admin-bar-tm-suspend {
    display: none;
}

/* Remove Programs filter from site search */
li.filter__item--block > button.btn.btn--transparent:disabled {
    display: none;
}
</style>
