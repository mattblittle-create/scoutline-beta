<div class="featured-boxes">
  <div class="featured-boxes__grid">

          <div class="featured-boxes__box" data-animation="fade-in-up" data-animate="true">
        <div class="featured-boxes__title">
          Free Community College for Adult Learners        </div>
        <div class="featured-boxes__description">
          SUNY Reconnect provides full funding for a range of job-ready programs.
        </div>
         
        <div class="featured-boxes__link">
          <a href="https://www.columbiagreene.edu/suny-reconnect/" class="button-cta button-cta--blue">Learn More</a>
        </div>
              </div>
          <div class="featured-boxes__box" data-animation="fade-in-up" data-animate="true">
        <div class="featured-boxes__title">
          Start College This January        </div>
        <div class="featured-boxes__description">
          Make your next move at Columbia-Greene. Explore your options at an information session, visit campus, or attend an Instant Decision Day for help with admissions, financial aid, and registration.        </div>
         
        <div class="featured-boxes__link">
          <a href="https://www.columbiagreene.edu/admissions/visit/" class="button-cta button-cta--blue">Learn More</a>
        </div>
              </div>
          <div class="featured-boxes__box" data-animation="fade-in-up" data-animate="true">
        <div class="featured-boxes__title">
          SUNY ASAP Pays You to Graduate        </div>
        <div class="featured-boxes__description">
          ASAP gives eligible full-time students a monthly stipend, textbook assistance, and dedicated advising to help you graduate faster — on top of your financial aid.        </div>
         
        <div class="featured-boxes__link">
          <a href="https://www.columbiagreene.edu/cgcc-asap/" class="button-cta button-cta--blue">Learn More</a>
        </div>
              </div>
      </div>

</div>
			  <div class="feature-front">
    <div class="feature-front__content">
      <div class="feature-front__copy" data-animation="slide-left-fade" data-animate="true">
        <p>From <a href="/academics/programs/automotive-technology/">Automotive Technology</a> to <a href="https://www.columbiagreene.edu/academics/programs/environmental-studies/">Environmental Biology</a>, our programs serve all types of students in Columbia and Greene Counties — and beyond!</p>
      </div>
      <div class="feature-front__buttons" data-animation="slide-right-fade" data-animate="true">
                  <a href="/academics/programs/" class="button button--blue">All Degrees and Programs</a>
                  <a href="https://www.columbiagreene.edu/academics/continuing-education/" class="button button--blue">Continuing Education Classes</a>
                  <a href="https://www.columbiagreene.edu/academics/faculty/" class="button button--blue">Meet Our Faculty</a>
              </div>
    </div>
  </div>
						    
    <div class="numbers" style="background-image: url( https://www.columbiagreene.edu/wp-content/uploads/2023/01/CGCC-Landscapes-3-of-3-2_1600x800-1600x800.jpg );" data-animation="background-zoom" data-animate="true">
        <div class="numbers__content">
            <div class="numbers__heading" data-animation="fade-in-up" data-animate="true">
                Columbia-Greene By the Numbers            </div>
            <div class="numbers__grid">
                  
                                    <div class="numbers__block" data-animation="fade-in-up" data-animate="true">
                                    
                        <div class="numbers__stat">15</div>
                        <div class="numbers__title">Average Class Size</div>
                        <div class="numbers__description">
                            Small classes provide the opportunity to know your professors and classmates and receive the personal attention you need to thrive.
                        </div>
                    </div>
                  
                                    <div class="numbers__block" data-animation="fade-in-up" data-animate="true">
                                    
                        <div class="numbers__stat">78%</div>
                        <div class="numbers__title">Students Receiving Financial Aid</div>
                        <div class="numbers__description">
                            Columbia-Greene offers both need- and merit-based financial assistance in the form of grants, scholarships, loans, and more.                        </div>
                    </div>
                  
                                    <div class="numbers__block" data-animation="fade-in-up" data-animate="true">
                                    
                        <div class="numbers__stat">10+</div>
                        <div class="numbers__title">Clubs &amp; Activities</div>
                        <div class="numbers__description">
                            From intramural flag football to gaming, students will find an array of clubs and organizations that reflect their interests.
                        </div>
                    </div>
                            </div>
        </div>
    </div>

