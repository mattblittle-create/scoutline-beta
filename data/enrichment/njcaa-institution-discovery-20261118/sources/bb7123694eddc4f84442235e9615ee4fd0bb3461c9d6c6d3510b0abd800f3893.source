<div id="main">
      <div class="carousel__wrapper home-hero">

    <div class="carousel" data-animation="fade-in-up" data-animate="true" data-speed="3" data-initial-index="0">
              <div class="carousel__item hero hero--featured" style="background-image: url( https://www.columbiagreene.edu/wp-content/uploads/2026/10/Header_InstantDecisionDay1600x800-copy.jpg );" data-animation="background-zoom" data-animate="true">
                    <div class="hero__container">
