body.cacc-dark-mode :is(.bg-yellow,.bg-light-yellow,.bg-warning) :is(h1,h2,h3,h4,h5,h6,.h1,.h2,.h3,.h4,.h5,.h6,p,li,a:not(.btn),.text-white,.text-blue,.text-dark-blue),
