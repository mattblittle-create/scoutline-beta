body.cacc-dark-mode .form-control,
body.cacc-dark-mode .custom-select,
body.cacc-dark-mode textarea,
body.cacc-dark-mode select,
body.cacc-dark-mode input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="hidden"]) { background-color:var(--cacc-panel)!important;color:var(--cacc-text)!important;border-color:var(--cacc-border)!important; }
