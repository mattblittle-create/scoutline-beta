    }
}

/* Additional refinements for very small screens */
@media (max-width: 480px) {
    .quote-column {
        width: 95%;
        padding: 20px;
    }

    .quotes {
        font-size: 0.8rem !important;
        line-height: 1.5 !important;
    }

    .fancy-text {
