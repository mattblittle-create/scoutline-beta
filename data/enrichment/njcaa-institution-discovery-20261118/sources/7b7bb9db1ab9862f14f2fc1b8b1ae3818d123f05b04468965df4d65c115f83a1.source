    }

    .glow {
        font-size: 1.1rem !important;
    }
	#loopVideo{
		border-radius: 0px;
	}
}

/* Dedicated relative wrapper pinned tight to the video dimensions */
.statue-video-wrapper {
    position: relative;
    width: 100%;
    display: block;
}

/* Video is a block element that sizes to its own aspect ratio,
   so the wrapper hugs the actual video and the toggle sits on it */
.statue-video-wrapper #loopVideo {
    display: block;
    width: 100%;
    height: auto;
}

/* WCAG 2.2.2 Pause Control Styling */
.statue-video-toggle {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background-color: #003a5d;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

.statue-video-toggle:hover {
    background-color: rgba(0, 0, 0, 0.70);
}

/* WCAG 2.4.7 — Visible focus indicator */
.statue-video-toggle:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
}

.statue-video-toggle:active {
    transform: scale(0.93);
}

.statue-video-toggle img {
    width: 1.75rem;
    height: 1.75rem;
    pointer-events: none;
    display: block;
}
</style>
               
               
