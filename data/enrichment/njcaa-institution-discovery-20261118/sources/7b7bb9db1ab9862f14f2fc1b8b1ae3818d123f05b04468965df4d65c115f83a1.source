               <style>
  @media (max-width: 768px) {
    #prevFactPage, #nextFactPage {
      display: none;
    }
  }

.button-navy, .button-gold{
 min-width: unset !important;
}
</style>
               
               <div class="card-body" style="display: block; padding-top: 30px;">
                  <center>
                     
                     <h2 style="color: #003a5d; text-align: center;">The VU Advantage: National Excellence, Local Value</h2>
                     </center>
                  
                  <div class="side-button-container" style="display: flex; align-items: center; justify-content: space-between;"><button id="prevFactPage" class="button-navy" style="float: left; margin: auto; font-weight: bold; font-size: larger;">&lt;</button>
                     
                     <div id="factsContainer" class="factcard-container"></div>
                     <button id="nextFactPage" class="button-gold" style="float: right; margin: auto; font-weight: bold; font-size: larger;">&gt;</button></div>
                  <script>
//
/* CDATA Block begins here. This tells the XML parser to ignore the JavaScript content. */
               document.addEventListener('DOMContentLoaded', () => {
            const factsContainer = document.getElementById('factsContainer');
            const prevButton = document.getElementById('prevFactPage');
            const nextButton = document.getElementById('nextFactPage');
            
            let currentPage = 0;
            let cardsPerPage = 4; // Default number of cards per page
            let allPages = []; // Array to hold all dynamically generated pages

            // --- Fact Data from iykyk-test.txt ---
            const allFactsData = [
                { align: 'left', color: 'pink', title: 'Largest Collaborative Robotics (COBOT) Training Program in the USA', text: 'VU leads the nation in collaborative robot (cobot) training, preparing students for cutting-edge careers in automation and advanced manufacturing.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Vincennes-University-Technology-Center-Largest-cobot-training-program-in-the-USA.jpg', alt: 'Students work with a cobot stacking blocks' },
                { align: 'right', color: 'teal', title: 'VU RN to BSN Online Program Nationally Ranks Among Best in Nation &amp; Most Affordable by Forbes ', text: 'VU\'s RN to BSN online program earns recognition for excellence setting students on a path to rewarding healthcare careers.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Ranked-best-in-nation-and-most-afordable-by-forbes.jpg', alt: 'Nursing students at a networking event' },
                { align: 'left', color: 'orange', title: '#1 Homeland Security Bachelor’s Program in the Nation', text: 'Intelligent.com names VU\'s Homeland Security &amp; Public Safety program the best in the country, showcasing its top-tier education and career readiness.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Top%20Homeland%20Security%20Bachelors%20Program%20in%20the%20Nation.jpg', alt: 'Students attend a threat simulation event' },
                { align: 'right', color: 'blue', title: 'Best Value Living &amp; Learning Community in Indiana', text: 'Experience the perfect blend of academic and residential life at VU, offering affordable, high-quality housing and a thriving learning environment.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Best-value-in-living-and-learning.jpg', alt: 'Students play at the pool' },
                
                { align: 'right', color: 'orange', title: 'Named Top 150 Colleges in USA by Aspen Institute', text: 'A testament to VU’s commitment to student success and equity in education, recognized as one of the nation’s best community colleges.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Named-top-150-colleges-in-USA-by-Aspen-Institute.jpg', alt: 'Female student excited for graduation' },
                { align: 'left', color: 'blue', title: 'NJCAA CHAMPIONS', text: 'VU’s championship legacy shines with top performances and national titles in NJCAA athletics.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/NJCAA%20Champions.jpg', alt: 'Vincennes University cheerleader' },
                { align: 'right', color: 'lime', title: 'VU Grads Rank Higher Nationally in Job Placement and Job Satisfaction - Gallup Survey', text: 'Gallup confirms VU graduates excel in job placement and report exceptional career satisfaction.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/VU%20Grads%20Rank%20Higher%20Nationally.jpg', alt: 'Culinary students work with a piping bag' },
                { align: 'left', color: 'pink', title: 'Indiana’s First College and One of America’s Most Historically Significant Universities', text: 'As Indiana’s first university, VU remains a cornerstone of academic excellence and tradition.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/One%20of%20Americas%20Most%20Historically%20Significant%20Universities.jpg', alt: 'French Quarter, Vincennes University\'s historic replica apartments' },
                
                { align: 'left', color: 'purple', title: 'Awarded for Excellence by Indiana Department of Education in Career and Technical Education (CTE)', text: 'A leader in CTE, VU empowers students with the skills they need to thrive in today’s job market.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Awarded%20for%20Excellence%20by%20Indiana%20Department%20of%20Education%20in%20Career%20and%20Technical%20Education.jpg', alt: 'Students laughing and looking back at graduation.' },
                { align: 'right', color: 'teal', title: '200+ Acre Campus Pulsing with Student Activities', text: 'From academics to extracurriculars, VU’s vibrant campus offers endless opportunities for engagement.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/200%20Acre%20Campus%20Pulsing%20with%20Student%20Activities.jpg', alt: 'Students playing a ball game' },
                { align: 'left', color: 'pink', title: 'Recognized by Indiana Commission for Higher Ed. for Innovative Approaches to Improving Student Outcomes', text: 'VU’s groundbreaking strategies in higher ed. continue to make an impact on student success.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Higher%20Education%20Praises%20Innovation.jpg', alt: 'Students intently focused on the team submission at a robotics competition.' },
                { align: 'right', color: 'orange', title: 'Small Class Sizes (16-1) Focus on Hands-On Learning', text: 'VU delivers personalized education with a hands-on approach, ensuring every student thrives.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Focus%20on%20Hands-On%20Learning.jpg', alt: 'Students and family members celebrate at graduation' },
                
                { align: 'right', color: 'orange', title: 'Ranked Best in the Nation for Homeland Security and Public Safety by Intelligent.com', text: 'VU’s Homeland Security program stands out as the top choice for students aiming to protect communities nationwide.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Ranked%20Best%20in%20the%20Nation%20for%20Homeland%20Security%20and%20Public%20Safety%20by%20Intelligent.jpg', alt: 'Students work in a forensics lab' },
                { align: 'left', color: 'blue', title: 'John Deere Program Awarded for Excellence by Indiana Career and Technical Education Program', text: 'VU’s John Deere program receives top honors for preparing students for high-demand careers in agriculture.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/John%20Deere%20Program%20Awarded%20for%20Excellence%20by%20Indiana%20Career%20and%20Technical%20Education%20Program.jpg', alt: '5 students work around and on a large John Deere combine' },
                { align: 'right', color: 'purple', title: 'Indiana Department of Education Award for Excellence for Nursing Program', text: 'Recognized for its exceptional training and clinical experience, VU Nursing continues to excel in healthcare education.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Indiana%20Department%20of%20Education%20Award%20for%20Excellence%20for%20Nursing%20Program.jpg', alt: 'Students and family members celebrate at graduation' },
                { align: 'left', color: 'lime', title: 'Indiana Governor’s Workforce Cabinet Lauds VU CTE Programs', text: 'VU is recognized for outstanding career and technical education programs, vital to Indiana’s workforce development.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Workforce%20Cabinet%20Lauds%20VU%20CTE%20Programs.jpg', alt: 'A team of students at the robotics scrimmage competition' },

                { align: 'left', color: 'orange', title: 'National Award for Educational Leadership from Jobs for America’s Graduates (JAG)', text: 'VU leads the way in preparing students for success, earning top honors for educational leadership and innovation.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/National%20Award%20for%20Educational%20Leadership%20from%20Jobs%20for%20Americas%20Graduates.jpg', alt: 'Students and family members celebrate at graduation' },
                { align: 'right', color: 'blue', title: 'Higher Learning Commission Accreditation: A Mark of Quality', text: 'Maintaining accreditation through the Higher Learning Commission, VU affirms its commitment to high standards and continuous improvement.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/A%20Mark%20of%20Quality.jpg', alt: 'A student uses a virtual reality headset' },
                { align: 'left', color: 'lime', title: 'Phi Theta Kappa Recognizes Academic Excellence', text: 'VU and its chapters earn top awards from Phi Theta Kappa Honor Society, celebrating student achievement at two-year colleges.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Phi%20Theta%20Kappa%20Recognizes%20Academic%20Excellence.jpg', alt: 'Students sing on stage at a choral concert' },
                { align: 'right', color: 'pink', title: 'Indiana Commission for Higher Education Praises Innovation', text: 'VU earns recognition for innovative strategies that enhance student outcomes and elevate higher education in Indiana.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Recognized%20by%20Indiana%20Commission%20for%20Higher%20Education%20for%20Innovative%20Approaches.jpg', alt: 'A male graduate smiles broadly with his two sisters' },
                
                { align: 'right', color: 'teal', title: 'Founded by US President William Henry Harrison', text: 'A historic legacy, Vincennes University was founded by the ninth U.S. President, shaping American education since 1801.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Founded%20by%20US%20President%20William%20Henry%20Harrison.jpg', alt: 'Learn in order to serve mural' },
                { align: 'left', color: 'purple', title: 'Nationally Ranked as a Top Military Friendly School by VIQTORY', text: 'Recognized for exceptional commitment to creating opportunities for military students and their families.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Nationally%20Ranked%20as%20a%20Top%20Military%20Friendly%20School%20by%20VIQTORY.jpg', alt: 'Cadets on stage at graduation performing the Honor Guard' },
                { align: 'right', color: 'lime', title: 'Agribusiness Program Awarded for Excellence by Indiana Career and Technical Education Program', text: 'VU’s Agribusiness program leads the way in equipping students for success in the agriculture industry.', image: 'https://www.vinu.edu/_resources/images/degree-and-program-images/bps/Vincennes-University-Agribusiness-Plant-Nursery.jpg', alt: 'Students tending to plants in VU Nursery' },
                { align: 'left', color: 'blue', title: 'Featured in \'Best for Vets\' Colleges for Dedication to Military-Affiliated Students', text: 'VU’s tailored support for military students secures its place as a top institution for veterans.', image: 'https://www.vinu.edu/_resources/images/campus-activity-photos/vincennes/Recognized%20as%20Best%20for%20Vets.jpg', alt: '4 students in uniform stand with their commander' }
            ];

            // --- Core Functions ---

            // Function to randomly shuffle the facts
            function shuffleArray(array) {
                for (let i = array.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [array[i], array[j]] = [array[j], array[i]];
                }
            }

            // Function to render the HTML for one set of cards (one "page")
            function createFactSection(cards) {
                const sectionDiv = document.createElement('div');
                sectionDiv.classList.add('fact-section');
                
                cards.forEach(cardData => {
                    const cardDiv = document.createElement('div');
                    cardDiv.classList.add(`factcard-${cardData.align}`, `factcard-${cardData.color}`);
                    cardDiv.innerHTML = `
                        <div class="factcard-image">
                            <img src="${cardData.image}" alt="${cardData.alt}" loading="lazy" />
                        </div>
                        <div class="factcard-text">
                            <p class="title"><strong>${cardData.title}</strong></p>
                            <p>${cardData.text}</p>
                        </div>
                    `;
                    sectionDiv.appendChild(cardDiv);
                });
                return sectionDiv;
            }

            // Function to determine cards per page and generate all pages
            function initializeLayout() {
                const width = factsContainer.clientWidth;
                
                if (width > 3600) {
                    cardsPerPage = 12;
                } else if (width > 1920) {
                    cardsPerPage = 8;
                } else if (width > 1200) {
                    cardsPerPage = 6;
                } else if (width > 768) {
                    cardsPerPage = 4;
                } else {
                    cardsPerPage = 2; // Show 2 cards on mobile/small screens
                }

                // 1. Shuffle all facts globally
                //shuffleArray(allFactsData);
                
                // 2. Clear existing content and pages
                factsContainer.innerHTML = '';
                allPages = [];

                // Separate data into Left and Right sets to ensure we always have pairs
    const leftCards = allFactsData.filter(f => f.align === 'left');
				const rightCards = allFactsData.filter(f => f.align === 'right');
				const totalPairsAvailable = Math.min(leftCards.length, rightCards.length);

				// Pick a random starting point for the pairs
				let pairIndex = Math.floor(Math.random() * totalPairsAvailable);

				// Create pages
				const totalPages = Math.ceil(totalPairsAvailable / (cardsPerPage / 2));

				for (let p = 0; p < totalPages; p++) {
					let pageData = [];
					const pairsNeededForThisPage = cardsPerPage / 2;

					for (let i = 0; i < pairsNeededForThisPage; i++) {
						// Use modulo (%) to loop back to the start of the array if we run out
						let currentIdx = (pairIndex + i) % totalPairsAvailable;
						pageData.push(leftCards[currentIdx]);
						pageData.push(rightCards[currentIdx]);
					}

					const pageElement = createFactSection(pageData);
					allPages.push(pageElement);
					factsContainer.appendChild(pageElement);
					
					// Advance the pair index for the next page
					pairIndex = (pairIndex + pairsNeededForThisPage) % totalPairsAvailable;
				}
                
                // 4. Reset to the first page and update visibility
                currentPage = 0;
                showCurrentPage();
            }

            // Function to handle showing the correct page
            function showCurrentPage() {
                // Hide all sections
                allPages.forEach(page => page.style.display = 'none');

                // Show the current section
                if (allPages[currentPage]) {
                    allPages[currentPage].style.display = 'grid';
                }
                
                // Disable/Enable buttons as needed
                prevButton.disabled = currentPage === 0;
                nextButton.disabled = currentPage === allPages.length - 1;
            }

            // --- Event Handlers ---
            prevButton.addEventListener('click', () => {
                if (currentPage > 0) {
                    currentPage--;
                    showCurrentPage();
                }
            });

            nextButton.addEventListener('click', () => {
                if (currentPage < allPages.length - 1) {
                    currentPage++;
                    showCurrentPage();
                }
            });
            
            // Re-initialize layout on resize
            window.addEventListener('resize', initializeLayout);

            // Initial setup
            initializeLayout();
        });
		/* End CDATA Block */
//
    </script>
                  </div>
               
