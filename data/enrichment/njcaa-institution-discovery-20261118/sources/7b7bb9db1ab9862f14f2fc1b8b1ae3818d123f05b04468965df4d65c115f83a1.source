               <style>
.form-container {
    background-color: #96CDEA; /* Light blue background */
    padding: 20px;
    text-align: center;
}

.button-navy, .button-gold{
 min-width: unset !important;
}

/* Search Label */
.light {
    font-size: 2rem;
	font-family: "HelveticaNeue", Arial, Helvetica, sans-serif;
    font-weight: bold !important;
    color: #003a5d; 
    display: block;
    margin-bottom: 10px;
}


.searchbar__input-wrapper {
    position: relative; /* Ensure relative positioning for child elements */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80%;
    max-width: 600px;
	margin-bottom: 20px;
}

/* Input Field */
.search-input {
    width: 100%; /* Make it fill the wrapper */
    padding: 12px;
    padding-right: 50px; /* Ensure space for the button */
    border: none;
    border-radius: 5px;
    font-size: 1rem;
}

/* Search Button */
.search-submit {
    position: absolute;
    right: 5px; /* Stick to the right */
    top: 50%;
    transform: translateY(-50%); /* Center it vertically */
    width: 40px; /* Adjust size */
    height: 40px;
    border: none;
    background: url('/_resources/images/icons/search-new-sm-gray.png') no-repeat center center;
    background-size: contain;
    cursor: pointer;
    text-indent: -9999px; /* Hide text */
    overflow: hidden;
}

/* Responsive adjustments */
@media (max-width: 600px) {
    .searchbar__input-wrapper {
        width: 90%; /* Ensure full width on smaller screens */
    }
    
    .search-submit {
        width: 35px;
        height: 35px;
        right: 10px;
    }
}

/* Button Styling */
.explore__buttons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); /* Responsive columns */
    gap: 0px;
    grid-auto-rows: minmax(80px, auto);
    justify-content: center; /* Center the grid */
	justify-items: center;
    align-items: center; /* Align items within the grid */
    width: 100%; /* Ensure it spans full width */
    max-width: 450px; /* Limit max width */
    margin: 0 auto; /* Center it within its parent */
}

.button {
        color: #fff !important;
        background-color: #003a5d;
        background-image: linear-gradient(to bottom right, #0069A7 49.5%, #003a5d 50%);
        background-position: bottom right;
        background-size: 200% 200%;
        border-top: 1px solid #97D700;
        border-left: 1px solid #97D700;
        border-right: 1px solid #1e0f33;
        border-bottom: 2px solid #1e0f33;
		border-radius: 5px;
        text-shadow: none;
        transition: background-position 0.2s;
	width: 200px;
	height: 60px;
	display: flex;
	align-items: center;
	justify-content: center;
}

    .button-navy:hover,
    .button-navy:focus {
    	background-position: top left;
    }
    
    .button-navy:active {
    	background-color: #ffd100;
    }
    
    .button-navy:active {
    	background-color: #003a5d;
    }

.program-container {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    margin: 0;
    padding: 0;
    background-color: #003A5D;
}

.image-container {
    width: 100%;
    height: 600px;
}

.image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.form-container {
    width: 100%;
    height: 600px;
    margin: 0;
    padding: 0;
}

@media (min-width: 1235px) {
    .image-container {
        width: 66.666%;
		height: 600px;
    }
    
    .form-container {
        width: 33.334%;
		height: 600px;
    }
}

@media (max-width: 1400px) and (min-width: 1235px){
	.explore__buttons{
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-top: 5px;
	}
}
@media (min-width: 769px) and (max-width: 1234px){
	.image-container {
        height: 525px;
    }
    
    .form-container {
        height: 550px;
    }
}


