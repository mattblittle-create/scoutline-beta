               <script>
document.addEventListener("DOMContentLoaded", () => {
    // Define the background color pairs and corresponding image mappings
    const colorMappings = [
        {
            visit: "#AA004F", quote: "#b9d65e",
            arrows: "yellow", stars: "navy"
        },
        {
            visit: "#6BC4E8", quote: "AA004F",
            arrows: "lime", stars: "yellow"
        },
        {
            visit: "#97D700", quote: "#FFD100",
            arrows: "white", stars: "navy"
        },
        {
            visit: "#FFD100", quote: "#003A5D",
            arrows: "white", stars: "yellow"
        }
    ];

    // Select a random color mapping
    const randomMapping = colorMappings[Math.floor(Math.random() * colorMappings.length)];

    // Get the elements
    const visitElement = document.querySelector(".visit-item2");
    const quoteElement = document.querySelector(".large-visit-item");

    // Apply the background colors
    if (visitElement) {
        visitElement.style.backgroundColor = randomMapping.visit;
    }

    if (quoteElement) {
        quoteElement.style.backgroundColor = randomMapping.quote;
    }

    // Define the quotes
    const quotesWithAuthors = [
     	{
		quote: "Vincennes University provides a supportive and inviting environment for students, featuring accessible faculty and a variety of academic programs.",
		author: "- Freshman 2024"
		},
		{
		quote: "The campus boasts modern facilities and numerous extracurricular activities that enrich the college experience.",
		author: "- Freshman 2024"
		},
		{
		quote: "Students value the focus on hands-on learning and career preparation, which enhances job readiness after graduation.",
		author: "- Freshman 2024"
		},
		{
		quote: "The strong sense of community also helps students build lasting friendships, contributing to a positive overall experience.", 
		author: "- Freshman 2024"
		},
		{
		quote: "All the staff and professors are very helpful. The aviation building is very impressive and they have a lot of up to date equipment to learn on.",
		author: "- Freshman 2024"
		},
		{
		quote: "The best school a student could imagine going to. Great community and always a fun year at Vincennes University.",
		author: "- Junior 2024"
		},
		{
		quote: "I am currently taking dual credit courses through VU while in high school. My experience with this University has been accommodating and an easy process.",
		author: "- Dual Credit Student 2024"
		},
		{
		quote: "I hope to continue my education at VU after graduating high school,",
		author: "- Dual Credit Student 2024"
		}		
    ];

    // Select a random quote
    const randomQuoteWithAuthor = quotesWithAuthors[Math.floor(Math.random() * quotesWithAuthors.length)];

    // Get the quote element
    const quoteTextElement = document.querySelector(".large-visit-item h3");
	const authorTextElement = document.querySelector(".large-visit-item h2");
	
    // Set the random quote
    if (quoteTextElement) {
        quoteTextElement.textContent = randomQuoteWithAuthor.quote;
    }
	
	if (authorTextElement) {
        authorTextElement.textContent = randomQuoteWithAuthor.author;
    }

    // Update arrow and star images based on the color mapping
    const arrowElements = document.querySelectorAll(".arrow");
    const starElements = document.querySelectorAll(".sm-star, .lg-star, .sm-squat-star, .lg-squat-star, .sm-btm-star");

    arrowElements.forEach(arrow => {
        if (arrow.classList.contains("arrow-left")) {
            // Set left arrow image
            arrow.src = `/_resources/images/general-website-images/visit-tour-png/left-${randomMapping.arrows}-curly-arrow.png`;
            arrow.alt = `Left ${randomMapping.arrows} Curly Arrow`;
        } else if (arrow.classList.contains("arrow-right")) {
            // Set right arrow image
            arrow.src = `/_resources/images/general-website-images/visit-tour-png/right-${randomMapping.arrows}-curly-arrow.png`;
            arrow.alt = `Right ${randomMapping.arrows} Curly Arrow`;
        }
    });

    starElements.forEach(star => {
        if (star.classList.contains("sm-star")) {
            star.src = `/_resources/images/general-website-images/visit-tour-png/sm-${randomMapping.stars}-star.png`;
            star.alt = `Small ${randomMapping.stars} Star`;
        } else if (star.classList.contains("sm-squat-star")) {
            star.src = `/_resources/images/general-website-images/visit-tour-png/sm-${randomMapping.stars}-squaty-star.png`;
            star.alt = `Small ${randomMapping.stars} Squaty Star`;
        } else if (star.classList.contains("lg-star")) {
            star.src = `/_resources/images/general-website-images/visit-tour-png/lg-${randomMapping.stars}-star.png`;
            star.alt = `Large ${randomMapping.stars} Star`;
        } else if (star.classList.contains("lg-squat-star")) {
            star.src = `/_resources/images/general-website-images/visit-tour-png/lg-${randomMapping.stars}-squaty-star.png`;
            star.alt = `Large ${randomMapping.stars} Squaty Star`;
        } else if (star.classList.contains("sm-btm-star")) {
            star.src = `/_resources/images/general-website-images/visit-tour-png/sm-${randomMapping.stars}-star-btm.png`;
            star.alt = `Small ${randomMapping.stars} Star`;
        }
    });
    // Update text color if stars are navy
    if (randomMapping.stars === "navy") {
        const textElements = document.querySelectorAll(".large-visit-item h3, .large-visit-item h2");
        textElements.forEach(element => {
            element.style.color = "#003A5D";
        });
    }
});

</script>
               
               
