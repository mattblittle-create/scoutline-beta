                  <p class="visually-hidden" id="hero-video-desc">
                     								A video is playing that shows all of the activities and classrooms
                     								at Vincennes University, Indiana's lowest cost residential college.
                     							</p><button id="hero-video-toggle" class="hero-video-toggle" aria-controls="hero-video-ada" type="button" aria-label="Pause background video" aria-pressed="false"><img id="icon-pause" src="/_resources/images/icons/pause-wabash.png" alt="" aria-hidden="true" width="28" height="28"><img id="icon-play" src="/_resources/images/icons/play-wabash.png" alt="" aria-hidden="true" width="28" height="28" style="display:none;"></button></div>
            </div><script>
				var images = [
				'https://www.vinu.edu/_resources/images/home-page-heroes/Vincennes-University-Centered-Video-Screencap-V2-min.jpg',
				'https://www.vinu.edu/_resources/images/home-page-heroes/Vincennes-University-Centered-Video-Screencap-V1-min.jpg',
				'https://www.vinu.edu/_resources/images/home-page-heroes/Vincennes-University-Centered-Video-Screencap-V3-min.jpg',
				'https://www.vinu.edu/_resources/images/home-page-heroes/Vincennes-University-Centered-Video-Screencap-V5-min.jpg',
				'https://www.vinu.edu/_resources/images/home-page-heroes/Vincennes-University-Centered-Video-Screencap-V4-min.jpg'
				];

				function getRandomImage() {
				return images[Math.floor(Math.random() * images.length)];
				}

				function displayRandomImage() {
				var heroDiv = document.getElementById('homepage-hero');
				if (heroDiv) {
				heroDiv.style.backgroundImage   = 'url(' + getRandomImage() + ')';
				heroDiv.style.backgroundSize     = 'cover';
				heroDiv.style.backgroundPosition = 'top';
				heroDiv.style.opacity            = '1';
				} else {
				console.error("Element with ID 'homepage-hero' not found.");
				}
				}

				displayRandomImage();
			</script><script>
				(function () {
				var video      = document.getElementById('hero-video-ada');
				var btn        = document.getElementById('hero-video-toggle');
				var iconPause  = document.getElementById('icon-pause');
				var iconPlay   = document.getElementById('icon-play');

				if (!video || !btn) return; // safety guard — no video section rendered

				// --- Helper: sync button state to actual video state ---
				function syncButtonState() {
				var paused = video.paused;
				// Option 1 — update aria attributes
				btn.setAttribute('aria-label',   paused ? 'Play background video'  : 'Pause background video');
				btn.setAttribute('aria-pressed',  paused ? 'true'                   : 'false');
				// Option 2 — swap SVG icons
				iconPause.style.display = paused ? 'none'         : '';
				iconPlay.style.display  = paused ? ''             : 'none';
				}

				// --- Option 1 + 2 — click handler ---
				btn.addEventListener('click', function () {
				if (video.paused) {
				video.play();
				} else {
				video.pause();
				}
				syncButtonState();
				});

				// --- Option 3 — prefers-reduced-motion auto-pause ---
				// Checks the OS/browser accessibility setting. If the user has
				// requested reduced motion, the video is paused immediately and
				// the button reflects the paused state without any manual action.
				var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

				function handleReducedMotion(mq) {
				if (mq.matches) {
				video.pause();
				syncButtonState();
				}
				}

				// Run once on load
				handleReducedMotion(motionQuery);

				// Also listen for live changes (user toggles the OS setting mid-session)
				if (motionQuery.addEventListener) {
				motionQuery.addEventListener('change', handleReducedMotion);
				} else {
				// Older Safari fallback
				motionQuery.addListener(handleReducedMotion);
				}

				// Initial sync in case autoplay was blocked by the browser
				video.addEventListener('play',  syncButtonState);
				video.addEventListener('pause', syncButtonState);
				})();
			</script></section>
