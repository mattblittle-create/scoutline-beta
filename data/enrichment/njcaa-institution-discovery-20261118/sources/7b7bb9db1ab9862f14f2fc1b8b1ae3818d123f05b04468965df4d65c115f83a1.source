               <script>

document.addEventListener('DOMContentLoaded', function () {
    var video = document.getElementById('loopVideo');
    var btn = document.getElementById('loopVideo-toggle');
    var iconPause = document.getElementById('statue-icon-pause');
    var iconPlay = document.getElementById('statue-icon-play');

    // Retain original 2-second pause between loops
    var pauseDuration = 2000;
    if (video) {
        video.addEventListener('ended', function () {
            video.pause();
            setTimeout(function () {
                var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
                if (!motionQuery.matches && btn && btn.getAttribute('aria-pressed') !== 'true') {
                    video.play();
                }
            }, pauseDuration);
        });
    }

    if (!video || !btn) return;

    // Helper to keep button state & aria attributes synced with actual video state
    function syncButtonState() {
        var isPaused = video.paused;
        btn.setAttribute('aria-label', isPaused ? 'Play background video' : 'Pause background video');
        btn.setAttribute('aria-pressed', isPaused ? 'true' : 'false');
        if (iconPause) iconPause.style.display = isPaused ? 'none' : '';
        if (iconPlay) iconPlay.style.display = isPaused ? '' : 'none';
    }

    // Toggle pause/play on button click
    btn.addEventListener('click', function () {
        if (video.paused) {
            video.play();
        } else {
            video.pause();
        }
        syncButtonState();
    });

    // Auto-pause if user has requested reduced motion in OS settings
    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    function handleReducedMotion(mq) {
        if (mq.matches) {
            video.pause();
            syncButtonState();
        }
    }

    handleReducedMotion(motionQuery);

    if (motionQuery.addEventListener) {
        motionQuery.addEventListener('change', handleReducedMotion);
    } else {
        motionQuery.addListener(handleReducedMotion);
    }

    // Keep button state updated on native video state changes
    video.addEventListener('play', syncButtonState);
    video.addEventListener('pause', syncButtonState);
});

</script>
               
