<!-- STYLE SECTION FOR MAIN PHOTO ONLY -->
<style>
#layoutHomeMainPhoto { height:900px; margin-bottom:2.07em; background-position:top; background-size:cover; background-repeat:no-repeat; }
#layoutHomeMainPhoto { background-image:url('/_images/homeMainPhoto/homepage_2023_fall.jpg'); }
@media screen and (max-width:1500px) {
	#layoutHomeMainPhoto { height:690px; }
}
@media screen and (max-width:1100px) {
	#layoutHomeMainPhoto { height:500px; }
}
@media screen and (max-width:740px) {
	#layoutHomeMainPhoto { height:400px; }
}
@media screen and (max-width:550px) {
	#layoutHomeMainPhoto { height:300px; }
}
@media print {
	#layoutHomeMainPhoto { display:none; }
}
</style>
<style type="text/css">#layoutHomeMainPhoto {
    /* 1. Keep your original PC settings */
    background-image: url('/_images/homeMainPhoto/homepage-hero-2026-fall.jpg');
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover; /* Keeps the high-end look on desktop */
    height: 900px;
    margin-bottom: 2.07em;
    width: 100%;
    display: block;
}

/* 2. Fix for Tablet/Mobile: Stop cutting the sides */
@media screen and (max-width: 1100px) {
    #layoutHomeMainPhoto {
        /* Change 'cover' to '100% auto' so the full width is always visible */
        background-size: 100% auto; 
        
        /* Remove fixed pixel heights and use aspect-ratio */
        /* This ensures the height perfectly matches the width of your PNG */
        height: auto;
        aspect-ratio: 16 / 9; /* Adjust these numbers to match your photo's shape */
    }
}


@media screen and (max-width: 550px) {
    #layoutHomeMainPhoto {
        margin-bottom: 1em;
        /* If 16/9 makes the photo look too short on mobile, 
           you can change it to 4/3 here */
        aspect-ratio: 16 / 10; 
    }
}

@media print {
    #layoutHomeMainPhoto { display: none; }
}
</style>


<!-- STYLE SECTION FOR MAIN TEMPLATE & MISC -->
<style>
html { overflow-y:scroll; }
.homeWidth { width:1170px; margin:0 auto; }
#layoutContent { max-width:none; }
#maskBanner { /*display:block;*/ display:NONE; }
/*#reconnectBanner { display:block; }*/
/*#wintertermBanner { display:block; }*/
#tourneyBanner { display:block; }
.sectionBlueBar2020 { display:block; }
#layoutCrumbs, #layoutPageTitle { display:none; }

@media screen and (max-width:1225px) {
	.homeWidth { width:950px; }
}

@media screen and (max-width:984px) {
	.homeWidth { width:auto; }
}

@media screen and (max-width:480px) {
	#layoutRSFull { display:block; margin:0 15px 15px; } /* homepage & subpages in mobile receive different images */
	#layoutRSShort { display:none; }
	.layoutSearchForm { max-width:275px; margin:0 auto 10px; }
	.layoutNavMajor { display:block; } /* main nav ordinarily hidden, except for homepage */
}
</style>

<!-- STYLE SECTION FOR CALENDAR -->
<style>
.sectionCalendar { display:none; /* hide temp contents including editor table */ font-family:"Microsoft New Tai Lue", "Segoe UI", Frutiger, "DejaVu Sans", "Helvetica Neue", Arial, sans-serif; }

.sectionCalendar .calendarTabRow { margin:24px 0 32px; font-size:16px; border-bottom:1px solid #cfcfcf; }
.sectionCalendar .calendarTabRow.second { margin-top:36px; }
.sectionCalendar .calendarTabRow .calendarTab { display:inline-block; margin-bottom:-2px; padding-bottom:2px; font-weight:bold; border-bottom:2px solid #860e00; }
.sectionCalendar .calendarMore { float:right; text-shadow: 0px 0px 0px black; } /* .calendarMore will exist in multiple structures */
.sectionCalendar .calendarMore a { text-decoration:none; }
.sectionCalendar .calendarMore.evenMore { float:none; padding:5px 0 2em; font-weight:bold; text-align:right; }

.sectionCalendar ul { margin:0; padding:0; list-style-type:none; }
.sectionCalendar ul li { display:inline-block; width:32.66%; margin:0 1% 0 0; padding:0; }
.sectionCalendar ul li:nth-child(n+4) { display:none; margin-top:24px; }
.sectionCalendar ul li:nth-child(3), .sectionCalendar ul li:nth-child(6) { margin-right:0; }
.sectionCalendar ul li a { display:table; width:100%; }
.sectionCalendar ul li a:hover { text-decoration:none; }
.sectionCalendar ul li a:focus { text-decoration:none !important; }
.sectionCalendar ul li a div.datePart { display:table-cell; width:65px; vertical-align:middle; text-align:center; line-height:1; text-transform:uppercase; color:black; border-right:1px solid #cfcfcf; }
.sectionCalendar ul li a div.datePart div.multiDate { position:relative; left:-4px; display:inline-block; }
.sectionCalendar ul li a div.datePart div.multiDate:last-child {  }
.sectionCalendar ul li a div.datePart span { display:block; margin-top:3px; }
.sectionCalendar ul li a div.datePart span.bigM { font-size:18px; font-weight:bold; }
.sectionCalendar ul li a div.datePart span.bigD { margin-top:5px; font-size:36px; }
.sectionCalendar ul li a div.datePart span.littleM { font-size:9px; font-weight:bold; }
.sectionCalendar ul li a div.datePart span.littleD { margin-top:5px; font-size:20px; }
.sectionCalendar ul li a div.datePart div.hyphen { position:relative; bottom:12px; left:-4px; display:inline-block; padding:0 2px; font-size:20px; }
.sectionCalendar ul li a div.textPart { display:table-cell; /*height:62px;*/ height:2.7em; padding-left:10px; box-sizing:border-box; font-size:24px; line-height:normal; vertical-align:middle; color:#0071bc; }
.sectionCalendar ul li a div.textPart div.overflowStop { max-height:2.7em; overflow:hidden; }
.sectionCalendar ul li a div.textPart div.overflowStop span.hellip { position:relative; left:-4px; font-family:Verdana; font-size:1rem; }
.sectionCalendar ul li a div.datePart.MMM { font-weight:bold; font-size:1.3em; }

@media screen and (max-width:1225px) {
	.sectionCalendar ul li a div.textPart { font-size:20px; }
}
@media screen and (max-width:984px) {
	.sectionCalendar ul li a div.datePart { width:60px; }
	.sectionCalendar ul li a div.datePart span.bigM { font-size:16px; }
	.sectionCalendar ul li a div.datePart span.bigD { margin-top:5px; font-size:30px; }
	.sectionCalendar ul li a div.textPart { font-size:17px; }
}
@media screen and (max-width:820px) {
	.sectionCalendar ul li:nth-child(n+0) { display:inline-block; width:100%;  /* inline-block & 100% because JS is setting inline-block on expansion */ margin-top:0.7em; margin-right:0; }
	.sectionCalendar ul li:nth-child(n+5) { display:none; }
	
/*	.sectionCalendar ul li { width:49%; }
	.sectionCalendar ul li:nth-child(n+4) { display:inline-block; }
	.sectionCalendar ul li:nth-child(n+5) { display:none; }
	.sectionCalendar ul li:nth-child(2) { margin-right:0; }
	.sectionCalendar ul li:nth-child(3) { margin-right:1%; }
	.sectionCalendar ul li:nth-child(4) { margin-right:0; }
	.sectionCalendar ul li:nth-child(n+3) { margin-top:0.7em; }*/
}
@media screen and (max-width:560px) {
	.sectionCalendar .calendarTabRow.second { margin-top:24px; }
/*	.sectionCalendar ul li { display:block; width:auto; }
	.sectionCalendar ul li:nth-child(n+0) { margin-top:0.7em; margin-right:0; }*/
	.sectionCalendar .calendarMore { float:none; display:inline-block; margin-left:0.75em; font-size:0.9em; }
}
@media screen and (max-width:400px) {
	.sectionCalendar .calendarTabRow { font-size:0.9em; text-shadow:none; }
}
</style>

<!-- STYLE SECTION FOR NEWS GRID -->
<style>
.sectionNews { margin-top:3em; font-family:GlacialIndifference, Verdana; /* Verdana fallback for IE11 */}
.sectionNews ul { list-style-type:none; margin:0; padding:0; }
.sectionNews ul li { position:relative; float:left; width:20%; margin:0; box-sizing:border-box; overflow:hidden; }
.sectionNews ul.lowCount li:nth-child(n+6) { display:none; } /* for low count situations */
.sectionNews ul li:before { content:""; display:block; margin-top:100%; } /* https://stackoverflow.com/a/6615994 */
.sectionNews ul li a { position:absolute; top:0; left:0; display:block; width:100%; height:100%; font-size:0; color:white; background-color:#5c5c5c; }
.sectionNews ul li:nth-child(odd) a { background-color:#3d3d3d; }
.sectionNews ul li a img { position:relative; width:100%; height:100% !important; /* if off-square by a few pixels, ensure fix */ transition-property:transform; transition-duration:.33s; transition-timing-function:cubic-bezier(.16,.51,.39,.97); }
.sectionNews ul li a:hover img { transform:scale(1.05, 1.05); }

.sectionNews ul li a span.titleContainer { position:absolute; top:0; left:0; z-index:100; width:100%; height:100%; background:linear-gradient(to bottom, rgba(0,0,0,0) 0%,rgba(0,0,0,0.30) 60%,rgba(0,0,0,0.65) 100%); transition-property:background-color; transition-duration:0.20s; transition-timing-function:linear; }
.sectionNews ul li a span.titleContainer:hover { background-color:rgba(0, 0, 0, 0.80); }

.sectionNews ul li a span.titleContainer span.firstTitle { position:absolute; bottom:0.5em; display:block; width:86%; margin:0 7% 3%; opacity:1; transition-property:all; transition-duration:0.20s; transition-timing-function:linear; /* fixes for GlacialIndifference: */ line-height:1.3; font-size:25px; letter-spacing:1px; }
.sectionNews ul li a span.titleContainer:hover span.firstTitle { opacity:0; }

.sectionNews ul li a span.titleContainer span.secondTitle { position:absolute; top:50%; transform:translateY(-50%); display:block; width:86%; margin:0 7% 0; opacity:0; font-family:Baskerville, "Palatino Linotype", Palatino, "Century Schoolbook L", "Times New Roman", serif; font-size:30px; text-align:center; transition-property:all; transition-duration:0.20s; transition-timing-function:linear; }
.sectionNews ul li a span.titleContainer:hover span.secondTitle { opacity:1; }
.sectionNews ul li a span.titleContainer span.secondTitle span.linkAction { display:block; margin-top:0.9em; font-size:0.65em; backface-visibility:hidden; color:white; font-weight:bold; font-style:italic; opacity:0; }
.sectionNews ul li a span.titleContainer:hover span.secondTitle span.linkAction { opacity:1; color:#0071bc; color:#0093f5; /* #0093f5 passes AA contrast limit against ~ the lightest possible bkgrnd #282727 */ }

.sectionNews ul li a.noImage span.titleContainer { background-image:none; }
.sectionNews ul li a.noImage span.titleContainer span.firstTitle { display:none; }
.sectionNews ul li a.noImage span.titleContainer:hover span.firstTitle { opacity:0; }
.sectionNews ul li a.noImage span.titleContainer span.secondTitle { opacity:1; }

.newsMore { text-align:right; }
.newsMore a { display:inline-block; margin-top:0.5em; padding:0 1em; text-decoration:none; font-family:"Microsoft New Tai Lue", "Segoe UI", Frutiger, "DejaVu Sans", "Helvetica Neue", Arial, sans-serif; font-size:18px; text-shadow:0px 0px 0px black; }

@media screen and (max-width:1700px) {
	.sectionNews ul li { width:25%; }
	.sectionNews ul li:nth-child(n+9) { display:none; }
	.sectionNews ul.lowCount li:nth-child(n+5) { display:none; } /* for low count situations */
}

@media screen and (max-width:1400px) {
	.sectionNews ul li a span.titleContainer span.firstTitle { font-size:22px; }
	.sectionNews ul li a span.titleContainer span.secondTitle { font-size:25px; }
}

@media screen and (max-width:1225px) {
	.sectionNews ul li { width:33.333%; width:calc(100% / 3); }
	.sectionNews ul li:nth-child(n+10) { display:initial; }
	.sectionNews ul.lowCount li:nth-child(n+4) { display:none; } /* for low count situations */
}

@media screen and (max-width:900px) {
	.sectionNews ul li { width:50%; }
	.sectionNews ul li:nth-child(n+7) { display:none; }
	.sectionNews ul.lowCount li:nth-child(n+1) { display:initial; } /* for low count situations (reset) */
	.sectionNews ul.lowCount li:nth-child(n+5) { display:none; } /* for low count situations */
	.sectionNews ul li a.noImage span.titleContainer { background-color:rgba(0, 0, 0, 0.80); }
