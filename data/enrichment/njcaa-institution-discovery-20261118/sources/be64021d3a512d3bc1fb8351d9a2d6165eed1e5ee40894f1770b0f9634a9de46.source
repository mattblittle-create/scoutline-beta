<script>
//make a case-insensitive "Contains"
//http://stackoverflow.com/questions/187537/is-there-a-case-insensitive-jquery-contains-selector
jQuery.expr[":"].Contains = jQuery.expr.createPseudo(function(arg) {
	return function( elem ) {
		return jQuery(elem).text().toUpperCase().indexOf(arg.toUpperCase()) >= 0;
	};
});
</script>

<script>
$(function(){
//***** SECTION: CALENDAR DATE ITEMS *****

	var $sectionCalendar = $(".sectionCalendar:first");
	var $sourceDateTable = $sectionCalendar.find("table:first");
	var $newCalendar = $("<div>");

	//cleanup
	$sourceDateTable.html($sourceDateTable.html().replace(/&nbsp;/g, " "));  //no nbsp's
	$sourceDateTable.find("p").contents().unwrap();  //no P's
	$sourceDateTable.find("th:first").closest("tr").remove();  //no header row
	
	//assign classes to list items
	$sourceDateTable.find("tr").each(function(){
		if($(this).children(":eq(2):Contains('Y')").length > 0){ $(this).addClass("itemEvents"); } else { $(this).addClass("itemDates"); } //assign class for what type of item this is
	});

	//remove items which have passed
	$sourceDateTable.find("tr").each(function(){
		var endingDateText = $(this).children(":eq(1)").text();
		if(endingDateText.indexOf("/") > -1){  //ignore "ongoing" situations (cell will be blank)
			var today = new Date();
			today.setHours(0, 0, 0, 0);  //must clear time portion otherwise comparison will be off
			var testdate = new Date(Date.parse(endingDateText));
			if(today > testdate){ $(this).remove(); };
		}
	});

	$newCalendar.append("<div class='calendarTabRow'><div class='calendarTab'>IMPORTANT DATES</div><div class='calendarMore'><a href='/?6553-Academic-Calendar'>More important dates</a></div></div>");

	//output first X "Important Dates" items
	var $ul = $("<ul>");
	$sourceDateTable.find("tr.itemDates:lt(6)").each(function(){
		var $li = $("<li>").attr("class", $(this).attr("class")).append($(this).find("a"));
		$li.find("a").contents().wrap("<div class='textPart'><div class='overflowStop'></div></div>");
		var $datePart = getDateHTML($.trim($(this).find("td:eq(0)").text()), $.trim($(this).find("td:eq(1)").text()), $("<div class='datePart'></div>"));
		$li.find("a").prepend($datePart)
		$ul.append($li);
	});
	$newCalendar.append($ul).append("<div class='calendarTabRow second'><div class='calendarTab'>EVENTS</div><div class='calendarMore'><a href='/?6457-College-Calendar'>More events</a></div></div>");

	//output first X "Events" items
	var $ul = $("<ul>");
	$sourceDateTable.find("tr.itemEvents:lt(6)").each(function(){
		var $li = $("<li>").attr("class", $(this).attr("class")).append($(this).find("a"));
		$li.find("a").contents().wrap("<div class='textPart'><div class='overflowStop'></div></div>");
		var $datePart = getDateHTML($.trim($(this).find("td:eq(0)").text()), $.trim($(this).find("td:eq(1)").text()), $("<div class='datePart'></div>"));
		$li.find("a").prepend($datePart)
		$ul.append($li);
	});
	$newCalendar.append($ul);

	//cleanup and show container
	$newCalendar.find("li:contains('NaN')").each(function(){ console.log("Date item has invalid date and has been hidden: " + $(this).text()); $(this).hide(); });
	$sectionCalendar.html($newCalendar.html()).show();

	//no overflowing; make ellipses
	reduceOverflows($sectionCalendar.find("div.overflowStop"));
	
	//handle request to show more items
	$("div.calendarMore a").on("click", function(e){
		
		var $thisMore = $(this).closest(".calendarMore");
		var $associatedItems = $(this).closest(".calendarTabRow").next("ul").children();
		
		//if there are more calendar items in DOM than visible calendar items, then show them all		
		if($associatedItems.length > $associatedItems.filter(":visible").length){
			
			e.preventDefault();
			
			$associatedItems.not(":visible")
				.addClass("expanded")
				.slideDown({
					start: function(){
						$(this).css('display','inline-block');
					},
					done: function(){
						reduceOverflows($(this).find(".overflowStop"));
					}
			});
			
			//add a View All link
			var $evenMore = $thisMore.clone().addClass("evenMore").hide();
			$evenMore.find("a").text("View all items");
			$associatedItems.parent().after($evenMore);
			$evenMore.slideDown();
			
		} else if($associatedItems.filter(".expanded").length > 0){  //else, if these items have been previously expanded, then collapse them
			
			e.preventDefault();
			$associatedItems.filter(".expanded").slideUp();
			$thisMore.closest(".calendarTabRow").next().next(".evenMore").slideUp(200);  //remove any (associated) previously added element		
			
		}
		
	});

});

function getDateHTML(beg, ending, $container){
//http://stackoverflow.com/questions/8579861/how-to-convert-milliseconds-into-a-readable-date
//input: date string, like 1/20/2017

	var months = ["Jan", "Feb", "Mar", "Apr", "May", "June", "July", "Aug", "Sept", "Oct", "Nov", "Dec"];
	
	//ordinarily, there is no beginning date to show
	if(beg.length === 0){
		
		//the ending date may be empty, too, in cases such as "ongoing" events
		if(ending.length === 0){
			var date = new Date();
			return $container.addClass("MMM").append(months[date.getMonth()]);
		} else {
			//return string format, like Jan 20
			var date = new Date(Date.parse(ending));
			return $container.append("<span class='bigM'>" + months[date.getMonth()] + "</span><span class='bigD'>" + date.getDate() + "</span>");
		}
		
	} else {
	//else, there is a beginning date to show	
		if(ending.length !== 0){
			var date1 = new Date(Date.parse(beg));
			var date2 = new Date(Date.parse(ending));
			return $container.append("<div class='multiDate'><span class='littleM'>" + months[date1.getMonth()] + "</span><span class='littleD'>" + date1.getDate() + "</span></div>")
							 .append("<div class='hyphen'>-</div>")
							 .append("<div class='multiDate'><span class='littleM'>" + months[date2.getMonth()] + "</span><span class='littleD'>" + date2.getDate() + "</span></div>");
		}
	}
}

function reduceOverflows($elems){
//This is passed a collection of DIVs which contain just the item text. It is called initially on all items; but will only act on visible items b/c they have no height to overflow.
//It will be called for items every time they are expanded, but once they are shortened, they shoudl not be acted on again.
	
	$.each($elems, function(){
		if(checkOverflow(this)){ //initial check to see if overflowing
		
			//add ellipsis
			$(this).append(" <span class='hellip'>&hellip;</span>");
		
			//reduce words until not overflowing
			while(checkOverflow(this)){
				//console.log(arrStr);
				var arrStr = $(this).html().split(" ");
				arrStr.splice(arrStr.length - 3, 1);
				$(this).html(arrStr.join(" "));
			}	
			
		}		
	});
	
}

function checkOverflow(el){
//http://stackoverflow.com/questions/143815/determine-if-an-html-elements-content-overflows
//This sets the element to CSS (inline) overflow if it is not already, compares its different dimension values, and returns the CSS property to its original (inline) state.
   
   var isOverflowing = el.scrollHeight > el.parentElement.clientHeight;
   //console.log(el.scrollHeight,  el.parentElement.clientHeight);
   return isOverflowing;
   
}
</script>

<script>
$(function(){
//***** SECTION: NEWS ITEMS *****

	//add class to UL if news items are below minimum count
	if($(".sectionNews ul li").length < 10){ $(".sectionNews ul").addClass("lowCount"); }

	//lazy load news images
	$(".sectionNews ul li a img").each(function(){
		$(this).attr("src", $(this).data("src"));
	});
	
	//no hanging digits (2019-08-14 email)
	$("span.firstTitle, span.secondTitle").each(function(){
		var htmlHeadline = $(this).html();
		htmlHeadline = htmlHeadline.replace(/ (?=\d)/g, "&nbsp;");
		$(this).html(htmlHeadline);
	});

});
</script>

<script>
$(function(){
//***** SECTION: MAPS *****
	$(".sectionMaps .controls").on("click", ".control", function(e){
		e.preventDefault();
		var thisIndex = $(this).index();
		$(".sectionMaps .content").hide().eq(thisIndex).show();
		$(this).addClass("active").siblings().removeClass("active");
	});
	
	$("#seeGlobalList").on("click", function(e){
			e.preventDefault();
			$("div.globalList").slideToggle();
	});
});
</script>

<script>
$(function(){
//***** SECTION: BY THE NUMBERS *****

	//lazy load image
	$(".sectionInfo").addClass("parallax");

});
</script>

