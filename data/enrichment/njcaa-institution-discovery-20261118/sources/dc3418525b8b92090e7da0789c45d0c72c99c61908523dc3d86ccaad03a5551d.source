<style id="wp-custom-css">
.tribe-events-after-html #events-after-html .su-list a {
	padding: 14px 0;
}
.tribe-events-after-html a {
	padding: 14px 0;
	display: inline-block;
}
.tribe-events-event-meta dd a {
	display: inline-block;
	padding: 14px 0;
}
.tribe-events-after-html #events-after-html .su-list {
	margin-bottom: 0;
}
.tribe-events-after-html #events-after-html p {
	display: none;
}
.tribe-common--breakpoint-medium.tribe-events .tribe-events-c-view-selector--tabs .tribe-events-c-view-selector__list-item-link {
	min-width: 44px;
	text-align: center;
}
.tribe-events-calendar-month__calendar-event-title a.tribe-events-calendar-month__calendar-event-title-link {
	min-height: 44px;
	min-width: 44px;
	display: block;
}
.tribe-common-c-btn-icon {
	min-height: 44px !important; 
	min-width: 44px;
}
.tribe-common--breakpoint-medium.tribe-common .tribe-common-c-btn-border-small, .tribe-common--breakpoint-medium.tribe-common a.tribe-common-c-btn-border-small {
	padding: 15px 15px;
}
a.tribe-events-widget-events-list__view-more-link {
