	font-size: 1rem !important; /* 1.23 */
}
.imagecard .imagecard-content ul li a{
	color: #005CB8;
	/*font-family: myriad-pro-condensed, sans-serif;*/
	font-weight: 200;
	border-bottom: 1px solid #005CB8;
}
.imagecard .imagecard-content ul li a:active, .imagecard .imagecard-content ul li a:focus, .imagecard .imagecard-content ul li a:hover {
	background: #fff !important;
	text-decoration: underline;
	border: 0;

}
.imagecard .imagecard-image {
	position: relative;
	overflow: hidden;
	padding: 1.2rem;
	height: auto !important;
	min-width: 150px;
}
.imagecard .imagecard-image img {
	min-width: 100%;
	width: 100%;
	max-width: 100%;
	min-height: auto;
	height: auto;
	position: relative;
	left: 0;
	top: 0;
	transform: none;
	-webkit-transform: none;
}
