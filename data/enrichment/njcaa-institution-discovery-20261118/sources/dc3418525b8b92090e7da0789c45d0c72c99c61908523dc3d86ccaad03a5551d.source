<style>
		#alert_bar, .alert-warning old_browsers {
			float: none;
			position: relative;
			max-width:1920px;
			margin:0 auto;
			z-index: unset;
		}

		.top-slider {
				width:100%;
				max-width: 1920px;
				padding: 0;
				float:none;
				margin:0 auto !important;
				position: absolute;
				top: 0;
				left:unset;
				z-index:0;
		}

		.header_menus {
			height:600px;
			position: relative;
			clear:both;
		}

		.menus_container {
			position:relative;
			width:100%;
			max-width:1920px;
			z-index:1;
		}

		/* Slider */
		#main_slider {
			width:100%;
			height:700px;
			padding:0;
			margin:0;
			position:relative;
			float:none;
			z-index:25;
			display:block;
			overflow: hidden;
		}

		.main_slide {
			position: absolute;
			top:0; left:4000px;
			background-repeat: no-repeat;
			background-position: 50% 50%;
			background-size: cover;
			width:100%;
			height:100%;
			display: none;
		}

		.main_slide img {
				width:100%;
		}

		.slide_content {
			width:100%;
			height:100%;
			float: left;
			text-align:center;
			vertical-align: middle;
			overflow: hidden;
		}

		.slide_content video {width:100%;}

		/* Navigation arrows */
		.navigationArrow {
				position:absolute;
				z-index:30;
				left:0;
				top:55%;
				width: 50px; /*10%;*/
				height:50px;
				max-width: 60px !important;
				min-width: 40px;
				max-height: 100px;
				min-height: 40px;
				background-color: rgba(0,0,0,0.9);
				text-align: center;
				display: table;
		}

		.navigationArrowRight {
				right: 0px;
				left: auto;
				display: inline-grid;
				height: 60px;
		}

		.navigationArrow span,
		.navigationArrow a {
				position: relative;
				top:0%;
				font-size: 3rem;
				color: white;
		}

		/* Call to action in the sliders */
		#cta_block {
			width: 30%;
			height: 290px;
			background-color: rgba(0,73,144,0.85);
			position: absolute;
			bottom:60px;
			left:110px;
			font-family:myriad-pro-condensed, sans-serif;
			font-size:55px;
			padding:10px 20px;
			border-radius:5px;
			box-shadow:5px 10px 18px rgba(0,0,0,.8);
		}

		#cta_container {
				float:left;
				position: absolute;
				z-index:50;
				background-color: #eeb111;
				height:65px;
				width:85%;
				left:-10px;
				bottom: 15px;
				padding:0 20px;
				box-shadow:5px 5px 10px rgba(0,0,0,0.4);
				border:1px white solid;
				border-radius:0 25px 25px 0;
		}

		#cta_block h2 {
				font-size: 2.5rem;
				line-height: 1.1;
				color:white;
				margin:0;padding:0;
		}

		#cta_block h3 {
				font-size: 0.3em;
				padding:0;
				line-height: 0.5;
				margin:20px 0 0;
				font-family: myriad-pro, sans-serif;
				font-weight: 400;
		}

		#cta_content {
			font-size: 1.5rem;
			line-height: 1.2;
			font-weight: 400;
			color:#eeb111;
			margin-top:16px;
		}

		#cta_container p {margin:0;padding:0;}

		#cta_container p a,
		#cta_container p a:visited {
				font-family: myriad-pro-condensed, sans-serif;
				font-size: 25px !important;
				margin:0;padding:0;
				line-height: 2.5;
				color: #004990;
				text-decoration: none;
				font-weight: 600;
		}

		#cta_container p a:hover {
				text-decoration: underline;
				color:#004990;
		}

		.dots_frame {
			position:absolute;
			width:108px;
			height:30px;
			left:245px;
			bottom:0px;
			z-index:30;
		}

		.dot_ind{
			position:relative;
			float:left;
			width:18px;
			height:30px;
			z-index:35;
		}

		.objectSlide { display:none; }
		.infoBox {margin-bottom:5px !important;}

		/* Main content */
		.main-contents {
				float:none;
				width:100%;
				max-width:1920px;
				position: relative;
				margin:0 auto;
				clear:both;
		}

		.page-template-page-home .banner {
			
/* USER IS 700px */
			height: 700px !important;
			float:none;
			position:relative;
			clear:both;
		}

		@media screen and (max-width:1024px) {
				.page-template-page-home .banner { height: 500px !important; }
				.page-template-page-home .banner .header-img-wrap { height: 500px !important; }
				.header_menus {height:400px;}
				#main_slider {height:500px;}
				.main_slide {top:50px;}
				#cta_block {
					padding-left:5px;
					min-width:200px;
					height:180px;
					bottom:10px;
				}
				#cta_block h2 {
					font-size: 25px;
					margin-left:5px;
				}
				#cta_container {
						font-size:20px;
						float:left;
						display: block;
						clear: both;
						height: 30px;
						bottom:0;
						padding:5px;
				}

				#cta_content {font-size:1.25rem;}
				#cta_container h3 { display:none; }
				#cta_container p { margin-top: 4px 0 0; }
				#cta_container p a { font-size:15px !important; line-height: 1; }
		}

		@media screen and (max-width: 600px) {
			#cta_block {left:50px; height:50%; bottom:60px;}
			.navigationArrowRight { height:50px; }
		}
</style>

