<style type="text/css">
.su-quote-cite{
	color: #004990;
	font-size: 1.3rem;
	text-transform: uppercase;
	font-weight: 500;
	line-height: 1.4;
}
.statQuoteWrapper{
	margin:15px 0;
	width:100%;
}
.statQuote-leftcol, .statQuote-rightcol{
	width:100%;
	display:inline-block;
}
.quote-right{
	text-align:right;
	padding-right:20px;
}
@media (min-width:700px){
	.statQuoteWrapper:after{
		content:" ";
		display:table;
		clear:both;
	}
	.statQuote-leftcol{
		float:left;
		width:33%;
		padding:0 15px;
		box-sizing:border-box;
	}
	.statQuote-rightcol{
		float:right;
		width:56%;
		padding-left:40px;
		box-sizing:border-box;
		margin-top:0;
	}
}
@media (max-width:700px) {
	.statQuote-leftcol, .statQuote-rightcol{
		display:inline-block;
	}
	.statQuote-rightcol{
		margin-top:15px;
	}
}
@media (max-width:300px) {
	.su-quote-cite {
		font-size: 1.2rem;
	}
}
.gray-container.merriweather, .gray-container.merriweather p, .gray-container.merriweather li, .gray-container.merriweather a  {
  font-family:myriad-pro, sans-serif;
  font-size: 1rem;
  font-weight:200;
  line-height: 1.85rem;
}

.gray-container.merriweather p a, .gray-container.merriweather li a, .gray-container.merriweather a,.gray-container.oswald p a, .gray-container.oswald li a, .gray-container.oswald a  {
  color: #005CB8;
}
.gray-container.merriweather p a:hover, .gray-container.merriweather li a:hover, .gray-container.merriweather a:hover, .gray-container.oswald p a:hover, .gray-container.oswald li a:hover, .gray-container.oswald a:hover{
  text-decoration:underline;
  background-color:#fff;
}
.gray-container.merriweather h2 {
  color: #004990;
  font-family: myriad-pro-condensed, sans-serif !important;
  font-size: 1.875rem !important;
  font-style: normal;
  font-weight: 700 !important;
  margin-top: 0;
  line-height: 1.5 !important;
  margin-bottom: 15px;	
}
.gray-container.merriweather h2 a{
  color: #005CB8;
  font-size: 1.875rem !important;
  font-style: normal;
  font-weight: 700 !important;
  margin-top: 0;
  line-height: 1.5 !important;
}
.gray-container.oswald, .gray-container.oswald p, .gray-container ul, .gray-container a{
  font-family:myriad-pro-condensed, sans-serif;
  font-size: 1.375rem;
  font-weight:200;
  line-height: 1.85rem;
}

.gray-container ul, .gray-container a{
	font-size: 1.375rem;
	font-family: myriad-pro-condensed, sans-serif;
}
.gray-container h2 a{
  color: #005CB8;
  font-family: myriad-pro-condensed, sans-serif !important;
  font-size: 1.875rem;
  font-style: normal;
  font-weight: 700;
  margin-top: 0;
  line-height: 1.5;
  margin-bottom: 15px;	
}
.gray-container h2 a:hover, .gray-container h2 a:focus, .gray-container h2 a:active {
  color: #B0820C !important;
  text-decoration:underline;
}
.gray-container .read-more-blue {
	text-transform: uppercase;
	color: #003971 !important;
	font-size: 1.1rem !important;
	font-family: myriad-pro-condensed, sans-serif !important;
	font-weight: 700 !important;
	font-style: normal;
	padding: .3571rem;
}
.video-container {
	position: relative;
	padding-bottom: 57.25%;
	padding-top: 0px; 
	height: 0;
	overflow: hidden;
	margin-bottom:15px;
}
.video-container iframe, .video-container object, .video-container embed {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	
}
.white-container {
	padding: 2rem;
	background: transparent;
	overflow: hidden;
}

.white-container p, .white-container a, .white-container ul li {
	font-family: myriad-pro-condensed, sans-serif;
	font-size: 1.375rem;
	padding-bottom: 10px;
	font-weight:200;
}
.white-container blockquote p {
	line-height: 1.75rem;
}
.white-container h2 a{
  color: #005CB8;
  font-family: myriad-pro-condensed, sans-serif;
  font-size: 1.875rem;
  font-style: normal;
  font-weight: 700;
  margin-top: 0;
  line-height: 1.5;
  margin-bottom: 15px;	
}
.white-container .read-more-blue {
	text-transform: uppercase;
	color: #003971;
	font-size: 15.5px;
	font-size: .96875rem;
	font-family: myriad-pro-condensed, sans-serif !important;
	font-weight: 700;
	font-style: normal;
	padding: .3571rem;
}
.accordion-width {
    max-width: 70%;
}
.su-accordion.white .su-spoiler-content a, .su-accordion.white .su-spoiler-content p a, .su-accordion.white .su-spoiler-content li a {
  font-size: 1rem;
  color:#005CB8;
}
.su-accordion.white .su-spoiler-content a:hover, .su-accordion.white .su-spoiler-content a:focus, .su-accordion.white .su-spoiler-content a:active {
  color:#005CB8;
  text-decoration:underline;
}
.white-container h2 a:hover, .white-container h2 a:focus, .white-container h2 a:active {
  color: #B0820C;
}
.academic-squash{
	margin-bottom:2rem;
}
.academic-blue{
	margin-bottom:2rem;
}
.academic-blue .academic-blue-content, .academic-blue-content h2, .academic-blue-content h3, .academic-blue-content h4,  .academic-blue-content p, .academic-blue-content li, .academic-blue-content li a, .academic-blue-content p a{
	color:#fff !important;
}
.academic-blue-content h3 a, .academic-blue-content h3 a:hover, .academic-blue-content h3 a:focus, .academic-blue-content h3 a:active{
  color: #fff;
  font-size: 1.5rem !important;
  line-height: 1.1;
  text-decoration:underline;
}
.academic-blue-content a, .academic-blue-content p a, .academic-blue-content li a{
	text-decoration:underline;
}
.academic-blue-content p a:hover, .academic-blue-content p a:focus, .academic-blue-content p a:active{
	color:#005CB8 !important;
}
.su-accordion.white .academic-blue .academic-blue-content p {
    margin-top: 15px;
    color:#fff !important;
}
.su-accordion.blue .su-spoiler-content {
    background: #eee;
    color:#000;
    font-family:myriad-pro, sans-serif;
}
.su-accordion.blue h2 {
  color: #004990;
  font-family: myriad-pro-condensed, sans-serif;
  font-size: 1.875rem;
  font-style: normal;
  font-weight: 700;
  margin-top: 0;
  line-height: 1.5;
  margin-bottom: 15px;
}
.su-accordion.blue .su-spoiler-content h2 a {
  color: #0066cc;
  font-family: myriad-pro-condensed, sans-serif;
  font-size: 1.875rem;
  font-style: normal;
  font-weight: 700;
}
.su-accordion.blue h2 a:hover, .su-accordion.blue h2 a:focus, .su-accordion.blue h2 a:active {
  color: #eeb111;
  font-family: myriad-pro-condensed, sans-serif;
  font-size: 1.875rem;
  font-style: normal;
  font-weight: 700;
  text-decoration:underline;
}
.su-accordion.blue .su-spoiler-content h3 a{
    color: #005CB8;
    font-size: 1.5rem !important;
    font-family: myriad-pro-condensed, sans-serif;
    font-weight: 700;
    font-style: normal;
    line-height: 1.4;
}

.su-accordion.blue .su-spoiler-content p, .su-accordion.blue ul li, .su-accordion.blue ul li p, .su-accordion.blue ol li, .su-accordion.blue ol li p{
    color: #000;
    font-family:myriad-pro, sans-serif;
}

.su-accordion.blue p a, .su-accordion.blue li a {
    color: #005CB8;
    font-size:1rem;
}
#sidebar .su-accordion.blue .su-spoiler a {
    color: #005cb8;
}
#sidebar .su-accordion.blue .su-spoiler a img {
    width: 100%;
    height: auto;
}
#sidebar .su-accordion.blue .su-spoiler p {
    padding: 0;
    text-align:left;
    font-family:myriad-pro, sans-serif;
}
#sidebar .su-accordion.blue .su-spoiler figure.alignright {
    margin-left: 0;
}
#sidebar .su-accordion.blue .su-spoiler figure.alignleft {
    margin-right: 0;
}

.su-accordion.blue p a:hover, .su-accordion.blue p a:focus, .su-accordion.blue p a:active {
	color: #005CB8;
	text-decoration: underline;
}

.su-accordion .su-spoiler-content h5 {
	font-size: 1.17rem !important;
}
.page-template-page-3col .stat-wrap, .page-template-page-3col-shared .stat-wrap {
    border-radius: 0;
    box-shadow: none;
    min-width: auto;
    min-height: auto;
    background: hsla(0,0%,100%,0);
    margin: .5rem auto;
    width:14.75rem !important;
}
.page-template-page-3col.stat-float, .page-template-page-3col-shared.stat-float {
  width: 30%;
}
.page-template-page-3col .stat-wrap, .page-template-page-3col-shared .stat-wrap {
