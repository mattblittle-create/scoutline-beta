      <style>
			section.mvccfact {
			background: url(/images/homepage/bg-campus.jpg) bottom center no-repeat;
			background-size:contain;
			padding-bottom:60px;
			}

			section.socialFeed {
			padding:60px;
			}	

			section.mvccfact>.factcontainer, section.socialFeed>div {
			max-width: 1170px;
			margin: 0 auto;
			text-align: center;
			}

			section.mvccfact .tab-content {
			background-color: transparent;
			}

			section.mvccfact h2 {
			font-family: Garamond,"Times New Roman", serif;
			font-weight: bolder;
			font-size: 2.4rem;
			line-height:1em;
			color: #00703c;
			}

			section.mvccfact p {
			font-size: .8rem;
			line-height:1.5em;
			font-family: Open Sans, Sans-serif;
			width:90%;
			margin: 20px auto;
			}

			section.mvccfact .tab-content {
			border: none;
			box-shadow: none;
			}

			section.mvccfact .nav-tabs {
			border-bottom: 0px solid #ddd;
			}


			section.mvccfact ul.nav-tabs li a {
			font-size: .7rem;
			background: #00703c;
			color:#fff;
			border:0;
			border-bottom:none;
			}
			
			section.mvccfact ul.nav-tabs li:not(:first-child) a:focus {
			box-shadow:	inset 0 -0.175em var(--limegreen), inset 0 -0.175em #fff;
			}


			section.mvccfact ul.nav-tabs > li > a:hover {
			background:#b2d33e;
			}



			section.mvccfact .nav-tabs li.active a  {
			background:#fff;
			color: #000 !important;
			font-weight: bold;
			}
			
			section.mvccfact ul.nav-tabs li.active {
			color: #fff !important;
			}


			section.mvccfact ul.nav-tabs li.active a:hover {
			color: #000 ;important;
			}

			section.mvccfact .col-sm-3 {
			padding:40px;
			border-right: 1px solid #e9e9e9;
			min-height:150px;
			font-size: .7rem;
			line-height:1.25em;
			text-shadow: 0px 0px 7px #FFF;
			}

			section.mvccfact .col-sm-3:last-child {
			border-right: 0;
			}

			section.mvccfact .col-sm-3 span {
			display:block;
			font-size: 2.2rem;
			line-height:1em;
			color:var(--mvgreen);
			font-weight: 700;
			}

			@media screen and (max-width:1025px) {
			section.mvccfact {
			background: url(/images/homepage/bg-campus.jpg) bottom left no-repeat;
			background-size:250%;
			}		

			section.mvccfact .col-sm-3 {
			padding:10px;
			border-right: none;
			min-height:auto;
			}

			section.mvccfact>.factcontainer {
			width: 100%;
			}

			section.mvccfact .row {
			border-right:none;
			border:none;		
			}

			section.mvccfact h2 {
			}
			}

			@media screen and (max-width:320px){
			section.mvccfact h2 {
			padding:0;
			}
			}
		</style>
