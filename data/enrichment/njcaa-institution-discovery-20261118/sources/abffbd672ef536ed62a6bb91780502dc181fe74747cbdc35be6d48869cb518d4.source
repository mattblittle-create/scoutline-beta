<script>
$(document).ready(function () {
  var isPaused = false;

  $('#carousel-toggle').on('click', function () {
    if (isPaused) {
      $('#intro-carousel').carousel('cycle');
      $(this).attr('aria-pressed', 'false');
      $(this).find('.fas')
        .removeClass('fa-play')
        .addClass('fa-pause');
      $(this).find('.visually-hidden').text('Pause carousel');
      isPaused = false;
    } else {
      $('#intro-carousel').carousel('pause');
      $(this).attr('aria-pressed', 'true');
      $(this).find('.fas')
        .removeClass('fa-pause')
        .addClass('fa-play');
      $(this).find('.visually-hidden').text('Play carousel');
      isPaused = true;
    }
  });
});
</script> <footer class="footer">
