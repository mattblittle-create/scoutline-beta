<script>// <![CDATA[
(function () {
  "use strict";

  var carousel = document.getElementById("ycExploreCarousel");
  var source = document.getElementById("ycExploreCardSource");
  var slides = document.getElementById("ycExploreSlides");
  var indicators = document.getElementById("ycExploreIndicators");
  if (!carousel || !source || !slides || !indicators) { return; }

  var cards = Array.prototype.slice.call(source.querySelectorAll("[data-yc-card]")).map(function (card) { return card.cloneNode(true); });

  // Shuffle once per page visit; responsive rebuilds keep the same order.
  for (var shuffleIndex = cards.length - 1; shuffleIndex > 0; shuffleIndex--) {
    var randomIndex = Math.floor(Math.random() * (shuffleIndex + 1));
    var temporaryCard = cards[shuffleIndex];
    cards[shuffleIndex] = cards[randomIndex];
    cards[randomIndex] = temporaryCard;
  }

  var previousPerSlide = 0;
  var firstVisibleIndex = 0;
  var resizeTimer;

  function perSlide() {
    if (window.matchMedia("(min-width: 992px)").matches) { return 3; }
    if (window.matchMedia("(min-width: 768px)").matches) { return 2; }
    return 1;
  }

  function updateIndicators(activeIndex) {
    var dots = indicators.querySelectorAll("li");
    Array.prototype.forEach.call(dots, function (dot, i) { dot.classList.toggle("active", i === activeIndex); });
    firstVisibleIndex = activeIndex * perSlide();
  }

  function build() {
    var count = perSlide();
    if (count === previousPerSlide && slides.children.length) { return; }

    var activeGroup = Math.floor(firstVisibleIndex / count);
    var totalGroups = Math.ceil(cards.length / count);
    if (activeGroup >= totalGroups) { activeGroup = totalGroups - 1; }

    slides.innerHTML = "";
    indicators.innerHTML = "";

    for (var i = 0; i < cards.length; i += count) {
      var groupIndex = Math.floor(i / count);
      var slide = document.createElement("div");
      var row = document.createElement("div");
      slide.className = "carousel-item" + (groupIndex === activeGroup ? " active" : "");
      slide.setAttribute("role", "group");
      slide.setAttribute("aria-roledescription", "slide");
      slide.setAttribute("aria-label", (groupIndex + 1) + " of " + totalGroups);
      var visibleCards = Math.min(count, cards.length - i);
      row.className = "row" + (visibleCards < count ? " justify-content-center" : "");

      for (var j = i; j < i + count && j < cards.length; j++) {
        var col = document.createElement("div");
        col.className = count === 3 ? "col-lg-4 yc-card-column" : (count === 2 ? "col-md-6 yc-card-column" : "col-12 yc-card-column");
        col.appendChild(cards[j].cloneNode(true));
        row.appendChild(col);
      }

      slide.appendChild(row);
      slides.appendChild(slide);

      var li = document.createElement("li");
      var button = document.createElement("button");
      if (groupIndex === activeGroup) { li.className = "active"; }
      button.type = "button";
      button.setAttribute("data-target", "#ycExploreCarousel");
      button.setAttribute("data-slide-to", String(groupIndex));
      button.setAttribute("aria-label", "Show group " + (groupIndex + 1) + " of " + totalGroups);
      li.appendChild(button);
      indicators.appendChild(li);
    }

    previousPerSlide = count;
    updateIndicators(activeGroup);
  }

  build();

  if (window.jQuery && window.jQuery.fn && window.jQuery.fn.carousel) {
    window.jQuery(carousel).carousel({ interval: false, pause: true, wrap: true, keyboard: true });
    window.jQuery(carousel).on("slid.bs.carousel", function (event) {
      var activeSlide = event.relatedTarget;
      var index = activeSlide ? Array.prototype.indexOf.call(slides.children, activeSlide) : -1;
      if (index >= 0) { updateIndicators(index); }
    });
  }

  window.addEventListener("resize", function () {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(build, 150);
  });
}());
// ]]></script>
            </section>
                



 


            
                
                        
            
                
                    
