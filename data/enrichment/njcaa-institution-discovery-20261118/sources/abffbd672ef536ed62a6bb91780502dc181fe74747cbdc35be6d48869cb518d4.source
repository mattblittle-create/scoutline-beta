    text-underline-offset: 3px;
}
.yc-home-intro {
    padding: 3rem 0;
}
.yc-home-intro h2 {
    font-size: 2.5rem;
    margin: 0 0 1rem;
}
.yc-home-intro p {
    max-width: 960px;
    margin: 0;
    font-size: 1.1rem;
}
.yc-home-locations {
    padding: 3rem 0;
    background: #f1f6f3;
    border-top: 1px solid #dbe4df;
    border-bottom: 1px solid #dbe4df;
}
.yc-home-locations-layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem;
    align-items: center;
}
.yc-home-map {
    margin: 0;
