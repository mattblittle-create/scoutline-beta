    color: #006747;
    background: #fff;
    text-align: center;
    transition: background-color .2s ease, border-color .2s ease;
}
.yc-home-quicklink span {
    color: #003c28;
    font-family: Barlow, "Open Sans", Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
}
.yc-home-explore .yc-home-quicklink-apply {
    background: #fff9e6;
    border-bottom-color: #ffc72c;
}
.yc-home-explore .yc-home-quicklink:hover, .yc-home-explore .yc-home-quicklink:focus {
    background: #f1f6f3;
    border-bottom-color: #006747;
}
.yc-home-quicklink:hover span, .yc-home-quicklink:focus span {
