<main class="main">
  



      
    
    
  
  <section class="section-article bg-white p-0" id="main-content" tabindex="0">
    <div class="carousel carousel-v62 slide" data-interval="7000" data-ride="carousel" id="intro-carousel">
        <ol class="carousel-indicators">
                        
                                    <li class="active" data-slide-to="0" data-target="#intro-carousel"></li>
                                        
                                    <li data-slide-to="1" data-target="#intro-carousel"></li>
                                        
                                    <li data-slide-to="2" data-target="#intro-carousel"></li>
                                        
                                    <li data-slide-to="3" data-target="#intro-carousel"></li>
                                        
                                    <li data-slide-to="4" data-target="#intro-carousel"></li>
                                    </ol>   
        
    <div class="carousel-inner">
                                
                        
            
            
                    
            <div class="carousel-item active" style="background-image: url(assets/images/aside/slide-enroll-spring-2027.jpg); background-position: 40%">
                <div class="container h-100 d-flex align-items-center">
                    <div class="section__entry carousel-v62-overlay" style="margin: 0 0 0 auto">
                        <h2 class="carousel-v62-overlay-heading barlow font-weight-bold text-uppercase">
                            Your Next 8 Week Session Starts Oct. 19
                            
                                                    </h2>
                
                        <p class="h5">Focus on fewer classes at a time without slowing your progress.  Experience a flexible way to begin sooner and keep moving toward your goals.</p>
            
                        <div class="text-center">
                                                            <a class="btn btn-myyc barlow text-uppercase" href="admissions/index.html">Enroll Now!</a>
                                                    </div>
                    </div><!-- /.section__entry -->
                </div><!-- /.container -->
            </div><!-- /.carousel-item -->

                                                        
                        
            
            
                    
            <div class="carousel-item " style="background-image: url(assets/images/aside/slide-odyssey.jpg); background-position: 40%">
                <div class="container h-100 d-flex align-items-center">
                    <div class="section__entry carousel-v62-overlay" style="margin: 0 0 0 auto">
                        <h2 class="carousel-v62-overlay-heading barlow font-weight-bold text-uppercase">
                            Your Journey
                            
                                                            <br/>Your Success
                                                    </h2>
                
                        <p class="h5">Your first semester begins with people, resources, and opportunities designed to help you belong, build confidence, and move forward.</p>
            
                        <div class="text-center">
                                                            <a class="btn btn-myyc barlow text-uppercase" href="student-services/journey.html">Learn More!</a>
                                                    </div>
                    </div><!-- /.section__entry -->
                </div><!-- /.container -->
            </div><!-- /.carousel-item -->

                                                        
                        
            
            
                    
            <div class="carousel-item " style="background-image: url(assets/images/aside/ps-banner.jpg); background-position: 40%">
                <div class="container h-100 d-flex align-items-center">
                    <div class="section__entry carousel-v62-overlay" style="margin: 0 0 0 auto">
                        <h2 class="carousel-v62-overlay-heading barlow font-weight-bold text-uppercase">
                            The Search for YC’s Next
                            
                                                            <br/>President Is Underway
                                                    </h2>
                
                        <p class="h5">A representative committee will guide a national search for the next leader of Yavapai College, with opportunities for input from the communities we serve.</p>
            
                        <div class="text-center">
                                                            <a class="btn btn-myyc barlow text-uppercase" href="i/presidential-search.html">Follow the Search</a>
                                                    </div>
                    </div><!-- /.section__entry -->
                </div><!-- /.container -->
            </div><!-- /.carousel-item -->

                                                        
                        
            
            
                    
            <div class="carousel-item " style="background-image: url(assets/images/aside/el8.jpg); background-position: 60%">
                <div class="container h-100 d-flex align-items-center">
                    <div class="section__entry carousel-v62-overlay" style="margin: 0 0 0 auto">
                        <h2 class="carousel-v62-overlay-heading barlow font-weight-bold text-uppercase">
                            ELEV8 WITH 8
                            
                                                    </h2>
                
                        <p class="h5">Take two classes at a time instead of four—while still completing a full semester’s worth of credits in the same overall timeframe. </p>
            
                        <div class="text-center">
                                                            <a class="btn btn-myyc barlow text-uppercase" href="academics/elevate-with-8.html">Click to Learn More!</a>
                                                    </div>
                    </div><!-- /.section__entry -->
                </div><!-- /.container -->
            </div><!-- /.carousel-item -->

                                                        
                        
            
            
                    
            <div class="carousel-item " style="background-image: url(assets/images/aside/bachelor-degrees-2026.jpg); background-position: 40%">
                <div class="container h-100 d-flex align-items-center">
                    <div class="section__entry carousel-v62-overlay" style="margin: 0 0 0 auto">
                        <h2 class="carousel-v62-overlay-heading barlow font-weight-bold text-uppercase">
                            Your Bachelor’s Degree Is Closer Than You Think
                            
                                                    </h2>
                
                        <p class="h5">Our programs include both traditional bachelor’s degrees and innovative Optimized Degree™ pathways.</p>
            
                        <div class="text-center">
                                                            <a class="btn btn-myyc barlow text-uppercase" href="schools/bachelor/index.html">Learn More!</a>
                                                    </div>
                    </div><!-- /.section__entry -->
                </div><!-- /.container -->
            </div><!-- /.carousel-item -->

