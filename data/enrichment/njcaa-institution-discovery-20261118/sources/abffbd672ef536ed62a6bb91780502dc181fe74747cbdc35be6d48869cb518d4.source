            <section class="custom-content-top">
                <!-- =========================================================
     YAVAPAI COLLEGE - EXPLORE YC CAROUSEL (REVISED)
     Bootstrap 4.1.3 compatible
     3 cards desktop / 2 tablet / 1 mobile
     Manual rotation only
========================================================= -->
<style><!--
.yc-explore {
    position: relative;
    isolation: isolate;
    padding: 3.5rem 0;
    background-color: #003c28;
    background-image: url("https://www.yc.edu/v6/assets/images/aside/yc-bg.jpg");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    color: #fff;
    border-top: 1px solid #dbe4df;
    font-family: "Open Sans", Arial, sans-serif;
}
.yc-explore::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: "";
    background: rgba(0, 60, 40, 0.58);
    pointer-events: none;
}
.yc-explore > .container {
    position: relative;
    z-index: 1;
}
.yc-explore *, .yc-explore *::before, .yc-explore *::after { box-sizing: border-box; }
.yc-explore .yc-intro { max-width: 760px; margin: 0 auto 2rem; text-align: center; }
.yc-explore .yc-eyebrow, .yc-explore .yc-card-label { margin: 0 0 .4rem; color: #006747; font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.yc-explore .yc-intro h2 { margin: 0 0 .75rem; color: #fff; font-family: Barlow, Arial, sans-serif; font-size: 2.2rem; font-weight: 700; line-height: 1.2; }
.yc-explore .yc-eyebrow { color: #f2b900; }
.yc-explore .yc-intro p:last-child { margin-bottom: 0; line-height: 1.6; }
.yc-explore .yc-carousel-wrap { position: relative; padding: 0; }
.yc-explore .carousel-inner { overflow: hidden; }
.yc-explore .carousel-item { padding: .35rem .15rem 1rem; }
.yc-explore .carousel-item > .row { align-items: stretch; }
.yc-explore .yc-card-column { display: flex; margin-bottom: 1rem; }
.yc-explore .yc-card { display: flex; flex: 1 1 auto; flex-direction: column; width: 100%; min-width: 0; overflow: visible; background: #fff; border: 1px solid #d5e2da; border-radius: 1rem 1rem 0 1rem; box-shadow: 0 8px 24px rgba(0,60,40,.08); }
.yc-explore .yc-card-media { position: relative; display: block; flex: 0 0 auto; width: 100%; padding-top: 56.25%; overflow: hidden; background: #dfeae4; border-radius: 1rem 1rem 0 0; }
.yc-explore .yc-card-media iframe, .yc-explore .yc-card-media img { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.yc-explore .yc-card-media img { display: block; object-fit: cover; }
.yc-explore .yc-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1rem; color: #003c28; background: #dfeae4; text-align: center; }
.yc-explore .yc-placeholder strong { display: block; margin-bottom: .25rem; font-family: Barlow, Arial, sans-serif; font-size: 1.15rem; }
.yc-explore .yc-placeholder span { color: #4e665c; font-size: .85rem; }
.yc-explore .yc-card-body { display: flex; flex: 1 1 auto; flex-direction: column; padding: 1.25rem; background: #fff; }
.yc-explore .yc-card h3 { margin: 0 0 .65rem; color: #003c28; font-family: Barlow, Arial, sans-serif; font-size: 1.4rem; font-weight: 700; line-height: 1.25; }
.yc-explore .yc-card-copy { margin: 0 0 1rem; color: #25312c; font-size: .9rem; line-height: 1.6; }
.yc-explore .yc-fitness-text-link { color: #00573d; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.yc-explore .yc-fitness-text-link:focus { outline: 3px solid #f4b41a; outline-offset: 3px; }
.yc-explore .yc-card-link-wrap { margin: auto 0 0; }
.yc-explore .yc-card-link { color: #00573d; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.yc-explore .yc-card-media:focus, .yc-explore .yc-card-link:focus, .yc-explore .carousel-control-prev:focus, .yc-explore .carousel-control-next:focus, .yc-explore .carousel-indicators button:focus { outline: 3px solid #f4b41a; outline-offset: 3px; }
.yc-explore a.yc-card-media:hover { box-shadow: inset 0 0 0 4px #006747; }
.yc-explore .yc-carousel-controls { display: flex; align-items: center; gap: .75rem; margin-top: .25rem; }
.yc-explore .carousel-control-prev, .yc-explore .carousel-control-next { position: relative; top: auto; right: auto; bottom: auto; left: auto; z-index: 1; display: flex; flex: 0 0 2.75rem; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; margin: 0; background: #f2b900; border-radius: 50%; opacity: 1; transform: none; }
.yc-explore .carousel-control-prev:hover, .yc-explore .carousel-control-next:hover { background: #ffcc33; }
.yc-explore .carousel-control-prev:focus, .yc-explore .carousel-control-next:focus { outline: 3px solid #fff; outline-offset: 3px; box-shadow: 0 0 0 6px #f2b900; }
.yc-explore .carousel-control-prev-icon, .yc-explore .carousel-control-next-icon { width: .65rem; height: .65rem; background-image: none; border-top: 3px solid #003c28; border-right: 3px solid #003c28; }
.yc-explore .carousel-control-prev-icon { transform: rotate(-135deg); }
.yc-explore .carousel-control-next-icon { transform: rotate(45deg); }
.yc-explore .carousel-indicators { position: static; display: flex; flex: 1 1 auto; flex-wrap: wrap; align-items: center; justify-content: center; margin: 0; padding: 0; list-style: none; }
.yc-explore .carousel-indicators li { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: auto; height: auto; margin: 0; text-indent: 0; background: transparent; border: 0; }
.yc-explore .carousel-indicators button { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; padding: 0; background: transparent; border: 0; border-radius: 50%; cursor: pointer; }
.yc-explore .carousel-indicators button::before { width: .65rem; height: .65rem; border-radius: 50%; background: #c4d2cc; content: ""; }
.yc-explore .carousel-indicators .active button::before { background: #f2b900; }
.yc-explore .carousel-indicators button:focus { outline: 3px solid #f2b900; outline-offset: 1px; }
.yc-explore .yc-card-source { display: none !important; }
@media (max-width: 767.98px) { .yc-explore { background-attachment: scroll; padding: 2rem 0; } .yc-explore .yc-intro { margin-bottom: 1.5rem; text-align: left; } .yc-explore .yc-intro h2 { font-size: 1.8rem; } .yc-explore .yc-card-body { padding: 1.1rem; } .yc-explore .yc-card h3 { font-size: 1.3rem; } }
@media (prefers-reduced-motion: reduce) { .yc-explore { background-attachment: scroll; } .yc-explore .carousel-item { transition: none !important; } }
/* Add a stronger green-and-gold frame to each card */
.yc-explore .yc-card {
  overflow: hidden;
  border-top: 4px solid #006747;
  box-shadow: 0 8px 24px rgba(0, 60, 40, .12);
  transition: transform .2s ease, box-shadow .2s ease;
}

.yc-explore .yc-card:hover,
.yc-explore .yc-card:focus-within {
  transform: translateY(-4px);
  box-shadow: 0 14px 30px rgba(0, 60, 40, .18);
}

.yc-explore .yc-card-media {
  border-bottom: 4px solid #f2b900;
}

.yc-explore .yc-card-label {
  display: inline-block;
  align-self: flex-start;
  padding: .28rem .55rem;
  color: #003c28;
  background: #edf5f0;
  border-left: 3px solid #f2b900;
  font-size: .68rem;
  letter-spacing: .12em;
}

.yc-explore .yc-card-link {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .55rem .8rem;
  color: #fff;
  background: #006747;
  border-radius: 0 10px 0 10px;
  text-decoration: none;
  white-space: nowrap;
}

.yc-explore .yc-card-link:hover {
  color: #fff;
  background: #003c28;
  text-decoration: none;
}

@media (max-width: 767.98px) {
  .yc-explore .yc-carousel-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "previous next";
    gap: .5rem;
  }

  .yc-explore .carousel-control-prev { grid-area: previous; justify-self: start; }
  .yc-explore .carousel-control-next { grid-area: next; justify-self: end; }
  .yc-explore .carousel-indicators { display: none; }
}
/* Keep card shadows inside the carousel's clipped viewport */
.yc-explore .carousel-item {
  padding: 1rem .25rem 1.5rem;
}

.yc-explore .carousel-item > .row {
  margin-right: 0;
  margin-left: 0;
}

.yc-explore .yc-card-column {
  padding-right: 1rem;
  padding-left: 1rem;
}

/* Keep each CTA inside its card and align buttons across the row */
.yc-explore .yc-card-link {
  display: flex;
  width: 100%;
  min-height: 2.75rem;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: .55rem .7rem;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width: 767.98px) {
  .yc-explore .carousel-item > .row {
    margin-right: 0;
    margin-left: 0;
  }
}

/* Expand the desktop cards to match the campus section's content width. */
@media (min-width: 992px) {
  .yc-explore .yc-carousel-wrap {
    left: 50%;
    width: calc(100vw - 2rem);
    max-width: 1080px;
    transform: translateX(-50%);
  }
}
--></style>
<section aria-labelledby="yc-explore-title" class="yc-explore">
<div class="container">
<div class="yc-intro">
<p class="yc-eyebrow">Explore</p>
<h2 id="yc-explore-title">Discover Yavapai College</h2>
</div>
<div class="yc-carousel-wrap">
<div aria-label="Explore Yavapai College features" aria-roledescription="carousel" class="carousel slide" data-interval="false" data-ride="false" data-wrap="true" id="ycExploreCarousel">
<div aria-live="polite" class="carousel-inner" id="ycExploreSlides"></div>
<div class="yc-carousel-controls"><a aria-label="Show previous group of Yavapai College features" class="carousel-control-prev" data-slide="prev" href="#ycExploreCarousel" role="button"><span aria-hidden="true" class="carousel-control-prev-icon"></span></a>
<ol aria-label="Choose a carousel group" class="carousel-indicators" id="ycExploreIndicators"></ol>
<a aria-label="Show next group of Yavapai College features" class="carousel-control-next" data-slide="next" href="#ycExploreCarousel" role="button"><span aria-hidden="true" class="carousel-control-next-icon"></span></a></div>
</div>
</div>
<!-- MASTER CARDS. These are cloned into responsive carousel slides by the script below. -->
<div class="yc-card-source" id="ycExploreCardSource"><!-- 1. Family Enrichment Center -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="/fec"><img alt="Children learning and playing at the Family Enrichment Center" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-fec.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Early Learning</p>
<h3>Family Enrichment Center</h3>
<p class="yc-card-copy">Discover a safe, nurturing lab school where children learn and YC students gain hands-on experience.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="/fec">Explore FEC <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 2. Skilled Trades Center -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="/stc"><img alt="Students learning hands-on skills at the Skilled Trades Center" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-stc.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Career &amp; Technical Education</p>
<h3>Skilled Trades Center</h3>
<p class="yc-card-copy">Build career and technical skills through hands-on training in Clarkdale.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="/stc">Explore the trades <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 3. Student Government Association -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="https://www.yc.edu/v6/campus-activities/sga/"><img alt="Four current Yavapai College Student Government Association members" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-sga.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Student Voice</p>
<h3>Student Government Association</h3>
<p class="yc-card-copy">YCSGA listens to students, speaks for their needs, and stands with the student body.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="https://www.yc.edu/v6/campus-activities/sga/">Explore SGA <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 4. Students of Leadership -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="https://www.yc.edu/V6/campus-activities/sol.html"><img alt="Students of Leadership developing leadership skills together" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-sol.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Leadership Development</p>
<h3>Students of Leadership</h3>
<p class="yc-card-copy">Grow through reflection, service, team building, and hands-on leadership experiences.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="https://www.yc.edu/V6/campus-activities/sol.html">Explore SOL <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 5. Odyssey Leadership -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="campus-activities/odyssey/index.html"> <img alt="Odyssey Leadership at Yavapai College" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-odyssey.jpg" width="800"/> </a>
<div class="yc-card-body">
<p class="yc-card-label">Leadership</p>
<h3>Odyssey Leadership</h3>
<p class="yc-card-copy">Explore leadership opportunities, speakers, and events that connect students across the Yavapai College community.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="campus-activities/odyssey/index.html">Explore Odyssey <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 6. Basic Needs Support -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="student-services/basic-needs/index.html"> <img alt="Basic Needs Support at Yavapai College" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-basic-needs.jpg" width="800"/> </a>
<div class="yc-card-body">
<p class="yc-card-label">Student Support</p>
<h3>Basic Needs Support</h3>
<p class="yc-card-copy">Find food, housing, and wellbeing resources to help you feel supported throughout your Yavapai College experience.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="student-services/basic-needs/index.html">Explore the support <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 7. YC Experience -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="student-services/journey.html"> <img alt="YC Experience at Yavapai College" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-experience.jpg" width="800"/> </a>
<div class="yc-card-body">
<p class="yc-card-label">Student Experience</p>
<h3>YC Experience</h3>
<p class="yc-card-copy">Discover a guided first-year experience that helps new students connect, learn, and thrive across Yavapai College.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="student-services/journey.html">Explore YC Experience <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 8. Swimming Pools -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="/pool"><img alt="Swimmer doing laps in a Yavapai College pool" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-pool.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Aquatics &amp; Wellness</p>
<h3>Swimming Pools</h3>
<p class="yc-card-copy">Swim laps, enjoy open swim, or explore therapy pool access, swim school, and lessons.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="/pool">Explore Swimming Pools <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 9. Student Clubs & Organizations -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="/v6/campus-activities/clubs.html"><img alt="Yavapai College students sharing a moment outdoors" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-clubs.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Student Life</p>
<h3>Student Clubs &amp; Organizations</h3>
<p class="yc-card-copy">Get involved, make lifelong friendships, and feel more at home at Yavapai College.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="/v6/campus-activities/clubs.html">Explore Student Clubs <span aria-hidden="true">&#8594;</span></a></p>
</div>
</article>
<!-- 10. Southwest Wine Center -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="https://www.southwestwinecenter.com/" rel="noopener noreferrer" target="_blank"><img alt="Southwest Wine Center vineyard and winery" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-swc.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Viticulture &amp; Enology</p>
<h3>Southwest Wine Center</h3>
<p class="yc-card-copy">Explore YC&#8217;s vineyard, teaching winery, and public tasting room in Clarkdale.</p>
<p class="yc-card-link-wrap"><a class="yc-card-link" href="https://www.southwestwinecenter.com/" rel="noopener noreferrer" target="_blank">Explore SWC <span aria-hidden="true">&#8594;</span><span class="sr-only"> (opens in a new tab)</span></a></p>
</div>
</article>
<!-- 11. The Eatery -->
<article class="yc-card" data-yc-card=""><a class="yc-card-media" href="https://www.yc.edu/v6/dining/eatery.html"><img alt="Fresh meals served at The Eatery on Yavapai College&#8217;s Prescott Campus" decoding="async" height="450" loading="lazy" src="assets/images/aside/media-eat.jpg" width="800"/></a>
<div class="yc-card-body">
<p class="yc-card-label">Campus Dining</p>
<h3>The Eatery</h3>
<p class="yc-card-copy">Enjoy fresh meals, smoothies, pizza, and more in a welcoming Prescott Campus gathering space.</p>
