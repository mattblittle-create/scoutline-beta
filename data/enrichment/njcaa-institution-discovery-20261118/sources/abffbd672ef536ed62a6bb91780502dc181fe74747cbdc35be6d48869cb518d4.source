}
.yc-home-explore .yc-home-quicklinks-list {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: .5rem;
    padding: 0;
    margin: 0;
    list-style: none;
}
.yc-home-quicklinks-list li {
    min-width: 0;
    margin: 0;
}
.yc-home-explore .yc-home-quicklink {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: .7rem;
