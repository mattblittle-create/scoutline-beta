<li hidden=""><a class="yc-home-quicklink" href="admissions/tours.html" rel="noopener" target="_blank"> <svg aria-hidden="true" class="yc-home-icon" focusable="false" viewbox="0 0 32 32"> <path d="M26 12c0 8-10 18-10 18S6 20 6 12a10 10 0 0 1 20 0z"> </path> <circle cx="16" cy="12" r="4"> </circle> </svg> <span>Tours</span> <span class="sr-only"> (opens in a new tab)</span> </a></li>
