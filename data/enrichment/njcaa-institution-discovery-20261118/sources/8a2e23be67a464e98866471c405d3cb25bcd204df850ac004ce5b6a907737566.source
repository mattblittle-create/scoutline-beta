<!--IPA Link Edit-->
<script rel="prefetch">	
window.addEventListener('load', function() {
  
  const paths = window.location.pathname.split('/');
  // if on pages that include ipa in the url
  if(paths.some(u => /ipa/i.test(u))){
    // links to the left of the social media links (upper-right corner of screen)
    const athAlumLinks = document.querySelectorAll('div.phone-info .top-banner a');
    athAlumLinks.forEach(l => l.remove());

    // Modify social media links for IPA.
    const socialMediaLinks = document.querySelectorAll('ul.social_bookmarks li');
    socialMediaLinks.forEach((listItem) => {
      const listItemClassList = Array.from(listItem.classList);
      if (listItemClassList.includes('social_bookmarks_facebook')) {
	listItem.firstChild.href = 'https://www.facebook.com/profile.php?id=100091719651517';
      } else if (listItemClassList.includes('social_bookmarks_instagram')) {
	listItem.firstChild.href = 'https://www.instagram.com/ipanmmi/';
      } else if (listItemClassList.includes('social_bookmarks_youtube')) {
	listItem.firstChild.href = 'https://www.youtube.com/@IPANMMI';
      }  else if (listItemClassList.includes('social_bookmarks_flickr')) {
	listItem.firstChild.href = 'https://www.flickr.com/photos/ipanmmi/albums/';
      }	else {
	listItem.remove();
      }
    });
    
    document.querySelector('nav.sub_menu').style.marginBottom = '14px'

    // change top banner link
    document.querySelector('span.logo.avia-standard-logo a').href = "https://nmmi.edu/ipa/";
	  const logo = document.querySelector('span.logo.avia-standard-logo img');
	  logo.srcset = 'https://www.nmmi.edu/wp-content/uploads/2025/01/Cavalry-Horse-Logo-1-e1736377689245.png';
      logo.src = 'https://www.nmmi.edu/wp-content/uploads/2025/01/Cavalry-Horse-Logo-1-e1736377689245.png';
	  
    
    const admissions = document.querySelector('#text-2 a[href="mailto:admissions@nmmi.edu"]');
    // change address
    admissions.parentElement.innerHTML = `<a href="tel:5756248010">(575) 624-8010</a>
    <span class="foot-sep">|</span>
    <a href="mailto:PrepAcademy@nmmi.edu">PrepAcademy@nmmi.edu</a><br>
    402 W Country Club Rd. <span class="foot-sep">|</span> Roswell, NM 88201`
    // change email
    admissions.href = 'mailto:PrepAcademy@nmmi.edu';
    admissions.innerText = 'PrepAcademy@nmmi.edu';
    
    // remove international
    document.querySelector('#text-3').remove();
  } else {
    // include admissions UChat
    const head = document.querySelector('head');
    const uChat = document.createElement('script');
    //uChat.src = 'https://uchat.co/widget.js?school=nmmi';
    //head.appendChild(uChat);
  }
})
</script>
<!--End IPA Link Edit-->

