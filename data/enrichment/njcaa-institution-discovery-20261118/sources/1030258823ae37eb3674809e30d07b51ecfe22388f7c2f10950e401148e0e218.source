      <section id="banner" class="video-hero">
         <div class="flexslider home-slider">
            <div data-vbg="https://www.youtube.com/embed/iqNd-ib7JrY?si=n73vE_in4TJfiWqo"></div>
            <div class="slider-text darken-backdrop">
               <div class="slider-text-inner">
                  <h1>Southeastern Community College</h1>
                  <p class="h3">You don't have to go far to go far</p>
                  <div class="sbtn"><a href="/start/requestinfo.aspx" class="btn btn-white-border">Request Info</a><a href="/programs/program-finder.aspx" class="btn btn-white-border">Programs</a><a href="/paying/tuition/index.aspx" class="btn btn-white-border">Cost</a></div>
