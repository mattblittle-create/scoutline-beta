                    <div class="item position-relative d-flex flex-column align-items-center justify-content-center">
                                    <a class="stretched-link" href=" # "   role="button">
                                
    <picture class="img-placeholder">
        <img src="/images/setup/FC_logo-long-color-white-border-rounded22.png?max_width=auto&max_height=auto&crop=false" alt="Food City" class="lazyloaded img-fluid mx-auto" loading="lazy" />
    </picture>
    
