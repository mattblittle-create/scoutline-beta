<script>
$(function () {
    var el = document.documentElement;
    var flag = el.getAttribute('data-ada-autocontrast');
    var automated = flag === 'true'  ? true
                  : flag === 'false' ? false
                  : getComputedStyle(el).getPropertyValue('--ink-on-primary').trim() !== '';
    if (automated) {
        el.classList.remove('primary-color-light', 'secondary-color-light');
        return;
    }
    el.classList.add('primary-color-light');
});
</script>

 


    
    
                                                                                                
        
                                                                                                                                                                                    
				
																															
