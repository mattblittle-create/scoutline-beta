      <style>
	.campus-slider {
  position: relative;
  width: 100%;
  height: 35vh;
  overflow: hidden;
  font-family: Azo Sans, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI,
Roboto, Helvetica Neue, Arial, Noto Sans, sans-serif, Apple Color Emoji,
Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
}

.campus-slider__track {
  display: flex;
  height: 100%;
  transition: transform 0.6s ease;
}

/* Slide */
.campus-slide {
  min-width: 100%;
  height: 100%;
  position: relative;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Example backgrounds — replace with CMS images */
.campus-slide:nth-child(1) { background-image: url("/_images/_banners/_hp-slider/hp-orange-screech.jpg"); }
.campus-slide:nth-child(2) { background-image: url("/_images/_banners/_hp-slider/hp-nursing.jpg"); }
.campus-slide:nth-child(3) { background-image: url("/_images/_banners/_hp-slider/hp-gis.jpg"); }
.campus-slide:nth-child(4) { background-image: url("/_images/_banners/_hp-slider/hp-oconnell.jpg"); }
.campus-slide:nth-child(5) { background-image: url("/_images/_banners/_hp-slider/hp-spring-scholarships.jpg"); }
	

/* Overlay for color contrast 
.campus-slide::before {
  content: "";
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.55);
}*/

/* Text */
.campus-slide__content {
  position: absolute;
  left: 19%;
  top: 50%;
  transform: translateY(-50%);
  text-align: left;
  max-width: 60ch;
}

@media (max-width: 768px) {
  .campus-slide__content {
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    max-width: 90%;
  }
}

.campus-slide__content h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 0.75rem;
			color: #ffffff;	
}

.campus-slide__content p {
  font-size: clamp(1rem, 3vw, 1.5rem) !important;
	color: #ffffff;	
		
}

/* Pause button */
.campus-slider__toggle {
  position: absolute;
  bottom: 0rem;
  right: 0rem;
  z-index: 5;
  background-color: rgba(255, 255, 255, 0.7);
  color: #172752;
  /* border: 2px solid #fff; */
  width: 120px;
	height: 50px;
	font-weight: 900;
  cursor: pointer;
}

.campus-slider__toggle:focus-visible {
  outline: 3px solid #ffd700;
  outline-offset: 2px;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .campus-slider__track {
    transition: none;
  }
}
		
/* PREV / NEXT BUTTONS */
.campus-slider__prev,
.campus-slider__next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  border: 2px solid #fff;
  font-size: 2rem;
  line-height: 1;
  padding: 0.4rem 0.7rem 0.7rem 0.7rem;
  cursor: pointer;
  z-index: 6;
}

.campus-slider__prev {
  left: 1rem;
}

.campus-slider__next {
  right: 1rem;
}

.campus-slider__prev:focus-visible,
.campus-slider__next:focus-visible {
  outline: 3px solid #ffd700;
  outline-offset: 2px;
}

	.logo-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center; /* centers the last row */
  gap: 1.5rem;
}

.logo-item {
  flex: 0 0 calc(100% / 7); /* 6 per row */
  text-align: center;
}

.logo-item img {
  max-width: 70%;
  height: auto;
  display: block;
  margin: 0 auto 0.5rem;
 transition: transform 0.25s ease;

}
		
		
.logo-item:hover img {
  transform: scale(1.12);
}

.logo-item figcaption {
  font-size: 0.9rem;
  line-height: 1.3;
}
</style>
      	
