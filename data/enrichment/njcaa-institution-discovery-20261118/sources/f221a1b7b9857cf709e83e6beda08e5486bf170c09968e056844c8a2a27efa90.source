<section class="slider-type-2 single-padding-divider-bottom">
  <div class="container-fluid container-t4">
    <div class="row">
      <div class="col-12">
        <h2 class="slider-type-2__section-title">What Our Students Say</h2>
      </div>

      <div class="col-12">
        <div class="slider-type-2__swiper">
          <div class="slider-type-2__swiper-container swiper-container">
            <!-- Swiper Wrapper -->
