}</style><style id="wp-custom-css">
/* float & clear rules */
.clear-left {
	clear: left;
}

.float.left {
	float: left;
}

.float.right {
	float: right;
}

.float.none {
	float: none;
}
/* END float & clear rules */
/* Text-formatting overrides */
em strong {
	font-style: unset;
}
.larger {
	font-size: 130%;
	line-height: 110%;
}
.double {
	font-size: 200%;
	line-height: 170%;
}

.block table thead td, .block table thead th {
	background-color: #444;
}

/* Change formatting on no-results so that it doesn't look like an error, per KB */
.no-results {
  background-color: unset;
  color: unset;
}


.pg-title {
	color: #fff;
	line-height: 1em;
	font-size: 3.5em;
	margin: 0;
	max-width: 900px;
}

div.table-wrap td {
  vertical-align: top;
}

div.board-section {
	clear: both;
}

.hide-photo-thumb .bio-information img {
	display: none;
	visibility: hidden;
}

.split-feature.default .content .link-wrap {
  border-color: #c99700;;
}

.split-feature.alt .content h2 + .link-wrap, .split-feature.default .content h2 + .link-wrap {
  border: none;
}
.wp-block-columns.nopadding.vertical {
	padding: 0;
}

.block.split-feature .widget-calendar.format-default {
  background-color: white;
	border-radius: 5px;
}

.block .alignleft:not(.img-sm), .block .aligncenter:not(.img-sm), .block .alignright:not(.img-sm), .block .alignnone:not(.img-sm) {
	width: unset;
}
.block address {
	background-color: inherit;
	color: inherit;
}

/* END Text-formatting overrides */

/* Block padding & margin rules */

.padding-top-zero {
	padding-top: 0px;
}
.padding-bottom-zero {
	padding-bottom: 0px;
}
.margin-top-zero {
	margin-top: 0;
}
.margin-bottom-zero {
	margin-bottom: 0;
}

/* END Block padding & margin rules */

/* Center a content block within its wrapper */
div.centered div.rtf-content {
	margin: auto;
}
/* END Center a content block within its wrapper */

/* Page-specific overrides */
.page-id-36544 #menu-primary-menu {
display: none;
}

.page-id-36544 #div.search-wrap {
display: none; !important;
}

.page-id-36544 #menu-footer-resources-menu {
display: none; !important;
}

.page-id-36544 #menu-footer-menu {
display: none; !important;
}

.page-id-36544 #search-form {
display: none; !important;
}

.page-id-36544 #search-directory {
display: none; !important;
}

.page-id-36544 #search-wrap-outer {display: none; visibility: hidden;}

.page-id-36544 #nav nav-footer-resources col {
display: hidden; !important;
}

.page-id-193 .split-feature + .split-feature {
	margin-top: 2em !important;
}

.page-id-193 .multiple-callout.statistics + .multiple-callout.style-intro-col {
	margin-top: .25em !important;
}
/* Hide extra Tutoring Services split-feature on Courses pages */
body.single-courses div.post div.split-feature#tutoring-services {
	visibility: hidden;
	display: none;

}

/* END Page-specific overrides */

/* begin GRAVITY FORMS */
/* adds a bottom border to a gravity form field container */
.gfield.border-bottom {
	border-bottom: 2px solid #e4e4e4;
	padding-bottom: .5em;
}
/* adds bottom padding to a gravity form field container */
.gfield.padding-bottom {
	padding-bottom: 1em;
}
/* add a top border to a gravity form field container */
.gfield.border-top {
	border-top: 2px solid #e4e4e4;
	padding-top: .5em;
}
/* add top padding to a gravity form field container */
.gfield.padding-top {
	padding-top: 1em;
}
/* Formidable section titles */
h3.gsection_title {
  font-size: 1.2em;
}
/* end GRAVITY FORMS */


/*The Economic Value of GCC Report */

/* Fade-in animation */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
.fade-in {
  animation: fadeInUp 1s ease-out forwards;
  opacity: 0;
}
.fade-in.delay-1 { animation-delay: 0.2s; }
.fade-in.delay-2 { animation-delay: 0.4s; }
.fade-in.delay-3 { animation-delay: 0.6s; }
.fade-in.delay-4 { animation-delay: 0.8s; }
.fade-in.delay-5 { animation-delay: 1.0s; }
.fade-in.delay-6 { animation-delay: 1.2s; }
.fade-in.delay-7 { animation-delay: 1.4s; }
.fade-in.delay-8 { animation-delay: 1.6s; }
.fade-in.delay-9 { animation-delay: 1.8s; }
.fade-in.delay-10 { animation-delay: 2.0s; }
.fade-in.delay-11 { animation-delay: 2.2s; }
.fade-in.delay-12 { animation-delay: 2.4s; }
.fade-in.delay-13 { animation-delay: 2.6s; }
.fade-in.delay-14 { animation-delay: 2.8s; }
.fade-in.delay-15 { animation-delay: 3.0s; }
.fade-in.delay-16 { animation-delay: 3.2s; }

/* Stat card hover animation */
.stat-box {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.stat-box:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

/* Progress bar structure */
.bar-wrapper {
  background: #e0e0e0;
  border-radius: 8px;
  overflow: hidden;
  height: 16px;
  margin-top: 5px;
}

.bar-fill {
  height: 100%;
  width: 0%; 
  background-color: #3a7ca5;
  transition: width 1.2s ease-out;
}

@keyframes growBar {
  from { width: 0%; }
  to   { width: var(--bar-width); }
}


/* Blue-Gray bg */
.blue-bg {
  background-color: #f0f4f8;
}
.dark-blue-text {
  color: #003366;
}
.light-gray-text {
  color: #777;
}

 
/*End of The Economic Value of GCC Report */

@media screen and (max-width: 435px) {
img.map-img {
    width: 100% !important;
}
}
</style>

