<div class="block split-feature align default media-left">
  <div class="block-wrap">
    <div class="split-feature-inner">
              <div class="img-wrap">
          <img decoding="async" src="/wp-content/uploads/sunyreconnectlogo.png" alt="suny reconnect logo">
        </div>
      
      <div class="content">
                  <h2>
            Free Community College with SUNY Reconnect!          </h2>
        
                  <div class="description-wrap cf">
            <p>The SUNY Reconnect program provides free associate degrees in high-demand fields like advanced manufacturing, nursing and health professions, teaching &amp; more for New York State residents ages 25 to 55 with no college degree</p>
          </div>
        
                  <div class="link-wrap">
            <a href="https://www.genesee.edu/freecc/" class="btn "><span>Learn More</span></a>          </div>
              </div>
