        <section data-pb-section="0" id="hero" class="hero-home relative isolate overflow-hidden text-white xl:-mt-17.5 xl:h-[calc(100dvh-100px)] xl:flex xl:items-center xl:justify-center after:absolute after:inset-0 after:bg-black/10 after:-z-10 after:content-['']" data-aos="fade-in">

    <video autoplay loop muted playsinline preload="none"
           poster="images/bg-video.jpg"
           data-hero-video="images/video-main-new.mp4"
           class="absolute inset-0 -z-20 w-full h-full object-cover"></video>
    <script>
    (function () {
        var v = document.querySelector('video[data-hero-video]');
        if (!v) return;
        if (!window.matchMedia('(min-width: 992px)').matches) return;
        var s = document.createElement('source');
        s.type = 'video/mp4';
        s.src  = v.dataset.heroVideo;
        v.appendChild(s);
        v.load();
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
    })();
    </script>

