        <script type="text/javascript" src="https://asumh.edu/js/bundle.js?v=1794842054"></script>
    
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
    <script>
        function initTurnstile(){
            const interiorContainer = document.getElementById('turnstile-interior-container');
            if(interiorContainer && !interiorContainer.hasAttribute('data-turnstile-rendered')){
                interiorContainer.setAttribute('data-turnstile-rendered', 'true');
                try {
                    turnstile.render('#turnstile-interior-container', {
                        sitekey: '0x4AAAAAACI6y0b7OeRWvoP2',
                        callback: function(token) {
                            const input = document.getElementById('cf-turnstile-response');
                            if(input) input.value = token;
                        }
                    });
                } catch(e) {
                    console.error('Turnstile interior render error:', e);
                }
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTurnstile);
        } else {
            initTurnstile();
        }
    </script>

