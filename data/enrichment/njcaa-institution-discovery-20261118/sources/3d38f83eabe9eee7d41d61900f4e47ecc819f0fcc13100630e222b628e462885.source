<script src="https://panorama-api.yuja.com/visualizers/website-accessibility/acebddc50f2f74f89a1b7439ade3d2a5e684afc6d8923c57e424e5035062ecee"></script>
<style>
    /* Hide YuJa's own draggable launcher without removing it: visibility:hidden
       drops it from the tab order and from hit-testing but - unlike display:none -
       keeps its geometry, which the synthetic mouse sequence below depends on. */
    #panoramaAccessibilityDraggable {
        visibility: hidden !important;
    }
</style>
<script>
(function () {
    'use strict';

    /* YuJa's launcher is a react-draggable. It opens the panel from its drag-STOP
       handler when the pointer moved less than 5px - it never listens for a plain
       'click', so element.click() does nothing. Opening it therefore means
       replaying a real press: pointerdown/mousedown, then pointerup/mouseup/click
       at the same coordinates. Verified against the live asumh.edu widget. */
    function pressLauncher(btn) {
        var r    = btn.getBoundingClientRect();
        var x    = r.left + r.width / 2;
        var y    = r.top + r.height / 2;
        var base = { bubbles: true, cancelable: true, clientX: x, clientY: y, button: 0, view: window };

        function fire(MouseCtor, PointerName, MouseName) {
            if (PointerName && typeof window.PointerEvent === 'function') {
                var pOpts = {};
                for (var k in base) { pOpts[k] = base[k]; }
                pOpts.pointerId = 1;
                pOpts.isPrimary = true;
                btn.dispatchEvent(new PointerEvent(PointerName, pOpts));
            }
            btn.dispatchEvent(new MouseEvent(MouseName, base));
        }

        fire(MouseEvent, 'pointerdown', 'mousedown');
        setTimeout(function () {
            fire(MouseEvent, 'pointerup', 'mouseup');
            btn.dispatchEvent(new MouseEvent('click', base));
        }, 50);
    }

    /* The widget bootstraps asynchronously (loader -> CDN script -> React mount),
       so a click landing before it is ready has to wait rather than no-op. */
    function openPanel(attempt) {
        attempt = attempt || 0;
        var btn = document.getElementById('panoramaAccessibilityFloatButton');
        if (btn) { pressLauncher(btn); return; }
        if (attempt < 40) { setTimeout(function () { openPanel(attempt + 1); }, 250); }
    }

    document.addEventListener('click', function (e) {
        var trigger = e.target.closest ? e.target.closest('[data-a11y-trigger]') : null;
        if (!trigger) { return; }
        e.preventDefault();
        openPanel(0);
    });
})();
</script>


