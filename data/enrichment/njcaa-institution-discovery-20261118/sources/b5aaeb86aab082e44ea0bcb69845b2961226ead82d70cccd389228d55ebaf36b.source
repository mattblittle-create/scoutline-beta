<!-- accessibility issue
<script >
jQuery(document).ready(function($) {
    // Force Divi Mobile Menu to open/stay open on Enter key
    $(document).on('keydown', '.et_mobile_menu .menu-item-has-children > a', function(e) {
        if (e.keyCode === 13) { // 13 is the Enter key
            e.preventDefault();
            var $parentLi = $(this).parent();
            $parentLi.toggleClass('visible'); // Divi's internal 'open' class
            $(this).siblings('.sub-menu').slideToggle();
            
            // Move focus to the first item in the sub-menu automatically
            if ($parentLi.hasClass('visible')) {
                setTimeout(function() {
                    $parentLi.find('.sub-menu li a').first().focus();
                }, 300);
            }
        }
    });
});
</script >
