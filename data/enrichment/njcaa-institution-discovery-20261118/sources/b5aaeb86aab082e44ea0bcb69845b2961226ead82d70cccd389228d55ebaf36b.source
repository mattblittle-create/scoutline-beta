39 \u0441 \u0421\u0414\u0412\u0413."},"dvmd_acsb_screen_reader":{"text":"\u042d\u043a\u0440\u0430\u043d\u043d\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435","label":"\u042d\u043a\u0440\u0430\u043d\u043d\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435","description":"\u042d\u043a\u0440\u0430\u043d\u043d\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0442\u0435\u043a\u0441\u0442 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0430 \u0432 \u0437\u0432\u0443\u043a\u043e\u0432\u0443\u044e \u0440\u0435\u0447\u044c \u0434\u043b\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0432 \u0447\u0442\u0435\u043d\u0438\u0438."},"dvmd_acsb_screen_reader_mode":{"text":"\u0420\u0435\u0436\u0438\u043c \u044d\u043a\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044f","label":"\u0420\u0435\u0436\u0438\u043c \u044d\u043a\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044f","description":"\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0435\u0436\u0438\u043c \u044d\u043a\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u0435\u043a\u0441\u0442\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0430 \u0432 \u0437\u0432\u0443\u043a\u043e\u0432\u0443\u044e \u0440\u0435\u0447\u044c."},"dvmd_acsb_screen_reader_mode_off":{"label":"\u0420\u0435\u0436\u0438\u043c \u044d\u043a\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044f \u2013 \u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d","description":"\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0435\u0436\u0438