<style>
/*----- Accordion -----*/
.accordion,
.accordion * {
    -webkit-box-sizing:border-box;
    -moz-box-sizing:border-box;
    box-sizing:border-box;
}

.accordion {
    overflow:hidden;
    box-shadow:0px 1px 3px rgba(0,0,0,0.25);
    border-radius:3px;
    background:#f7f7f7;
}

/*----- Section Titles -----*/
.accordion-section-title {
    width:100%;
    padding:15px;
    display:inline-block;
    border-bottom:1px solid #0082ca;
    background:#003a70;
    transition:all linear 0.15s;
    /* Type */
    font-size:1.200em;
    text-shadow:0px 1px 0px #1a1a1a;
    color:#fff;
}

.accordion-section-title.active,
.accordion-section-title:hover {
    background:#003a70;
    /* Type */
    text-decoration:none;
}

.accordion-section:last-child .accordion-section-title {
    border-bottom:none;
}

/*----- Section Content -----*/
.accordion-section-content {
    padding:15px;
    display:none;
}

</style>
      <style>
		.main-content #content {width:calc(100%); max-width:1170px; float:none; padding:50px 30px 0px 30px; margin:0px auto;}
			.programs-text a {color: white; text-decoration: underline;}
			:root {
  --blue: #0183c9;
  --green: #78ba21;
  --orange: #ef7f0f;
  --red: #b32615;
  --steel-gray: #435263;
  --yellow: #fec83f;

  --gray: #e1e1e1;
  --slcc-primary-blue: #003a70;
}

/* colors - start */
.bg-blue {
  background-color: var(--blue);
  color: #111;
}

.bg-green {
  background-color: var(--green);
  color: #111;
}

.bg-orange {
  background-color: var(--orange);
  color: #111;
}

.bg-red {
  background-color: var(--red);
  color: white;
}

.bg-steel-gray {
  background-color: var(--steel-gray);
  color: white;
}

.bg-yellow {
  background-color: var(--yellow);
  color: #111;
}

.bg-white {
  background-color: white;
  color: #111;
}

.bg-gray {
  background-color: var(--gray);
  color: #111;
}

.bg-primary-blue {
  background-color: var(--slcc-primary-blue);
  color: white;
}

/* colors - end */

/* global - start */
.p-text-bold {
  font-weight: 800;
}

.programs-container {
  position: relative;
  max-width: 1170px;
  margin: 0 auto;
}

.programs-button {
  min-width: 160px;
  font-weight: 900;
  text-transform: capitalize;
  padding: 16px 30px;
  font-size: 20px;
}

.p-button-primary {
  background-color: var(--slcc-primary-blue);
  color: white;
}

.p-button-blue {
  background-color: #00b3e3;
  color: var(--slcc-primary-blue);
}

.programs-container h2 {
  color: var(--slcc-primary-blue);
  font-weight: 900;
  font-size: 40px;
  margin-bottom: 30px;
}

.programs-iframe-div iframe {
  object-fit: cover;
  width: 100%;
  height: 340px;
}

/* global - end */

/* program banner - start */
.program-banner {
  width: 100%;
  position: relative;
  min-height: 280px;
  padding: 20px 30px;
}

.program-banner .banner-container {
  max-width: 1360px;
  margin: 0 auto;
}

.program-banner .banner-title-layout {
  display: flex;
  align-items: center;
}

.program-banner .banner-title-layout h1 {
  font-size: 46px;
  font-weight: 900;
  line-height: 3.6rem !important;
  padding-top: 30px;
}

.program-banner .banner-title-layout img {
  width: 200px;
  height: auto;
}

.program-banner .banner-text {
  font-size: 60px;
  font-weight: 900;
  text-align: right;
  line-height: 1;
}

.program-banner .banner-text-stroke-black {
  -webkit-text-stroke: 2px #111;
  color: transparent !important;
}

.program-banner .banner-text-stroke-white {
  -webkit-text-stroke: 2px white;
  color: transparent !important;
}

/* program banner - end */

/* col 2 div - start */
.col-2-div {
  display: flex;
  gap: 50px;
  justify-content: space-between;
  align-items: center;
}

.col-2-div>div {
  flex: 1;
}

.col-2-div img {
  width: 100%;
}

.col-2-div p {
  margin-bottom: 50px;
}

/* col 2 div - end */

/* col 4 div - start */
.programs-included-container h2 {
  color: white !important;
  text-align: center;
  margin-bottom: 60px;
  font-weight: 900;
  font-size: 32px;
}

.col-4-div {
  display: flex;
  gap: 50px;
  justify-content: space-between;

}
			
			.inner-card {
				min-width: 25%;
			}

.col-4-div h3 {
  font-weight: 900;
  font-size: 26px;
}

.col-4-div img {
  width: 100%;
  height: 150px;
  object-fit: cover;
  margin-bottom: 20px;
}

/* col 4 div - end */

/* bg div - start */
.cta-bg-div {
  background: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/bg-div.png');
  background-size: cover;
  background-repeat: no-repeat;
  padding: 44px 0;
}

.cta-bg-div p {
  font-weight: 900;
  font-size: 32px;
  margin-bottom: 0;
}

.cta-bg-div .programs-button {
  float: right;
}

/* bg div - end */

/* bubble bg - start */
.bubble-bg {
  background-repeat: no-repeat;
  background-position-x: 120%;
  background-position-y: 100%;
  background-size: 900px;
  background-color: white;
  overflow: hidden;
  color: #111;
}

.bubble-bg-blue {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_bubble-education.svg');
}

.bubble-bg-green {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_bubble-art.svg');
}

.bubble-bg-orange {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/bubble-health.svg');
}

.bubble-bg-red {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_bubble-culinary.svg');
}

.bubble-bg-steel-gray {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_bubble-transportation.svg');
}

.bubble-bg-yellow {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_bubble-stem.svg');
}

/* bubble bg - end */

/* illustration bg - start */
.illustration-bg {
  background-repeat: no-repeat;
  background-position: top left;
  background-size: 36%;
  background-color: white;
  overflow: hidden;
}

.illustration-bg-blue {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_education.svg');
}

.illustration-bg-green {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_art.svg');
}

.illustration-bg-orange {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_health.svg');
}

.illustration-bg-red {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_culinary.svg');
}

.illustration-bg-steel-gray {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_auto.svg');
}

.illustration-bg-yellow {
  background-image: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/pathway-illustrations/path-illustrations_stem.svg');
}

.illustration-bg-text {
  margin-top: 100px;
  margin-left: 36%;
}

/* illustration bg - end */

/* bottom tabs - start */
.programs-tabs .tab {
  overflow: hidden;
  width: 100%;
  display: flex;
  gap: 16px;
  justify-content: space-between;
}

.programs-tabs .tab button {
  flex-grow: 1;
  background-color: inherit;
  text-align: left !important;
  border: none;
  border-bottom: 10px solid var(--slcc-primary-blue);
  color: var(--slcc-primary-blue);
  outline: none;
  cursor: pointer;
  padding: 10px 16px 4px 16px;
  font-size: 22px;
  font-weight: 900;
}

.programs-tabs .tab button::after {
  font: var(--fa-font-solid);
  content: "\f0d7";
  float: right;
  margin-top: 6px;
}

.programs-tabs .tab button.active,
.programs-tabs .tab button:hover {
  background-color: var(--slcc-primary-blue);
  color: white;
}

.programs-tabs .programs-mobile-tab {
  display: none;
}

.programs-tabs .programs-panel {
  display: none;
  padding: 20px 20px 0 20px;
}

.programs-tabs .programs-detail {
  display: flex;
  gap: 40px;
  align-items: center;
}

.programs-tabs .programs-detail img {
  max-width: 400px;
  max-height: 220px;
  object-fit: cover;
  margin-bottom: 10px;
}

.programs-tabs .programs-detail p {
  margin: 6px 0;
}

.programs-tabs .programs-detail p:last-of-type {
  margin-bottom: 40px;
}

.programs-tabs .programs-button {
  font-size: 16px;
  padding: 10px 30px;
}

/* bottom tabs - end */
			@media only screen and (min-width: 1201px) and (max-width: 1400px) {
  .illustration-bg {
    padding-bottom: 100px;
  }
}

@media only screen and (min-width: 993px) and (max-width: 1200px) {
  .illustration-bg {
    padding-bottom: 20px;
  }
}

@media only screen and (max-width: 992px) {

  /* global - start */
  .programs-container {
    max-width: 100%;
    padding: 47px 30px;
  }

  .programs-container h2 {
    font-size: 36px;
  }

  .programs-iframe-div iframe {
    height: 300px;
    margin-bottom: 20px;
  }

  /* global - end */

  /* program banner - start */
  .program-banner {
    min-height: 150px;
    padding: 30px 0;
  }

  .program-banner .banner-container {
    max-width: 100%;
  }

  .program-banner .banner-title-layout h1 {
    font-size: 26px;
    line-height: 2.4rem !important;
    max-width: 100%;
  }

  .program-banner .banner-title-layout img {
    width: 100px;
  }

  .program-banner .banner-text {
    display: none;
  }

  /* program banner - end */

  /* col 2 div - start */
  .col-2-div {
    display: block;
  }

  .col-2-div img {
    margin-bottom: 30px;
  }

  /* col 2 div - end */

  /* col 4 div - start */
  .programs-included-container h2 {
    margin: 0 30px 30px 30px;
  }

  .programs-included-container .programs-container {
    padding: 67px 0;
  }

  .programs-included-container .programs-text {
    padding: 0 30px;
  }

  .col-4-div-container h2 {
    margin-bottom: 44px;
  }

  .col-4-div {
    display: block;
  }

  .col-4-div img {
    width: 100%;
    height: auto;
    max-height: 280px;
    object-fit: cover;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  /* col 4 div - end */

  /* bg div - start */
  .cta-bg-div {
    background: url('https://designstudio.moderncampus.com/clients/stlcc-programs/_resources/images/pathway/bg-div-mobile.png');
    background-position: center;
    padding: 40px 0 50px 0;
    text-align: center;
  }

  .cta-bg-div p {
    margin-bottom: 60px;
  }

  .cta-bg-div .programs-button {
    float: none;
  }

  /* bg div - end */

  /* bubble bg - start */
  .bubble-bg {
    background-position-x: 8%;
    background-position-y: 100%;
    background-size: 450px;
    background-color: white;
    overflow: hidden;
  }

  .bubble-bg .programs-container {
    padding-bottom: 60px;
  }

  /* bubble bg - end */

  /* illustration bg - start */
  .illustration-bg {
    background-position: bottom left;
    background-size: 350px;
    padding-bottom: 280px;
  }

  .illustration-bg-text {
    margin-top: 0;
    margin-left: 0;
    margin-bottom: 40px;
  }

  /* illustration bg - end */

  /* bottom tabs - start */
  .programs-tabs .tab {
    display: block;
  }

  .programs-tabs .programs-desktop-tab {
    display: none;
  }

  .programs-tabs .programs-mobile-tab {
    display: block;
  }

  .programs-tabs .tab button {
    width: 100%;
    border: 1px solid var(--slcc-primary-blue);
    padding: 16px;
    font-size: 18px;
  }

  .programs-tabs .tab button::after {
    margin-top: 4px;
  }

  .programs-tabs .tab button.active::after {
    font: var(--fa-font-solid);
    content: "\f0d8";
    float: right;
  }

  .programs-tabs .programs-panel {
    border: 1px solid var(--slcc-primary-blue);
    padding: 20px 20px 30px 20px;
  }

  .programs-tabs .programs-detail {
    display: block;
  }

  .programs-tabs .programs-detail img {
    width: 100%;
  }

  /* bottom tabs - end */
}
			.new-program-content {width:100%; display:table; margin-top:15px;}
			.new-program-content > div {display:table-row;}
			.new-program-content .new-program-video {width:50%; display:table-cell; vertical-align:middle; padding-right:15px}
			.new-program-content .new-program-video iframe {width:100%; aspect-ratio:16 / 9; outline:2px solid #002453;}
			.new-program-content .new-program-text {width:50%; display:table-cell; vertical-align:middle; padding-left:15px;}
			.new-program-content .new-program-career {width:50%; display:table-cell; vertical-align:middle;padding-right:15px; padding-left:20px;}
			.new-program-info {width:100%; display:table; margin-top:35px;}
			.new-program-info > div {display:table-row;}
			.new-program-info-left, .new-program-info-right {width:50%; display:table-cell; vertical-align:top; padding:0px 15px 0px 15px;}
			.new-program-info-left-content, .new-program-info-right-content {width:100%; display:table;}
			.new-program-info-left-content > div {display:table-row;}
			.new-program-info-right-content > div {display:table-row;}
			.new-program-info-icon {width:30px; display:table-cell; vertical-align:top}
			.new-program-info-text {display:table-cell; vertical-align:middle; padding:0px 20px 0px 20px;}
			.new-program-info-text p {font-size:22px}
			.new-program-info-text span {font-weight:600} 
			
			
			
			
			.new-program-at-a-glance {display:flex; flex-wrap:wrap; justify-content:center; margin-top:35px;}
			.new-program-at-a-glance div {flex-basis: 33.33%; text-align:center; padding:0px 20px 15px 20px;}
			
			
			
			.new-program-contact-text {display:table-cell; vertical-align:middle; padding:0px 20px 0px 20px;}
			.new-program-contact-name {font-size:22px}
			.custom-style--career-widget-single-column {width:100%; background:#eee;}
			.custom-style--data-column {width:100%; background:transparent;}
		
	
                      /* NEW EVENTS FEED - start */
                      .event-item {
                        margin-bottom: 15px;
                      }


                      .event-item-header,
                      .event-item-header h3 {
                        font-size: 18px;
                        line-height: 24px;
                      }


                      .event-item-header a {
                        text-decoration: none;
                        color: #013b70;
                      }


                      .event-item-header a:hover,
                      .event-item-header a:focus {
                        text-decoration: underline;
                      }


                      .event-item-copy p {
                        margin-bottom: 5px;
                      }


                      .event-item-date {
                        font-size: 12px;
                      }


                      .events .event-item {
                        display: table;
                        margin-bottom: 20px;
                        position: relative;
                      }


                      .events .event-item .event-date,
                      .events .event-item .event-text {
                        display: table-cell;
                        position: relative;
                      }


                      .event-item .event-date .event-month {
                        display: block;
                        text-align: center;
                        text-transform: uppercase;
                        font-size: 20px;
                        font-weight: bold;
                        color: white;
                      }


                      .event-item .event-date .event-day {
                        display: block;
                        text-align: center;
                        font-size: 40px;
                        font-weight: bold;
                        color: white;
                      }


                      .event-item .event-date .year {
                        color: white;
                        text-align: center;
                        display: block;
                      }


                      .event-item .event-text {
                        position: relative;
                        vertical-align: top;
                        padding-left: 20px;
                      }


                      .event-item .event-date-bg {
                        background-color: #013b70;
                        padding: 10px 20px 20px 20px;
                        line-height: 36px;
                        border-radius: 4px;
                      }


                      .event-item .event-item-time-location {
                        margin-bottom: 10px;
                      }


                      .event-item .event-item-time-location .time:before {
                        display: inline-block;
                        font-style: normal;
                        font-variant: normal;
                        text-rendering: auto;
                        -webkit-font-smoothing: antialiased;
                        font-family: "Font Awesome 6 Pro";
                        font-weight: 900;
                        content: "\f017";
                        font-size: 14px;
                        margin-right: 5px;
                        color: #013b70;
                      }


                      .event-item .event-item-time-location .location {
                        margin-left: 10px;
                      }


                      .event-item .event-item-time-location .location:before {
                        display: inline-block;
                        font-style: normal;
                        font-variant: normal;
                        text-rendering: auto;
                        -webkit-font-smoothing: antialiased;
                        font-family: "Font Awesome 6 Pro";
                        font-weight: 900;
                        content: "\f3c5";
                        font-size: 14px;
                        margin-right: 5px;
                        color: #013b70;
                      }


                      /* responsive */
                
                    
