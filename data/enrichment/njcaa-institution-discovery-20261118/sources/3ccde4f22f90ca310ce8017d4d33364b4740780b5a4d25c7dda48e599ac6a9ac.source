				.main-content {margin-top:-16px}
			}
		</style>
      		
      		
      		<!-- Content Blocks with Images -->
      		
      <style>
			.content-block-top {background-color:#eee; border-top-left-radius:60px;}
			
			.content-block-video {width:100%; display:flex; flex-wrap:wrap; align-items:center; margin-top:8px;}
			.content-block-video-iframe, .content-block-video-text {width:50%}
			.content-block-video-iframe .pathways-video {width:100%; aspect-ratio:16 / 9; border:none; border-radius:8px;}
			.content-block-video > div:nth-child(odd) {padding-right:15px;}
			.content-block-video > div:nth-child(even) {padding-left:15px;}
			.content-block-video #blue-button-snippet {margin-bottom:5px;}
			
			@media (max-width:699px){
				.content-block-video-iframe {order:1}
				.content-block-video-text {order:2; padding-top:45px;}
				.content-block-video-iframe, .content-block-video-text {width:100%}
				.content-block-video > div:nth-child(odd) {padding-right:0px}
				.content-block-video > div:nth-child(even) {padding-left:0px}
				.content-block-video #blue-button-snippet {margin-bottom:0px}
			}
		</style>
      		
      		<!-- Buttons -->
      		
      <style>
			.blue-button-snippet-inverse-home {background-color:#fff !important; border:2px solid #003a70; color:#003a70 !important; transition:0.1s linear;}
			.blue-button-snippet-inverse-home:hover {background-color:#00b3e3 !important; color:#003a70 !important;}			
			.pathways-catalog-button-container {text-align:center; margin:30px 0px 30px 0px;}
			
			@media (max-width:992px){
				.pathways-catalog-button-container {margin-top:40px; margin-bottom:36px;}
			}
		</style>
      		
      		<!-- Pathways Home Page CTA -->
      		
      <style>
			.pathways-home-page-cta {width:100%; background-color:#fff; display:flex; flex-wrap:wrap; align-items:center; margin-top:130px; margin-bottom:10px;}
