      	<!-- Page Layout -->
      		
      <style>
			#main {background-color:#fff}
			#main #content {padding-top:0px}
			.hero-block .holder > * {vertical-align:bottom;}
			.hero-block h1 {font-weight:600; font-size:40px;}
			.breadcrumbs ul {padding:20px 32px 75px}
			.pathways-container {max-width:1170px; margin:0px auto; padding:50px 30px 50px 30px;}
			.pathways-container-top {padding-top:0px}
			.pathways-tabs-container {max-width:1170px; margin:0px auto; padding:15px 30px 45px 30px;}
			.pathways-container h2 {font-size:40px; line-height:1; font-weight:bold; color:#003a70;}
			.pathways-container h2.default-headline {font-size:30px; font-weight:600; line-height:1; color:#111;}
			.pathways-container .content-center-text h2 {text-align:center}
			.pathways-tabs-container h2 {font-size:40px; line-height:1; font-weight:bold; color:#003a70;}
			.pathways-tabs-container a {text-decoration:underline;}
			.pathways-outline-blue {-webkit-text-fill-color:white; -webkit-text-stroke-width:1.5px; -webkit-text-stroke-color:#003a70;}
			.pathways-container .accordion-section-title {background:#fff; color:#111;}
			.snippets-container {background-color:#fff; padding:50px 30px 50px 30px;}
			.snippets-container .programs-container {padding:0;}
			.snippets-container a {text-decoration:underline;}
			.content-center-text {text-align:center}
			
			@media (max-width:992px){
				.program-banner .banner-title-layout h1 {font-size:32px; padding-top:20px !important}
				.main-content {margin-top:-6px}
			}
			
			@media (min-width:699px){
				.hero-block .holder {height:410px; padding:20px 45px;}
			}
			
			@media (max-width:699px){
				.hero-block .holder {height:260px; padding:20px 30px;}
				.hero-block h1 {font-size:40px}
				.hero-block .holder:after {display:inline-block}
				.pathways-container {padding:40px 30px 40px 30px;}
				.pathways-container h2 {font-size:38px;}
				.pathways-container h2.default-headline {font-size:28px;}
				.pathways-tabs-container h2 {font-size:38px;}
			}
		</style>
      		
      	<!-- Page Layout Home Demo-->
      		
      <style>
			.hero-block .holder > * {vertical-align:middle}
			.hero-block . caption-wrap {max-width:600px;}
			.pathways-home-page-demo h1 {font-size:40px; font-weight:bold;}
			.pathways-home-page-demo h1 span {-webkit-text-fill-color:transparent; -webkit-text-stroke-width:2px; -webkit-text-stroke-color:#fff;}
			.stlcc-background-logo {background-image:url(https://stlcc.edu/images/logos-icons/stlcc-home-page-demo-bg-logo.png); background-position:top right; background-position-y:-130px; background-size:770px; background-repeat:no-repeat;}
			.stlcc-whats-happening {background-color:#d8dfe2}
			.whats-happening-content {width:100%; display:flex; flex-wrap:wrap; align-items:top; justify-content:space-between; margin-top:50px;}
			.whats-happening-events {width:61%; background-color:#fff; padding:50px 30px 30px 30px;}
			.whats-happening-news {width:37%; background-color:#fff; background-image:url(https://stlcc.edu/images/logos-icons/stlcc-home-page-demo-bg-archie.png); background-repeat:no-repeat; padding:50px 30px 30px 30px;}
			.whats-happening-news-articles div {border-bottom:2px solid #003a70; padding-top:10px;}
			.whats-happening-news-articles div:last-child {border-bottom:none;}
			
			.news-article-headline {font-weight:bold}
			.news-article-content {font-size:16px}
			.news-article-info {font-style:italic; font-size:16px}
			
			.education-for-life {background-color:#003a70}
			.education-for-life h2 {color:#fff !important; text-align:center;}
			.education-for-life-icons {width:100%; display:flex; flex-wrap:wrap; align-items:top; justify-content:space-around;}
			.education-for-life-icon {width:20%; text-align:center; padding:4px;}
			.education-for-life-icon a {text-decoration:none; font-weight:bold; color:#fff;}
			.education-for-life-icon i {display:block; font-size:50px; line-height:1.25;}
			.education-for-life-icon a:hover {color:#00b3e3; transition:0.05s linear;}
			
			.pathways-to-success-home {background-color:#003a70}
			.pathways-to-success-home h2 {font-size:60px; color:#fff !important;}
			.pathways-to-success-home .content-block-video-text {color:#fff}
			.pathways-to-success-home .cta-text-stroke-white {-webkit-text-fill-color:transparent; -webkit-text-stroke-width:2px; -webkit-text-stroke-color:#fff;}
			.pathways-to-success-home-spacer {width:100px; height:15px; background-color:#00b3e3;}
			
			@media (max-width:992px){
				.whats-happening-events {width:100%}
				.whats-happening-news {width:100%; background-position:top center; margin-top:35px;}
			}

			@media (max-width:699px) {
				.hero-block .holder {height:360px; padding:0px;}
				.hero-block .holder > * {vertical-align:bottom}
				.stlcc-background-logo {background-position:bottom center; background-position-y:100%; background-size:120px;}
				.hero-block .caption-wrap {max-width:100%; width:100%; background:rgba(0, 58, 112, .65); padding:20px 30px 25px 30px;}
				.pathways-home-page-demo h1 {min-height:0px; font-size:40px; padding-top:0;}
				.education-for-life-icon {width:50%; padding:12px;}
				
				.pathways-to-success-home h2 {font-size:42px}
				.pathways-to-success-home-spacer {width:80px; height:10px;}
			}
		
		</style>
      		
      		<!-- Breadcrumb Remove -->
      		
      <style>
			.breadcrumbs {display:none}
			.main-content {margin-top:0px}
			.content-block-top {border-top-left-radius:0px !important;}
			
			@media (max-width:1023px){
				.main-content {margin-top:-20px}
			}
			
			@media (max-width:992px){
				.main-content {margin-top:-25px}
			}
			
