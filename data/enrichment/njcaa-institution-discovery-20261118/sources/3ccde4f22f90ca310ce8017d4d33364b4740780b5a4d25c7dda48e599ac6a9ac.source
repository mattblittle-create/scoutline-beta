         <div id="hidden" style="display:none;"><a id="de" href="https://a.cms.omniupdate.com/11/?skin=stlcc&amp;account=master&amp;site=Pub_website&amp;action=de&amp;path=/index.pcf">© </a></div><a class="accessibility" accesskey="t" href="#wrapper">Back to top</a></div><script>
			document.addEventListener("DOMContentLoaded", function() {
				const accordionButtons = document.querySelectorAll(".programs-accordion");
				const panels = document.querySelectorAll(".programs-panel");
				let isSmallScreen = window.innerWidth >= 992;

				// Function to toggle the display of a panel
				function togglePanel(panelId) {
					panels.forEach(panel => {
						if (panel.id === panelId) {
							if (isSmallScreen) {
								// Toggle the display property for small screens
								panel.style.display = panel.style.display === "block" ? "none" : "block";
							} else {
								panel.style.display = "block";
							}
						} else {
							panel.style.display = "none";
						}
					});

					accordionButtons.forEach(button => {
						if (button.id === `programsAcc_${panelId.split('_')[1]}`) {
							button.classList.toggle("active");
						} else {
							button.classList.remove("active");
						}
					});
				}

				// Initial setup
				togglePanel("programsAccPanel_1"); // Activate the first panel

				// Event listener for button clicks
				accordionButtons.forEach(button => {
					button.addEventListener("click", function() {
						const panelId = button.id.replace("programsAcc", "programsAccPanel");
						togglePanel(panelId);
					});
				});

				// Update the isSmallScreen variable on window resize
				window.addEventListener("resize", function() {
					isSmallScreen = window.innerWidth >= 992;
				});
			});
		</script><script src="/_resources/js/alert-message.js"></script></body>
</html>