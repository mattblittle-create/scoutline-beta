kets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/11/3/A7R05253.JPG","image_focal_point":null,"image_alt_text":"Christian","video":null,"url":"/news/2026/11/3/general-christian-molina-earns-swac-all-conference-third-team-honors.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":2,"locked_ranking":false,"id":3937,"content_id":"3937","content_title":"Christian Molina Earns SWAC All-Conference Third Team Honors","content_date":"2026-11-03T11:11:00","content_url":"https://athletics.cncc.edu/news/2026/11/3/general-christian-molina-earns-swac-all-conference-third-team-honors.aspx","content_image_url":"https://athletics.cncc.edu/images/2026/11/3/A7R05253.JPG","date":"2026-11-03T11:11:00"},{"title":"CNCC Cross Country Builds Momentum, Sends Six Spartans to Nationals","title_in_rotator":true,"sub_headline":null,"teaser":"<p data-pm-slice=\"1 1 []\">CNCC Cross Country is headed to the national stage.</p>\r\n\r\n<p>Six Spartans will represent Colorado Northwestern Community College at the 2026 NJCAA Cross Country National Championships in Huntsville, Alabama, on November 14. After a season filled with personal bests, growing confidence, and national recognition, CNCC is ready to see how it stacks up against the best in the country.</p>\r\n\r\n<p>With six national qualifiers, three individually ranked runners, and the team earning a spot in the national rankings, the Spartans have built serious momentum heading into Huntsville.</p>\r\n\r\n<p>Read more about CNCC Cross Country's road to nationals and the athletes representing the Spartans on the national stage.</p>\r\n","type":null,"byline":null,"app_exclusive":false,"sport_display":"General, Men's Cross Country/Track","sport":{"id":10,"title":"Men's Cross Country/Track","abbreviation":"MXC","shortname":"xc","short_title":"Men's Cross Country/Track","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"cross","gender":"g","youtube":"","facebook":null,"twitter":"","instagram":"","pinterest":"","tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"sport_shortname":null,"image_source":"/images/2026/11/1/NJCAA_National_Photo.png","image_focal_point":null,"image_alt_text":"NJCAA XC","video":null,"url":"/news/2026/11/2/mens-cross-country-track-cncc-cross-country-builds-momentum-sends-six-spartans-to-nationals.aspx","redirect_absolute_url":null,"links":null,"homepage_feed_template":"story_links","game_id":null,"games":[],"gallery_id":0,"writer":null,"ranking":3,"locked_ranking":false,"id":3936,"content_id":"3936","content_title":"CNCC Cross Country Builds Momentum, Sends Six Spartans to Nationals","content_date":"2026-11-02T09:00:00","content_url":"https://athletics.cncc.edu/news/2026/11/2/mens-cross-country-track-cncc-cross-country-builds-momentum-sends-six-spartans-to-nationals.aspx","content_image_url":"https://athletics.cncc.edu/images/2026/11/1/NJCAA_National_Photo.png","date":"2026-11-02T09:00:00"},{"title":"Spartans Break Through for First Conference Win in Seven Years","title_in_rotator":true,"sub_headline":null,"teaser":"Colorado Northwestern Community College Volleyball earned a major accomplishment Friday night, defeating Truckee Meadows Community College in a five-set battle, 3-2, for the program's <strong>first conference victory in seven years</strong>. The win marks an exciting step forward for the Spartans under the new leadership of Interim Head Coach <strong>Doug Merrill</strong>.","type":"postgame","byline":null,"app_exclusive":false,"sport_display":"Women's Volleyball","sport":{"id":7,"title":"Women's Volleyball","abbreviation":"WVBALL","shortname":"wvball","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":"wvball","gender":"f","youtube":"","facebook":null,"twitter":""