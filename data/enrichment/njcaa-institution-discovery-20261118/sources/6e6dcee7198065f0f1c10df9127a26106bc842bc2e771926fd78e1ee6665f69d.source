    <div class="component c-awards c-awards--slider" data-bind="afterBind: {foreach: data, callback: slick}" data-slick-options="{arrows: true, infinite: false, slidesToShow: 1, slidesToScroll: 1, adaptiveHeight: false, autoplay: true, autoplaySpeed: 8000, pausable:true}">
        <div class="c-awards__item">
