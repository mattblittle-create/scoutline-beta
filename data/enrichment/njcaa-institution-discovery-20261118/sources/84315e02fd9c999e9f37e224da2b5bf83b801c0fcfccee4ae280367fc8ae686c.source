<!-- homepage-bs5.min.js -->
<script src="https://pxl-elginedu.terminalfour.net/prod01/cdn-pxl-elginedu-prod/media/website/site-assets/js/bootstrap/v523/homepage-bs5.min.js"></script> 
  <script>
  if("" === "College Meetings"){
    findEvents('https://elgin.edu/calendar/xml-bot/', 2490665, "", "", "" , "", 10, 1, "myelgin-homepage", "");
  }else{
	findEvents('https://elgin.edu/calendar/xml/', 2490665, "", "", "" , "", 10, 1, "myelgin-homepage", "", '');
  }
  
  var pickButton = "";
  if(pickButton === "Yes" && pickButton != null){  
    function registerWithTitle(dateStr, title) {
      const session = '';
      var scriptSrc;
      const [mm, dd, yyyy] = dateStr.split("/").map(Number);
      const enterDate = new Date(yyyy, mm - 1, dd);
      const reminderDate = new Date(enterDate);
      reminderDate.setDate(reminderDate.getDate() - 1);
      const pad = (n) => String(n).padStart(2, "0");
      var params = new URLSearchParams({
          "enterA[month]": pad(enterDate.getMonth() + 1),
          "enterA[day]": pad(enterDate.getDate()),
          "enterA[year]": enterDate.getFullYear(),
          "reminderDate[month]": pad(reminderDate.getMonth() + 1),
          "reminderDate[day]": pad(reminderDate.getDate()),
          "reminderDate[year]": reminderDate.getFullYear(),
          session
      });
      if(session === "Writers Center"){
        //scriptSrc = `https://elginedu.jotform.com/jsform/252963425149968?enterA=${dateStr}&type=${encodeURIComponent(title)}`;
        scriptSrc = `https://elginedu.jotform.com/jsform/252963425149968?${params.toString()}&type=${encodeURIComponent(title)}`;
      }
      
      const modalEl = document.getElementById('formModal');
      const wrapper = modalEl.querySelector('#jotform-wrapper');
      wrapper.innerHTML = '';

      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = scriptSrc;
      wrapper.appendChild(script);

      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    }
    function register(dateStr, timeStr, LocationStr) {
      const encodedDate = dateStr;
      const session = '';
      var scriptSrc;
      
      // Prefer the clicked title ONLY for Writers Center
      const effectiveType = (session === "Writers Center" && typeFromTitle)
        ? typeFromTitle
        : session;
      
        const [mm, dd, yyyy] = dateStr.split("/").map(Number);
        const enterDate = new Date(yyyy, mm - 1, dd);
      
        // Sessions that only need a 24-hour reminder
        const oneDayReminderSessions = [
          "Resume Workshop",
          "Interview Workshop",
          "WIOA Information Session",
          "Pre-Apprenticeship Inquiry",
          "Fire Science and Safety",
          "Certified Recovery Support Specialist"
        ];
      
        // Everything else (Health Professions) gets 48 hours
        const reminderOffsetDays = oneDayReminderSessions.includes(session) ? 1 : 2;
        const reminderDate = new Date(enterDate);
        reminderDate.setDate(reminderDate.getDate() - reminderOffsetDays);
        const pad = (n) => String(n).padStart(2, "0");
        var params = new URLSearchParams({
          "enterA[month]": pad(enterDate.getMonth() + 1),
          "enterA[day]": pad(enterDate.getDate()),
          "enterA[year]": enterDate.getFullYear(),
          "reminderDate[month]": pad(reminderDate.getMonth() + 1),
          "reminderDate[day]": pad(reminderDate.getDate()),
          "reminderDate[year]": reminderDate.getFullYear(),
          session
        });
      
      if(session === "Resume Workshop" || session === "Interview Workshop"){
        params.append("eTime", timeStr);
        params.append("eLocation", LocationStr);
        scriptSrc = `https://elginedu.jotform.com/jsform/252265205322952?${params.toString()}&type=${encodeURIComponent(session)}`;
        //scriptSrc = `https://elginedu.jotform.com/jsform/252265205322952?enterA=${dateStr}&type=${encodeURIComponent(session)}`;
      }else if(session === "WIOA Information Session"){
        params.append("eTime", timeStr);
        params.append("eLocation", LocationStr);
        scriptSrc = `https://elginedu.jotform.com/jsform/222285290720957?${params.toString()}`;
      }else if(session === "Pre-Apprenticeship Inquiry"){
        params.append("eTime", timeStr);
        params.append("eLocation", LocationStr);
        scriptSrc = `https://elginedu.jotform.com/jsform/252664819834974?${params.toString()}`;
      }else if(session === "Truck Driving"){
        scriptSrc = `https://elginedu.jotform.com/jsform/242056430791959?${params.toString()}`;
      }else if(session === "Fire Science and Safety"){
        scriptSrc = `https://elginedu.jotform.com/jsform/232336167814861?enterA=${dateStr}&session=${encodeURIComponent(session)}`;
      }else if(session === "Certified Recovery Support Specialist"){
        scriptSrc = `https://elginedu.jotform.com/jsform/260425535688970?${params.toString()}`;
      }else{ //Health profession information session
        params.append("eTime", timeStr);
        params.append("eLocation", LocationStr);
        scriptSrc = `https://elginedu.jotform.com/jsform/230094381441955?${params.toString()}&type=${encodeURIComponent(session)}`;
      }

      // Get modal and form wrapper
      const modalEl = document.getElementById('formModal');
      const wrapper = modalEl.querySelector('#jotform-wrapper');

      // Clear previous form if any
      wrapper.innerHTML = '';

      // Inject new JotForm script with dynamic prefill
      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = scriptSrc;
      wrapper.appendChild(script);

      /*Update URL (optional)
      const url = new URL(window.location);
      if(session === "Resume Workshop" || session === "Interview Workshop"){
        url.searchParams.set('type', session);
      }else{
        url.searchParams.set('Session', session);
      }window.history.pushState({}, '', url);*/
    
      // Show the modal
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    }
  } //End of if looop
</script>
  <script>
(() => {
  const video = document.getElementById('backgroundVideo');
  const img = document.getElementById('backgroundImage');
  if (!video || !img) return;

  const mqDesktop = window.matchMedia('(min-width: 576px)');

  const showImg = () => img.classList.remove('is-hidden');
  const hideImg = () => img.classList.add('is-hidden');

  const isVideoVisible = () => getComputedStyle(video).display !== 'none';

  // Prevent "stuck hidden" after resizing (removes inline display overrides on desktop)
  const normalizeVideoDisplay = () => {
    if (mqDesktop.matches) video.style.display = '';
  };

  const ensureVideoSrc = () => {
    // If src already exists, do nothing
    if (video.getAttribute('src')) return true;

    // Attach from data-src
    const ds = (video.getAttribute('data-src') || '').trim();
    if (!ds) return false;

    video.setAttribute('src', ds);
    video.load();
    return true;
  };

  const tryPlay = () => {
    const p = video.play && video.play();
    if (p && typeof p.catch === 'function') p.catch(() => {});
  };

  const sync = () => {
    normalizeVideoDisplay();

    // Mobile OR CSS-hidden video => image stays visible
    if (!mqDesktop.matches || !isVideoVisible()) {
      showImg();
      try { video.pause(); } catch (e) {}
      return;
    }

    // Desktop: keep image visible for LCP, then hide only when video plays
    showImg();

    const onPlaying = () => {
      if (mqDesktop.matches && isVideoVisible()) hideImg();
    };
    video.addEventListener('playing', onPlaying, { once: true });

    // If already playing
    if (!video.paused && video.readyState >= 3) onPlaying();
  };

  // IMPORTANT: attach video src only after window.load (keeps MP4 from competing with LCP)
  const attachAfterLoad = () => {
    if (ensureVideoSrc()) tryPlay();
    sync();
  };

  // Initial run (shows image immediately, handles mobile/desktop state)
  sync();

  // Attach mp4 only after load
  if (document.readyState === 'complete') {
    attachAfterLoad();
  } else {
    window.addEventListener('load', attachAfterLoad, { once: true });
  }

  // Keep in sync across breakpoint changes / resizes
  if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', sync);
  window.addEventListener('resize', sync, { passive: true });
})();
</script>
