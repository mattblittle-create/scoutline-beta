    // Create input elements
    var firstInput = document.createElement('input');
    firstInput.id = 'current-' + outerDiv.id;
    firstInput.type = 'hidden';

    var secondInput = document.createElement('input');
    secondInput.id = 'show-' + outerDiv.id;
    secondInput.type = 'hidden';

    // Create the events div
    var eventsDiv = document.createElement('div');
    eventsDiv.className = 'events';
    
    // Create the heading h2
    var heading = document.createElement('h2');
    heading.innerHTML = 'Upcoming Events';

    // Create the border div
    var borderDiv = document.createElement('div');
    borderDiv.className = 'mb-3';

    // Create loader div
    var loaderDiv = document.createElement('div');
    loaderDiv.id = 'events-loader-' + outerDiv.id;
    loaderDiv.className = 'events-loader';
    loaderDiv.style.display = 'none';

    var progressDiv = document.createElement('div');
    progressDiv.className = 'events-progress';

    var progressBarDiv = document.createElement('div');
    progressBarDiv.className = 'events-progress-bar';

    var loaderText = document.createElement('p');
    loaderText.className = 'small';
    loaderText.textContent = 'Please wait while we load event information.';

    progressDiv.appendChild(progressBarDiv);
    loaderDiv.appendChild(progressDiv);
    loaderDiv.appendChild(loaderText);

    // Create the list group div
    var listGroupDiv = document.createElement('div');
    listGroupDiv.id = 'content-' + outerDiv.id;
    listGroupDiv.className = 'list-group';

    // Create the page navigation div
    var pageNavigationDiv = document.createElement('div');
    pageNavigationDiv.id = 'page_navigation-' + outerDiv.id;

    // Create calendar link
    var calLink = document.createElement('a');
    calLink.className = 'my-3';
    calLink.id = 'eCalBtn';
    calLink.href = 'https://elgin.edu/calendar/';
    calLink.title = 'Full Calendar';
    calLink.textContent = 'Full Calendar';

    // Append the elements to their respective parents
    pageNavigationDiv.appendChild(calLink);

    borderDiv.appendChild(loaderDiv);
    borderDiv.appendChild(listGroupDiv);
    borderDiv.appendChild(pageNavigationDiv);

    eventsDiv.appendChild(heading);
    eventsDiv.appendChild(borderDiv);

    outerDiv.appendChild(firstInput);
    outerDiv.appendChild(secondInput);
    outerDiv.appendChild(eventsDiv);

    targetDiv.appendChild(outerDiv);
  });
</script>	</main>	
