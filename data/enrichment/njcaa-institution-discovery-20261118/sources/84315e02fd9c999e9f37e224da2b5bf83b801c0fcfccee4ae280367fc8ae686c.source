<section id="ecc-news-">
	<!-- News in Card format -->
	<div id="hp-events-news" class="container-fluid overflow-hidden px-4">
		<div class="container">
	
		<div class="row gx-5">
			<p>&nbsp;</p>
			<div class="col-md-12">
				<h2 class="fs-1">Keeping up with ECC</h2>
				<p>Hear from students, faculty, and staff about the incredible learning community in Elgin through blog posts, news releases, and quick ECC stories.</p>
			</div>
			
	<div class="flex-row row gx-5 mb-5 pe-0">		
			
			<div class="col-md-12 col-lg-4 mb-5 hp-events"><!--hp-item scroll-reveal box left"-->
					<div class="card bg-white border-0"><!-- shadow-sm"-->
						<div class="card-header fw-bold">
							<h3>Upcoming Events</h3>
						</div>
						<!-- Navigation - Homepage Events -->
						<div class="card-body bg-white" id="c-widget">
							<div id="events-loader-2490665" class="events-loader" style="display:none;">
    <div class="events-progress">
    	<div class="events-progress-bar"></div>
    </div>
	<p class="small text-black">Please wait while we load event information.</p>
</div>
<ul id="content-2490665" class="list-unstyled m-0 p-0">

</ul>
						</div>
						<div class="card-footer bg-transparent">
							<p class="card-text">
								<a class="btn btn-link p-0" href="/calendar/" aria-label="View Calendar"><!-- removed btn-sm -->
									View Calendar<span class="fa-solid fa-chevron-right" aria-hidden="true"></span></a>
							</p>
						</div>
					</div>
				</div>
			
			<div id="hp-news"  class="col-md-12 col-lg-8">
			<div class="row row-cols-1 row-cols-md-2 g-4">
				         <div class="col hp-item">
			<div class="card h-100">
				<div class="flex-shrink-0">
    <img src="https://pxl-elginedu.terminalfour.net/filters:format(webp)/prod01/cdn-pxl-elginedu-prod/media/elginedu/news-and-events/featured/original/Amari001.jpg" class="flex-shrink-0 me-3 p-0 img-thumbnail shadow-sm d-none d-sm-block ls-is-cached lazyloaded" alt="Poet Amari Amai read a poem at ECC's Writers Center's Open Mic Coffee House on November 3, 2026."> </div>
					<div class="card-body">
			    		<p class="card-text">ECC's Writers Center's Open Mic Coffee House event brought students and community together on November 3, where Chicago Poet Amari Amai led the event. </p>
					</div>
					<div class="card-footer">
    <a href="/news/ecc-stories/2026/chicago-poet-leads-writing-workshop-at-eccs-open-mic-coffee-house.php" title="Chicago Poet Leads Writing Workshop at ECC’s Open Mic Coffee House" aria-label="Read Story about how Chicago Poet Leads Writing Workshop at ECC&rsquo;s Open Mic Coffee House">Read story<span class="fa-solid fa-chevron-right" aria-hidden="true"></span></a>
</div>
          	</div>
		</div>        <div class="col hp-item">
			<div class="card h-100">
				<div class="flex-shrink-0">
    <img src="https://pxl-elginedu.terminalfour.net/filters:format(webp)/prod01/cdn-pxl-elginedu-prod/media/elginedu/news-and-events/featured/original/MiguelM800X500.jpg" class="flex-shrink-0 me-3 p-0 img-thumbnail shadow-sm d-none d-sm-block ls-is-cached lazyloaded" alt="ECC Police Officer Miguel Martinez poses next to an ECC Police car."> </div>
					<div class="card-body">
			    		<p class="card-text">As a first-generation college student, Miguel Martinez found direction and inspiration through ECC&rsquo;s Criminal Justice Program. Among those who influenced him were Richard Martin, the program director at the time and an Indiana State Trooper, and Jane Barbosa, who founded ECC's Organization of Latin American Students.&nbsp;</p>
					</div>
					<div class="card-footer">
    <a href="/news/ecc-stories/2026/alum-returns-to-ecc-as-a-police-officer-.php" title="Alum Returns to ECC as a Police Officer " aria-label="Read Story about how Alum Returns to ECC as a Police Officer ">Read story<span class="fa-solid fa-chevron-right" aria-hidden="true"></span></a>
</div>
          	</div>
		</div>        <div class="col hp-item">
			<div class="card h-100">
				<div class="flex-shrink-0">
    <img src="https://pxl-elginedu.terminalfour.net/filters:format(webp)/prod01/cdn-pxl-elginedu-prod/media/elginedu/news-and-events/featured/original/Rachael-S-class.jpg" class="flex-shrink-0 me-3 p-0 img-thumbnail shadow-sm d-none d-sm-block ls-is-cached lazyloaded" alt="English professor Rachael Stewart teaches her class."> </div>
					<div class="card-body">
			    		<p class="card-text">As her retirement approaches, English professor Rachael Stewart reflects on her career at ECC, which began in the 1990s. </p>
					</div>
					<div class="card-footer">
    <a href="/news/ecc-stories/2026/longtime-english-faculty-has-only-ever-wanted-to-teach-at-ecc.php" title="Longtime English Faculty Has Only Ever Wanted to Teach at ECC" aria-label="Read Story about how Longtime English Faculty Has Only Ever Wanted to Teach at ECC">Read story<span class="fa-solid fa-chevron-right" aria-hidden="true"></span></a>
</div>
          	</div>
		</div>        <div class="col hp-item">
			<div class="card h-100">
