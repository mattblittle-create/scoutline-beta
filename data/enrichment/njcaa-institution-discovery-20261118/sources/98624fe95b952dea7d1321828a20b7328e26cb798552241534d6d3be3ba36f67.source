.ribbon {
  font-size: 21px;
  font-weight: bold;
  color: #fff;
    margin-bottom:-130px;
  position:absolute;
  right:0;
}
.ribbon {
  --r: .8em; /* control the cutout */
  
  border-block: .5em solid #0000;
  padding-inline: calc(var(--r) + .25em) .5em;
  line-height: 1.8;
  clip-path: polygon(0 0,100% 0,100% 100%,0 100%,var(--r) calc(100% - .25em),0 50%,var(--r) .25em);
  background:
   radial-gradient(.2em 50% at right,#000a,#0000) border-box,
   #C75300 padding-box; /* the color  */
  width: fit-content;
}
 
  .ribbon a {font-family:rubik, verdana, sans-serif; text-decoration:none; color:#FFF; font-weight:bold; font-size:21px;}
  .ribbon a:hover {color:#FAEBBE;}
</style></div>
      
