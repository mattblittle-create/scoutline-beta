  <section class="paragraph paragraph--type--paragraph-views-reference background-grey paragraph--view-mode--default"  id="panel-recent-news"  >
         <div class="container">           <div class="view-header">
        <div class="row">
          <div class="col col-12 col-lg-6"><h3 class="viewsreference--view-title animated">
    Recent News
</h3>
</div>
          <div class="col col-12 col-lg-6">
  <div class="field animated field--name-field-paragraph-header-text field--type-text-long field--label-hidden field--item"><p>Keep up with what's happening at Northeastern; stay tuned here!</p>

<p><a href="https://www.njc.edu/news" class="button small black solid" target title><span class="button-text">View all news</span></a></p></div>
</div>
        </div>
      </div>
              
