av-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Quick Links</a>  <ul class="dropdown-menu">    <li><a class="dropdown-item" href="https://portal.louisburg.edu/eStudent/login.asp"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Student Portal</a></li>    <li><a class="dropdown-item" href="https://louisburg.instructure.com/"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Canvas</a></li>    <li><a class="dropdown-item" href="/calendar"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Calendar</a></li>    <li><a class="dropdown-item" href="https://www.jpacarts.com/"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>JPAC</a></li>    <li><a class="dropdown-item" href="/news"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>News</a></li>    <li><a class="dropdown-item" href="/academics/library"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Library</a></li>    <li><a class="dropdown-item" href="/map"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Campus Map</a></li>    <li><a class="dropdown-item" href="/directory"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Directory</a></li>    <li><a class="dropdown-item" href="/canes-store"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Canes Store</a></li>    <li><a class="dropdown-item" href="http://gmail.louisburg.edu/"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Campus Email</a></li>  </ul></li><li class="nav-item ms-lg-auto"><a class="btn btn-red btn-sm ms-0 ms-lg-2 text-nowrap cta-tile" href="/give"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Give</a></li>      </ul>    </div>  </div></nav><nav class="main-nav navbar navbar-expand-lg" aria-label="Main"><div class="container-fluid"><a class="navbar-brand" href="/"><img src="/assets/images/louisburg-college.png" alt="Louisburg College"></a><button class="navbar-toggler border-0" type="button"data-bs-toggle="collapse"data-bs-target="#louisburg-college-main-nav"aria-controls="louisburg-college-main-nav"aria-expanded="false"aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse justify-content-end" id="louisburg-college-main-nav"><ul class="navbar-nav align-items-lg-center"><li class="nav-item"><a class="nav-link" href="/about"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>About</a></li><li class="nav-item"><a class="nav-link" href="/academics"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Academics</a></li><li class="nav-item"><a class="nav-link" href="/admissions"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Admissions</a></li><li class="nav-item"><a class="nav-link" href="/campus-life"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Campus Life</a></li><li class="nav-item"><a class="nav-link" href="https://www.lchurricanes.com/landing/index"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Athletics</a></li><li class="nav-item"><a class="nav-link" href="/alumni"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Alumni</a></li><li class="nav-item"><a class="btn btn-primary ms-0 ms-lg-2 text-nowrap cta-tile" href="/admissions/apply"><i class="fa-solid fa-compass d-lg-none" aria-hidden="true"></i>Apply Now</a></li></ul></div></div></nav></header><main class="flex-grow-1" id="main-content" tabindex="-1"><section id="hero-6afdcdb4da48c" class="hero-section hero-section-large text-start position-relative w-100 text-white d-flex align-items-center justify-content-center"><div class="hero-bg-preview-wrapper position-absolute top-0 start-0 w-100 h-100 overflow-hidden"><div class="hero-bg-preview w-100 h-100" style="background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center;filter:blur(20px);transform:scale(1.15);"></div></div><img class="hero-bg-image position-absolute top-0 start-0 w-100 h-100" src="/content/images/image-bg/i6aeb30f3858ec.jpg" alt="" fetchpriority="high" style="object-fit:cover;object-position:center;opacity:0;transition:opacity 0.5s ease;" onload="this.style.opacity=1"><noscript><style>.hero-bg-image{opacity:1 !important;}</style></noscript><div class="hero-video-bg position-absolute top-0 start-0 w-100 h-100 overflow-hidden"><video class="w-100 h-100" autoplay muted loop playsinline preload="auto" disablepictureinpicture aria-hidden="true" poster="/content/images/image-bg/i6aeb30f3858ec.jpg" style="object-fit:cover;object-position:center;pointer-events:none;"><source src="/content/video/louisburg-hero.mp4" type="video/mp4"></video></div><div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div><div class="container position-relative py-5"><div class="row"><div class="col-lg-8"><div class="lead text-white"><p class="kicker">Whatever&rsquo;s Next Starts Here</p>
<h1>A Strong First Step Forward</h1>
<p>Not every student starts college confident about what&rsquo;s next. Louisburg helps students grow through personal support, real college experiences, and a clear path to transfer or career success.</p>
<p><a class="btn btn-red btn-lg" href="/admissions/apply">Apply Now</a> <a class="btn btn-red btn-lg" href="/admissions/visit">Visit Campus</a> <a class="btn btn-red btn-lg" href="/admissions/request-info">Request Info</a></p></div></div></div></div></section>
<section class="image-grid-content "><div class="container"><div class="row align-items-center"><div class="images col-12 col-sm-6"><div class="row pb-4"><div class="col-12 col-md-6 d-flex align-items-end"><div class="tile"><img loading="lazy" class="img-fluid" src="/content/images/450x1000/i6adf68ab957e0.jpg" alt=""></div></div><div class="col-12 col-md-6 d-flex align-items-end"><div class="tile"><img loading="lazy" class="img-fluid" src="/content/images/450x1000/i6ae0b5750dcf4.jpg" alt=""></div></div></div><div class="row pb-4 d-none d-md-flex"><div class="col-12 col-md-6 d-flex align-items-end"><div class="tile"><img loading="lazy" class="img-fluid" src="/content/images/450x1000/i6ae0b42d8b2a4.jpg" alt=""></div></div><div class="col-12 col-md-6 d-flex align-items-end"><div class="tile"><img loading="lazy" class="img-fluid" src="/content/images/450x1000/i6adf68abea63d.jpg" alt=""></div></div></div></div><div class="col-12 col-sm-6"><div class=""><h2>Built for growth and direction.</h2>
<p>Louisburg&rsquo;s two-year residential college experience gives students the support, structure, and real-world independence to grow in confidence before taking their next step toward transfer or career success.</p>
<p>Grounded in a faith-informed approach, students build more than academic momentum. They develop purpose, character, accountability, and the confidence to move forward.</p>
<p><a class="btn btn-primary" href="/why-louisburg">Why Choose Louisburg?</a></p></div></div></div></div></section>
<section class="pathway-selector bg-soft-gold"><div class="container"><div class="row align-items-center"><div class="col-12 col-lg-5"><div class="text-wrapper"><p class="kicker">Find Your Next Step</p><h2>Whatever&rsquo;s next starts here.</h2><p>Not sure where to start? Tell us who you are and what you&rsquo;re interested in, and we&rsquo;ll help guide your next step.</p></div></div><div class="col-12 col-lg-7"><div class="card h-100 w-100"><div class="card-body d-flex flex-column"><div class="mb-4"><h3 class="h4 ms-3">I am a&hellip;</h3><div class="btn-group flex-wrap d-flex w-100" role="group"><button type="button" class="btn btn-primary active" data-pathway="new-student" aria-pressed="true" aria-controls="pathway-new-student-6afdcdb4db05c">New Student</button><button type="button" class="btn btn-outline-primary" data-pathway="transfer-student" aria-pressed="false" aria-controls="pathway-transfer-student-6afdcdb4db05c">Transfer Student</button><button type="button" class="btn btn-outline-primary" data-pathway="parent-family" aria-pressed="false" aria-controls="pathway-parent-family-6afdcdb4db05c">Parent / Family</button><button type="button" class="btn btn-outline-primary" data-pathway="alumni" aria-pressed="false" aria-controls="pathway-alumni-6afdcdb4db05c">Alumni</button></div></div><div class="my-4"><h3 class="h4 ms-3">Looking for&hellip;</h3><div class="pathway-groups"><div class="btn-group flex-wrap w-100 pathway-group is-active" role="group" id="pathway-new-student-6afdcdb4db05c" data-pathway-group="new-student"><a href="/academics" class="btn btn-outline-primary">Academics</a><a href="/admissions" class="btn btn-outline-primary">Admissions</a><a href="/admissions/financial-aid" class="btn btn-outline-primary">Scholarships &amp; Aid</a><a href="/campus-life" class="btn btn-outline-primary">Campus Life</a></div><div class="btn-group flex-wrap w-100 pathway-group" role="group" id="pathway-transfer-student-6afdcdb4db05c" data-pathway-group="transfer-student"><a href="/academics" class="btn btn-outline-primary">Academics</a><a href="/academics/transfer" class="btn btn-outline-primary">Transfer Credit</a><a href="/admissions/apply" class="btn btn-outline-primary">Admissions</a><a href="/admissions/financial-aid" class="btn btn-outline-primary">Scholarships &amp; Aid</a></div><div class="btn-group flex-wrap w-100 pathway-group" role="group" id="pathway-parent-family-6afdcdb4db05c" data-pathway-group="parent-family"><a href="/admissions/financial-aid" class="btn btn-outline-primary">Tuition &amp; Costs</a><a href="/campus-life" class="btn btn-outline-primary">Campus Life &amp; Safety</a><a href="/academics" class="btn btn-outline-primary">Academics</a><a href="/parents-resources" class="btn btn-outline-primary">Family Resources</a></div><div class="btn-group flex-wrap w-100 pathway-group" role="group" id="pathway-alumni-6afdcdb4db05c" data-pathway-group="alumni"><a href="/calendar" class="btn btn-outline-primary">Events &amp; Reunions</a><a href="/give" class="btn btn-outline-primary">Give Back</a><a href="/alumni" class="btn btn-outline-primary">Stay Connected</a><a href="/alumni" class="btn btn-outline-primary">Career &amp; Mentorship</a></div></div></div></div></div></div></div></div></section>
<section id="hero-6afdcdb4db17f" class="hero-section hero-section-small text-start position-relative w-100 text-white d-flex align-items-center justify-content-center"><div class="hero-bg-preview-wrapper position-absolute top-0 start-0 w-100 h-100 overflow-hidden"><div class="hero-bg-preview w-100 h-100" style="background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center;filter:blur(20px);transform:scale(1.15);"></div></div><img class="hero-bg-image position-absolute top-0 start-0 w-100 h-100" src="/content/images/image-bg/i6aeb30edd6b2e.jpg" alt="" loading="lazy" style="object-fit:cover;object-position:center;opacity:0;transition:opacity 0.5s ease;" onload="this.style.opacity=1"><noscript><style>.hero-bg-image{opacity:1 !important;}</style></noscript><div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div><div class="container position-relative py-5"><div class="row"><div class="col-lg-8"><div class="lead text-white"><p class="kicker">Student Support</p><h2>You’ve got the drive. We’ve got the map.</h2><p>No student is an island at Louisburg. From day one, we surround you with the tools to build independence and the safety net to take risks.</p><div class="card h-100 w-100"><div class="card-body d-flex flex-column"><h3>Integrated Advising</h3><p>Career and academic guidance baked into your schedule, ensuring every semester moves you toward your destination.</p></div></div><div class="card h-100 w-100"><div class="card-body d-flex flex-column"><h3>Proactive Mentoring</h3><p>Professors who act as partners in your progress, offering the accessibility and personal connection a large university can’t match.</p></div></div><p>Families trust Louisburg because students are known, supported, and guided every step of the way.</p><p><a class="btn btn-red btn-lg" href="/academics/student-support">Explore Support Services</a></p></div></div></div></div></section>
<section id="hero-6afdcdb4dbb6f" class="hero-section hero-section-small text-end position-relative w-100 text-white d-flex align-items-center justify-content-center"><div class="hero-bg-preview-wrapper position-absolute top-0 start-0 w-100 h-100 overflow-hidden"><div class="hero-bg-preview w-100 h-100" style="background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center;filter:blur(20px);transform:scale(1.15);"></div></div><img class="hero-bg-image position-absolute top-0 start-0 w-100 h-100" src="/content/images/image-bg/i6aeb30edde3cc.jpg" alt="" loading="lazy" style="object-fit:cover;object-position:center;opacity:0;transition:opacity 0.5s ease;" onload="this.style.opacity=1"><noscript><style>.hero-bg-image{opacity:1 !important;}</style></noscript><div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div><div class="container position-relative py-5"><div class="row justify-content-end"><div class="col-lg-8"><div class="lead text-white"><p class="kicker">Learning Partners</p>
<h2>Built for those who learn differently.</h2>
<p>Most colleges give you a syllabus and wish you luck. At Louisburg, we give you a team and a blueprint. Learning Partners bridges the gap between capable and successful.</p>
<div class="card h-100 w-100"><div class="card-body d-flex flex-column"><h3>Academic Strategy & Accountability</h3><p>High-impact, one-on-one mentorship focused on executive function, time management, and personalized study habits.</p></div></div>
<div class="card h-100 w-100"><div class="card-body d-flex flex-column"><h3>The Residential Edge</h3><p>A structured residential environment builds life habits, stability, independence, and confidence before complexity feels overwhelming.</p></div></div>
<p><a class="btn btn-red btn-lg" href="/academics/learning-resources/learning-partners">Experience Learning Partners</a></p></div></div></div></div></section>
<section class=""><div class="container"><h2 style="text-align: center;">Degrees designed for what&rsquo;s next.</h2>
<p style="text-align: center;">Louisburg connects your daily studies to your ultimate destination. We don&rsquo;t just offer subjects; we help you discover pathways.</p>
<p style="text-align: center;">&nbsp;</p>
<div class="kicms-flexgrid kicms-flexgrid--justify-center kicms-flexgrid--align-stretch"><div class="kicms-flexcell kicms-flexcell--normal kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><img loading="lazy" src="/content/images/2500x1000/i6adf68ac22471.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68ac22471.jpg 450w, /content/images/800x1000/i6adf68ac22471.jpg 800w, /content/images/1200x1000/i6adf68ac22471.jpg 1200w, /content/images/1600x1000/i6adf68ac22471.jpg 1600w, /content/images/2500x1000/i6adf68ac22471.jpg 2000w" sizes="auto, 100vw" alt=""></div><div class="card-body d-flex flex-column"><h3>Business & Leadership</h3><p>Develop practical leadership, communication, and decision-making skills grounded in real-world business challenges.</p><p><a href="/academics/programs/business">Business Degree</a></p></div></div></div><div class="kicms-flexcell kicms-flexcell--normal kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><img loading="lazy" src="/content/images/2500x1000/i6adf68ac466c2.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68ac466c2.jpg 450w, /content/images/800x1000/i6adf68ac466c2.jpg 800w, /content/images/1200x1000/i6adf68ac466c2.jpg 1200w, /content/images/1600x1000/i6adf68ac466c2.jpg 1600w, /content/images/2500x1000/i6adf68ac466c2.jpg 2000w" sizes="auto, 100vw" alt=""></div><div class="card-body d-flex flex-column"><h3>Health & Human Performance</h3><p>Prepare for careers in health, wellness, and performance through hands-on learning and applied science.</p><p><a href="/academics/programs/health-science">Health Science Degree</a><br><a href="/academics/programs/medical-science">Medical Science Degree</a><br><a href="/academics/programs/sports-science">Sports Science Degree</a></p></div></div></div><div class="kicms-flexcell kicms-flexcell--normal kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><img loading="lazy" src="/content/images/2500x1000/i6ae9f6634a78d.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6ae9f6634a78d.jpg 450w, /content/images/800x1000/i6ae9f6634a78d.jpg 800w, /content/images/1200x1000/i6ae9f6634a78d.jpg 1200w, /content/images/1600x1000/i6ae9f6634a78d.jpg 1600w, /content/images/2500x1000/i6ae9f6634a78d.jpg 2048w" sizes="auto, 100vw" alt=""></div><div class="card-body d-flex flex-column"><h3>Science & Environment</h3><p>Explore scientific inquiry and environmental systems while building a foundation for transfer or specialized study.</p><p><a href="/academics/programs/general-science">General Science Degree</a><br><a href="/academics/programs/environmental-science">Environmental Science Degree</a></p></div></div></div><div class="kicms-flexcell kicms-flexcell--normal kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><img loading="lazy" src="/content/images/2500x1000/i6adf68ac98a0b.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68ac98a0b.jpg 450w, /content/images/800x1000/i6adf68ac98a0b.jpg 800w, /content/images/1200x1000/i6adf68ac98a0b.jpg 1200w, /content/images/1600x1000/i6adf68ac98a0b.jpg 1600w, /content/images/2500x1000/i6adf68ac98a0b.jpg 2000w" sizes="auto, 100vw" alt=""></div><div class="card-body d-flex flex-column"><h3>Agriculture & Applied Sciences</h3><p>Gain hands-on experience in agriculture, sustainability, and applied sciences with direct industry relevance.</p><p><a href="/academics/programs/agricultural-studies">Agricultural Studies</a></p></div></div></div><div class="kicms-flexcell kicms-flexcell--normal kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><img loading="lazy" src="/content/images/2500x1000/i6adf68b397f42.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68b397f42.jpg 450w, /content/images/800x1000/i6adf68b397f42.jpg 800w, /content/images/1200x1000/i6adf68b397f42.jpg 1200w, /content/images/1600x1000/i6adf68b397f42.jpg 1600w, /content/images/2500x1000/i6adf68b397f42.jpg 2000w" sizes="auto, 100vw" alt=""></div><div class="card-body d-flex flex-column"><h3>Liberal Arts & Transfer</h3><p>Build the broad academic foundation, writing skills, and critical thinking needed for successful transfer.</p><p><a href="/academics/programs/liberal-arts">Liberal Arts Degree</a></p></div></div></div></div></div></section>
<section class="bg-soft-gold"><div class="container"><p class="kicker">Where Students Go Next</p><h2>Gain momentum. Graduate ready.</h2><p>Louisburg students graduate with more than credits—they leave with a destination. By mastering the essentials of self-discipline and academic rigor, you gain the confidence to take your next big step.</p><p>Whether you are transferring to a premier four-year university or entering the workforce, you will leave Louisburg ready to perform. We provide the foundation; you provide the drive.</p><p><strong>Your journey doesn’t end here—it starts here</strong>.</p>
<div class="kicms-flexgrid kicms-flexgrid--justify-left kicms-flexgrid--align-stretch"><div class="kicms-flexcell kicms-flexcell--large kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/academics/transfer" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/2500x1000/i6ae0b5752a45f.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6ae0b5752a45f.jpg 450w, /content/images/800x1000/i6ae0b5752a45f.jpg 800w, /content/images/1200x1000/i6ae0b5752a45f.jpg 1200w, /content/images/1600x1000/i6ae0b5752a45f.jpg 1600w, /content/images/2500x1000/i6ae0b5752a45f.jpg 2000w" sizes="auto, 100vw" alt=""></a></div><div class="card-body d-flex flex-column"><h3>Transfer Ready</h3>
<p>Build a strong academic foundation for your next college or university.</p><div class="mt-auto text-end"><a href="/academics/transfer" class="btn btn-cta">Learn More<span class="visually-hidden">: Transfer Ready</span></a></div></div></div></div><div class="kicms-flexcell kicms-flexcell--large kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/academics/career-pathways" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/2500x1000/i6adf68acc5ff1.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68acc5ff1.jpg 450w, /content/images/800x1000/i6adf68acc5ff1.jpg 800w, /content/images/1200x1000/i6adf68acc5ff1.jpg 1200w, /content/images/1600x1000/i6adf68acc5ff1.jpg 1600w, /content/images/2500x1000/i6adf68acc5ff1.jpg 2000w" sizes="auto, 100vw" alt=""></a></div><div class="card-body d-flex flex-column"><h3>Career Ready</h3>
<p>Connect coursework, advising, and campus experience to real career direction.</p><div class="mt-auto text-end"><a href="/academics/career-pathways" class="btn btn-cta">Learn More<span class="visually-hidden">: Career Ready</span></a></div></div></div></div></div></div></section>
<section class=""><div class="container"><h2>Find your place. Find your footing.</h2><p>Growth happens when you feel like you belong. At Louisburg, campus life provides the supportive environment you need to step out of your comfort zone, gain independence, and build a foundation of confidence.</p><div class="kicms-flexgrid kicms-flexgrid--justify-left kicms-flexgrid--align-stretch"><div class="kicms-flexcell kicms-flexcell--small kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/campus-life/housing" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/2500x1000/i6adf68acec0e7.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68acec0e7.jpg 450w, /content/images/800x1000/i6adf68acec0e7.jpg 800w, /content/images/1200x1000/i6adf68acec0e7.jpg 1200w, /content/images/1600x1000/i6adf68acec0e7.jpg 1600w, /content/images/2500x1000/i6adf68acec0e7.jpg 2000w" sizes="auto, 100vw" alt=""></a></div><div class="card-body d-flex flex-column"><h3>Residential Living</h3><p>A close community where independence, responsibility, and friendships grow fast.</p><div class="mt-auto text-end"><a href="/campus-life/housing" class="btn btn-cta">Learn More<span class="visually-hidden">: Residential Living</span></a></div></div></div></div><div class="kicms-flexcell kicms-flexcell--small kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/campus-life/organizations" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/2500x1000/i6ae0b42d4dea7.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6ae0b42d4dea7.jpg 450w, /content/images/800x1000/i6ae0b42d4dea7.jpg 800w, /content/images/1200x1000/i6ae0b42d4dea7.jpg 1200w, /content/images/1600x1000/i6ae0b42d4dea7.jpg 1600w, /content/images/2500x1000/i6ae0b42d4dea7.jpg 2000w" sizes="auto, 100vw" alt=""></a></div><div class="card-body d-flex flex-column"><h3>Student Organizations</h3><p>Lead, serve, and get involved in ways that build confidence and identity.</p><div class="mt-auto text-end"><a href="/campus-life/organizations" class="btn btn-cta">Learn More<span class="visually-hidden">: Student Organizations</span></a></div></div></div></div><div class="kicms-flexcell kicms-flexcell--small kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="https://www.jpacarts.com/" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/2500x1000/i6adf68ad50966.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6adf68ad50966.jpg 450w, /content/images/800x1000/i6adf68ad50966.jpg 800w, /content/images/1200x1000/i6adf68ad50966.jpg 1200w, /content/images/1600x1000/i6adf68ad50966.jpg 1600w, /content/images/2500x1000/i6adf68ad50966.jpg 2000w" sizes="auto, 100vw" alt=""></a></div><div class="card-body d-flex flex-column"><h3>Arts, Culture & Events</h3><p>Performances, experiences, and traditions that make campus life feel real.</p><div class="mt-auto text-end"><a href="https://www.jpacarts.com/" class="btn btn-cta">Learn More<span class="visually-hidden">: Arts, Culture &amp; Events</span></a></div></div></div></div><div class="kicms-flexcell kicms-flexcell--small kicms-flexcell--halign-left kicms-flexcell--valign-top"><div class="card h-100 w-100"><div class="card-img-ratio-16-9" style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="https://www.lchurricanes.com/" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/2500x1000/i6ae0b5756a5c2.jpg" class="object-fit-cover w-100 h-100 card-img-top" srcset="/content/images/450x1000/i6ae0b5756a5c2.jpg 450w, /content/images/800x1000/i6ae0b5756a5c2.jpg 800w, /content/images/1200x1000/i6ae0b5756a5c2.jpg 1200w, /content/images/1600x1000/i6ae0b5756a5c2.jpg 1600w, /content/images/2500x1000/i6ae0b5756a5c2.jpg 2000w" sizes="auto, 100vw" alt=""></a></div><div class="card-body d-flex flex-column"><h3>Athletics</h3><p>Compete, connect, and be part of a campus community that wins together.</p><div class="mt-auto text-end"><a href="https://www.lchurricanes.com/" class="btn btn-cta">Learn More<span class="visually-hidden">: Athletics</span></a></div></div></div></div></div></div></section>
<section class="bg-soft-gold"><div class="container"><p class="kicker">Student Stories</p>
<h2>Real students. Real outcomes.</h2>
<p>These stories show what happens when support, structure, and direction come together.</p>
<div class="row d-flex flex-wrap"><div class="col-12 col-md-6 col-lg-4"><div class="card h-100 w-100 card-large"><div style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/news/student-spotlight-rion-neely" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/500x1000/6ae0b93defb05.png" class="object-fit-cover w-100 h-100 card-img-top" alt="Student Spotlight: Rion Neely"></a></div><div class="card-body d-flex flex-column"><p class="kicker">Student Spotlight</p><h3 class="card-title"><a href="/news/student-spotlight-rion-neely">Student Spotlight: Rion Neely</a></h3><p class="small text-muted">April 8, 2024</p><p>Rion Neely is a freshman at Louisburg College studying Health Science. Originally from Charlotte, North Carolina, Neely is Vice President of the Student Government Association and a member of the Student Ambassador Program at Louisburg. When she&#039;s not studying or socializing, she&#039;s always searching for a new hobby or interest.</p><div class="mt-auto text-end"><a href="/news/student-spotlight-rion-neely" class="btn btn-cta">Read More<span class="visually-hidden">: Student Spotlight: Rion Neely</span></a></div></div></div></div><div class="col-12 col-md-6 col-lg-4"><div class="card h-100 w-100 card-large"><div style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/news/student-spotlight-larissa-turner" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/500x1000/6ae0b904d1d0d.png" class="object-fit-cover w-100 h-100 card-img-top" alt="Student Spotlight: Larissa Turner"></a></div><div class="card-body d-flex flex-column"><p class="kicker">Student Spotlight</p><h3 class="card-title"><a href="/news/student-spotlight-larissa-turner">Student Spotlight: Larissa Turner</a></h3><p class="small text-muted">November 17, 2023</p><p>Larissa Turner is a Sophomore at Louisburg College studying Business. Originally from Raleigh, North Carolina, Turner is a returning member of the CCA National Champion Louisburg College Cheerleading team and Whitehead Leadership Program. She enjoys baking, crafting, and rollerskating. Her favorite class at Louisburg is theater appreciation.</p><div class="mt-auto text-end"><a href="/news/student-spotlight-larissa-turner" class="btn btn-cta">Read More<span class="visually-hidden">: Student Spotlight: Larissa Turner</span></a></div></div></div></div><div class="col-12 col-md-6 col-lg-4"><div class="card h-100 w-100 card-large"><div style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/news/student-spotlight-taylor-mcqueen" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/500x1000/tc23fd719c9825e8b090177a44354adcc.png" class="object-fit-cover w-100 h-100 card-img-top" alt="Student Spotlight: Taylor McQueen"></a></div><div class="card-body d-flex flex-column"><p class="kicker">Student Spotlight</p><h3 class="card-title"><a href="/news/student-spotlight-taylor-mcqueen">Student Spotlight: Taylor McQueen</a></h3><p class="small text-muted">October 6, 2023</p><p>Taylor McQueen is a Sophomore at Louisburg College studying for her Associate&#039;s in Science. Originally from Clayton, North Carolina, McQueen is a member of the Louisburg College Softball team and Whitehead Leadership Program. When she&#039;s not playing or studying, she enjoys hot yoga and going for walks in the woods to enjoy nature.</p><div class="mt-auto text-end"><a href="/news/student-spotlight-taylor-mcqueen" class="btn btn-cta">Read More<span class="visually-hidden">: Student Spotlight: Taylor McQueen</span></a></div></div></div></div></div></div></section>
<section class=""><div class="container"><p class="kicker">Latest News</p>
<h2>This is Louisburg College</h2>
<p>Stories from a campus that's growing, evolving, and moving with purpose.</p>
<div class="row d-flex flex-wrap"><div class="col-12 col-md-6 col-lg-4"><div class="card h-100 w-100 card-large"><div style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/news/polished-and-prepared-closet-opens-to-campus" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/500x1000/tfd3766a12d8a5e1e7538a0648012f36a.jpg" class="object-fit-cover w-100 h-100 card-img-top" alt="Polished and Prepared Closet Opens to Campus"></a></div><div class="card-body d-flex flex-column"><p class="kicker">Student Life</p><h3 class="card-title"><a href="/news/polished-and-prepared-closet-opens-to-campus">Polished and Prepared Closet Opens to Campus</a></h3><p class="small text-muted">October 3, 2025</p><p>The Polished and Prepared Professional Closet officially opened its doors to campus on October 2, 2025.</p><div class="mt-auto text-end"><a href="/news/polished-and-prepared-closet-opens-to-campus" class="btn btn-cta">Read More<span class="visually-hidden">: Polished and Prepared Closet Opens to Campus</span></a></div></div></div></div><div class="col-12 col-md-6 col-lg-4"><div class="card h-100 w-100 card-large"><div style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/news/kionna-coleman-named-associate-vice-president-of-strategic-communications-and-alumni-engagement-at-louisburg-college" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/500x1000/6af75da1cabf5.png" class="object-fit-cover w-100 h-100 card-img-top" alt="Kionna Coleman Named Associate Vice President of Strategic Communications and Alumni Engagement at Louisburg College"></a></div><div class="card-body d-flex flex-column"><p class="kicker">College News</p><h3 class="card-title"><a href="/news/kionna-coleman-named-associate-vice-president-of-strategic-communications-and-alumni-engagement-at-louisburg-college">Kionna Coleman Named Associate Vice President of Strategic Communications and Alumni Engagement at Louisburg College</a></h3><p class="small text-muted">November 13, 2026</p><p>Kionna Coleman, a marketing and communications executive with more than 25 years of experience, has been named the associate vice president of strategic communications and alumni engagement for Louisburg College.</p><div class="mt-auto text-end"><a href="/news/kionna-coleman-named-associate-vice-president-of-strategic-communications-and-alumni-engagement-at-louisburg-college" class="btn btn-cta">Read More<span class="visually-hidden">: Kionna Coleman Named Associate Vice President of Strategic Communications and Alumni Engagement at Louisburg College</span></a></div></div></div></div><div class="col-12 col-md-6 col-lg-4"><div class="card h-100 w-100 card-large"><div style="aspect-ratio: 1.7777777777778; overflow: hidden;"><a href="/news/71-student-athletes-named-njcaa-region-x-all-academic" class="d-block h-100" aria-hidden="true" tabindex="-1"><img loading="lazy" src="/content/images/500x1000/t2c8514eb6b2a3624d78dc9736c0b2428.png" class="object-fit-cover w-100 h-100 card-img-top" alt="71 Student-Athletes Named NJCAA Region X All Academic"></a></div><div class="card-body d-flex flex-column"><p class="kicker">Athletics</p><h3 class="card-title"><a href="/news/71-student-athletes-named-njcaa-region-x-all-academic">71 Student-Athletes Named NJCAA Region X All Academic</a></h3><p class="small text-muted">March 4, 2025</p><p>Congratulations! Louisburg College Athletics has the most NJCAA Region 10 All-Academic Students for the Fall semester with 71 students!</p><div class="mt-auto text-end"><a href="/news/71-student-athletes-named-njcaa-region-x-all-academic" class="btn btn-cta">Read More<span class="visually-hidden">: 71 Student-Athletes Named NJCAA Region X All Academic</span></a></div></div></div></div></div></div></section>
<section class="angle-divided split-bg split-forward split-left-gold split-right-navy split-right-has-image" style="--split-right-image: url(&#039;/content/images/2500x1000/i6a99f43a7a1f0.jpg&#039;)"><div class="ad-wrap container"><div class="ad-left flex-fill d-flex"><div class="ad-content"><div class="ad-shape" aria-hidden="true"></div><p class="kicker">So, What's Next for You?</p>
<h2>Whatever's Next Starts Here.</h2>
<p>You don't have to have it all figured out. Take the first step and we'll help you find the rest.</p>
