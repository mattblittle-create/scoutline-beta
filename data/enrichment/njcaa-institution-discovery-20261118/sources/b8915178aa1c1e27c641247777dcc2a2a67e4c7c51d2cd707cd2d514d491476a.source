 #content > div.stripe.stripe-style-3.shadow-element-decoration > div > div.wpb_column.vc_column_container.vc_col-sm-9 > div > div > div > div > div.vc_tta-tabs-container > ul > li.vc_tta-tab.vc_active > a > span: = rqdata {
