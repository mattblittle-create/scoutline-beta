.vc_grid-container-wrapper.vc_clearfix > div > div > div > div:nth-child(odd) > div.vc_grid-item-mini.vc_clearfix > div > div:hover, .vc_grid-container-wrapper.vc_clearfix > div > div > div > div:nth-child(even) > div.vc_grid-item-mini.vc_clearfix > div > div:hover {
