/* =====================================================
   EVENT CARDS
   ===================================================== */

.eventCardsRow,
.eventCardsRow * {
  box-sizing: border-box !important;
}

/* Keep VC column widths intact, only add vertical spacing */
.eventCardsRow .wpb_column,
.eventCardsRow .vc_column_container {
  margin-bottom: 24px !important;
  display: flex !important;
}

/* Add horizontal spacing inside column without breaking layout */
.eventCardsRow .vc_column-inner {
  padding-left: 17.5px !important;
  padding-right: 17.5px !important;
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
}

/* Pull outer edges back so total width stays aligned with VC grid */
.eventCardsRow {
  margin-left: -17.5px !important;
  margin-right: -17.5px !important;
}

/* Card styling */
.eventCards {
  background: #f9f9f9;
  border: 1px solid #cecece;
  border-radius: 20px;
  padding: 18px;
  overflow: hidden;
  display: flex !important;
  flex-direction: column !important;
  flex: 1 1 auto !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* Hover effect */
.eventCards:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

/* Remove unwanted VC spacing */
.eventCards .wpb_wrapper,
.eventCards .vc_column-inner {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* Make wrapper stretch fully */
.eventCards .wpb_wrapper {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Push last element like button to bottom */
.eventCards .wpb_wrapper > *:last-child {
  margin-top: auto;
}

/* Image wrappers
   Make wrapper span full width and remove extra spacing */
.eventCards .vc_single_image-wrapper,
.eventCards figure,
.eventCards .vc_figure,
.eventCards .wp-caption {
  display: block;
  width: 100%;
  margin: 0 0 16px 0 !important;
  padding: 0 !important;
}

/* Images
   Let each image fill the card width while keeping its natural proportions */
.eventCards img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto !important; /* preserves image proportions */
  border-radius: 12px;
  margin: 0 !important;
  object-fit: contain; /* harmless here, but not really needed when height is auto */
	/*aspect-ratio: 16 / 6;*/
}

/* Mobile fixes */
@media (max-width: 991px) {
  .eventCardsRow .wpb_column,
  .eventCardsRow .vc_column_container {
    margin-bottom: 20px !important;
  }

  .eventCardsRow .vc_column-inner {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .eventCardsRow {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  .eventCards {
    padding: 16px;
  }

  .eventCards h2,
  .eventCards h3,
  .eventCards h4 {
    font-size: 22px;
  }

  .eventCards p {
    font-size: 15px;
  }

  .eventCards img {
    aspect-ratio: auto;
    object-fit: contain;
  }
}

/* =====================================================
   FANCY LINKS (FIXED ALIGNMENT)
   ===================================================== */

.fancyLinks {
  margin: 20px 0;
  text-align: inherit; /* allows WYSIWYG alignment to control it */
}

.fancyLinks a {
  display: inline-flex;        /* key fix */
  align-items: center;
  gap: 12px;
  text-decoration: none;
  font-size: 16px;
  font-weight: 600;
  color: #003f7e;
  padding: 1px 0;
  transition: color 0.25s ease;
}

/* Circle arrow icon */
.fancyLinks a::before {
  content: "→";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #e9f2f9;
  color: #003f7e;
  font-size: 14px;
  font-weight: 700;
  transition:
    transform 0.25s ease,
    background-color 0.25s ease,
    color 0.25s ease;
}

/* Hover effects */
.fancyLinks a:hover {
  color: #005aa7;
}

.fancyLinks a:hover::before {
  background: #003f7e;
  color: #ffffff;
  transform: translateX(4px);
}

/* Accessibility focus state */
.fancyLinks a:focus-visible {
  outline: 2px solid #003f7e;
  outline-offset: 3px;
}

/* =====================================================
   Columns 
   ===================================================== */
.columns2 {
    list-style-type: disc;
    -webkit-columns: 2;
    -moz-columns: 2;
    columns: 2;
    list-style-position: inside;/*this is important addition*/
}


.columns4 {
    list-style-type: disc;
    -webkit-columns: 4;
    -moz-columns: 4;
    columns: 4;
    list-style-position: inside;/*this is important addition*/
}
@media (max-width: 768px) {

  /* =========================================
     Collapse 2-column list to 1 column
     ========================================= */
  .columns2 {
    -webkit-columns: 1;  /* Chrome, Safari */
    -moz-columns: 1;     /* Firefox */
    columns: 1;          /* Standard */
  }

  /* =========================================
     Collapse 4-column list to 1 column
     ========================================= */
  .columns4 {
    -webkit-columns: 1;  /* Chrome, Safari */
    -moz-columns: 1;     /* Firefox */
    columns: 1;          /* Standard */
  }

/* =====================================================
   GLOBAL ORDERED LIST HIERARCHY
   Level 1: 1, 2, 3
   Level 2: a, b, c
   Level 3: i, ii, iii
   Level 4: A, B, C
   ===================================================== */

/* Main ordered lists */
.entry-content ol,
.wp-block-post-content ol,
.page-content ol,
.post-content ol {
  list-style-type: decimal !important;
  list-style-position: outside;
  padding-left: 2rem;
}

/* First nested level */
.entry-content ol ol,
.wp-block-post-content ol ol,
.page-content ol ol,
.post-content ol ol {
  list-style-type: lower-alpha !important;
}

/* Second nested level */
.entry-content ol ol ol,
.wp-block-post-content ol ol ol,
.page-content ol ol ol,
.post-content ol ol ol {
  list-style-type: lower-roman !important;
}

/* Third nested level */
.entry-content ol ol ol ol,
.wp-block-post-content ol ol ol ol,
.page-content ol ol ol ol,
.post-content ol ol ol ol {
  list-style-type: upper-alpha !important;
}

/* Consistent spacing */
.entry-content ol > li,
.wp-block-post-content ol > li,
.page-content ol > li,
.post-content ol > li {
  margin-bottom: 0.4rem;
  padding-left: 0.35rem;
}

/* Space nested lists correctly */
.entry-content li > ol,
.wp-block-post-content li > ol,
.page-content li > ol,
.post-content li > ol {
  margin-top: 0.4rem;
  margin-bottom: 0.75rem;
	}
}

/*== TOUR/SECTION TABS ADA FIX (8-4-26)==*/

/*--Sidebar Tabs BG color--*/
.wpb-js-composer .vc_tta.vc_general .vc_tta-panel-title>a {
	background-color: #003e7e!important;
}

/*--Sidebar Tabs Font color--*/
h4.vc_tta-panel-title span {
	color: #ffffff!important;
}

/*--MOBILE>> Active Sidebar Tab Font Color--*/
.vc_tta.vc_general .vc_tta-panel.vc_active a span {
	color: #ffffff!important;
}

/*== END TOUR/SECTION TABS ADA Fix ==*/

</style>
