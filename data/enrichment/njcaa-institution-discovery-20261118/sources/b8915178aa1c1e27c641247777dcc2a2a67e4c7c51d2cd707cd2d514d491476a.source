	#flyout-content-id-111410 .flyout-content h4,
	#flyout-content-id-111410 .flyout-content h5,
	#flyout-content-id-111410 .flyout-content h6 { color: #000000; }
		#flyout-content-id-111410 .flyout-content {
		background-color: #efefef;
	}
	
	#flyout-content-id-98973 { width:400px; right:-400px; }
	#flyout-content-id-98973 .flyout-content { color: #ffffff; }
	#flyout-content-id-98973 .flyout-content a,
	#flyout-content-id-98973 .flyout-content a:hover,
	#flyout-content-id-98973 .flyout-content a:visited { color: #eeeeee; }
	#flyout-content-id-98973 .flyout-content h1,
	#flyout-content-id-98973 .flyout-content h2,
	#flyout-content-id-98973 .flyout-content h3,
	#flyout-content-id-98973 .flyout-content h4,
	#flyout-content-id-98973 .flyout-content h5,
	#flyout-content-id-98973 .flyout-content h6 { color: #ffffff; }
		#flyout-content-id-98973 .flyout-content {
		background-color: #000000;
	}
	
</style>
<!-- END Flyout Custom CSS -->
	<style data-type="vc_custom-css">/* Style and align the completed countdown message. */
.psc-events .psc-event-countdown-complete {
    background: transparent !important;
    color: #ffd400 !important;
    text-align: left !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
}

/* Prevent inner elements from adding indentation. */
.psc-events .psc-event-countdown-complete p,
.psc-events .psc-event-countdown-complete span {
    color: #ffd400 !important;
    -webkit-text-fill-color: #ffffff !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
}
label {
    width: 80%;
}


.vc_tta-container {
     margin-bottom: 0px!important; 
}


.ajde_evcal_calendar #evcal_head.calendar_header #evcal_cur, .ajde_evcal_calendar .evcal_month_line p {
    color: #ccc!important;
}

.dg-wrap .dg-post-title {
  
    background: rgba(0,32,48,0.9)!important;
}

.rox-grid-title {
    min-height: 85px;
    width: 100%;
   font-size: 1.35em; 
    line-height: 1.4em;
    letter-spacing: 1px;
    font-family: 'Lato', sans-serif;
    color: #ffffff;
}

.vc_grid-container-wrapper.vc_clearfix > div > div > div > div:nth-child(odd) > div.vc_grid-item-mini.vc_clearfix > div > div:hover, .vc_grid-container-wrapper.vc_clearfix > div > div > div > div:nth-child(even) > div.vc_grid-item-mini.vc_clearfix > div > div:hover {
    background: inherit;
    color: inherit;
}

.uvc-main-heading, .uvc-sub-heading {
    text-transform: none!important;
}

.yellowbanner:hover {
    color: red;
}

span.uvc-headings-line {
    border-width: 0px 0px 1px 0px!important;
}

.uvc-main-heading {
    margin: 5px 0!important;
}

/* Match the homepage Locations block to the president-designate page width. */
#content .psc-home-locations {
        width: 100%;
            max-width: 1200px;
                margin-left: auto;
                    margin-right: auto;
}

/* Keep the homepage Locations block centered despite WPBakery column-gap margins. */
#content .psc-home-locations {
    margin-left: auto !important;
    margin-right: auto !important;
}</style>
