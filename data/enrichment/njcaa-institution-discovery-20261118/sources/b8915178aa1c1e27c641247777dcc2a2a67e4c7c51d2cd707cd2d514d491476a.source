<style id="psc-brand-buttons-v1-1-0">
/* Scope to actual CTA widgets, never generic buttons, tabs, or navigation controls. */
#the7-body :where(.vc_btn3, .vc_btn, .wpb_button, .dt-btn, .ubtn, .wp-block-button__link, a.psc-event-button, .applyNowBtn a:where(body:not(.home) *), .formcraft-css .submit-button, .btn.btn-white-outlined) {
    --psc-button-bg: #003e7e;
    --psc-button-hover: #036636;
}
#the7-body :is(.vc_btn3, .vc_btn, .wpb_button, .dt-btn, .ubtn, .wp-block-button__link, a.psc-event-button, .applyNowBtn a:where(body:not(.home) *), .formcraft-css .submit-button, .btn.btn-white-outlined) {
    background-color: var(--psc-button-bg) !important;
    background-image: none !important;
    border-color: var(--psc-button-bg) !important;
    color: #fff !important;
    text-shadow: none !important;
}
#the7-body :is(.psc-button-green, .vc_btn3-color-green, .vc_btn3-color-vista-blue, .wpb_btn-success, .btn-green, .applyNowBtn a:where(body:not(.home) *)) {
    --psc-button-bg: #036636;
    --psc-button-hover: #003e7e;
}
#the7-body :is(.vc_btn3, .vc_btn, .wpb_button, .dt-btn, .ubtn, .wp-block-button__link, a.psc-event-button, .applyNowBtn a:where(body:not(.home) *), .formcraft-css .submit-button, .btn.btn-white-outlined):is(:hover, :focus-visible):not(:disabled):not([aria-disabled="true"]):not(.disabled) {
