/* Program card heading recovery — 2026-10-30.
 * Native ACF blocks: Secondary Title and optional Program Heading Prefix.
 * Keep the original credential badge and shared image-card design. */
body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-acf.psc-program-secondary,
body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-acf.psc-program-prefix {
  position: static !important;
  inset: auto !important;
  display: block;
  float: none;
  width: auto;
  max-width: 100%;
  background: transparent !important;
  border: 0;
  border-radius: 0;
  padding: 0;
  margin: 8px 0 0;
  color: #fff !important;
  font-size: 18px;
  line-height: 1.25;
  font-weight: 400;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  text-shadow: 0 1px 3px rgba(0,0,0,.7);
}
body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-acf.psc-program-prefix {
  box-sizing: border-box;
  margin: 0;
  padding: 10px 54px 0;
  font-size: 14px;
  line-height: 1.2;
  font-weight: 400;
}
body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-acf.psc-program-secondary:empty,
body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-acf.psc-program-prefix:empty {
  display: none !important;
}
body .vc_grid-container:has(.psc-shared-program-tile) .rox-grid-title {
  padding: 40px 18px 28px !important;
}

body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-row-position-top:has(.psc-program-prefix) > .vc_gitem-col {
  padding: 0;
}


/* Preserve text-list and landscape variants while restoring qualifiers. */
body .psc-program-list-prefix { font-size:14px; line-height:1.25; font-weight:400; margin:0 0 6px; white-space:normal; }
body .psc-program-list-prefix:empty, body .psc-program-landscape-secondary:empty { display:none; }
body .vc_gitem-zone.rox-programs-title-only:has(.psc-program-list-prefix:not(:empty)) { height:auto !important; min-height:75px; }
body .vc_gitem-zone.rox-programs-title-only:has(.psc-program-list-prefix:not(:empty)) .vc_gitem-row-position-top { position:relative; }
body .vc_gitem-col:has(> .psc-program-list-prefix:not(:empty)) { display:flex; flex-direction:column; }
body .vc_gitem-col > .psc-program-list-prefix { order:-1; }
body .psc-program-landscape-secondary { color:#fff; font-size:16px; line-height:1.3; white-space:normal; }


/* Narrow cards need room for the full named-degree eyebrow below the badge. */
