	<script>
	document.addEventListener('DOMContentLoaded', function () {

		/* -------------------------------------
		   PATCH TRACKING PIXELS
		------------------------------------- */
		function patchPubadsTrackingPixels() {
			document.querySelectorAll('img[src*="pubads.g.doubleclick.net/activity"]').forEach(function(img) {

				/* Add alt text if missing or empty */
				if (!img.hasAttribute('alt') || img.getAttribute('alt').trim() === '') {
					img.setAttribute('alt', 'Advertising tracking pixel');
				}

				/* Hide from assistive tech as extra protection */
				img.setAttribute('aria-hidden', 'true');

				/* Keep it out of layout if possible */
				img.style.display = 'none';
				img.style.width = '1px';
				img.style.height = '1px';
				img.style.border = '0';
			});
		}

		/* Run immediately */
		patchPubadsTrackingPixels();

		/* Run again in case script injects it later */
		setTimeout(patchPubadsTrackingPixels, 500);
		setTimeout(patchPubadsTrackingPixels, 1500);
		setTimeout(patchPubadsTrackingPixels, 3000);

		/* Watch for dynamically injected pixels */
		var observer = new MutationObserver(function() {
			patchPubadsTrackingPixels();
		});

		observer.observe(document.body, {
			childList: true,
			subtree: true
		});
	});
	</script>
		<script>
	document.addEventListener('DOMContentLoaded', function () {

		/* =====================================================
		   CLEAN PDF NAME INTO HUMAN-READABLE TITLE
		   ===================================================== */
		function cleanPdfName(name) {
			if (!name) return 'Embedded PDF document';

			name = name
				.replace(/\.pdf$/i, '')
				.replace(/[-_]+/g, ' ')
				.replace(/\s+/g, ' ')
				.trim();

			name = name.replace(/\b\w/g, function(letter) {
				return letter.toUpperCase();
			});

			return name || 'Embedded PDF document';
		}

		/* =====================================================
		   EXTRACT FILE NAME FROM IFRAME SRC
		   ===================================================== */
		function getNameFromSrc(src) {
			if (!src) return '';

			try {
				var url = new URL(src, window.location.origin);

				/* Look for common ?file= parameter first */
				var fileParam = url.searchParams.get('file');
				if (fileParam) {
					return cleanPdfName(fileParam.split('/').pop());
				}

				/* Fall back to the last path segment */
				var parts = url.pathname.split('/').filter(Boolean);
				if (parts.length) {
					return cleanPdfName(parts[parts.length - 1]);
				}
			} catch (e) {}

			return '';
		}

		/* =====================================================
		   DETERMINE IF IFRAME IS LIKELY A PDF VIEWER
		   ===================================================== */
		function isLikelyPdfIframe(iframe) {
			if (!iframe) return false;

			if (iframe.classList.contains('pdfembed-iframe')) {
				return true;
			}

			var src = (iframe.getAttribute('src') || '').toLowerCase();
			var className = (iframe.className || '').toLowerCase();

			return (
				src.indexOf('.pdf') !== -1 ||
				src.indexOf('pdfjs') !== -1 ||
				src.indexOf('pdf') !== -1 ||
				src.indexOf('viewer') !== -1 ||
				src.indexOf('wp-pdf') !== -1 ||
				className.indexOf('pdf') !== -1
			);
		}

		/* =====================================================
		   BUILD BEST POSSIBLE IFRAME TITLE
		   ===================================================== */
		function getBestIframeTitle(iframe, index) {
			var titleText = '';
			var src = iframe.getAttribute('src') || '';

			titleText = getNameFromSrc(src);

			if (!titleText) {
				titleText =
					iframe.getAttribute('data-title') ||
					iframe.getAttribute('data-document-title') ||
					iframe.getAttribute('aria-label') ||
					iframe.getAttribute('title') ||
					'';
			}

			titleText = cleanPdfName(titleText);

			if (!titleText || titleText === 'Embedded Pdf Document') {
				titleText = 'Embedded PDF document ' + (index + 1);
			}

			return titleText;
		}

		/* =====================================================
		   BUILD A LABEL FOR EMPTY INTERNAL PDF LINKS
		   ===================================================== */
		function getInternalLinkLabel(link, index) {
			var href = link.getAttribute('href') || '';
			var elementId = link.getAttribute('data-element-id') || link.id || '';
			var label = 'Internal PDF link';

			/* Try to infer a destination from the href */
			if (href.indexOf('%22num%22%3A') !== -1) {
				try {
					var match = href.match(/%22num%22%3A(\d+)/);
					if (match && match[1]) {
						label = 'Internal PDF link to destination ' + match[1];
					}
				} catch (e) {}
			}

			/* Fallback to the element identifier */
			if (label === 'Internal PDF link' && elementId) {
				label = 'Internal PDF link ' + elementId;
			}

			/* Final fallback */
			if (!label) {
				label = 'Internal PDF link ' + (index + 1);
			}

			return label;
		}

		/* =====================================================
		   REMOVE INVALID ARIA ID REFERENCES
		   Fixes cases like aria-owns="367R" when no such ID exists
		   ===================================================== */
		function cleanupInvalidAriaReferences(doc) {
			if (!doc) return;

			var ariaIdRefAttributes = [
				'aria-owns',
				'aria-controls',
				'aria-labelledby',
				'aria-describedby',
				'aria-details',
				'aria-errormessage',
				'for'
			];

			ariaIdRefAttributes.forEach(function(attrName) {
				doc.querySelectorAll('[' + attrName + ']').forEach(function(el) {
					var value = (el.getAttribute(attrName) || '').trim();

					/* Remove empty values immediately */
					if (!value) {
						el.removeAttribute(attrName);
						return;
					}

					/* Some ARIA attributes can contain multiple IDs */
					var ids = value.split(/\s+/);
					var validIds = ids.filter(function(id) {
						try {
							return !!doc.getElementById(id) || !!doc.getElementById('pdfjs_internal_id_' + id);
						} catch (e) {
							return false;
						}
					}).map(function(id) {
						if (doc.getElementById(id)) {
							return id;
						}
						if (doc.getElementById('pdfjs_internal_id_' + id)) {
							return 'pdfjs_internal_id_' + id;
						}
						return null;
					}).filter(Boolean);

					/* If no valid IDs remain, remove the attribute */
					if (!validIds.length) {
						el.removeAttribute(attrName);
						return;
					}

					/* If some are valid and some are not, keep only valid ones */
					var uniqueIds = Array.from(new Set(validIds));
					if (uniqueIds.join(' ') !== value) {
						el.setAttribute(attrName, uniqueIds.join(' '));
					}
				});
			});

			/* Remove invalid boolean-like ARIA values */
			doc.querySelectorAll('[aria-hidden],[aria-expanded],[aria-selected],[aria-checked],[aria-pressed],[aria-required]').forEach(function(el) {
				['aria-hidden','aria-expanded','aria-selected','aria-checked','aria-pressed','aria-required'].forEach(function(attr) {
					if (!el.hasAttribute(attr)) return;

					var val = (el.getAttribute(attr) || '').trim().toLowerCase();
					var allowed = ['true', 'false'];

					if (attr === 'aria-checked' || attr === 'aria-pressed') {
						allowed = ['true', 'false', 'mixed'];
					}

					if (allowed.indexOf(val) === -1) {
						el.removeAttribute(attr);
					}
				});
			});
		}

		/* =====================================================
		   PATCH UNLABELED PDF FORM FIELDS INSIDE IFRAME
		   ONLY WORKS WHEN SAME-ORIGIN ACCESS IS ALLOWED
		   ===================================================== */
		function patchIframeFormFields(doc, frameTitle) {
			if (!doc) return;

			doc.querySelectorAll('input[id^="pdfjs_internal_id_"], textarea[id^="pdfjs_internal_id_"], select[id^="pdfjs_internal_id_"]').forEach(function(field, fieldIndex) {

				var existingLabel =
					field.getAttribute('aria-label') ||
					field.getAttribute('aria-labelledby') ||
					field.getAttribute('title');

				if (existingLabel && existingLabel.trim() !== '') {
					return;
				}

				var labelText =
					field.getAttribute('name') ||
					field.getAttribute('placeholder') ||
					field.getAttribute('data-element-id') ||
					'Form field ' + (fieldIndex + 1) + ' in ' + frameTitle;

				labelText = labelText.replace(/[_-]+/g, ' ').trim();

				field.setAttribute('aria-label', labelText);
				field.setAttribute('title', labelText);
			});
		}

		/* =====================================================
		   PATCH EMPTY INTERNAL PDF LINKS
		   Fixes anchors like:
		   <a class="internalLink" id="pdfjs_internal_id_1224R"></a>
		   ===================================================== */
		function patchIframeInternalLinks(doc) {
			if (!doc) return;

			doc.querySelectorAll('a.internalLink').forEach(function(link, index) {
				var visibleText = (link.textContent || '').trim();
				var hasAriaLabel = (link.getAttribute('aria-label') || '').trim();
				var hasLabelledBy = (link.getAttribute('aria-labelledby') || '').trim();
				var hasTitle = (link.getAttribute('title') || '').trim();

				/* Only patch links that truly have no accessible name */
				if (visibleText || hasAriaLabel || hasLabelledBy || hasTitle) {
					return;
				}

				var labelText = getInternalLinkLabel(link, index);

				link.setAttribute('aria-label', labelText);
				link.setAttribute('title', labelText);

				/* Optional helper for stubborn scanners */
				link.setAttribute('data-ada-link-repaired', 'true');
			});
		}

		/* =====================================================
		   PATCH CONTENT INSIDE PDF IFRAME
		   ===================================================== */
		function patchIframeInternals(iframe, frameTitle) {
			try {
				var doc = iframe.contentDocument || (iframe.contentWindow ? iframe.contentWindow.document : null);
				if (!doc) return;

				patchIframeFormFields(doc, frameTitle);
				patchIframeInternalLinks(doc);
				cleanupInvalidAriaReferences(doc);
			} catch (e) {
				/* Cross-origin iframe cannot be modified */
			}
		}

		/* =====================================================
		   APPLY ADA FIXES TO PDF IFRAMES
		   ===================================================== */
		function setPdfIframeTitles() {
			var allIframes = document.querySelectorAll('iframe');

			allIframes.forEach(function(iframe, index) {
				if (!isLikelyPdfIframe(iframe)) {
					return;
				}

				var titleText = getBestIframeTitle(iframe, index);

				/* Always enforce meaningful iframe naming */
				iframe.setAttribute('title', titleText);
				iframe.setAttribute('aria-label', titleText);
				iframe.setAttribute('data-ada-repaired', 'true');

				/* Try to patch the iframe internals too */
				patchIframeInternals(iframe, titleText);
			});
		}

		/* =====================================================
		   RUN REPEATEDLY TO CATCH LATE-LOADED PDF CONTENT
		   ===================================================== */
		function runPdfAdaRepairs() {
			setPdfIframeTitles();
		}

		runPdfAdaRepairs();
		setTimeout(runPdfAdaRepairs, 300);
		setTimeout(runPdfAdaRepairs, 1000);
		setTimeout(runPdfAdaRepairs, 2000);
		setTimeout(runPdfAdaRepairs, 4000);

		/* =====================================================
		   WATCH FOR DYNAMIC CHANGES
		   ===================================================== */
		var observer = new MutationObserver(function() {
			runPdfAdaRepairs();
		});

		observer.observe(document.body, {
			childList: true,
			subtree: true
		});

		/* =====================================================
		   RUN AGAIN AFTER FULL PAGE LOAD
		   ===================================================== */
		window.addEventListener('load', function() {
			runPdfAdaRepairs();
			setTimeout(runPdfAdaRepairs, 500);
			setTimeout(runPdfAdaRepairs, 1500);
			setTimeout(runPdfAdaRepairs, 3000);
		});
	});
	</script>
	    <script>
    jQuery(document).ready(function() {
      
    });
    </script>
    
<div class="pswp" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="pswp__bg"></div>
	<div class="pswp__scroll-wrap">
		<div class="pswp__container">
			<div class="pswp__item"></div>
			<div class="pswp__item"></div>
			<div class="pswp__item"></div>
		</div>
		<div class="pswp__ui pswp__ui--hidden">
			<div class="pswp__top-bar">
				<div class="pswp__counter"></div>
				<button class="pswp__button pswp__button--close" title="Close (Esc)" aria-label="Close (Esc)"></button>
				<button class="pswp__button pswp__button--share" title="Share" aria-label="Share"></button>
				<button class="pswp__button pswp__button--fs" title="Toggle fullscreen" aria-label="Toggle fullscreen"></button>
				<button class="pswp__button pswp__button--zoom" title="Zoom in/out" aria-label="Zoom in/out"></button>
				<div class="pswp__preloader">
					<div class="pswp__preloader__icn">
						<div class="pswp__preloader__cut">
							<div class="pswp__preloader__donut"></div>
						</div>
					</div>
				</div>
			</div>
			<div class="pswp__share-modal pswp__share-modal--hidden pswp__single-tap">
				<div class="pswp__share-tooltip"></div> 
			</div>
			<button class="pswp__button pswp__button--arrow--left" title="Previous (arrow left)" aria-label="Previous (arrow left)">
			</button>
			<button class="pswp__button pswp__button--arrow--right" title="Next (arrow right)" aria-label="Next (arrow right)">
			</button>
			<div class="pswp__caption">
				<div class="pswp__caption__center"></div>
			</div>
		</div>
	</div>
</div>
</body>
</html>
