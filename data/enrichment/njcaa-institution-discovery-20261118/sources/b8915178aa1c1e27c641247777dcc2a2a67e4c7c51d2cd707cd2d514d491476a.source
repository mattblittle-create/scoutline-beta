 body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-zone.vc_gitem-zone-a:has(.psc-program-prefix:not(:empty)) { height:330px !important; }
 body .vc_grid-container:has(.psc-shared-program-tile) .vc_gitem-acf.psc-program-prefix { padding:40px 12px 0; }
}

