/* START: Style TablePress search input background to dark (#282828) */

/* Target the specific input */
#dt-search-0.dt-input {
    background-color: #282828 !important; /* force dark background */
    color: #ffffff !important; /* ensure readable text */
    border: 1px solid #555555 !important; /* subtle visible border */
}

/* Improve placeholder visibility */
#dt-search-0.dt-input::placeholder {
    color: #cccccc !important; /* accessible contrast */
}

/* Focus state for accessibility */
#dt-search-0.dt-input:focus {
    outline: 2px solid #ffd400 !important; /* PSC yellow focus */
    outline-offset: 2px;
    background-color: #282828 !important;
}

/* END: Style TablePress search input background to dark (#282828) */



/* Secondary font color override */
.text-secondary {
  color: #282828 !important;
}

textarea::placeholder {
  color: #000000 !important;
}

.entry-date {
	color:#282828!important;
}

/*------------PDF EMBEDDER ADA COLOR FIXES are found in the functions file------------------*/


/* Fix placeholder contrast */
.sf-input-text::placeholder {
  color: #4a4a4a !important; /* darker gray for WCAG compliance */
  opacity: 1 !important;     /* prevents browser from fading it */
}

/* Also target all browsers */
.sf-input-text::-webkit-input-placeholder {
  color: #4a4a4a !important;
}

.sf-input-text:-ms-input-placeholder {
  color: #4a4a4a !important;
}

.sf-input-text::-ms-input-placeholder {
  color: #4a4a4a !important;
}
.sf-input-text {
  color: #000000 !important;
}
/* Add space after each paragraph */
 p {
  margin-bottom: 25px; /* adjust value as needed */
}

/* Optional: remove extra space on last paragraph */
 p:last-child {
  margin-bottom: 0;
}

/* FIX DATE COLOR ADA PROBLEM on blog posts Maximum specificity without being messy */
.post-format-standard .post-content time {
  color: #282828 !important;
}

/* FIX Search box ADA color contrast issue */
/* Target placeholder text inside this specific search form */
#search-filter-form-1150143 .sf-input-text::placeholder {
  color: #282828 !important;
  opacity: 1 !important; /* overrides default faded look */
}

/* Safari / Chrome */
#search-filter-form-1150143 .sf-input-text::-webkit-input-placeholder {
  color: #282828 !important;
  opacity: 1 !important;
}

/* Firefox */
#search-filter-form-1150143 .sf-input-text::-moz-placeholder {
  color: #282828 !important;
  opacity: 1 !important;
}

/* IE / Edge legacy */
#search-filter-form-1150143 .sf-input-text:-ms-input-placeholder {
  color: #282828 !important;
}

