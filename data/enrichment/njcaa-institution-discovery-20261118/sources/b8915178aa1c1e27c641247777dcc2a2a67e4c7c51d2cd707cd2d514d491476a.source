<!-- ADA FIX FOR PROGRAM SEARCH PAGE -->
<script>
/*
  ADA cleanup for dynamically generated academic program cards

  This script:
  1. Gives each card a unique article id
  2. Improves image alt text
  3. Prevents duplicate vague link names
  4. Gives "Explore Now" links meaningful accessible names
  5. Hides decorative arrow icons from screen readers
  6. Re-runs when Search & Filter updates results
*/
document.addEventListener("DOMContentLoaded", function () {

  function cleanProgramCards() {
    document.querySelectorAll(".search-filter-result-item article.item-result").forEach(function (card, index) {

      /* Get the main title link and visible title text */
      var titleLink = card.querySelector(".program-title-test a");
      if (!titleLink) return;

      var titleText = (titleLink.getAttribute("data-program-accessible-name") || "").trim() || (titleLink.childNodes[0] ? titleLink.childNodes[0].textContent.trim() : titleLink.textContent.trim());
      var programUrl = titleLink.getAttribute("href");

      /* Give the card a unique id if needed */
      if (!card.id || card.id === "programID") {
        card.id = "program-card-" + index;
      }

      /* Improve title link accessible name */
      titleLink.setAttribute("aria-label", titleText + " academic program");

      /* Fix the image link and image alt text */
      var imageLink = card.querySelector("#program-image a");
      var image = card.querySelector("#program-image img");

      if (image) {
        image.setAttribute("alt", titleText + " academic program");
      }

      /* If image link goes to same place as title link, keep it accessible but specific */
      if (imageLink && programUrl && imageLink.getAttribute("href") === programUrl) {
        imageLink.setAttribute("aria-label", titleText + " academic program image");
      }

      /* Fix the Explore Now link */
      var exploreLink = card.querySelector(".discover-more a");
      if (exploreLink) {
        exploreLink.setAttribute("aria-label", "Explore the " + titleText + " academic program");
      }

      /* Hide decorative arrow icons from screen readers */
      card.querySelectorAll(".discover-more i.fa").forEach(function (icon) {
        icon.setAttribute("aria-hidden", "true");
        icon.setAttribute("focusable", "false");
      });
    });
  }

  /* Run on load */
  cleanProgramCards();

  /* Re-run after AJAX/dynamic updates */
  var observer = new MutationObserver(function () {
    cleanProgramCards();
  });

  document.querySelectorAll(".search-filter-results, #search-filter-results, body").forEach(function (node) {
    observer.observe(node, {
      childList: true,
      subtree: true
    });
  });

  /* Backup delayed runs in case content loads late */
  setTimeout(cleanProgramCards, 500);
  setTimeout(cleanProgramCards, 1500);
  setTimeout(cleanProgramCards, 3000);

});
</script>


<!-- FIX ALL MISSING ALT TEXT ON IMAGE AND SHOW READABLE TEXT ON LINKS -->
<script>
/*
  ADA Link + Image Repair Script

  Fixes:
  1. Links with no discernible text
  2. Links that only contain images with missing alt text
  3. Generates meaningful fallback labels from URL or context
*/

document.addEventListener("DOMContentLoaded", function () {

  function getReadableTextFromURL(url) {
    try {
      var path = new URL(url, document.baseURI).pathname;
      var slug = path.split("/").filter(Boolean).pop() || "link";
      return slug.replace(/[-_]/g, " ").replace(/\b\w/g, c => c.toUpperCase());
    } catch (e) {
      return "View page";
    }
  }

  /* Name only observed program grid links from their rendered native heading fields. */
  function getProgramGridName(link) {
    if (!link.matches("a.vc_gitem-link")) return "";
    var zone = link.closest(".vc_gitem-zone");
    if (!zone || !zone.matches(".psc-shared-program-tile, .rox-programs-title-only")) return "";

    /* This title-only template also renders departments; do not relabel those links. */
    var overlay = zone.querySelector("a.vc-zone-link");
    try {
      var target = new URL(link.getAttribute("href"), document.baseURI);
      if (target.origin !== new URL(document.baseURI).origin || !/^\/academic-programs\/[^/]+\/?$/.test(target.pathname)) return "";
      if (!overlay || new URL(overlay.getAttribute("href"), document.baseURI).href !== target.href) return "";
    } catch (e) {
      return "";
    }

    var titleNode = zone.querySelector(".vc_gitem-post-data-source-post_title");
    var prefixNode = zone.querySelector(".psc-program-prefix, .psc-program-list-prefix");
    var secondaryNode = zone.querySelector(".psc-program-secondary, .rox-programs-title-only.secondary-title");
    var title = titleNode ? titleNode.textContent.trim() : "";
    var prefix = prefixNode ? prefixNode.textContent.trim() : "";
    var secondary = secondaryNode ? secondaryNode.textContent.trim() : "";
    if (!title) return "";

    function normalized(text) {
      return text.replace(/&/g, "and").replace(/\s+/g, " ").trim().toLowerCase();
    }
    var name = prefix || title;
    if (prefix && (" " + normalized(prefix) + " ").indexOf(" " + normalized(title) + " ") === -1) {
      name += " - " + title;
    }
    return name + (secondary ? " - " + secondary : "");
  }

  function cleanLinks() {
    document.querySelectorAll("a").forEach(function (link) {

      var text = link.textContent.trim();
      var hasImage = link.querySelector("img");
      var href = link.getAttribute("href");

      /* Override prior URL-slug fallbacks only for these native program grid links. */
      var programGridName = getProgramGridName(link);
      if (programGridName) {
        var programGridLabel = programGridName + " academic program";
        if (link.getAttribute("aria-label") !== programGridLabel) {
          link.setAttribute("aria-label", programGridLabel);
        }
        return;
      }

      /* Preserve authored accessible names, including linked-image alt text. */
      var namedBy = (link.getAttribute("aria-labelledby") || "").trim();
      var hasNamedBy = namedBy && namedBy.split(/\s+/).some(function (id) {
        var labelNode = document.getElementById(id);
        return labelNode && labelNode.textContent.trim();
      });
      var imageName = Array.from(link.querySelectorAll("img[alt]")).some(function (img) {
        return img.getAttribute("alt").trim();
      });
      if ((link.getAttribute("aria-label") || "").trim() || hasNamedBy || text || imageName) {
        return;
      }

      /* Case 1: Empty link or no readable text */
      if (!text && href) {

        var generatedText = "";

        /* Try to use nearby heading */
        var parent = link.closest("article, .item-result, .card, .post");
        if (parent) {
          var heading = parent.querySelector("h1, h2, h3, .program-title-test a");
          if (heading) {
            generatedText = heading.textContent.trim();
          }
        }

        /* Fallback to URL parsing */
        if (!generatedText) {
          generatedText = getReadableTextFromURL(href);
        }

        /* Apply accessible name */
        link.setAttribute("aria-label", generatedText);

        /* If no visible text at all, add hidden text */
        if (!hasImage) {
          var span = document.createElement("span");
          span.className = "sr-only";
          span.textContent = generatedText;
          link.appendChild(span);
        }
      }

      /* Case 2: Link contains only image */
      if (hasImage) {
        var img = link.querySelector("img");

        /* Fix missing or useless alt text */
        if (!img.getAttribute("alt") || img.getAttribute("alt").trim() === "") {
          var altText = "";

          if (text) {
            altText = text;
          } else if (href) {
            altText = getReadableTextFromURL(href);
          }

          img.setAttribute("alt", altText);
        }

        /* Ensure link has accessible name */
        if (!text && !link.getAttribute("aria-label")) {
          var label = img.getAttribute("alt") || getReadableTextFromURL(href);
          link.setAttribute("aria-label", label);
        }
      }

    });
  }

  /* Run initially */
  cleanLinks();

  /* Watch for dynamic content (important for your filters) */
  var observer = new MutationObserver(function () {
    cleanLinks();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  /* Backup delayed runs */
  setTimeout(cleanLinks, 500);
  setTimeout(cleanLinks, 1500);

});
</script>




