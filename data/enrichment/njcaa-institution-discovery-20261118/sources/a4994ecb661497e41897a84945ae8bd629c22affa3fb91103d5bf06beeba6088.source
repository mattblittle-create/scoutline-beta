<!-- Fix CookieYes heading level for SiteImprove SIA-R61 -->
<script>
(function () {
  function fixCookieYesHeading() {
    const observer = new MutationObserver(() => {
      const title = document.querySelector('.cky-title[role="heading"]');
      if (title) {
        title.removeAttribute('role');
        title.removeAttribute('aria-level');
        observer.disconnect();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
  if (document.body) {
    fixCookieYesHeading();
  } else {
    document.addEventListener('DOMContentLoaded', fixCookieYesHeading);
  }
})();
</script>
