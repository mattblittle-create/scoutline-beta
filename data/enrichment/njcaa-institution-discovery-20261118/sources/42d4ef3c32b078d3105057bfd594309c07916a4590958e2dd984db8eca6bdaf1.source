		// --- 1. Your Existing Video Play/Pause and Responsive Source Logic ---
		$(document).ready(function () {
			// Play/Pause functionality
			$('.play-pause-button').click(function () {
				var videoDesktop = $("#hero-video").get(0);
				if (videoDesktop.paused) {
					videoDesktop.play();
					$('.play-pause-button-img').attr("src", "/_resources/images/pause_icon.svg");
				} else {
					videoDesktop.pause();
					$('.play-pause-button-img').attr("src", "/_resources/images/play_icon.svg");
				}
			});

			function setVideoSource() {
				var width = $(window).width();
				var video = document.getElementById('hero-video');
				if (video) {
					var currentSrc = video.querySelector('source');
					var mobileVideoSrc = '';
					var desktopVideoSrc = '';
					var newSrc = width <= 768 ? mobileVideoSrc : desktopVideoSrc;

					if (!currentSrc || currentSrc.getAttribute('src') !== newSrc) {
						if (currentSrc) {
							video.removeChild(currentSrc);
						}
						var source = document.createElement('source');
						source.setAttribute('src', newSrc);
						source.setAttribute('type', 'video/mp4');
						video.appendChild(source);
						video.load();
					}
				}
			}

			setVideoSource(); // Set the initial video source

			$(window).resize(function () {
				setVideoSource(); // Update video source on window resize
			});
		});

		// --- 2. Swiper Carousel Initialization ---
		document.addEventListener('DOMContentLoaded', function () {
    var homeSwiper = new Swiper('.home-hero-swiper', {
        modules: [Swiper.Navigation, Swiper.Pagination, Swiper.A11y, Swiper.Autoplay],
        a11y: {
            enabled: true,
            prevSlideMessage: 'Previous slide',
            nextSlideMessage: 'Next slide',
            firstSlideMessage: 'This is the first slide',
            lastSlideMessage: 'This is the last slide',
            paginationBulletMessage: 'Go to slide {{index}}',
        },
        loop: true,
        autoplay: {
            delay: 5000,
            disableOnInteraction: false,
        },
        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        },
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
        },
        keyboard: {
            enabled: true,
            onlyInViewport: true,
        },
    });

    // --- Carousel Pause/Play Toggle Logic (Moved inside scope) ---
    var playPauseBtn = document.getElementById('slider-play-pause');
    if (playPauseBtn) {
        var isPlaying = true;
        playPauseBtn.addEventListener('click', function () {
            if (isPlaying) {
                homeSwiper.autoplay.stop();
                playPauseBtn.setAttribute('aria-label', 'Play slideshow');
                playPauseBtn.setAttribute('aria-pressed', 'true');
                var icon = playPauseBtn.querySelector('.slider-toggle-icon');
                if (icon) { icon.className = 'slider-toggle-icon fa-solid fa-play'; }
                isPlaying = false;
            } else {
                homeSwiper.autoplay.start();
                playPauseBtn.setAttribute('aria-label', 'Pause slideshow');
                playPauseBtn.setAttribute('aria-pressed', 'false');
                var icon = playPauseBtn.querySelector('.slider-toggle-icon');
                if (icon) { icon.className = 'slider-toggle-icon fa-solid fa-pause'; }
                isPlaying = true;
            }
        });
    }
});
		</script>
