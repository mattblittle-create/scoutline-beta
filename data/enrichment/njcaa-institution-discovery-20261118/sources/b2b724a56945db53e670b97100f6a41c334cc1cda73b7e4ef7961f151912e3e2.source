            scrollTriggerElements.forEach(function (element) {
                if (element.dataset['ga4Event']) {
                    scrollObserver.observe(element);
                }
            });
                        document.addEventListener('click', function (event) {
                handleNestedClick(event.target);
            });

                                                function handleNestedClick(target) {
                const parent = target.parentElement;

                                if (parent) {
                    const elementData = target.dataset;

                    if (elementData['ga4Event'] !== undefined) {
                                                                        const tagObject = JSON.parse(elementData.ga4Event);

                        if (tagObject.clickScrollParams.category === 'clickEvent') {
                            semTag(tagObject);
