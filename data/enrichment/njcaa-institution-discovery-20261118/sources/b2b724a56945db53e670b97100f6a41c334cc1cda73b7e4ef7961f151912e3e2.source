    // So on load, we generate a random number 1-4
    $(function () {
        var randomNumber = randomNumberFromRange(1, 4);

        // We make that random number the randomNumber var
        function randomNumberFromRange(min, max) {
            return Math.floor(Math.random() * (max - min + 1) + min);
        }
        // We make a new variable that is the css selector, add the number to be the nth type
        var visibleSpotlight = '.spotlight.d-none:nth-of-type(' + randomNumber + ')';
        // We remove the display none class, so it shows up.
        $(visibleSpotlight).removeClass('d-none');
    });
</script></div></div></div>
                                        
