        data-ga-scroll-label="Spotlight"><div class="spotlight d-none "><div class="container"><div class="row"><div class="col-12 px-0"><div class="d-md-flex"><div class="col-md-6 spotlightImgHolder px-0 d-flex align-items-center "><picture><source media="(min-width: 1200px)"
                                    srcset="/ssap/assets/source/website/homepage/1-expanding-lg.jpg"><source media="(min-width: 768px)"
                                    srcset="/ssap/assets/source/website/homepage/1-expanding-md.jpg"><source media="(min-width: 1px)"
