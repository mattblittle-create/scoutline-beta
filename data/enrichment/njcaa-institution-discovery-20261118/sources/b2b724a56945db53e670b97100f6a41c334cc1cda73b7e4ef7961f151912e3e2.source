         * and pushes the resulting Consent Mode signals to the dataLayer.
         *
         * @param {Boolean} isFromEvent
         */
        function setConsentObject(isFromEvent) {
            const stored = window.localStorage.getItem('sscCookieStatement');
            cookieStatus = stored ? JSON.parse(stored) : {accept: null, types: []};

            analyticsStorage = cookieStatus.accept !== null && cookieStatus.types.indexOf('performanceType') !== -1 ? consentGranted : consentDenied;
