<div class="tab-content">
  
    <div class="tab-pane show active"
         id="section-1"
         role="tabpanel"
         aria-labelledby="section-1-tab">
      <h3 class="mb-4 text-white">Affordability</h3>
      
        <p class="mb-4">Southern Union State Community College offers an affordable option for quality academic, technical, and health science programs.</p>
      
        <p class="mb-0"><a href="/admissions/financial-aid-overview" class="btn btn-yellow-link">Learn More</a></p>
      
    </div>
  
    <div class="tab-pane show"
         id="section-2"
         role="tabpanel"
         aria-labelledby="section-2-tab">
      <h3 class="mb-4 text-white">Active Campus Life</h3>
      
        <p class="mb-4">SUSCC is one of a select few community colleges to offer a comprehensive program of fine arts as well as many other student clubs and organizations.</p>
      
        <p class="mb-0"><a href="/students/ambassadors" class="btn btn-yellow-link">Learn More</a></p>
      
    </div>
  
    <div class="tab-pane show"
         id="section-3"
         role="tabpanel"
         aria-labelledby="section-3-tab">
      <h3 class="mb-4 text-white">Concurrent Enrollment</h3>
      
        <p class="mb-4">Concurrent Enrollment offers opportunities for students to work on their Associate in Science degree and their bachelor's degree at the same time.</p>
      
        <p class="mb-0"><a href="/programs/Overview" class="btn btn-yellow-link">Learn More</a></p>
      
    </div>
  
    <div class="tab-pane show"
         id="section-4"
         role="tabpanel"
         aria-labelledby="section-4-tab">
      <h3 class="mb-4 text-white">Scholarships</h3>
      
        <p class="mb-4">Students may be able to obtain scholarships based on academic/technical achievement, participation in extracurricular and leadership activities, and exhibited talents of the fine arts.</p>
      
        <p class="mb-0"><a href="/admissions/scholarships" class="btn btn-yellow-link">Learn More</a></p>
      
    </div>
  
</div>
                                        </div>
                                        
                                   </div>
                              </div>
