  function hideMobileNav() {
      jQuery(".mobileOn .menu").animate({ "right": "-240px" }, 400, function () {
          jQuery('.mobileOn .menu').hide().animate({ "right": "-240px" }, 300);
      });
      jQuery('body').removeClass('mobileOn');
      jQuery('body').removeClass('disableScrolling');
  }

  jQuery(document).ready(function() {
    jQuery(function(){
      var $topmenulink = $('#topmenutoggle div');
      var $topmenubar  = $('#topmenubar');
      jQuery("#topmenutoggle").css("opacity", "1");
      jQuery(".mega-menu-trigger.no-js").css("display", "none");
      jQuery('.main-nav &gt; ul li a.mega-menu-trigger').on('click', function(e){
         
        e.preventDefault();
        jQuery(".mega-wrapper").toggleClass("on");
        
        // if ($(window).width() &gt; 961) {
        //   jQuery("html, body").animate({
        //       scrollTop: 0
        //   }, 600);
        // }
       
        if ($(window).width() &gt; 961) {
          //jQuery(".header").css("position","relative");
        }
         
        if($(this).attr('id') == 'topmenutoggle') {
          if(!$topmenubar.is(":visible")) {
            // if invisible we switch the icon to appear collapsable
            $topmenulink.removeClass('menu-icon-off').addClass('menu-icon-on');
            jQuery('.search-icon-off').hide();
            //jQuery('body').addClass('is-visible disableScrolling');
          } else {
            // if visible we switch the icon to appear as a toggle
            $topmenulink.removeClass('menu-icon-on').addClass('menu-icon-off');
            jQuery('.search-icon-off').show();
            //jQuery('body').removeClass('is-visible disableScrolling');
            //jQuery(".header").css("position","fixed");
          }
          
          

                  $topmenubar.slideToggle(300,function(){
            // toggle slide
            });
           
        }
      });
    });


    window.__gcse = {
      callback: googleCSELoaded
    };



    function googleCSELoaded() {
      // The hook in question.
      $("#customSearch").click(function() {
      var searchText = $("#customSearchText").val();
      console.log(searchText);
      var element = google.search.cse.element.getElement('searchOnlyCSE');
      element.execute(searchText);
      })
      $('#customSearchText').keydown(function (event) {
      var keypressed = event.keyCode || event.which;
      var searchText = $("#customSearchText").val();
      console.log(searchText);
      var element = google.search.cse.element.getElement('searchOnlyCSE');
        if (keypressed == 13) {
             element.execute(searchText);
        }
      });
    }
  });
  
  
  
</script>



    
     











 
    















 




