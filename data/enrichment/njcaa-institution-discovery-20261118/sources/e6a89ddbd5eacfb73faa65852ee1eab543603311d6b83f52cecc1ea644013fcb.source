	<!-- ACCESSIBILITY FIX FOR UNTITLED IFRAMES -->
	<script>
//
		<![CDATA[
document.querySelectorAll('iframe:not([title])').forEach(function(iframe) {
    if (iframe.src.indexOf('youtube.com') > -1) {
        iframe.setAttribute('title', 'YouTube video');
    } else if (iframe.src.indexOf('issuu.com') > -1) {
        iframe.setAttribute('title', 'Issuu document');
    } else if (iframe.src.indexOf('matterport.com') > -1) {
        iframe.setAttribute('title', 'Virtual Tour');
    }
});
//]]>
	</script>
<!-- ACCESSIBILITY FIX FOR BAD ALT TAGS â€” [2026] also catches images added later (GTM beacons) -->
<script>//<![CDATA[
(function () {
  function fixAlt(img) {
    var src = img.getAttribute("src") || "";
    var name = src.split("/").pop().split("?")[0].replace(/\.[^.]+$/, "").toLowerCase();
    if (!img.hasAttribute("alt")) {
      img.setAttribute("alt", "");
    } else if (img.getAttribute("alt").trim().toLowerCase() === name) {
      img.setAttribute("alt", "");
    }
  }
  function fixAll(root) {
    if (root.querySelectorAll) { root.querySelectorAll("img").forEach(fixAlt); }
  }
  fixAll(document);
  new MutationObserver(function (records) {
    records.forEach(function (r) {
      r.addedNodes.forEach(function (n) {
        if (n.nodeType !== 1) { return; }
        if (n.tagName === "IMG") { fixAlt(n); } else { fixAll(n); }
      });
    });
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
//]]></script>
<!-- END ACCESSIBILITY FIX FOR BAD ALT TAGS -->
	<!--INCLUDE EMERGENCY ALERTS-->
	<script type="text/javascript">
        //build cachebuster, so latest version of alert is always loaded
        var cachebuster = Math.round(new Date().getTime() / 1000);
        var alertUrl = "//www.slcc.edu/emergency-alert.html?cb=" + cachebuster;
        $(document).ready(function () {
            $.ajax({
                url: alertUrl,
                error: function () {
                    // ignore on failure
                },
                success: function (result) {
                    //check 404 to see if page is currently published
                    // [2026] target changed from .header-container (legacy fixed header) to #emergency-alert
                    if (result.indexOf("404") === -1) $('#emergency-alert').append(result);
                    }
            });
   });
	</script>
	<!--INCLUDE EMERGENCY ALERTS-->


