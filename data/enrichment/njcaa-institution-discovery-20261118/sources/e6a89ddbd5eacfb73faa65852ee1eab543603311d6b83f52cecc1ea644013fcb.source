  <div class="page-content" id="page-body">
  	
 <div class="landing-2026 home-2026">
<div class="announcementBar">
<div class="container text-center">
<a class="lp-announce d-inline-flex align-items-center justify-content-center gap-lg-4 gap-2" href="http://slcc.edu/apply"><span>Apply Now for Spring Semester</span><img alt="" height="25" src="https://www.slcc.edu/_redesign/_files/images/2026-redesign/blue-chevron.svg" width="25"/></a>
</div>
</div>
<div class="headerHome position-relative d-flex align-items-end" style="background-image: url('https://www.slcc.edu/_redesign/_files/images/2026-redesign/hero-Image-updated.jpg');">
<div class="container-fluid px-0">
<div class="headerHome-banner text-center">
<h1><a class="lp-banner-link stretched-link" href="https://www.slcc.edu/get-started-landing.aspx"> <span>Flexible. Affordable. Transferable.</span><span class="visually-hidden">: enroll at SLCC</span></a></h1>
</div>
</div>
</div>
<section aria-labelledby="lp-strip" class="enrollNowSection position-relative">
<div class="container">
  <h2 class="text-center" id="lp-strip"><a class="lp-banner-link stretched-link" href="https://www.slcc.edu/get-started-landing.aspx">That's <span>SLCC</span><span class="visually-hidden">: get started at SLCC</span></a></h2>
</div>
</section>
<section aria-labelledby="lp-path" class="chooseYourPathSection px-xl-0 px-3">
<div class="container-xl">
<h2 class="section-h2 text-center" id="lp-path">Don't know where to start? We got you.</h2>
<p class="lp-lede text-center mb-5">With 120+ certificates and degrees, there's something here for you.</p>
<ul class="lp-path-list">
<li class="path-card-col">
<div class="card path-card h-100 border-0 position-relative">
<div class="card-icon"> <i class="fa-light fa-graduation-cap" aria-hidden="true"></i> </div>
<div class="card-body p-0 d-flex align-items-end">
<h3 class="mb-0"><a class="stretched-link" href="https://www.slcc.edu/academics/index.aspx?goal=degree"><span>78</span> Degrees</a></h3>
</div>
</div>
</li>
<li class="path-card-col">
<div class="card path-card h-100 border-0 position-relative">
<div class="card-icon"> <i class="fa-light fa-file-certificate" aria-hidden="true"></i> </div>
<div class="card-body p-0 d-flex align-items-end">
<h3 class="mb-0"><a class="stretched-link" href="https://www.slcc.edu/academics/index.aspx?goal=certificate"><span>56</span> Certificates</a></h3>
</div>
</div>
</li>
<li class="path-card-col">
<div class="card path-card h-100 border-0 position-relative">
<div class="card-icon"> <i class="fa-light fa-user-helmet-safety" aria-hidden="true"></i> </div>
<div class="card-body p-0 d-flex align-items-end">
<h3 class="mb-0"><a class="stretched-link" href="https://www.slcc.edu/academics/index.aspx?goal=workforce-microcredential"><span>39</span> Workforce Microcredentials</a></h3>
</div>
</div>
</li>
<li class="path-card-col">
<div class="card path-card h-100 border-0 position-relative">
<div class="card-icon"> <i class="fa-light fa-compass" aria-hidden="true"></i> </div>
<div class="card-body p-0 d-flex align-items-end">
<h3 class="mb-0"><a class="stretched-link" href="https://www.slcc.edu/academics/index.aspx"><span>Career</span> Exploration</a></h3>
</div>
</div>
</li>
</ul>
<p class="lp-lede text-center mt-5">We're invested in helping students graduate or transfer quickly and affordably.</p>
<div class="text-center mt-4">
<a class="arrow-btn btn btn-yellow text-uppercase rounded-pill px-5 fw-bold py-2" href="https://www.slcc.edu/academics/index.aspx">Explore Programs</a>
</div>
</div>
</section>
