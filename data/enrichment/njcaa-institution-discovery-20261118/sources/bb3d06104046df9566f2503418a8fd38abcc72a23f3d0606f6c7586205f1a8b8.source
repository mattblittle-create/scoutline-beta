<style>
    html {
        overflow-x: hidden;
    }
    #main {
        padding: 0;
    }

    .kvcc-hero {
     background: url("https://images.prismic.io/kvcc-home/nLod9WWtOBVXxN5K_60thHeader_2.jpg?auto=format,compress&rect=0,0,3840,1080&w=3840&h=1080") center center;
            background-size: cover;
        background-color: #003f51;
        min-height: 32rem;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
    }

    .kvcc-hero__container {
        display: flex;
        justify-content: start;
        flex-direction: column;
        padding: 2rem;
        height: 100%;
        min-height: 28rem;
    }

    .kvcc-hero__content {
        transition: all 0.25s ease;
        /*display: flex;*/ 
        display: none; /* keep hidden for Reconnect promo */
        flex-direction: column;
        justify-content: start;
        align-items: start;
        background-color: rgba(0, 127, 176, 0.9);
        color: white;
        text-decoration: none;
        padding: 2rem;
        box-shadow: 0 0 0.25rem 0 rgba(0, 0, 0, 0.125);
    }

    .kvcc-hero__content a {
        color: white;
    }

    .kvcc-hero__content__h2 {
        font-size: 2.25rem;
    }

    .kvcc-hero__content__description {
        font-size: 1rem;
        line-height: 1rem;
        margin-top: 1rem;
        margin-bottom: 0;
    }

    .kvcc-hero__content__description p {
        margin: 0;
    }

    .kvcc-hero__button {
        transition: all 0.25s ease;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        background-color: white;
        color: rgba(0, 127, 176, 1);
        text-decoration: none;
        font-weight: 500;
        padding: 1.125rem;
        border-radius: 0.375rem;
        font-size: 1.5rem;
        box-shadow: 0 0 0.25rem 0 rgba(0, 0, 0, 0.125);
        margin: 1rem auto 0;
    }

    .kvcc-hero__button__icon {
        margin-right: 0.5rem;
    }

    .kvcc-hero__button:hover, .kvcc-hero__button:focus {
        background-color: rgba(0, 127, 176, 1);
        color: white;
    }

    .kvcc-hero__announcements {
        background-color: rgba(0, 127, 176, 0.9);
        color: white;
        padding: 2rem;
        width: 20rem;
        max-width: 100%;
    }

    .kvcc-hero__announcements__heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0 0 2rem;
        font-size: 1.75rem;
    }

    .kvcc-hero__announcements__h2 {
        line-height: 100%;
        margin: 0;
        font-weight: 500;
        font-size: 1.75rem;
    }

    .kvcc-hero__announcements__ul {
        padding: 0 0 0 1rem;
        font-size: 1.125rem;
        line-height: 135%;
    }

    .kvcc-hero__announcements__li {
        margin: 0 0 1rem;
    }

    .kvcc-hero__announcements__a {
        color: white;
        font-weight: normal;
    }
    
    .reconnect {
        display: none;
    }

    @media (min-width: 48em) {
        .kvcc-hero {
            flex-direction: row;
            }

        .kvcc-hero__container {
            flex-direction: row;
            align-items: flex-end;
            min-height: 32rem;
                padding: 2rem;
        }

        .kvcc-hero__button {
            margin: 0 0 0 2rem;
        }

        .kvcc-hero__announcements {
            height: 100%;
