    <script>
        var label = document.getElementById("pos-hamburger");
        var input = document.getElementById("pathways-mobile-menu");
        var links = document.querySelectorAll("#pathway-navigation a");
        var closeButton = document.getElementById("pathways-navigation-close");

        function expandMenu() {
            input.checked = true;
            input.setAttribute("aria-expanded", "true");

            // Update tabindex values when menu is expanded
            links.forEach(function(link) {
                link.setAttribute("tabindex", "0");
            });
            closeButton.setAttribute("tabindex", "0");
        }

        function collapseMenu() {
            input.checked = false;
            input.setAttribute("aria-expanded", "false");

            // Update tabindex values when menu is collapsed
            links.forEach(function(link) {
                link.setAttribute("tabindex", "-1");
            });
            closeButton.setAttribute("tabindex", "-1");
        }

        label.addEventListener("click", function() {
            if (input.checked) {
                collapseMenu();
            } else {
                expandMenu();
            }
        });

        label.addEventListener("keydown", function(event) {
            if (event.key === "Enter") {
                if (input.checked) {
                    collapseMenu();
                } else {
                    expandMenu();
                }
            }
        });

        closeButton.addEventListener("click", function() {
            collapseMenu();
        });
    </script>
</div>
