			<script>
var button = document.getElementById("kvcc-site-navigation-label");
var checkbox = document.getElementById("kvcc-site-navigation");
var menuItems = document.querySelectorAll(".kvcc-utility-navigation-menu [tabindex='-1'], .kvcc-primary-navigation [tabindex='-1']");

button.addEventListener("click", function(event) {
  event.preventDefault();
  checkbox.checked = !checkbox.checked;
  button.setAttribute("aria-expanded", checkbox.checked);
  
  if (checkbox.checked) {
    menuItems.forEach(function(item) {
      item.setAttribute("tabindex", "0");
    });
  } else {
    menuItems.forEach(function(item) {
      item.setAttribute("tabindex", "-1");
    });
  }
});

button.addEventListener("keydown", function(event) {
  if (event.key === "Enter") {
    event.preventDefault();
    checkbox.checked = !checkbox.checked;
    button.setAttribute("aria-expanded", checkbox.checked);
    
    if (checkbox.checked) {
      menuItems.forEach(function(item) {
        item.setAttribute("tabindex", "0");
      });
    } else {
      menuItems.forEach(function(item) {
        item.setAttribute("tabindex", "-1");
      });
    }
  }
});
	</script>
