	<meta name="et-api-version" content="v1"><meta name="et-api-origin" content="https://www.bhc.edu"><link rel="https://theeventscalendar.com/" href="https://www.bhc.edu/wp-json/tribe/tickets/v1/" /><meta name="tec-api-version" content="v1"><meta name="tec-api-origin" content="https://www.bhc.edu"><link rel="alternate" href="https://www.bhc.edu/wp-json/tribe/events/v1/events/?categories=athletics" /><style class="wpcode-css-snippet">/* Event Single CSS */

/* ==========================================================================
   IFC Additions 6.11.29
   ========================================================================== */
/* Make Venue details stack vertically in a single column in the sidebar */
.event-details .tribe-block__venue {
    display: flex !important;
    flex-direction: column !important;
    background: transparent !important;
}
.event-details .tribe-block__venue__meta {
    width: 100% !important;
    padding-bottom: 15px !important;
}
.event-details .tribe-block__venue__map,
.event-details .tribe-block__venue__map iframe {
    width: 100% !important;
    max-width: 100% !important;
    display: block !important;
}
/* Add to Calendar Button Hover Tweak */
.tribe-events-c-subscribe-dropdown__button:hover,
.tribe-events-c-subscribe-dropdown__button:hover .tribe-events-c-subscribe-dropdown__button-text {
    color: var(--color-white) !important;
	transition: 0.2s;
}
.tribe-events-c-subscribe-dropdown__button:hover svg path {
    fill: var(--color-white) !important;
}
/* Fix shortcode content buttons on hover inside events */
.single-tribe_events .btn:hover,
.single-tribe_events .link-wrap .btn:hover,
.single-tribe_events .btn:hover span {
    color: #ffffff !important;
    text-decoration: none !important;
	transition: 0.2s;
}
/* Buttons inside .event-details */
.event-details .tribe-block__event-website a, .event-details .link-wrap a.btn {
	width: 100% !important;
	border-radius: 0 !important;
	text-decoration: none !important;
}
.event-details .tribe-block__event-website a {
	border: 1px solid var(--color-yellow);
}
.event-details .tribe-block__event-website a:hover {
	transition: 0.2s;
	background-color: var(--color-white) !important;
	color: var(--color-black) !important;
	border: 1px solid var(--color-black);
}
/* Prevent Notice Banner from bleeding under the sticky sidebar */
.single-tribe_events .tribe-events-status-single--canceled, 
.single-tribe_events .tribe-events-status-single--postponed, 
.single-tribe_events .tribe-events-status-single--rescheduled {
    max-width: 66.66% !important;
    box-sizing: border-box;
    margin-bottom: 1.5em;
}

@media screen and (max-width: 768px) {
    .single-tribe_events .tribe-events-status-single--canceled, 
    .single-tribe_events .tribe-events-status-single--postponed, 
    .single-tribe_events .tribe-events-status-single--rescheduled {
        max-width: 100% !important;
    }
}
/* Hide the Gutenberg Date/Time Block inside the main content area */
.single-tribe_events .type-tribe_events > .tribe-events-schedule {
    display: none !important;
}
/* Hide redundant TEC headers on single events (handled by the Black Box now) */
.single-tribe_events .tribe-events-single-event-title,
.single-tribe_events .tribe-events-back {
    display: none !important;
}
/* Expand the Black Box Title to full width */
@media only screen and (min-width: 1170px) {
    .single-tribe_events .featured-image-and-title .inner-wrap {
        width: 100% !important;
        max-width: 1350px; /* Keeps it aligned with your main content container */
    }
}
/* Remove the massive gap between breadcrumbs and date/time */
.single-tribe_events #tribe-events, 
.single-tribe_events #tribe-events-pg-template, 
.single-tribe_events .tribe-events-pg-template {
    padding-top: 15px !important;
    margin-top: 0 !important;
}
/* Desktop Layout: Constrain header info and bump the sidebar up */
@media only screen and (min-width: 782px) {
    /* Constrain the date/time and venue links to the left column's width */
    .bhc-event-header-schedule,
    .bhc-event-venue-links {
        width: 66.66%;
        padding-right: 2em; /* Adds breathing room so text doesn't touch the sidebar */
        box-sizing: border-box;
    }
}
/* Fix the Related Events Thumbnail overflow */
.tribe-events-single ul.tribe-related-events li .tribe-related-events-thumbnail img {
    transform: none !important;
    position: static !important; /* Overrides the absolute positioning hack */
    width: 100% !important;
    height: auto !important;
    object-fit: cover; /* Ensures the image fills the space beautifully without stretching */
}
/* Hide the Gutenberg Date/Time Block on the Frontend */
.single-tribe_events .wp-block-tribe-event-datetime,
.single-tribe_events .tribe-block__event-datetime {
    display: none !important;
}
/* Event Details Sidebar Typography Fixes */
#tribe-events-content .event-details h2.wp-block-heading {
    font-size: 1.75rem !important; /* "EVENT DETAILS" Header */
    text-transform: uppercase !important;
    margin-bottom: 1rem !important;
}
#tribe-events-content .event-details h3.wp-block-heading {
    font-size: 1.25rem !important; /* "Venue", "Organizer", etc. */
    text-transform: none !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.5rem !important;
}
/* Shrink the dynamic Venue and Organizer links */
#tribe-events-content .event-details .tribe-block__venue__name h3 a,
#tribe-events-content .event-details .tribe-block__organizer__title h3 a {
    font-size: 1rem !important;
    text-decoration: underline !important;
}
/* Standardize the paragraph, link, and taxonomy text sizes in the sidebar */
#tribe-events-content .event-details p, 
#tribe-events-content .event-details span, 
#tribe-events-content .event-details a,
#tribe-events-content .event-details .wp-block-post-terms {
    font-size: 1rem !important;
    line-height: 1.4 !important;
}
/* Remove awkward top border/padding from TEC Organizer/Venue details */
.tribe-block__organizer__details, 
.tribe-block__venue__meta {
    padding-top: 0 !important;
}
/* Links (Categories & Tags Underline Fix) */
.single-tribe_events a {
	text-decoration: underline;
	font-weight: bold;
}
/* Buttons */
main.bdy .tribe-events-single a.btn, .tribe-events-single a.btn-alt {
	color: var(--text-color);
	text-decoration: none;
}
main.bdy .tribe-events-single-event-description a.btn {
	--border-color: var(--color-black);
	border-bottom: 1px solid var(--color-black);
	font-size: 1rem;
}
main.bdy .tribe-events-single-event-description a.btn-alt {
	border-bottom: none;
}
/* ==========================================================================
   New Template Details (Sticky Nav, Lists, Spacing)
   ========================================================================== */
.inner-nav-sticky .event-details {
	top: 140px;
	position: sticky;
	padding-bottom: 1em;
}
.event-details .wp-block-columns {
	gap: 1em;
}
.event-details h3 {
	margin: 0.75em 0;
}
.tribe-events-content ul, .tribe-events-content ol {
	display: block;
    list-style-type: disc;
    margin-block-start: 1em;
    margin-block-end: 1em;
    unicode-bidi: isolate;
}
.tribe-events-content li {
    margin-bottom: 0.25em;
	text-indent: -1.4em;
	padding-left: 3em;
}
@media screen and (max-width: 781px) {
	.tribe-events-content img {
		width: 100%;
	}
}
@media screen and (min-width: 932px) {
	.tribe-events-content img.alignright {
	    max-width: 50% !important;
	}
}

/* ==========================================================================
   Meta Data & Section Titles (Responsive H2/H3)
   ========================================================================== */
.tribe-events-status-single--canceled, .tribe-events-status-single--postponed, .tribe-events-status-single--rescheduled {
	width: 100%;
    background-color: #f8d7da;
    border: 3px solid #f5c2c7 !important;
}
.tribe-events-event-meta {
	width: 100% !important;
    background-color: var(--color-light-grey) !important;
	padding: 1.5em !important;
}
.tribe-events-event-meta:before, .tribe-events-related-events-title, #tribe-events-footer {
	border-top: none !important;
}
.tribe-events-meta-group h2.tribe-events-single-section-title, .tribe-events-meta-group h3.tribe-events-single-section-title, .tribe-common h2 {
	font-size: 2.5rem !important;
	margin-bottom: 0.5em;
	margin-top: 0;
}
h2.tribe-events-related-events-title, h3.tribe-events-single-section-title, h2.tribe-block__related-events__title {
	text-transform: uppercase;
	font-size: 2.15rem;
	max-width: 768px;
	position: relative;
    font-family: var(--font-ibm-plex-sans) !important;
}
@media only screen and (min-width:768px) {
	h2.tribe-events-related-events-title, h3.tribe-events-single-section-title, h2.tribe-block__related-events__title {
	    font-size: 2.5rem;
	}
}
@media only screen and (min-width:980px) {
    h2.tribe-events-related-events-title, h3.tribe-events-single-section-title, h2.tribe-block__related-events__title {
        font-size: 3.5rem;
	}
}
@media only screen and (min-width:1170px) {
    h2.tribe-events-related-events-title, h3.tribe-events-single-section-title, h2.tribe-block__related-events__title {
        font-size: 3.8rem;
	}
}
h3.tribe-events-single-section-title {
	padding-top: 0.5em;
}
.tribe-events-meta-group {
	flex: 1 0 140px;
	margin-right: var(--tec-spacer-5);
	order: 0;
	padding: 0;
}
.tribe-events-meta-group dl dt {
	font-size: 1.2rem;
	font-weight: bold;
	padding-top: 4px;
}
.tribe-events-meta-group dl dd {
	font-size: 1.125rem;
}

/* ==========================================================================
   Venue & Organizer Blocks
   ========================================================================== */
.tribe-block__venue {
	max-width: 100% !important;
	background-color: var(--color-light-grey) !important;
	border: none;
	margin-top: 0.75em;
	padding: 0;
}
.tribe-block__venue__name h3 a {
	font-size: 1.25rem;
	font-weight: bold;
	text-decoration: underline;
}
.tribe-block__venue__meta span {
	font-size: 1.125rem !important;
}
.tribe-block__venue__website {
	text-decoration: underline;
}
.tribe-block__venue__meta::before {
	content: "Venue";
	font-size: 2.5rem;
	text-transform: uppercase;
	font-family: var(--font-ibm-plex-sans) !important;
	margin-bottom: 0.5em;
	font-weight: 700;
	line-height: 1.64;
}
.tribe-events-pro-venue__meta-content ul {
	list-style: disc;
	margin-left: 1.5em;
}
.tribe-events-pro-venue__meta-content ul li a {
	text-decoration: underline !important;
}
.tribe-block__organizer__details {
	margin: 0;
    padding: 0;
	border-top: none;
}
.tribe-block__organizer__details p {
	margin-bottom: 0;
}
.tribe-block__organizer__title h3 {
	margin: 0 !important;
}
@media screen and (max-width: 768px) {
	.tribe-block__venue__meta, .tribe-block__venue__map {
		width: 100% !important;
	}
}
@media screen and (min-width: 768px) and (max-width: 992px) {
	.tribe-block__venue__meta, .tribe-block__venue__map {
		width: 100% !important;
	}
	.tribe-block__venue {
		display: block;
	}
}
@media (min-width: 768px) {
    .tribe-events-venue-map {
      width: 100%;
    }
}
.tribe-events-venue-map iframe {
	max-height: 250px;
}

/* ==========================================================================
   Event Tags & Tickets
   ========================================================================== */
.tribe-events-section-tags li.tribe-events-meta-item .tribe-events-meta-label {
	display: none;
}
.tribe-events-section-tags li.tribe-events-meta-item {
	list-style: none;
}
.event-tickets .tribe-tickets__rsvp-wrapper {
	max-width: 100% !important;
	margin-bottom: 2em;
}
.event-tickets .tribe-tickets__rsvp-wrapper {
	border-radius: 0 !important;
}
/* ==========================================================================
   Related Events & Next/Prev Sub-Nav
   ========================================================================== */
.tribe-related-event-info {
	padding: 0 1em !important;
}
h3.tribe-related-events-title a {
	font-size: 1rem;
	line-height: 120%;
}
.tribe-events-single ul.tribe-related-events {
	display: flex;
	justify-content: flex-start;
	width: 100% !important;
	gap: 1.5em;
}
.tribe-events-single ul.tribe-related-events::before,
.tribe-events-single ul.tribe-related-events::after {
	content: none !important;
	display: none !important;
}
.tribe-events-single ul.tribe-related-events li {
	border: 1px solid var(--color-black);
	background-color: var(--color-white);
	border-bottom: 5px solid var(--color-black);
	padding-bottom: 1em;
	margin: 0 !important;
	border-radius: 0;
	float: none !important;
	flex: 1 1 0;
}
@media screen and (max-width: 576px) {
	ul.tribe-related-events {
		display: flex;
		flex-direction: column;
	}
	.tribe-events-single ul.tribe-related-events li {
		width: 100% !important;
		margin-bottom: 1.25em;
	}
	.tribe-events-event-meta {
		display: block !important;
	}
}
@media screen and (max-width: 768px) {
    .tribe-events-sub-nav li {
		max-width: 250px !important;
		width: 48% !important;
	}
	.tribe-events-sub-nav li a {
		background-color: var(--color-yellow);
		border: 1px solid var(--color-black);
		line-height: 125%;
		text-align: center;
	}
	.tribe-events-sub-nav li a:visited {
		color: var(--color-black);
	}
}
/* Series Relationships fixes */
.tribe-events-series-relationship-single-marker--pill {
    float: none !important;
}
.bhc-header-meta-inject .bhc-header-date .tribe-events-series-relationship-single-marker {
	display: none;
}
/* ==========================================================================
   Header Schedule
   ========================================================================== */
.tribe-events-schedule {
	margin: 1em 0 !important;
}
.tribe-events-schedule ul {
	list-style: none;
	padding: 0;
	display: flex;
	font-size: 1.25rem;
	flex-wrap: wrap;
}
.tribe-events-schedule ul li {
	margin-right: 0.6em;
	font-size: 1.25rem !important;
	display: inline-block;
	line-height: 130%;
}
.tribe-events-cost {
	order: 0 !important;
	background-color: var(--color-yellow);
	padding: 0 0.25em;
}
.tribe-events-schedule ul li.tribe-events-venue {
	width: 100%;
}
.tribe_events-template-default h1.pg-title {
	text-transform: none;
}
.tribe_events-template-default .bdy .featured-image-and-title {
	border-bottom: 10px solid var(--color-yellow);
}
.tribe_events-template-default .bdy .featured-image-and-title .wrap .inner-wrap {
	width: 80%;
}
/* Inner Nav on Event Page */
@media screen and (max-width: 781px) {
.inner-nav {
	margin-top: 10px !important;
}
}
@media screen and (min-width: 782px) {
.inner-nav {
	margin-top: 10px !important;
}
	.block.inner-nav .inner {
		padding: 30px !important;
	}
	.inner-nav .inner .anchor-menu-mobile {
		display: block !important;
		padding: 0 !important;
	}
	.inner-nav .inner .anchor-menu-items {
		display: none;
	}
	.inner-nav .inner .anchor-menu-items h2 {
		display: none !important;
	}
}
.block:first-child {
	margin-top: 0;
}
/* RSVP Block */
.event-tickets {
	margin: 50px 0;
}
.event-tickets form.tribe-tickets__tickets-form {
	border: 1px solid var(--color-black) !important;
	border-radius: 0 !important;
	border-bottom-width: 5px !important;
	width: 100%;
	max-width: 700px !important;
}
.tribe-tickets__rsvp-actions-wrapper {
	border: none !important;
}
.tribe-tickets__rsvp-actions-button-going, .tribe-tickets__tickets-buy {
	color: var(--color-black) !important;
}
.tribe-tickets__rsvp-actions-button-going:hover, .tribe-tickets__tickets-buy:hover {
	color: var(--color-white) !important;
}
/* Tickets Block */
.tribe-tickets__tickets-item {
	border-top: 1px solid var(--color-black) !important;
}
.event-tickets .tec-tickets-plus-purchase-rules-messages__container {
    border-top: 1px solid var(--color-black);
}
.tribe-common-h3, .tribe-common-h4, .tribe-common-h5 {
	font-family: var(--font-ibm-plex-sans) !important;
	font-weight: 700 !important;
	color: var(--color-black) !important;
	max-width: 100% !important;
}
.tribe-common-h4 {
	font-size: 3.2rem;
