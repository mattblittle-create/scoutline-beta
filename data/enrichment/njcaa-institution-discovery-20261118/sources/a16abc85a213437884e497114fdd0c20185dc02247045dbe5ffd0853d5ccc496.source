<script type="application/ld+json" class="rank-math-schema-pro">{"@context":"https://schema.org","@graph":[{"@type":"CollegeOrUniversity","@id":"https://www.bhc.edu/#organization","name":"Black Hawk College","url":"https://www.bhc.edu","sameAs":["https://www.facebook.com/blackhawkcollege","https://twitter.com/BHCCampus","https://www.instagram.com/bhccampus/","https://www.linkedin.com/school/438489/","https://www.youtube.com/user/BHCBlackHawkCollege"],"email":"info@bhc.edu","logo":{"@type":"ImageObject","@id":"https://www.bhc.edu/#logo","url":"https://www.bhc.edu/wp-content/uploads/bhc-default-image-e1738963186821.jpg","contentUrl":"https://www.bhc.edu/wp-content/uploads/bhc-default-image-e1738963186821.jpg","caption":"Black Hawk College","inLanguage":"en-US","width":"1317","height":"877"},"contactPoint":[{"@type":"ContactPoint","telephone":"309-796-5000","contactType":"customer support"},{"@type":"ContactPoint","telephone":"309-854-1700","contactType":"customer support"},{"@type":"ContactPoint","telephone":"309-796-5200","contactType":"billing support"},{"@type":"ContactPoint","telephone":"309-854-1706","contactType":"billing support"},{"@type":"ContactPoint","telephone":"309-796-5555","contactType":"technical support"}],"description":"Black Hawk\u00a0College\u2019s district office is located at the Quad-Cities\u00a0Campus in Moline, while the East Campus is located five\u00a0miles south of Kewanee. Black Hawk College serves all or part of nine counties in\u00a0northwestern Illinois with a population of more than\u00a0225,000 residents.\r\n\r\nOperated as one college with two campuses and several outreach sites, Black Hawk College offers both career and transfer programs. The college also offers a wide range of special\u00a0purpose and community outreach programs.\r\n\r\nBlack Hawk College offers\u00a0a full array of student clubs, honor societies, athletic programs and judging teams. Athletic teams compete in the NJCAA Arrowhead Conference.\r\n\r\nBlack Hawk College operates within Illinois Community College District #503, an area encompassing 2,200 square miles in nine counties of northwestern Illinois (Bureau, Henderson, Henry, Knox, Marshall, Mercer, Rock Island, Stark and Whiteside). In addition to full-service campuses in Moline and near Kewanee, the college operates the Adult Learning Center in Rock Island, the Community Education Center in Kewanee, the Industrial Training Lab Extension Center in Moline, the Outreach Center in East Moline, and the Welding and Skilled Trades Center in Kewanee. The college offers a variety of career and transfer programs and serves more people than any other institution of higher education in the Quad-Cities area.","foundingDate":"Sept. 18, 1946","numberOfEmployees":{"@type":"QuantitativeValue","value":"800"}},{"@type":"WebSite","@id":"https://www.bhc.edu/#website","url":"https://www.bhc.edu","name":"Black Hawk College","alternateName":"BHC","publisher":{"@id":"https://www.bhc.edu/#organization"},"inLanguage":"en-US"},{"@type":"BreadcrumbList","@id":"https://www.bhc.edu/events/category/quad-cities/athletics/#breadcrumb","itemListElement":[{"@type":"ListItem","position":"1","item":{"@id":"https://www.bhc.edu","name":"Home"}},{"@type":"ListItem","position":"2","item":{"@id":"https://www.bhc.edu/events/","name":"Events"}}]},{"@type":"CollectionPage","@id":"https://www.bhc.edu/events/category/quad-cities/athletics/#webpage","url":"https://www.bhc.edu/events/category/quad-cities/athletics/","name":"Athletics Events - Black Hawk College","isPartOf":{"@id":"https://www.bhc.edu/#website"},"inLanguage":"en-US","breadcrumb":{"@id":"https://www.bhc.edu/events/category/quad-cities/athletics/#breadcrumb"}}]}</script>
