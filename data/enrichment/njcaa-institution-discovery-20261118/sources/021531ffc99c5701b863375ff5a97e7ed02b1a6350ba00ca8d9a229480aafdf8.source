      		<script>document.querySelectorAll(".story-carousel").forEach((section, idx) => {
		const heading = section.querySelector(".story-carousel__header h2");
		const main = section.querySelector(".story-carousel__main");

		if (!heading || !main) return;

		// Ensure unique heading id
		if (!heading.id) heading.id = `story-carousel-heading-${idx + 1}`;

		// Make the landmark uniquely named
		main.setAttribute("role", "region");
		main.removeAttribute("aria-label");           // remove generic duplicate label
		main.setAttribute("aria-labelledby", heading.id);
		});
		</script>
