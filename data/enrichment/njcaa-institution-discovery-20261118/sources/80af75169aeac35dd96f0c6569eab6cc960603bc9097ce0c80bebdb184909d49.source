                    <article class="single-article-list-item">
                        <header>
                            <h4>Ethics Awareness Week Highlights USG's Commitment to Integrity</h4>
                            <time class="pubdate red" datetime="">October 30, 2026</time>
                        </header>
                                                <figure><img alt="${_EscapeTool.xml($caption)}" src="https://www.gordonstate.edu/newsroom/2025/october/usg-strengthens-commitment-to-ethical-culture-through-ethics-awareness-week/usg-ethics-week-spirit.png"/></figure>
                                                <a class="cover" href="https://www.gordonstate.edu/newsroom/2026/october/ethics-awareness-week-highlights-usgs-commitment-to-integrity/index.html"></a>
                    </article>
                                                                           
                    <article class="single-article-list-item">
                        <header>
                            <h4>Gordon State College Awarded More Than $568,000 to Advance Nursing, STEM, Teacher Education</h4>
