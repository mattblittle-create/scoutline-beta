<meta content="Home" property="og:title"/>
<meta content="Welcome to Northeast Mississippi Community College! At Northeast, we are dedicated to providing an affordable, high-quality education that paves the way for a bright future. Our campus is home to a vibrant community of students, faculty, and staff who are committed to academic excellence and personal growth. Whether you’re looking to start your college journey, transfer to a university, or gain new skills for the workforce, we offer a wide range of programs and resources to help you succeed. Explore our website to learn more about our academic offerings, student life, and the many opportunities that await you at Northeast. Join us and become part of a community where your potential is our priority." property="og:description"/>
<meta content="https://www.nemcc.edu/index.html" property="og:url"/>
<meta content="website" property="og:type"/>
<meta content="nemcc.edu" property="og:site_name"/>
<meta content="summary_large_image" name="twitter:card"/>


