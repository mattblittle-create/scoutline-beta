 2Z" class="gcsc-arrow-fill-circle"></path>	<path fill-rule="evenodd" clip-rule="evenodd" d="M12 3C7.03828 3 3 7.03828 3 12C3 16.9617 7.03828 21 12 21C16.9617 21 21 16.9617 21 12C21 7.03828 16.9617 3 12 3ZM12 2C6.486 2 2 6.486 2 12C2 17.514 6.486 22 12 22C17.514 22 22 17.514 22 12C22 6.486 17.514 2 12 2Z" class="gcsc-arrow-border-circle"></path>	<path d="M13 13V16L17 12L13 8V11H7V13H13Z" class="gcsc-arrow"></path>	</svg></button><button class="gcsc-pill-pathway  gcsc-drawer-open" data-drawer="gcsc-pathway-sciencetechnologyengineeringmath" style="background-image:url(/images/homepage/pathway-pills/stem.jpg);" aria-haspopup="true" aria-expanded="false">Science, Technology, Engineering & Math	<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="fill-current gcsc-transition gcsc-cta-arrow flex-none">	<path clip-rule="evenodd" d="M12 3C7.03828 3 3 7.03828 3 12C3 16.9617 7.03828 21 12 21C16.9617 21 21 16.9617 21 12C21 7.03828 16.9617 3 12 3ZM12 2C6.486 2 2 6.486 2 12C2 17.514 6.486 22 12 22C17.514 22 22 17.514 22 12C22 6.486 17.514 2 12 2Z" class="gcsc-arrow-fill-circle"></path>	<path fill-rule="evenodd" clip-rule="evenodd" d="M12 3C7.03828 3 3 7.03828 3 12C3 16.9617 7.03828 21 12 21C16.9617 21 21 16.9617 21 12C21 7.03828 16.9617 3 12 3ZM12 2C6.486 2 2 6.486 2 12C2 17.514 6.486 22 12 22C17.514 22 22 17.514 22 12C22 6.486 17.514 2 12 2Z" class="gcsc-arrow-border-circle"></path>	<path d="M13 13V16L17 12L13 8V11H7V13H13Z" class="gcsc-arrow"></path>	</svg></button><button class="gcsc-pill-pathway blue-bright gcsc-drawer-open" data-drawer="gcsc-pathway-socialbehavioraleducation" style="background-image:url(/images/homepage/pathway-pills/sbse.jpg);" aria-haspopup="true" aria-expanded="false">Social, Behavioral, Education	<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="fill-current gcsc-transition gcsc-cta-arrow flex-none">	<path clip-rule="evenodd" d="M12 3C7.03828 3 3 7.03828 3 12C3 16.9617 7.03828 21 12 21C16.9617 21 21 16.9617 21 12C21 7.03828 16.9617 3 12 3ZM12 2C6.486 2 2 6.486 2 12C2 17.514 6.486 22 12 22C17.514 22 22 17.514 22 12C22 6.486 17.514 2 12 2Z" class="gcsc-arrow-fill-circle"></path>	<path fill-rule="evenodd" clip-rule="evenodd" d="M12 3C7.03828 3 3 7.03828 3 12C3 16.9617 7.03828 21 12 21C16.9617 21 21 16.9617 21 12C21 7.03828 16.9617 3 12 3ZM12 2C6.486 2 2 6.486 2 12C2 17.514 6.486 22 12 22C17.514 22 22 17.514 22 12C22 6.486 17.514 2 12 2Z" class="gcsc-arrow-border-circle"></path>	<path d="M13 13V16L17 12L13 8V11H7V13H13Z" class="gcsc-arrow"></path>	</svg></button></div>
            </div>
         </section>
         <div class="extra-extra-skinny-container mb-16">
            
            <h2 class="font-display text-4xl text-teal-dark uppercase" style="text-align: center;">EXPLORE GCSC BY LOCATION</h2>
            
            <p>Take courses or earn your Gulf Coast State College degree where it works best for
               you. As one of the most affordable state colleges in Florida and offering four locations
               and online options, GCSC is ready to meet you, wherever you are on your path.</p>
            </div>
         
         <div class="overflow-hidden relative">
