                    <picture>
                        <img class="cmp-breakout-image__image" src="/media/vgpdznaos1famacjlg2meivroq/graduation-selfie.png?format=webp&amp;quality=80" alt="3 Female Graduates in caps and gowns taking selfie" />
                    </picture>
