    $('.accordion .collapse').on('shown.bs.collapse', function () {
      var $openedItem = $(this).closest('.accordion-item');
      if ($openedItem.length) {
        var yOffset = -100; // Adjust for sticky header height
        var y = $openedItem.offset().top + yOffset;

        console.log("Scrolling to:", y); // Debug log

        $('html, body').animate({
          scrollTop: y
        }, 400);
      }
    });
  });
</script>










