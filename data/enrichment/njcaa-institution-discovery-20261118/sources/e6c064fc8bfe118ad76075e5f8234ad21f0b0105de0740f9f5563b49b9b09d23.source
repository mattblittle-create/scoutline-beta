			.snackbar {
			  display:block;
			  background:#bb5421;
			  border:#f2f2f2;
			  padding:10px 40px 10px 20px;
			  color:#fff;
			  font-family:Arial;
			  position:relative;
			  left:0px;
			  bottom:-70px;
			  transition: bottom 0.5s ease-in-out;
			  z-index:1;
			} 
			.snackclose, label {
			  bottom:-70px;
			  position:absolute;
			  border:0;
			}
			.snackclose {
			  display:none;
			  z-index:10;
			}
			label {
			  z-index:11;
			  display:block;
			  width:100%;
			  height:100%;
			  color:rgba(255,255,255,1);
			  cursor:pointer;
			}
			.animated {
			  animation-name: snackbar-show;
			  animation-duration: 5s;
			  animation-direction: forwards;
			  animation-timing-function: ease-in-out;
			  animation-delay:1s;
			  animation-fill-mode: forwards;
			}
