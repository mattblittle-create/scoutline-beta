                                        <div class="testimonials-name">
                                            <strong>Brianna Redding '15</strong>
                                            <br>
                                        </div>
                                    </div>
                                    <div class="testimonials-bg">
                                        <div class="testimonials-img">
                                            <img alt="Testimonial from Belinda Coulibaly" src="assets/images/testimonials/4.jpg">
