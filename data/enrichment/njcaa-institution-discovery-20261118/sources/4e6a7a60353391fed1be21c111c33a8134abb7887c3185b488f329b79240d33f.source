    <main class="body-container" id="skip-link-destination">
    
  
    <div class="container-fluid">
<div class="row-fluid-wrapper">
<div class="row-fluid">
<div class="span12 widget-span widget-type-cell " style="" data-widget-type="cell" data-x="0" data-w="12">

<div class="row-fluid-wrapper row-depth-1 row-number-1 dnd-section">
<div class="row-fluid ">
<div class="span12 widget-span widget-type-custom_widget dnd-module" style="" data-widget-type="custom_widget" data-x="0" data-w="12">
<div id="hs_cos_wrapper_Main_DND_Area-dnd_partial-1-module-1" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module" style="" data-hs-cos-general-type="widget" data-hs-cos-type="module">

<section class="hero-homepage hero__overlay" style="background-image: url(https://rlc.edu/hubfs/website-2024-assets/home-page-hero-1518x794.png);">
    
    <div class="hero-homepage__inner">
        <div class="hero-homepage__text">
            <h5>Welcome To</h5>
            <h1>Rend Lake College</h1>
            <p>Providing general, transfer and career-technical education to both traditional and non-traditional students since 1967. Choose from over 100 degree &amp; certificate options that are affordable and close-to-home.</p>
            
