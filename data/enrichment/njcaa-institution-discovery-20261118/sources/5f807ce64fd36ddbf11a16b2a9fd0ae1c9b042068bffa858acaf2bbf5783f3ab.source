      <div class="quiz"><img src="/_resources/_images/bg2.jpg" class="img_bg z-0" alt="Path Finder Quiz"><div class="bg_overlay z-1 overlay_strong_blue" style="opacity: 0.80;"></div>
         <div class="container relative_z questions_w">
            <form class="quiz__form" action="/learn/find-your-program/index.html" data-result="You’ve got a bright future ahead of you! Based on your answers, here are some programs and degrees we’d recommend. Click on each path to see more details.">
               <fieldset>
                  <legend class="top-title color_white">
                     							TAKE OUR PATH FINDER QUIZ!
                     						</legend>
                  <div class="questions">
                     <div class="question_i &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;active_q&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;">
                        <div class="quiz__title color_white">
                           										Which best describes your current situation?
                           									</div>
