<script>
	$(function() {
		// Get the current URL's search parameters
		var query = new URLSearchParams(window.location.search);
		if(query.size > 0){
			// Store UTM parameters in localStorage
			localStorage.setItem("utm_source", query.get('utm_source'));
			localStorage.setItem("utm_medium", query.get('utm_medium'));
			localStorage.setItem("utm_campaign", query.get('utm_campaign'));
		}

		// Retrieve the UTM parameters from localStorage
		var utmSource = localStorage.getItem("utm_source");
		var utmMedium = localStorage.getItem("utm_medium");
		var utmCampaign = localStorage.getItem("utm_campaign");

		// Set the data-redirect attribute if needed
		var redirURL = $('.ou-form form').attr('data-redirect');
		if (redirURL) {
			$('.ou-form form').attr('data-redirect', redirURL + window.location.search);
		}

		// Pre-fill the form fields with the retrieved UTM parameters
		$('#id_utmsource').val(utmSource);
		$('#id_utmmedium').val(utmMedium);
		$('#id_utmcampaign').val(utmCampaign);
	});
