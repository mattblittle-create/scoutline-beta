    		    <script>var debugMode = false; var defaultView = "upcoming events.replace(/[^A-Za-z0-9]/g, "-")"; function getBlockEvents(data) { return new Promise(function (resolve) { $.each(data, function (i, v) { eventList += v2025WebsiteSection(v); }); resolve({ data: data, events: eventList }); }) } function v2025WebsiteSection(v) { var filter1 = v.filter1; var filter10 = v.filter10; filter1 = filter1.join(", "); eventItem = ''; eventItem += '<a class="group card flex-col card-link h-96" href="' + v.url + '" target="_parent" title="' + v.url + '">'; eventItem += '<div class="flex flex-row h-full gap-x-5">'; eventItem += '<div class="w-1/4 h-full bg-primary p-4 flex flex-col items-center justify-center text-center rounded-l-lg">'; eventItem += '<div class="display-6 font-bold text-white">'; eventItem += '<span>' + kckccOutputCustom(v.startDate, v.endDate, 'kckccDate') + '</span>'; eventItem += '</div>'; eventItem += '</div>'; eventItem += '<div class="w-3/4 flex flex-col justify-center">'; eventItem += '<h3 class="h4 card-title">'; eventItem += v.title; eventItem += '</h3>'; eventItem += '<div class="text-lg text-secondary">'; eventItem += '<span>' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd) + '</span>'; eventItem += '</div>'; eventItem += '<div class="text-lg text-secondary">'; if (filter10) { filter10 = filter10.join(", "); eventItem += '<span>' + filter10 + '</span>'; } eventItem += '</div>'; eventItem += '</div>'; eventItem += '</div>'; eventItem += '</a>'; eventItem += ''; return eventItem; } function eventColumnHTML(v) { eventItem = ''; eventItem += '<div class="py-2 newsEventBorder">'; eventItem += '<a class="bg-transparent font-weight-bold fs-base text-kckcc-blue-500" href="' + v.url + '" target="_parent">'; eventItem += v.title; eventItem += '</a>'; eventItem += '<div>'; eventItem += '<div><span>' + dateOutputCustom(v.startDate, v.endDate,) + '</span>'; eventItem += ' | '; eventItem += '<span>' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd) + '</span></div>'; eventItem += '</div>'; eventItem += '</div>'; eventItem += ''; return eventItem; } function noImgCardHTML(v, image) { var filter1 = v.filter1; var filter10 = v.filter10; filter1 = filter1.join(", "); eventItem = ''; eventItem += '<div class="card max-w-75">'; eventItem += imageSource(v); eventItem += '<div class="card-body">'; eventItem += '<h3 class="card-title">' + v.title + '</h3>'; eventItem += '<div class="col px-2">'; eventItem += '<div><i class="fa-solid fa-calendar-star text-primary"></i><span>' + dateOutputCustom(v.startDate, v.endDate, 'full') + '</span></div>'; eventItem += '<div><i class="fa-solid fa-calendar-clock text-primary"></i><span>' + timeOutputCustom(v.startDate, v.endDate, v.allDay, v.originalStart, v.originalEnd) + '</span></div>'; if (filter10) { filter10 = filter10.join(", "); eventItem += '<div><i class="fa-solid fa-location-dot text-primary"></i><span>' + filter10 + '</span></div>'; } eventItem += '</div></div>'; eventItem += '<div class="card-footer text-muted">'; eventItem += '<a class="cta-link" href="' + v.url + '" target="_parent" title="' + v.title + '">More about this event<i class="bi bi-arrow-right-short text-primary px-2"></i></a>'; eventItem += '</div></div>'; return eventItem; } function monthOutputCustom(startDateIn, endDateIn, type) { if (type === "kckccMonth") { if (moment(startDateIn).isSame(endDateIn, 'day')) { var monthOutput = moment(startDateIn).format('MMM'); } else { var monthOutput = moment(startDateIn).format('MMM'); } } return monthOutput; } function kckccOutputCustom(startDateIn, endDateIn, type) { if (moment(startDateIn).isSame(endDateIn, 'day')) { var dateOutput = moment(startDateIn).format('MMM D'); } if (moment(endDateIn).isAfter(startDateIn, 'day')) { var dateOutput = moment(startDateIn).format('MMM D') + ' - ' + moment(endDateIn).format('MMM D'); } return dateOutput } function dateOutputCustom(startDateIn, endDateIn, type) { if (moment(startDateIn).isSame(endDateIn, 'day')) { if (type == "full") { var dateOutput = moment(startDateIn).format('MMMM D, YYYY'); } else { var dateOutput = moment(startDateIn).format('MMM D YYYY'); } } else { if (moment(startDateIn).isSame(endDateIn, 'year')) { if (moment(startDateIn).isSame(endDateIn, 'month')) { var dateOutput = moment(startDateIn).format('MMM D') + ' - ' + moment(endDateIn).format('D '); } else { var dateOutput = moment(startDateIn).format('MMM D') + ' - ' + moment(endDateIn).format('MMM D'); } } else { var dateOutput = moment(startDateIn).format('MMM D') + ' - ' + moment(endDateIn).format('MMM D'); } } return dateOutput; } function imageSource(v) { if (v.image) { var imgOut = '<img alt="' + v.title + '" src="' + v.image.url + '"/>'; } else var imgOut = ''; return imgOut; } function imageOutputCustom(image, startDateIn){ if (image) { var imageOuput = '<div class="event-image w-100" style="background-image:url(' + image.url + ');"></div>'; } else { var imageOuput = '<div class="event-image date-img"><div class="month">' + moment(startDateIn).format('MMM') + '</div><div class="day">' + moment(startDateIn).format('D') + '<div class="weekday">' + imgWeekDay(moment(startDateIn).isoWeekday()) + '</div></div></div>'; } return imageOuput; } function timeOutputCustom(startDateIn, endDateIn, allDayIn, originalStart, originalEnd) { if (allDayIn === "true") { var timeOutput = 'All Day'; } else { var timeOutput = ""; var startDateInM = moment(startDateIn); var originalStartM = moment(originalStart); var endDateInM = moment(endDateIn); var originalEndM = moment(originalEnd); var startDateStdOffset; /*Fix to remove daylight savings time*/ if (!moment().isDST()) { if (startDateInM.isSame(originalStartM)) { startDateStdOffset = originalStartM.utcOffset(); } else { startDateStdOffset = startDateInM.utcOffset(); } var endDateStdOffset; if (endDateInM.isSame(originalStartM)) { endDateStdOffset = originalEndM.utcOffset(); } else { endDateStdOffset = endDateInM.utcOffset(); } var startDateInOffsetM = startDateInM.utcOffset(startDateStdOffset); var endDateInOffsetM = endDateInM.utcOffset(endDateStdOffset); } else { var startDateInOffsetM = originalStartM; var endDateInOffsetM = originalEndM; } timeOutput += startDateInOffsetM.format('h'); if (startDateInOffsetM.format('mm') != "00") { timeOutput += startDateInOffsetM.format(':mm'); } if (startDateInOffsetM.format('a') != endDateInOffsetM.format('A')) { timeOutput += startDateInOffsetM.format(' a'); } timeOutput += ' - '; timeOutput += endDateInOffsetM.format('h'); if (endDateInOffsetM.format('mm') != "00") { timeOutput += endDateInOffsetM.format(':mm'); } timeOutput += endDateInOffsetM.format('a'); } return timeOutput; } var currentDataURL = "https://www.kckcc.edu/events/_data/current-live.json"; var hhEventsType = "current"; var locationRoom = "${hhlocationRoom}"; var hhEventsLimit = 6; var hhEventsWidth = "${hhEventsWidth}"; var hhEvents = []; var filter1Text = [ "categoryb"]; var filter2Text = [ ]; var filter3Text = [ ]; var filter5Text = [ ]; var filter6Text = [ ]; var filter7Text = [ ]; var filter8Text = [ ]; var filter9Text = [ ]; var filter10Text = [ ]; var filter1 = true; var filter2 = true; var filter3 = true; var filter4 = false; var filter5 = true; var filter6 = true; var filter7 = true; var filter8 = true; var filter9 = true; var filter10 = true; function afterHHEventsLoad(){ $('.hh-events.hh-events-block .event .title').matchHeight(); }</script>        	</section>
