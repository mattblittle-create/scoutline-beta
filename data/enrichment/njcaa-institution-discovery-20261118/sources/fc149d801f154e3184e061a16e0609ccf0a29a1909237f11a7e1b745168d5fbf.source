}	
		
	.stay-connectedcard .contentWrap {
    opacity: 1;
    background-color: #000000ba;    
}

.stay-connectedcard .contentWrap .title {
    opacity: 1;   
}

.stay-connectedcard .contentWrap .text {
    opacity: 1;    
}
		
		
		
		
		
	.info-modal-toggle {
    cursor: pointer;
    display: none;
}
		
		
		
	.hero-alt .inner .hero-alt-image {
    width: 100%;
    min-height: 509px;
    max-height: 509px;
    object-fit: contain;
	border-radius: 10px;
}
		
	.stay-connectedcards {
    display: flex;
    justify-content: space-between;
    gap: 20px; /* Space between the cards */
	flex-wrap: wrap;
}

.stay-connectedcard {
    flex: 1 1 calc(33.333% - 20px); /* Three cards in a row */
    max-width: calc(33.333% - 20px); /* Prevent stretching */
    display: flex;
	aspect-ratio: 3 / 2;
    flex-direction: column;
    overflow: hidden; /* Prevent overflow of images */
    border: 1px solid #ccc; /* Optional: Add a border for clarity */
    border-radius: 8px; /* Optional: Rounded corners */
    background: #fff; /* Ensure a consistent background */
}
		
/* Mobile Layout */
@media (max-width: 768px) {
    .stay-connectedcard {
        flex: 1 1 100%; /* Full width on mobile */
        max-width: 100%; /* Full width on mobile */
        margin-bottom: 20px; /* Add spacing between stacked cards */
    }
}

.stay-connectedcard .img-wrap {
    width: 100%;
    aspect-ratio: 3 / 2; /* Maintain the 1200x800 aspect ratio */
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
}

.stay-connectedcard .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensure the image fills the container */
}

.stay-connectedcard .contentWrap {
    padding: 15px; /* Space inside the text content */
    flex: 1; /* Allow content to expand and fit nicely */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}



		
	.featured-events-card .img-wrap>img {
    width: 100%;
    display: flex;
    object-fit: contain;
    height: 100%;
    transition: 0.3s;
    -webkit-transition: 0.3s;
    -moz-transition: 0.3s;
    -ms-transition: 0.3s;
    -o-transition: 0.3s;
    scale: 1.1;
}
		
