      <style>
	/* =========================================================
	   UAT HOMEPAGE HERO
	   This only applies to home-uat.xsl / homeTest.pcf
	   ========================================================= */

	.hero-uat {
		position: relative;
		min-height: 650px;
		width: 100%;
		display: flex;
		align-items: center;
		overflow: hidden;
		background-repeat: no-repeat;
		background-size: cover;
		background-position: center center;
		font-family: var(--font-neo);
		pointer-events: none;
	}

	/* Dark gradient guarantees readable white text
	   regardless of the photograph being used */
	.hero-uat::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			90deg,
			rgba(0, 0, 0, 0.82) 0%,
			rgba(0, 0, 0, 0.72) 38%,
			rgba(0, 0, 0, 0.40) 65%,
			rgba(0, 0, 0, 0.15) 100%
		);
		pointer-events: none;
	}

	.hero-uat .wrapper {
		position: relative;
		z-index: 2;
		width: 100%;
		pointer-events: none;
	}

	.hero-uat__content {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 680px;
		padding: 80px 30px;
		color: #fff;
		font-family: var(--font-neo);
		pointer-events: none;
	}

	.hero-uat__heading {
		margin: 0 0 22px;
		color: #fff;
		font-size: clamp(3rem, 5vw, 5.25rem);
		line-height: 1.02;
		font-weight: 600;
		letter-spacing: .01em;
		font-family: var(--font-neo);
		pointer-events: none;
	}

	/* Override existing banner-big treatment inside UAT */
	.hero-uat__heading .banner-big {
		color: #fff;
		font-size: inherit;
		line-height: inherit;
		font-family: var(--font-neo);
	}

	.hero-uat__text {
		max-width: 610px;
		margin: 0 0 32px;
		padding: 0;
		background: none;
		color: #fff;
		font-size: 1.25rem;
		line-height: 1.6;
		font-weight: 500;
		text-align: left;
		font-family: var(--font-neo);
		pointer-events: none;
	}

	.hero-uat__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: center;
		pointer-events: none;
	}

	.hero-uat__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width:300px;
		min-height: 52px;
		padding: 14px 26px;
		border: 2px solid #e60012;
		border-radius: 6px;
		background: #e60012;
		color: #fff !important;
		font-size: 1.4rem;
		font-weight: 700;
		line-height: 1.2;
		text-decoration: none !important;
		font-family: var(--font-neo);
		pointer-events: auto;

		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.hero-uat__cta:hover,
	.hero-uat__cta:focus-visible {
		background: #fff;
		border-color: #fff;
		color: #111 !important;
		transform: translateY(-2px);
	}

	.hero-uat__cta:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 4px;
	}

	/* Mobile image is hidden on desktop */
	.hero-uat__mobile-image {
		display: none;
		pointer-events: none;
	}


	/* =========================================================
	   SIDE STICKY BUTTONS
	   Above hero, below navigation / mega menu
	   ========================================================= */

	.side-sticky-sec {
		z-index: 20 !important;
		pointer-events: auto !important;
	}

	.side-sticky-sec a {
		position: relative;
		z-index: 21;
		pointer-events: auto !important;
		font-family: var(--font-neo);
	}


	/* =========================================================
	   TABLET / SMALL DESKTOP
	   ========================================================= */

	@media (max-width: 1024px) {

		.hero-uat {
			min-height: 590px;
			background-image: none !important;
		}

		.hero-uat__mobile-image {
			display: block;
			position: absolute;
			inset: 0;
			z-index: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
		}

		.hero-uat__mobile-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			pointer-events: none;
		}

		.hero-uat::before {
			background: linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.84) 0%,
				rgba(0, 0, 0, 0.70) 60%,
				rgba(0, 0, 0, 0.42) 100%
			);
		}

		.hero-uat__content {
			max-width: 620px;
			padding: 70px 30px;
		}
	}


	/* =========================================================
	   MOBILE
	   ========================================================= */

	@media (max-width: 600px) {

		.hero-uat {
			min-height: 540px;
			align-items: flex-end;
		}

		.hero-uat::before {
			background: linear-gradient(
				0deg,
				rgba(0, 0, 0, 0.88) 0%,
				rgba(0, 0, 0, 0.70) 65%,
				rgba(0, 0, 0, 0.38) 100%
			);
		}

		/* Reserve room on the right for sticky side buttons */
		.hero-uat__content {
			padding: 55px 120px 48px 22px;
		}

		.hero-uat__heading {
			font-size: clamp(2.25rem, 10vw, 3.2rem);
			margin-bottom: 18px;
		}

		.hero-uat__text {
			font-size: 1.05rem;
			line-height: 1.55;
			margin-bottom: 26px;
		}

		.hero-uat__cta {
			width: 350px;
		    font-size: 1.0rem;
			pointer-events: auto;
		}
	}
</style>
