<!-- Track Apply clicks -->
<script>
document.addEventListener('click', function(event) {
    const link = event.target.closest('a');

    if (link && link.href.includes('apply.cochise.edu')) {
        gtag('event', 'apply_click', {
            link_url: link.href,
            link_text: link.textContent.trim()
        });
    }
});
</script>
