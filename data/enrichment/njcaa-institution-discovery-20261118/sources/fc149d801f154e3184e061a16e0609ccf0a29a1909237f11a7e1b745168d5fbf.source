	.skip-link {
  position: absolute;
  left: -9999px;
  top: auto;
  width: 1px;
  height: 1px;
  overflow: hidden;
  z-index: 9999;
}

.skip-link:focus,
.skip-link:active {
  left: 20px;
  top: 20px;
  width: auto;
  height: auto;
  overflow: visible;
  padding: 12px 16px;
  background: #000;
  color: #fff;
  text-decoration: none;
  border: 2px solid #da0016;
  border-radius: 6px;
}

</style>


<style>
.skip-link {
  position: absolute;
  left: -9999px;
  top: 10px;
  z-index: 99999;
  background: #000;
  color: #fff;
  padding: 12px 18px;
  text-decoration: none;
  border: 2px solid #da0016;
  border-radius: 6px;
  font-weight: 700;
}

.skip-link:focus,
.skip-link:active {
  left: 20px;
  top: 20px;
}

#main-content:focus {
  outline: none;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var existingSkipLink = document.querySelector(".skip-link");
  if (existingSkipLink) return;

  var mainTarget =
    document.getElementById("main-content") ||
    document.querySelector("main") ||
    document.querySelector("#main") ||
    document.querySelector(".main-content") ||
    document.querySelector("#content");

  if (!mainTarget) return;

  if (!mainTarget.id) {
    mainTarget.id = "main-content";
  }

  mainTarget.setAttribute("tabindex", "-1");

  var skipLink = document.createElement("a");
  skipLink.className = "skip-link";
  skipLink.href = "#" + mainTarget.id;
  skipLink.textContent = "Skip to main content";

  document.body.insertBefore(skipLink, document.body.firstChild);

  skipLink.addEventListener("click", function () {
    setTimeout(function () {
      mainTarget.focus();
    }, 0);
  });
});
</script>
