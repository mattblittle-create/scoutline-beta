      	<script>
	document.addEventListener("DOMContentLoaded", function () {
    // Select all news cards
    const newsCards = document.querySelectorAll(".stay-connectedcard");

    // Check if there are at least 4 cards
    if (newsCards.length >= 4) {
        // Hide the 4th card (index 3 because it's zero-based)
        newsCards[3].style.display = "none";
    }
});
		
		document.addEventListener("DOMContentLoaded", function () {
    var imgElement = document.querySelector(".hero-alt-image");
    var playButton = document.querySelector(".black-playiconwrap"); // The play button
    var videoPopup = document.querySelector(".video-popup"); // The video popup

    // Completely remove the play button on page load
    if (playButton) {
        playButton.remove();
    }

    // Remove any video popup overlay
    if (videoPopup) {
        videoPopup.style.display = "none";
        videoPopup.remove();
    }

    if (imgElement) {
        // Make the entire image wrapper clickable
        var imgWrapper = imgElement.parentElement;
        imgWrapper.style.cursor = "pointer"; // Makes it clear it's clickable

        imgWrapper.addEventListener("click", function () {
            var videoId = "Ii7C9bquqp4"; // Your YouTube video ID
            var iframe = document.createElement("iframe");
            iframe.width = imgElement.width;
            iframe.height = imgElement.height;
            iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&showinfo=0`;
            iframe.frameBorder = "0";
            iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
            iframe.allowFullscreen = true;

            // Replace image with video
            imgWrapper.replaceChild(iframe, imgElement);

            // Ensure scrolling remains enabled
            document.body.style.overflow = "auto";
            document.documentElement.style.overflow = "auto";
        });
    }
});

	
	</script>
      	
