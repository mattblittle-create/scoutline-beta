   <body>
      <main class="main">
<section class="search-bar-popup">
  <div class="inner">
    <div class="search-bar-form">
      <form action="/search/index.html" method="get">
        <!-- Visible label explicitly associated with the input -->
        <label id="ousearchq-label" for="ousearchq" class="visually-hidden">Search for a location</label>
        <input 
          type="text" 
          name="ousearchq" 
          id="ousearchq" 
          placeholder="Search..." 
          class="input searchInput" 
          oninput="toggleClearButton()" 
          aria-labelledby="ousearchq-label"
		  
        />

        <!-- Submit button -->
        <button 
          type="submit" 
          class="search" 
          aria-label="submit search">
          <img src="/_resources/images/_dev_images/Search-icon.png" alt="Search Icon">
        </button>				  

        <!-- Clear button -->
        <button 
          class="clearButton" 
          onclick="clearSearch()" 
          aria-label="clear search"> 
        </button>
      </form>
    </div>
  </div>
  <div class="close">&#9587;</div>
</section>

