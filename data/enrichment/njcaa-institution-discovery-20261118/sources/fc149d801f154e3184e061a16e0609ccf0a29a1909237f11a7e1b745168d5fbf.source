      	<script>
	document.addEventListener("DOMContentLoaded", function() {
  const selectWraps = document.querySelectorAll(".select-wrap");
  if (selectWraps[2]) { // Index 2 targets the third instance
    selectWraps[2].style.display = "none"; // Hides only the third dropdown
