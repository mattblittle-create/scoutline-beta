                     <style>
.cd-featured-events {
  width: 100%;
  padding: 20px 0 10px;
}

.cd-featured-events__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.cd-featured-events__heading {
  margin: 0;
  font-size: 2rem;
  line-height: 1.2;
  color: #000;
}

.cd-featured-events__more {
  text-decoration: underline;
    color: var(--brand-red);
    font-family: var(--font-neo);
    font-size: 20px;
    font-weight: 700;
    line-height: 17px;
    position: relative;
}

.cd-featured-events__more:hover,
.cd-featured-events__more:focus {
  text-decoration: underline;
}

.cd-featured-events__slider-wrap {
  position: relative;
  padding: 0 58px;
}

.cd-featured-events__viewport {
  overflow: hidden;
  width: 100%;
}

.cd-featured-events__track {
  display: flex;
  gap: 20px;
  transition: transform 0.35s ease;
  will-change: transform;
}

.cd-featured-events__card {
  flex: 0 0 calc((100% - 40px) / 3);
  background: #e3e4e5;
  border-radius: 10px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

.cd-featured-events__image-link {
  display: block;
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #cfcfcf;
}

.cd-featured-events__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.cd-featured-events__body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cd-featured-events__date-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 8px;
  background: #fff;
  color: #000;
  border-radius: 8px;
  padding: 10px 14px;
  font-weight: 600;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}

.cd-featured-events__date-badge-icon {
  color: #da0016;
  font-style: normal;
  line-height: 1;
}

.cd-featured-events__title {
  margin: 0;
  font-size: 1.05rem;
  line-height: 1.35;
}

.cd-featured-events__title a {
  color: #000;
  text-decoration: underline;
}

.cd-featured-events__title a:hover,
.cd-featured-events__title a:focus {
  color: #da0016;
}

.cd-featured-events__meta {
  color: #222;
  font-size: 0.98rem;
  line-height: 1.5;
}

.cd-featured-events__location,
.cd-featured-events__time {
  margin: 0;
}

.cd-featured-events__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 2px solid #da0016;
  background: #fff;
  color: #da0016;
  font-size: 1.3rem;
  font-weight: 700;
  cursor: pointer;
  z-index: 2;
  transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
}

.cd-featured-events__nav:hover,
.cd-featured-events__nav:focus {
  background: #da0016;
  color: #fff;
}

.cd-featured-events__nav[disabled] {
  opacity: 0.35;
  cursor: default;
}

.cd-featured-events__nav--prev {
  left: 0;
}

.cd-featured-events__nav--next {
  right: 0;
}

.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

@media (max-width: 1024px) {
  .cd-featured-events__card {
    flex: 0 0 calc((100% - 20px) / 2);
  }
}

@media (max-width: 767px) {
  .cd-featured-events__slider-wrap {
    padding: 0 46px;
  }

  .cd-featured-events__card {
    flex: 0 0 100%;
  }

  .cd-featured-events__heading {
    font-size: 1.7rem;
  }
}
</style>
                     
                     <script>
document.addEventListener("DOMContentLoaded", function () {
  var FEED_URL = "/_resources/php/coursedog-featured-events-proxy.php";
  var FALLBACK_IMAGE = "/_resources/images/c-logo-stacked.png";
  var MAX_ITEMS = 6;

  var track = document.getElementById("cd-featured-events-track");
  var status = document.getElementById("cd-featured-events-status");
  var prevBtn = document.querySelector(".cd-featured-events__nav--prev");
  var nextBtn = document.querySelector(".cd-featured-events__nav--next");

  var currentIndex = 0;
  var visibleCards = getVisibleCards();
  var totalCards = 0;

  function getVisibleCards() {
    if (window.innerWidth <= 767) return 1;
    if (window.innerWidth <= 1024) return 2;
    return 3;
  }

  function decodeHtml(html) {
    var txt = document.createElement("textarea");
    txt.innerHTML = html;
    return txt.value;
  }

  function escapeHtml(str) {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "'");
  }

  function parseDescription(descriptionHtml) {
    var temp = document.createElement("div");
    temp.innerHTML = descriptionHtml || "";

    var data = {
      rawDate: "",
      location: "",
      organizer: "",
      type: "",
      summary: ""
    };

    var divs = temp.querySelectorAll("div");
    for (var i = 0; i < divs.length; i++) {
      var text = (divs[i].textContent || "").trim();

      if (text.indexOf("Date:") === 0) {
        data.rawDate = text.replace(/^Date:\s*/, "").trim();
      } else if (text.indexOf("Location:") === 0) {
        data.location = text.replace(/^Location:\s*/, "").trim();
      } else if (text.indexOf("Organizer:") === 0) {
        data.organizer = text.replace(/^Organizer:\s*/, "").trim();
      } else if (text.indexOf("Type:") === 0) {
        data.type = text.replace(/^Type:\s*/, "").trim();
      }
    }

    var p = temp.querySelector("p");
    if (p) {
      data.summary = (p.textContent || "").trim();
    }

    return data;
  }

  function formatBadgeDate(rawDate, pubDate) {
  var dateText = rawDate || "";

  var match = dateText.match(/^[A-Za-z]{3}\s([A-Za-z]{3})\s(\d{1,2})\s(\d{4})/);

  if (match) {
    var monthMap = {
      Jan: "January",
      Feb: "February",
      Mar: "March",
      Apr: "April",
      May: "May",
      Jun: "June",
      Jul: "July",
      Aug: "August",
      Sep: "September",
      Oct: "October",
      Nov: "November",
      Dec: "December"
    };

    var month = monthMap[match[1]] || match[1];
    var day = match[2];
    var year = match[3];

    return month + " " + day + ", " + year;
  }

  var pubParsed = new Date(pubDate);
  if (!isNaN(pubParsed.getTime())) {
    return pubParsed.toLocaleDateString("en-US", {
      timeZone: "UTC",
      month: "long",
      day: "numeric",
      year: "numeric"
    });
  }

  return "Date TBA";
}

  function formatTime(rawDate) {
    if (!rawDate) return "";

    if (rawDate.indexOf("–") !== -1 || rawDate.indexOf("-") !== -1) {
      return rawDate
        .replace(/^[A-Za-z]{3}\s[A-Za-z]{3}\s\d{1,2}\s\d{4}\s*/, "")
        .trim()
        .replace(/\s*–\s*/g, " - ");
    }

    if (/\d{1,2}:\d{2}(AM|PM)/i.test(rawDate)) {
      return rawDate.replace(/^[A-Za-z]{3}\s[A-Za-z]{3}\s\d{1,2}\s\d{4}\s*/, "").trim();
    }

    return "";
  }

  function extractImageUrl(itemNode) {
    var enclosure = itemNode.querySelector("enclosure");
    if (enclosure && enclosure.getAttribute("url")) {
      return enclosure.getAttribute("url");
    }
    return FALLBACK_IMAGE;
  }

  function buildCard(eventObj) {
    var locationText = eventObj.location && eventObj.location !== "Location not provided"
      ? eventObj.location
      : "Location TBA";

    var timeText = eventObj.timeText || "All Day";

    return ""
      + '<article class="cd-featured-events__card">'
      +   '<a class="cd-featured-events__image-link" href="' + escapeHtml(eventObj.link) + '" target="_blank" rel="noopener">'
      +     '<img class="cd-featured-events__image" src="' + escapeHtml(eventObj.image) + '" alt="' + escapeHtml(eventObj.title) + '" />'
      +   '</a>'
      +   '<div class="cd-featured-events__body">'
      +     '<div class="cd-featured-events__date-badge">'
      +       '<span class="cd-featured-events__date-badge-icon" aria-hidden="true">📅</span>'
      +       '<span>' + escapeHtml(eventObj.badgeDate) + '</span>'
      +     '</div>'
      +     '<h3 class="cd-featured-events__title">'
      +       '<a href="' + escapeHtml(eventObj.link) + '" target="_blank" rel="noopener">' + escapeHtml(eventObj.title) + '</a>'
      +     '</h3>'
      +     '<div class="cd-featured-events__meta">'
      +       '<p class="cd-featured-events__location">' + escapeHtml(locationText) + '</p>'
      +       '<p class="cd-featured-events__time">' + escapeHtml(timeText) + '</p>'
      +     '</div>'
      +   '</div>'
      + '</article>';
  }

  function updateSlider() {
    var cards = track.querySelectorAll(".cd-featured-events__card");
    if (!cards.length) return;

    visibleCards = getVisibleCards();

    var cardWidth = cards[0].offsetWidth;
    var gap = 20;
    var offset = currentIndex * (cardWidth + gap);

    track.style.transform = "translateX(-" + offset + "px)";

    var maxIndex = Math.max(0, totalCards - visibleCards);
    prevBtn.disabled = currentIndex <= 0;
    nextBtn.disabled = currentIndex >= maxIndex;

    status.textContent = "Showing events " + (currentIndex + 1) + " through " + Math.min(currentIndex + visibleCards, totalCards) + " of " + totalCards + ".";
  }

  function attachNav() {
    prevBtn.addEventListener("click", function () {
      currentIndex = Math.max(0, currentIndex - 1);
      updateSlider();
    });

    nextBtn.addEventListener("click", function () {
      var maxIndex = Math.max(0, totalCards - visibleCards);
      currentIndex = Math.min(maxIndex, currentIndex + 1);
      updateSlider();
    });

    window.addEventListener("resize", function () {
      var newVisible = getVisibleCards();
      if (newVisible !== visibleCards) {
        visibleCards = newVisible;
        var maxIndex = Math.max(0, totalCards - visibleCards);
        if (currentIndex > maxIndex) {
          currentIndex = maxIndex;
        }
      }
      updateSlider();
    });
  }

  function parseFeed(xmlText) {
    var parser = new DOMParser();
    var xml = parser.parseFromString(xmlText, "text/xml");
    var items = xml.querySelectorAll("item");
    var events = [];

    for (var i = 0; i < items.length && events.length < MAX_ITEMS; i++) {
      var item = items[i];

      var titleNode = item.querySelector("title");
      var linkNode = item.querySelector("link");
      var pubDateNode = item.querySelector("pubDate");
      var descNode = item.querySelector("description");

      var title = titleNode ? decodeHtml(titleNode.textContent.trim()) : "Untitled Event";
      var link = linkNode ? linkNode.textContent.trim() : "#";
      var pubDate = pubDateNode ? pubDateNode.textContent.trim() : "";
      var descriptionHtml = descNode ? descNode.textContent : "";

      var parsedDesc = parseDescription(descriptionHtml);
      var badgeDate = formatBadgeDate(parsedDesc.rawDate, pubDate);
      var timeText = formatTime(parsedDesc.rawDate);
      var image = extractImageUrl(item);

      events.push({
        title: title,
        link: link,
        pubDate: pubDate,
        badgeDate: badgeDate,
        timeText: timeText,
        location: parsedDesc.location,
        organizer: parsedDesc.organizer,
        type: parsedDesc.type,
        summary: parsedDesc.summary,
        image: image
      });
    }

    return events;
  }

  function renderEvents(events) {
    if (!events.length) {
      track.innerHTML = '<div class="cd-featured-events__empty">No featured events are available right now.</div>';
      prevBtn.disabled = true;
      nextBtn.disabled = true;
      return;
    }

    var html = "";
    for (var i = 0; i < events.length; i++) {
      html += buildCard(events[i]);
    }

    track.innerHTML = html;
    totalCards = events.length;
    currentIndex = 0;

    updateSlider();
  }

  function showError() {
    track.innerHTML = '<div class="cd-featured-events__empty">Unable to load featured events at this time.</div>';
    prevBtn.disabled = true;
    nextBtn.disabled = true;
  }

  fetch(FEED_URL)
    .then(function (response) {
      if (!response.ok) {
        throw new Error("Feed request failed");
      }
      return response.text();
    })
    .then(function (xmlText) {
      var events = parseFeed(xmlText);
      renderEvents(events);
      attachNav();
    })
    .catch(function (error) {
      console.error("Featured events feed error:", error);
      showError();
    });
});
</script></div>
               </div>
            </div>
