document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('programSearch');
  if (!searchInput) return;
  const programCards = document.querySelectorAll('#programList .program-card');
  searchInput.addEventListener('input', function() {
    const term = this.value.toLowerCase();
    programCards.forEach(card => {
      const text = card.textContent.toLowerCase();
      card.style.display = text.includes(term) ? '' : 'none';
    });
  });
});
(function () {
  function cleanLink(link) {
    try {
      var url = new URL(link.href);

      // Strip GA/marketing junk on the OUTER ezproxy URL
      ['_gl', '_ga', 'gclid', 'fbclid'].forEach(function (p) { url.searchParams.delete(p); });
      Array.from(url.searchParams.keys()).forEach(function (k) {
        if (k.startsWith('utm_') || k.startsWith('_ga')) url.searchParams.delete(k);
      });

      // Keep ?url= target clean and encoded
      if (url.searchParams.has('url')) {
        var inner = url.searchParams.get('url');
        try { inner = decodeURIComponent(inner); } catch (e) {}
        var encoded = encodeURI(inner);
        url.searchParams.set('url', encoded);
      }

      link.href = url.toString();
    } catch (e) {}
  }

  function cleanAll(root) {
    root.querySelectorAll('table.tablepress a[href*="ezproxy.angelina.edu/login?url="]')
        .forEach(cleanLink);
  }

  // Run after the page content exists
  document.addEventListener('DOMContentLoaded', function () { cleanAll(document); });

  // Catch TablePress redraws (search/sort/paginate) and any lazy content
  var obs = new MutationObserver(function (muts) {
    muts.forEach(function (m) {
      m.addedNodes && m.addedNodes.forEach(function (node) {
        if (node.nodeType === 1) cleanAll(node);
      });
    });
  });
  obs.observe(document.documentElem


