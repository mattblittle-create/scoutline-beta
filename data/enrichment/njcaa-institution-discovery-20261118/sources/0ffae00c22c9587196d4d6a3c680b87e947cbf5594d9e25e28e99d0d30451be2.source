<script type="text/plain" data-service="youtube" data-category="marketing">
document.addEventListener("DOMContentLoaded", function () {

  /* Mobile menu button */
  document.querySelectorAll(".kingster-mobile-menu-button").forEach(function(el) {
    el.setAttribute("aria-label", "Open navigation menu");
    el.setAttribute("role", "button");
  });

  /* Overlay / hamburger menu icons */
  document.querySelectorAll(".kingster-overlay-menu-icon, .kingster-menu-search-button, .kingster-top-search, .kingster-side-menu-icon").forEach(function(el) {
    if (!el.getAttribute("aria-label")) {
      el.setAttribute("aria-label", "Open menu");
    }
    el.setAttribute("role", "button");
  });

  /* Search icons */
  document.querySelectorAll("a[href='#kingster-search'], .kingster-main-menu-search, .kingster-search-button").forEach(function(el) {
    el.setAttribute("aria-label", "Open search");
    el.setAttribute("role", "button");
  });

/* Add label to search inputs */
document.querySelectorAll('form[role="search"] input[name="s"]').forEach(function(input) {
  if (!input.getAttribute("aria-label")) {
    input.setAttribute("aria-label", "Search the website");
  }
});

  /* Social media icon links */
  document.querySelectorAll("a[href*='facebook.com']").forEach(function(el) {
    el.setAttribute("aria-label", "Visit us on Facebook");
  });

  document.querySelectorAll("a[href*='instagram.com']").forEach(function(el) {
    el.setAttribute("aria-label", "Visit us on Instagram");
  });

  document.querySelectorAll("a[href*='twitter.com'], a[href*='x.com']").forEach(function(el) {
    el.setAttribute("aria-label", "Visit us on X");
  });

  document.querySelectorAll("a[href*='youtube.com']").forEach(function(el) {
    el.setAttribute("aria-label", "Visit us on YouTube");
  });

  document.querySelectorAll("a[href*='linkedin.com']").forEach(function(el) {
    el.setAttribute("aria-label", "Visit us on LinkedIn");
  });

  /* Links opening new tabs */
  document.querySelectorAll("a[target='_blank']").forEach(function(el) {
    const currentLabel = el.getAttribute("aria-label") || el.textContent.trim();
    if (currentLabel) {
      el.setAttribute("aria-label", currentLabel + " (opens in a new tab)");
    }
    el.setAttribute("rel", "noopener");
  });

  /* Icon-only links */
  document.querySelectorAll("a").forEach(function(el) {
    const hasText = el.textContent.trim().length > 0;
    const hasAria = el.getAttribute("aria-label");
    const hasTitle = el.getAttribute("title");

    if (!hasText && !hasAria && hasTitle) {
      el.setAttribute("aria-label", hasTitle);
    }
  });
  /* Fix pagination arrows */
  document.querySelectorAll(".gdlr-core-pagination a, .page-numbers").forEach(function(link) {
    const text = link.textContent.trim();

    if (text === "←" || text === "«") {
      link.setAttribute("aria-label", "Previous page");
      link.setAttribute("title", "Previous page");
    }

    if (text === "→" || text === "»") {
      link.setAttribute("aria-label", "Next page");
      link.setAttribute("title", "Next page");
    }
  });

});
</script>

<script>
window.addEventListener("load", function () {
  /* Anchor skip link to H1 */
  const firstHeading = document.querySelector("h1");
  if (firstHeading) {
    firstHeading.setAttribute("tabindex", "-1");
  }

  /* Move existing skip link to the very top after all plugins load */
  const skip = document.querySelector(".skip-link");
  if (skip && document.body.firstElementChild !== skip) {
    document.body.insertBefore(skip, document.body.firstElementChild);
  }
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".gdlr-core-pagination").forEach(function (pagination) {
    if (pagination.tagName.toLowerCase() === "nav") return;

    const nav = document.createElement("nav");
    nav.className = pagination.className;
    nav.setAttribute("aria-label", "News pagination");
    nav.innerHTML = pagination.innerHTML;

    const prev = nav.querySelector("a.prev.page-numbers");
    const next = nav.querySelector("a.next.page-numbers");

    if (prev && !prev.getAttribute("aria-label")) {
      prev.setAttribute("aria-label", "Previous page");
    }

    if (next && !next.getAttribute("aria-label")) {
      next.setAttribute("aria-label", "Next page");
    }

    pagination.replaceWith(nav);
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  if (window.location.pathname.includes("/news")) {

    const container = document.querySelector(".gdlr-core-page-builder-body");

    if (container && !container.querySelector("h1.news-page-title")) {

      const h1 = document.createElement("h1");
      h1.className = "news-page-title";
      h1.textContent = "Angelina College News";

      container.prepend(h1);
    }

  }

});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  /* If page already has an H1, do nothing */
  if (document.querySelector("h1")) return;

  /* Try to get title from page title or breadcrumb */
  let pageTitle =
    document.querySelector(".gdlr-core-page-title") ||
    document.querySelector(".kingster-page-title") ||
    document.querySelector(".tribe-events-page-title");

  if (pageTitle) {

    const h1 = document.createElement("h1");
    h1.textContent = pageTitle.textContent.trim();
    h1.className = "auto-generated-h1";

    const content = document.querySelector(".gdlr-core-page-builder-body") ||
                    document.querySelector("main") ||
                    document.querySelector("#main-content");

    if (content) {
      content.prepend(h1);
    }
  }

});
</script>
<script>
function labelEventNavButtons() {
  document.querySelectorAll(".tribe-events-c-nav__prev").forEach(function(el) {
    el.setAttribute("aria-label", "Previous events");
  });

  document.querySelectorAll(".tribe-events-c-nav__next").forEach(function(el) {
    el.setAttribute("aria-label", "Next events");
  });
}

document.addEventListener("DOMContentLoaded", labelEventNavButtons);
document.addEventListener("tribe_events_views_v2_after_ajax_success", labelEventNavButtons);
</script>
