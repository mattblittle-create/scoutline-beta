		    <script>
    document.addEventListener("DOMContentLoaded", function() {
      function cleanUrl(u){
        try{
          var url = new URL(u);
          // Remove GA linker params
          url.searchParams.delete('_gl');
          url.searchParams.delete('_ga');
          // Remove any _ga_* params (e.g., _ga_ABC123)
          var toDelete = [];
          url.searchParams.forEach(function(v, k){
            if (k.indexOf('_ga_') === 0) toDelete.push(k);
          });
          toDelete.forEach(function(k){ url.searchParams.delete(k); });
          var s = url.toString().replace(/[?&]$/, '');
          return s;
        } catch(e){
          // Fallback if URL() fails (older browsers / malformed href)
          return u.replace(/([?&])_gl=[^&]*/g, '')
                  .replace(/([?&])_ga=[^&]*/g, '')
                  .replace(/([?&])_ga_[^&]*/g, '')
                  .replace(/[?&]$/, '');
        }
      }

      // Clean ezproxy links on page load (so Copy Link stays clean)
      document.querySelectorAll('a[href*="ezproxy.angelina.edu"]').forEach(function(a){
        a.href = cleanUrl(a.href);
      });

      // Clean again right before navigation (belt & suspenders)
      document.addEventListener('click', function(e){
        var a = e.target.closest && e.target.closest('a[href*="ezproxy.angelina.edu"]');
        if (!a) return;
        a.href = cleanUrl(a.href);
      }, true);
    });
    </script>
    
