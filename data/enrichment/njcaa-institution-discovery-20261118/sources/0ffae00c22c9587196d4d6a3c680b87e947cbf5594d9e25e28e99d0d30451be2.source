<style type="text/css">
/* ===============================
   SP News / News Pro Grid Styling
   =============================== */

/* Entire card content left aligned */
.wpnaw-news-grid-content,
.wpnaw-news-grid-content * {
  text-align: left !important;
}

/* News title */
.wpnaw-news-title,
.wpnaw-news-title a {
  color: #004f86 !important;
  text-align: left !important;
  text-decoration: none !important;
  font-weight: 600;
}

/* News title hover/focus */
.wpnaw-news-title a:hover,
.wpnaw-news-title a:focus {
  color: #ff671f !important;
}

/* Date and excerpt/body text */
.wpnaw-news-date,
.wpnaw-news-content,
.wpnaw-news-short-content,
.wpnaw-news-content p {
  color: #000000 !important;
  text-align: left !important;
  line-height: 1.5;
}

/* Regular links inside the card */
.wpnaw-news-grid-content a:not(.readmorebtn),
.wpnaw-news-content a:not(.readmorebtn) {
  color: #004f86 !important;
}

/* Read more button */
.wpnaw-news-content .readmorebtn,
.wpnaw-news-grid-content .readmorebtn,
a.readmorebtn {
  background: #004f86 !important;
  color: #ffffff !important;
  border: 1px solid #004f86 !important;
  padding: 6px 14px;
  display: inline-block;
  text-decoration: none !important;
  text-align: center !important;
}

/* Read more button hover/focus */
.wpnaw-news-content .readmorebtn:hover,
.wpnaw-news-content .readmorebtn:focus,
.wpnaw-news-grid-content .readmorebtn:hover,
.wpnaw-news-grid-content .readmorebtn:focus,
a.readmorebtn:hover,
a.readmorebtn:focus {
  background: #003a63 !important;
  border-color: #003a63 !important;
  color: #ffffff !important;
}
/* Hide Kingster page title/header on News Pro archive */
.post-type-archive-news .kingster-page-title-wrap {
  display: none !important;
}
/* News archive heading */
.post-type-archive-news .auto-generated-h1 {
  font-size: 0 !important;
  max-width: 1040px;
  margin: 0 auto !important;
  padding: 10px 20px 12px 0 !important;
  box-sizing: border-box;
  text-align: left !important;
}

.post-type-archive-news .auto-generated-h1::after {
  content: "AC News";
  display: block;
  font-size: 45px;
  line-height: 1.2;
  font-weight: 800;
  color: #004f86;
  text-align: left !important;
  margin-left: 0px !important;
}

/* Mobile */
@media (max-width: 767px) {

  /* AC News heading */
  .post-type-archive-news .auto-generated-h1::after {
    font-size: 34px;
    margin-left: 0 !important;
  }

  /* Individual story titles */
  .post-type-archive-news h3 {
    font-size: 22px !important;
    line-height: 1.1 !important;
    margin-top: 0 !important;
    margin-bottom: 8px !important;
  }

  .post-type-archive-news h3 a {
    font-size: 22px !important;
    line-height: 1.1 !important;
  }

}
</style>
