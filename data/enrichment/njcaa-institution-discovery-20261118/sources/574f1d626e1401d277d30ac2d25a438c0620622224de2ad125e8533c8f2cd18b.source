		    <style>
        @media (max-width: 768px) {
            .column-filter {
                position: fixed;
                top: 75px;
                left: 0;
                transform: translateX(-100%);
                height: calc(100vh - 75px);
                background-color: var(--color-black);
                z-index: 10000;
                overflow-y: scroll;
                padding: 3em 2em 6em 2em;
                transition: transform 0.3s ease-in-out;
                will-change: transform;
                box-sizing: border-box;
            }

            .column-filter.show {
                transform: translateX(0);
                width: 100vw !important;
                max-width: 100% !important;
            }

            .chosen-container {
                max-width: 100%;
            }

            .filter-toggle-wrapper {
                position: sticky;
                width: 100%;
                top: 75px;
                left: 0;
                right: 0;
                padding: 0;
                background-color: #fff;
                z-index: 9999;
                display: flex;
                flex-direction: column;
            }

            .filter-toggle-wrapper::after,
            .filter-toggle-wrapper::before {
                width: 120%;
                background-color: var(--color-black);
                height: 1px;
                content: ' ';
                margin: 1.5em -2em 0 -2em;
            }

            .filter-toggle-wrapper::before {
                margin-top: 0 !important;
                margin-bottom: 1.5em !important;
            }

            .filter-toggle-btn,
            .see-results-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5em;
                padding: 1em;
                background-color: var(--color-yellow);
                color: var(--color-black);
                border: 1px solid var(--color-yellow);
                border-radius: 0;
                cursor: pointer;
                font-size: 1rem;
                font-weight: 700;
                font-family: var(--font-proxima-nova);
                width: 100%;
                text-align: center;
            }

            .filter-toggle-btn:hover,
            .see-results-btn:hover {
                background-color: var(--color-black);
                color: #fff;
            }

            .filter-toggle-btn svg {
                width: 1em;
                height: 1em;
                fill: currentColor;
                flex-shrink: 0;
            }

            .close-filter-link {
                display: none;
            }

            body.filter-open {
                overflow: hidden;
            }

            .column-filter .sf-input-select {
                width: 100%;
                max-width: 100%;
                box-sizing: border-box;
                padding: 0.5em;
                border: none;
                background-color: #fff;
                color: #000;
                appearance: none;
                -webkit-appearance: none;
                -moz-appearance: none;
            }

            .column-filter .sf-input-select:focus {
                outline: 2px solid var(--color-yellow);
            }

            .column-filter select,
            .column-filter select[multiple] {
                width: 100% !important;
                max-width: 100%;
                background-image: none !important;
            }

            .column-filter .sf-field-taxonomy-university-college {
                background-color: transparent !important;
                padding: 0;
            }

            .sf-input-select + .sf-dropdown,
            .select2-container {
                z-index: 10001 !important;
            }
        }
    </style>

    <script>
        function initMobileFilters() {
            const filters = document.querySelectorAll('.column-filter');

            filters.forEach(function (filter) {
                if (filter.dataset.toggleInjected === 'true') return;

                const toggleBtn = document.createElement('button');
				toggleBtn.className = 'filter-toggle-btn';
				toggleBtn.setAttribute('type', 'button');
				toggleBtn.setAttribute('aria-expanded', 'false');
				toggleBtn.setAttribute('aria-controls', 'mobile-filter-panel');
				toggleBtn.setAttribute('aria-label', 'Toggle search, sort, and filter panel');
				toggleBtn.id = 'filter-toggle-button'; // For accessibility reference


				const filterPanelId = 'mobile-filter-panel';
				filter.setAttribute('id', filterPanelId);
				filter.setAttribute('role', 'region');
				filter.setAttribute('aria-labelledby', toggleBtn.id);
				filter.setAttribute('tabindex', '-1'); // Make focusable


                const svgIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svgIcon.setAttribute('viewBox', '0 0 512 512');
                svgIcon.innerHTML = '<path d="M0 416c0 17.7 14.3 32 32 32l54.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48L480 448c17.7 0 32-14.3 32-32s-14.3-32-32-32l-246.7 0c-12.3-28.3-40.5-48-73.3-48s-61 19.7-73.3 48L32 384c-17.7 0-32 14.3-32 32zm128 0a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zM320 256a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm32-80c-32.8 0-61 19.7-73.3 48L32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l246.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48l54.7 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-54.7 0c-12.3-28.3-40.5-48-73.3-48zM192 128a32 32 0 1 1 0-64 32 32 0 1 1 0 64zm73.3-64C253 35.7 224.8 16 192 16s-61 19.7-73.3 48L32 64C14.3 64 0 78.3 0 96s14.3 32 32 32l86.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48L480 128c17.7 0 32-14.3 32-32s-14.3-32-32-32L265.3 64z"/>';

                const toggleLabel = document.createElement('span');
                toggleLabel.textContent = 'Search, Sort & Filter';

                toggleBtn.appendChild(svgIcon.cloneNode(true));
                toggleBtn.appendChild(toggleLabel);

                const wrapper = document.createElement('div');
                wrapper.className = 'filter-toggle-wrapper';
                wrapper.appendChild(toggleBtn);
                filter.parentNode.insertBefore(wrapper, filter);

                const seeResultsBtn = document.createElement('button');
                seeResultsBtn.className = 'see-results-btn';
                seeResultsBtn.setAttribute('type', 'button');
                seeResultsBtn.textContent = 'See Results';
                filter.appendChild(seeResultsBtn);

 				toggleBtn.addEventListener('click', function () {
    			const isOpen = filter.classList.toggle('show');
				if (isOpen) {
   				 // Reset scroll inside the panel
    			filter.scrollTop = 0;

    			// Move keyboard focus into the panel
    			setTimeout(() => filter.focus(), 10);
				}

   			    toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    			document.body.classList.toggle('filter-open', isOpen);

    			if (isOpen) {
        		filter.scrollTop = 0; // Reset scroll inside panel
    			}

    			const target = document.querySelector('#content');
const wrapperHeight = document.querySelector('.filter-toggle-wrapper')?.offsetHeight || 0;

// Add extra spacing (e.g., 100px) above the content
const extraGap = -50;

if (target) {
  const offsetTop = target.getBoundingClientRect().top + window.pageYOffset - wrapperHeight - extraGap;
  window.scrollTo({ top: offsetTop, behavior: 'smooth' });
}

});

seeResultsBtn.addEventListener('click', function () {
    filter.classList.remove('show');
    toggleBtn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('filter-open');

    const wrapper = document.querySelector('.filter-toggle-wrapper');
    if (wrapper) {
        const offset = 40; // Adjust this value to increase/decrease space above
        const offsetTop = wrapper.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({ top: offsetTop, behavior: 'smooth' });
    }
});



                filter.dataset.toggleInjected = 'true';
            });
        }

        function destroyMobileFilters() {
            document.querySelectorAll('.filter-toggle-wrapper')?.forEach(el => el.remove());
            document.querySelectorAll('.see-results-btn')?.forEach(el => el.remove());
            document.querySelectorAll('.column-filter').forEach(filter => {
                filter.classList.remove('show');
                document.body.classList.remove('filter-open');
                delete filter.dataset.toggleInjected;
            });
        }

        function checkScreenWidth() {
            if (window.innerWidth < 768) {
                initMobileFilters();
            } else {
                destroyMobileFilters();
            }
        }

        document.addEventListener('sf:ajaxfinish', function () {
            document.querySelectorAll('.column-filter').forEach(filter => filter.classList.remove('show'));
            document.body.classList.remove('filter-open');
            document.querySelectorAll('.filter-toggle-btn').forEach(btn => btn.setAttribute('aria-expanded', 'false'));
        });
			// Close on Escape key
		document.addEventListener('keydown', function (e) {
    		if (e.key === 'Escape') {
        document.querySelectorAll('.column-filter.show').forEach(filter => {
            filter.classList.remove('show');
            document.body.classList.remove('filter-open');
            document.querySelectorAll('.filter-toggle-btn').forEach(btn => btn.setAttribute('aria-expanded', 'false'));
        });
    }
});


        /* Existing */
		window.addEventListener('load', checkScreenWidth);
        window.addEventListener('resize', checkScreenWidth);
    </script>
        
      </body>
</html>