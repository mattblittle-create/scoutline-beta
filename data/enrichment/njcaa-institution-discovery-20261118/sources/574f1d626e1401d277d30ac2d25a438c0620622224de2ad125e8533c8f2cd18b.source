}</style><style class="wpcode-css-snippet">/* DLM Buttons */
a.dlm-buttons-button-primary-button, a.dlm-buttons-button-table-btn
 {
	display: inline-flex !important;
	align-items: center;
	min-width: 186px;
	font-weight: 700;
	font-family: var(--font-proxima-nova) !important;
	width: auto !important;
}
a.dlm-buttons-button-primary-button:hover, a.dlm-buttons-button-table-btn:hover {
	background-color: var(--color-black) !important;
	color: var(--color-white) !important;
	border: 1px solid var(--color-black) !important;
	transition: color .3s ease-out,background-color .3s ease-out !important;
}
a.dlm-buttons-button-primary-button, a.dlm-buttons-button-secondary-button {
	margin-right: 1em;
	margin-bottom: 1em;
	font-size: 1rem !important;
}
@media screen and (max-width: 768px) {
	a.dlm-buttons-button-primary-button, a.dlm-buttons-button-secondary-button {
		width: 100% !important;
		margin-bottom: 1em;
		margin-right: 0;
		justify-content: center;
	}
}
a.dlm-buttons-button-secondary-button {
	display: inline-flex !important;
	align-items: center;
	min-width: 186px;
	font-weight: 700;
	font-family: var(--font-proxima-nova) !important;
	width: auto;
}
a.dlm-buttons-button-arrow-btn {
	display: inline-flex !important;
	align-items: center;
	font-size: 1rem !important;
	font-weight: 700;
	font-family: var(--font-proxima-nova) !important;
	padding: 0 !important;
}
a.dlm-buttons-button-arrow-btn strong:hover {
  text-decoration: underline;
}
a.dlm-buttons-button-title-icon strong {
  text-decoration: underline;
  font-weight: 700;
}
a.dlm-buttons-button-arrow-btn i.dlm-btn-icon {
	margin: 0 0.4em;
}
a.dlm-buttons-button-secondary-button:hover {
	background-color: #F4C109 !important;
	transition: color .3s ease-out,background-color .3s ease-out;
}
i.dlm-btn-icon, .print-btn i.print-icon {
  display: inline-block;
  width: 1.3em;
  height: 1.3em;
  background-color: var(--color-black); /* Set icon color */
  mask-image: url('/wp-content/uploads/file-pdf-solid.svg');
  mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  -webkit-mask-image: url('/wp-content/uploads/file-pdf-solid.svg');
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  margin-left: 0.4em;
}
.print-btn {
	display: flex;
	align-items: center;
	justify-content: center;
}
.print-btn:hover {
	cursor: pointer;
}
.dlm-buttons-button-primary-button:hover i.dlm-btn-icon, .print-btn:hover i.print-icon {
  background-color: var(--color-white); /* Set icon color */
  transition: background-color .3s ease-out;
}
i.dlm-arrow-icon {
  display: inline-block;
  width: 1em;
  height: 1em;
  background-color: var(--color-yellow);
  mask-image: url('/wp-content/uploads/arrow-right-solid-yellow.svg');
  mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  -webkit-mask-image: url('/wp-content/uploads/arrow-right-solid-yellow.svg');
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
}

a.dlm-buttons-button-title-icon {
	display: inline-flex !important;
	font-size: 1rem;
	font-family: var(--font-proxima-nova) !important;
	padding: 0 !important;
	align-items: center;
}
a.dlm-buttons-button-title-icon i.dlm-pdf-classic {
  display: inline;
  width: 1em;
  height: 1em;
  background-color: var(--color-black);
  mask-image: url('/wp-content/uploads/file-pdf-regular.svg') !important;
  mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  -webkit-mask-image: url('/wp-content/uploads/file-pdf-regular.svg') !important;
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  margin-left: 0.15em;
}
.expand-collapse-description a.dlm-buttons-button-title-icon i.dlm-pdf-classic {
	background-color: var(--color-white);
}
.expand-collapse-description a.dlm-buttons-button-title-icon {
	color: var(--color-white) !important;
}
/* Download Box */
aside.dlm-download-box {
	width: 100%;
	display: flex;
	min-height: 200px;
	margin: 2rem 0;
	border-radius: 0;
	border: 1px solid var(--color-black);
  	border-bottom: 5px solid var(--color-black);
	filter: drop-shadow(0 4px 6px rgba(0, 0, 0, .03)) drop-shadow(0 12px 16px rgba(0, 0, 0, .08));
	background-color: var(--color-white);
	align-items: flex-start;
}
aside.dlm-download-box .dlm-download-box-content {
	margin: auto;
}
aside.dlm-download-box img.wp-post-image {
	aspect-ratio: 4 / 3;
	max-height: 100%;
	overflow: hidden;
	max-width: 40%;
	margin: 15px 0 15px 15px;
	border: 1px solid var(--color-black);
	border-radius: 0;
	height: auto;
}
aside.dlm-download-box .dlm-download-box-content .dlm-download-button {
	width: 100% !important;
	text-decoration: none !important;
}
aside.dlm-download-box h3, aside.dlm-download-box h1 {
	font-size: 2rem;
	text-align: left;
	margin: 0.5em auto !important;
	max-width: 90%;
	text-transform: none;
}
aside.dlm-download-box p {
	text-align: left;
	max-width: 90%;
	margin: 0 auto 1em auto;
	font-size: 1rem !important;
	line-height: 120%;
}
aside.dlm-download-box .dlm-download-box-content {
	width: 100%;
	padding: 10px;
}
aside.dlm-download-button a.dlm-download-button {
	width: 100% !important;
	text-decoration: none !important;
}
aside.dlm-download-box .dlm-download-box-content .dlm-download-button {
	background-color: var(--color-yellow);
	border: 1px solid var(--color-yellow);
	color: var(--color-black);
	border-radius: 0;
	background-image: none;
	box-shadow: none;
  font-weight: 600;
	font-family: var(--font-proxima-nova) !important;
	max-width: 90%;
	margin: 0 auto;
	margin-bottom: 10px;
	font-size: 16px;
	padding: 15px 30px !important;
}
aside.dlm-download-box .dlm-download-box-content .dlm-download-button small {
	font-weight: 500 !important;
	line-height: 1.5 !important;
	display: none;
}
aside.dlm-download-box .dlm-download-box-content .dlm-download-button:hover  {
	background-color: var(--color-black) !important;
	color: var(--color-white) !important;
  border: 1px solid var(--color-yellow) !important;
	transition: color .3s ease-out,background-color .3s ease-out !important;
}
.dlm-download-box .dlm-download-count {
	border-radius: 0 !important;
	font-family: var(--font-proxima-nova) !important;
	color: var(--color-black) !important;
	display: none;
}
@media screen and (max-width: 768px) {
aside.dlm-download-box {
	flex-direction: column;
	height: auto;
	padding: 1em;
	}
aside.dlm-download-box img.wp-post-image {
	width: 100%;
	height: auto;
	max-width: 486px;
	margin: 0 auto !important;
	padding: 0;
}
	aside.dlm-download-box .dlm-download-box-content .dlm-download-button, aside.dlm-download-box h3, aside.dlm-download-box p {
	max-width: 100%;
	}
}
/* Downloads List - for use on white backgrounds */
ul.dlm-downloads li a.dlm-buttons-button-title-icon {
  margin: 0;
  padding: 0.5em !important;
  width: 100%;
  text-align: left !important;
}
@media screen and (max-width: 767px) {
	ul.dlm-downloads li a.dlm-buttons-button-title-icon {
	  flex-direction: row-reverse;
	  justify-content: flex-end;
	}
	ul.dlm-downloads li a.dlm-buttons-button-title-icon i.dlm-pdf-classic {
	  width: 1.5em;
	  height: 1.7em;
	  margin: 0 0.5em;
	  flex: 0 0 1.7em;
	}
}
ul.dlm-downloads li:nth-child(odd) a.dlm-buttons-button-title-icon {
	background-color: var(--color-light-grey);
}
ul.dlm-downloads:has(li a.dlm-buttons-button-title-icon) {
	list-style: none;
	padding-left: 0;
}
ul.dlm-downloads li a.dlm-buttons-button-title-icon strong  {
	text-decoration: none !important;
}
ul.dlm-downloads li a.dlm-buttons-button-title-icon strong:hover  {
	text-decoration: underline !important;
}
/* Use inside the Expand Collapse */
.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon {
	color: var(--color-white) !important;
}
.expand-collapse-description ul.dlm-downloads li:nth-child(odd) a.dlm-buttons-button-title-icon {
	background-color: transparent !important;
}
.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon i.dlm-pdf-classic {
	background-color: var(--color-white);
}
.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon {
	padding: 0.2em !important;
}
@media screen and (max-width: 767px) {
	.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon {
	  padding: 0.3em !important;
	}
}
.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon strong:hover  {
	text-decoration: none !important;
}
.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon:hover {
	background-color: var(--color-yellow) !important;
	color: var(--color-black) !important;
	transition: color .2s ease-out,background-color .3s ease-out;
}
.expand-collapse-description ul.dlm-downloads li a.dlm-buttons-button-title-icon:hover i.dlm-pdf-classic {
	background-color: var(--color-black) !important;
}
/* Document Library DLM CSS */
/* Grid View */
.dlm-pa-gridview-item {
	border-radius: 0;
	border-bottom: 5px solid var(--color-black);
	border-color: var(--color-black) !important;
}
.dlm-pa-gridview-button-wrap .dlm-pa-download-button-container a {
	width: 100% !important;
	justify-content: center;	
}
.dlm-pa-gridview-title h3 {
	font-family: var(--font-ibm-plex-sans) !important;
	line-height: 120% !important;
	font-size: 1.3rem !important;
	font-weight: 700 !important;
}
.dlm-pa-gridview-item .dlm-pa-gridview-excerpt p {
	font-size: 1rem;
	color: var(--color-black);
	font-family: var(--font-proxima-nova);
}
.dlm-pa-download-gridview-filters select, .dlm-pa-download-table-filters select {
	padding: 15px 30px;
	border: 0;
	background-color: var(--color-yellow);
	color: var(--color-black);
	font-family: var(--font-proxima-nova);
	font-weight: 700;
	appearance: none;
	-webkit-appearance: none;
    -moz-appearance: none;
	background-image: url('https://www.bhc.edu/wp-content/themes/bhc/img/fa-icons/chevron-down-solid-black.svg');
    background-repeat: no-repeat;
    background-size: 16px;
    background-position: top 45% right 10px;
}

.dlm-pa-download-gridview-filters select option, .dlm-pa-download-table-filters select option {
	background-color: #fff;
	padding-bottom: 2px;
}
.dlm-pa-download-gridview-pre, .dlm-pa-download-table-pre {
	margin-bottom: 3em;
}
.dlm-pa-pagination-controls {
	margin-top: 2em;
	font-size: 1.125rem;
}
.dlm-pa-files-listing-app .dlm-pa-pagination-controls button.button {
	padding: 15px 30px;
	border: 1px solid var(--color-yellow);
	background-color: var(--color-yellow);
	color: var(--color-black);
	font-family: var(--font-proxima-nova);
	font-weight: 700;
	transition: color .3s ease-out, background-color .3s ease-out;
}
.dlm-pa-files-listing-app .dlm-pa-pagination-controls button.button:hover {
	background-color: var(--color-black);
	color: var(--color-white);
	cursor: pointer;
}
.dlm-pa-files-listing-app .dlm-pa-pagination-controls button.button:disabled {
	display: none;
}
.dlm-pa-download-gridview-filters select {
  appearance: none;
  padding: 15px 35px 15px 25px;
  width: 100%;
  height: 50px;
  border: 0;
  font-weight: 700;
  background-color: var(--color-yellow) !important;
  background-repeat: no-repeat;
  background-size: 16px;
  background-position: top 45% right 10px;
  cursor: pointer;
}
/* Table View 
More styles are combined with Tables in Text Element and Structure */

td.dlm-pa-col-title {
	font-size: 1.125rem;
	font-weight: 700;
	text-align: left;
	vertical-align: top;
}
td.dlm-pa-table-td.dlm-pa-col-link > div > div > a.dlm-buttons-button.dlm-buttons-button-table-btn {
	width: 100% !important;
	max-width: 100% !important;
}
td.dlm-pa-table-td.dlm-pa-col-description {
	width: 40% !important;
	vertical-align: top;
}
td.dlm-pa-table-td.dlm-pa-col-link {
	width: 210px;
	vertical-align: top;
}
td.dlm-pa-table-td.dlm-pa-col-link > div > div > a.dlm-buttons-button-table-btn {
	display: inline-block !important;
}
td.dlm-pa-table-td.dlm-pa-col-size {
	min-width: 100px;
	vertical-align: top;
}
td.dlm-pa-table-td.dlm-pa-col-description > div > p {
	margin: 0 !important;
}
table.dlm-pa-download-table {
	border: none !important;
}
table.dlm-pa-download-table th.dlm-pa-table-th, table.dlm-pa-download-table thead {
	background-color: transparent !important;
}
/* BHC Download Box 2026-08-05 */
.bhc-download-box {
	width: 100%;
	margin-block: 2rem;
	padding: 2em;
	max-width: 910px;
}

.bhc-download-box--has-image {
	display: grid;
	grid-template-columns: minmax(180px, 35%) minmax(0, 1fr);
	gap: 2rem;
	align-items: start;
}

.bhc-download-box--no-image {
	display: block;
}

.bhc-download-box__media {
	min-width: 0;
}

.bhc-download-box__image {
	display: block;
	width: 100%;
	height: auto;
	aspect-ratio: 4 / 5;
	object-fit: cover;
	border: 1px solid var(--color-black);
	border-radius: 0;
}

.bhc-download-box__content {
	min-width: 0;
}

.bhc-download-box__heading-wrap {
	position: relative;
}

.bhc-download-box__heading {
	margin-top: 0;
	margin-bottom: 0.75rem;
	text-transform: none;
}

.bhc-download-box__description {
	margin: 1rem 0;
	font-size: 1rem;
}

.bhc-download-box__modified {
	margin: 1rem 0 0;
	line-height: 1.2;
}

.bhc-download-box__modified small {
	font-size: 0.875rem;
	font-style: italic;
}

.bhc-download-box__action {
	margin: 0;
}

.bhc-download-box__button {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: auto;
	min-width: 35%;
	margin: 0;
}

.bhc-heading-dots {
	display: block;
	margin-bottom: 0.5rem;
	line-height: 0;
}

.bhc-heading-dots svg {
	display: block;
	fill: currentColor;
}

.bhc-heading-dots--orange {
	color: var(--color-orange);
}

.bhc-heading-dots--green {
	color: var(--color-green);
}

.bhc-heading-dots--red {
	color: var(--color-red);
}

@media screen and (max-width: 767px) {
	.bhc-download-box--has-image {
		display: block;
	}

	.bhc-download-box__media {
		margin-bottom: 1.5rem;
	}

	.bhc-download-box__button {
		width: 100% !important;
	}
}

</style><style id="wp-custom-css">
.tribe-block__venue{
background-color:transparent !important;
}
.tribe-block__venue__meta::before{
display:none;
}
</style>

      </head>
