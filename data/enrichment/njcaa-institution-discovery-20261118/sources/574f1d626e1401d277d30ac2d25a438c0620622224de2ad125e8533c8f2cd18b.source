}
</style><style class="wpcode-css-snippet">/*/* Table Inside a Collapse */
table.courses {
	width: 100%;
	border-collapse: collapse;
}
.expand-collapse .item table.courses {
	width: 99% !important;
}
.expand-collapse .item table.courses td, .expand-collapse table.courses tr {
	background-color: transparent !important;
	color: var(--color-white) !important;
}
.expand-collapse .item .description-wrap table.courses thead th {
	border-bottom: 1px solid var(--color-yellow);
}
.expand-collapse .item .description-wrap table.courses tfoot td {
	border-top: 1px solid var(--color-yellow) !important;
}
table.courses th, th.dlm-pa-table-th {
	border-bottom: 3px solid var(--color-yellow) !important;
	font-size: 1rem !important;
	font-weight: 700;
}
table.courses tfoot td {
	border-top: 3px solid var(--color-yellow) !important;
	font-weight: bold;
}
.expand-collapse .description-wrap table.courses td, th {
	font-size: 1rem !important;
}</style><style class="wpcode-css-snippet">/* TOC */
.wp-block-rank-math-toc-block {
	background-color: var(--color-light-grey);
	padding: 0 1em 1em 1em;
	margin: 30px 0;
	border-bottom: 4px solid var(--color-yellow);
}
.wp-block-rank-math-toc-block h2, .wp-block-rank-math-toc-block h3, .wp-block-rank-math-toc-block h4 {
	padding-top: 25px;
	font-size: 1.25rem;
  font-family: var(--font-ibm-plex);
  font-weight: 700;
  text-transform: uppercase;
}
.wp-block-rank-math-toc-block nav ul {
  padding-left: 1em;
}
.wp-block-rank-math-toc-block nav ul li {
	  list-style: none;
	  font-weight: 700;
	  font-size: 1.5rem;
}
.wp-block-rank-math-toc-block nav ul li a {
	font-family: var(--font-ibm-plex-sans);
    font-size: 1rem;
    padding: 0.25em 0;
	text-decoration: none;
	display: inline-block;
}
.wp-block-rank-math-toc-block nav ul li a:hover::after {
  background: var(--color-yellow);
}
.wp-block-rank-math-toc-block nav ul li a::after {
	height: 2px;
	bottom: -0.5em;
	content: '';
	display: block;
	left: 0;
	right: 0;
}
.wp-block-rank-math-toc-block nav ul li ul li {
	list-style: disc;
	font-weight: normal;
	margin-left: 1em;
}
/* Business Wrapper */
.rank-math-business-wrapper {
	padding: 1.5em;
}
h3.rank-math-business-name {
	margin: 0;
	margin-bottom: 0.25em;
}
.rank-math-business-wrapper h5 {
  margin-bottom: 0.25em;
}
.rank-math-business-wrapper address {
	margin-bottom: 1em;
}
:where(.is-layout-grid) {
	gap: 1.5em;
}
@media screen and (max-width: 576px) {
.is-layout-grid:has(> .rank-math-business-wrapper) {
    display: block !important;
}
.rank-math-business-wrapper {
	margin-bottom: 1.5em !important;
	}
}
/* Related Content Block */
.wp-block-rank-math-related-posts .rank-math-related-wrap {
	margin-bottom: 60px;
	display: flex !important;
	flex-direction: column;
}
.wp-block-rank-math-related-posts .rank-math-related-wrap article {
	border: 1px solid var(--color-black) !important;
	border-bottom: 3px solid var(--color-black) !important;
	border-radius: 0 !important;
	padding: 0 !important;
	background-color: var(--color-white);	
	}
.wp-block-rank-math-related-posts .rank-math-related-wrap article a {
	border-radius: 0 !important;
	--aspect-ratio: calc(3 / 2);
}
.wp-block-rank-math-related-posts .rank-math-related-wrap article a img.wp-post-image {
	border-radius: 0 !important;
	height: 200px;
	object-fit: cover;
}
.wp-block-rank-math-related-posts .rank-math-related-wrap article h3 {
	margin: 1em !important;
}
.wp-block-rank-math-related-posts .rank-math-related-wrap article h3 a {
	font-size: 1.25rem;
	text-transform: uppercase;
	font-family: var(--font-ibm-plex-sans) !important;
    line-height: 120%;
	font-weight: bold;
	text-decoration: underline !important;
}
.wp-block-rank-math-related-posts .rank-math-related-wrap article h3 a:hover {
	color: var(--color-black) !important;
}
.wp-block-rank-math-related-posts .rank-math-related-wrap article .rank-math-related-excerpt {
	margin: 0 1em 1em 1em !important;
	font-size: 1.125rem;
	line-height: 120%;
}
@media (min-width: 768px) {
	.wp-block-rank-math-related-posts .rank-math-related-wrap {
		flex-wrap: nowrap;
		flex-direction: row;
	}
	.wp-block-rank-math-related-posts .rank-math-related-wrap article {
		flex: 0 1 32%;
	}
	.wp-block-rank-math-related-posts .rank-math-related-wrap article a img.wp-post-image {
	border-radius: 0 !important;
	height: 175px !important;
	object-fit: cover;
}
}</style><style class="wpcode-css-snippet">@page {
	size: 8.5in 11in;
	margin: 0.33in;
}
@media print {
	.display-print-none, .print-btn {
		display: none !important;
	}
	.pagebreak {
	page-break-before: always !important;
	clear: both;
	display: block;
}
	.display-print-only {
		display: flex !important;
	}
	#content {
		margin-top: 0 !important;
	}
	ul.wp-block-outermost-social-sharing {
		display: none;
	}
	.inner-nav, .nav-toggle, .featured-items, .related-programs, .ftr, .hdr, .multiple-callout.more-to-explore, .breadcrumbs, .wp-block-ppb-print-page
 {
		display: none;
	}
	.wp-block-columns {
		display: block !important;
	}
	.featured-image-and-title-inner  {
		background-color: var(--color-white) !important;
		color: var(--color-black) !important;
	}
	.page:not(.page-parent,.page-child) .featured-image-and-title::before, .page:not(.page-parent,.page-child) .featured-image-and-title .featured-image-and-title-inner::before, .page:not(.page-parent,.page-child) .featured-image-and-title::after {
		display: none;
	}
	.featured-image-and-title .inner-wrap {
		padding: 0 0 1em 0 !important;
	}
	h1.pg-title {
		font-size: 2.25rem;
		margin-top: 0 !important;
	}
	.page-child .featured-image-and-title {
		border-bottom: 5px solid var(--color-yellow);
	}
/* Expand-Collapse */
	.expand-collapse-description {
		display: block !important;
		background-color: #fff !important;
		border: 0 !important;
		border-top: none !important;
	}
	.expand-collapse .block-wrap {
		max-width: 100% !important;
	}
	.expand-collapse .block-wrap .item {
		border: 1px solid #000 !important;
	}
	.expand-collapse-description .description-wrap {
		background-color: #fff !important;
		color: #000 !important;
		max-width: 100% !important;
	}
	.expand-collapse-title {
		border: none !important;
	}
	.expand-collapse-title a span:before {
		display: none !important;
	}
	.expand-collapse .item .expand-collapse-title a {
		padding: 1em 1.5em !important;
	}
	.expand-collapse .item .expand-collapse-description .description-wrap {
		padding: 0 1.5em 1em 1.5em !important;
		width: 100% !important;
	}
/* Contact Info, links, split feature */
	.contact-info .block-wrap {
	flex-direction: row !important;
}
	.contact-info .block-wrap div {
		flex: 1 1 100px !important;
}
	a {
		color: #000 !important;
	}
	.link-wrap a.btn {
		width: auto !important;
	}
	.split-feature .block-wrap .split-feature-inner, div.img-wrap div.content {
		display: flex;
		gap: 60px;
	}
/* Events Block */
	.events-list {
		display: flex;
		flex-flow: row wrap;
		justify-content: center;
	}
	.events-list .event-item {
		flex-basis: 33%;
	}
	.events .link-wrap {
		display: none !important;
	}
/* Faculty/Staff Grid */
	.faculty-staff-results-wrap .category-group-wrap .faculty-staff-results {
		display: flex;
		flex-flow: row wrap;
		justify-content: left;
	}
	.block.faculty_staff_list {
		break-inside: avoid;
	}
	.faculty-staff-results .item {
		flex-basis: 23%;
		page-break-inside: avoid;
	}
	.faculty-staff-results .item .title {
		font-size: 16px;
		line-height: 20px;
	}
	.faculty-staff-results .item ul.links {
		display: block;
	}
	.faculty-staff-results .item ul.links li a span.screen-reader-text {
		display: block !important;
		overflow: visible !important;
		clip-path: none !important;
		clip: auto !important;
		height: auto !important;
		width: auto !important;
		margin-left: 2em;
	}
	.faculty-staff-results .item ul.links li {
		margin-bottom: 0 !important;
		font-size: 0.8rem !important;
	}
	.faculty-staff-results .links a {
		padding: 0 !important;
	}
	.faculty-staff-results-wrap .faculty-staff-lead {
		display: flex;
		max-width: 100% !important;
		width: 100%;
		align-items: center;
		gap: 25px;
	}
	.faculty-staff-lead .photo-wrap, .faculty-staff-lead .lead-copy-wrap span.title {
		margin-top: 1em;
	}
	p.name a {
		text-decoration: none;
	}
/* Multiple Callout */
	.multiple-callout .block-wrap .callout-inner {
		display: flex;
		align-items: flex-start;
		flex-wrap: wrap;
		row-gap: 0;
		align-content: flex-start;
		justify-content: space-between;
	}
	.multiple-callout.col-2 .block-wrap .callout-inner div.callout, .multiple-callout.col-4 .block-wrap .callout-inner div.callout, .multiple-callout.col-3 .block-wrap .callout-inner div.callout {
		/*flex-basis: 47%; */
		break-inside: auto;
		page-break-inside: auto;
		font-size: 14px;
	}
	.wp-block-columns {
		display: flex !important;
	}
	h2 span.dot-pattern {
		display: none;
	}
	h2 {
		margin: 0.5em 0 !important;
		font-size: 2rem;
	}
	.block {
		margin: 25px 0;
	}
/* Roster Pages 
	
/* News Template */
	.sidebar-wrap {
	 display: none;
	}
/* Event Template */
	h2.tribe-events-related-events-title, ul.tribe-related-events {
		display: none !important;
	}
	.tribe-events-pg-template {
		padding-top: 0 !important;
	}
	.tribe-events-venue-map {
		width: 100%;
	}
	.tribe-events-l-container {
		background-color: white !important;
		padding: 0 !important;
		margin: 0 auto !important;
		max-width: 100%;
	}
	.grecaptcha-badge, #back-to-top, #rank-math-analytics-stats-wrapper {
		visibility: hidden;
	}
/* Events List (for Athletics) */
	.event-item {
		flex-wrap: nowrap !important;
		gap: 5% !important;
		height: auto;
		font-size: 13px;
		break-inside: avoid;
	}
	.event-date {
		flex: 0 0 22% !important;
		max-width: 22%;
	}
	.event-time {
		max-width: 10%;
		flex: 0 0 10% !important;
	}
	.events-list-block .events-list {
		flex-flow: column nowrap !important;
	}
}</style><style class="wpcode-css-snippet">/* News Post Styles */
/* Header */
.post-template-default h1.pg-title {
	text-transform: none;
}
.post-template-default .bdy .featured-image-and-title {
	border-bottom: 10px solid var(--color-yellow);
}
.post-template-default .bdy .featured-image-and-title .wrap .inner-wrap {
	width: 80%;
}
@media screen and (min-width: 768px) and (max-width: 979px) {
.featured-items h2 {
	max-width: 60% !important;
}
}
.single-post .posts-sidebar-wrap {
	padding-top: 3em !important;
	gap: 2em;
}
@media screen and (min-width: 782px) {
	.post .published + .block {
		margin-top: 0 !important;
	} 
}
@media screen and (min-width: 932px) {
	.posts-sidebar-wrap .sidebar-wrap {
	width: 30% !important;
	position: sticky;
	display: flex;
	top: 175px;
	align-self: self-start;
	margin-bottom: 60px;
}
	.posts-sidebar-wrap .sidebar-wrap .news-events-sidebar {
		width: 100%;
	}
}
@media screen and (max-width: 768px) {
	.single-post img.alignright, .single-post .wp-caption.alignright {
		width: 100% !important;
		max-width: 100% !important;
	}
	.single-post .wp-caption.alignright {
		margin: 0 !important;
	}
}
@media screen and (min-width: 781px) {
	.single-post img.alignright, .single-post .wp-caption.alignright {
		max-width: 50% !important;
	}
}
@media screen and (min-width: 769px) and (max-width: 782px) {
	.single-post img.alignright {
		max-width: 80% !important;
	}
}
@media screen and (max-width: 931px) {
	.posts-sidebar-wrap .sidebar-wrap .news-events-sidebar {
		width: 100%;
	}
	.single-post .sidebar-wrap {
		max-width: 450px !important;
		width: 100%;
		margin: 0 auto;
	}
	.posts-sidebar-wrap, .post, .posts-sidebar-wrap .sidebar-wrap {
		display: block !important;
	}
	.post {
		width: 100%;
	}
}

@media screen and (max-width: 782px) {
	.post-list .post .post-inner, .posts .post .post-inner {
		flex-direction: column;
		padding-right: 12px !important;
	}
	.post-list-wrap .post-list .post-inner .img-wrap, .posts .post .post-inner .img-wrap {
		width: 100% !important;
		max-width: 400px !important;
		margin: 0 auto 1rem auto !important;
	}
	.post-list-wrap .post-list .content-inner, .posts .post-inner {
		margin: 1rem 0 !important;
	}
}
/* Inner Nav in Post */
@media screen and (max-width: 782px) {
.post .inner-nav {
	margin-top: 10px !important;
}
}
@media screen and (min-width: 783px) {
.post .inner-nav {
	margin-top: 10px !important;
}
}
.post .block:first-child {
	margin-top: 0;
}
/* Social Sharing */
ul.wp-block-outermost-social-sharing li {
	border-radius: 0;
	padding: 7px;
	font-size: 1.125em;
}
.post .post-inner .content-inner p.post-excerpt, .post .post-inner .content-inner .date {
	font-size: 1rem;
}
/* Block Spacing */
.block.rtf, figure.wp-block-image {
	margin: 1em 0;
}</style><style class="wpcode-css-snippet">/* Shared Pages TEC CSS */
/* ==========================================================================
   IFC Additions 6.11.29
   ========================================================================== */

.tribe-events-c-subscribe-dropdown__button {
	margin-top: 2em !important;
}
.tribe-events-c-subscribe-dropdown__button:hover svg path {
    fill: var(--color-white) !important;
}
/* Center Global Events Page Wrapper */
.tribe-events-pg-template{
	margin-left: auto;
	margin-right: auto;
}
.tribe-events-c-subscribe-dropdown__button:hover,
.tribe-events-c-subscribe-dropdown__button:hover
.tribe-events-c-subscribe-dropdown__button-text {
	color: var(--color-white) !important;
	transition: 0.2s;
}

/* ==========================================================================
   Buttons - keep in this file
   ========================================================================== */

.tribe-events-c-subscribe-dropdown__button, .tribe-events-c-subscribe-dropdown__content ul, .tribe-button-secondary, .tribe-button.events-community-submit, .tribe-button.tribe-button-primary.add-new, .tribe-configure-virtual-button {
	border-radius: 0 !important;
	color: var(--color-black) !important;
	font-size: 1rem !important;
	font-weight: 700 !important;
	padding: 15px 30px !important;
	text-transform: capitalize !important;
	letter-spacing: 0 !important;
	font-family: var(--font-proxima-nova) !important;
	text-decoration: none !important;
}
.tribe-button.tribe-button-primary.add-new {
	height: 3rem !important;
	margin-top: 1.2em !important;
}
.tribe-button.events-community-submit, .tribe-button.tribe-button-primary.add-new, .tribe-configure-virtual-button {
	background-color: var(--color-yellow) !important;
	border: 1px solid var(--color-yellow) !important;
}
.tribe-button.events-community-submit:hover, .tribe-button.tribe-button-primary.add-new:hover {
	background-color: var(--color-black) !important;
	color: var(--color-white) !important;
	transition: color .3s ease-out, background-color .3s ease-out;
}
.tribe-button.tribe-button-secondary, .tribe-configure-virtual-button {
	background-color: var(--color-white) !important;
	border: 1px solid var(--color-black) !important;
	text-decoration: none !important;
}
.tribe-button.tribe-button-secondary:hover, .tribe-configure-virtual-button:hover {
	background-color: var(--color-yellow) !important;
	transition: color .3s ease-out, background-color .3s ease-out;
}
.tribe-button.tribe-button-small.tribe-button-tertiary, .tribe-button-tertiary {
	border-radius: 0 !important;
	padding: 15px 30px !important;
	color: var(--color-black) !important;
	font-weight: 700 !important;
	text-transform: capitalize !important;
