            <main id="main-content">
               <div class="outer-pad">
                  <div class="hero__outer">
                     
                     <div class="hero--home">
                        <div class="hero__media"><picture>
                              <source srcset="https://www.delta.edu/_resources/images/homepage-hero-1920x1280/homepage-hero-students-102.jpg" media="(min-width: 1024px)">
                              <source srcset="https://www.delta.edu/_resources/images/homepage-hero-1920x1280/homepage-hero-students-102.jpg" media="(min-width: 640px)"><img src="https://www.delta.edu/_resources/images/homepage-hero-mobile-828x1794/homepage-hero-students-102-mobile.jpg" alt="" loading="lazy" width="1434" height="502"></picture></div>
                        <div class="hero__content">
                           <h1 class="hero__title">Find your way. <br>The Delta Way.</h1>
                           <div class="hero__content-cta"><a href="https://www.delta.edu/features/the-delta-way/index.html" class="btn--secondary">Learn about the Delta Way</a></div>
                        </div>
                     </div> 
                     
                     
                     <div class="hero__lower">
                        <div class="hero__lower-content">
                           <div class="hero__lower-story">
                              <div class="hero__lower-story-eyebrow">You can do this.</div>
                              <h2 class="hero__lower-story-title"><a class="primary-link" href="https://www.delta.edu/admissions/apply.html"><span>Register now for Winter 2027</span></a></h2>
                              <p>
                                 <p>The winter semester at Delta College begins January 9. New and current students can
                                    plan now by registering for classes today!</p>
                              </p>
                           </div>
                           <div class="hero__lower-links">
                              <ul class="hero__lower-links-wrap">
                                 <li>
                                    <h3><a href="https://www.delta.edu/locations/index.html" class="primary-link"><span>Our campuses</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                             <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></h3>
                                    <p><span data-olk-copy-source="MessageBody">Centrally located main campus, plus convenient locations in downtown Midland, Saginaw
                                          and Bay City. &nbsp;&nbsp;</span></p>
                                 </li>
                                 <li>
                                    <h3><a href="https://www.delta.edu/costs-financial-aid/scholarships/reconnect.html" class="primary-link"><span>MI Reconnect Scholarship</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                             <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></h3>
                                    <p>With Michigan Reconnect, you can get your degree or certificate from Delta, tuition-free.</p>
                                 </li>
                              </ul>
                           </div>
                        </div>
                     </div> 
                     </div>
                  
                  <div class="home-testimonials">
                     <div class="home-testimonials__wrap">
                        <h2 class="home-testimonials__title">Why choose Delta?</h2>
                        <div class="home-testimonials__profiles">
                           <ul class="home-testimonials__profiles-wrap">
                              <li class="home-testimonials__profile"><button class="home-testimonials__profile-link"><img src="https://www.delta.edu/_resources/images/homepage-testimonials-gallery/christina-justice-round.png" alt="Christina Justice"></button><div class="home-testimonials__label">Affordability</div>
                              </li>
                              <li class="home-testimonials__profile"><button class="home-testimonials__profile-link"><img src="https://www.delta.edu/_resources/images/homepage-testimonials-gallery/noah-maciag-round.png" alt="Noah Maciag"></button><div class="home-testimonials__label">Programs</div>
                              </li>
                              <li class="home-testimonials__profile"><button class="home-testimonials__profile-link"><img src="https://www.delta.edu/_resources/images/homepage-testimonials-gallery/kelsie-shance-round.png" alt="Kelsie Shance"></button><div class="home-testimonials__label">Support</div>
                              </li>
                              <li class="home-testimonials__profile"><button class="home-testimonials__profile-link"><img src="https://www.delta.edu/_resources/images/homepage-testimonials-gallery/alex-gonzalez-round.png" alt="Alex Gonzalez"></button><div class="home-testimonials__label">Community</div>
                              </li>
                           </ul>
                           <nav class="home-testimonials__mobile-nav"><button class="prev"><svg xmlns="http://www.w3.org/2000/svg" id="SVG-link-arrow" width="10.629" height="16.84" viewBox="0 0 10.629 16.84">
                                    <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41,2.627-1.518Z" transform="translate(-1.519 1.202)" fill="#9ad8ce"/></svg></button><button class="next"><svg xmlns="http://www.w3.org/2000/svg" id="SVG-link-arrow" width="10.629" height="16.84" viewBox="0 0 10.629 16.84">
                                    <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41,2.627-1.518Z" transform="translate(-1.519 1.202)" fill="#9ad8ce"/></svg></button></nav>
                        </div>
                        <div class="home-testimonials__quotes">
                           <figure class="home-testimonials__quote"><svg xmlns="http://www.w3.org/2000/svg" width="63.573" height="47.927" viewBox="0 0 63.573 47.927">
                                 <g id="Group_14353" data-name="Group 14353" transform="translate(-119.045 -1421.535)">
                                    <g id="Group_14351" data-name="Group 14351">
                                       <g id="Quote_marks_coral_RGB" data-name="Quote_marks_coral RGB" transform="translate(119.268 1421.551)">
                                          <path id="Path_20401" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                       <g id="Quote_marks_coral_RGB-2" data-name="Quote_marks_coral RGB" transform="translate(151.055 1421.551)">
                                          <path id="Path_20401-2" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                    </g>
                                 </g></svg><p>Michigan Reconnect is opening up so many opportunities for people who would never
                                 consider going to school. I'm really grateful that it's here in Michigan.</p>
                              <div class="home-testimonials__quote-attribution"><strong>Christina Justice</strong>, Respiratory Care</div>
                              <div class="home-testimonials__quote-context"><span data-olk-copy-source="MessageBody">Michigan Reconnect gave Christina the opportunity to pursue her education without
                                    the financial burden. See how Delta can make college more affordable for you.</span></div>
                              <div class="home-testimonials__link"><a href="https://www.delta.edu/costs-financial-aid/index.html" class="primary-link--alt"><span>Learn about paying for college</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                       <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></div>
                           </figure>
                           <figure class="home-testimonials__quote"><svg xmlns="http://www.w3.org/2000/svg" width="63.573" height="47.927" viewBox="0 0 63.573 47.927">
                                 <g id="Group_14353" data-name="Group 14353" transform="translate(-119.045 -1421.535)">
                                    <g id="Group_14351" data-name="Group 14351">
                                       <g id="Quote_marks_coral_RGB" data-name="Quote_marks_coral RGB" transform="translate(119.268 1421.551)">
                                          <path id="Path_20401" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                       <g id="Quote_marks_coral_RGB-2" data-name="Quote_marks_coral RGB" transform="translate(151.055 1421.551)">
                                          <path id="Path_20401-2" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                    </g>
                                 </g></svg><p>Delta lets you try new things. They have a program for everyone and a lot of resources
                                 to help you figure out what you want to do.</p>
                              <div class="home-testimonials__quote-attribution"><strong>Noah Maciag</strong>, Associate in Arts, Theater</div>
                              <div class="home-testimonials__quote-context"><span data-olk-copy-source="MessageBody">Noah found the freedom to explore his interests and discover new possibilities at
                                    Delta. With so many programs to choose from, there's room to find what fits you.</span></div>
                              <div class="home-testimonials__link"><a href="https://www.delta.edu/programs/index.html" class="primary-link--alt"><span>Find your perfect program</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                       <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></div>
                           </figure>
                           <figure class="home-testimonials__quote"><svg xmlns="http://www.w3.org/2000/svg" width="63.573" height="47.927" viewBox="0 0 63.573 47.927">
                                 <g id="Group_14353" data-name="Group 14353" transform="translate(-119.045 -1421.535)">
                                    <g id="Group_14351" data-name="Group 14351">
                                       <g id="Quote_marks_coral_RGB" data-name="Quote_marks_coral RGB" transform="translate(119.268 1421.551)">
                                          <path id="Path_20401" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                       <g id="Quote_marks_coral_RGB-2" data-name="Quote_marks_coral RGB" transform="translate(151.055 1421.551)">
                                          <path id="Path_20401-2" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                    </g>
                                 </g></svg><p>Delta gives you the opportunity to gain so much more than knowledge. They have the
                                 support you need to achieve your dreams, even if you don't know what they are yet.</p>
                              <div class="home-testimonials__quote-attribution"><strong>Kelsie Shance</strong>, Early Middle College</div>
                              <div class="home-testimonials__quote-context"><span data-olk-copy-source="MessageBody">Kelsie learned that having the right support can make all the difference. At Delta,
                                    there's someone in your corner every step of the way.</span></div>
                              <div class="home-testimonials__link"><a href="https://www.delta.edu/services-support/index.html" class="primary-link--alt"><span>Learn about services and support</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                       <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></div>
                           </figure>
                           <figure class="home-testimonials__quote"><svg xmlns="http://www.w3.org/2000/svg" width="63.573" height="47.927" viewBox="0 0 63.573 47.927">
                                 <g id="Group_14353" data-name="Group 14353" transform="translate(-119.045 -1421.535)">
                                    <g id="Group_14351" data-name="Group 14351">
                                       <g id="Quote_marks_coral_RGB" data-name="Quote_marks_coral RGB" transform="translate(119.268 1421.551)">
                                          <path id="Path_20401" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                       <g id="Quote_marks_coral_RGB-2" data-name="Quote_marks_coral RGB" transform="translate(151.055 1421.551)">
                                          <path id="Path_20401-2" data-name="Path 20401" d="M72.794-.006C63.577-.351,55.627,11.113,55.108,25.63c-1,10.86,2.662,21.939,11.868,22.274,7.958.289,12.166-6.249,12.512-15.755.288-8.584-3.39-15.733-10.248-17.465,1.21-4.551,3.919-7.026,6.4-7.026,4.509-.548,6.406,3.281,7.765,7.376l3.334-1.329C84.258,5.755,79.073.225,72.794-.006Z" transform="translate(-55.172 -0.003)" fill="#f27968"/>
                                       </g>
                                    </g>
                                 </g></svg><p>I'm leaving Delta College with a network of very highly educated, very interesting
                                 people who are invested in my success. I did not have that before I came here.</p>
                              <div class="home-testimonials__quote-attribution"><strong>Alex Gonzalez</strong>, Entrepreneurship</div>
                              <div class="home-testimonials__quote-context"><span data-olk-copy-source="MessageBody">Alex built a network of people who encourage his growth and believe in his future.
                                    Discover the connections and sense of community waiting for you at Delta.</span></div>
                              <div class="home-testimonials__link"><a href="https://www.delta.edu/life-at-delta/index.html" class="primary-link--alt"><span>Learn more about campus community</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                       <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></div>
                           </figure>
                        </div>
                        <nav class="home-testimonials__mobile-dots"><button class="home-testimonials__dot"><span class="visible-for-screen-readers">Affordability</span></button><button class="home-testimonials__dot"><span class="visible-for-screen-readers">Programs</span></button><button class="home-testimonials__dot"><span class="visible-for-screen-readers">Support</span></button><button class="home-testimonials__dot"><span class="visible-for-screen-readers">Community</span></button></nav>
                        <div class="home-testimonials__mobile-links">
                           <div class="home-testimonials__link"><a href="https://www.delta.edu/costs-financial-aid/index.html" class="primary-link--alt"><span>Learn about paying for college</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
                                    <path data-name="SVG-link-arrow" d="M7.652,5.728,1.519,2.318S2.615-.448,2.867-1.2C4.74.283,10.48,4.666,12.148,5.625V8.831c-1.645.96-7.408,5.345-9.281,6.807-.251-.731-1.348-3.49-1.348-3.49l6.134-3.41H6.6c-4.135,0-13.081.514-14.452.56V5.141c1.371.068,10.318.587,14.452.587Z" transform="translate(7.856 1.202)" fill="#0d4638"/></svg></a></div>
                           <div class="home-testimonials__link"><a href="https://www.delta.edu/programs/index.html" class="primary-link--alt"><span>Find your perfect program</span><svg xmlns="http://www.w3.org/2000/svg" width="20.003" height="16.84" viewBox="0 0 20.003 16.84">
