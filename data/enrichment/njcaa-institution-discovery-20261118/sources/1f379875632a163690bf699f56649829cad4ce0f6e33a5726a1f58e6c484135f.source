<script type="text/javascript">
//<![CDATA[
    document.addEventListener('DOMContentLoaded', function () {

        // Fix low-res/missing maxresdefault thumbnails
        document.querySelectorAll('.yt-lazy-poster').forEach(function (img) {
            img.addEventListener('load', function () {
                if (img.naturalWidth <= 120 && img.dataset.fallback) {
                    img.src = img.dataset.fallback;
                }
            });
            img.addEventListener('error', function () {
                if (img.dataset.fallback) img.src = img.dataset.fallback;
            });
        });

        function loadVideoSlide(container) {
            console.log('loadVideoSlide called', container);
            if (!container || container.dataset.loaded === "true") return;
            container.dataset.loaded = "true";
            var videoId = container.getAttribute('data-video-id');
            console.log('Loading video ID:', videoId);
            var iframe = document.createElement('iframe');
            iframe.width = "560";
            iframe.height = "315";
            iframe.src = "https://www.youtube.com/embed/" + videoId +
                "?autoplay=1&mute=1&playsinline=1&controls=0&loop=1&playlist=" + videoId;
            iframe.title = "YouTube video player";
            iframe.setAttribute('allow', 'autoplay; encrypted-media');
            iframe.setAttribute('allowfullscreen', 'allowfullscreen');
            container.innerHTML = "";
            container.appendChild(iframe);
        }

        function checkActiveSlide() {
            document.querySelectorAll('.carousel-item.active .yt-lazy-video').forEach(loadVideoSlide);
        }

        window.addEventListener('load', function () {
            setTimeout(checkActiveSlide, 1500);
        });

        var carouselEl = document.getElementById('hero-carousel');
        if (carouselEl) {
            var inner = carouselEl.querySelector('.carousel-inner');
            if (inner) {
                console.log('Observing', inner.querySelectorAll('.carousel-item').length, 'carousel items');
                var observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (m) {
                        if (m.attributeName === 'class' && m.target.classList.contains('active')) {
                            var lazyVideo = m.target.querySelector('.yt-lazy-video');
                            if (lazyVideo) loadVideoSlide(lazyVideo);
                        }
                    });
                });
                inner.querySelectorAll('.carousel-item').forEach(function (item) {
                    observer.observe(item, { attributes: true, attributeFilter: ['class'] });
                });
            }
        }
    });
//]]>
</script>



