                                <style>
        /* --- Base / tokens --- */
        :root{
          --blue-900:#112b4a;
          --blue-700:#163c6a;
          --blue-200:#e7eef8;
          --ink:#13223a;
          --muted:#6a7688;
          --card:#f3f6fb;
          --radius: 5px;
          --gap:2rem;
        }
        
        /* --- Layout (Grid) --- */
        .hp-grid{
          display:grid;
          grid-template-columns: repeat(2, 1fr);
          grid-template-areas: "news events";
          gap: var(--gap);
          align-items:start;
          padding: 3em 2em;
        }
        
        /* Swap columns by adding .layout--swap to .hp-grid */
        .hp-grid.layout--swap{
          grid-template-areas: "events news";
          grid-template-columns: 1fr 2fr;
        }
        
        .hp-news   { grid-area: news; }
        .hp-events { grid-area: events; }
        
        /* Responsive stack */
        @media (max-width: 900px){
          .hp-grid,
          .hp-grid.layout--swap{
            grid-template-columns: 1fr;
            grid-template-areas:
              "news"
              "events";
          }
        }
        
        /* --- NEWS --- */
        .news-feature{
          display:grid;
          /*gap: 1rem;*/
        }
        
        .news-media{
          display:block;
          border-radius: var(--radius) var(--radius) 0 0 ;
          overflow:hidden;
          background:#ddd;
        }
        .news-media img{
          display:block;
          width:100%;
          height:auto;
          aspect-ratio: 16 / 9;
          object-fit: cover;
        }
        
        .news-body{
          background: #d6e8ee;
          border-radius: 0 0 var(--radius) var(--radius);
          padding: 1.25rem 1.5rem;
        }
        .news-title{
          margin:0 0 .5rem;
          font: 400 1.15rem 'Poppins', sans-serif;
          letter-spacing:.01em;
              line-height: 31px;
        }
        .news-title a{
          color: #0567aa;
          text-decoration:none;
        }
        .news-title a:hover{ text-decoration:underline; }
        
        .news-date{
          display:block;
          color: #003366;
          font: 400 1.125rem 'Poppins', sans-serif;
        }
        
        /* --- EVENTS --- */
        .events-list{
          list-style:none;
          margin:0 0 1rem;
          padding:0;
          display:grid;
          gap: 1rem;
        }
        .event{
          --max-width: 530px;    
          background:#fff;
          border-radius: var(--radius);
          margin-inline: 0;
          max-width: var(--max-width);
          display:grid;
          grid-template-columns: 80px 1fr;
          gap: 1rem;
          align-items:center;
          text-decoration:none;
          padding: .5rem;
          border-radius: var(--radius);
          transition: background 150ms ease-in-out;
        }
        
        .event-link:hover .event-title{ text-decoration:underline; }
        
        /* calendar tile */
        .event-date-tile{
          width: 80px;
          min-width:80px;
          aspect-ratio: 1 / 1;
          display:grid;
          place-items:center;
          border-radius: 8px;
          background-color:#d6e8ee;
        }
        .event-month{
          font: 400 0.875rem 'Poppins', sans-serif;
          color: #003366;
          letter-spacing:.08em;
                  margin: 0 0 -0.5rem;
        }
        .event-day{
          font: 500 1.5rem 'Poppins', sans-serif;
          color: #003366;
        }
        
        .event-details{
          display:grid;
        }
        .event-title{
          margin:0;
          font: 400 1.15rem 'Poppins', sans-serif;
          color: #0567aa;
          line-height: 29px;
        }
        .event-meta{
          margin:0;
          color: #000000;
          font: 400 1rem 'Poppins', sans-serif;
          line-height:1.5;
        }
        /* button */
        .btn.more-events{
          display:inline-block;
          background: var(--blue-900);
          color:#fff;
          text-decoration:none;
          padding:.75rem 1.1rem;
          border-radius: .75rem;
          font: 600 1rem/1 'Poppins', sans-serif;
        }
        .btn.more-events:hover{ background:#0d213a; }
    </style>

