<!-- Mobile menu double-toggle fix: main-updated.js bundles its own private copy of
     Bootstrap Collapse, which registers a second document-level click listener
     alongside the CDN Bootstrap instance. Both fire on the same click, causing
     the mobile menu to close then immediately reopen. This intercepts the click
     in the capture phase, BEFORE either Bootstrap instance's listener runs, and
     handles the toggle manually. Must stay ABOVE the jQuery/Bootstrap/main-updated.js
     script tags below — registration order determines capture-phase firing order.
     Remove this once main-updated.js is rebuilt with bootstrap marked as an
     external dependency instead of bundled. -->
<script>
//<![CDATA[
(function () {
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('#menu-button');
    if (!btn) return;
    e.stopImmediatePropagation();
    e.preventDefault();

    var targetSelector = btn.getAttribute('data-bs-target');
    var target = targetSelector ? document.querySelector(targetSelector) : null;
    if (!target) return;

    var isOpen = target.classList.contains('show');
    target.classList.toggle('show', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  }, true);
})();
//]]>
</script>

