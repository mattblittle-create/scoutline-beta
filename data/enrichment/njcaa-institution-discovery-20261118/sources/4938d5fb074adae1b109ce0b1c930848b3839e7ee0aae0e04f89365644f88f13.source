      	<!-- Page Layout -->
      		
      <style>
			#main {background-color:#fff}
			#main #content {padding-top:0px}
			.hero-block .holder > * {vertical-align:bottom}
			.hero-block h1 {font-weight:600; font-size:46px;}
			.breadcrumbs ul {padding:20px 32px 75px}
			.pathways-container {max-width:1170px; margin:0px auto; padding:50px 30px 50px 30px;}
			.pathways-container-top {padding-top:0px}
			.pathways-tabs-container {max-width:1170px; margin:0px auto; padding:15px 30px 45px 30px;}
			.pathways-container h2 {font-size:40px; line-height:1; font-weight:bold; color:#003a70;}
			.pathways-container .content-center-text h2 {text-align:center}
			.pathways-tabs-container h2 {font-size:40px; line-height:1; font-weight:bold; color:#003a70;}
			.pathways-tabs-container a {text-decoration:underline;}
			.pathways-outline-blue {-webkit-text-fill-color:white; -webkit-text-stroke-width:1.5px; -webkit-text-stroke-color:#003a70;}
			.pathways-container .accordion-section-title {background:#fff; color:#111;}
			.snippets-container {background-color:#fff; padding:50px 30px 50px 30px;}
			.snippets-container .programs-container {padding:0;}
			.snippets-container a {text-decoration:underline;}
			.content-center-text {text-align:center}
			
			@media (max-width:992px){
				.program-banner .banner-title-layout h1 {font-size:32px; padding-top:20px !important}
				.main-content {margin-top:-6px}
			}
			
			@media (min-width:699px){
				.hero-block .holder {height:410px; padding:20px 45px;}
			}
			
			@media (max-width:699px){
				.hero-block .holder {height:260px; padding:20px 30px;}
				.hero-block h1 {font-size:40px}
				.hero-block .holder:after {display:inline-block}
				.pathways-container {padding:40px 30px 40px 30px;}
				.pathways-container h2 {font-size:38px;}
				.pathways-tabs-container h2 {font-size:38px;}
			}
		</style>
      		
      		<!-- Content Blocks with Images -->
      		
      <style>
			.content-block-top {background-color:#eee; border-top-left-radius:60px;}
			
			.content-block-video {width:100%; display:flex; flex-wrap:wrap; align-items:center; margin-top:8px;}
			.content-block-video-iframe, .content-block-video-text {width:50%}
			.content-block-video-iframe .pathways-video {width:100%; aspect-ratio:16 / 9; border:none; border-radius:8px;}
			.content-block-video > div:nth-child(odd) {padding-right:15px;}
			.content-block-video > div:nth-child(even) {padding-left:15px;}
			.content-block-video #blue-button-snippet {margin-bottom:5px;}
			
			.content-block-1 {width:100%; display:flex; flex-wrap:wrap; align-items:center; margin-top:12px;}
			.content-block-1-text, .content-block-1-img {width:50%}
			.content-block-1-img img {width:100%; height:auto; border-radius:8px;}
			.content-block-1 > div:nth-child(odd) {padding-right:15px;}
			.content-block-1 > div:nth-child(even) {padding-left:15px;}
			.content-block-1 #blue-button-snippet {margin-bottom:5px;}
			
			.content-block-2 {width:100%; display:flex; flex-wrap:wrap; align-items:center; margin-top:15px;}
			.content-block-2-text, .content-block-2-img {width:50%}
			.content-block-2-img img {width:100%; height:auto; border-radius:8px;}
			.content-block-2 > div:nth-child(odd) {padding-right:15px;}
			.content-block-2 > div:nth-child(even) {padding-left:15px;}
			.content-block-2 #blue-button-snippet {margin-bottom:5px;}
			
			@media (max-width:699px){
				.content-block-video-iframe {order:1}
				.content-block-video-text {order:2; padding-top:45px;}
				.content-block-video-iframe, .content-block-video-text {width:100%}
				.content-block-video > div:nth-child(odd) {padding-right:0px}
				.content-block-video > div:nth-child(even) {padding-left:0px}
				.content-block-video #blue-button-snippet {margin-bottom:0px}
			
				.content-block-1-img {order:1}
				.content-block-1-text {order:2; padding-top:10px;}
				.content-block-1 > div:nth-child(odd) {padding-right:0px;}
				.content-block-1 > div:nth-child(even) {padding-left:0px;}
				.content-block-1-text, .content-block-1-img {width:100%}
			
				.content-block-2-img {order:1}
				.content-block-2-text {order:2; padding-top:10px;}
				.content-block-2 > div:nth-child(odd) {padding-right:0px;}
				.content-block-2 > div:nth-child(even) {padding-left:0px;}
				.content-block-2-text, .content-block-2-img {width:100%}
			}
		</style>
      		
      		<!-- Content Squares and CTAs -->
      		
      <style>
			.content-cards-3 {width:100%; display:flex; flex-wrap:wrap; justify-content:space-between;}
			.content-cards-3-cta {width:32%; border:1px solid #777; margin-top:15px;}
			.content-cards-3-cta div {text-decoration:none; color:#333; padding:15px}
			.content-cards-3-cta:hover {text-decoration:none; cursor:pointer;}

			.content-cards-3-w {transition:0.1s linear;}
			.content-cards-3-w:hover {background-color:#003a70;}
			.content-cards-3-w:hover div {color:#fff;}
			
			@media (max-width:699px){
