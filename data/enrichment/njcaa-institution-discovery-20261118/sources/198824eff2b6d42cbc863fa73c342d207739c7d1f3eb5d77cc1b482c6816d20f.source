<section id="pathways" style="margin-top:50px;margin-bottom:130px">
    <style>
    .path-grid {
    max-width:1500px;    
    margin:auto;
    
    }
    .pathway0 {
    height: 184px;
    background-size: cover;
    background-position: center;
    margin-bottom: 2%;
    }
    .pathtext {
        width:100%;
      /*  height:355px;*/
        position:relative;
    }
       @media (max-width:768px) {
          .pathway0 {
              height:130px!important;
          } 
       }
    @media (max-width:990px) {
    #pathways .headline {
    margin-left:0px!important;
   
    display:block!important;
    }
    #pathways .blurb {
     margin-left:0px!important;

     display:block!important;
    }
     .pathtext {
         font-size:75%;
         margin-left:1em;
     }
    
    }
    
    #pathways .headline {
        font-size: 3.5em;
        color: #002265;
      
        margin-top: 30px;
        display: inline-block;
       width:100%;
       text-align:center;
    }
    #pathways .blurb {
        display: inline-block;
        margin-top: 30px;
  
        margin-bottom:40px;
        line-height: 1.5;
        font-size:1.7em;
        width:100%;
       text-align:center;
    }
    #pathways .link {
        position: absolute;
        top: 5%;
        left: 1%;
        text-decoration:none;
        color:white;
        font-size:1.3rem;
        font-weight:bold;
        background-color: #333;
        padding: 0px 5px 0px 5px;
    }
    #pathways .link a {
        text-decoration:none;
        color:white;
        font-size:1.3rem;
        font-weight:bold;
    }
    .pathway0::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(45, 45, 45, 0.53); /* hsla(0, 0%, 18%, 0.55) */
    transition:all .5s;
    }
    
    .arts {
    border-left:#f8a326 10px solid;     /*hsl(36, 94%, 56%)*/
    transition:all .5s;
    }
    .arts.pathway0:hover:before, a:focus .arts.pathway0:before {
   /* background-color:#a2691782;  */   /* 	hsl(35, 75%, 36%) */
    background-color:hsla(36, 50%, 30%, .55);
    transition:all .5s;
    }
    .business {
    border-left:#8b3c73 10px solid;   /* hsl(318, 40%, 39%) */
    transition:all .5s;
    }
    .business.pathway0:hover:before, a:focus .business.pathway0:before {
    /*background-color:#5b254ba6; */    /* hsl(318, 42%, 25%) */
    background-color:hsla(318, 50%, 30%, .55);
    transition:all .5s;    
    }
    .industrial {
    border-left:#464155 10px solid;       /* hsl(255, 13%, 29%) */
    }
    .industrial.pathway0:hover:before, a:focus .industrial.pathway0:before {
       /* background-color:#2D2D2DBF;  */  /* hsl(0, 0%, 18%) */
    background-color:hsla(255, 50%, 30%, .55);
    transition:all .5s;  
    }
    .health {
    border-left:#df463e 10px solid;    /* hsl(3, 72%, 56%) */
    }
    .health.pathway0:hover:before, a:focus .health.pathway0:before {
    transition:all .5s;
    background-color:hsla(3, 50%, 30%, .55);
        
    }
    .public {
    border-left:#91d6e5 10px solid;    /* hsl(191, 62%, 73%) */
    }
    .public.pathway0:hover:before, a:focus .public.pathway0:before {
    background-color:hsla(191, 50%, 30%, .55);
    transition:all .5s;
    }
    .science {
    border-left:#008244 10px solid;     /* hsl(151, 100%, 25%) */
    }
    .science.pathway0:hover:before, a:focus .science.pathway0:before {
        background-color:hsla(151, 50%, 30%, .55);
        transition:all .5s;
    }
    .pathway0:hover .link , a:focus .pathway0 .link {
        text-decoration:underline!important;
    }
    
    
    </style>
