<meta name="tec-api-version" content="v1"><meta name="tec-api-origin" content="https://snead.edu"><link rel="alternate" href="https://snead.edu/wp-json/tribe/events/v1/" /><style>.recentcomments a{display:inline !important;padding:0 !important;margin:0 !important;}</style><script>document.addEventListener('DOMContentLoaded', function () {

  // Fix 1: Hide decorative icon elements from assistive technologies.
  document.querySelectorAll('.ewd-ufaq-post-margin-symbol').forEach(function (icon) {
    icon.setAttribute('aria-hidden', 'true');
  });

  // Fix 2: Move aria-expanded to the <a role="button"> and derive its value
  // from the panel's class rather than the div's aria-expanded attribute.
  document.querySelectorAll('.ewd-ufaq-faq-title').forEach(function (titleDiv) {
    const button = titleDiv.querySelector('a[role="button"]');
    const panel = titleDiv.nextElementSibling;
    if (!button || !panel) return;

    const isExpanded = !panel.classList.contains('ewd-ufaq-hidden');
    button.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');

    const observer = new MutationObserver(function () {
      const expanded = !panel.classList.contains('ewd-ufaq-hidden');
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });

    observer.observe(panel, {
      attributes: true,
      attributeFilter: ['class']
    });
  });

  // Fix 3: Correct the heading level inside .ewd-ufaq-faq-category-title
  // from H4 to H3 to reflect the correct document outline.
  document.querySelectorAll('.ewd-ufaq-faq-category-title h4').forEach(function (h4) {
    const h3 = document.createElement('h3');

    // Copy all attributes from the H4 to the H3.
    Array.from(h4.attributes).forEach(function (attr) {
      h3.setAttribute(attr.name, attr.value);
    });

    h3.innerHTML = h4.innerHTML;
    h4.parentNode.replaceChild(h3, h4);
  });

});</script><link rel="icon" href="https://snead.edu/wp-content/uploads/2020/07/cropped-icon-2.png" sizes="32x32" />
