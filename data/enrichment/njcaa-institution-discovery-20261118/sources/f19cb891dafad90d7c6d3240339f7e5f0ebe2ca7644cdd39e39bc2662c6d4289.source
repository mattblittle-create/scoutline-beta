      <h2>Student Panel</h2>
      <div class="container">
                    <ul>
                                              <li><span class="far fa-compass" aria-hidden="true"></span> <a target="_self" href="https://snead.edu/mysnead/">mySnead (use @alabama.edu credential to log in)</a></li>
                                              <li><span class="far fa-calendar" aria-hidden="true"></span> <a target="_self" href="https://snead.edu/wp-content/uploads/2026/03/2026-2027-Academic-Calendar.pdf">Academic Calendar 2026-2027</a></li>
