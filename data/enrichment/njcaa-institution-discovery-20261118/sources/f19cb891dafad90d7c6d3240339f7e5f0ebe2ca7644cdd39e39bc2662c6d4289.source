<style id="wp-custom-css">
.hthb-notification.hthb-pos--left-wall, .hthb-notification.hthb-pos--right-wall {
	top: auto !important;
	transform: none !important;
	-webkit-transform: none !important;
}

body.blog div.abtitle-content {
	padding-left: 10px;
}
body.blog div.abtitle-content h1 {
	font-size: 2.5em;
	font-weight: 800;
}

a.skip-to-content {
	position: absolute;
	top: 0;
	left: 0;
	transform: translateY(-120%);
	background: #000;
	color: #fff;
	padding: 12px 18px;
	z-index: 999999;
	text-decoration: none;
}

.skip-to-content:focus,
.skip-to-content:focus-visible {
	transform: translateY(0);
	outline: 3px solid #fff;
}

.opener,
.contacter {
	display: block !important;
	visibility: visible !important;
	opacity: 1 !important;
	/* position: fixed !important;
	z-index: 999999 !important; */
	pointer-events: auto !important;
}

.opener:focus,
.contacter:focus {
	outline: 3px solid #fff !important;
	outline-offset: 4px !important;
	box-shadow: 0 0 0 4px #000 !important;
}

.contacter, .opener {
	max-height: 40px;
}

.contacter *, .opener * {
	max-height: 20px;
}

footer .widget h2 {
	color:white;
}

li.gfield fieldset {
	padding-top: 0px !important;
}

li.gfield fieldset legend {
	margin-bottom: 0px;
}

li.gfield fieldset div.ginput_container {
	margin-top: 0px !important;
}

#sscc-header > #header > .navbar-header {
	float: right;
	right: 0;
	width: 20%;
}

div#sidebar a {
	font-size: 1.5rem;
}

#primary-menu > li > a:hover {
	color: #151515;
}

span.decorative-slash {
  color: #e9a511;
}

button.navbar-toggle:focus {
    outline: revert;
}

#mobile-menu > li > a:hover, #mobile-menu > li > a:focus
{
	color: #333;
}

#mobile-menu > li > a:hover > svg, #mobile-menu > li > a:focus > svg
{
	fill: #333;
}

body.home #mobile-menu > li > a:hover, body.home #mobile-menu > li > a:focus
{
	color: #fff;
}

body.home #mobile-menu > li > a:hover > svg, body.home #mobile-menu > li > a:focus > svg
{
	fill: #fff;
}

.contacter .contacter-btn {
  color: rgba(0, 0, 0, 0.62);	
}

.contact-panel li + li,
.student-panel li + li {
	padding-top: 4px; 
}

.charleft.ginput_counter.gfield_description, table > caption {
	color: #333;
}

.table-container {
  overflow-x: auto;
  display: block;
  max-width: 100%;
}

.table-container > table {
	text-align: right;
}

.table-container > table th,
.table-container > table td {
	padding: 4px 8px !important;
	background-color: white;
}
</style>

