  // Inject a rule to suppress ::before on headings we've already handled
  const style = document.createElement('style');
  style.textContent = '.slash-injected::before { content: none !important; }';
  document.head.appendChild(style);

  const headings = document.querySelectorAll('h1, h2');

  headings.forEach(heading => {
    const before = window.getComputedStyle(heading, '::before');
    const content = before.getPropertyValue('content');

    // content is a CSS string value — normalize it for comparison
    // Browsers return it quoted, e.g. '"/ "' or '"/"'
    if (!content || content === 'none' || content === 'normal') return;
    if (!content.includes('/')) return;

    const slash = document.createElement('span');
    slash.className = 'decorative-slash';
    slash.setAttribute('aria-hidden', 'true');
    slash.textContent = '/ ';

    heading.insertBefore(slash, heading.firstChild);
    heading.classList.add('slash-injected');
  });
});</script><script id="tec-user-agent-js" src="https://snead.edu/wp-content/plugins/the-events-calendar/common/build/js/user-agent.js?ver=da75d0bdea6dde3898df"></script>
