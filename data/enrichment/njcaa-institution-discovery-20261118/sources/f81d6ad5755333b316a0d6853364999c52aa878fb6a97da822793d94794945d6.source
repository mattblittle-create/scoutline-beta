function lcw() {
    return {
        // Closing message buttons and message
        confirmationPaneProps: {
            controlProps: {
                titleText: "End this conversation?",
                subtitleText: "Clicking 'Close' will end your chat session. You can download a transcript using the download icon below the chat box.",
                confirmButtonText: "Close",
                cancelButtonText: "Continue"
            }
        },
        // Show just bubble widget without messages
			chatButtonProps: {
				controlProps: {
					hideChatTextContainer: true
				},
				styleProps: {
					generalStyleProps: {
						minWidth: "60px",
						width: "60px",
						height: "60px",
						borderStyle: "unset",
						borderWidth: "unset",
						selectors: {
							":hover" : {
								backgroundColor: "#c8102e"
							},
							":focus" : {
								outline: "solid 3px #c8102e"
							}
						},
					},
					iconStyleProps: {
						backgroundSize: "cover",
						borderColor: "unset",
						borderRadius: "unset",
						borderStyle: "unset",
						borderWidth: "unset",
						backgroundColor:"unset",
						margin: "unset",
					}
				}
			},
        // Loading screen message modification
        loadingPaneProps: {
            controlProps: {
                titleText: "Connecting you to Monty Chat...",
                subtitleText: "Please wait"
            }
        },
        // Show vertical buttons for questions
        webChatContainerProps: {
            webChatStyles: {
                suggestedActionLayout: "stacked",
                suggestedActionHeight: 30,
            }
        },
        // Header Title Size
        headerProps: {
            styleProps: {
                generalStyleProps: {
                    height: "45px",
                    minHeight: "45px"
                }
            }
        }
    };
}
</script>
