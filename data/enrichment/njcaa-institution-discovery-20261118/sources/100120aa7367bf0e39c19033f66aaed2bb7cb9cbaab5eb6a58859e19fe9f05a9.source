  <div class="story-hlight paragraph">
    
      <div class="story-hlight__sm-main-intro">
                  <h2 class="story-hlight__heading paragraph__header colored-heading">
            <p><strong>Make</strong> Your <em>Mark</em></p>
          </h2>
        
                  <div class="story-hlight__intro paragraph__intro">
            <p>Learn from industry-experienced faculty and gain hands-on experience in labs, workforce programs, and career-focused courses.</p>
          </div>
              </div>

      <div class="story-hlight__container">
        <div class="story-hlight__toggle-cards">
          <div class="story-hlight__toggle-cards-inner">
                          <div class="story-hlight__toggle-card">
                <div class="story-hlight__toggle-card-inner">
                                      <div class="story-hlight__image">
                      <img alt="" title="" src="/sites/default/files/styles/story_highlights/public/uploads/images/2025-07/homepage_jorgo_story.jpg?h=cac311d4&amp;itok=LVmomnaU" width="850" height="525" loading="lazy" class="image-style-story-highlights" />


                    </div>
                                    <div class="story-hlight__toggle-btn-wrapper">
                    <div class="story-hlight__toggle-btn-inner">
                      <button class="story-hlight__toggle-btn" aria-expanded="false">
                        <span class="visually-hidden"> Open Story: Jorgo Gushi Class of 2022 From Student to Director </span>
                      </button>
                    </div>
                  </div>
                  <div class="story-hlight__card-content">
                                          <h3 class="story-hlight__name">Jorgo Gushi</h3>
                                                              <div class="story-hlight__subtitle">
                        <span>Class of 2022</span>
                      </div>
                                                              <div class="story-hlight__story-title">
                        From Student to Director
                      </div>
                                      </div>
                </div>
              </div>
                          <div class="story-hlight__toggle-card">
                <div class="story-hlight__toggle-card-inner">
