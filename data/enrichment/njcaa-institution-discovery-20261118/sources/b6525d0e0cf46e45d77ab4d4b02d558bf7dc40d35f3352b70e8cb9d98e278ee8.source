<style id="wp-custom-css">
/* STANDARD COLOR VARIABLES */

:root {
	--connors-orange: #CB6015;
	--connors-gray: #898D8D;
	--light-gray: #f0f0f0;
}

/* END COLORS */

.main-feature {
	height: 90vh;
}

#metaslider-id-3172 {
	height: 100%;
}

.caption-wrap {
	height: 20vh;
}

.caption {
	height: 90vh;
	padding: 0 !important;
	margin: 0 !important;
}

.jumbotron-caption .btn {
	margin: .5vw;
	text-decoration: none !important;
	background-color: #ff6900;
	font-size: max(1.5vw, 20px);
	border-radius: 5px;
	box-shadow: 1px 1px 5px #333;
}

.jumbotron-caption .btn:hover {
	transform: scale(0.95);
	color: #ccc;
}

.jumbotron-caption {
	margin-top: 0 !important;
	padding-top: 0 !important;
}

.jumbotron-caption h1 {
	margin-top: 20vh !important;
}

@media (max-width: 767px) {
	.caption-wrap .caption {
		padding: 0 !important;
	}
	.main-feature {
		height: 70vh;
		margin-top: 5vh;
	}
	.main-feature p {
		margin: 0;
		padding: 0;
	}
	#metaslider-id-3172 {
		height: 100%;
	}
	.slider-3172 {
		height: 70vh !important;
		overflow-x: hidden;
	}
	.jumbotron-caption {
		margin-top: 5vh !important;
	}
	.jumbotron-caption .btn {
		width: 80vw;
	}
	.jumbotron-caption h1 {
	margin-top: 10vh !important;
}
}

