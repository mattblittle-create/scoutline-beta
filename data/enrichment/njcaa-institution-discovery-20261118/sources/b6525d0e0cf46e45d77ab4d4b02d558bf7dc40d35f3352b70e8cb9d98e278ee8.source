	background-image: url("https://connorsstate.edu/wp-content/uploads/2023/11/PXL_20231115_211956764.jpg"), url("https://connorsstate.edu/wp-content/uploads/2023/11/PXL_20231115_212227954.jpg"), url("https://connorsstate.edu/wp-content/uploads/2023/11/PXL_20231115_212643026.jpg");
	background-color: rgb(203, 96, 21);
