}

.va-links-container {
	padding: 5vw;
}

/* Veteran Services page END */

/* Career Services page START */

.cs-nav {
	margin: 0 2vw;
	padding: 2vh 2vw !important;
	display: flex;
	flex-direction: column;
	gap: 2px;
}

.cs-nav li {
	list-style-type: none;
	border-bottom: 1px solid lightgray;
}

.cs-nav li:hover {
	background-color: #d5d5d5;
}

.cs-nav a {
	color: black;
	text-decoration: none !important;
}

.cs-nav a:hover {
	color: var(--connors-orange);
}

.cs-services {
	padding: 1vw;
}

.cs-services-list {
	gap: 0;
	padding: 0 2vw;
}

.cs-services-list-col ul {
	padding: 0;
	margin: 0;
}

.cs-accordion {
	color: white;
	width: 50% !important;
	padding-top: 0 !important;
	margin-top: 0 !important;
}

@media only screen and (max-width: 768px) {
	.cs-landing {
		padding-top: 5vh;
	}
}

/*Career Services page END */

/* Custom global CSS START */

/*BUTTONS*/
.wp-block-button__link {
	text-decoration: none !important;
	transition-duration: 0.4s;
}

.wp-block-button__link:hover {
	text-decoration: none !important;
	transform: scale(0.95);
}

/*ACCORDIONS*/
.accordion {
	width: 65%;
	margin: 3vh auto;
	padding: 1vw;
	font-size: max(15px, 1vw);
}

.accordion-summary {
	padding: 1rem;
	margin: .2rem;
	border-bottom: 1px solid lightgray;
	transition-duration: 0.2s;
	font-size: max(15px, 1.1vw);
	font-weight: lighter;
}

.accordion-summary:hover {
	color: var(--connors-orange);
	border-color: var(--connors-orange);
}

.accordion-summary-dark {
	padding: 1rem;
	margin: .2rem;
	background-color: rgba(255,255,255,0.4);
	border-radius: 15px;
	transition-duration: 0.3s;
}

.accordion-summary-dark:hover {
	outline: 1px solid white;
	background-color: rgba(0,0,0,0.20);
}

.accordion-content {
	font-size: max(12px, 1vw)
	font-weight: lighter;
  padding: 1rem;
	overflow: hidden;
}

@media only screen and (max-width: 768px) {
	.accordion {
		width: 100%;
		border: none;
		box-shadow: none;
	}
}

/*BACKGROUNDS*/
.black-background {
	background-color: black;
	color: white;
	position: relative;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.white-background {
	background-color: white;
	color: black;
	position: relative;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.orange-background {
	background-color: var(--connors-orange);
	position: relative;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.gray-background {
	background-color: rgb(137,141,141);
	color: white;
	position: relative;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.dark-gray-background {
	background-color: rgb(68,70,70);
	color: white;
	position: relative;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.light-gray-background {
	background-color: var(--light-gray);
	color: black;
	position: relative;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.image-background {
	position: relative;
	background-position: center center;
	background-size: cover;
	background-repeat: no-repeat;
	background-attachment: fixed;
	width: 100vw;
	left: calc(-50vw + 50%);
	padding: 2vw 20vw;
	margin: 0;
}

.wrapper {
	margin-bottom: 0;
	padding-bottom: 0;
}

.orange-separator {
	margin: 2vh 0;
	width: 20%;
	background-color: var(--connors-orange);
	height: 6px;
	border: none;
	border-radius: 5px;
}

/* no bottom margin */
.no-bottom-margin {
    margin-bottom: 0;
}

/* black border */
.black-border {
	border: 1px solid black;
}

/* This fixes the margins of a group when using the empty page template */
.fix-margin {
	padding: 5vh 10vw;
	margin: 0;
}

.wp-block-columns {
	margin: 0;
}

.wp-block-image {
	margin: 0;
}

/* Custom global CSS END */
</style>
</head>

