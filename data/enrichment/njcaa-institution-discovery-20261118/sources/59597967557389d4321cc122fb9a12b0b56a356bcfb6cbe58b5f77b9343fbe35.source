<script>

	document.querySelectorAll('#main p').forEach(p => {
		// skip if it contains any element children
		if (p.querySelector('*')) return;

		const raw = p.textContent || '';

		// remove regular whitespace (space, tab, newline, etc.)
		const withoutNormalWS = raw.replace(/[ \t\n\r\f\v]+/g, '');

		// if nothing remains after removing normal whitespace => p is empty (only normal whitespace)
		if (withoutNormalWS === '') {
			p.classList.add('is-empty');
			return;
		}

		// if the content is only NBSP characters, treat as non-empty (do nothing)
		if (/^[\u00A0]+$/.test(raw)) return;

		// otherwise there is visible content — do nothing
	});

</script>

