			}

			var $ = window.jQuery;
			var $carousel = $("#indexCarousel");
			if (!$carousel.length) {
			return true;
			}

			if ($carousel.hasClass("slick-initialized")) {
			return true;
			}

			var $root = $carousel.closest(".index-carousel");
			var $prev = $root.find(".carousel-control-prev");
			var $next = $root.find(".carousel-control-next");
			var $pause = $root.find(".carousel-control-pause");
			var reduceMotionQuery =
			typeof window.matchMedia === "function"
			? window.matchMedia(
			"(prefers-reduced-motion: reduce)",
			)
			: null;

			function setPauseState(isPaused) {
			$pause.toggleClass("is-paused", isPaused);
			$pause.attr(
			"aria-label",
			isPaused ? "Play Slider" : "Pause Slider",
			);
			}

			function setSlideAnchorsFocusable($anchors, isFocusable) {
			$anchors.each(function () {
			var $anchor = $(this);

			if (isFocusable) {
			if (
			$anchor.data("carouselPrevTabindexStored")
			) {
			var previousTabIndex = $anchor.data(
			"carouselPrevTabindex",
			);
			if (previousTabIndex === null) {
			$anchor.removeAttr("tabindex");
			} else {
			$anchor.attr(
			"tabindex",
			previousTabIndex,
			);
			}
			$anchor.removeData("carouselPrevTabindex");
			$anchor.removeData(
			"carouselPrevTabindexStored",
			);
			}
			return;
			}

			if (!$anchor.data("carouselPrevTabindexStored")) {
			var currentTabIndex = $anchor.attr("tabindex");
			$anchor.data(
			"carouselPrevTabindex",
			typeof currentTabIndex === "undefined"
			? null
			: currentTabIndex,
			);
			$anchor.data(
			"carouselPrevTabindexStored",
			true,
			);
			}
			$anchor.attr("tabindex", "-1");
			});
			}

			function syncHiddenSlideAnchors() {
			$carousel.find(".slick-slide").each(function () {
			var $slide = $(this);
			var isVisibleSlide =
			$slide.hasClass("slick-active") &&
			$slide.attr("aria-hidden") === "false";

			setSlideAnchorsFocusable(
			$slide.find("a"),
			isVisibleSlide,
			);
			});
			}

			function syncCarouselHeight() {
			if (!$root.length) {
			return;
			}

			// Let the root size naturally first, then lock it to the
			// tallest non-cloned slide so all slides fill the same space.
			$root.css("height", "auto");

			var tallestSlideHeight = 0;
			$carousel
			.find(".slick-slide")
			.not(".slick-cloned")
			.each(function () {
			var slideHeight = Math.ceil(
			this.scrollHeight || 0,
			);

			if (!slideHeight) {
			slideHeight = Math.ceil(
			$(this)
			.find(".hero-section__content")
			.first()
			.outerHeight(true) || 0,
			);
			}

			if (slideHeight > tallestSlideHeight) {
			tallestSlideHeight = slideHeight;
			}
			});

			var trackHeight = Math.ceil(
			$carousel.find(".slick-track").outerHeight() || 0,
			);
			var cssMinHeight = parseFloat(
			window
			.getComputedStyle($root.get(0))
			.getPropertyValue(
			"--index-carousel-min-height",
			),
			);
			var minHeight = Number.isFinite(cssMinHeight)
			? cssMinHeight
			: 0;
			var finalHeight = Math.max(
			tallestSlideHeight,
			trackHeight,
			minHeight,
			);

			if (finalHeight > 0) {
			$root.css("height", finalHeight + "px");
			}
			}

			$carousel.on(
			"init reInit afterChange setPosition",
			function () {
			syncHiddenSlideAnchors();
			syncCarouselHeight();
			},
			);

			$carousel.slick({
			dots: true,
			arrows: false,
			infinite: true,
			slidesToShow: 1,
			slidesToScroll: 1,
			rows: 0,
			autoplay: !(
			reduceMotionQuery && reduceMotionQuery.matches
			),
			autoplaySpeed: 5000,
			speed: 500,
			adaptiveHeight: false,
			pauseOnHover: false,
			pauseOnFocus: false,
			});

			$(window).on("resize orientationchange", function () {
			syncCarouselHeight();
			});

			$(window).on("load", function () {
			syncCarouselHeight();
			});

			if (reduceMotionQuery && reduceMotionQuery.matches) {
			$carousel.slick("slickPause");
			setPauseState(true);
			} else {
			setPauseState(false);
			}

			$prev.on("click", function () {
			$carousel.slick("slickPrev");
			});

			$next.on("click", function () {
			$carousel.slick("slickNext");
			});

			$pause.on("click", function () {
			var slick = $carousel.slick("getSlick");
			if (slick.paused) {
			$carousel.slick("slickPlay");
			setPauseState(false);
			} else {
			$carousel.slick("slickPause");
			setPauseState(true);
			}
			});

			if (reduceMotionQuery) {
			var onReducedMotionChange = function (event) {
			if (!event.matches) {
			return;
			}
			$carousel.slick("slickPause");
			setPauseState(true);
			};

			if (
			typeof reduceMotionQuery.addEventListener ===
			"function"
			) {
			reduceMotionQuery.addEventListener(
			"change",
			onReducedMotionChange,
			);
			} else if (
			typeof reduceMotionQuery.addListener === "function"
			) {
			reduceMotionQuery.addListener(
			onReducedMotionChange,
			);
			}
			}

			return true;
			}

			function waitForSlick(maxAttempts) {
			var attempts = 0;
			var timer = setInterval(function () {
			attempts += 1;
			if (initIndexCarousel() || attempts >= maxAttempts) {
			clearInterval(timer);
			}
			}, 100);
			}

			if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", function () {
			waitForSlick(200);
			});
			} else {
			waitForSlick(200);
			}
			})();
		</script> 
         
         
         	
