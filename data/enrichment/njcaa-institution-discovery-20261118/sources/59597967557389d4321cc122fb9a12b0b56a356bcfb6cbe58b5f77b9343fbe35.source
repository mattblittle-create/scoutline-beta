         <h1 class="sr-only">
            			SUNY Erie: A state university of New York Community College
            		</h1>
         <div class="hero home-hero index-carousel" aria-live="polite">
            <div id="indexCarousel" class="index-carousel-track">
               <div style="background-image: url('/_resources/images/components/_hero/882A4820-2.jpg');" class="carousel-item active">
                  <div class="content">
                     <div class="container container_big">
                        <div class="hero-section__content">
                           <h2 class="h1"><span data-ouc-test="Join Us At Our" class="hero-section__subhead wow fadeInDown start" data-wow-delay="0.3s" style="          visibility: visible;          animation-delay: 0.3s;          animation-name: fadeInDown;          ">
                                 						Join Us At Our
                                 					</span><span class="hero-section__headline wow fadeInUp" data-wow-delay="0.8s" style="          visibility: visible;          animation-delay: 0.8s;          animation-name: fadeInUp;          ">
                                 						Fall Open House
                                 					</span></h2>
                           <div class="hero-section__intro wow fadeIn" data-wow-delay="1.8s" style="        visibility: visible;        animation-delay: 1.8s;        animation-name: fadeIn;        ">
                              					
                              <p>
                                 						<span data-teams="true">Visit us on November 17, 18, and 19! Explore academic programs, tour our campuses,
                                    and learn about admissions, student resources, and the SUNY Reconnect tuition-free
                                    program.</span>
                                 					</p>
                              				</div>
                           <div class="ctas--buttons"><a data-ouc-test="https://www.ecc.edu/openhouse.html" href="https://www.ecc.edu/openhouse.html" class="cta cta--button bg--bright-red--gradient wow fadeIn" data-wow-delay="2.3s" style="          visibility: visible;          animation-delay: 2.3s;          animation-name: fadeIn;          ">
                                 						Register for Open House
                                 					</a></div>
                        </div>
                     </div>
                  </div>
               </div>
               <div style="background-image: url('/_resources/images/components/_hero/hero-reconnect.jpg');" class="carousel-item">
                  <div class="content">
                     <div class="container container_big">
                        <div class="hero-section__content">
                           <h2 class="h1"><span class="hero-section__headline wow fadeInUp" data-wow-delay="0.8s" style="          visibility: visible;          animation-delay: 0.8s;          animation-name: fadeInUp;          ">
                                 						Spring Registration is Now Open!
                                 					</span></h2>
                           <div class="hero-section__intro wow fadeIn" data-wow-delay="1.8s" style="        visibility: visible;        animation-delay: 1.8s;        animation-name: fadeIn;        ">
                              					
                              <p>
                                 						Registration for the Spring 2027 semester opened November 2nd! Register now
                                 to stay ahead and secure your perfect class schedule.
                                 					</p>
                              				</div>
                           <div class="ctas--buttons"><a data-ouc-test="https://wd5.myworkday.com/ecc/" href="https://wd5.myworkday.com/ecc/" class="cta cta--button bg--bright-red--gradient wow fadeIn" data-wow-delay="2.3s" style="          visibility: visible;          animation-delay: 2.3s;          animation-name: fadeIn;          ">
                                 						Register Today!
                                 					</a></div>
                        </div>
                     </div>
                  </div>
               </div>
               <div style="background-image: url('/_resources/images/components/_hero/Reconnect_Hero.jpg');" class="carousel-item">
                  <div class="content">
                     <div class="container container_big">
                        <div class="hero-section__content">
                           <h2 class="h1"><span class="hero-section__headline wow fadeInUp" data-wow-delay="0.8s" style="          visibility: visible;          animation-delay: 0.8s;          animation-name: fadeInUp;          ">
                                 						Build Your Future Tuition-Free!
                                 					</span></h2>
                           <div class="hero-section__intro wow fadeIn" data-wow-delay="1.8s" style="        visibility: visible;        animation-delay: 1.8s;        animation-name: fadeIn;        ">
                              					
                              <p>
                                 						<span>The SUNY Reconnect program provides free associate degrees in high-demand fields like
                                    advanced manufacturing, nursing and health professions, teaching &amp; more for New York
                                    State residents ages 25 to 55.</span>
                                 					</p>
                              				</div>
                           <div class="ctas--buttons"><a data-ouc-test="https://www.ecc.edu/admissions-and-aid/freeCC.html" href="https://www.ecc.edu/admissions-and-aid/freeCC.html" class="cta cta--button bg--bright-red--gradient wow fadeIn" data-wow-delay="2.3s" style="          visibility: visible;          animation-delay: 2.3s;          animation-name: fadeIn;          ">
                                 						See If You're Eligble
                                 					</a><a data-ouc-test="https://wd5-student.myworkdaysite.com/ecc/SUNYErie" href="https://wd5-student.myworkdaysite.com/ecc/SUNYErie" class="cta cta--button bg--bright-red--gradient wow fadeIn" data-wow-delay="2.3s" style="          visibility: visible;          animation-delay: 2.3s;          animation-name: fadeIn;          ">
                                 						Apply Today
                                 					</a></div>
                        </div>
                     </div>
                  </div>
               </div>
               <div style="background-image: url('/_resources/images/components/_callouts/citycampus.jpg');" class="carousel-item">
                  <div class="content">
                     <div class="container container_big">
                        <div class="hero-section__content">
                           <h2 class="h1"><span data-ouc-test="Start Here," class="hero-section__subhead wow fadeInDown start" data-wow-delay="0.3s" style="          visibility: visible;          animation-delay: 0.3s;          animation-name: fadeInDown;          ">
                                 						Start Here,
                                 					</span><span class="hero-section__headline wow fadeInUp" data-wow-delay="0.8s" style="          visibility: visible;          animation-delay: 0.8s;          animation-name: fadeInUp;          ">
                                 						Go Anywhere!
                                 					</span></h2>
                           <div class="hero-section__intro wow fadeIn" data-wow-delay="1.8s" style="        visibility: visible;        animation-delay: 1.8s;        animation-name: fadeIn;        ">
                              					
                              <p>
                                 						<span>Affordable, high-quality education that opens doors to your future—close to home,
                                    built for your dreams</span>
                                 					</p>
                              				</div>
                           <div class="ctas--buttons"><a data-ouc-test="https://www.ecc.edu/admissions-and-aid/how-to-apply.html" href="https://www.ecc.edu/admissions-and-aid/how-to-apply.html" class="cta cta--button bg--bright-red--gradient wow fadeIn" data-wow-delay="2.3s" style="          visibility: visible;          animation-delay: 2.3s;          animation-name: fadeIn;          ">
                                 						Learn How to Apply
                                 					</a><a data-ouc-test="https://wd5-student.myworkdaysite.com/ecc/SUNYErie" href="https://wd5-student.myworkdaysite.com/ecc/SUNYErie" class="cta cta--button bg--bright-red--gradient wow fadeIn" data-wow-delay="2.3s" style="          visibility: visible;          animation-delay: 2.3s;          animation-name: fadeIn;          ">
                                 						Apply Today
                                 					</a></div>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
            <div class="carousel-nav-buttons" aria-live="off"><button class="carousel-control-prev" type="button" aria-label="Previous Slide" tabindex="0"><span class="carousel-control-prev-icon" aria-hidden=""></span></button><button class="carousel-control-pause" type="button" tabindex="0" aria-label="Pause Slider"><span class="carousel-control-pause-icon" aria-hidden=""></span></button><button class="carousel-control-next" type="button" aria-label="Next Slide" tabindex="0"><span class="carousel-control-next-icon" aria-hidden=""></span></button></div>
         </div><script src="/_resources/js/slick.min.js"></script><script>
