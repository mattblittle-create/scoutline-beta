<script>
	(function () {
		// Only stub if testimonials are NOT present
		if (document.getElementById('testimonial-quote')) return;

		const wrapper = document.createElement('div');
		wrapper.style.display = 'none';
		wrapper.setAttribute('aria-hidden', 'true');

		wrapper.innerHTML = `
<div id="testimonial-quote">
<div class="testimonial-text"></div>
	</div>

<div id="testimonial-name"></div>


<div id="testimonial-image">
<img src="" alt="">
	</div>

<div id="testimonial-live" aria-live="polite"></div>
`;

		document.body.appendChild(wrapper);
	})();
</script>
