<style id="cindy-inline-css">
/* START CSS variables */
:root { 
--color_accent: #0038d3; --color_button_background: #0c234b; --color_button_hover_background: #000e2d; --color_site_title_background: #0c234b; --color_header_background: #0c234b; --color_navigation_background: #c5c5c5; --color_navigation_text: #0c234b; --color_navigation_border: rgba(12,35,75,var(--border_opacity)); --color_navigation_link: #0c234b; --color_intro_background: #212121; --color_content_text: #3f3f3f; --color_content_border: rgba(63,63,63,var(--border_opacity)); --color_sidebar_background: #0c234b; --color_sidebar_text: #c5c5c5; --color_sidebar_border: rgba(197,197,197,var(--border_opacity)); --color_footer_background: #0c234b; --color_footer_text: #ffffff; --color_footer_border: rgba(255,255,255,var(--border_opacity)); --color_footer_headings: #ffffff; --color_footer_link: #ffffff; --color_footer_1_background: #0c234b; --color_footer_1_background_secondary: #0c234b; --color_footer_1_text: #ffffff; --color_footer_1_border: rgba(255,255,255,var(--border_opacity)); --color_palette_1: #000000; --color_palette_2: #191919; --layout_width_entry_content: 950px; --typography_size_html: 14px; --typography_font_global: Roboto, sans-serif; --typography_font_headings: "Roboto Slab", sans-serif;
}
/* END CSS variables */
:root {--color_category_catalog: #0c234b;} 
.has-category-catalog-color,.has-category-255-color{color: var(--color_category_catalog);} .has-category-catalog-background-color,.has-category-255-background-color{background-color: var(--color_category_catalog);} .has-category-catalog-border-color,.has-category-255-border-color,.posts .category-catalog,.category-255 .page-header,.cat-item-255{border-color: var(--color_category_catalog);}
.sidebar .menu .category-255::before,.sidebar .menu .category-255 > a::before,.sidebar .widget_categories .cat-item-255::before,.sidebar .widget_categories .cat-item-255 > a::before{border-color: var(--color_category_catalog) !important;}
/*# sourceURL=cindy-inline-css */
</style>
