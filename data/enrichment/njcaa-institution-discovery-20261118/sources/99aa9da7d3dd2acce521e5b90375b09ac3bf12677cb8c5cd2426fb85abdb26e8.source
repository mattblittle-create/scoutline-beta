<style>
    #rattler-notification {
    background: #fff6be; 
    color: #000;
    font-size: 16px;
    position: top;    
    top: 0px;
    left: 0px;
    width: 100%;
    height: auto;
    display: block;
    padding: 10px 50px 10px 50px; 
    text-align: left;
    z-index: 9999;
}
#rattler-notification a {
    color: #000;    
    border-bottom: 1px dotted;
    text-decoration: none;
}

/* Parent Flex Container */
.flex-notification-container {
  display: flex;
  flex-direction: row;
  gap: 10px;
  padding: 0px 20px 0px 20px; 
}

/* Child Columns */
.left-notification-column {
  border-right: 2px solid #000000; 
  padding-right: 20px;
}
.right-notification-column {
  flex: 2; 
}

/* Tablet and Mobile Breakpoint */
@media screen and (max-width: 768px) {
  .flex-notification-container {
    flex-direction: column;
    text-align: center;
    gap: 0px;
  }


  .left-notification-column {
    display: none;
  }

  #rattler-notification {
    padding: 10px 10px;
  }
}

</style>

