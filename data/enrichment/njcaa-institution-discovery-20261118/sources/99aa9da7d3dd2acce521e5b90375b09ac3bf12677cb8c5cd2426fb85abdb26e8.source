<style id="my-calendar-reset-inline-css">

/* Styles by My Calendar - Joe Dolson https://www.joedolson.com/ */

.my-calendar-modal .event-title svg { background-color: #243f82; padding: 3px; }
.my-calendar-modal.mc_general #modal-title, .my-calendar-modal .mc_general .event-title, .my-calendar-modal.mc_general .mc-modal-title-container, .mc-main .mc_general .event-title, .mc-main .mc_general .event-title a { background: #243f82 !important; color: #ffffff !important; }
.mc-main .mc_general .event-title button { background: #243f82 !important; color: #ffffff !important; }
.my-calendar-modal span.mc_general, .mc-main span.mc_general { color: #243f82; }
.mc-main .mc_general .event-title a:hover, .mc-main .mc_general .event-title a:focus { background: #000c4f !important;}
.mc-main .mc_general .event-title button:hover, .mc-main .mc_general .event-title button:focus { background: #000c4f !important;}
.my-calendar-modal .event-title svg { background-color: #ffffff; padding: 3px; }
.my-calendar-modal.mc_public-events #modal-title, .my-calendar-modal .mc_public-events .event-title, .my-calendar-modal.mc_public-events .mc-modal-title-container, .mc-main .mc_public-events .event-title, .mc-main .mc_public-events .event-title a { background: #ffffff !important; color: #000000 !important; }
.mc-main .mc_public-events .event-title button { background: #ffffff !important; color: #000000 !important; }
.my-calendar-modal span.mc_public-events, .mc-main span.mc_public-events { color: #ffffff; }
.mc-main .mc_public-events .event-title a:hover, .mc-main .mc_public-events .event-title a:focus { background: #ffffff !important;}
.mc-main .mc_public-events .event-title button:hover, .mc-main .mc_public-events .event-title button:focus { background: #ffffff !important;}
.my-calendar-modal .event-title svg { background-color: #ffffff; padding: 3px; }
.my-calendar-modal.mc_meetings-and-conferences #modal-title, .my-calendar-modal .mc_meetings-and-conferences .event-title, .my-calendar-modal.mc_meetings-and-conferences .mc-modal-title-container, .mc-main .mc_meetings-and-conferences .event-title, .mc-main .mc_meetings-and-conferences .event-title a { background: #ffffff !important; color: #000000 !important; }
.mc-main .mc_meetings-and-conferences .event-title button { background: #ffffff !important; color: #000000 !important; }
.my-calendar-modal span.mc_meetings-and-conferences, .mc-main span.mc_meetings-and-conferences { color: #ffffff; }
.mc-main .mc_meetings-and-conferences .event-title a:hover, .mc-main .mc_meetings-and-conferences .event-title a:focus { background: #ffffff !important;}
.mc-main .mc_meetings-and-conferences .event-title button:hover, .mc-main .mc_meetings-and-conferences .event-title button:focus { background: #ffffff !important;}
.my-calendar-modal .event-title svg { background-color: #ffffff; padding: 3px; }
.my-calendar-modal.mc_student-activities-campus-life #modal-title, .my-calendar-modal .mc_student-activities-campus-life .event-title, .my-calendar-modal.mc_student-activities-campus-life .mc-modal-title-container, .mc-main .mc_student-activities-campus-life .event-title, .mc-main .mc_student-activities-campus-life .event-title a { background: #ffffff !important; color: #000000 !important; }
.mc-main .mc_student-activities-campus-life .event-title button { background: #ffffff !important; color: #000000 !important; }
.my-calendar-modal span.mc_student-activities-campus-life, .mc-main span.mc_student-activities-campus-life { color: #ffffff; }
.mc-main .mc_student-activities-campus-life .event-title a:hover, .mc-main .mc_student-activities-campus-life .event-title a:focus { background: #ffffff !important;}
.mc-main .mc_student-activities-campus-life .event-title button:hover, .mc-main .mc_student-activities-campus-life .event-title button:focus { background: #ffffff !important;}
.my-calendar-modal .event-title svg { background-color: #ffffff; padding: 3px; }
.my-calendar-modal.mc_academic-events #modal-title, .my-calendar-modal .mc_academic-events .event-title, .my-calendar-modal.mc_academic-events .mc-modal-title-container, .mc-main .mc_academic-events .event-title, .mc-main .mc_academic-events .event-title a { background: #ffffff !important; color: #000000 !important; }
.mc-main .mc_academic-events .event-title button { background: #ffffff !important; color: #000000 !important; }
.my-calendar-modal span.mc_academic-events, .mc-main span.mc_academic-events { color: #ffffff; }
.mc-main .mc_academic-events .event-title a:hover, .mc-main .mc_academic-events .event-title a:focus { background: #ffffff !important;}
.mc-main .mc_academic-events .event-title button:hover, .mc-main .mc_academic-events .event-title button:focus { background: #ffffff !important;}
.mc-main, .mc-event, .my-calendar-modal, .my-calendar-modal-overlay, .mc-event-list {--close-button: #b32d2e; --search-highlight-bg: #f5e6ab; --navbar-background: transparent; --nav-button-bg: #fff; --nav-button-color: #313233; --nav-button-border: #313233; --nav-input-border: #313233; --nav-input-background: #fff; --nav-input-color: #313233; --grid-cell-border: #0000001f; --grid-header-border: #313233; --grid-header-color: #313233; --grid-weekend-color: #313233; --grid-header-bg: transparent; --grid-weekend-bg: transparent; --grid-cell-background: transparent; --current-day-border: #313233; --current-day-color: #313233; --current-day-bg: transparent; --date-has-events-bg: #313233; --date-has-events-color: #f6f7f7; --primary-dark: #313233; --primary-light: #f6f7f7; --secondary-light: #fff; --secondary-dark: #000; --highlight-dark: #646970; --highlight-light: #f0f0f1; --calendar-heading: clamp( 1.125rem, 24px, 2.5rem ); --event-title: clamp( 1.25rem, 24px, 2.5rem ); --grid-date: 16px; --grid-date-heading: clamp( .75rem, 16px, 1.5rem ); --modal-title: 1.5rem; --navigation-controls: clamp( .75rem, 16px, 1.5rem ); --card-heading: 1.125rem; --list-date: 1.25rem; --author-card: clamp( .75rem, 14px, 1.5rem); --single-event-title: clamp( 1.25rem, 24px, 2.5rem ); --mini-time-text: clamp( .75rem, 14px 1.25rem ); --list-event-date: 1.25rem; --list-event-title: 1.2rem; --grid-max-width: 1260px; --main-margin: 0 auto; --list-preset-border-color: #000000; --list-preset-stripe-background: rgba( 0,0,0,.04 ); --list-preset-date-badge-background: #000; --list-preset-date-badge-color: #fff; --list-preset-background: transparent; --color_button_hover_background: #e5e5e5; --main-background: transparent; --main-color: inherit; --category-mc_general: #243f82; --category-mc_public-events: #ffffff; --category-mc_meetings-and-conferences: #ffffff; --category-mc_student-activities-campus-life: #ffffff; --category-mc_academic-events: #ffffff; }
