      <style>
			/* Custom caption styling */

			#mainContent .carousel-caption {
			background-color: rgba(0, 0, 0, 0.6);
			padding: 1rem;
			margin-bottom: 0.5rem;
			position: absolute;
			z-index: 0;
			}

			#mainContent .carousel-caption h1, 
			#mainContent .carousel-caption .h1, 
			#mainContent .carousel-caption a {
			font-size: 2.4rem;
			color: #fff;
			margin-bottom: 0.4rem;
			text-decoration: none;
			font-family: 'UniversLTStd-Bold', sans-serif;
			}
			#mainContent .carousel-caption h1 a:focus, 
			#mainContent .carousel-caption h1 a:hover,
			#mainContent .carousel-caption .h1 a:focus, 
			#mainContent .carousel-caption .h1 a:hover {
			text-decoration: underline;
			}

			#mainContent .carousel-caption p {
			font-size: 0.94rem;
			color: #fff;
			}
			.carousel-control-next, 
			.carousel-control-prev {
			width: 10%
			}
			.carousel-control-next-icon, 
			.carousel-control-prev-icon {
			width: 3rem;
			height: 3rem;
			}

			/* Adjust text size on smaller screens */
			@media (max-width: 767px) {
			#mainContent .carousel-caption {
			padding: 0.75rem;
			bottom: 0;
			left: 0;
			margin-bottom: 0;
			width: 100%;
			}

			#mainContent .carousel-caption h1, 
			#mainContent .carousel-caption .h1, 
			#mainContent .carousel-caption a {
			font-size: 1.25rem;
			margin-bottom: 0.3rem;
			}

			#mainContent .carousel-caption p {
			font-size: 0.8rem;
			}
			}



			/* Carousel Image cover sizing */
			.carousel-item, .carousel-inner {
			height: 500px; /* Default height */
			}
			.carousel-inner {
			background-color: #232B2D;
			}

			.carousel-item img {
			height: 100%;
			width: 100%;
			object-fit: cover;
			object-position: center;
			}

			/* Large screens */
			.carousel-item, .carousel-inner
			{
			height: 550px;
			}

			/* Medium screens */
			@media (max-width: 991px) {
			.carousel-item, .carousel-inner {
			height: 500px;
			}
			#mainContent .carousel-caption h1, 
			#mainContent .carousel-caption .h1, 
			#mainContent .carousel-caption a {
			font-size: 1.2rem;
			text-align: center;
			}
			#mainContent .carousel-caption p {
			font-size: 0.8rem;
			}
			}

			/* Small screens */
			@media (max-width: 768px) {
			.carousel-item, .carousel-inner {
			height: 400px;
			}
			}

			/* Extra small screens */
			@media (max-width: 576px) {
			.carousel-item, .carousel-inner {
			height: 300px;
			}
			}

		</style>
      
      		
      <style>
			.carousel-pause-btn {
			position: absolute;
			bottom: 1rem;
			top: unset;
			right: 1rem;
			z-index: 20;
			background-color: rgba(0, 0, 0, 0.6);
			border: solid 2px #ffffff;
			border-radius: 6px;
			color: #ffffff;
			padding: 0.5rem 0.75rem;
			font-size: .9rem;
			cursor: pointer;
			transition: background-color 0.3s ease;
			line-height: 1.2;
			width: 50px;
			}

			/* Improve contrast on hover/focus */
			.carousel-pause-btn:hover,
			.carousel-pause-btn:focus {
			background-color: #ffffff;
			color: #000000;
			}

			/* Ensure button is readable and doesn't get cut off on small screens */
			@media (max-width: 767px) {
			.carousel-pause-btn {
			font-size: 0.75rem;
			padding: 0.5rem 0.7rem;
			bottom: unset;
			top: 0.32rem;
			right: 0.3rem;
			width: 40px;
			border: solid 1px #ffffff;
			}
			}

		</style>
      
      		
      <style>
			/* Card Block over-ride for full width implementation */
			@media (min-width: 1001px) {
			
			.classic-image-block {
			height: 300px;
			}
			.classic-image-block a, .classic-image-block h3 {
			font-size: 40px;
			}
			
			}
		</style>
      
      
      
