      		<script xmlns:ouc="http://omniupdate.com/XSL/Variables">

			var revSlider;
			function pause_slider(){
			console.log("pause slider");
			revSlider.revpause();
			document.getElementById('slider_play_pause').setAttribute("class", "bi bi-play-btn")
			document.getElementById('slider_play_pause').setAttribute("aria-label", "play button")
			document.getElementById('slider_play_pause').setAttribute("onclick", "play_slider()");
			}

			function play_slider(){
			console.log("play slider");
			revSlider.revresume();
			document.getElementById('slider_play_pause').setAttribute("class", "bi bi-pause-btn")
			document.getElementById('slider_play_pause').setAttribute("aria-label", "pause button")
			document.getElementById('slider_play_pause').setAttribute("onclick", "pause_slider()");
			}


		</script>
      		
      		
