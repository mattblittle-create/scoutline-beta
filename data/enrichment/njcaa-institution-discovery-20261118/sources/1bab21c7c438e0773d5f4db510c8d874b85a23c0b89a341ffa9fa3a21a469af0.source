<style>
/* ================================
   NWFSC Footer - Compact Clean
================================ */

.black-footer {
  background: #000;
  color: #fff;
  padding: 18px 20px 32px;
  text-align: center;
}

.black-footer footer.center {
  max-width: 1200px;
  margin: 0 auto;
}

/* Logo */
.black-footer .footer-logo {
  margin: 0 auto 8px;
  text-align: center;
}

.black-footer .footer-logo img {
  max-width: 330px;
  width: 90%;
  height: auto;
  display: inline-block;
}

/* Address */
.black-footer .footer-contact {
  display: block;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  margin: 0 0 10px;
}

/* Operating Hours */
.black-footer .footer-hours {
  margin: 0 0 20px;
}

.black-footer .footer-hours a {
  color: #fff !important;
  font-size: 17px;
  font-weight: 600;
  text-decoration: none;
}

.black-footer .footer-hours a:hover,
.black-footer .footer-hours a:focus {
  text-decoration: underline;
  text-underline-offset: 5px;
}

/* Social Icons */
.black-footer .social {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
  margin: 0 0 20px;
}

.black-footer .social a {
  color: #fff !important;
  text-decoration: none;
  line-height: 1;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.black-footer .social a:hover,
.black-footer .social a:focus {
  opacity: 0.75;
  transform: translateY(-2px);
}

/* Footer Navigation */
.black-footer .links-container {
  max-width: 900px;
  margin: 0 auto 18px;
}

.black-footer .footer-row {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px 20px;
  margin-bottom: 5px;
}

.black-footer .footer-row a {
  color: #fff !important;
  display: inline-block;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.25;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.black-footer .footer-row a:hover,
.black-footer .footer-row a:focus {
  color: #fff !important;
  text-decoration: underline;
  text-underline-offset: 5px;
  opacity: 0.85;
}

/* Non-discrimination Statement */
.black-footer #nondiscrim-statement {
  max-width: 1100px;
  margin: 18px auto 0;
  padding-top: 16px;
  border-top: 1px solid rgba(255,255,255,0.25);
  color: #ede8e8;
}

.black-footer #nondiscrim-statement p {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0;
  color: #ede8e8 !important;
  font-size: 11.5px;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
}

/* Important: do NOT use white-space: nowrap here */
.black-footer #nondiscrim-statement a {
  color: #fff !important;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4px;
  white-space: normal;
  display: inline;
  margin: 0;
  padding: 0;
}

.black-footer #nondiscrim-statement a:hover,
.black-footer #nondiscrim-statement a:focus {
  opacity: 0.85;
}

/* Keyboard Accessibility */
.black-footer a:focus {
  outline: 2px solid #fff;
  outline-offset: 4px;
}

/* Screen Reader Hidden Text */
.black-footer .visuallyhidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

/* Mobile Footer */
@media only screen and (max-width: 768px) {
  .black-footer {
    padding: 22px 16px 72px;
  }

  .black-footer .footer-logo img {
    max-width: 285px;
  }

  .black-footer .footer-contact {
    font-size: 13px;
    margin-bottom: 9px;
  }

  .black-footer .footer-hours {
    margin-bottom: 18px;
  }

  .black-footer .footer-hours a {
    font-size: 16px;
    font-weight: 600;
  }

  .black-footer .social {
    gap: 18px;
    margin-bottom: 18px;
  }

  .black-footer .links-container {
    margin-bottom: 16px;
  }

  .black-footer .footer-row {
    flex-direction: column;
    gap: 5px;
    margin-bottom: 5px;
  }

  .black-footer .footer-row a {
    font-size: 15px;
    font-weight: 400;
  }

  .black-footer #nondiscrim-statement {
    margin-top: 16px;
    padding-top: 14px;
  }

  .black-footer #nondiscrim-statement p {
    font-size: 11px;
    line-height: 1.45;
  }
}
</style>

<!-- footer -->
<div class="black-footer">
  <footer class="center">

    <div id="logo-footer" class="footer-logo">
      <a href="https://www.nwfsc.edu/" aria-label="Northwest Florida State College Home">
        <img 
          src="https://www.nwfsc.edu/wp-content/uploads/2023/03/NWFSC-White_logo-final.png" 
          alt="Northwest Florida State College Logo" 
          title="Northwest Florida State College"
        />
      </a>
    </div>

    <span class="footer-contact">100 College Blvd E, Niceville, FL 32578</span>

    <div class="footer-hours">
      <a href="/college-operating-hours/">Click Here for Operating Hours</a>
    </div>

    <section class="social" aria-label="Social Media Links">
      <a href="https://www.facebook.com/nwfsc" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <i class="fa fa-facebook-square fa-2x" aria-hidden="true"></i>
      </a>

      <a href="https://twitter.com/nwfstatecollege" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
        <i class="fa fa-twitter-square fa-2x" aria-hidden="true"></i>
      </a>

      <a href="https://www.youtube.com/user/nwfstatecollege" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
        <i class="fa fa-youtube-square fa-2x" aria-hidden="true"></i>
      </a>

      <a href="https://www.instagram.com/nwfstatecollege/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <i class="fa fa-instagram fa-2x" aria-hidden="true"></i>
      </a>

      <a href="https://www.linkedin.com/school/north-west-florida-state-college/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <i class="fab fa-linkedin fa-2x" aria-hidden="true"></i>
      </a>
    </section>

    <nav class="links-container" aria-label="Footer Navigation">
      <div class="footer-row">
        <a href="https://www.nwfsc.edu/raider-central/visit-campus/">Visit NWFSC</a>
        <a href="https://www.nwfsc.edu/campus-maps/">Campus Maps</a>
        <a href="https://www.nwfsc.edu/a-to-z/">A to Z</a>
        <a href="https://www.nwfsc.edu/contact-us/">Contact Us</a>
      </div>

      <div class="footer-row">
        <a href="https://www.nwfsc.edu/news/">News</a>
        <a href="https://www.nwfsc.edu/calendar/">Events</a>
        <a href="https://www.nwfsc.edu/safety/">Campus Safety</a>
        <a href="https://www.nwfsc.edu/about/accessibility-policy/">Accessibility</a>
        <a href="https://nwfsc.interviewexchange.com/static/clients/531NFM1/index.jsp" target="_blank" rel="noopener noreferrer">Careers at NWFSC</a>
      </div>

      <div class="footer-row">
        <a href="https://www.nwfsc.edu/student-dispute-resolution/">Student Disputes</a>
        <a href="https://www.nwfsc.edu/public-records-request/">Public Records Request</a>
      </div>
    </nav>

    <section id="nondiscrim-statement" aria-label="Non-discrimination Statement">
      <h2 class="visuallyhidden">Non-discrimination Statement</h2>

      <p>
        Northwest Florida State College does not discriminate based on age, color, ethnicity, race, national origin, disability, marital status, pregnancy, religion, genetic information, sex, or any other legally protected classification in its employment practices or its educational programs or activities. For more information, please visit <a href="https://www.nwfsc.edu/nondiscrimination">nwfsc.edu/nondiscrimination</a>. Por favor llame a la Oficina de Admisiones de Northwest Florida State College al 850-678-5111 para obtener materiales de la Universidad en Español.
      </p>
    </section>

  </footer>
</div>

