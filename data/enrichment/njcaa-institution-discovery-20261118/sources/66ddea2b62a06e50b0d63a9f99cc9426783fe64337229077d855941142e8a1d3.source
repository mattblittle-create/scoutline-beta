                                                <path d="M49.4226 32.3341C40.2628 33.543 39.3944 34.4349 38.4318 43.6239C37.2229 34.464 36.331 33.5956 27.142 32.633C36.3018 31.4241 37.1703 30.5322 38.1328 21.3432C39.3417 30.5031 40.2337 31.3715 49.4226 32.3341Z" fill="#E53E30"/>
                                            </svg>
                                            <svg class="second-item-icon" width="76" height="76" viewBox="0 0 76 76" fill="none">
                                                <circle cx="38" cy="38" r="38" fill="#74C4D6"/>
                                                <path d="M46.3324 12H25V65L38.4446 50.5532C38.3074 50.7006 50.9954 65 50.9954 65L50.9931 16.4229C51.1273 13.7435 49.2898 12.0423 46.3324 12Z" fill="white"/>
                                                <path d="M49.4226 32.3341C40.2628 33.543 39.3944 34.4349 38.4318 43.6239C37.2229 34.464 36.331 33.5956 27.142 32.633C36.3018 31.4241 37.1703 30.5322 38.1328 21.3432C39.3417 30.5031 40.2337 31.3715 49.4226 32.3341Z" fill="#FFBF3D"/>
                                            </svg>
                                            <svg class="third-item-icon" width="76" height="76" viewBox="0 0 76 76" fill="none">
                                                <circle cx="38" cy="38" r="38" fill="#EE7624"/>
                                                <path d="M46.3324 12H25V65L38.4446 50.5532C38.3074 50.7006 50.9954 65 50.9954 65L50.9931 16.4229C51.1273 13.7435 49.2898 12.0423 46.3324 12Z" fill="white"/>
                                                <path d="M49.4226 32.3341C40.2628 33.543 39.3944 34.4349 38.4318 43.6239C37.2229 34.464 36.331 33.5956 27.142 32.633C36.3018 31.4241 37.1702 30.5322 38.1328 21.3432C39.3417 30.5031 40.2337 31.3715 49.4226 32.3341Z" fill="#6E7BA1"/>
                                            </svg>
                                        </div>
                                        <p class="txt-size-20 title">RVCC Student Interns, Professor Join Efforts to Protect Wildlife on Beachfront Areas</p>
                                        <p class="txt-size-16">Student interns from Raritan Valley Community College—led by Professor Jay Kelly—to install symbolic beach fencing in key beachfront areas for the purpose of protecting natural dune development and habitat for rare and threatened species.</p>
                                    </div>
                                </div>
                            </div>
                                                            </div>
                </div>
            </div>
        </div>
    </section>






