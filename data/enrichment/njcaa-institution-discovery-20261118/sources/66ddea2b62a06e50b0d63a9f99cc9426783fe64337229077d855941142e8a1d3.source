                <div class="max-w-container w-1400">
                    <div class="content-wrap">
                        <h1 class="main-title txt-size-140">
                            <span class="first">What can</span>
                            <span class="second">YOU do
                                <svg class="accent-svg" viewBox="0 0 360 216" fill="none" aria-hidden="true">
