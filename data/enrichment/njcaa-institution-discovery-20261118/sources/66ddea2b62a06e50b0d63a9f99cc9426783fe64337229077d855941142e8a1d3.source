                                    <path class="star" d="M309.84 17.2019C293.28 21.9144 291.921 23.7942 292.638 40.9966C287.926 24.4367 286.046 23.0777 268.844 23.7947C285.404 19.0822 286.763 17.2024 286.046 0C290.758 16.5599 292.638 17.9189 309.84 17.2019Z" fill="#FFBF3D"/>
                                    </g>
                                    <defs>
                                    <clipPath id="clip0_1283_1298">
                                    <rect width="360" height="215.952" fill="white"/>
                                    </clipPath>
                                    </defs>
                                </svg>
                            </span>
                            <span class="third">at RVCC?</span>
                        </h1>
                        <p class="description-text txt-size-18 c-white">Transfer or train, study or explore, and find what you’re looking for. Start something at RVCC and get real results on your terms.</p>
                                                                            <a href="https://www.raritanval.edu/education-for-everyone/" class="btn white" target="">See Education for Everyone</a>
                                            </div>
