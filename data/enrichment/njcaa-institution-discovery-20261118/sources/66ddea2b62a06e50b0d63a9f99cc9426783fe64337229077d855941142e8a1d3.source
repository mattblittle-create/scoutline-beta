<style id="wp-custom-css">
h1 a, h2 a, h3 a, h4 a, h5 a, h6 a {
	color: #272827;
}
h1.c-white a, h2.c-white a, h3.c-white a, h4.c-white a, h5.c-white a, h6 a {
	color: #fff;
}

body.home #messenger-root,
body.page-id-1242 #messenger-root {
    display: none;
  }

.resources-simple-block .content-wrap {
	display: block !important;
  columns: 2;
  column-gap: 2rem;
	margin-bottom: 5rem !important;
}
.resources-simple-block .content-wrap .item {
	break-inside: avoid;
  -webkit-column-break-inside: avoid; /* Safari */
  page-break-inside: avoid;           /* Older browsers */
}

@media (min-width: 1025px) {
	.dropdown-container {
    max-height: calc(100vh - 100px);
	}
}

.header .dropdown-menu-link.two-columns .menu-column:first-of-type .menu-items {
    column-count: 2;
    column-gap: 20px !important;
	display: block !important;
}
@media (max-width: 1200px) {
	.header .dropdown-menu-link.two-columns .menu-column:first-of-type .menu-items {
    column-count: 1;
	}
}
.header .dropdown-menu-link.two-columns .menu-column:first-of-type .menu-items .menu-item-wrap {
	break-inside: avoid;
}
.header .dropdown-menu-link.two-columns .menu-column:first-of-type .menu-items a {
	margin-bottom: 0 !important;
	padding-bottom: 15px;
}

.single-image-block .content-wrap {
	height: auto;
}
.single-image-block .content-wrap img {
	display: block;
	width: auto;
	max-width: 100%;
	height: auto;
	margin: 0 auto;
	object-fit: unset;
}

.image-with-text .content-wrap .image-wrap {
	height: auto !important;
}
.image-with-text .content-wrap .image-wrap img {
	display: block;
	width: auto;
	max-width: 100%;
	height: auto;
	object-fit: unset;
	margin: 0 auto;
}
@media (max-width: 800px) {
	.image-with-text.left-image .content-wrap .right-side, .image-with-text.right-image .content-wrap .left-side {
		width: 100%;
	}
	.image-with-text .content-wrap .image-wrap img {
		margin-top: 1rem;
		margin-bottom: 1rem;
	}
}
</style>
