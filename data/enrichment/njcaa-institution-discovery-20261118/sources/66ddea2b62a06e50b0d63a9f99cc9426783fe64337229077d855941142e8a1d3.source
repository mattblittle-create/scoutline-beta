    <script>
        var serviceUrl = "//uswestapi.reciteme.com/asset/js?key=";
        var serviceKey = "8179447b971ad2ac1af98f779309265b3e31427f";
        var options = {"Tracker":{"Ga":{"enabled":true}},"Docreader":{"endpoint":"https:\/\/docreader.reciteme.com\/doc\/url?q="},"autoEnable":0};
        var autoLoad = false;
        var floatingButton = true;
        var floatingButtonPosition = false;
        var enableFragment = "#reciteEnable";
        var reciteIsLoaded = [],
            frag = !1;
        var reciteMeButton;
        var buttonSrc = "https://www.raritanval.edu/wp-content/plugins/ReciteWordPress Plugin v2.4 AA 040326/images/reciteme_button.png";
        var buttonSrcHover = "https://www.raritanval.edu/wp-content/plugins/ReciteWordPress Plugin v2.4 AA 040326/images/reciteme_button_hover.png";
        window.location.hash === enableFragment && (frag = !0);

        function loadReciteScript(c, b) {
            var a = document.createElement("script");
            a.type = "text/javascript";
            a.readyState ? a.onreadystatechange = function() {
                if ("loaded" == a.readyState || "complete" == a.readyState){ 
