    <section class="testimonials-slider-section" aria-label="testimonials in a slider section">
        <div class="offset-x-desktop-170 ">
            <div class="max-w-container w-1570 slider">
                <div class="content-wrap">
                    <h2 class="txt-size-72 nexa c-black lh-1_1 testimonials-main-title">What our students feel</h2>
                    <div class="main-slider-wrap">
                        <div class="shape">
                            <svg class="shape-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 174 174" fill="none">
                                <path d="M173.999 88.7091C174.152 80.9004 162.263 73.8753 144.638 70.0634C140.251 69.1144 138.244 63.9873 140.822 60.3126C151.177 45.5505 155.139 32.3214 149.726 26.6916C144.313 21.0618 130.938 24.5008 115.78 34.268C112.007 36.6991 106.963 34.4927 106.187 30.0717C103.071 12.3109 96.5178 0.154896 88.7095 0.00146771C80.9008 -0.15196 73.8758 11.737 70.0638 29.3617C69.1148 33.7488 63.9877 35.7557 60.3131 33.1779C45.5509 22.8228 32.3218 18.8612 26.692 24.274C21.0622 29.6872 24.5012 43.0617 34.268 58.2193C36.6991 61.9927 34.4927 67.0368 30.0717 67.8128C12.3109 70.9288 0.154896 77.4817 0.00146771 85.2905C-0.15196 93.0988 11.737 100.124 29.3613 103.936C33.7484 104.885 35.7553 110.012 33.1775 113.687C22.8228 128.449 18.8612 141.678 24.274 147.308C29.6872 152.938 43.0617 149.499 58.2193 139.732C61.9927 137.3 67.0368 139.507 67.8128 143.928C70.9293 161.689 77.4822 173.845 85.2909 173.999C93.0996 174.152 100.125 162.263 103.937 144.639C104.886 140.252 110.013 138.245 113.687 140.822C128.449 151.177 141.678 155.139 147.308 149.726C152.938 144.313 149.499 130.938 139.732 115.781C137.301 112.008 139.507 106.964 143.928 106.188C161.689 103.071 173.845 96.5178 173.999 88.7091Z" fill=""/>
                            </svg>
                            <svg  class="quote-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75 64" fill="none">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M17.4245 31.4516C26.0204 29.3645 34.7085 34.7577 36.8308 43.4981C38.9528 52.2378 33.7055 61.0153 25.1096 63.1025C20.192 64.2965 15.3489 62.8996 11.5146 60.1132C-6.19886 47.2445 -3.3395 14.4411 19.1564 8.97896L21.0922 16.9515C21.0922 16.9515 9.93931 23.1463 12.0351 33.8989C13.6187 32.7792 15.4316 31.935 17.4251 31.451L17.4245 31.4516ZM54.4041 22.4727C62.9993 20.3857 71.6881 25.7788 73.8103 34.5192C75.9324 43.2589 70.6843 52.0366 62.0891 54.1236C57.1715 55.3176 52.3278 53.9209 48.4929 51.1346C30.7794 38.266 33.6387 5.46255 56.1346 0.000380195L58.0704 7.97296C58.0704 7.97296 46.9189 14.1674 49.014 24.9202C50.5965 23.8008 52.4097 22.9565 54.404 22.4722L54.4041 22.4727Z" fill="white"/>
                            </svg>
                        </div>
                        <div class="testimonials-slider swiper">
                            <div class="swiper-wrapper">
                                                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/haskins_mischelle_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Mischelle Haskins during an interview." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/haskins_mischelle_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/haskins_mischelle_headshot_slider.png" alt="Image of RVCC student Mischelle Haskins during an interview." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">I really was taken back by how much support that was really there, especially be on the older side. &#8230; No one ever made me feel like I was a non-traditional student.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Mischelle Williams,</span> <span class="position">Human Services Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/werenko_annika_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Annika Werenko." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/werenko_annika_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/werenko_annika_headshot_slider.png" alt="Image of RVCC student Annika Werenko." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">I think RV does a really good job at meeting everyone where they are.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Annika Werenko,</span> <span class="position">Human Services Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/wusha_conteh_mohamed_john_headshot_slider.png_.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Mohammed (John" Wusha-Conteh." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/wusha_conteh_mohamed_john_headshot_slider.png_.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/wusha_conteh_mohamed_john_headshot_slider.png_.png" alt="Image of RVCC student Mohammed (John" Wusha-Conteh." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">It&#8217;s not just a college. It&#8217;s a family. The professors and staff are all so friendly.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Mohammed &#8216;John&#8217; Wusha_Conteh,</span> <span class="position">Computer Science Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/blanco_valerie_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Valerie Blanco." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/blanco_valerie_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/blanco_valerie_headshot_slider.png" alt="Image of RVCC student Valerie Blanco." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">I would say coming to RV was the best decision because I met so many faculty in a smaller environment that I was able to grow and learn. I feel like I&#8217;m much more prepared to transfer to a 4-year.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Valerie Blanco,</span> <span class="position">Business Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/byrnes_chris_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Chris Byrnes." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/byrnes_chris_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/byrnes_chris_headshot_slider.png" alt="Image of RVCC student Chris Byrnes." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">A two-year program is an absolutely wonderful way of getting back into it. It&#8217;s something that is more doable for a lot of people.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Chris Byrnes,</span> <span class="position">Digital Media Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/nunez_edward_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Edward Nunez." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/nunez_edward_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/nunez_edward_headshot_slider.png" alt="Image of RVCC student Edward Nunez." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">The school has been very helpful in terms of allowing me to continue with father duty and husband duty.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Edward Nunez,</span> <span class="position">Computer Science Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/hooke_talia_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Talia Hooke." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/hooke_talia_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/hooke_talia_headshot_slider.png" alt="Image of RVCC student Talia Hooke." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">If someone is stuck and they don&#8217;t know what it is they want to do with their life, I feel like this is the perfect fit for them.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Talia Hooke,</span> <span class="position">IT Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/toribio_joscar_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC student Joscar Toribio." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/toribio_joscar_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/toribio_joscar_headshot_slider.png" alt="Image of RVCC student Joscar Toribio." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">That&#8217;s one of the biggest misconceptions that it&#8217;s lesser than a 4-year school.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Joscar Toribio,</span> <span class="position">IT Student</span>
                                                </p>
                                            </div>
                                        </div>
                                    
                                                                                                                        <div class="swiper-slide single-slide">
                                                                                                                                        <div class="image-wrap">
                                                    <picture><source  type="image/webp" data-srcset="https://www.raritanval.edu/wp-content/uploads/2026/06/faragalla_sandra_headshot_slider.png.webp"><img decoding="async" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Image of RVCC graduate Sandra Faragalla." data-eio="p" data-src="https://www.raritanval.edu/wp-content/uploads/2026/06/faragalla_sandra_headshot_slider.png" class="lazyload"></picture><noscript><img decoding="async" src="https://www.raritanval.edu/wp-content/uploads/2026/06/faragalla_sandra_headshot_slider.png" alt="Image of RVCC graduate Sandra Faragalla." data-eio="l"></noscript>
                                                                                                    </div>
                                            
                                            <div class="text-wrap">
                                                <p class="txt-size-22 quote-text">I feel like RV picked me because, ever since the start of coming to my first open house, I feel like it was love at first sight. That really stood out to me because you want to be at an institution where you can feel comfortable being yourself.</p>
                                                <p class="author-names txt-size-16">
                                                    <span class="name">Sandra Faragalla,</span> <span class="position">Communication Studies Student</span>
                                                </p>
                                            </div>
                                        </div>
                                                                                                </div>


                                                        <div class="slider-controlls">
                                <div class="slider-nav testimonials-prev-slide">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="34" height="8" viewBox="0 0 34 8" fill="none">
                                        <path d="M0.146122 3.33004C-0.0491409 3.52531 -0.0491409 3.84189 0.146122 4.03715L3.3281 7.21913C3.52337 7.41439 3.83995 7.41439 4.03521 7.21913C4.23047 7.02387 4.23047 6.70729 4.03521 6.51202L1.20678 3.6836L4.03521 0.855169C4.23047 0.659907 4.23047 0.343325 4.03521 0.148062C3.83995 -0.0471997 3.52336 -0.0471997 3.3281 0.148063L0.146122 3.33004ZM33.833 3.68359L33.833 3.18359L0.499676 3.1836L0.499676 3.6836L0.499676 4.1836L33.833 4.18359L33.833 3.68359Z" fill="black"/>
                                    </svg>
                                </div>
