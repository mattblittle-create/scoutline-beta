      		<script>
			
			$(document).ready(function () {

			

			$('.events-slider ul').bxSlider({
			maxSlides: 3,
			slideWidth: 400,
			slideMargin: 36,
			moveSlides: 1,
			pager: false,
			touchEnabled: false,
			onSliderLoad: fixHiddenSliderItems,
			onSlideAfter: fixHiddenSliderItems,
			onSlideBefore: fixHiddenSliderItems
			});

			function fixHiddenSliderItems() {
			$('.homepage-slider li[aria-hidden="true"], .events-slider li[aria-hidden="true"]').each(function () {
			$(this).attr('tabindex', '-1');

			$(this).find('a, button, input, select, textarea, iframe, [tabindex]').each(function () {
			$(this)
			.attr('tabindex', '-1')
			.attr('aria-hidden', 'true');
			});
			});
			}

			fixHiddenSliderItems();
			setTimeout(fixHiddenSliderItems, 100);
			setTimeout(fixHiddenSliderItems, 500);
			setTimeout(fixHiddenSliderItems, 1000);

			});
		</script>
