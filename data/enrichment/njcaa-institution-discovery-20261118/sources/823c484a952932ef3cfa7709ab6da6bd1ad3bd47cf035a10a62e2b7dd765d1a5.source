    <div class="juicer-feed-wrapper">
        <div class="juicer-feed" data-feed-id="lakesumterstatecollege"></div><script type="text/javascript" src="//www.juicer.io/embed/lakesumterstatecollege/wp-plugin-1-13.js?nojquery=true"></script>    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        // --- Existing Lazy Loading Code ---
        const addLazyLoading = () => {
            document.querySelectorAll('.j-content-image:not([loading="lazy"])').forEach(img => {
                img.setAttribute('loading', 'lazy');
            });
        };

        // --- Updated Function to Fix Multiple Issues ---
        function fixJuicerElements() {
            // 1. Find the main container for Juicer items
            const juicerContainer = document.querySelector('.juicer-feed .slick-list.draggable .slick-track');
            if (!juicerContainer) {
                // console.log("Juicer slick track not found yet.");
                return; // Exit if container isn't ready
            }

            // --- TABINDEX FIXES ---
            // Strategy: Make primary links/buttons focusable by removing erroneous tabindex="-1"
            // Keep the LI focusable for simplified navigation if desired (Option 1)

            // a) Remove tabindex="-1" from links (<a>) that should be focusable
            const linksToRemoveTabIndex = juicerContainer.querySelectorAll(`
            .feed-item a[tabindex="-1"]:not(.j-social),
            .feed-item a.j-social[tabindex="-1"]
        `);

            linksToRemoveTabIndex.forEach(link => {
                link.removeAttribute('tabindex');
            });

            // b) Remove tabindex="-1" from images
            const imagesToRemoveTabIndex = juicerContainer.querySelectorAll('.feed-item .j-image img[tabindex="-1"]');
            imagesToRemoveTabIndex.forEach(img => {
                img.removeAttribute('tabindex');
            });

            // c) Remove tabindex="-1" from other text/container elements
            const textElementsToRemoveTabIndex = juicerContainer.querySelectorAll(`
           .feed-item .j-text[tabindex="-1"],
           .feed-item .j-poster[tabindex="-1"],
           .feed-item h3[tabindex="-1"],
           .feed-item .j-date[tabindex="-1"],
           .feed-item .j-message[tabindex="-1"],
           .feed-item .j-meta[tabindex="-1"],
           .feed-item .j-link-container[tabindex="-1"],
           .feed-item nav[tabindex="-1"]
        `);
            textElementsToRemoveTabIndex.forEach(el => {
                el.removeAttribute('tabindex');
            });

            // d) Manage LI tabindex based on visibility
            const allFeedItems = juicerContainer.querySelectorAll('.feed-item.slick-slide');
            allFeedItems.forEach(item => {
                const isHidden = item.getAttribute('aria-hidden') === 'true';
                const isCloned = item.classList.contains('slick-cloned');

                if (isHidden || isCloned) {
                    item.setAttribute('inert', '');

                    // Save and set LI tabindex to -1 so the list item itself is not focusable
                    if (!item.hasAttribute('data-original-tabindex')) {
                        item.setAttribute('data-original-tabindex', item.hasAttribute('tabindex') ? item.getAttribute('tabindex') : '');
                    }
                    item.setAttribute('tabindex', '-1');

                    const focusableChildren = item.querySelectorAll('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
                    focusableChildren.forEach(child => {
                        if (!child.hasAttribute('data-original-tabindex')) {
                            child.setAttribute('data-original-tabindex', child.getAttribute('tabindex') || '');
                        }
                        child.setAttribute('tabindex', '-1');
                    });
                } else {
                    item.removeAttribute('inert');

                    // Restore LI tabindex from saved value (if any)
                    if (item.hasAttribute('data-original-tabindex')) {
                        const originalLi = item.getAttribute('data-original-tabindex');
                        if (originalLi === '') {
                            item.removeAttribute('tabindex');
                        } else {
                            item.setAttribute('tabindex', originalLi);
                        }
                        item.removeAttribute('data-original-tabindex');
                    } else {
                        // If no original saved value, ensure we don't leave a lingering -1
                        if (item.getAttribute('tabindex') === '-1') {
                            item.removeAttribute('tabindex');
                        }
                        if (item.getAttribute('aria-hidden') === 'true') {
                            item.setAttribute('tabindex', '0');
                        }
                    }

                    const previouslyDisabledChildren = item.querySelectorAll('[data-original-tabindex]');
                    previouslyDisabledChildren.forEach(child => {
                        const originalValue = child.getAttribute('data-original-tabindex');
                        if (originalValue === '') {
                            child.removeAttribute('tabindex');
                        } else {
                            child.setAttribute('tabindex', originalValue);
                        }
                        child.removeAttribute('data-original-tabindex');
                    });
                }
            });

            // --- NEW: REMOVE ARIA ROLE="REGION" ---
            // Find elements with role="region" within the Juicer feed and remove it
            const elementsWithRoleRegion = juicerContainer.querySelectorAll('[role="region"]');
            elementsWithRoleRegion.forEach(element => {
                element.removeAttribute('role');
                // console.log("Removed role='region' from element:", element);
            });

            // --- EXISTING LAZY LOADING CALL ---
            addLazyLoading();
        } // End fixJuicerElements function

        // --- MutationObserver Setup ---
        const observer = new MutationObserver(() => {
            setTimeout(fixJuicerElements, 100); // Run the combined fix function
        });

        const juicerFeed = document.querySelector('.juicer-feed');
        if (juicerFeed) {
            observer.observe(juicerFeed, {
                childList: true,
                attributes: true,
                attributeFilter: ['aria-hidden', 'class', 'tabindex']
            });
            fixJuicerElements(); // Run once initially
        }

    }); // End DOMContentLoaded
</script>
<script type="text/javascript">
    // Vanilla JS lazy load Juicer
    var feed = document.querySelector('.juicer-feed');
    var juicerLoaded = false;
    var juicerFeedScrollDistance = feed ? feed.getBoundingClientRect().top + window.pageYOffset : 0;

    function lazyLoadJuicer() {
        var scrollDistance = window.pageYOffset || document.documentElement.scrollTop;
        var windowHeight = window.innerHeight;

        if (feed && (scrollDistance >= (juicerFeedScrollDistance - windowHeight)) && !juicerLoaded) {
            var script = document.createElement('script');
            script.src = 'https://assets.juicer.io/embed.js';
            document.body.appendChild(script);

            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.type = 'text/css';
            link.href = 'https://assets.juicer.io/embed.css';
            document.head.appendChild(link);

            juicerLoaded = true;
        }
    }

    window.addEventListener('scroll', lazyLoadJuicer);
    // Run once in case already in view
    lazyLoadJuicer();
</script>


