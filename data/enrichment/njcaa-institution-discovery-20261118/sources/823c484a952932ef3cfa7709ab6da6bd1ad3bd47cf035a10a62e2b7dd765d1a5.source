    <section class="bg-gradient-dk-blue">
        <div class="container py-6">
            <div class="row">
                <div class="col-12 col-md-8 offset-lg-2 d-flex flex-column align-items-center text-center gap-2">
                    <h2 class="display-4 text-warning text-center">Take the first step with us!</h2>
                    <p class="text-white lead">We're here to help you get the information and support you need.<br />Let your journey begin!</p>
                    <div class="d-flex flex-column flex-lg-row justify-content-lg-center gap-4">
                        <a class="mb-4 btn btn-lg btn-outline-warning text-white" href="https://www.lssc.edu/future-students/visit/">Plan a Visit&nbsp;<i class="fa-solid fa-arrow-right text-warning"></i></a>
                        <a class="mb-4 btn btn-lg btn-outline-warning text-white" href="https://www.lssc.edu/dept/enrollment-service-center/">Enrollment Support&nbsp;<i class="fa-solid fa-arrow-right text-warning"></i></a>
                        <a class="mb-4 btn btn-lg btn-outline-warning text-white" href="https://enroll.lssc.edu">Learn More&nbsp;<i class="fa-solid fa-arrow-right text-warning"></i></a>
                    </div>
                    <h3 class="display-6 text-white">Not sure where to start?</h3>
                    <p class="text-white lead">Complete our <a class="text-white" href="https://lssc.mymajors.com/quiz" target="_blank" rel="noopener noreferrer">LSSC Assessment</a> to discover<br /> what program and pathway fits your interest and skills.</p>
                </div>
            </div>
        </div>
    </section>
    <section class="home-facts">
        <div class="container">
            <div class="row">
                <div class="col-12 col-lg-7 d-flex align-items-center">
                    <div class="p-lg-5">
                        <h2>Every future looks different! That's why <span>we take a personalized approach</span> to education. Our mission is to serve the communities of central Florida by <span>preparing students to thrive</span> in today's dynamic workforce.</h2>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="home-facts-right">
                        <div class="home-fact">
                            <div class="icon">
                                <img src="/wp-content/themes/lssc/images/icon-bank.svg" alt="" loading="lazy" width="143" height="150" />
                            </div>
                            <div class="fact">
                                1/2 the price of state universities
                            </div>
                        </div>
                        <div class="home-fact">
                            <div class="icon">
                                <img src="/wp-content/themes/lssc/images/more-than-one-point-seven-million.svg" alt="More than 1.7 Million" loading="lazy" width="127" height="64" />
                            </div>
                            <div class="fact">
                                in scholarships awarded annually
                            </div>
                        </div>
                        <div class="home-fact">
                            <div class="icon">
                                <img src="/wp-content/themes/lssc/images/top-200.svg" alt="In the Top 200" loading="lazy" width="101" height="64" />
                            </div>
                            <div class="fact">
                                community colleges nationwide
                            </div>
                        </div>
