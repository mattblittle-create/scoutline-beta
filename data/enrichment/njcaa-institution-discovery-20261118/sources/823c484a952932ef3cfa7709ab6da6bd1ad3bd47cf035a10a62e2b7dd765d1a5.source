<style id="wp-custom-css">
.widget-banner-home a {
	color: #fff;
	margin-top: -2rem;
}


.primary-nav {
  display: flex;
  flex: 1 1 100%;
  margin-left: 1rem;
  margin-right: 1rem;

  @media (min-width: 768px) {
    justify-content: space-between;
  }
}

h2 {
	 scroll-snap-align: start;
  scroll-margin-top: 30px;
}

#SR7_33_1-164-3 {
background:	rgba(18, 81, 164, 0.6) !important;
	border-radius: 8px;
}
</style>
</head>



<body class="home wp-singular page-template-default page page-id-6 wp-custom-logo wp-theme-lssc" data-bs-theme="light">
<header class="border-bottom">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="fixed-top">
        <div class="bg-gradient-dk-blue text-white" id="notificationBar">
            <div class="container py-2">
                <div class="top-bar row d-flex align-content-center align-items-center justify-content-between">
                    <div class="col d-flex align-content-center">
                        <div class="virtual-lobby-wrapper"><div class="virtual-lobby-message d-flex align-items-center">
        <a href="https://lssc.my.salesforce-sites.com/engage/TargetX_Engage__Engage#/VESC/signin?offsite=1" class="text-white text-decoration-underline" aria-label="Join Virtual Enrollment Service Center" target="_blank" rel="noopener noreferrer">    
            <img src="https://lssc.edu/wp-content/themes/lssc/images/live-enroll.svg" width="48" height="48" class="mr-2" alt="">
        </a>
        <span class="mx-2 my-2">
            <strong>Need support?</strong>
            <a href="https://lssc.my.salesforce-sites.com/engage/TargetX_Engage__Engage#/VESC/signin?offsite=1" class="text-white text-decoration-underline" target="_blank" rel="noopener noreferrer">Join our Virtual Enrollment Service Center</a>
            or
            <a href="https://lssc.my.salesforce-sites.com/inquiry/TargetX_Base__InquiryForm#?formId=a0BVP000009JpeL2AS&formType=general" class="text-white text-decoration-underline" target="_blank" rel="noopener noreferrer">Request a call for assistance!</a>
        </span>
    </div></div>                    </div>

                    <ul class="col-3 nav-row d-flex align-items-center justify-content-end gap-4 text-end">
                        <li class="dropdown hide--mobile">
                            <button class="btn btn-outline-light btn-on-dark dropdown-toggle select"
                                id="dropdownEnrollmentSupport" data-bs-toggle="dropdown" aria-haspopup="true"
                                aria-expanded="false" aria-controls="dropdownEnrollmentSupportMenu">
                                Enrollment Support
                            </button>
                            <ul id="dropdownEnrollmentSupportMenu" class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="dropdownEnrollmentSupport">
                                <li>
                                    <a class="dropdown-item"
                                        href="https://lssc.my.salesforce-sites.com/inquiry/TargetX_Base__InquiryForm#?formId=a0BVP000009JpeL2AS&formType=general"
                                        target="_blank" rel="noopener noreferrer">Request a Callback</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://lssc.my.salesforce-sites.com/engage/TargetX_Engage__Engage#/VESC/signin?offsite=1" target="_blank" rel="noopener noreferrer">Virtual Support</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="mailto:ESC@lssc.edu">Email</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://www.lssc.edu/about-us/locations/">In-Person </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://www.lssc.edu/future-students/visit/">Visit Campus</a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                        href="https://www.lssc.edu/academics/request-more-information/">Request
                                        Information</a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="https://banner.lssc.edu/apexPROD/r/rtsdba/apply/login?session=7942767434123"
                                class="btn btn-warning" id="apply">Apply</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="hide--mobile">
            
<nav class="container-fluid shortcut-nav" role="navigation" aria-label="Shortcut Navigation">
    <div class="container">
        <ul class="shortcut-grid">
            <li class="shortcut-grid-item">
                <a class="shortcut-link" href="https://www.lssc.edu/academics/academic-programs/">
                    <svg width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
