            <div class="container">
               <h1 class="display-4" style="text-align: center;" data-sider-select-id="a5c5b187-bb9f-4b97-9861-d5d607ef2fd5"><span style="color: #0033a1;" data-sider-select-id="6964eb16-305e-4a13-abce-6a06e105db7c">WHY MURRAY STATE?</span></h1>
               
               
               	
               <div class="row">
                  		
                  <div class="col-12 mb-5">
                     			
                     <h2 class="text-center sans-serif"></h2>
                     		</div>
                  		
                  <div class="col-lg-4">
                     	
                     <div class="card">
                        		
                        <div class="image-overlay">
                           			
                           <div class="card-img-top" style="background-image: url('/_resources/images/student-life/students/ardmore-students.jpg')"></div>
                           			
                           <div class="card-overlay"></div>
                           		</div>
                        		
                        <div class="card-body text-center">
                           			
                           <h3>DEGREES</h3>
                           			
                           			
                           <p>
                              <div style="text-align: center;"><span>Murray State offers the best education at a great value. Discover why it's the fastest-growing
                                    college or university in Oklahoma.</span></div>
                           </p>
                           			
                           <p>
                              				<a href="/academics/academics/degrees-programs.html" target="_self" rel="noopener noreferrer" class="btn btn-default btn-dark btn-centered">EXPLORE DEGREES </a>
                              			</p>
                           		</div>
                        	</div>
                     </div>
                  <div class="col-lg-4">
                     	
                     <div class="card">
                        		
                        <div class="image-overlay">
                           			
                           <div class="card-img-top" style="background-image: url('/_resources/images/student-life/students/stud%20life.jpg')"></div>
                           			
                           <div class="card-overlay"></div>
                           		</div>
                        		
                        <div class="card-body text-center">
                           			
                           <h3>EXPERIENCE CAMPUS</h3>
                           			
                           			
                           <p>
                              <div style="text-align: center;">&nbsp;A campus visit lets you experience the community, traditions, and support that shape
                                 life at Murray State College. See where you belong.</div>
                           </p>
                           			
                           <p>
                              				<a href="https://calendly.com/mscoutreach/msc-campus-tour?month=2026-01" target="_self" rel="noopener noreferrer" class="btn btn-default btn-dark btn-centered">VISIT CAMPUS </a>
                              			</p>
                           		</div>
                        	</div>
                     </div>
                  <div class="col-lg-4">
                     	
                     <div class="card">
                        		
                        <div class="image-overlay">
                           			
                           <div class="card-img-top" style="background-image: url('/_resources/images/remote.jpg')"></div>
                           			
                           <div class="card-overlay"></div>
                           		</div>
                        		
                        <div class="card-body text-center">
                           			
                           <h3>ONLINE</h3>
                           			
                           			
