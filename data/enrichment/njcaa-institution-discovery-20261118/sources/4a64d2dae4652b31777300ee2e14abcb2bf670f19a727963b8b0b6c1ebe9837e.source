      <div class="content">
      <article about="/athletics" typeof="schema:WebPage" class="node node--type-page node--view-mode-full clearfix">

  
    
  <span property="schema:name" content="Athletics" class="rdf-meta hidden"></span>


  
  <div class="node__content clearfix">
    

            <div property="schema:text" class="field field--name-body field--type-text-with-summary field--label-hidden field__item"><h2>Welcome to Panola College Athletics!&nbsp;</h2><p>At Panola College, our student-athletes compete with purpose, pursue excellence, and represent Pony pride both in competition and in the classroom. Explore our athletic programs, meet our teams, and discover what it means to be a Panola Pony.</p></div>
      
<div class="field field--name-field-contents field--type-entity-reference-revisions field--label-hidden">
        <div class="paragraph paragraph--type--button paragraph--view-mode--default">
              

  
<a href="https://www.youtube.com/@PanolaCollege1947/streams"  class="secondary button outlink featured" target="_blank">
