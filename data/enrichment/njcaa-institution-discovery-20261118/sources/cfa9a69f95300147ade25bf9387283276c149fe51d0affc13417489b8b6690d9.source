               <p><!-- Component: Embed Code-->
                  <div data-section="Embed Code" data-headline="">
                     <div id="standout-stage" data-section="Hompage Feed Tabs"></div><script type="text/javascript">
//
window.onload = function() {
    var xhttp = new XMLHttpRequest();
    xhttp.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
            // Action to be performed when the document is read;
            document.getElementById("standout-stage").innerHTML = this.responseText;

            // Start of slideshow code
            let soslideIndex = 1;
            showSoslides(soslideIndex);

            // Next/previous controls
            window.plusSoslides = function(n) {
                showSoslides(soslideIndex += n);
            }

            // Thumbnail image controls
            window.currentSoslide = function(n) {
                showSoslides(soslideIndex = n);
            }

            function showSoslides(n) {
                let i;
                let slides = document.getElementsByClassName("standout-slide");
                let dots = document.getElementsByClassName("standout-dot");
                if (n > slides.length) {soslideIndex = 1}
                if (n < 1) {soslideIndex = slides.length}
                for (i = 0; i < slides.length; i++) {
                    slides[i].style.display = "none";
                }
                for (i = 0; i < dots.length; i++) {
                    dots[i].className = dots[i].className.replace(" active", "");
                }
                slides[soslideIndex-1].style.display = "block";
                dots[soslideIndex-1].className += " active";
            }   
            // End of slideshow code
        }
    };
    xhttp.open("GET", "/_resources/php/blog/loaders/homepage-tabs-feed.php", true);
    xhttp.send();
}
//
</script></div>
