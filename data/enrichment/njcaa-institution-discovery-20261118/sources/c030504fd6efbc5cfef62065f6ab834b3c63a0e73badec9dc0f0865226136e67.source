                    slidesToScroll: 1,
                    fade: true,
                    arrows: false
                };

                var oddSliderSettings_component_aotw_1 = {
                    autoplay: true,
                    infinite: true,
                    dots: false,
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    fade: true,
                    arrows: false
                };

                var evenSliderSettings_component_aotw_1 = {
                    autoplay: true,
                    infinite: true,
                    dots: false,
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    fade: true,
                    arrows: false
                };

                if (1 > 1 && 1 > 1) {
                    oddSliderSettings_component_aotw_1.asNavFor = '.slider-even-component-aotw-1';
                    evenSliderSettings_component_aotw_1.asNavFor = '.slider-odd-component-aotw-1';
                }

                // Initialize only the slider set appropriate for the current viewport
                if ($(window).width() < 576) {
                    $('.slider-mobile-component-aotw-1').slick(mobileSliderSettings_component_aotw_1);
                } else {
                    if (1 > 1) {
                        $('.slider-odd-component-aotw-1').slick(oddSliderSettings_component_aotw_1);
                    }
                    if (1 > 1) {
                        $('.slider-even-component-aotw-1').slick(evenSliderSettings_component_aotw_1);
                    }
                }

                $('.next-component-aotw-1').click(function() {
                    if ($(window).width() < 576) {
                        if ($('.slider-mobile-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-mobile-component-aotw-1').slick('slickNext');
                        }
                    } else {
                        if ($('.slider-odd-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-odd-component-aotw-1').slick('slickNext');
                        }
                        if ($('.slider-even-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-even-component-aotw-1').slick('slickNext');
                        }
                    }
                });

                $('.prev-component-aotw-1').click(function() {
                    if ($(window).width() < 576) {
                        if ($('.slider-mobile-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-mobile-component-aotw-1').slick('slickPrev');
                        }
                    } else {
                        if ($('.slider-odd-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-odd-component-aotw-1').slick('slickPrev');
                        }
                        if ($('.slider-even-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-even-component-aotw-1').slick('slickPrev');
                        }
                    }
                });

                $('.pp-component-aotw-1').click(function() {
                    var onMobile = $(window).width() < 576;
                    if (isPlaying_component_aotw_1) {
                        if (onMobile) {
                            if ($('.slider-mobile-component-aotw-1').hasClass('slick-initialized')) $('.slider-mobile-component-aotw-1').slick('slickPause');
                        } else {
                            if ($('.slider-odd-component-aotw-1').hasClass('slick-initialized')) $('.slider-odd-component-aotw-1').slick('slickPause');
                            if ($('.slider-even-component-aotw-1').hasClass('slick-initialized')) $('.slider-even-component-aotw-1').slick('slickPause');
                        }
                        $(this).attr('aria-label', 'Start slide rotation').removeClass('pause').addClass('play');
                        $('.fa', this).removeClass('fa-pause').addClass('fa-play');
                        $('.sr-only', this).text('Play');
                    } else {
                        if (onMobile) {
                            if ($('.slider-mobile-component-aotw-1').hasClass('slick-initialized')) $('.slider-mobile-component-aotw-1').slick('slickPlay');
                        } else {
                            if ($('.slider-odd-component-aotw-1').hasClass('slick-initialized')) $('.slider-odd-component-aotw-1').slick('slickPlay');
                            if ($('.slider-even-component-aotw-1').hasClass('slick-initialized')) $('.slider-even-component-aotw-1').slick('slickPlay');
                        }
                        $(this).attr('aria-label', 'Stop slide rotation').removeClass('play').addClass('pause');
                        $('.fa', this).removeClass('fa-play').addClass('fa-pause');
                        $('.sr-only', this).text('Pause');
                    }
                    isPlaying_component_aotw_1 = !isPlaying_component_aotw_1;
                });

                $(window).on('resize', function() {
                    if ($(window).width() < 576) {
                        if ($('.slider-odd-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-odd-component-aotw-1').slick('unslick');
                        }
                        if ($('.slider-even-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-even-component-aotw-1').slick('unslick');
                        }
                        if (!$('.slider-mobile-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-mobile-component-aotw-1').slick(mobileSliderSettings_component_aotw_1);
                        }
                    } else {
                        if ($('.slider-mobile-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-mobile-component-aotw-1').slick('unslick');
                        }
                        if (1 > 1 && !$('.slider-odd-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-odd-component-aotw-1').slick(oddSliderSettings_component_aotw_1);
                        }
                        if (1 > 1 && !$('.slider-even-component-aotw-1').hasClass('slick-initialized')) {
                            $('.slider-even-component-aotw-1').slick(evenSliderSettings_component_aotw_1);
                        }
                    }
                });
            });
        </script>
    
