                parameter.format_field = format_field;
            }

            $wrap.removeClass('on');
            if (isClear) {
                $wrap.removeClass('selected');
                $wrap.find('.sel-val').text('Degree Type');
                $wrap.find('.sel-val').attr('data-val', '');
            } else {
                $wrap.addClass('selected');
                $wrap.find('.sel-val').text(jQuery(this).text());
                $wrap.find('.sel-val').attr('data-val', valueSelected);
            }
            set_parameter_browser();
            call_filter_seach(parameter);
            
        });
        jQuery('body').on('click', '.format-select .sel-opts .opt', function(e) {
            e.stopPropagation();
            var $wrap = jQuery(this).parents('.select-wrap');
            var isClear = jQuery(this).hasClass('clear');
            var valueSelected = isClear ? '' : jQuery(this).attr('data-val');
            var parameter= {'action': "get_filter_list_search", 'format_field': valueSelected };
            if(jQuery('.block-row-areas-study .select-wrap.selected').length){
                var va = jQuery('.block-row-areas-study .select-wrap.selected').find('.sel-val').attr('data-val');
                parameter.areas_of_study = va;
            }
            if(jQuery('.block-row-degree-type .select-wrap.selected').length){
                var dt = jQuery('.block-row-degree-type .select-wrap.selected').find('.sel-val').attr('data-val');
                parameter.degree_type = dt;
            }

            $wrap.removeClass('on');
            if (isClear) {
                $wrap.removeClass('selected');
                $wrap.find('.sel-val').text('Format');
                $wrap.find('.sel-val').attr('data-val', '');
            } else {
                $wrap.addClass('selected');
                $wrap.find('.sel-val').text(jQuery(this).text());
                $wrap.find('.sel-val').attr('data-val', valueSelected);
            }
            set_parameter_browser();
            call_filter_seach(parameter);
            
        });
    });
</script>

<script type="text/javascript">

    function resizeElements_element_equal(){
      var max_height = 0;
      jQuery(".list-news-wrapper .first-three-news").each(function() {
          if (jQuery(this).find('.wrapper-box-summary').innerHeight() > max_height) {
              max_height = jQuery(this).find('.wrapper-box-summary').innerHeight();
          }
      });
      jQuery(".list-news-wrapper .first-three-news").innerHeight(max_height);
  }
    function settup_size_submenu(){
        var dim_container = jQuery('#header .container').width();
        var top_menu_nav = jQuery('#nav-main').width();
        var result = dim_container - top_menu_nav;
        jQuery("#nav-main>li .menu-drop").css({"left": "-" + (result -10) + "px", "width": (dim_container+80) + "px"});
    }
    jQuery(document).ready(function () {
        resizeElements_element_equal();
        jQuery('.am-row>p').remove();
        settup_size_submenu()
        jQuery(window).resize(function () {
            resizeElements_element_equal();
            settup_size_submenu()  
        });

         jQuery('body').on('click', '.show-more-paginator', function(e) {
          e.preventDefault();  
          var id = jQuery(this).attr('show_number');
          var datos = 20;
          var parameter= {'action': "get_paginator_news",'dim': datos,'show_id': id }
            jQuery.ajax({
                type: "POST",
                url: '/wp-admin/admin-ajax.php',
                data: parameter,
               error: function (response) {
                    console.log(response);
                },
                beforeSend: function() {
                  jQuery('.list-news-wrapper').find('.show-more-paginator').addClass('loader-call'); 
                },
                success: function(response) {
                    jQuery('.list-news-wrapper').find('.show-more-paginator').remove(); 
                    jQuery('.list-news-wrapper').append(response); 
                    resizeElements_element_equal();
                  
                }
            });
        });

        
    });
</script>


<script type="text/javascript">
    let testimonialsListBoxObj=0;
