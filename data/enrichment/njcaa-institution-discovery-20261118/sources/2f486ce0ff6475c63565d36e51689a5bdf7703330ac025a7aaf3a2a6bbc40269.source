</div>
<div class="am-row">
<div class="am-column-1-1">
<p class="pre-h">Dec. 1 &#8211; 3</p>
<h1>Explore CF at Open House</h1>
<p>Apply for free, tour campus, learn about financial aid and more!</p>
<p><a class="am-button-3" href="/events/category/admissions/open-house/list/">Find my Campus</a></p>
</div>
</div>
</div>
<p><!-- spotlight section right below homepage banner --></p>
<div class="am-section grey-section">
<div class="am-row">
<div class="am-column-1-2">
<img decoding="async" class="box-shadow" src="https://www.cf.edu/wp-content/uploads/2025/04/6J2A0646-editsm.jpg" alt="CF Student" />
</div>
<div class="am-column-1-2">
<h2>Take Classes in Spring</h2>
<p><strong>Get a head start on your degree! The Spring term starts in&#8230;</strong></p>
<div class="countdown"><style type='text/css'>.wpcdt-timer-10008 .wpcdt-clock{max-width: 1200px;}</style>
<div class="wpcdt-wrap wpcdt-timer-wrap wpcdt-clearfix  wpcdt-timer-circle wpcdt-timer-10008" data-conf="{&quot;current_date&quot;:&quot;2026-11-18 11:09:42&quot;,&quot;expiry_date&quot;:&quot;2027-01-06 00:00:01&quot;,&quot;timercircle_animation&quot;:&quot;smooth&quot;,&quot;timercircle_width&quot;:0.00333,&quot;timer_bg_width&quot;:0.1,&quot;timer_bgclr&quot;:&quot;#ffffff&quot;,&quot;timer_day_bgclr&quot;:&quot;#ffffff&quot;,&quot;timer_hour_bgclr&quot;:&quot;#ffffff&quot;,&quot;timer_minute_bgclr&quot;:&quot;#ffffff&quot;,&quot;timer_second_bgclr&quot;:&quot;#ffffff&quot;,&quot;day_text&quot;:&quot;Days&quot;,&quot;hour_text&quot;:&quot;Hours&quot;,&quot;minute_text&quot;:&quot;Minutes&quot;,&quot;second_text&quot;:&quot;Seconds&quot;,&quot;is_days&quot;:1,&quot;is_hours&quot;:1,&quot;is_minutes&quot;:1,&quot;is_seconds&quot;:&quot;&quot;}">
	<div class="wpcdt-timer-inr wpcdt-timer wpcdt-timer-js" id="wpcdt-timer-1" data-id="10008">
