<article id="post-1960" class="post-1960 page type-page status-publish has-post-thumbnail hentry entry">
	
	<div class="entry-content">
		<div class="am-section dark-section section-video-hero center">
<div class="am-video-bg">
<div class="mejs-container mejs-container-keyboard-inactive mejs-video">
<div class="mejs-inner">
<div class="mejs-mediaelement">
<video class="video-hero-full-width" autoplay="" playsinline="" muted="" id="mejs_33321436266808835_html5" preload="none" src="https://www.cf.edu/wp-content/uploads/2024/11/open-house-banner.mp4"><source type="video/mp4" src="https://www.cf.edu/wp-content/uploads/2024/11/open-house-banner.mp4"><source type="video/webm" src="https://www.cf.edu/wp-content/uploads/2024/11/open-house-banner.mp4"></video></div>
</div>
