<script>
        function set_description_dropdown_filter(){
            if(jQuery('.block-row-areas-study .selected').length){
                var v1 = jQuery('.block-row-areas-study .select-wrap.selected').find('.sel-val').attr('data-val');
                var value_aof = jQuery(".areas-of-study-select .sel-opts .opt[data-val='" + v1 +"']").text();
                jQuery('.block-row-areas-study .select-wrap.selected').find('.sel-val').text(value_aof);
            }
            if(jQuery('.block-row-degree-type .selected').length){
                var v2 = jQuery('.block-row-degree-type .select-wrap.selected').find('.sel-val').attr('data-val');
                var value_dt = jQuery(".degree-type-select .sel-opts .opt[data-val='" + v2 +"']").text();
                jQuery('.block-row-degree-type .select-wrap.selected').find('.sel-val').text(value_dt);
            }
            if(jQuery('.block-row-format .selected').length){
                var v3 = jQuery('.block-row-format .select-wrap.selected').find('.sel-val').attr('data-val');
                var value_ff = jQuery(".format-select .sel-opts .opt[data-val='" + v3 +"']").text();
                jQuery('.block-row-format .select-wrap.selected').find('.sel-val').text(value_ff);
            }
        }

        function set_parameter_browser(){
            var url = window.location.protocol + '//' + window.location.hostname + window.location.pathname;
            var parameter_secondary = false;
            var areas_of_study="";
            if(jQuery('.block-row-areas-study .selected').length){
                var v1 = jQuery('.block-row-areas-study .select-wrap.selected').find('.sel-val').attr('data-val');
                if(v1!=""){
                    pa="?";
                    if(parameter_secondary){
                        pa="&";
                    }
                    parameter_secondary = true;
                    areas_of_study = pa+"areas_of_study="+v1;    
                }
                
            }
            var degree_type="";
            if(jQuery('.block-row-degree-type .selected').length){
                var v2 = jQuery('.block-row-degree-type .select-wrap.selected').find('.sel-val').attr('data-val');
                if(v2!=""){
                    pa="?";
                    if(parameter_secondary){
                        pa="&";
                    }
                    parameter_secondary = true;
                    degree_type = pa+"degree_type="+v2;
                }
            }
            var format_field ="";
            if(jQuery('.block-row-format .selected').length){
                var v3 = jQuery('.block-row-format .select-wrap.selected').find('.sel-val').attr('data-val');
                if(v3!=""){
                    pa="?";
                    if(parameter_secondary){
                        pa="&";
                    }
                    parameter_secondary = true;
                    format_field = pa+"format_field="+v3;
                }
            }
             var cat_main = areas_of_study+degree_type+format_field;
             url = url+cat_main;
             history.pushState({}, null, url);
        }


        function settup_header_height(){
            var height = jQuery('#header').height();
           jQuery('.site-content').css({"padding-top": height + "px"});
        }

        var currentFilterRequest = null;
        var currentInputRequest = null;

        function render_filter_response(htmlContent){
            jQuery('.wrapper-filter-box').html(htmlContent);
            if(jQuery('.wrapper-filter-box').find('.list-filter-pages').length){
                jQuery(".value-hidden-box").addClass('show-find-looking');
            } else {
                jQuery(".value-hidden-box").removeClass('show-find-looking');
            }
        }

        function call_filter_seach(parameter){
            if (currentFilterRequest && currentFilterRequest.readyState !== 4) {
                currentFilterRequest.abort();
            }
            currentFilterRequest = jQuery.ajax({
                type: "POST",
                url: '/wp-admin/admin-ajax.php',
                data: parameter,
                error: function (response, textStatus) {
                    if (textStatus === 'abort') {
                        return;
                    }
                    if (response && response.readyState === 0) {
                        currentFilterRequest = jQuery.ajax({
                            type: "GET",
                            url: window.location.href,
                            cache: false,
                            success: function(pageHtml) {
                                var $parsed = jQuery('<div>').append(jQuery.parseHTML(pageHtml));
                                var $box = $parsed.find('.wrapper-filter-box');
                                if ($box.length) {
                                    render_filter_response($box.html());
                                } else {
                                    render_filter_response(pageHtml);
                                }
                            },
                            error: function(fallbackErr, fallbackStatus) {
                                if (fallbackStatus !== 'abort') {
                                    console.log(fallbackErr);
                                }
                            }
                        });
                        return;
                    }
                    console.log(response);
                },
                success: function(response) {
                    render_filter_response(response);
                }
            });
        }

        function call_filter_seach_input_box(parameter){
            if (currentInputRequest && currentInputRequest.readyState !== 4) {
                currentInputRequest.abort();
            }
            currentInputRequest = jQuery.ajax({
                type: "POST",
                url: '/wp-admin/admin-ajax.php',
                data: parameter,
                error: function (response, textStatus) {
                    if (textStatus === 'abort') {
                        return;
                    }
                    console.log(response);
                },
                success: function(response) {
                    jQuery('.search-opts').html(response);  
                    jQuery('.search-opts').parents('.pf-search-wrap').addClass('on');
                }
            });
        }

       function size_campus_map(){
            var size_element = jQuery('#campus-map').innerWidth();
            var height = (85/100)*size_element;
            jQuery('.map-image-location').css({"margin-left": "-" + (Math.round(size_element)/2) + "px", "margin-top": "-" + (Math.round(height)/2) + "px", "width": (Math.round(size_element)) + "px", "height": (Math.round(height)) + "px" }); 
            
       }
         function video_resize_screen(){
            var rw=0;
            var width_br = jQuery(window).width();
            var height_br = jQuery(window).height();
            var rk = width_br/15;

            if(width_br<=1280){
                height_br = jQuery('.section-video-hero').innerHeight();
            }
            
           jQuery('.video-hero-full-width').css({"width": (width_br + rw) + "px", "height": (height_br+rk) + "px"});
           
        }
    jQuery(document).ready(function() {
        set_description_dropdown_filter();
        if(jQuery('.current-page-link').length){
            jQuery('.current-page-link').parents('.has-child-pages').addClass('open');
            jQuery('.current-page-link').parents('.has-child-pages.open').children('ul').slideToggle();
        }
        var button_open_close = "<span class='icon-sidebar-child'></span>";
        jQuery('.has-child-pages>a').before(button_open_close);
        jQuery('.sidebar-nav .closed > .icon-sidebar-child').on('click', function() {
            jQuery(this).parent('li').toggleClass("open");
            jQuery(this).siblings('ul').slideToggle();
        });


        video_resize_screen();
        size_campus_map();
        /*var button='<button type="button" data-toggle="collapse" data-target="#main-menu-179" aria-expanded="false" aria-controls="main-menu-179" class=""><i class="fa fa-plus"></i><span class="sr-only">Expand Menu</span></button>'
