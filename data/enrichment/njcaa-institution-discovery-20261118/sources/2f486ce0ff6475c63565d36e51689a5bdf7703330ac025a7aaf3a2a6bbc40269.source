    function load_end_testimonials() {
        testimonialsListBoxObj = jQuery('.testimonials-list-box').slick({
            focusOnSelect: false,
            centerMode: true,
            centerPadding: '60px',
            slidesToShow: 1,
            slidesToScroll: 1,
