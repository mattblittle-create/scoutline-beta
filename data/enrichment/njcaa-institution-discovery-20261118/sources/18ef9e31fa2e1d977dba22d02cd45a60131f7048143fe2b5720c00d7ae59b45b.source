}

#footer-bottom-bar {
	background-color: #02358c !important;
}

@media only screen and (max-width: 1274px) {
	footer .footer-content {
		justify-content: center;
	}
}

@media (max-width: 1000px) {
	#footer-ship-v3 {
		width: 1000px;
		position: relative;
		right: calc(1000px - 100%);
	}
}

@media only screen and (max-width: 991px) {
