<script>
function playCircularVideo() {
	const iframe = document.getElementById('yt-video');
	const thumb = document.getElementById('yt-thumb');
	const playButton = document.querySelector('#featured-video .play-button');
	const rawUrl = iframe.dataset.src;

	if (!rawUrl) {
		console.error('The ACF video_url field is empty.');
		return;
	}

	try {
		const videoUrl = new URL(rawUrl);

		videoUrl.searchParams.set('autoplay', '1');
		videoUrl.searchParams.set('controls', '1');
		videoUrl.searchParams.set('rel', '0');
		videoUrl.searchParams.set('playsinline', '1');

		console.log('Loading YouTube URL:', videoUrl.toString());

		iframe.src = videoUrl.toString();
		iframe.style.display = 'block';
		thumb.style.display = 'none';
		playButton.style.display = 'none';
	} catch (error) {
		console.error('Invalid YouTube URL:', rawUrl, error);
	}
}
</script>
