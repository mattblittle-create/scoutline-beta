								<img
								id="yt-thumb"
								data-src="https://www.cv.edu/wp-content/uploads/2026/07/wearethecommunity.png"
								alt="Video Thumbnail"
								class="video-thumb lazyload"
								style="--smush-placeholder-width: 1440px; --smush-placeholder-aspect-ratio: 1440/931;width:100%;height:100%;object-fit:cover;display:block;position:absolute;top:0;left:0;"
								 src="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==" />
								<iframe
									id="yt-video"
									data-src="https://www.youtube.com/embed/ToTn-PJZI9E"
									src="about:blank"
									title="Featured video"
									frameborder="0"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									style="display:none;position:absolute;top:0;left:0;width:100%;height:100%;">
</iframe>
								<div class="play-button" onclick="playCircularVideo()" role="button" tabindex="0" aria-label="Play video" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); playCircularVideo(); }">

								</div>
