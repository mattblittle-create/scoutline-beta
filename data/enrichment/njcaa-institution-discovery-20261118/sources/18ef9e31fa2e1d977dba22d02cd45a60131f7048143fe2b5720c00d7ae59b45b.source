<!-- <script src="https://www.cv.edu/wp-content/themes/cvcc/js/menu.js" type="text/javascript"></script> -->
    <script>
        $(document).ready(function () {

            // JQUERY NAV TOGGLE
            $('#menu').bind('click', function (event) {
                $('#mainnav ul').slideToggle();
            });

            $(window).resize(function () {
                var w = $(window).width();
                if (w > 768) {
                    $('#mainnav ul').removeAttr('style');
                }
            });

        });
    </script>

    <script type="text/javascript">
        $(window).on('load', function () {

        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalElement = document.getElementById('myModal');

            if (modalElement) {
                var alertModal = new bootstrap.Modal(modalElement);

                // a11y: the dialog has no tabindex (an unfocusable wrapper fails keyboard checks), so move
                // focus to its first control when it opens and keep Tab inside it while it is open
                var modalFocusFirst = function () {
                    var first = modalElement.querySelector('button, a[href]');
                    if (first) first.focus();
                };
                modalElement.addEventListener('shown.bs.modal', modalFocusFirst);
                document.addEventListener('focusin', function (e) {
                    if (modalElement.classList.contains('show') && !modalElement.contains(e.target)) {
                        modalFocusFirst();
                    }
                });

                alertModal.show();

                var closeButton = document.getElementById('modalCloseButton');

                if (closeButton) {
                    closeButton.addEventListener('click', function () {
                        console.log("clicked");
                        document.cookie = "=1; max-age=604800; path=/; SameSite=Lax";
                    });
                }
            }
        });
    </script>


    <script type="application/javascript">

        function loadJS(file) {
            var jsElm = document.createElement("script");
            jsElm.type = "application/javascript";
            jsElm.src = file;
            document.body.appendChild(jsElm);
        }

        window.onload = function () {

            // find all elements with the class "simplifi-tracking-apply" and add the onclick attribute and value element
            let simplifiTrackingApply = document.querySelectorAll('.simplifi-tracking-apply > a');

            simplifiTrackingApply.forEach(element => {
                $(element).attr('onclick', "loadJS('https://tag.simpli.fi/sifitag/b7cbf31b-3108-4c5f-bc4e-e1d066a419ab.js');");
            });

            let simplifiTrackingApplyTwo = document.querySelectorAll('.home-v3.button-container > a');

            simplifiTrackingApplyTwo.forEach(element => {
                if (element.textContent.trim() === 'Apply') {
                    $(element).attr('onclick', "loadJS('https://tag.simpli.fi/sifitag/b7cbf31b-3108-4c5f-bc4e-e1d066a419ab.js');");
                    console.log('banner-loop');
                }
            });
        }
    </script>

