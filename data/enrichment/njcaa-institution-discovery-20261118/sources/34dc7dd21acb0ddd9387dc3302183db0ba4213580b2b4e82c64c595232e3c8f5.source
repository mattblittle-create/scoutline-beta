															<img fetchpriority="high" decoding="async" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src="https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-scaled.jpg" data-srcset="https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-scaled.jpg 2560w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-300x228.jpg 300w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-1024x778.jpg 1024w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-768x584.jpg 768w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-1536x1167.jpg 1536w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-2048x1556.jpg 2048w" width="2560" height="1946" class="attachment-full size-full wp-image-23648 lazyload" alt="Graphic promoting the download of the new NWSCC athletics app with a qr code" sizes="(max-width: 2560px) 100vw, 2560px"><noscript><img decoding="async" width="2560" height="1946" src="https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-scaled.jpg" class="attachment-full size-full wp-image-23648" alt="Graphic promoting the download of the new NWSCC athletics app with a qr code" srcset="https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-scaled.jpg 2560w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-300x228.jpg 300w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-1024x778.jpg 1024w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-768x584.jpg 768w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-1536x1167.jpg 1536w, https://nwscc.edu/wp-content/uploads/2026/01/NWSCC-Athletics-App_WEB-2048x1556.jpg 2048w" sizes="(max-width: 2560px) 100vw, 2560px"></noscript>															</div>
