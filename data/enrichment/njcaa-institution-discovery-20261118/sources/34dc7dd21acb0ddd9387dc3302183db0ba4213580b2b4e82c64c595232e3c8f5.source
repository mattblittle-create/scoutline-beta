<script>
document.addEventListener('DOMContentLoaded', function() {
  // Add aria-label to search input (this one loads with the page)
  const searchInput = document.getElementById('cn-search-input');
  if (searchInput) {
    searchInput.setAttribute('aria-label', 'Search Directory');
  }
  
  // Function to add aria-label to category input
  function addCategoryLabel() {
    const categoryInput = document.querySelector('.chosen-search-input');
    if (categoryInput && !categoryInput.hasAttribute('aria-label')) {
      categoryInput.setAttribute('aria-label', 'Select Category');
      return true;
    }
    return false;
  }
  
  // Try immediately first
  if (!addCategoryLabel()) {
    // If not found, watch for it to be added
    const observer = new MutationObserver(function(mutations) {
      if (addCategoryLabel()) {
        observer.disconnect(); // Stop observing once we've added the label
      }
    });
    
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }
});
</script>
<script>
// Wait for DOM to be ready
// Create observer to watch for the problematic element
const observer = new MutationObserver(function(mutations) {
    const problematicElement = document.querySelector('a.elementor-item.elementor-gallery-title.elementor-item-active[role="button"][tabindex="0"]');
    
    if (problematicElement) {
        console.log('Found and removing problematic element');
        problematicElement.remove();
        // Optional: disconnect if you only need to remove it once
        // observer.disconnect();
    }
});

// Start observing when DOM is ready
if (document.body) {
    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
} else {
    document.addEventListener('DOMContentLoaded', function() {
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
}
</script>
<script>
(function() {
  'use strict';
  
  // Function to fix dialog accessibility issues
  function fixDialogAccessibility() {
    const dialogs = document.querySelectorAll('[role="dialog"]');
    
    dialogs.forEach(dialog => {
      // Remove aria-hidden from dialog
      if (dialog.hasAttribute('aria-hidden')) {
        dialog.removeAttribute('aria-hidden');
      }
      
      // Find and fix close button
      const closeButton = dialog.querySelector('button.ekit-team-modal-close');
      if (closeButton && !closeButton.hasAttribute('aria-label')) {
        closeButton.setAttribute('aria-label', 'Close');
      }
    });
  }
  
  // Run immediately if DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixDialogAccessibility);
  } else {
    fixDialogAccessibility();
  }
  
  // Watch for changes
  const observer = new MutationObserver(() => {
    fixDialogAccessibility();
  });
  
  observer.observe(document.documentElement, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['aria-hidden']
  });
  
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  
  // Function to add role="button" to the links
  function updateLinks() {
    const menu = document.getElementById('menu-1-e3de749');
    if (menu) {
      const links = menu.querySelectorAll('a[href="#"]');
      links.forEach(link => {
        link.setAttribute('role', 'button');
      });
      return true; // Found and processed
    }
    return false; // Not found yet
  }
  
  // Try immediately first
  if (updateLinks()) {
    return; // Done, no need for observer
  }
  
  // Set up MutationObserver for dynamic content
  const observer = new MutationObserver(function(mutations) {
    if (updateLinks()) {
      observer.disconnect(); // Stop observing once we've found it
    }
  });
  
  // Start observing
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
</script>
<script>
	// Convert h2.profile-title elements to h3 elements
(function() {
  'use strict';

  // Function to convert an h2 to h3
  function convertH2ToH3(h2Element) {
    if (h2Element.classList.contains('profile-title') && h2Element.tagName === 'H2') {
      // Create new h3 element
      const h3 = document.createElement('h3');
      
      // Copy all attributes
      Array.from(h2Element.attributes).forEach(attr => {
        h3.setAttribute(attr.name, attr.value);
      });
      
      // Copy all child nodes
      while (h2Element.firstChild) {
        h3.appendChild(h2Element.firstChild);
      }
      
      // Replace h2 with h3
      h2Element.parentNode.replaceChild(h3, h2Element);
      
      return true;
    }
    return false;
  }

  // Function to process existing elements
  function processExistingElements() {
    const h2Elements = document.querySelectorAll('h2.profile-title');
    h2Elements.forEach(convertH2ToH3);
  }

  // Set up MutationObserver to watch for dynamically added elements
  function setupObserver() {
    const observer = new MutationObserver(mutations => {
      mutations.forEach(mutation => {
        // Check added nodes
        mutation.addedNodes.forEach(node => {
          if (node.nodeType === Node.ELEMENT_NODE) {
            // Check if the node itself is an h2.profile-title
            if (node.tagName === 'H2' && node.classList.contains('profile-title')) {
              convertH2ToH3(node);
            }
            // Check for h2.profile-title within the added node
            if (node.querySelectorAll) {
              const h2Elements = node.querySelectorAll('h2.profile-title');
              h2Elements.forEach(convertH2ToH3);
            }
          }
        });
      });
    });

    // Start observing the document body for changes
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }

  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      processExistingElements();
      setupObserver();
    });
  } else {
    // DOM already loaded
    processExistingElements();
    setupObserver();
  }
})();
</script>

