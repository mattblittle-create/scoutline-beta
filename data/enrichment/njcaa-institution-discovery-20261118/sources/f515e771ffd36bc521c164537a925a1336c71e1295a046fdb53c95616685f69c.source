<!----------------------		STUDENT PATH			---------------------->
<style>
#student-types {
	display: flex;
	gap:40px;
	justify-content: center;

	position: relative;
	background:var(--light-grey);
	background:#eee;
	background-image: url('https://www.eastcentral.edu/images/studentTypeHome2.jpg');
	background-position: center center;
	background-size: cover;
	border:#a9a9a9 1px solid;
	z-index: 5;
	padding:100px 56px;
}
a.student-type {
	display: flex;
	justify-content: center;
	align-items: center;

	background: var(--sunshine);

	font-weight: 500;
	line-height: 18px;
	text-decoration: none;

	padding: 5px 10px;
	width: 300px;
	height:80px;
	transition: background 0.4s, color 0.4s;
	text-align: center;
	position: relative;
	z-index: 301;
	/* border-radius: 6px; */
	box-shadow: 0 10px 10px -5px var(--elephant-grey);
	
}
a.student-type:hover {
	background: var(--aqua);
	color: var(--true-blue);
}

.prospective-on {
	border-radius: 4px 4px 0 0 !important;
	background: #dcdcdc !important;
}

#prospective-dropdown-container {
	display: none;
	margin-top:-101px;
	position: absolute;
	justify-content: center;
	align-items: center;
	flex-direction: column;
	left: 50%;
	right: 50%;
}


#prospective-dropdown-connector {
	height: 6px;
	width:300px;
	z-index: 302;
	background:#dcdcdc;
}

#prospective-dropdown {
	background:var(--light-grey);
	z-index:300;
	line-height: 18px;
	padding: 20px 20px 10px;
	box-shadow: 0 10px 10px -5px var(--elephant-grey);
}

.prospective-links {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 10px;
}
.prospective-links a {
	text-decoration: none;
	text-align: center;
	width: 320px;
}

@media screen and (max-width: 767px) {
	#student-types {
		padding:40px 20px;
		flex-direction: column;
		gap: 16px;
	}
	a.student-type {
		width: 100%;
	}
}


</style>

<div id="student-types">
	<a class="student-type" href="/current/">Current Students</a>
	<a id="prospective-button" class="student-type prospective-hover" href="/admissions/prospective-students/">Prospective Students</a>
	<a class="student-type" href="/admissions/prospective-students/family/">Family &amp; Supporters</a>
</div>

<div id="prospective-dropdown-container">
	<div id="prospective-dropdown-connector"></div>
	<div id="prospective-dropdown" class="prospective-hover" style="">
		<div style="margin-bottom: 20px;font-size: 24px;text-align: center;">What kind of student are you?</div>
		<div class="prospective-links">
			<a href="/admissions/prospective-students/adult-learners/">Adult Learner</a>
			<a href="/admissions/prospective-students/international-students/">International Student</a>
			<a href="/admissions/prospective-students/transfer-students/">Transfer Student</a>
			<a href="/admissions/prospective-students/current-high-school-students/">Current High School Student</a>
			<a href="/admissions/prospective-students/recent-high-school-graduates/">Recent High School Graduate</a>
			<a href="/admissions/prospective-students/veterans/">Veteran</a>
			<a href="/admissions/prospective-students/homeschool-students/">Homeschool Student</a>
			<a href="/admissions/prospective-students/returning-students/">Returning Student</a>
			<a href="/admissions/prospective-students/visiting-students/">Visiting Student</a>
			<a href="/admissions/prospective-students/student-athletes/">Student Athlete</a>
		</div>
	</div>
</div>


<script>
$('#prospective-button').mouseover(function(){
	var width = $( document ).width();
	if(width > 767) {
		$('#prospective-button').addClass('prospective-on');	
		// $('#prospective-dropdown-container').show();
		$('#prospective-dropdown-container').css('display','flex');
	}
});
$('#prospective-dropdown').mouseleave(function(){
	$('#prospective-button').removeClass('prospective-on');	
	$('#prospective-dropdown-container').hide();
});
</script>

<!----------------------		/STUDENT PATH			---------------------->





















