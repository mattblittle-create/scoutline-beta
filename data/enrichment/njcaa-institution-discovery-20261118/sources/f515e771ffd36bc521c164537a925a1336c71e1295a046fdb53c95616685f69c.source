<!-- HEADING VIDEO -->

<style>
.hero {
	position: relative;
	width: 100%;
	/* padding-top: 40%; */
	/* Maintains 5:2 aspect ratio (2 / 5 * 100 = 40%) */
	aspect-ratio: 5 / 2;
	/* aspect-ratio: 2 / 1; */
	overflow: hidden;
}

.hero-video {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	width: 100%;
	height: auto;
	min-height: 100%;
	object-fit: cover;
}

.hero-banner-buttons {
	display: grid;
	gap: 20px;
	grid-template-columns: 1fr 1fr 1fr;
	position: absolute;
	bottom: 40px;
	left: 50%;
	transform: translateX(-50%);
	width: 100%;
	max-width: 800px;
	text-align: center;
	padding: 0 20px;
}
.hero-banner-buttons .ecc-button {
	/* box-shadow: none; */
	box-shadow: 0px 8px 8px -2px rgba(0,0,0,0.6);
	position: relative;
	font-size: 18px!important;
	text-transform: uppercase;
	font-weight: 600;
	line-height: 1em;
	/* Flex so the button fills the full row height and the text stays centered */
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	padding: 16px 24px!important;
	
}
/* Each grid cell stretches to the tallest button; let the button fill its cell */
.hero-banner-buttons > div {
	display: flex;
	justify-content: center;
}




.commencement-button {
	position: absolute;
	bottom: 120px;
	left: 50%;
	transform: translateX(-50%);
}
.commencement-button .ecc-button {
	background-color: var(--pumpkin-spice)!important;
	box-shadow: none;
}
.commencement-button .ecc-button:hover {
	background-color: var(--aqua)!important;
}



@media (max-width:720px) {
	.hero-banner-buttons {
		bottom: 5px;
		gap: 10px;
	}
	.hero-banner-buttons .ecc-button {
		/* font-size: 14px!important; */
		padding: 12px 20px!important;
	}
}

@media (max-width:600px) {
	.hero-banner-buttons {
		bottom: -5px;
		gap: 8px;
	}
	.hero-banner-buttons .ecc-button {
		font-size: 14px!important;
		padding: 5px 20px!important;
		padding: 8px 20px!important;
	}
	
	.commencement-button {
		bottom: 50px;
	}
	.commencement-button .ecc-button {
		font-size: 16px!important;
	}

}


</style>

