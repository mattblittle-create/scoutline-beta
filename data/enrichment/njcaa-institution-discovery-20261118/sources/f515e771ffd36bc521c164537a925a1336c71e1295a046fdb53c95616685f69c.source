<style>
#ecc-events-news-container {
	display: grid;
	gap: 40px;
	grid-template-columns: 2fr 1fr;
	
	padding: 20px;
	width: 100%;
	margin: 0 auto 40px;
}

#ecc-events-news-container h2 {
	font-size: 24px;
	font-weight: 500;
	text-transform: uppercase;
	color: #666;
	border-bottom: 2px #dcdcdc solid;
	padding-bottom: 10px;
	margin-bottom: 20px;
}

.news-post {
	margin-bottom: 20px;
}
.news-title {
	font-size: 18px;
	font-weight: 600;
}
.news-title a {
	text-decoration: none;
}
.news-title a:hover {
	text-decoration: underline;
}

#ecc-events-news-container .ecc-button-small {
	background-color: #eee;
	margin-bottom: 10px;
}
#ecc-events-news-container .ecc-button-small:hover {
	background-color: var(--aqua);
}


/* 		PODCAST 		*/
a.ecc-insiders-badge {
	display: block;
	background-color: var(--true-blue);
	background-image: url('https://www.eastcentral.edu/images/ecc-blue-background-2024.png');
	background-position: center;
	background-size: cover;
	text-align: center;
	padding: 20px;
	text-decoration: none;
}
.ecc-insiders-badge .ecc-insiders-logo {
	width: 100%;
	max-width: 200px;
}
.ecc-insiders-badge .ecc-insiders-tag {
	color: var(--sunshine);
	font-size: 18px;
	font-weight: 600;
	text-decoration: none;
}



@media (max-width: 992px) {
	#ecc-events-news-container {
		grid-template-columns:1fr;
	}
}
@media (max-width: 650px) {
	#ecc-events-news-container .event-calendar-item {
		gap: 10px;
		grid-template-columns: 1fr;
	}
}

</style>

