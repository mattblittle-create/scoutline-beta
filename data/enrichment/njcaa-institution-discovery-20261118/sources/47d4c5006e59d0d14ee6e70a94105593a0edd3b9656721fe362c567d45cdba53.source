<!-- Page Change Form Page Variables -->
<script>
	/*$(document).ready(function() {
					$title = ($("title").text());
					$fromurl = document.location;
					$('#reftitle').attr('value', $title);
					$('#reffromurl').attr('value', $fromurl);
					}); */
	$(document).ready(function() {
		var $title = $("title").text();
		var $keywords = $("head").find("meta[name='Keywords']").attr("content");
		var $description = $("head").find("meta[name='Description']").attr("content");
		var $reviewperiod = $("body").find("input[name='periodreview']").attr("value");
		var $datetime = $("body").find("input[name='timedate']").attr("value");
		var $fromurl = document.location;
		$('#reftitleinput').val($title);
		$('#reffromurlinput').val($fromurl);
		$('#refmetakeywordsinput').val($keywords);
		$('#refmetadescriptioninput').val($description);
		$('#refreviewperiodinput').val($reviewperiod);
		$('#refdatetimeinput').val($datetime);
		/* Webmaster Form */
		$('#reftitlewminput').val($title);
		$('#reffromurlwminput').val($fromurl);
	});
</script>

<!-- OU Campus Direct Edit Button -->
<script>
	/* automatically pulls the direct edit button from the published pages without the need to define Button Code */
	function directedit() {
		if(document.getElementById("de") != null && document.getElementById("directedit")) {
			var link = document.getElementById("de").children[0].href;
			document.getElementById("de").innerHTML = "";
			document.getElementById("directedit").href = link;
		}
	}
	window.onload = function() { directedit() };
	
</script>
<!-- Add tabindex to Direct Edit -->
<script>
$('#directedit').attr("tabindex","-1");
</script>
