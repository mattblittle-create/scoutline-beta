			-moz-background-size:cover;
			-o-background-size:cover;
			background-size:cover;
			*/
			}

			/* Centered text Mobile */
			.centered {
			position: static;
			padding: 50px 0;
			margin: 0 100px;
			top: 50%;
			left: 50%;
			transform: none;
			} 

			/* Small devices (landscape phones, 576px and up) */
			@media (min-width: 576px) {
			/* Centered text */
			.centered {
			position: absolute;
			padding:0;
			margin: 0;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%); 
			}
			}

			#homevideo .btn-border{
			color: #222222;
			background-color: #fff;
			border-color: #222222;
			}
			#homevideo .btn{
			font-weight: 600;
