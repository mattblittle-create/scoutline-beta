      		<script>
			/* Do not load poster image on mobile */
			$(
			function() {
			const bgvtag = $('#homevideotag');
			if (bgvtag.is(':hidden')) {
			$(bgvtag.removeAttr('preload'));
			$(bgvtag.removeAttr('poster'));
			}
			}
			)
			/* Do not load video on mobile */
			$(
			function() {
			const bgv = $('#homevideotag');

			if (bgv.is(':visible')) {
			$('source', bgv).each(
			function() {
			const el = $(this);
			el.attr('src', el.data('src'));
			}
			);

			bgv[0].load();
			}
			}
			)

		</script>
      		<script>
			$( document ).ready(function() {
			$(".owl-nav, .disabled").remove();
			$(".owl-dots, .disabled").remove();
			});


			var owl = $('#owl-1.owl-carousel');
			owl.owlCarousel({
			loop:true,
			autoplay:true,
			autoplayTimeout:3000,
			autoplayHoverPause:true,
			responsiveClass:true,
			responsive : {
			// breakpoint from 0 up
			0 : {
			items : 1,
			nav: false
			},
			// breakpoint from 480 up
			476 : {
			items : 2,
			nav: false
			},
			// breakpoint from 768 up
			768 : {
			items : 5,
			nav: false
			},
			// breakpoint from 992 up
			992 : {
			items : 6,
			nav: false
			},
			// breakpoint from 1200 up
			1200 : {
			items : 6,
			nav: false
			}
			}
			});
			$('.play').on('click',function(){
			owl.trigger('play.owl.autoplay',[3000])
			})
			$('.stop').on('click',function(){
			owl.trigger('stop.owl.autoplay')
			})

			var owlnews = $('#newsroomContainer.owl-carousel');
			owlnews.owlCarousel({
			loop:true,
			autoplay:true,
			autoplayTimeout:3000,
			autoplayHoverPause:true,
			responsiveClass:true,
			responsive : {
			// breakpoint from 0 up
			0 : {
			items : 1,
			nav: false
			},
			// breakpoint from 480 up
			476 : {
			items : 1,
			nav: false
			},
			// breakpoint from 768 up
			768 : {
			items : 3,
			nav: false
			},
			// breakpoint from 992 up
			992 : {
			items : 3,
			nav: false
			},
			// breakpoint from 1200 up
			1200 : {
			items : 3,
			nav: false
			}
			}
			});
			$('.playnews').on('click',function(){
			owlnews.trigger('play.owl.autoplay',[3000])
			})
			$('.stopnews').on('click',function(){
			owlnews.trigger('stop.owl.autoplay')
			})
		</script>
