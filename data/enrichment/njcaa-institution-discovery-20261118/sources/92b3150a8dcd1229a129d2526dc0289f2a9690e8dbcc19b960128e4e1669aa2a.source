<script>
document.addEventListener("DOMContentLoaded", () => {
  const header = document.querySelector("header");
  const footer = document.querySelector("footer");
  if (!header || !footer) return;

  let sibling = header.nextElementSibling;

  while (sibling && sibling !== footer) {
    if (sibling.hasAttribute("data-elementor-type")) {
      sibling.setAttribute("role", "main");
      sibling.setAttribute("id", "content");
      break;
    }
    sibling = sibling.nextElementSibling;
  }
});
</script>
<script>
/**
 * Search Dialog Accessibility Fix
 *
 * Resolves five issues in the injected search overlay:
 *  1. Missing ARIA dialog attributes on the overlay container
 *  2. Close button not keyboard-focusable or operable
 *  3. Tab from close button closes dialog and sends focus to page top
 *  4. Focus not trapped within the open dialog
 *  5. Background content readable by screen readers while dialog is open
 */
(function () {
  "use strict";

  // Selectors used throughout
  const OVERLAY_SEL   = ".st-ui-container-overlay";
  const CLOSE_BTN_SEL = ".st-ui-close-button";
  const SEARCH_INPUT  = "#st-overlay-search-input";

  // Elements that are natively focusable (and visible/enabled)
  const FOCUSABLE_SEL = [
    "a[href]",
    "button:not([disabled])",
    "input:not([disabled])",
    "select:not([disabled])",
    "textarea:not([disabled])",
    "[tabindex]:not([tabindex='-1'])",
    "[role='button']:not([aria-disabled='true'])",
  ].join(", ");

  // The control that opens the search dialog. Focus returns here on close.
  const TRIGGER_SEL = "a.ubermenu-target.menu-search-toggle";

  // ─── Helpers ────────────────────────────────────────────────────────────────

  function isVisible(el) {
    return (
      el &&
      !el.hidden &&
      el.style.display !== "none" &&
      window.getComputedStyle(el).display !== "none"
    );
  }

  function getFocusable(container) {
    return Array.from(container.querySelectorAll(FOCUSABLE_SEL)).filter(
      (el) =>
        !el.disabled &&
        window.getComputedStyle(el).display !== "none" &&
        window.getComputedStyle(el).visibility !== "hidden"
    );
  }

  /**
   * Apply or remove aria-hidden on every sibling of the overlay so that
   * background content is hidden from screen readers while the dialog is open.
   * Skips elements that already had aria-hidden before we touched them.
   */
  function setBackgroundAriaHidden(overlay, hide) {
    const parent = overlay.parentElement;
    if (!parent) return;

    Array.from(parent.children).forEach((sibling) => {
      if (sibling === overlay) return;

      if (hide) {
        // Preserve any pre-existing aria-hidden value so we can restore it later
        if (!sibling.hasAttribute("data-st-fix-aria-hidden-saved")) {
          sibling.dataset.stFixAriaHiddenSaved =
            sibling.getAttribute("aria-hidden") ?? "__none__";
        }
        sibling.setAttribute("aria-hidden", "true");
      } else {
        const saved = sibling.dataset.stFixAriaHiddenSaved;
        if (saved === undefined) return; // We never touched this element
        if (saved === "__none__") {
          sibling.removeAttribute("aria-hidden");
        } else {
          sibling.setAttribute("aria-hidden", saved);
        }
        delete sibling.dataset.stFixAriaHiddenSaved;
      }
    });
  }

  // ─── Core fix: runs once the overlay element exists in the DOM ───────────────

  function applyFixes(overlay) {
    // ── Fix 1: ARIA dialog attributes ────────────────────────────────────────
    //
    // The container needs role="dialog" so AT announces it as a dialog.
    // aria-modal="true" tells AT to restrict the virtual cursor to the dialog.
    // aria-labelledby points to the search input, which carries a visible label
    // via its aria-label attribute; if a visible heading existed we'd prefer that.
    overlay.setAttribute("role", "dialog");
    overlay.setAttribute("aria-modal", "true");
    overlay.setAttribute("aria-labelledby", SEARCH_INPUT.replace("#", ""));

    // ── Fix 2 & 3: Make the close button keyboard-accessible ──────────────────
    //
    // The <a> has no href, so browsers skip it during Tab navigation.
    // Adding role="button" and tabindex="0" makes it a first-class keyboard target.
    // Without this, Tab exits the dialog, which triggers the widget's focusout
    // handler and closes it — sending focus to the top of the page.
    const closeBtn = overlay.querySelector(CLOSE_BTN_SEL);
    if (closeBtn) {
      closeBtn.setAttribute("role", "button");
      closeBtn.setAttribute("tabindex", "0");

      // Allow Space and Enter to activate the button (standard button contract)
      closeBtn.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault(); // Stop Space from scrolling the page
          closeBtn.click();
        }
      });

      // When the dialog closes via the close button, return focus to the trigger
      closeBtn.addEventListener("click", function () {
        returnFocus();
      });
    }

    // ── Fix 3 & 4: Tab interception and focus trap ────────────────────────────
    //
    // The widget calls input.blur() explicitly inside its own Tab keydown
    // handler. An explicit blur() sets relatedTarget to null, so a focusout
    // capture handler cannot tell whether focus is staying inside the dialog —
    // it always looks like focus is leaving. The widget's focusout handler then
    // closes the dialog.
    //
    // The only reliable fix is to intercept Tab before the widget's keydown
    // handler ever runs. Registering on document in capture phase achieves this:
    // capture fires top-down, so a document capture handler runs before any
    // handler on a descendant element regardless of phase. Combined with
    // stopImmediatePropagation(), the widget's handler never sees the Tab key.
    //
    // Once we own Tab completely, we also manage wrapping (first ↔ last),
    // replacing the previous overlay-level focus trap.
    document.addEventListener(
      "keydown",
      function (e) {
        if (e.key !== "Tab") return;
        if (!isVisible(overlay)) return;
        if (!overlay.contains(document.activeElement)) return;

        const focusable = getFocusable(overlay);
        if (focusable.length === 0) return;

        // Claim the event — widget keydown handlers never see this Tab press
        e.preventDefault();
        e.stopImmediatePropagation();

        const idx = focusable.indexOf(document.activeElement);

        if (e.shiftKey) {
          // Shift+Tab: move to previous element, wrapping from first to last
          const prev = idx <= 0 ? focusable[focusable.length - 1] : focusable[idx - 1];
          prev.focus();
        } else {
          // Tab: move to next element, wrapping from last to first
          const next = idx >= focusable.length - 1 ? focusable[0] : focusable[idx + 1];
          next.focus();
        }
      },
      true // capture phase
    );

    // ── Fix 5 (+ dialog open/close lifecycle) ─────────────────────────────────
    //
    // Watch the overlay for visibility changes. When it becomes visible:
    //   - Hide background content from AT (aria-hidden on siblings)
    //   - Move focus into the dialog (search input)
    // When it is hidden:
    //   - Restore background content visibility for AT
    //   - Return focus to the known trigger control
    let wasVisible = isVisible(overlay);

    const visibilityObserver = new MutationObserver(function () {
      const nowVisible = isVisible(overlay);
      if (nowVisible === wasVisible) return;
      wasVisible = nowVisible;

      if (nowVisible) {
        onDialogOpen(overlay);
      } else {
        onDialogClose(overlay);
      }
    });

    // Observe both inline style changes and class changes (the widget uses both)
    visibilityObserver.observe(overlay, {
      attributes: true,
      attributeFilter: ["style", "class", "hidden"],
    });

    // Handle the case where the dialog is already visible on script load
    if (wasVisible) {
      onDialogOpen(overlay);
    }
  }

  function onDialogOpen(overlay) {
    // Fix 5: hide background from screen readers
    setBackgroundAriaHidden(overlay, true);

    // Move focus to the search input so keyboard users can start typing immediately
    const input = overlay.querySelector(SEARCH_INPUT);
    if (input) {
      // Defer one tick so the overlay is fully rendered/transitioned
      requestAnimationFrame(function () {
        input.focus();
      });
    }
  }

  function onDialogClose(overlay) {
    // Fix 5: restore background content for screen readers
    setBackgroundAriaHidden(overlay, false);
    returnFocus();
  }

  function returnFocus() {
    const trigger = document.querySelector(TRIGGER_SEL);
    if (trigger) {
      // The widget's close sequence moves focus in its own async callback. A
      // short setTimeout ensures our call runs after the widget finishes, so
      // we reliably win the final focus position.
      setTimeout(function () {
        trigger.focus();
      }, 150);
    }
  }

  // ─── Initialisation ──────────────────────────────────────────────────────────
  //
  // The widget injects the overlay dynamically, so we use a MutationObserver
  // rather than relying on DOMContentLoaded alone. Once found, we apply fixes
  // and disconnect the DOM watcher.

  function init() {
    const existing = document.querySelector(OVERLAY_SEL);
    if (existing) {
      applyFixes(existing);
      return;
    }

    // Overlay not in the DOM yet — watch for it
    const domObserver = new MutationObserver(function (_, obs) {
      const overlay = document.querySelector(OVERLAY_SEL);
      if (overlay) {
        obs.disconnect();
        applyFixes(overlay);
      }
    });

    domObserver.observe(document.body, { childList: true, subtree: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const utilityNav = document.querySelector('#utilityNav');
  if (!utilityNav) return;

  const toggle = utilityNav.querySelector('.elementor-menu-toggle');
  if (!toggle) return;

  toggle.setAttribute('aria-label', 'Toggle Secondary Menu');

  let suppressNextClick = false;

  toggle.addEventListener('keyup', function (e) {
    if (e.key === 'Enter' || e.key === ' ') {
      suppressNextClick = true;
    }
  });

  toggle.addEventListener('click', function (e) {
    if (suppressNextClick) {
      suppressNextClick = false;
      e.stopImmediatePropagation();
    }
  }, true);
});
</script>
