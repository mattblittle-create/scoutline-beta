<style id="wp-custom-css">
.accordionVid {
	display: block;
	width: 100%;
}

.accordionVid .elementor-widget-container,
.accordionVid .elementor-html,
.accordionVid .ocelot-video-wrap {
	display: block;
	width: 100%;
}

.accordionVid .ocelot-video-wrap {
	position: relative;
	height: auto;
	padding-top: 56.25%;
	background: #000;
	overflow: hidden;
}

.accordionVid .ocelot-video-wrap iframe {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	border: 0;
	display: block;
}

.office-info-container {
  max-width: calc(100% - 40px) !important;
  margin-left: auto;
  margin-right: auto;
}

/* Keep all flyout submenus above surrounding content */
.ubermenu .ubermenu-submenu {
	z-index: 99999;
}

li.mega-menu-item > a.menu-search-toggle > span {
	color: #fff;
	margin-left: 10px;
}

/* Default flyout behavior */
.ubermenu .ubermenu-item-level-1 > .ubermenu-submenu-drop,
.ubermenu .ubermenu-item-level-2 > .ubermenu-submenu-drop,
.ubermenu .ubermenu-item-level-3 > .ubermenu-submenu-drop {
	left: 100%;
	right: auto;
	top: 0;
}

/* When near the right edge, force submenu to open to the left */
.ubermenu .ubermenu-item-level-1.ubermenu-submenu-open-left > .ubermenu-submenu-drop,
.ubermenu .ubermenu-item-level-2.ubermenu-submenu-open-left > .ubermenu-submenu-drop,
.ubermenu .ubermenu-item-level-3.ubermenu-submenu-open-left > .ubermenu-submenu-drop {
	left: auto;
	right: 100%;
}

/* Prevent very tall submenus from running off the screen */
.ubermenu .ubermenu-submenu-drop {
	max-height: calc(100vh - 40px);
	overflow-y: auto;
	overflow-x: visible;
}

/* Optional: keep submenu width reasonable */
.ubermenu .ubermenu-submenu-drop {
	min-width: 260px;
}
.ubermenu .ubermenu-icon.fas.fa-search::before {
	color: #fff !important;
}

.ubermenu .ubermenu-item a:hover {
	background-color: #4298B5;
}


ul.ubermenu-submenu li a img {
	width: 300px;
	aspect-ratio: auto 300 / 200;
}

.ubermenu-main .ubermenu-item-normal > .ubermenu-target, .ubermenu-main .ubermenu-submenu .ubermenu-target, .ubermenu-main .ubermenu-submenu .ubermenu-nonlink, .ubermenu-main .ubermenu-submenu .ubermenu-widget, .ubermenu-main .ubermenu-submenu .ubermenu-custom-content-padded, .ubermenu-main .ubermenu-submenu .ubermenu-retractor, .ubermenu-main .ubermenu-submenu .ubermenu-colgroup .ubermenu-column, .ubermenu-main .ubermenu-submenu.ubermenu-submenu-type-stack > .ubermenu-item-normal > .ubermenu-target, .ubermenu-main .ubermenu-submenu.ubermenu-submenu-padded {
	padding: 5px 10px;
}

#utilityNav nav ul li.shine {
	background-color: #F0B82D;
	border-radius: 0 0 8px 0;
	color: #000;
}

#utilityNav nav ul li.shine a {
	color: #000 !important;
}

#utilityNav nav ul li.menu-gtranslate {
	padding: 6px 10px;
}

#utilityNav nav ul li.shine img {
	width: 60px;
	height: auto;
}

input.st-default-search-input {
	padding-left: 30px;
}

.st-injected-content-generated a.st-ui-result .st-ui-type-heading {
	color: #0772E4 !important;
}

.st-injected-content-generated a.st-ui-result .st-ui-type-detail {
	color: #66758F !important;
}
.st-injected-content-generated a.st-ui-result:hover .st-ui-type-detail {
	color: #000 !important;
}

form.ftcc-swiftype-search-form {
	display:none;
	position: absolute;
	z-index: 99999 !important;
	right: 90px;
}

form.ftcc-swiftype-search-form.is-open {
	display: block;
	top: 180px;
	right: 75px;
}

img.yes-form-logo {
	max-width: 135px;
}

body.page-id-124295 div.wp-block-column figure img {
	width: 100% !important;
}

form div.gform-body div.gfield, form div.gform-body fieldset.gfield {
	margin: 15px 0px;
}

.preventWrap tr td:last-child a {
	white-space: nowrap;
}

ul.sidebarLinks {
	list-style-type: none;
	padding-left: 0px;
}

ul.sidebarLinks li {
	margin: 7px;
	background-color: #f0b82d;
	border-radius: 10px;
	padding: 10px;
	box-shadow: 0px 0px 1px 1px;
}

ul.sidebarLinks li:before {
	font-family: "Font Awesome 6 Free";
	content: "\f35a";
	margin-right: 7px;
	position: relative;
	top: 2px;
}

ul.sidebarLinks li a {
	font-size: 16px;
	color: #000;
	text-decoration: none;
}

form div.gform-body fieldset.gfield input {
	margin-bottom: 10px;
}

form div.gform-body button.gfield_choice_all_toggle {
	padding: 7px 14px;
}

.contactGutBlock {
	border-bottom: solid #f0b92e;
	padding-bottom: 16px
}

.contactGutBlock svg, .contactGutBlock i {
	font-size: 28px;
	color: #000;
}

.contactGutBlock p {
	font-size: 16px;
	margin-top: 15px;
}

.contactGutBlock .iconTitle {
	font-weight: 700;
}

.contactGutBlock .iconContent {
	
}

.elementor-118646 .elementor-element.elementor-element-c130c08 ul li a {
    color: #2a7791;
    font-size: 18px;
    line-height: 1.5;
}

.wp-block-details summary {
    cursor: pointer;
    font-size: 1.2em;
    font-weight: 600;
    padding-top: 20px;
	  color: #2a7791;
}

a.wp-block-button__link.wp-element-button {
    color: rgb(255, 255, 255);
    background-color: rgb(66, 152, 181);
    text-decoration: none;
    margin: 0px 0px 20px 0px;
    border-radius: 0px;
}

a.wp-block-button__link.wp-element-button:hover {
		background-color: #2A7791;
}

h2.wp-block-heading {
    font-size: 2em;
		padding-top: 25px;
}

h3.elementskit-info-box-title {
    font-size: 1.3em !important;
    line-height: 1.2em !important;
}




.teaser-news {
	 padding-top: 17px;
	 padding-bottom: 14px;
	 border-bottom: 2px solid palette(black);
}
 .teaser-news .teaser-date {
	 display: flex;
	 justify-content: center;
	 align-items: center;
	 width: 10%;
	 text-align: center;
}
 .teaser-news .teaser-date .the-day {
	 display: block;
	 font-size: calcRem(32);
	 line-height: calcRem(32);
	 font-weight: 400;
}
 .teaser-news .teaser-date .the-month {
	 display: block;
	 font-size: calcRem(16);
	 font-weight: 700;
	 line-height: calcRem(26);
	 text-transform: uppercase;
	 letter-spacing: 2px;
}
 .teaser-news .teaser-date .the-year {
	 display: block;
	 font-size: calcRem(14);
	 line-height: calcRem(6);
}
 .teaser-news .teaser-header {
	 display: flex;
	 align-items: center;
	 width: 86%;
}
 .teaser-news .teaser-header h2.news-title {
	 display: inline-block;
	 margin: 0;
	 padding: 0;
	 font-size: calcRem(16);
	 font-weight: 400;
	 line-height: calcRem(22);
}
.row-flex {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-wrap: wrap;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: space-between;
    -ms-flex-pack: justify;
    justify-content: space-between;
    padding: 0 15px;
}
.crEventsNews header.tribe-events-widget-events-list__header, .crEventsNews .tribe-events-widget-events-list__event-datetime-wrapper, .crEventsNews .tribe-events-widget-events-list__view-more {
	display: none;
}
.teaser-news .teaser-date .the-day, .crEventsNews .tribe-common--breakpoint-xsmall.tribe-events-widget .tribe-events-widget-events-list__event-date-tag-daynum {
    display: block;
    font-size: 2rem;
    line-height: 2rem;
    font-weight: 400;
}
.panel-news-events-feed-teaser .teaser-event .teaser-date .the-month, .panel-news-events-feed-teaser .teaser-news .teaser-date .the-month, .crEventsNews .tribe-common--breakpoint-xsmall.tribe-events-widget .tribe-events-widget-events-list__event-date-tag-month {
    line-height: 1rem;
}
.teaser-news .teaser-date .the-month, .crEventsNews .tribe-common--breakpoint-xsmall.tribe-events-widget .tribe-events-widget-events-list__event-date-tag-month {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.625rem;
    text-transform: uppercase;
    letter-spacing: 2px;
	font-family: "Source Sans 3";
	color: #000;
}
.panel-news-events-feed-teaser .teaser-event .teaser-title, .panel-news-events-feed-teaser .teaser-news .teaser-header {
	width: 84%;
}
    .teaser-news .teaser-header h2.news-title, .crEventsNews .tribe-common .tribe-common-anchor-thin {
        font-size: 1.125rem;
        line-height: 1.5rem;
    }
.teaser-news .teaser-header h2.news-title a, .crEventsNews .tribe-common .tribe-common-anchor-thin {
	color: #000;
	font-weight: 400;
	text-decoration: underline;
}
.teaser-news, .crEventsNews .tribe-events-widget-events-list__event-row {
    padding-top: 17px;
    padding-bottom: 14px;
    border-bottom: 2px solid #000;
}

.crEventsNews .tribe-events-widget .tribe-events-widget-events-list__event-row {
	margin-bottom: 0px !important
}
.crEventsNews time {
	flex-direction: column-reverse !important;
}
.crEventsNews .tribe-events-widget-events-list__event-wrapper {
	display: flex !important;
	align-items: center !important;
}
.crEventsNews .tribe-events-widget .tribe-events-widget-events-list__event-date-tag-datetime {
	row-gap: 4px;
}
.crEventsNews .tribe-compatibility-container, .crEventsNews div.feed {
	margin-top: 0px !important;
}

.crSpotlight .wp-block-latest-posts__featured-image, .blogFeed .wp-block-latest-posts__featured-image {
	height: 250px;
	overflow: hidden;
}

.crSpotlight .wp-block-latest-posts__featured-image img, .blogFeed .wp-block-latest-posts__featured-image img {
	height: 100%;
 object-fit: cover;
}

.crEventsHeading, .crNewsHeading, .crSpotlightHeading {
	border-bottom: solid 2px;
	align-items: end !important;
}

.crEventsHeading a, .crNewsHeading a, .crSpotlightHeading a {
	color: #000;
	text-transform: uppercase;
	letter-spacing: 2px;
	font-size: 0.875rem;
	text-decoration: none;
}

.crEventsHeading p, .crSpotlightHeading p {
	margin-bottom: 0px;
}
.st-ui-container-footer_bar > .st-ui-footer > .st-ui-search-summary > .st-query-present {
	color: black;
}

#utilityNav nav ul li.shine a:hover,
#utilityNav nav ul li.shine a:focus {
	background-color: #F3C758;
}
/*Max Menu CSS*/
/* ================================
   Max Mega Menu - Base Styling
================================ */
#mega-menu-menu-1 {
	background: #393939 !important;	
}
.mega-menu-row{
	background:#333 !important;
}
#mega-menu-141903-0-1,#mega-menu-141903-0-2,#mega-menu-141900-0-1,#mega-menu-141900-0-2,#mega-menu-141900-0-1,#mega-menu-141901-0-1,#mega-menu-141901-0-2,#mega-menu-141901-0-3,#mega-menu-141901-0-4,#mega-menu-141902-0-1,#mega-menu-141902-0-2,#mega-menu-141902-0-3,#mega-menu-141899-0-1,#mega-menu-134813-0-1,#mega-menu-134813-0-2,#mega-menu-141902-0-4,#mega-menu-141899-0-2{
	    padding: 10px 0px 10px 0px !important;

}

 
/* ================================
   Mega Menu Alt Image Blocks
================================ */
.mega-menu-alt-image {
	color: #fff !important;
	font-weight: bold;
	font-size: 14px;
	align-content: center;
	display: block;
}

.mega-menu-alt-image span {
	display: block;
	margin-bottom: 10px;
}

.mega-menu-alt-image:hover {
	background-color: #2a7791;
	color: #fff;
}

/* ================================
   Main Menu Links
================================ */
.mega-menu .mega-menu-link {
	font-size: 14px !important;
	text-transform: uppercase !important;
}

.mega-menu,
.mega-menu .mega-menu-item,
.mega-menu .mega-menu-item a {
	align-content: center;
}
.mega-menu-link{
 background:#393939 !important;
}
.mega-menu-link:hover{
	background:#2a7791 !important;
}
/* ================================
   Sub Menu Layout
================================ */
.mega-menu .mega-sub-menu .mega-menu-item {
	padding: 0px !important;
	 
}
.mega-menu-alt-image{
	padding:5px !important;
}
 
.mega-sub-menu a{
	background:#333 !important;
}
.mega-menu-link {
 background:#393939 !important;
}
.mega-menu .mega-sub-menu .mega-menu-item a {
	text-transform: capitalize !important;
	padding: 10px !important;
	color: #fff !important;
}

.mega-menu .mega-sub-menu {
	background: #333  !important;
}

/* ================================
   Flyout Menu Styling
================================ */
.mega-menu .mega-menu-flyout {
	background: #333 !important;
}

.mega-menu-flyout .mega-sub-menu {
	background-color: #333  !important;
}

.mega-menu-flyout .mega-sub-menu .mega-menu-item .mega-menu-link {
	background-color: #333  !important;
	font-weight: bold !important;
}

.mega-menu-flyout .mega-sub-menu .mega-menu-item:hover {
	background-color: #333  !important;
}
.mega-menu-flyout .mega-sub-menu .mega-menu-item .mega-menu-link:hover {
	background-color: #2a7791 !important;
}
/* ================================
   Hover States
================================ */
.mega-menu .mega-menu-item:hover {
	background-color: #2a7791 !important;
	color: #fff !important;
}
.mega-menu-item:hover {
	color: #fff !important;
}
.mega-menu .mega-menu-item a:hover {
	color: #fff !important;
}
/* ================================
   Sub Menu Accents
================================ */
.sub-menu-items-2-row {
	border-top: solid 2px #f1b825 !important;
}

.mega-sub-menu a.mega-menu-link:before {
	color: rgb(240, 184, 45) !important;
}

/* ================================
   Make a Gift Button
================================ */
#mega-menu-item-custom_html-8,#mega-menu-item-custom_html-9,#mega-menu-item-custom_html-10,#mega-menu-item-custom_html-11 {
	background:#333  !important;
}

.make-a-gift-btn-container,.canvas-btn-container {
	display: flex;
	justify-content: center;
	margin: 0px 0px 10px 0px; 
	font-weight:bold !important;
}

.mega-sub-menu .make-a-gift-btn,.mega-sub-menu .canvas-nav-btn {
	display: block;
	background: #2a7791 !important;
	transition: background 0.3s ease-in;
	color: #fff;
	width: 200px !important;
	text-align: center;
	margin: 0px 0px 0px 0px !important;
}

.make-a-gift-btn:hover,.canvas-nav-btn:hover {
	background: #266B83 !important;
}

.make-a-gift-btn:hover a,.canvas-nav-btn:hover a {
	color: #000 !important;
}

.make-a-gift-btn a,.canvas-nav-btn a {
	text-decoration: none !important;
}
.elementor-element-b5d605f{
	z-index:12;
}

p > a {
	text-decoration: underline !important;
}

a.wp-block-button__link.wp-element-button {
    background-color: #34788e;
}

ul.child-sidebar-menu > li.page_item.menu-item > a {
	color: #2a7791;
}
