					<div class="ekit-wid-con" >
            <div class="elementskit-info-image-box ekit-image-box text-center simple-card" >

                
                <div class="elementskit-box-header image-box-img-center">

                    <img decoding="async" width="600" height="400" src="https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-2025-Graduate.png" class="attachment-full size-full wp-image-205271" alt="" srcset="https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-2025-Graduate.png 600w, https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-2025-Graduate-400x267.png 400w, https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-2025-Graduate-540x360.png 540w, https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-2025-Graduate-200x133.png 200w" sizes="(max-width: 600px) 100vw, 600px" />
                </div>
                
                <div class="elementskit-box-body ekit-image-box-body">
                    <div class="elementskit-box-content ekit-image-box-body-inner">
                                                <h3 class="elementskit-info-box-title">

                        Associate in Applied Science
                        
                    </h3>
                                                            <div class="elementskit-box-style-content">
                        Complete two years of focused, hands-on training that prepares you to enter the workforce in a high-demand career or continue your education by transferring to a four-year institution.                     </div>
                                    </div>

                                <div class="elementskit-box-footer">
                    <div class="box-footer">
                        <div class="btn-wraper">
