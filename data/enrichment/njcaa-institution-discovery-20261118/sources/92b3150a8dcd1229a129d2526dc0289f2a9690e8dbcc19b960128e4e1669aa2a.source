				<div class="elementor-element elementor-element-eba0bd4 ekit-equal-height-enable elementor-widget elementor-widget-elementskit-image-box" data-id="eba0bd4" data-element_type="widget" data-e-type="widget" data-widget_type="elementskit-image-box.default">
					<div class="ekit-wid-con" >
            <div class="elementskit-info-image-box ekit-image-box text-center simple-card" >

                
                <div class="elementskit-box-header image-box-img-center">

                    <img loading="lazy" decoding="async" width="400" height="267" src="https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-Culinary-Student-400x267.png" class="attachment-medium size-medium wp-image-205277" alt="" srcset="https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-Culinary-Student-400x267.png 400w, https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-Culinary-Student-540x360.png 540w, https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-Culinary-Student-200x133.png 200w, https://faytechcc.edu/wp-content/uploads/2026/07/FTCC-Culinary-Student.png 600w" sizes="(max-width: 400px) 100vw, 400px" />
