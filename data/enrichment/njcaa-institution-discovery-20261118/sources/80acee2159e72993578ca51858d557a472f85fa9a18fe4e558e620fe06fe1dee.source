          <div class="phighlight__card-close--content">
            <h3 class="phighlight__card-title info__card-name">The Ticket to Transfer</h3>
            <div class="phighlight__card-prog--type">
      <div class="field field--name-field-sel-prog-type field--type-entity-reference field--label-hidden field__items">
              <div class="field__item">Associate of Arts</div>
