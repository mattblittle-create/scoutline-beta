}</style><meta name="theme-color" content="#FFFFFF"><link rel="icon" href="https://www.macc.edu/wp-content/uploads/2021/06/cropped-MACC-Icon-512-x-512-32x32.png" sizes="32x32" /><link rel="icon" href="https://www.macc.edu/wp-content/uploads/2021/06/cropped-MACC-Icon-512-x-512-192x192.png" sizes="192x192" /><link rel="apple-touch-icon" href="https://www.macc.edu/wp-content/uploads/2021/06/cropped-MACC-Icon-512-x-512-180x180.png" /><meta name="msapplication-TileImage" content="https://www.macc.edu/wp-content/uploads/2021/06/cropped-MACC-Icon-512-x-512-270x270.png" /> <style id="wp-custom-css"> body {
 background-color: #fff !important;}
h1.entry-title {
 color: #000000;
}
.education-pro-red .home-top .wrap {background-color: #cd2028;}
.education-pro-red .nav-primary{
 background-color: #cd2028;}
.title-area {
 box-shadow: 3px 2.75px 10px rgba(0, 0, 0, 0.31);
}
.home-featured {
 box-shadow: 3px 2.75px 10px rgba(0, 0, 0, 0.31);}
.education-pro-red .site-header { 
 box-shadow: 3px 2.75px 10px rgba(0, 0, 0, 0.31);
}
.education-pro-red a {
 color: #801417;
}
/* Remove post meta data */
.entry-footer {display: none;}
div#respond {display: none;}  .widget-area .widget-title, .widget-area .widget-title a {
 color: #000000;
}
h2.elementor-heading-title {color:#cd2028;}
.slide-excerpt h2 a:hover {color:#9a9a9a !important;}
.slide-excerpt h2 a {color:#444 !important;}
.education-pro-red button {background-color: transparent;}
.education-pro-red button:hover {background-color: transparent;}
.elementor-kit-11220 label {
 color: #000000;
}
ol, ul {
 font-weight: bolder;
}
.tablepress-id-40 td {
 text-align: center;
}
.tablepress-id-40 th {
 text-align: center;
 font-size: 1.3em;
}
.tablepress-id-41 td {
 text-align: center;
}
.tablepress-id-41 th {
 text-align: center;
 font-size: 1.3em;
}
.tablepress-id-42 td {
 text-align: center;
}
.tablepress-id-42 th {
 text-align: center;
 font-size: 1.3em;
}
.wp-block-button__link {
 background-color: #dad9d7;
}
h1.page-banner__title {
 padding: 0px 0px;
}
.page-banner__content {
 padding: 0px 15px;
}
/*added for side menus*/
.generic-content {
 padding: 40px 0px;
}
/*added for links*/
.education-pro-red p a:link {
 color: blue;
 text-decoration: underline;
}
.elementor-widget-text-editor li a:link, .elementor-widget-container li a:link {
 color: blue;
 text-decoration: underline;
}
.education-pro-red p a:visited, .elementor-widget-text-editor li a:visited {
 color: purple;
 text-decoration: underline;
}
.elementor-widget-ma-navmenu.jltma-dropdown-breakpoints-tablet .jltma-nav-menu__main.jltma-layout-vertical.jltma-vertical-type-normal > ul > li > a {
 text-decoration: none;
 }
/* remove left padding on front page main menu 
ul#menu-main-menu-01 {
 padding-left: 0px !important;
 }
*/
.education-pro-red .button,
.education-pro-red .genesis-nav-menu .sub-menu .current-menu-item > a:hover,
.education-pro-red .genesis-nav-menu .sub-menu a,
.education-pro-red .genesis-nav-menu li a:hover,
.education-pro-red .genesis-nav-menu li.current-menu-item > a,
.education-pro-red .home-bottom,
.education-pro-red .widget-area .widget.enews-widget,
.education-pro-red button,
.education-pro-red input[type="button"],
.education-pro-red input[type="reset"],
.education-pro-red input[type="submit"] {
 background-color: #646564;
}
/*dropdown menu*/
.jltma-nav-menu__main.jltma-layout-vertical.jltma-vertical-type-normal > ul > li ul {
 width: 300px;
}
/*accordian styles */
.accord h3 {
 color:#ffffff;
}
.elementor-post-date {
 color: black;
}
[type="submit"], .ma-cf.jltma-wpforms .wpforms-form [type="submit"] {
 background:
#cd2028;
 border:
1px solid #cd2028;
 border-radius:
5px;
 color: #fff;
}
.ma-cf [type="submit"]:hover, .ma-cf.jltma-wpforms .wpforms-form [type="submit"]:hover {
 background:
#fff;
 color: #cd2028;
}
.tablepress thead .dt-orderable-asc:hover, .tablepress thead .dt-orderable-desc:hover, .tablepress thead .dt-ordering-asc, .tablepress thead .dt-ordering-desc {
 background-color: #3d3e17;
 color: #ffffff;
}
h3.e-n-accordion-item-title-text {
 color: white;
}
:focus {
