 } </style> <style id="custom-background-css"> body.custom-background { background-color: #ffffff; } </style> <style class="wpcode-css-snippet">.entry-content p a {
 color: #0000EE;
 text-decoration: underline;
}
.entry-content p a:hover {
 color: #cd2028;
 text-decoration: underline;
}
