<script type="text/javascript" src="/_resources/js/jquery.jfeed.js">//</script><script type="text/javascript">
			if (!window.console) console = {log: function() {}};

			var entryobj = {};
			var alertactive = false;

			function updatefeed()
			{
				jQuery.getFeed({
					url: '/_resources/php/wnl/alerthandler.php?path=http://www.getrave.com/rss/ncc/channel1',
					success: function(feed) {

						entry = feed.items[0];

						if (!entry || !entry.description || entry.description.toUpperCase() === "ALL CLEAR" || entry.title.toUpperCase() === "ALL CLEAR")
						{
							jQuery("#alertBar").attr("style", "display: none;");
							jQuery("#alertBar").hide();
							return;
						}

						if (!alertactive)
						{
							initalerthtml();	//init alert html
							alertactive = true;
						}

						entryobj = {
							description:entry.description.toString(),
							title:entry.title.toString(),
							link:entry.link.toString()
						};

						updatealerthtml(entryobj);

						jQuery("#alertBar").attr("style", "display: block;");
						jQuery("#alertBar").show();

					},
					cache: false
				});
			}

			function initalerthtml()	//init alert html
			{
			var alertOutput = '<span id="alertTitle"> </span><br><span id="alertContent"> </span><span id="alertLinkHide"> - <span id="alertLink"><a href="' + entry.link + '">Read More...</a></span></span>';

				
						jQuery("#alertBarContent").html(alertOutput);
					
			}

			function updatealerthtml(updateobj)
			{
				jQuery("#alertTitle").html(updateobj.title);
				jQuery("#alertContent").html(updateobj.description);

				if (updateobj.link)
				{
					jQuery("#alertLink a").attr("src",updateobj.link);
					jQuery("#alertLinkHide").attr("style", "display: block;");
					jQuery("#alertLinkHide").show();
				}
				else
				{
					jQuery("#alertLinkHide").attr("style", "display: none;");
					jQuery("#alertLinkHide").hide();
				}

				if (updateobj.clear)
				{
					jQuery("#alertBar").attr("style", "display: none;");
					jQuery("#alertBar").hide();
				}
				else
				{
					jQuery("#alertBar").attr("style", "display: block;");
					jQuery("#alertBar").show();
				}
			}

			function startfeedupdater()
			{
				updatefeed();
				setInterval(updatefeed,60000);	//update feed every 60s
			}

			jQuery(document).ready(startfeedupdater);


		</script>
      		
      
      		
