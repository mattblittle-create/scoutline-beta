/* Desktop */

.program-results {
    margin-bottom: 10px;
    font-size: 36px;
    font-weight: 700;
    color: #0e2245;
}

.fwpl-row.el-49w6yc .fwpl-item.el-sjcm4m {
    color: #000000;
    font-family: Calibri;
}

.elementor-icon-wrapper {
    display: flex;
}

.gform-loader {
    position: absolute !important;
    bottom: 0;
}

@media (min-width: 1025px) {
    .mobile-filter-programs {
        position: static;
        transform: none !important;
        width: auto;
        height: auto;
        box-shadow: none;
    }

    .filter-overlay,
    .open-filters,
    .close-filters {
        display: none;
    }
}

/* Mobile */
@media (max-width: 1024px) {

    .filter-program-finder .elementor-widget-html.close-button-filter {
    height: 60px !important;
}

    .degree-content-sec .degree-right-col.mobile-filter-programs {
        position: fixed;
        top: 0;
        right: 0;
        width: 90%;
        max-width: 350px;
        height: 100vh;
        background: #fff;
        z-index: 99999;
        overflow-y: auto;
        transform: translateX(100%);
        transition: transform .35s ease;
        box-shadow: -5px 0 20px rgba(0,0,0,.2);
        padding: 0 20px !important;
    }

    .degree-content-sec .degree-right-col.mobile-filter-programs.active {
        transform: translateX(0);
    }

    .filter-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        opacity: 0;
        visibility: hidden;
        transition: .3s;
        z-index: 99998;
    }

    .filter-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .close-filters {
        position: absolute;
        top: 15px;
        right: 15px;
        border: 0;
        background: none;
        font-size: 30px;
        cursor: pointer;
        padding: 0 !important;
    }

    .open-filters {
                padding: 10px 18px;
        border: 0;
        background: #0e2245;
        color: #fff;
        border-radius: 5px;
        cursor: pointer;
			        margin-bottom: 5px;
    }

    body.filter-open {
        overflow: hidden;
    }
	
	.program-results {
    font-size: 24px;
}
	
}

@media screen and (max-width:767px){
	.facetwp-selections ul span.facetwp-selection-label {
			display: flex;
			margin-bottom: 10px;
	}
	
	.elementor-icon-wrapper {
    display: flex;
		justify-content:center
}
	
	
}

@media screen and (max-width:400px){
	.degree-content-sec .degree-right-col.mobile-filter-programs {
			max-width: 300px;
	}
}




.lede {
    font-family: 'Inter' !important;
}

span.permanaent-marker-text {
    line-height: 1;
    letter-spacing: -.005em;
    transform: rotate(-2.5deg);
    transform-origin: left center;
    margin: .06em 0 .04em;
    display: block;
}

.hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 6px;
}

html .btn-ghost {
    border-color: rgba(255, 255, 255, .55) !important;
    color: #FFFFFF;
    text-decoration: none !important;
}

.btn {
    display: inline-block;
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none !important;
    padding: 16px 30px;
    border: 2px solid transparent;
    transition: background .18s ease, color .18s ease, border-color .18s ease;
}

.btn-ghost:hover {
    background: #ffffff;
    color: #111C3A;
    border-color: #FFFFFF;
}

.btn-red:hover {
    background: #C4241F;
}

html .btn-red {
    background: #E8342F;
    color: #FFFFFF;
    text-decoration: none !important;
}

.prog-list {
    list-style: none;
    margin: 0;
    padding: 0 !important;
}

.prog-list li {
    font-size: 15.5px;
    color: #DCE2EF !important;
    padding: 7px 0 7px 20px;
    position: relative;
    font-family: 'Inter' !important;
}

.prog-list li::before {
    content: "";
    position: absolute;
    left: 0;
