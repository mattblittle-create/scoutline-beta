}
	
	
}



label {
    display: none;
}

form.our-team-search {
    margin-bottom: 30px;
}

form.our-team-search .our-team-search-controls .form-wrapper {
    display: flex;
}

form.our-team-search .our-team-search-controls input {
    width: 100%;
    height: 40px;
    padding: 5px 15px;
	    border-radius: 4px !important;
    border-top-right-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
}

form.our-team-search .our-team-search-controls button {
    background: #0e2245;
    border: 2px solid #0e2245;
	border-radius: 4px !important;
    border-top-left-radius: 0px !important;
    border-bottom-left-radius: 0px !important;
}

form.our-team-search .our-team-search-controls button i.icon-search {
    color: #ffffff;
}

form.our-team-search .our-team-search-controls  a.clear-search-button {
    margin: 10px 0;
    display: flex;
    background-color: #092245;
    font-size: 18px;
    font-weight: bold;
    padding: 10px 25px 10px 25px;
    max-width: max-content;
    color: #ffffff;
    text-decoration: none !important;
	border-radius: 4px !important;
}

nav.our-team-pagination a.page-numbers {
    font-family: 'Calibri';
    width: 33px;
    height: 33px;
    justify-content: center;
    align-items: center;
    display: flex;
	font-size:19px;
}

nav.our-team-pagination span.page-numbers.dots {
    font-size: 22px;
    font-weight: 500;
	
}

nav.our-team-pagination a.page-numbers:hover {
    background: #022343;
    color: #ffffffff;
}

nav.our-team-pagination a.next.page-numbers {
    text-decoration: none !important;
}

nav.our-team-pagination a.prev.page-numbers {
    text-decoration: none !important;
}

.copyrights-line p { font-size: 15.52px; font-weight: 700; }
.footer-bottom-links ul { padding-left: 0 !important; padding-bottom: 0; }


h3.team-program-heading {
    margin: 0;
    color: #0e2245;
    display: flex;
    clear: both;
    font-size: 20px;
    align-items: center;
    font-weight: 700;
}

a.team-program-button {
    background-color: #092245;
    font-size: 18px;
    font-weight: bold;
    padding: 20px 35px;
    display: flex;
    max-width: max-content;
    color: #ffffff !important;
    text-decoration: none !important;
    margin-top: 10px;
    line-height: 1;
	border-radius:4px
}

a.team-program-button:hover {
    background: #092245DE;
}

