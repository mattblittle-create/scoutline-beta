<script>
jQuery(document).ready(function($) {
    // Select the specific textarea by ID or class
    $('textarea#input_6_5').attr('tabindex', '0');
});
</script>



<script>
(function () {
  let lastFocusedElement = null;

  // Capture the opener BEFORE dialog opens
  document.addEventListener('click', function (e) {
    // Heuristic: element that opens the AI search
    if (
      e.target.closest('[aria-label*="Search"], [data-open-search], .search-toggle')
    ) {
      lastFocusedElement = document.activeElement;
    }
  }, true);

  // Close button inside iframe
  document.addEventListener('click', function (e) {
    const closeBtn = e.target.closest('#display-close-x');
    if (!closeBtn) return;

    // Delay allows iframe/dialog JS to finish closing
    setTimeout(() => {
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      }
    }, 50);
  }, true);

  // ESC key support
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      setTimeout(() => {
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        }
      }, 50);
    }
  }, true);
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll(
        'li.mega-menu-item a > button'
    ).forEach(function (button) {
        const anchor = button.closest('a');

        // Move button outside <a>
        anchor.parentNode.insertBefore(button, anchor);

        // Remove <a>
        anchor.remove();
    });
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {
  document
    .querySelectorAll('li.mega-menu-item-has-children > a')
    .forEach(function(anchor) {
      anchor.setAttribute('aria-has-popup', 'true');
    });
});
</script>

<script>

let lastFocusedElement = null;
const searchButton = document.querySelector('.halda-conversational-search');
const iframe = document.querySelector('#halda-conversational-search-iframe');

// STEP 1: Capture the button BEFORE modal opens
searchButton.addEventListener('click', () => {
  lastFocusedElement = searchButton;
});

// STEP 2: Poll for iframe visibility changes
const observer = new MutationObserver(() => {
  if (iframe) {
    // Check if iframe is hidden / modal closed
    const isClosed = iframe.classList.contains('conversational-search-closed') || iframe.style.display === 'none';
    if (isClosed && lastFocusedElement) {
      lastFocusedElement.focus();  // Restore focus to the search button
      lastFocusedElement = null;
    }
  }
});

if (iframe) {
  observer.observe(iframe, { attributes: true, attributeFilter: ['class', 'style'] });
}

	
</script>


