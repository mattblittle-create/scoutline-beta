.work-together-section {
    background: #dce7f3;
    padding: 70px 25px 45px;
}

.work-together-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 45px;
}

.work-together-header h2 {
    margin: 0 0 10px;
    color: #10254a;
    font-size: 42px;
    line-height: 1.1;
    font-weight: 700;
}

.work-together-header p {
    margin: 0;
    color: #34445d;
    font-size: 16px;
}

/* Grid */

.work-cards {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

/* Card */

.work-card {
    position: relative;
    min-height: 330px;
    padding: 25px 25px 25px;
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content:center ;

    transition:
        background-color 0.3s ease,
        transform 0.3s ease;
	max-height: 330px;
}

/* Icon */

.card-icon {
    border-radius: 50%;
    background: #f0f4f8;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 12px;

    font-size: 17px;
    color: #172b4d;
	padding: 10px;
}

/* Content */

.card-content {
    text-align: center;
    width: 100%;
}

.card-content h3 {
    margin: 0 0 6px;
    color: #14284b;
    font-size: 17px;
    line-height: 1.2;
}

.short-text {
    margin: 0;
    color: #6b7481;
    font-size: 12px;
}

/* Full description */

.full-text {
    max-height: 0;
    opacity: 0;
    overflow: hidden;

    margin: 0;
    color: #fff;
    font-size: 13px;
    line-height: 1.5;

    transition:
        max-height 0.35s ease,
        opacity 0.25s ease,
        margin 0.35s ease;
}

/* Toggle */

.card-toggle {
    position: absolute;
    top: 8px;
    right: 8px;

    width: 25px;
    height: 25px;

    border: 0;
    background: transparent;

    color: #8b96a5;
    font-size: 18px;
    line-height: 1;

    cursor: pointer;
    z-index: 5;
}

.close-icon {
    display: none;
}

/* --------------------------------
   HOVER / OPEN STATE
-------------------------------- */

.work-card:hover,
.work-card.active {
    background: #142b50;
    transform: translateY(-2px);
}

.work-card:hover .card-icon,
.work-card.active .card-icon {
    background: rgba(255,255,255,0.12);
    color: #fff;
}

.work-card:hover h3,
.work-card.active h3 {
    color: #fff;
}

.work-card:hover .short-text,
.work-card.active .short-text {
    display: none;
}

.work-card:hover .full-text,
.work-card.active .full-text {
    max-height: 150px;
    opacity: 1;
    margin-top: 8px;
}

.work-card:hover .plus-icon,
.work-card.active .plus-icon {
    display: none;
}

.work-card:hover .close-icon,
.work-card.active .close-icon {
    display: block;
}

.work-card:hover .card-toggle,
.work-card.active .card-toggle {
    color: #fff;
}

/* Note */

.cards-note {
    text-align: center;
    margin-top: 12px;

    font-size: 11px;
    color: #697789;
    font-style: italic;
} 

.card-title .elementor-widget-container {
    margin: 0 !important;
}

.work-card p {
    margin: 0 !important;
}

.work-card:hover, .work-card.active {
    text-align: left;
    align-items: flex-start;
}

.work-card:hover .card-title, .work-card.active .card-title, .work-card:hover .full-text, .work-card.active .full-text{
    text-align:left;
    color:#ffffff !important;
}

.work-card:hover .card-title h2, .work-card.active .card-title h2{
    color:#ffffff !important;
}


.work-card:hover .card-icon i,
.work-card.active .card-icon i{
	color:#ffffff !important
	
}

h3.elementor-icon-box-title {
    line-height: 1;
    margin-bottom: 10px !important;
}

.plus-absolute {
    position: absolute;
    top: 15px;
    right: 15px;
    transition:transform .6s ease;
}

.work-card:hover .plus-absolute, .work-card.active .plus-absolute{
    transform: rotate(
45deg);
}

.work-card:hover .plus-absolute h2, .work-card.active .plus-absolute h2{
    color:#ffffff;
}

div.gform_confirmation_message {
    color: #ffffff;
	font-family:'Calibri'
}

.gform_wrapper.gravity-theme .gfield_validation_message, .gform_wrapper.gravity-theme .validation_message {
    color: red !important;
}

@media screen and (max-width:1024px){
	.work-card {
			min-height: 400px;
	}
}

@media screen and (max-width:970px){
	.work-card {
			min-height: 455px;
	}

	.work-card:hover .full-text, .work-card.active .full-text {
			max-height: unset;
	}
}

@media screen and (max-width:767px){
	.work-card {
			max-height: unset;
			min-height: unset;
	}
}

.team-member {
    flex-basis: calc(33.33% - 15px);
}

.our-team-wrapper {
    display: flex;
    gap: 40px 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.team-member .team-image {
    position: relative;
    padding-bottom: 100%;
	    overflow: hidden;
}

.team-member .team-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
	    transition: all 0.5s ease-in-out;
    -webkit-transition: all 0.5s ease-in-out;
    -moz-transition: all 0.5s ease-in-out;
}

.team-member .team-image:hover img {
    transform: scale(1.1);
}

.team-modal-content-wrapper .team-modal-image img {
    object-fit: cover;
    object-position: top;
	aspect-ratio:1;
	width: 100%;
}

.team-member .team-content {
    margin-top: 20px;
}

