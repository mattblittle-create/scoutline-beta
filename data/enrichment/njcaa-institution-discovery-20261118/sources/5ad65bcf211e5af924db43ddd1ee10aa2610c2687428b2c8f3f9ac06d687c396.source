	<style>
		/* Chatbot popup styles */
		#chatbot-popup {
			display: none;
			z-index: 99999;
			position: fixed;
			bottom: 20px;
			right: 20px;
			width: 370px;
			height: 500px;
			box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
			border-radius: 20px;
			overflow: hidden;
			display: flex;
			flex-direction: column;
		}

		#chatbot-header {
			background-color: #001e61;
			color: whitesmoke;
			padding: 13px 20px;
			font-size: 16px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			height: 50px;
		}

		#chatbot-scroll-container {
			flex: 1;
			overflow-y: auto;
  			-webkit-overflow-scrolling: touch;
  			overscroll-behavior: contain;
		}

		#webchat {
			flex: 1;
			width: 100%;
			height: 100%;
			overflow-y: auto;
		}


		#close-button {
			cursor: pointer;
			font-size: 20px;
		}


		#open-chat {
			z-index: 99998;
			position: fixed;
			bottom: 20px;
			right: 20px;
			background-color: #001e61;
			color: white;
			border: none;
			border-radius: 50%;
			width: 70px;
			height: 70px;
			cursor: pointer;
			display: flex;
			justify-content: center;
			align-items: center;
			font-size: xx-large;
		}

		.webchat__suggested-action__text.webchat__suggested-actions__button-text{
			color: black !important;
		}
		.webchat__link-definitions__list-item-text{
			color: black !important;
		}
		/* Responsive overrides for mobile */
		@media (max-width: 600px) {
		#chatbot-popup {
			width: 70vw;
			height: 70vh;
			bottom: 0;
			right: 0;
			border-radius: 0;
		}


		#chatbot-header {
			font-size: 18px;
			padding: 16px;
		}


		#open-chat {
			bottom: 16px;
			right: 16px;
			width: 60px;
			height: 60px;
			font-size: 20px;
		}


		.main {
			margin: 10px;
			padding: 12px;
		}


		#heading {
			font-size: 20px;
			padding: 14px;
		}
		}
	</style>
	

