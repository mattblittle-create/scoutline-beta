<section class="accent-programs-section ov-hidden nav-section" id="">
    <div class="offset-x-desktop-162">
        <div class="max-w-container w-1596">

            <div class="left-image-container accent-program smaller-image ">
                <div class="image-wrap left-side">
                                        <img fetchpriority="high" decoding="async" class="image" src="https://www.ccm.edu/wp-content/uploads/2026/11/Commencement_26_JoeG_408.jpg" alt="Graduating student high five's Titus the Titan at County College of Morris Commencement" width="618" height="430">
                </div>
                <div class="content-wrap right-side" > <!-- data-lenis-prevent -->
                    <div class="inner-wrap">
                                                    <div class="subheading">The CCM Foundation</div>
                                                <h4 class="txt-size-62 main-title">Fuel the Future!</h4>
                        <div class="txt-size-18 description">Your partnership with the County College of Morris Foundation opens doors to affordable education, empowers students to achieve their goals, and strengthens our community through scholarships, innovative programs and campus improvements. With over $300,000 in scholarships awarded to over 300 students each year, your generosity makes a BIG impact.  <strong>Give today to help shape tomorrow and discover the many ways you can make a difference.</strong></div>
                        <div class="btns-wrap">
                                                                                        <a href="https://wl.donorperfect.net/weblink/weblink.aspx?name=E358494&#038;id=1&#038;_gl=1*9cdgcl*_gcl_au*MTQ0OTU4ODgzMi4xNzkzNzMyOTk2" class="btn-default small yellow left-btn" target="">Donate</a>
                                                                                        <a href="https://www.ccm.edu/meet-ccm/about/ccm-foundation/" class="btn-default small yellow" target="">Learn More</a>
                                                    </div>
                    </div>
                </div>
            </div>

            
                    </div>
    </div>
</section>





<section class="accent-programs-section ov-hidden nav-section" id="">
    <div class="offset-x-desktop-162">
        <div class="max-w-container w-1596">

            <div class="left-image-container accent-program">
                <div class="image-wrap left-side">
                                        <img decoding="async" class="image" src="https://www.ccm.edu/wp-content/uploads/2024/02/image-ccm-1-1-e1711456736381.jpg" alt="" width="618" height="430">
                </div>
                <div class="content-wrap right-side" > <!-- data-lenis-prevent -->
                    <div class="inner-wrap">
                                                <h4 class="txt-size-62 main-title">Workforce Development</h4>
                        <div class="txt-size-18 description">Through our Workforce Development Program, CCM helps students level up their professional credentials and helps employers recruit and train top talent</div>
                        <div class="btns-wrap">
                                                                                        <a href="https://www.ccm.edu/workforce-development/" class="btn-default small yellow left-btn" target="_blank">Workforce Programs</a>
                                                                                </div>
                    </div>
                </div>
            </div>

                            <div class="right-image-container accent-program">
                    <div class="content-wrap left-side"> <!-- data-lenis-prevent -->
                        <div class="inner-wrap">
                                                        <h4 class="txt-size-62 main-title">Virtual Campus</h4>
                            <div class="txt-size-18 description">The Virtual Campus is committed to a high-quality and a “learning without borders” experience for all without the need to access a physical campus to engage in. Connecting learning with real-world applications. Gaining Mastery of the principles and skills needed for the workforce.</div>
                            <div class="btns-wrap">
                                                                                                    <a href="https://www.ccm.edu/financial-aid/" class="btn-default small yellow left-btn" target="_blank">Funding and Financial Aid</a>
                                                                                            </div>
                        </div>
                    </div>
                    <div class="image-wrap right-side">
                                                <img decoding="async" class="image" src="https://www.ccm.edu/wp-content/uploads/2024/03/GettyImages-636706834.jpg" alt="Image of man looking at computer with reflection on his glasses." idth="618" height="430">
                    </div>
                </div>
            
                            <div class="left-image-container second-left-container accent-program">
                    <div class="image-wrap left-side">
                                                <img decoding="async" class="image" src="https://www.ccm.edu/wp-content/uploads/2024/01/accent-program-2-e1711456698415.jpg" alt="" idth="618" height="430">
                    </div>
                    <div class="content-wrap right-side"> <!-- data-lenis-prevent -->
                        <div class="inner-wrap">
                                                        <h4 class="txt-size-62 main-title">Paying For Your Education</h4>
                            <div class="txt-size-18 description">Your goals are within reach. CCM’s Financial Aid team can help you explore a variety of ways to get help funding your education.</div>
                            <div class="btns-wrap">
                                                                                                    <a href="https://www.ccm.edu/admissions/flexible-learning-opportunities/" class="btn-default small yellow left-btn" target="_blank">Virtual Campus</a>
                                                                                            </div>
                        </div>
                    </div>
                </div>
                    </div>
    </div>
</section>





<section class="success-stories-section ov-hidden nav-section" id="">
    <div class="offset-x-desktop-162 right-endless">
        <div class="max-w-container w-1596 fade-in-container">
            <h3 class="txt-size-62 main-title fade-el">Success Stories</h3>
            <div class="testimonials-slider swiper-container prel">
                <div class="swiper-wrapper">
                                        
                        <div class="swiper-slide testimonial-slide">
                            <div class="left-side">
                                <p class="testimonial-text fade-el">&#8220;CCM professors take time to work with students individually to ensure they understand the material. I really missed not having that close connection to my professors at the other schools I attended.” </p>
                                <div class="full-testimonial">
                                                                    </div>
                            </div>
                            <div class="right-side">
                                <div class="image-wrap fade-el">
                                    <div class="quote-icon">“</div>
                                    <img decoding="async" class="image" src="https://www.ccm.edu/wp-content/uploads/2023/12/david-davis.webp" alt="">
                                    <div class="testimonial-author">
                                        <div class="names">
                                            <p class="name">David Davis</p>
                                            <p class="position">Starship Engineer II, SpaceX</p>
                                        </div>
                                        <div class="icon">                                      
                                            <svg viewBox="0 0 23 19" fill="none">
                                                <path d="M22.5887 5.52532L11.7907 0.961929C11.6229 0.890294 11.4327 0.890294 11.2649 0.961929L0.409521 5.50889C0.246107 5.58162 0.117303 5.71503 0.0502728 5.88087C-0.0167576 6.0467 -0.0167576 6.23225 0.0502728 6.39809C0.117303 6.56392 0.246107 6.69733 0.409521 6.77006C1.05025 7.04521 4.80417 8.61855 5.33823 8.84857L11.2691 11.3501C11.4373 11.42 11.6266 11.42 11.7948 11.3501L20.4488 7.69036V13.1081C19.6273 13.3136 19.3029 14.706 19.7587 15.4576L19.155 18.1686C19.1338 18.2772 19.1574 18.3898 19.2203 18.4807C19.2832 18.5719 19.3802 18.6337 19.4893 18.6521C19.5984 18.6707 19.7103 18.6444 19.7999 18.5793C20.0919 18.3635 20.4433 18.2431 20.8063 18.2343C21.1925 18.2286 21.5694 18.3513 21.8783 18.5835C21.971 18.6529 22.0884 18.6801 22.2021 18.6582C22.3158 18.6365 22.4148 18.5679 22.4752 18.4691C22.5355 18.3706 22.5515 18.2509 22.519 18.1399L21.7675 15.4412C22.1782 14.7634 21.9482 13.5476 21.2869 13.2067V7.34117L22.5889 6.78255C22.7528 6.71091 22.882 6.57816 22.9495 6.41254C23.0169 6.24693 23.0167 6.0616 22.9495 5.89576C22.8822 5.72993 22.7528 5.59739 22.5889 5.52576L22.5887 5.52532Z" fill="#DAE343"/>
                                                <path d="M10.9435 12.1056L4.51562 9.37402V13.3746C4.52132 13.8106 4.74103 14.2161 5.10291 14.459C6.90857 15.6867 9.02791 16.3721 11.2103 16.4348C13.6022 16.4836 15.9515 15.7984 17.9421 14.4715C18.3136 14.2275 18.5397 13.815 18.5458 13.3707V9.37402L12.1098 12.1056C11.7359 12.2576 11.3172 12.2576 10.9433 12.1056H10.9435Z" fill="#DAE343"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    
                        <div class="swiper-slide testimonial-slide">
                            <div class="left-side">
                                <p class="testimonial-text fade-el">“CCM played a huge role in my life and put me on a path to success. I truly wouldn&#8217;t be where I am today without the support I received there. The faculty and staff gave me all the tools I needed to be challenged academically and succeed. My experiences there also taught me self-discipline. It really prepared me to move to the next level.”</p>
                                <div class="full-testimonial">
                                                                    </div>
                            </div>
                            <div class="right-side">
                                <div class="image-wrap fade-el">
                                    <div class="quote-icon">“</div>
                                    <img decoding="async" class="image" src="https://www.ccm.edu/wp-content/uploads/2023/12/Chaz-Hayden.webp" alt="Chaz-Hayden">
                                    <div class="testimonial-author">
                                        <div class="names">
                                            <p class="name">Chaz Hayden (Weiner)</p>
                                            <p class="position">Separately Managed Account Analyst, Bloomberg LP, and author of “The First Thing About You” </p>
                                        </div>
