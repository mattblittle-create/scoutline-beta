              <script>
                function liveSearch() {
                  // Locate the card elements
                  let cards = document.querySelectorAll('.program-searches');
                  // Matched programs count
                  let matchedPrograms = 1;
                  // Locate the search input
                  let search_query = document.getElementById("q").value;

                  // Matched programs
                  const mPrograms = [];

                  // Loop through the cards
                  for (var i = 0; i < cards.length; i++) {
                    let matchedString = cards[i].innerText.toLowerCase();

                    // If the text is within the card...
                    if(cards[i].innerText.toLowerCase().includes(search_query.toLowerCase())) {
                      // ...and the text matches the search query, remove the `.is-hidden` class.
                      cards[i].classList.add("is-active");
                      cards[i].classList.remove("display-none");
                      cards[i].getElementsByTagName('a')[0].classList.add("is-active");
                      cards[i].getElementsByTagName('div')[0].setAttribute('aria-expanded', true);
                      cards[i].getElementsByTagName('div')[0].setAttribute('aria-hidden', false);
                      cards[i].getElementsByTagName('div')[0].setAttribute('style', 'display: block;');
                      matchedPrograms = matchedPrograms + 1;

                      mPrograms.push(matchedString);
                      console.log("matchedString: " + matchedString);
                      // console.log("match mPrograms: " + mPrograms);

                      console.log("match matchedPrograms: " + matchedPrograms);
                    } else {
                      // Otherwise, add the class.
                      cards[i].classList.add("display-none");
                      cards[i].classList.remove("is-active");
                      cards[i].getElementsByTagName('a')[0].classList.remove("is-active");
                      cards[i].getElementsByTagName('div')[0].setAttribute('aria-expanded', false);
                      cards[i].getElementsByTagName('div')[0].setAttribute('aria-hidden', true);
                      cards[i].getElementsByTagName('div')[0].setAttribute('style', 'display: none;');
                      matchedPrograms = 0;
                      if(mPrograms.includes(matchedString)){
                        mPrograms.pop(matchedString);
                      }
                      console.log("NOmatch mPrograms: " + mPrograms);
                      console.log("NOmatch matchedPrograms: " + matchedPrograms);
                    }
                  }

                  let noPrograms = document.createElement('div');
                  noPrograms.classList.add('no-programs');
                  if(mPrograms.length === 0){
                    if(document.querySelectorAll('.no-programs').length < 1){
                      noPrograms.innerHTML = '<span style="color: #222;">No programs found.</span>';
                      document.getElementById('full-programs-list').appendChild(noPrograms);
                    }
                  }else{
                    document.querySelectorAll('.no-programs').forEach(e => e.remove());
                  }
                }

                // A little delay
                let typingTimer;        
                let typeInterval = 125; // Half a second
                let searchInput = document.getElementById('search-controls');

                searchInput.addEventListener('keyup', () => {
                  clearTimeout(typingTimer);
                  typingTimer = setTimeout(liveSearch, typeInterval);
                });

                var searchSuggestion = document.getElementById('search-suggestion');
                searchInput.addEventListener('click', event => {
                  if(searchSuggestion){
                    searchSuggestion.remove();
                  }
                });
                searchSuggestion.addEventListener('click', event => {
                  if(searchSuggestion){
                    searchSuggestion.remove();
                  }
                });
              </script>
            </div><!-- /.accordion js-accordion -->
          </div><!-- /.search__dropdown -->
        </div><!-- /.search__scroll -->
      </form>
    </div><!-- /.search -->
  </div><!-- /.shell -->
</section><!-- /.section-find -->

<section class="section section--white">
  <div class="shell">
        <div class="box">
      <div class="grid">
        <div class="grid__col grid__col--size-2">
          <div class="box__content">
            <a href="/news/" class="box__link green">Latest News</a>

                        <h2>New Study Highlights $594.4 Million Annual Economic and Community Impact of Middlesex College </h2>
            <p><p>The study details Middlesex College’s economic value through development, community partnerships, and improving the quality of life for residents of Middlesex County. </p>
</p>

            <div class="btn btn--size-2">
              <a href="https://middlesexcollege.edu/2026/07/new-study-highlights-594-4-million-annual-economic-and-community-impact-of-middlesex-college/">Read More</a>
