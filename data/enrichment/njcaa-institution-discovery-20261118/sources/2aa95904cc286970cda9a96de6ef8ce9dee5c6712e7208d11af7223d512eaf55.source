    .caption
{
	background-color:#f5f5f5;
	margin-top:-20px;
margin-left: auto;
margin-right: auto;
	width:600px;
	padding: 5px;
}
.caption-200
{
	background-color:#F5F5F5;
	margin-top:-5px;
	width:200px;
	padding: 5px;
font-size: 13px;
}

.caption-400
{
	background-color:#F5F5F5;
	margin-top:-20px;
margin-left: auto;
margin-right: auto;
	width:400px;
	padding: 5px;
font-size: 13px;
}

    .caption960
{
	background-color:#f5f5f5;
	margin-top:-20px;
margin-left: auto;
margin-right: auto;
	width:848px;
	padding: 5px;
}
.divider {

    background: #00703C;
    border: 1px solid #000;
        border-top-color: rgb(0, 0, 0);
        border-right-color: rgb(0, 0, 0);
        border-bottom-color: rgb(0, 0, 0);
        border-left-color: rgb(0, 0, 0);
    border-radius: 5px;
    box-shadow: 0px 3px 6px 0px #666;
    border-color: #000;
    height: 8px;
    margin: 25px 0;

}
.contact-box
{
    height: 190px;
    width: 400px;
    display: flex;
    padding-left:20px;

    align-items: center; /* align vertical */
}



.programs
{
width: 100%;
font-size:20px;
}


th, td {
    text-align: left;
    padding: 5px;

}

.programs tr:nth-child(odd){background-color: #f5f5f5;}

th {
    background-color: #00703c;
    color: white;
    font-size:14px;
    
}
.breadcrumb > .active {

    color: #00703C;

}

.people-item #viewlink {

    border: 1px solid #00703C;
    color: #00703C;
    display: inline-block;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 1px;
    margin: 15px 0 30px;
    opacity: 0.8;
    padding: 5px 10px;
    text-transform: uppercase;
    transition-duration: 0.1s;
}

.people-item #viewlink:hover {

    background: 

#fff;
}
    
    a.button, button.button {


    white-space: normal;
    font-size: clamp(1px,1px + 1.2vw,12px) !important;
    max-width: 95%;


} 

.nav-tree-sidebar a.nav-path-selected:not(.nav-selected) {

width: 100%;
}
 
     .entry-meta li {
    float: left;
    font-size: 13px;
    line-height: 14px;
    margin: 0 10px 15px 0;
    color: #00703c;
    font-family: 'Crete Round',serif;
}  

/* fix the issue with page title not matching most of the website size */
.fs24 {
    font-size: 18px !important;
}

.formidable .checkbox label input, .formidable .radio label input {
    margin-top: 2px;
}
