    <style>
.hero {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}

.hero-heading {
  font-size: 60px;
  line-height:50px;
  margin: 10px 0;
}

.hero-sub {
  font-size: 20px;
  line-height: 25px;
  margin: 0.5rem 0 0;
}

.hero-img {
  width: 600px;
  height: auto;        /* keep aspect ratio */
  flex: 0 0 auto;
  transition: transform .2s; /* Animation */

}

.hero-img:hover {
  transform: scale(1.2); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
}

/* Stack on small screens, image below text */
@media (max-width: 768px) {
  .hero {
    flex-direction: column;
  }

  .hero-img {
    width: min(80%, 360px);
    align-self: center;    /* center the image */
    margin-top: 8px;
  }
  
  

  .hero-heading {
    font-size: 40px;
    line-height: 1.2;
  }

  .hero-sub {
    font-size: 18px;
    line-height: 1.4;
  }
}

.dcb3-button {
    color: white;
    padding: 12px 24px;
    text-decoration: none;
    display: inline-block;
    margin: 20px 10px;
    -webkit-transition-duration: 0.4s; /* Safari */
    transition-duration: 0.4s;
    cursor: pointer;

}



.dcb3-button1 {
    background-color: #f5f5f5; 
    color: #444444; 
    border: 1px solid #444444;
    width:200px;
    font-size:80%;
    font-weight:bold;
    padding:12px 24px;
}

.dcb3-button1:hover {
    background-color:transparent; 
    color: #00703C;
    border: 1px solid #00703C;
}

.ccm-page .ig-show-more {
  background-color: #f5f5f5; 
    color: #444444; 
    border: 1px solid #444444;
    width:200px;
    font-size:80%;
    font-weight:bold;
    padding:12px 24px;
}

.ccm-page .ig-show-more:hover {
    background-color:transparent; 
    color: #00703C;
    border: 1px solid #00703C;
}

@media (min-width: 768px) {
  .ccm-page .ig-btn {
    width: auto;
    min-width: 200px;
  }
}


</style>


