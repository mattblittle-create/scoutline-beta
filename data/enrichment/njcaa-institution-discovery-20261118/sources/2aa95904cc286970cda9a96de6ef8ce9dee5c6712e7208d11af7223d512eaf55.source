<div class="container"><div class="row"><div class="col-md-12">        <div class="ccm-custom-style-container ccm-custom-style-main2-32398 ccm-block-custom-template-bootstrap-calendar"
            >
        <div class="ccm-block-calendar-wrapper" data-calendar="32398"></div>

    <script>
        $(function() {
            $('div[data-calendar=32398]').fullCalendar({
                header: {
                    left: 'prev,next today',
                    center: 'title',
                    right: ''
                },
                locale: "en",
                views: {
                    listDay: { buttonText: 'list day' },
                    listWeek: { buttonText: 'list week' },
                    listMonth: { buttonText: 'list month' },
                    listYear: { buttonText: 'list year' }
                },
                contentHeight: 'auto',

                                    defaultView: 'basicWeek',
                                                
                events: 'https://www.dakotacollege.edu/get_events/32398',
                nextDayThreshold: '00:00:00',
                eventDataTransform: function(event) {
                    if(event.allDay) {
                        event.end = moment(event.end).add(1, 'days')
                    }
                    return event;
                },

                eventRender: function(event, element) {
                                            element.attr('href', 'https://www.dakotacollege.edu/ccm/calendar/view_event/32398/' + event.id).magnificPopup({
                            type: 'ajax',
                            callbacks: {
                                beforeOpen: function () {
                                    // just a hack that adds mfp-anim class to markup
                                    this.st.mainClass = 'mfp-zoom';
                                }
                            },
                            closeBtnInside: true,
                            closeOnContentClick: true,
                            midClick: true // allow opening popup on middle mouse click. Always set it to true if you don't provide alternative source.
                        });
                                    }
            });
        });
    </script>

</div></div></div>    </div>


