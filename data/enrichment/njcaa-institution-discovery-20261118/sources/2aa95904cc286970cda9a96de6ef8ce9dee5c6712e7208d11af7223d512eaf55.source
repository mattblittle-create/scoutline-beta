<style>

.swiper_wrapper .swiper-slide {
    position: relative;
    margin: 0;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
}

#footer .footer-ribbon {
    font-size: 12px;
}

.widget p:not(.lead) {
    font-size: 16px;
}


.footer-quote
{
    color:#eeeeee;
    font-size:20px;
    font-weight:600;
    font-family: "Raleway", sans-serif;
}


.footer-title
{
    color:#eeeeee;
    font-size:30px;
    font-weight:600;
    font-family: "Raleway", sans-serif;
}

#footer {
 
  margin-top: 20px;
}

.dcb-button {
    background-color: #e2e2e2; /* Grey */
    border: none;
    color: white;
    padding: 12px 24px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
font-size: 12px;
    margin: 4px 17px;
    -webkit-transition-duration: 0.4s; /* Safari */
    transition-duration: 0.4s;
    cursor: pointer;
width: 200px;

}

.dcb-button1 {
    background-color: #00703c; 
    color: #FFFFFF; 
    border: 2px solid #F5F5F5;
    width:85%;
    font-size:20px;
    font-weight:bold;
    padding:12px 24px;
}

.dcb-button1:hover {
    background-color: #f5f5f5;
    color: #000000;
    border: 2px solid #FFFFFF;
}
.dcb2-button {
    color: white;
    padding: 12px 24px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    margin: 4px 17px;
    -webkit-transition-duration: 0.4s; /* Safari */
    transition-duration: 0.4s;
    cursor: pointer;

}



.dcb2-button1 {
    background-color: #00703c; 
    color: #FFFFFF; 
    border: 2px solid #444444;
    width:90%;
    font-size:18px;
    font-weight:bold;
    padding:12px 24px;
}

.dcb2-button1:hover {
    background-color: #444444;
    color: #FFFFFF;
    border: 2px solid #00703C;
}


hr { 
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left:0px;
    border-style: inset;
    border-width: 2px;
    color: #00703C;
} 

/* Gradient transparent - color - transparent */ 
hr.style-two 
{ border: 0; height: 2px; background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 112, 60, 0.75), rgba(0, 0, 0, 0)); }

#content .content-wrap {

    position: relative;
    padding-top: 30px;
    padding-bottom: 0px;
}

.ccm-custom-style-main142
{
    border-left-width: 4px;
    border-left-style: solid;
    border-left-color: rgb(0, 112, 60);
    border-right-width: 4px;
    border-right-style: solid;
    border-right-color: rgb(0, 112, 60);
    min-height: 700px;
    margin-bottom: 20px;
    padding:5px;
    overflow:scroll;
    
}     

a.footerlink:link, 
a.footerlink:visited,
a.footerlink:active { color: #FFFFFF !important; text-decoration: none; !important; padding:4px !important; }

a.footerlink:hover { color: #FFFFFF !important; border-bottom: 2px solid black !important; padding:4px !important; }

.dcb-bottom-border
{
border-style: solid;
border-color: #00703C;
border-width: 0px 0px 5px 0px;
}
/* fixes margin-left issue with ul navigation */ 
.nav-tree > ul {

    margin: -8px 0;
    margin-left: -10px;

}


    /*fixes the issue with the top-link in an accordion to not be easily clickable */
    .accordion-container.style-preset-2 .accordion-item .accordion-header .accordion-title-overlay {

  height: 0%;
    
</style>



