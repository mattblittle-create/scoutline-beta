<div class="container"><div class="row"><div class="col-md-12">        <div class="ccm-custom-style-container ccm-custom-style-pagefooter-33116"
            >
    

    <div class="ig-wrapper js-ig-wrapper"
         style="--ig-columns-phone: 50%;--ig-columns-tablet: 33.333333333333%;--ig-columns-desktop: 20%;--ig-spacing: 16px;--ig-header-name-color: rgb(65, 69, 72);--ig-header-name-color-hover: rgb(59, 63, 66);--ig-header-description-color: rgb(0, 112, 60);--ig-show-more-color: rgb(255, 255, 255);--ig-show-more-color-hover: rgb(255, 255, 255);--ig-show-more-bg: rgb(0, 112, 60);--ig-show-more-bg-hover: rgb(153, 153, 153);--ig-follow-color: rgb(255, 255, 255);--ig-follow-color-hover: rgb(255, 255, 255);--ig-follow-bg: rgb(86, 86, 86);--ig-follow-bg-hover: rgb(69, 147, 214);"
         data-get-media-url="https://www.dakotacollege.edu/insta-media-gallery/frontend/get-media"
         data-unique-id="ba28faa0d0300a0043"
         data-current-offset="0"
         data-media-total="36"
         data-display-limit="40"
         data-media-source-ids="[&quot;2&quot;]"
         data-moderation="show_all"
         data-sorting-method="date_desc"
         data-hashtag=""
         data-thumbnail-generation-method="image_helper"
         data-thumbnail-type="file_manager_detail"
         data-thumbnail-width="600"
         data-thumbnail-height="600"
         data-thumbnail-crop="1"
         data-masonry-random-heights="1"
         data-media-at-start="10"
         data-media-to-reveal="10"
    >

        

        <div class="ig-items js-ig-items">
            <div class="grid-sizer"></div>
            <div class="gutter-sizer"></div>
        </div>

        <div class="ig-no-media-found ig-hidden js-ig-no-media-found">
            No media found.        </div>

        <div class="ig-show-more-wrapper">
            <span class="ig-btn ig-show-more js-ig-show-more"
                  style=""
                  data-loading-label="Loading..."
                  data-show-more-label="Show more"
            >
                Loading...            </span>
                    </div>

        
<script type="text/template" class="js-ig-item-template">

    <div class="ig-masonry-item js-ig-masonry-item">

        <a href="#ig-popup-<%- uniqueId %>-<%- medium.id %>"
           class="ig-item ig-item-overlay-effect js-ig-item"
           style="--ig-item-padding-bottom: <%- medium.padding_bottom %>"
           title="<%- medium.instagram_caption %>"
           data-first-item-in-batch="<% if (first_item_in_batch) { %>1<% } else { %>0<% } %>"
        >

            <span class="ig-item-media-type-icon-wrapper">

                <% if (medium.instagram_media_type === 'CAROUSEL_ALBUM') { %>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="currentColor"
                         class="ig-icon ig-item-media-type-icon ig-item-media-type-icon-slider"
                         viewBox="0 0 16 16"
                    >
                        <path d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2z"/>
                    </svg>
                <% } else if (medium.instagram_media_type === 'VIDEO') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor"
                         class="ig-icon ig-item-media-type-icon ig-item-media-type-icon-video"
                         viewBox="0 0 16 16">
                        <path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V1zm4 0v6h8V1H4zm8 8H4v6h8V9zM1 1v2h2V1H1zm2 3H1v2h2V4zM1 7v2h2V7H1zm2 3H1v2h2v-2zm-2 3v2h2v-2H1zM15 1h-2v2h2V1zm-2 3v2h2V4h-2zm2 3h-2v2h2V7zm-2 3v2h2v-2h-2zm2 3h-2v2h2v-2z"/>
                    </svg>
                <% } %>

            </span>

            <span class="ig-item-overlay">
                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="currentColor"
                     class="ig-icon ig-item-overlay-icon"
                     viewBox="0 0 16 16"
                >
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                </svg>
            </span>

            <% if (medium.video.url && !medium.thumbnail.url) { %>

                <video class="ig-item-medium ig-item-medium-video"
                       preload="none"
                       muted
                       playsinline
                       loop
                >
                    <source src="<%- medium.video.url %>" type="video/mp4">
                </video>

            <% } else { %>

                <img src="<%- medium.thumbnail.url ? medium.thumbnail.url : 'data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20' + medium.thumbnail.width + '%20' + medium.thumbnail.height + '%22%20%2F%3E' %>"
                     class="ig-item-medium ig-item-medium-img"
                     loading="lazy"
                     width="<%- medium.thumbnail.width %>"
                     height="<%- medium.thumbnail.height %>"
                     alt="<% if (medium.instagram_caption) { %><%- medium.instagram_caption %><% } else { %>Instagram Image<% } %>"
                >

            <% } %>

        </a>


        <div class="ig-popup-wrapper mfp-hide"
             id="ig-popup-<%- uniqueId %>-<%- medium.id %>"
             data-instagram-media-type="<%- medium.instagram_media_type %>"
        >

            <div class="ig-popup-medium-wrapper">

                <% if (medium.instagram_media_type === 'CAROUSEL_ALBUM' && medium.carousel_items.length) { %>

                    <div class="ig-popup-slider-wrapper">

                        <div class="swiper js-popup-slider"
                             data-medium-id="<%- medium.id %>"
                        >

                            <div class="swiper-wrapper">

                                <% medium.carousel_items.forEach(carouselItem => { %>

                                    <div class="swiper-slide ig-popup-slide">

                                        <div class="ig-popup-slide-medium-wrapper">

                                            <% if (carouselItem.extension === 'mp4') { %>
                                                <video class="ig-popup-slide-video"
                                                       preload="none"
                                                       muted
                                                       playsinline
                                                       controls
                                                       loop
                                                >
                                                    <source src="<%- carouselItem.url %>" type="video/mp4">
                                                </video>
                                            <% } else { %>
                                                <img src="<%- carouselItem.url %>"
                                                     loading="lazy"
                                                     width="<%- carouselItem.width %>"
                                                     height="<%- carouselItem.height %>"
                                                     alt="Carousel Item"
                                                     class="ig-popup-slide-image"
                                                >
                                            <% } %>

                                        </div>

                                    </div>

                                <% }); %>

                            </div>

                        </div>

                        <div class="swiper-pagination" data-medium-id="<%- medium.id %>"></div>

                        <div class="swiper-button-next" data-medium-id="<%- medium.id %>">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="currentColor"
                                 class="ig-icon"
                                 viewBox="0 0 16 16"
                            >
                                <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </div>

                        <div class="swiper-button-prev" data-medium-id="<%- medium.id %>">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="currentColor"
                                 class="ig-icon"
                                 viewBox="0 0 16 16"
                            >
                                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                            </svg>
                        </div>

                    </div>

                <% } else if (medium.instagram_media_type === 'VIDEO' && medium.video.url) { %>

                    <div class="ig-popup-video-wrapper">

                        <video class="ig-popup-video"
                               preload="none"
                               muted
                               playsinline
                               controls
                               loop
                        >
                            <source src="<%- medium.video.url %>" type="video/mp4">
                        </video>

                    </div>

                <% } else { %>

                    <div class="ig-popup-image-wrapper">

                        <img src="<%- medium.fullscreen.url %>"
                             loading="lazy"
                             width="<%- medium.fullscreen.width %>"
                             height="<%- medium.fullscreen.height %>"
                             alt="<%- medium.instagram_caption %>"
                             class="ig-popup-image"
                        >

                    </div>

                <% } %>

            </div>

            <div class="ig-popup-content-wrapper">

                <div class="ig-popup-content">

                    <div class="ig-popup-content-info">
                        <a href="<%- medium.instagram_permalink %>"
                           class="ig-popup-content-link"
                           target="_blank"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="currentColor"
                                 class="ig-icon ig-popup-content-icon-instagram"
                                 viewBox="0 0 16 16"
                            >
                                <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/>
                            </svg>
                            <span class="ig-popup-content-username">
                                <% if (medium.instagram_username) { %>
                                    @<%- medium.instagram_username %>
                                <% } else { %>
                                    @instagram
                                <% } %>
                            </span>
                        </a>
                        <% if (medium.instagram_date) { %>
                            <div class="ig-popup-content-date">
                                <%- medium.instagram_date %>
                            </div>
                        <% } %>
                    </div>

                    <% if (medium.instagram_caption) { %>
                        <div class="ig-popup-content-text">
                            <p><%- medium.instagram_caption %></p>
                        </div>
                    <% } %>

