                     <div class="interest-section__item"><span class="img-wrapper">
                           <td data-name="image"><img src="/_resources/images/Online-Learning.jpeg" alt="Online Learning Page" width="1456" height="430"></td></span><a href="/academics/online-learning/index.html"><span class="content">Online Learning</span></a></div>
