            text-align: center;
            color: #e53e3e;
        }

        @media (max-width: 968px) {
            .widget-container {
                flex-direction: column;
                gap: 20px;
            }

            .tiles-section {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
                max-width: 100%;
                margin: 0 auto;
            }

            .list-section {
                width: 100%;
            }
        }

        @media (max-width: 640px) {
            .widget-container {
                gap: 16px;
