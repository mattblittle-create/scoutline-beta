				<section class="slab has-bg-image bg-color-two text-center space-above space-below" style="background-image: url('images/background-images/graduation_for_highlights.jpg');">
<div class="stats-slab">
<div class="container" name="highlightsContainer">
<div class="row">
<div class="col">
<h2>Highlights</h2>
</div>
</div>
<div class="row highlightsCenter">
<div class="col-md-6 col-lg-3 stat one hide centerHighlights">
<div class="">
<div class="headline-group"><img alt="walking up stairs" class="highlightVector" src="images/highlights-vectors/Career-white.svg"/> <span class="head">91.58%</span> <span class="subhead">Job Placement Rate</span></div>
<div class="stat-body">
<p>2021-2022 A.A.S. &amp; Technical Certificate Graduates</p>
</div>
</div>
</div>
<div class="col-md-6 col-lg-3 stat two hide centerHighlights">
<div class="">
<div class="headline-group"><img alt="wearing a graduation cap, and holding a key" class="highlightVector" src="images/highlights-vectors/CapAndKey.svg"/> <span class="head">100%</span> <span class="subhead">Licensure Pass Rate</span></div>
<div class="stat-body">
<p>For 2023 Paramedic (National Average: 71%)</p>
</div>
</div>
</div>
<div class="col-md-6 col-lg-3 stat three hide centerHighlights">
<div class="">
<div class="headline-group"><img alt="Graduation Cap and Diploma" class="highlightVector" src="images/highlights-vectors/CapAndScroll-white.svg"/> <span class="head">1,043</span> <span class="subhead">Degrees &amp; Certificates Awarded</span></div>
<div class="stat-body">
<p>2023-2024: 642 A.A./A.S./A.S.T. Degrees, 250 A.A.S. Degrees, 151 Tech. Certificates</p>
</div>
</div>
</div>
