            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 12px 0 0 12px;
            padding: 12px;
        }

        .date-number {
            font-size: 1.8rem;
            font-weight: 700;
            color: #FFF;
            line-height: 1;
        }

        .date-month {
            font-size: 0.85rem;
            font-weight: 600;
            color: #FFF;
            text-transform: uppercase;
            margin-top: 4px;
        }

        .list-item-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 16px;
        }

        .list-item-title {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 4px;
        }

        .list-item-date {
            font-size: 0.9rem;
            color: #2d7a4f;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .list-item-description {
            font-size: 0.85rem;
            color: #6b7280;
            line-height: 1.4;
            margin-top: 4px;
        }

        .description-field {
            margin-bottom: 4px;
        }

        .description-field:last-child {
            margin-bottom: 0;
        }

        .description-field strong {
            font-weight: 700;
            color: #1a202c;
        }

        .loading {
            text-align: center;
            color: #4a5568;
            font-size: 1.1rem;
            padding: 40px;
        }

        .error {
            background: white;
            border-radius: 12px;
