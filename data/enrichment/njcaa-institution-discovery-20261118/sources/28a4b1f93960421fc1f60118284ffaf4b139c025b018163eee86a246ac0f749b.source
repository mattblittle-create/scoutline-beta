--></style>
<section class="slab hm-events-slab space-above">
<div class="container">
<div class="row">
<div class="col">
<h2>What's Happening</h2>
</div>
</div>
<div class="row">
<div class="col-md-12 col-lg-6 featured">
<div class="tiles-section" id="tiles-container">
<div class="loading">Loading events...</div>
</div>
</div>
<div class="col-md-12 col-lg-6 event-list">
<div class="list-container" id="list-container">
<div class="loading">Loading events...</div>
</div>
</div>
</div>
<div class="row">
<div class="col"><a class="btn space-above more-events waves-effect waves-light" href="events/index.html">More Events</a></div>
</div>
</div>
</section>
<script>// <![CDATA[
let allEvents = [];
        const defaultImageUrl = 'https://coursedog-images-public.s3.us-east-2.amazonaws.com/columbiastate_banner_sql/CSCC%20shield.jpg';
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const dayNamesShort = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const ERROR_MSG_LOAD = 'Failed to load events. Please try refreshing the page.';
        const ERROR_MSG_PARSE = 'Failed to parse events. Please try refreshing the page.';
        const ERROR_MSG_NONE = 'No events found.';
        const LOADING_MSG = 'Loading events...';

        function formatMilitaryTime(value) {
            const n = parseInt(value, 10);
            if (Number.isNaN(n)) return '';
            let hours = Math.floor(n / 100);
            const minutes = n % 100;
            const period = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12;
            return `${hours}:${String(minutes).padStart(2, '0')}${period}`;
        }

        function parseEventDate(startDate, startTime, endTime) {
            const dateForSorting = startDate ? new Date(startDate) : new Date('2099-12-31');
            if (Number.isNaN(dateForSorting.getTime())) {
                return { dateDisplay: '', dateForSorting: new Date('2099-12-31') };
            }
            const start = formatMilitaryTime(startTime);
            const end = formatMilitaryTime(endTime);
            const datePart = `${dayNamesShort[dateForSorting.getDay()]} ${monthNames[dateForSorting.getMonth()]} ${dateForSorting.getDate()} ${dateForSorting.getFullYear()}`;
            return {
                dateDisplay: start && end ? `${datePart} | ${start} – ${end}` : datePart,
                dateForSorting
            };
        }

        function mapRawEvent(item) {
            const { dateDisplay, dateForSorting } = parseEventDate(item.eventStartDate, item.eventStartTime, item.eventEndTime);
            const contact = [item.eventContact, item.eventContactEmail, item.eventContactPhone]
                .map((v) => (v == null ? '' : String(v).trim()))
                .filter(Boolean)
                .join(', ');
            const eventDescription = (item.eventDescription || '').trim();
            const fields = [
                ['Event Description', eventDescription],
                ['Location', (item.eventLocation || '').trim()],
                ['Organizer', (item.eventOrganizer || '').trim()],
                ['Contacts', contact]
            ].filter(([, v]) => v);
            return {
                title: (item.eventTitle || 'Untitled Event').trim(),
                dateDisplay,
                formattedDescription: fields.map(([label, v]) => `<div class="description-field"><strong>${label}:</strong> ${v}</div>`).join(''),
                eventDescription,
                link: item.eventURL || '',
                dateForSorting,
                eventImageUrl: (item.eventImageURL || '').trim() || defaultImageUrl
            };
        }

        function getDateBadge(dateForSorting) {
            if (!dateForSorting || dateForSorting.getTime() === new Date('2099-12-31').getTime()) {
                return { day: '', month: '' };
            }
            return {
                day: dateForSorting.getDate(),
                month: monthNames[dateForSorting.getMonth()]
            };
        }

        function formatTileDate(dateDisplay, dateForSorting) {
            if (!dateDisplay || !dateForSorting || dateForSorting.getTime() === new Date('2099-12-31').getTime()) {
                return { dateOnly: '', timeOnly: '' };
            }
            
            const dateOnly = `${monthNames[dateForSorting.getMonth()]} ${dateForSorting.getDate()}`;
            
            const timeMatch = dateDisplay.match(/(\d{1,2}):(\d{2})(AM|PM|am|pm)\s*[–—\-]\s*(\d{1,2}):(\d{2})(AM|PM|am|pm)/i);
            let timeOnly = '';
            if (timeMatch) {
                const formatTime = (hour, min, period) => {
                    const h = parseInt(hour, 10);
                    return min === '00' ? `${h}` : `${h}:${min}`;
                };
                timeOnly = `${formatTime(timeMatch[1], timeMatch[2], timeMatch[3])} ${timeMatch[3].toUpperCase()} - ${formatTime(timeMatch[4], timeMatch[5], timeMatch[6])} ${timeMatch[6].toUpperCase()}`;
            }
            
            return { dateOnly, timeOnly };
        }

        function displayTiles() {
            const container = document.getElementById('tiles-container');
            container.innerHTML = '';
            const tileEvents = allEvents.slice(0, 4);

            if (tileEvents.length === 0) {
                container.innerHTML = `<div class="error">${ERROR_MSG_NONE}</div>`;
                return;
            }

            tileEvents.forEach(event => {
                const tile = document.createElement('div');
                tile.className = 'event-tile';
                if (event.link) tile.onclick = () => window.open(event.link, '_blank');
                
                const { dateOnly, timeOnly } = formatTileDate(event.dateDisplay, event.dateForSorting);
                
                tile.innerHTML = `
                    <div class="tile-image" style="background-image:url('${event.eventImageUrl}');"></div><div class="tile-date-section">
                        ${dateOnly ? `<div class="tile-date-only">${dateOnly}</div>` : ''}
                        ${timeOnly ? `<div class="tile-time">${timeOnly}</div>` : ''}
                    </div><div class="tile-title-section"><div class="tile-title">${event.title}</div></div>
                `;
                container.appendChild(tile);
            });
        }

        function displayList() {
            const container = document.getElementById('list-container');
            container.innerHTML = '';
            const listEvents = allEvents.slice(4, 9);

            if (listEvents.length === 0) {
                container.innerHTML = `<div class="error">${ERROR_MSG_NONE}</div>`;
                return;
            }

            listEvents.forEach(event => {
                const listItem = document.createElement('div');
                listItem.className = 'event-list-item';
                if (event.link) listItem.onclick = () => window.open(event.link, '_blank');
                
                const { day, month } = getDateBadge(event.dateForSorting);
                const desc = event.eventDescription?.trim() || '';
                const descriptionHtml = desc ? `<div class="list-item-description">${desc.length > 50 ? desc.substring(0, 50) + '...' : desc}</div>` : '';
                
                listItem.innerHTML = `
                    <div class="date-badge"><div class="date-number">${day}</div><div class="date-month">${month}</div></div><div class="list-item-content"><div class="list-item-title">${event.title}</div>
                        ${event.dateDisplay ? `<div class="list-item-date">${event.dateDisplay}</div>` : ''}
                        ${descriptionHtml}
                    </div>
                `;
                container.appendChild(listItem);
            });
        }

        function renderFromRawEvents(events) {
            const tilesContainer = document.getElementById('tiles-container');
            const listContainer = document.getElementById('list-container');
            const raw = Array.isArray(events) ? events : [];

            if (raw.length === 0) {
                const errorHtml = `<div class="error">${ERROR_MSG_NONE}</div>`;
                tilesContainer.innerHTML = errorHtml;
                listContainer.innerHTML = errorHtml;
                return;
            }

            try {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                allEvents = raw
                    .filter((item) => item.publicEvent === true)
                    .map(mapRawEvent)
                    .filter((event) => event.dateForSorting >= today)
                    .sort((a, b) => a.dateForSorting - b.dateForSorting);
                displayTiles();
                displayList();
            } catch {
                const errorHtml = `<div class="error">${ERROR_MSG_PARSE}</div>`;
                tilesContainer.innerHTML = errorHtml;
                listContainer.innerHTML = errorHtml;
            }
        }

        fetch('/_data/event-data-cd.json')
            .then((res) => {
                if (!res.ok) throw new Error('Failed to load events JSON');
                return res.json();
            })
            .then(renderFromRawEvents)
            .catch(() => {
                const errorHtml = `<div class="error">${ERROR_MSG_LOAD}</div>`;
                document.getElementById('tiles-container').innerHTML = errorHtml;
                document.getElementById('list-container').innerHTML = errorHtml;
            });
// ]]></script>
				
	
	
		
	
									
		
									
																	
															
	
																										
		
													
						
										
								
								
								
								
								
										
				
										
										
						
																									
		
											
