 <script type="text/javascript" src="/_resources/js/element.js"></script>
<script>
	function moveGoogleTranslateWidget() {
		var desktopContainer = document.getElementById(
			"desktopTranslateContainer"
		);
		var mobileContainer = document.getElementById(
			"mobileTranslateContainer"
		);
		var widget = document.getElementById("google_translate_element");
		if (!desktopContainer || !mobileContainer || !widget) {
			return;
		}
		var viewportWidth = window.innerWidth;

		if (viewportWidth <= 991) {
			if (!mobileContainer.contains(widget)) {
				mobileContainer.appendChild(widget);
			}
		} else {
			if (!desktopContainer.contains(widget)) {
				desktopContainer.appendChild(widget);
			}
		}
	}

	window.addEventListener("load", moveGoogleTranslateWidget);
	window.addEventListener("resize", moveGoogleTranslateWidget);
