<body class="home wp-singular page-template-default page page-id-690 wp-theme-northlandcollege has-alert" data-template="base.twig">
	<!-- Google Tag Manager (noscript) -->
	<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PQL2W75"
	height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	<!-- End Google Tag Manager (noscript) -->
<header class="header">
		<a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>
		<a href="#nav-main" class="skip-nav visually-hidden-focusable">Skip to main menu</a>
		<div class="has-international-orange-background">
	<div class="container northland-alerts" role="status">
		<div class="row">
			<div class="alert-wrapper">
				<div class="icon-wrapper"><img class="alert-icon" src="/assets/themes/northlandcollege/images/icons/notification.svg" alt="notification icon" /></div>
				<div class="alert-text"><p>Registration for Spring &amp; Summer 2027 Classes is Now Open! Secure your classes today.</p>
<a class="alert-link" href="https://www.northlandcollege.edu/academics/register-for-classes/">Register for Classes <img src="/assets/themes/northlandcollege/images/icons/arrow-right.svg" alt="right arrow" /></a></div>
			</div>
		</div>
	</div>
</div>
				<div class="header-inner">
