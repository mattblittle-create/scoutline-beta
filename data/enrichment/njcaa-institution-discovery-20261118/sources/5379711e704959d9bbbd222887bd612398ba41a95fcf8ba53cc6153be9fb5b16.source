<div  class="wp-block-genesis-blocks-gb-container gb-block-container"><div class="gb-container-inside"><div class="gb-container-content">
<div class="fscc-events-widget">
  <h2 class="fscc-events-heading">Upcoming Events</h2>

  <div
    id="fscc-calendar-status"
    class="fscc-calendar-status"
    role="status"
    aria-live="polite"
  >
    Loading upcoming events…
  </div>

  <div
    id="fscc-calendar-events"
    class="fscc-calendar-grid"
    aria-label="Upcoming FSCC events"
  ></div>

  <a
    class="fscc-full-calendar-button"
    href="https://calendar.google.com/calendar/embed?src=fsccpr%40gmail.com&#038;ctz=America%2FChicago"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View the full Fort Scott Community College calendar of events in a new window"
  >
    View the Full FSCC Calendar of Events
  </a>
</div>

<style>
  .fscc-events-widget {
    width: 100%;
    margin: 0 auto;
    font-family: Arial, Helvetica, sans-serif;
  }

  .fscc-events-heading {
    margin: 0 0 16px;
    color: #660619;
    font-size: 26px;
    line-height: 1.2;
  }

  .fscc-calendar-status {
    padding: 14px;
    background: #f4f4f4;
    border-radius: 5px;
  }

  .fscc-calendar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
  }

  .fscc-event {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 10px;
    min-width: 0;
    padding: 13px;
    background: #ffffff;
    border: 1px solid #dddddd;
    border-top: 4px solid #660619;
    border-radius: 6px;
    box-shadow: 0 2px 7px rgba(0, 0, 0, 0.06);
  }

  .fscc-event-date {
    text-align: center;
    text-transform: uppercase;
  }

  .fscc-event-month {
    display: block;
    color: #660619;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.1;
  }

  .fscc-event-day {
    display: block;
    color: #222222;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.1;
  }

  .fscc-event-weekday {
    display: block;
    margin-top: 2px;
    color: #666666;
    font-size: 11px;
  }

  .fscc-event-details {
    min-width: 0;
  }

  .fscc-event-title {
    margin: 0 0 6px;
    color: #660619;
    font-size: 16px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .fscc-event-title a {
    color: inherit;
    text-decoration: none;
  }

  .fscc-event-title a:hover,
  .fscc-event-title a:focus {
    text-decoration: underline;
  }

  .fscc-event-time,
  .fscc-event-location {
    margin: 3px 0;
    color: #444444;
    font-size: 13px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .fscc-full-calendar-button {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-top: 18px;
    padding: 15px 20px;
    color: #ffffff;
    background: #660619;
    border: 3px solid #660619;
    border-radius: 5px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
  }

  .fscc-full-calendar-button:hover {
    color: #660619;
    background: #ffffff;
  }

  .fscc-full-calendar-button:focus-visible {
    color: #660619;
    background: #ffffff;
    outline: 3px solid #222222;
    outline-offset: 3px;
  }

  @media (max-width: 850px) {
    .fscc-calendar-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .fscc-calendar-grid {
      grid-template-columns: 1fr;
    }

    .fscc-events-heading {
      font-size: 23px;
    }

    .fscc-event {
      grid-template-columns: 50px 1fr;
    }
  }
</style>

<script>
(function () {
  "use strict";

  const API_KEY = "AIzaSyBax_062gYowzKHpv2vyerXvxxBgu7P1YQ";
  const CALENDAR_ID = "fsccpr@gmail.com";
  const TIME_ZONE = "America/Chicago";
  const MAX_EVENTS = 6;

  const eventsContainer =
    document.getElementById("fscc-calendar-events");

  const statusContainer =
    document.getElementById("fscc-calendar-status");

  /*
   * Creates midnight at the beginning of today in Chicago.
   */
  function getChicagoStartOfToday() {
    const parts = new Intl.DateTimeFormat("en-US", {
      timeZone: TIME_ZONE,
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).formatToParts(new Date());

    const values = {};

    parts.forEach(function (part) {
      if (part.type !== "literal") {
        values[part.type] = part.value;
      }
    });

    const localDate =
      values.year +
      "-" +
      values.month +
      "-" +
      values.day +
      "T00:00:00";

    const offsetPart = new Intl.DateTimeFormat("en-US", {
      timeZone: TIME_ZONE,
      timeZoneName: "longOffset"
    })
      .formatToParts(new Date())
      .find(function (part) {
        return part.type === "timeZoneName";
      });

    const offset = offsetPart
      ? offsetPart.value.replace("GMT", "")
      : "-05:00";

    return localDate + offset;
  }

  function escapeHtml(value) {
    const element = document.createElement("div");
    element.textContent = value || "";
    return element.innerHTML;
  }

  /*
   * Correctly formats both timed and all-day events.
   *
   * All-day dates must not be passed directly into new Date("YYYY-MM-DD"),
   * because JavaScript treats that format as UTC.
   */
  function formatEventDate(event) {
    if (event.start.date) {
      const dateParts = event.start.date.split("-");

      const year = Number(dateParts[0]);
      const monthIndex = Number(dateParts[1]) - 1;
      const day = Number(dateParts[2]);

      /*
       * Noon is used to safely avoid midnight timezone shifts.
       */
      const localDate = new Date(year, monthIndex, day, 12, 0, 0);

      return {
        month: new Intl.DateTimeFormat("en-US", {
          month: "short"
        }).format(localDate),

        day: String(day),

        weekday: new Intl.DateTimeFormat("en-US", {
          weekday: "short"
        }).format(localDate)
      };
    }

    const timedDate = new Date(event.start.dateTime);

    return {
      month: new Intl.DateTimeFormat("en-US", {
        timeZone: TIME_ZONE,
        month: "short"
      }).format(timedDate),

      day: new Intl.DateTimeFormat("en-US", {
        timeZone: TIME_ZONE,
        day: "numeric"
      }).format(timedDate),

      weekday: new Intl.DateTimeFormat("en-US", {
        timeZone: TIME_ZONE,
        weekday: "short"
      }).format(timedDate)
    };
  }

  function formatEventTime(event) {
    if (event.start.date) {
      return "All day";
    }

    const start = new Date(event.start.dateTime);

    const end =
      event.end && event.end.dateTime
        ? new Date(event.end.dateTime)
        : null;

    const timeOptions = {
      timeZone: TIME_ZONE,
      hour: "numeric",
      minute: "2-digit"
    };

    const startTime = new Intl.DateTimeFormat(
      "en-US",
      timeOptions
    ).format(start);

    if (!end) {
      return startTime;
    }

    const endTime = new Intl.DateTimeFormat(
      "en-US",
      timeOptions
    ).format(end);

    return startTime + "–" + endTime;
  }

  function renderEvents(events) {
    statusContainer.style.display = "none";

    if (!events.length) {
      statusContainer.textContent =
        "No upcoming events are currently scheduled.";

      statusContainer.style.display = "block";
      return;
    }

    eventsContainer.innerHTML = events
      .map(function (event) {
        const date = formatEventDate(event);

        const title = escapeHtml(
          event.summary || "Untitled Event"
        );

        const link = event.htmlLink
          ? escapeHtml(event.htmlLink)
          : "";

        const titleHtml = link
          ? '<a href="' +
            link +
            '" target="_blank" rel="noopener noreferrer">' +
            title +
            "</a>"
          : title;

        const locationHtml = event.location
          ? '<p class="fscc-event-location"><strong>Location:</strong> ' +
            escapeHtml(event.location) +
            "</p>"
          : "";

        return (
          '<article class="fscc-event">' +
            '<div class="fscc-event-date" aria-hidden="true">' +
              '<span class="fscc-event-month">' +
                date.month +
              "</span>" +
              '<span class="fscc-event-day">' +
                date.day +
              "</span>" +
              '<span class="fscc-event-weekday">' +
                date.weekday +
              "</span>" +
            "</div>" +

            '<div class="fscc-event-details">' +
              '<h3 class="fscc-event-title">' +
                titleHtml +
              "</h3>" +

              '<p class="fscc-event-time"><strong>Time:</strong> ' +
                formatEventTime(event) +
              "</p>" +

              locationHtml +
            "</div>" +
          "</article>"
        );
      })
      .join("");
  }

  function loadCalendarEvents() {
    const endpoint =
      "https://www.googleapis.com/calendar/v3/calendars/" +
      encodeURIComponent(CALENDAR_ID) +
      "/events?" +
      new URLSearchParams({
        key: API_KEY,
        timeMin: getChicagoStartOfToday(),
        maxResults: String(MAX_EVENTS),
        singleEvents: "true",
        orderBy: "startTime",
        timeZone: TIME_ZONE,
        showDeleted: "false"
      }).toString();

    fetch(endpoint)
      .then(function (response) {
        if (!response.ok) {
          throw new Error(
            "Google Calendar returned error " +
            response.status
          );
        }

        return response.json();
      })
      .then(function (data) {
        renderEvents(data.items || []);
      })
      .catch(function (error) {
        console.error("Calendar error:", error);

        statusContainer.textContent =
          "Upcoming events could not be loaded. Please view the full calendar below.";

        statusContainer.style.display = "block";
      });
  }

  loadCalendarEvents();
})();
</script>



<p class="wp-block-paragraph"></p>
</div></div></div>



<p class="wp-block-paragraph"></p>



