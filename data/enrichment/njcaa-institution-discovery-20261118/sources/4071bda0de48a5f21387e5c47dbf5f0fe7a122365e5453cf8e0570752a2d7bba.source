    <script>
    (function() {
        'use strict';
        if (typeof jQuery !== 'undefined') {
            jQuery(document).ready(function($) {
                setTimeout(function() {
                    try {
                        var $links = $('.tribe-events-pro-photo__event-featured-image-link');
                        if ($links.length === 0) return;

                        $links.each(function() {
                            var $link = $(this);

                            var titleText = $link.find('.tribe-events-pro-photo__event-featured-image-link-inner').text().trim();

                            if (!titleText) {
                                titleText = $link.closest('article')
                                    .find('[class*="event-title"]')
                                    .first()
                                    .text().trim();
                            }

                            if (titleText) {
                                $link.attr('aria-label', titleText);
                            }
                        });
                    } catch (e) {
                        console.log('TEC embedded photo link a11y fix error:', e);
                    }
                }, 500);
            });
        }
    })();
    </script>
    		<script type="text/javascript">
				jQuery('.soliloquy-container').removeClass('no-js');
		</script>
			
