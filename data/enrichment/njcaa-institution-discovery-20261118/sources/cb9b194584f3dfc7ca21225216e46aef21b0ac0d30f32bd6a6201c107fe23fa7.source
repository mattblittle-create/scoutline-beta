		<header
		id="site-header"
		class="header group/header hocus:bg-white hocus:shadow fixed z-[9999] w-full bg-black/70 px-6 pt-2.5 pb-2.5 transition-all md:px-10 md:pt-3.75 md:pb-3.75 [&.menu-open]:bg-white [&.menu-open]:text-black"
	>
		<div
			class="relative z-[9999] grid items-center md:grid-cols-[215px_auto_215px]"
		>
			<div
				class="flex justify-between gap-10 -mb-7 md:mb-0 md:justify-start"
			>
				<button
