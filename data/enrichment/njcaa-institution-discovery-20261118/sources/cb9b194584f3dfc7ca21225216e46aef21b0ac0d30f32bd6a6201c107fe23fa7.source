					</i>
					<span
						class="group-hover/button:!text-primary hidden text-sm leading-[120%] font-bold text-white uppercase transition-colors group-hover/header:text-black md:block [header.menu-open_&]:text-black"
					>
						Menu
					</span>
				</button>

				<button
					type="button"
					class="flex items-center gap-4 search-toggle group/button"
					aria-controls="header-search-form"
					aria-expanded="false"
				>
					<i
						class="fa-solid fa-magnifying-glass [header.menu-open_&]:text-primary group-hover/header:text-primary text-xl leading-[120%] text-white transition-colors"
					>

					</i>
					<span
						class="group-hover/button:!text-primary hidden text-sm leading-[120%] font-bold text-white uppercase transition-colors group-hover/header:text-black md:block [header.menu-open_&]:text-black"
					>
						Search
					</span>
				</button>
			</div>

			<div  class="header__branding justify-self-center md:mt-0 md:mb-0">
				<figure>
					<a
						href="https://ndscs.edu"
						class="group/logo inline-flex  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-black [header.menu-open_&]:focus-visible:ring-offset-white"
					>
						<img
							class="h-7.5 brightness-0 invert transition-all group-hover/header:brightness-100 group-hover/header:invert-0 md:h-auto [header.menu-open_&]:brightness-100 [header.menu-open_&]:invert-0 group-focus-visible/logo:brightness-100 group-focus-visible/logo:invert-0"
							src="https://cdn.ndscs.edu/app/themes/ndscs/assets/img/logos/ndscs-red.svg"
							alt="North Dakota State College of Science"
						/>
					</a>
				</figure>
			</div>

			<div  class="hidden transition-all header__ancillary md:block">
				<nav class="block" aria-label="Ancillary Links">
					<ul class="flex items-center justify-center md:justify-end">
													<li
								class="after:bg-opacity-20 [header.menu-open_&]:after:bg-opacity-20 group-hover/header:after:bg-opacity-20 flex items-center after:mx-4 after:block after:h-3.25 after:w-[1px] after:bg-white after:transition-colors group-hover/header:after:bg-black last:after:hidden [header.menu-open_&]:after:bg-black"
							>
								<a
									href="https://ndscs.edu/admissions-aid/apply-to-ndscs/"
									class="group/link group-hover/button:!text-primary min-h-[24px] min-w-[24px] font-sans text-sm font-bold text-white transition-colors group-hover/header:text-black [header.menu-open_&]:text-black"
								>
									<span
										class="block transition-colors group-hover/link:text-primary"
									>
										Apply
									</span>
								</a>
							</li>
													<li
								class="after:bg-opacity-20 [header.menu-open_&]:after:bg-opacity-20 group-hover/header:after:bg-opacity-20 flex items-center after:mx-4 after:block after:h-3.25 after:w-[1px] after:bg-white after:transition-colors group-hover/header:after:bg-black last:after:hidden [header.menu-open_&]:after:bg-black"
							>
								<a
									href="https://ndscs.edu/admissions-aid/visit/"
									class="group/link group-hover/button:!text-primary min-h-[24px] min-w-[24px] font-sans text-sm font-bold text-white transition-colors group-hover/header:text-black [header.menu-open_&]:text-black"
								>
									<span
										class="block transition-colors group-hover/link:text-primary"
									>
										Visit
									</span>
								</a>
							</li>
													<li
								class="after:bg-opacity-20 [header.menu-open_&]:after:bg-opacity-20 group-hover/header:after:bg-opacity-20 flex items-center after:mx-4 after:block after:h-3.25 after:w-[1px] after:bg-white after:transition-colors group-hover/header:after:bg-black last:after:hidden [header.menu-open_&]:after:bg-black"
							>
