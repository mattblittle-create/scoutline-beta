<section
	class="home-the-difference not-prose pt-15 pb-7.5 lg:pt-30 lg:pb-25"
	data-js-component="home-the-difference"
>
	<div class="home-the-difference__wrapper">
		<div class="container">
			<div class="grid grid-cols-12 items-end gap-7.5">
				<div class="col-span-12 lg:col-span-7">
					<h2 class="text-heading_3 text-white">The NDSCS</h2>
					<h3 class="text-accent text-primary font-accent mb-6">
						Difference
					</h3>
					<p class="text-l mb-7.5 font-sans text-white">
						NDSCS is a two-year college that offers a wide range of academic options to help student prepare for lucrative careers in high-demand industries. Faster, affordable Career &amp; Technical or Liberal Arts degrees means you can turn your interests into a successful career with less debt.
					</p>
					<form class="relative mt-6">
						<div class="input-as-btn relative">
