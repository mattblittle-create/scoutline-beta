         <div class="content-wrapper">
            <div class="container">
               		
               		
               
               
               <section class="section gen4col">
                  
                  <div class="scroll-animate-box scroll-animate">
                     
                     <div class="section__header gen4col__header">
                        
                        <h2>Explore Our Programs!</h2>
                        </div>
                     		
                     
                     <div class="section__intro gen4col__intro">
                        
                        <div style="text-align: justify;">Whether you want to enter the workforce or transfer to a four-year college, Lawson
                           State has hundreds of programs that will equip you with the knowledge to succeed.
                           You picked the right school to forge your pathway to success.</div>
                        </div>
                     
                     <div class="column column--four">
                        		  
                        <div class="column__col">
                           	
                           <div class="column__img">
                              		<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/career_technical_education_programs/default.aspx" target="_self">
                                 			<img alt="A mechanic working on car" src="https://www.lawsonstate.edu/_resources/assets/img/automotive_pictures/Lawson%20State%20ACAE%202.JPG">
                                 		</a>
                              		
                              	</div>
                           	
                           <div class="column__title">
                              		
                              <h5>
                                 			<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/career_technical_education_programs/default.aspx" target="_self">CAREER TECHNICAL PROGRAMS</a>	
                                 		</h5>
                              		
                              	</div>
                           	
                           	
                           	
                           <div class="column__body">
                              <div style="text-align: justify;">Find a specialized workforce career that leads to a high income and unique skills.</div>
                              		</div>
                           </div>
                        <div class="column__col">
                           	
                           <div class="column__img">
                              		<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/college_transfer_programs/default.aspx" target="_self">
                                 			<img alt="A graduate student holding lawson degree" src="https://www.lawsonstate.edu/_resources/assets/img/grads.jpg">
                                 		</a>
                              		
                              	</div>
                           	
                           <div class="column__title">
                              		
                              <h5>
                                 			<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/college_transfer_programs/default.aspx" target="_self">COLLEGE TRANSFER PROGRAMS</a>	
                                 		</h5>
                              		
                              	</div>
                           	
                           	
                           	
                           <div class="column__body">
                              <div style="text-align: justify;">Get your best start with us.Take up to 64 credits and transfer to your four-year college
                                 of choice.</div>
                              		</div>
                           </div>
                        <div class="column__col">
                           	
                           <div class="column__img">
                              		<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/business_and_information_technologies_programs/default.aspx" target="_self">
                                 			<img alt="A skyscraper building photo" src="https://www.lawsonstate.edu/_resources/assets/img/business%20bldg.jpg">
                                 		</a>
                              		
                              	</div>
                           	
                           <div class="column__title">
                              		
                              <h5>
                                 			<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/business_and_information_technologies_programs/default.aspx" target="_self">BUSINESS AND INFORMATION TECHNOLOGIES </a>	
                                 		</h5>
                              		
                              	</div>
                           	
                           	
                           	
                           <div class="column__body">
                              <div style="text-align: justify;">Explore our Business and Computer Science Pathways. From Cyber Security and Computer
                                 hardware knowledge to Accounting and Economics, we have the program for you.</div>
                              		</div>
                           </div>
                        <div class="column__col">
                           	
                           <div class="column__img">
                              		<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/health_professions_programs/default.aspx" target="_self">
                                 			<img alt="A nursing students working in lab" src="https://www.lawsonstate.edu/_resources/assets/img/nursing.jpg">
                                 		</a>
                              		
                              	</div>
                           	
                           <div class="column__title">
                              		
                              <h5>
                                 			<a href="https://www.lawsonstate.edu/learn_at_lawson/programs_and_divisions/health_professions_programs/default.aspx" target="_self">HEALTH PROFESSIONS</a>	
                                 		</h5>
                              		
                              	</div>
                           	
                           	
                           	
                           <div class="column__body">
                              <div style="text-align: justify;">Lawson State has one of the strongest Health Professions Programs in the state. With
                                 options in Nursing, RAD Tech, EMS, Dental, or Sonography you cannot go wrong selecting
                                 a career in healthcare.</div>
                              		</div>
                           </div>
                        </div>
                     </div>
                  </section>
               
               
               
               
               	
               <section class="support">
                  		
                  <div class="section-content-holder">
                     			
                     <div class="support__header lined-header">
                        				
                        <div class="text-holder">
                           					
                           <div class="lined-header__subtile">
                              						
                              <div class="text-box">A Network of Success</div>
                              					</div>
                           					
                           <h2 class="lined-header__title">
                              						 We all need a support system. We're here for you...
                              					</h2>
                           				</div>
                        				
                        <div class="image-box">
                           					<picture>
                              						
                              <source media="(min-width:1024px)" srcset="https://www.lawsonstate.edu/_resources/assets/img/Rich%20Raymond%20Mechatronics.jpg">
                              						<img src="https://www.lawsonstate.edu/_resources/assets/img/Rich%20Raymond%20Mechatronics.jpg" alt="A person workin on the machine">
                              					</picture>
                           				</div>
                        			</div>
                     
                     			
                     <div class="content-holder">
                        				
                        <div class="support__list">
                           					
                           <div class="support__item">
                              	
                              <h3 class="support__title">In the Classroom</h3>
                              	
                              	
                              <div class="support__body">
                                 		Get in-person or virtual access to tutors, advisors, and mentors to help you succeed
                                 in class.
                                 	</div>
                              	
                              <div class="support__cta">
                                 		<a href="https://www.lawsonstate.edu/campus_life/student_support/academic_support/default.aspx" target="_self" class="cta--button">Academic Support</a>
                                 	</div>
                              </div>
                           <div class="support__item">
                              	
                              <h3 class="support__title">Beyond the Classroom</h3>
                              	
                              	
                              <div class="support__body">
                                 		We support the whole student by offering social, wellness, and financial support
                                 to make sure you can focus on your work.
                                 	</div>
                              	
                              <div class="support__cta">
                                 		<a href="https://www.lawsonstate.edu/campus_life/student_support/default.aspx" target="_self" class="cta--button">Student Support</a>
                                 	</div>
                              </div>
                           <div class="support__item">
                              	
                              <h3 class="support__title">After Graduation</h3>
                              	
                              	
                              <div class="support__body">
                                 		Over decades, we've built strong relationships across regional industries. See how
                                 we can help you take your career to the next level.
                                 	</div>
                              	
                              <div class="support__cta">
                                 		<a href="https://www.lawsonstate.edu/campus_life/student_support/career_transfer_support.aspx" target="_self" class="cta--button">Career Support</a>
                                 	</div>
                              </div>
                           				</div>
                        			</div>
                     		</div>
                  	</section>
                
               
               
