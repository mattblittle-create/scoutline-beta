        <div class="scripts">
            
    <script type="text/javascript">
        $(document).ready(function () {
            if ($(window).width() >= 1024) {
                $(".homepagevideo").attr("autoplay", "autoplay");
            }
            else {
                $(".homepagevideo").click(function () {
                    this.paused ? playVid(this) : pauseVid(this);
                });
            }
        })

        function playVid(video) {
            video.play();
            $(".playButton").hide();
        }

        function pauseVid(video) {
            video.pause();
            $(".playButton").show();
        }
    </script>

        </div>
        <div class="scripts">
            
        </div>
        <div class="scripts">
            
<script>
    $(document).ready(function () {
        $(window).scroll(function () {
            if ($(window).width() >= 992) {
                var scrollPosition = $(this).scrollTop();
                $('.parallax').css({
                    'background-position-y': (-(scrollPosition / 2)) + 'px' // Adjust the divisor to change the speed of parallax
                });
            } else {
                // Reset the background position for mobile devices
                $('.parallax').css({
                    'background-position-y': 'center'
                });
            }
        });
    });
</script>
