<script>
    $(document).ready(function () {
        $(window).scroll(function () {
            if ($(window).width() >= 992) {
                var scrollPosition = $(this).scrollTop();
                $('.parallax').css({
                    'background-position-y': (-(scrollPosition / 2)) + 'px' // Adjust the divisor to change the speed of parallax
                });
            } else {
                // Reset the background position for mobile devices
                $('.parallax').css({
                    'background-position-y': 'center'
                });
            }
        });
    });
