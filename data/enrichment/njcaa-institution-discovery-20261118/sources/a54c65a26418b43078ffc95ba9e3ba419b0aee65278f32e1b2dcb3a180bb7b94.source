                              <div class="group-caption field-group-div wrap">
                                <div class="field field--name-field-century-sliders-title field--type-text field--label-hidden">
                                  <div class="field__items">
                                    <div class="field__item even">
                                      Training for Careers!
                                    </div>
                                  </div>
                                </div>
                                <div class="field field--name-field-century-sliders-text field--name-field-century-sliders-link field--type-text-long field--label-hidden">
                                  <div class="field__items">
                                    <div class="field__item even">
                                      <p>
                                        Enhance your job skills, advance your career, or start a new career through credit and non-credit short-term certificate programs. Programs include Welding, Solar, Kitchen &amp; Bath, Manufacturing, Public Safety, Business, Health &amp; Human Services, Computers &amp; Technology, and more.
                                      </p>
                                      <p>
                                        <a href="/academics/programs-degrees/">Register for Short-Term Credit Certificates &gt;</a>
                                      </p>
                                      <p>
                                        <a title="Training for Careers!" href="/continuing-education">Register for Non-Credit Continuing Education Certificates &gt;</a>
                                      </p>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>`
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
									<section class="section-main">
										<div class="section-main-content">
