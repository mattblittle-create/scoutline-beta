width: 1201px)" type="image/jpeg" srcset="/live/image/gid/2/width/1500/height/610/crop/1/src_region/0,0,1500,610/5177_ROTATOR-DentalAssistant-1500x610.rev.1756077711.jpg 1x" data-origin="responsive"/><img src="/live/image/gid/2/width/1500/height/610/crop/1/src_region/0,0,1500,610/5177_ROTATOR-DentalAssistant-1500x610.rev.1756077711.jpg" alt="" width="1500" height="610" data-max-w="1500" data-max-h="610" data-optimized="true"/></picture>
