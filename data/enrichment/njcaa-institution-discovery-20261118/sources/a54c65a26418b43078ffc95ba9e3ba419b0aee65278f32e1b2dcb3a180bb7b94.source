                                            <span class="lw_item_thumb"><picture class="lw_image"><source type="image/webp" srcset="/live/image/scale/2x/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.webp 2x, /live/image/scale/3x/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.webp 3x" data-origin="responsive"/><source type="image/png" srcset="/live/image/scale/2x/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.png 2x, /live/image/scale/3x/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.png 3x" data-origin="responsive"/><img src="/live/image/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.png" alt="A student looks through a microscope in class." width="300" height="200" srcset="/live/image/scale/2x/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.png 2x, /live/image/scale/3x/gid/136/width/300/height/200/crop/1/src_region/0,0,3900,2600/4438_2024-MegaMenu-Biology.rev.1727880996.png 3x" data-max-w="3900" data-max-h="2600" loading="lazy" data-optimized="true"/></picture></span>
