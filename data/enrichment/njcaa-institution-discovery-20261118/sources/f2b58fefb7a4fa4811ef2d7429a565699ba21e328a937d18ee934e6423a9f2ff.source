    </script>
        <script>
        $(function() {
            var slickSelector = $('#component-headlines-209 .slick-slider');
            var navSelector = $('#component-headlines-209 .slick-nav-item');
            var activeClass = "slick-active";
            
            if (slickSelector.length && navSelector.length && slickSelector.hasClass('slick-initialized')) {
                var slickInstance = slickSelector.slick('getSlick');
                
                navSelector.on('click', function(e) {
                    var clickedIndex = $(this).index();
                    if (slickInstance && slickInstance.currentSlide != clickedIndex) {
                        slickSelector.slick('slickGoTo', clickedIndex);
                        navSelector.removeClass(activeClass).eq(clickedIndex).addClass(activeClass);
                    }
                });
                
                slickSelector.on('afterChange', function(e, slick) {
                    navSelector.removeClass(activeClass).eq(slick.currentSlide).addClass(activeClass);
                })
            }
        })
    </script>

