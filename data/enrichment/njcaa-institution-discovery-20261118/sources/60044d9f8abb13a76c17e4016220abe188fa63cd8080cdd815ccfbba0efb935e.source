                <section class="three-column stats">
                    <div class="container">
                        <h2><span 
                        data--400-top="left: 200px;" 
                        data-400-bottom="left: -50px;">By the</span> <span 
                        data--400-top="right: 60px;" 
                        data-400-bottom="right: -145px;">Numbers</span></h2>
                        <div class="row">
                            <div class="column revealOnScroll notOnMobile" data-animation="fadeIn" data-timeout="300">
                                <div class="content">
                                    <span class="stat">$20,000</span>
                                    <p class="stat-label">KC can save you on average $20,000 on your first two years of school.</p>
                                    
