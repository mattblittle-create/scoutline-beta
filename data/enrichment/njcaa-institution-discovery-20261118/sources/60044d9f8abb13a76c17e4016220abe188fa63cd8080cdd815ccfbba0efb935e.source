 <section class="info-group">
                    <div class="container"
                        data--1350-top="margin-top: -150px;"
                        data-1350-bottom="margin-top: 100px;">
                        <h2 class="h1">Around KC</h2>
                        <div class="events">
                          
                          <!-- event slider-->
                          
                          
                        </div>
                        <div class="event-list">
                          <script>

    window.addEventListener('load', e => {
        $('.event-list').empty();
        loadCalendar1();
        loadCalendar2();
        loadCalendar3();
      });

  	/*?events = 1 will display only one event per feed*/

    async function loadCalendar1() {
        const academicCalendar = 'https://25livepub.collegenet.com/calendars/academic-calendar-31.json?events=1';
        const response = await fetch(academicCalendar);
        const json = await response.json();
        homepageEvent(json, 'Academic Calendar', 'Academic Calendar Announcement');
    }

    async function loadCalendar2() {
        const academicCalendar = 'https://25livepub.collegenet.com/calendars/athletic-2.json?events=1';
        const response = await fetch(academicCalendar);
        const json = await response.json();
        homepageEvent(json, 'Athletics', 'Competition / Tournament');
    }

    async function loadCalendar3() {
        const academicCalendar = 'https://25livepub.collegenet.com/calendars/fine-arts-2.json?events=1';
        const response = await fetch(academicCalendar);
        const json = await response.json();
        homepageEvent(json, 'Fine Arts', 'Fine Arts');
    }

   function homepageEvent(json, calendarName, category) {
        if (json[0] != null) {
            const event = JSON.parse(JSON.stringify(json[0]));
            const startTime = new Date(event.startDateTime);
            const endTime = new Date(event.endDateTime);
            const month = shortMonth[startTime.getMonth()];
            const day = ("0" + startTime.getDate()).slice(-2);
            const link = `https://www.kaskaskia.edu/about-kc/news-events/events/?categories=${category}`;
            var html = `<div class="secondary event">
                <h3 class="h5"><a href="${link}" class="cta primary">${calendarName}<span class="icon-arrow" aria-hidden="true"></span> </a></h3>
                <div class="date">
                    <span class="month">${month}</span>
                    <span class="day">${day}</span>
                </div>
                <h4 class="h5"><a href="${event.permaLinkUrl}">${event.title}</a></h4>
                <p class="details"><span class="time"><strong>${formatTime(startTime)}-${formatTime(endTime)}</strong></span>`;
            if (event.location != '') {
                html = html + `&nbsp;|&nbsp; <span class="location">${event.location}</span>`;
            }
            html = html + '</p></div>';

            const resultsSection = document.querySelector('.event-list');
            const currentHtml = resultsSection.innerHTML;
            resultsSection.innerHTML = currentHtml + html;
        }

    }


    function formatTime(date) {
        var hours = date.getHours();
        var minutes = date.getMinutes();
        var ampm = hours >= 12 ? 'pm' : 'am';
        hours = hours % 12;
        hours = hours ? hours : 12; // the hour '0' should be '12'
        minutes = minutes < 10 ? '0' + minutes : minutes;
        var strTime = hours + ':' + minutes + ' ' + ampm;
        return strTime;
    }


    const shortMonth = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ];

</script><div class="secondary event">
                                    <h3 class="h5"><a href="/about-kc/news-events/events/?categories%5B%5D=Campus+Event" class="cta primary">Campus Event<span class="icon-arrow" aria-hidden="true"></span> </a></h3>


  
  </div><div class="secondary event">
                                    <h3 class="h5"><a href="/about-kc/news-events/events/?categories%5B%5D=Athletics" class="cta primary">Athletics<span class="icon-arrow" aria-hidden="true"></span> </a></h3>


  
  </div><div class="secondary event">
                                    <h3 class="h5"><a href="/about-kc/news-events/events/?categories%5B%5D=Fine+Arts" class="cta primary">Fine Arts<span class="icon-arrow" aria-hidden="true"></span> </a></h3>


  
  </div>                              
                          <div class="slick-navigation"></div>
                        </div>
