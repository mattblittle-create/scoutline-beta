/* The theme's own submenu-toggle span duplicates .dropdown-button (most visibly at mobile
   widths, ~990px and below) and can sit on top of it intercepting clicks. Removing it from
   layout entirely leaves .dropdown-button as the one toggle control at every screen size. */
.rd-navbar-submenu-toggle {
	display: none !important;
}
.dropdown-button {
	display: inline-flex !important;
	align-items: center;
	justify-content: center;
	width: 1.75em;
	height: 1.75em;
	margin: 0 0 0 0.15em;
	padding: 0;
	border: none !important;
	background: none !important;
	color: inherit;
	cursor: pointer;
	vertical-align: middle;
}
.dropdown-button-icon {
	display: block;
	width: 0.5em;
	height: 0.5em;
	border-right: 0.15em solid currentColor;
	border-bottom: 0.15em solid currentColor;
	transform: rotate(45deg);
	transition: transform 0.2s ease;
}
.dropdown-button[aria-expanded="true"] .dropdown-button-icon {
	transform: rotate(-135deg);
}
.rd-navbar-dropdown,
.rd-navbar-megamenu {
	visibility: hidden !important;
	opacity: 0 !important;
}
.rd-navbar-dropdown.is-open,
.rd-navbar-megamenu.is-open {
	display: block !important;
	visibility: visible !important;
	opacity: 1 !important;
}
</style>
<script>
//<![CDATA[
(function () {
	function closeMenu(button) {
		button.setAttribute('aria-expanded', 'false');
		var submenu = document.getElementById(button.getAttribute('aria-controls'));
		if (submenu) { submenu.classList.remove('is-open'); }
	}

	function openMenu(button) {
		button.setAttribute('aria-expanded', 'true');
		var submenu = document.getElementById(button.getAttribute('aria-controls'));
		if (submenu) { submenu.classList.add('is-open'); }
	}

	function closeAllMenus(except) {
		document.querySelectorAll('.dropdown-button[aria-expanded="true"]').forEach(function (button) {
			if (button !== except) { closeMenu(button); }
		});
	}

	document.addEventListener('click', function (event) {
		var button = event.target.closest && event.target.closest('.dropdown-button');
		if (button) {
			var isOpen = button.getAttribute('aria-expanded') === 'true';
			closeAllMenus(button);
			if (isOpen) { closeMenu(button); } else { openMenu(button); }
			return;
		}
		if (!event.target.closest('.rd-navbar-nav')) {
			closeAllMenus();
		}
	});

	document.addEventListener('keydown', function (event) {
		if (event.key !== 'Escape') { return; }
		var openButton = document.querySelector('.dropdown-button[aria-expanded="true"]');
		if (openButton) {
			closeMenu(openButton);
			openButton.focus();
		}
	});
})();
//]]>
</script>


