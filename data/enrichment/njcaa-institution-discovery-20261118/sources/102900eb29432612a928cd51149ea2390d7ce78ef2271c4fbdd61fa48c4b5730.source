          </div>
  
    </div>
            <div  class="hfc-show-content">
            <div class="paragraph paragraph--type--simple-text-area paragraph--view-mode--default">
              
            <div class="clearfix text-formatted field field--name-field-long-text field--type-text-long field--label-hidden field__item"><p>Join in student clubs, sports, gaming and competitions, campus events, volunteer experiences.</p>

<p><a href="/campus-life/#get-involved" class="hfc-button">Get Involved</a></p></div>
      
          </div>
  
