.forminator-ui input::placeholder,
.forminator-ui textarea::placeholder {
    color: #383838 !important;
    opacity: 1 !important;
}
.forminator-description {
  color: #660000 !important;              /* Darker red for better contrast */
  text-decoration-color: #660000 !important;
	font-size: 110% !important;
	background-color: #ffffff !important;
}

.quick-links a.links-btn {
  display: flex;
  align-items: center;
  justify-content: center;
min-width: 44px;            /* enforce minimum width */
}
.entry-content ul li a {
  display: inline-flex;              
  align-items: center;        /* vertical centering */
  min-width: 44px;            /* enforce minimum width */
}
/* WCAG styles for bulleted lists with mobile specs */
/* Widget Area bullet: keep it in inline flow and stable */
.widget-area ul li::before {
  content: "\f101";             
  font-family: FontAwesome;
  color: rgb(252,185,0);
  font-size: 16px;
  line-height: 1.2;              
  display: inline-block;         
  margin-right: 8px;             
}

/* Widget area list text: separate line-height for comfortable reading */
.widget-area ul li {
  font-size: 14px;
  line-height: 1.6;              
  position: relative;
  padding-left: 22px;            
}

/* Entry-content base style: clean, compact lists for desktop */
.entry-content ul li a {
  display: inline-block;
  /* padding: 2px 8px;  */      
  text-decoration: none;
  color: #333;
}

/* =========================================================
   Mobile / Touch styles (larger tap targets)
   Applies to small screens OR coarse / non-hover pointers
   ========================================================= */
@media screen and (max-width: 768px),
       screen and (hover: none) and (pointer: coarse) {

  /* =========================================
     Widget-Area side menu mobile/touch style
     Larger tap targets
     ========================================= */

  .widget-area ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .widget-area ul li {
    position: static;     /* no absolute bullet */
    padding-left: 0;      /* remove desktop bullet spacing */
    margin-bottom: 8px;   /* spacing between tap targets */
  }

  .widget-area ul li::before {
    content: none;        /* hide custom bullet on touch */
  }

  .widget-area ul li a {
    display: flex;              /* flex ensures centering */
    align-items: center;        /* vertical centering */
    justify-content: flex-start;/* keep text left-aligned */
    min-width: 44px;            /* enforce WCAG width */
    min-height: 44px;           /* enforce WCAG height */
    padding: 8px 12px;          /* extra breathing room */
    background-color: #f9f9f9;  /* subtle background for clarity */
    border-radius: 4px;         /* touch-friendly rounded edges */

    /* Added for larger text */
    font-size: 16px;            /* bump up text size */
    line-height: 1.4;           /* keep spacing comfortable */
    font-weight: 500;           /* optional: make text a bit bolder */

    margin-left: 8px;
  }

  /* =========================================
     Entry-content mobile/touch style
     Larger tap targets for lists
     ========================================= */

  .entry-content ul {
    list-style: none !important;  /* optional: remove bullets */
    padding: 0;
  }

  .entry-content ul li {
    margin-bottom: 8px;         /* spacing between tap targets */
  }

  .entry-content ul li a {
    display: flex;              /* flex ensures centering */
    align-items: center;
    justify-content: flex-start;/* keep text left-aligned */
    min-width: 44px;            /* enforce WCAG width */
    min-height: 44px;           /* enforce WCAG height */
    padding: 8px 12px;          /* extra breathing room */
    background-color: #f9f9f9;  /* subtle background for clarity */
    border-radius: 4px;         /* touch-friendly rounded edges */
  }

  /* =========================================
     Accordions (mobile)
     Remove bullets in accordion lists
     ========================================= */

  .ui-widget-content li::before {
    display: none;
  }
}
.quick-links a.links-btn {
  display: flex;
  align-items: center;
  justify-content: center;
min-width: 44px;            /* enforce minimum width */
}

/* blog prev/next article a:visited link color for accessibilty */
div.nav-next a:visited {
    color: #ffffff !important;
}
div.nav-links a:hover {
    color: #ffffff !important;
}
/* Prospective Interest Form majors list color for accessibility*/
li.select2-results__option {
    color: #000 !important;
    background-color: #fff !important;
}

/* Hover state for selectable options */
li.select2-results__option--selectable:hover {
    color: #000 !important;
    background-color: #fbffad !important;
}

/* Selected option styling */
li.select2-results__option--selected {
    color: #fff !important;
    background-color: #666 !important; /* example */
}
/*.eeSFL section.eeFiles {padding:0;margin:0;}
.eeSFL_Item {padding-bottom:0;margin-bottom:0;}
.eeSFL_FileDetails {display:none;}*/

/* Target the file list container */
.eeSFL section.eeFiles {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 0; /* no spacing between tiles */
  margin: 0 !important;
  padding: 0 !important;
}

/* Normalize each tile */
.eeSFL_Item {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  box-sizing: border-box;
}

/* Collapse file details completely */
.eeSFL_FileDetails {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
  height: 0 !important;
}


/* Accessibility tweaks for footer links */
.footer-active-2 .wp-block-list li a {
  text-decoration: underline dotted;
  text-decoration-thickness: 1px;
  text-underline-offset: 2px;
  text-decoration-color: lightblue;
  color: inherit;   /* keep text color unchanged */
  transition: text-decoration-color 0.3s ease,
              text-decoration-style 0.3s ease;
}

.footer-active-2 .wp-block-list li a:hover {
  text-decoration-style: solid; /* switch to solid underline on hover */
  text-decoration-color: white; /* brighter white underline on hover */
}

/* tweaks to GTranslate look and feel */
.gtranslate-wrapper {
    display: inline-block;
    width: auto;
    white-space: nowrap;
}

.gtranslate-wrapper select {
    width: auto !important;
    min-width: max-content;
background-color: #faf7f2 !important; /* warm off‑white */ color: #333; border: 1px solid #ccc; border-radius: 6px; padding: 4px 8px;
}

/* end bulleted list styles for mobile */
/*
.entry-content a {
  text-decoration: underline dotted; /* Ensures basic underline support */
/*  text-decoration-thickness: 1px;    /* Very thin line */
/*  text-underline-offset: 2px;        /* Small gap between text and line */
/*  text-decoration-color: rgba(70, 130, 180, 0.7); /* Normal state color, Subtle color (e.g., semi-transparent blue) */
/*}

.entry-content a:hover {
  text-decoration-color: rgba(255, 0, 0, 0.7); /* Hover state color only (e.g., semi-transparent red) */
/*}*/

/* Styles that only apply when printing */
/* Styles that only apply when printing */
@media print  {
 #tophead, #main-nav, #breadcrumb, #sidebar-primary, #footer-widgets, .search-section, .scrollup, .site-footer {
    display: none !important; /* Hides the element and removes its space */
  }

/*video iframe removal*/
div[style*="padding: 56.25%"] {
    display: none !important;
  }

  h1, h2, h3, h4, h5, h6 {
    break-after: avoid;
  }

  h1 + *, 
  h2 + *, 
  h3 + *, 
  h4 + *, 
  h5 + *, 
  h6 + * {
    break-before: avoid;
  }
	
.site-content {padding: 0px 0;}
#primary {width: 80%; margin-left: 60px; margin-right: 45px;}
.site-header {padding: 0px 0;
	margin-top: 10px;
	margin-left: 60px;}
}
/*cost to attend accessible table styles*/
.cost-table {
  width: 100%;
  border-collapse: collapse;
}

.cost-table th,
.cost-table td {
  padding: 0.5rem;
  border-bottom: 1px solid #ccc;
}

.cost-table thead th {
  background-color: #F5DA27; /* updated gold */
  color: #000; /* maintains AA contrast */
}

.cost-table .text-center {
  text-align: center;
}

/*scholarship tips table*/
.do-dont-table td p {
  margin: 0;
  font-size: inherit;
}

.back-to-student-jobs {font-size: 1.1em;}
.back-to-student-jobs a,
.back-to-student-jobs a:visited {
    color: #005694;
		display: inline-block;
		min-height: 44px;
		padding: 12px;
		line-height: 1.2;
}
.back-to-student-jobs a:hover,
.back-to-student-jobs a:focus {
    text-decoration: underline;
}

/* WCAG 2.1AA interactive elements size */
#quick-contact .quick-call {
	float: none;
	display: flex;
	align-items: center;
	gap: 0.35rem;
	line-height: 1.5;
	box-sizing: border-box;
	transform: translateY(2px);
}
/* Quick Links button */
.quick-links a.links-btn {
	min-height: 44px;
	box-sizing: border-box;
}

/* Vertically center the dropdown arrow */
.quick-links a.links-btn::before {
	top: 65%;
	transform: translateY(-50%);
}

/* Dropdown menu links */
.quick-links ul li a {
	display: flex;
	align-items: center;
	min-height: 44px;
	box-sizing: border-box;
}
/* RCTC Address - google maps link - in footer */
.textwidget p a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    box-sizing: border-box;
margin-top: -6px;
margin-bottom: -6px;
}
/* WCAG 2.1 AA interactive elements size */
/* Targets lists inside the main article content area only */
.entry-content ul li a {
    position: relative;
    display: inline-block;
    vertical-align: top;
}

/* Creates a 44px invisible hit target box */
.entry-content ul li a::before {
    content: "";
    position: absolute;
    top: -8px;    /* Expands the target slightly up */
    bottom: -8px; /* Expands the target slightly down */
    left: -25px;  /* Expands the target left over the bullet point */
    right: -25px; /* Expands the target right into empty space */
}</style></head>

