<!-- added for pickplugins accordions -->
<script>
jQuery(document).ready(function($) {
    function forceSequentialTabs() {
        // Enforce all headers are part of the natural Tab sequence
        $('.accordions-items .accordion-header, .accordions .accordion-header').each(function() {
            $(this).attr('tabindex', '0').attr('aria-selected', 'false');
        });
    }

    // Run on page load
    setTimeout(forceSequentialTabs, 500);

    // Re-enforce standard tabbing whenever an accordion header is clicked or activated
    $(document).on('click', '.accordion-header', function() {
        setTimeout(forceSequentialTabs, 50);
    });
});
</script>

