/*Google Search Results*/
/* Use a different font family for search results */
    .gs-title, .gs-snippet {
    font-family: 'Avenir LT Std' !important;     
    }
/* Add a border between individual search results */
    .gs-webResult {
        /*border: 1px solid #cccccc;
        padding: 1em;*/
