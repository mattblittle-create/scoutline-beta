                  <div class="sm:grid grid-cols-2 gap-8">
                     <div>
                        <h2 class="uppercase heading-border font-bold text-4xl text-blue-primary">News</h2>
                        
    <div class="efsc-stories space-y-4" data-col="1">
        <div class="sm:grid grid-cols-2 gap-2">
            <div>
                <img src="https://www.easternflorida.edu/news-events/images/featured/programming-competition-2026-500x500.jpg" alt="1st place programming competition winner, Bradley Bellis, holding a paper with his placement" width="308px" height="308px" class="object-cover h-full w-full">
            </div>
            <div class="efsc-story">
                <h3 class="heading-border font-bold leading-tight">EFSC Students Showcase Coding Talents During Annual Programming Competition</h3>
                <div class="text-right">
                    <a href="https://www.easternflorida.edu/news-events/news-releases/2026/11-10-efsc-students-showcase-coding-talents-during-annual-programming-competition.php" class="efsc-cta white-cta">
                        <span>Read More About </span>
                        <em>
                            <svg width="24px" height="24px" viewBox="0 0 34 34" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g>
