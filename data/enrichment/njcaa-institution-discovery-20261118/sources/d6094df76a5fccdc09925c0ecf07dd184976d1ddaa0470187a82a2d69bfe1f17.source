                     <div class="text-white bg-blue-primary justify-between flex flex-col md:bg-opacity-75 md:bg-blue-saturated ">
                        <div class="px-6 py-8 justify-between flex flex-col flex-grow">
                           <h3 class="heading-border font-bold text-4xl">Sign up for Classes</h3>
                           <p class="text-base flex-grow hidden md:block">Find convenient classes on campus and online, scheduled to meet your needs.</p><a class="efsc-cta transparent-cta text-white border-white" href="/registrar/registration/index.php"><span>Register for Classes</span><em role="presentation" class="text-green-900"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 34 34" version="1.1">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
