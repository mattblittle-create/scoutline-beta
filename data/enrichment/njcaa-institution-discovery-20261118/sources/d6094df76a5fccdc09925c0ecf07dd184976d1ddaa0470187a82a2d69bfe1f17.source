         <div class="relative mt-16"><img class="w-full hidden md:block" src="/_resources/images/home_explore_bg.jpg" alt="Explore EFSC" width="1366" height="923"><div class="md:absolute w-full md:bottom-nudge">
               <div class="container">
                  <div class="grid md:grid-cols-3 md:gap-8">
                     <div class="text-white bg-blue-primary justify-between flex flex-col md:bg-opacity-75 md:bg-blue-saturated ">
                        <div class="px-6 py-8 justify-between flex flex-col flex-grow">
                           <h3 class="heading-border font-bold text-4xl">Explore EFSC</h3>
                           <p class="text-base flex-grow hidden md:block">We offer more than 100 degrees &amp; certificates to help you achieve your career goals.</p><a class="efsc-cta transparent-cta text-white border-white" href="/request-info/"><span>Request Information</span><em role="presentation" class="text-green-900"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 34 34" version="1.1">
