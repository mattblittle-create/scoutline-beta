nu-item menu-item-type-post_type menu-item-object-page menu-item-23006"><a href="https://www.jeffco.edu/request-info/">Request Information</a></li></ul></div></nav></div><div id="div_block-269-2544" class="ct-div-block" ><h3 id="headline-491-2544" class="ct-headline">International Student</h3><nav id="_nav_menu-1424-2544" class="oxy-nav-menu oxy-nav-menu-dropdowns oxy-nav-menu-dropdown-arrow oxy-nav-menu-vertical" ><div class='oxy-menu-toggle'><div class='oxy-nav-menu-hamburger-wrap'><div class='oxy-nav-menu-hamburger'><div class='oxy-nav-menu-hamburger-line'></div><div class='oxy-nav-menu-hamburger-line'></div><div class='oxy-nav-menu-hamburger-line'></div></div></div></div><div class="menu-community-member-quick-links-container"><ul id="menu-community-member-quick-links" class="oxy-nav-menu-list"><li id="menu-item-23002" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23002"><a href="https://www.jeffco.edu/jobs/">Human Resources &amp; Jobs</a></li><li id="menu-item-22999" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-22999"><a href="https://www.jeffco.edu/ecc/">Early Childhood Center</a></li><li id="menu-item-23003" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23003"><a href="https://www.jeffco.edu/friday-speaker-series/">Friday Speaker Series</a></li><li id="menu-item-23001" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23001"><a href="https://www.jeffco.edu/facilities/">Facilities</a></li><li id="menu-item-3835" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-3835"><a href="https://athletics.jeffco.edu/landing/index">Athletics</a></li><li id="menu-item-23000" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23000"><a href="https://www.jeffco.edu/fine-arts/">Fine Arts</a></li></ul></div></nav></div></div></section><section id="section-271-2544" class=" ct-section" ><div class="ct-section-inner-wrap"><a id="link-272-2544" class="ct-link oxel_icon_button__container" href="#section-243-2544" target="_self"   role="button"><div id="fancy_icon-273-2544" class="ct-fancy-icon oxel_icon_button_icon" ><svg id="svg-fancy_icon-273-2544"><use xlink:href="#FontAwesomeicon-long-arrow-down"></use></svg></div><div id="text_block-1096-2544" class="ct-text-block sr-only" >Open/Close quicklinks menu<br></div></a></div></section><section id="section-106-2544" class=" ct-section" ><div class="ct-section-inner-wrap"><div id="div_block-109-2544" class="ct-div-block" ><h2 id="headline-111-2544" class="ct-headline">Belong Here, Succeed anywhere</h2><div id="_rich_text-107-2544" class="oxy-rich-text" ><p>At Jefferson College, you’ll find a supportive community ready to help you thrive. Explore our flexible programs, build hands-on skills, and step confidently into your future.</p></div></div><div id="div_block-108-2544" class="ct-div-block" ><h2 id="headline-114-2544" class="ct-headline">Find A Program</h2><div id="div_block-116-2544" class="ct-div-block" ><div id="fancy_icon-118-2544" class="ct-fancy-icon" ><svg id="svg-fancy_icon-118-2544"><use xlink:href="#FontAwesomeicon-search"></use></svg></div><div id="_search_form-115-2544" class="oxy-search-form" ><form role="search" method="get" class="search-form" action="https://www.jeffco.edu/"> <label> <span class="screen-reader-text">Search for:</span> <input type="search" class="search-field" placeholder="Search &hellip;" value="" name="s" data-swplive="true" data-swpengine="default" data-swpconfig="default" /> </label> <input type="submit" class="search-submit" value="Search" /></form></div></div><div id="code_block-1222-2544" class="ct-code-block" ></div></div></div></section><section id="section-31-2544" class=" ct-section" ><div class="ct-section-inner-wrap"><h2 id="headline-32-2544" class="ct-headline">opportunities for everyone</h2><div id="div_block-69-2544" class="ct-div-block" ><div id="div_block-72-2544" class="ct-div-block" ><div id="div_block-65-2544" class="ct-div-block" ><img loading="lazy" id="image-120-2544" alt="digi comm academic programs" src="https://www.jeffco.edu/wp-content/uploads/2026/11/digi-comm-academic-programs-768x576.png" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2026/11/digi-comm-academic-programs-768x576.png 768w, https://www.jeffco.edu/wp-content/uploads/2026/11/digi-comm-academic-programs-300x225.png 300w" sizes="(max-width: 768px) 100vw, 768px" /><div id="div_block-40-2544" class="ct-div-block" ><h3 id="headline-41-2544" class="ct-headline">Academic Programs</h3><div id="text_block-44-2544" class="ct-text-block" >Launch your college journey with dynamic associate degrees and seamless transfer pathways designed to fit your goals and fuel your future.</div><div id="div_block-59-2544" class="ct-div-block" ><a id="link_text-61-2544" class="ct-link-text" href="https://www.jeffco.edu/academics/programs/"   >Explore Academic Programs</a></div></div></div></div><div id="div_block-76-2544" class="ct-div-block" ><div id="div_block-77-2544" class="ct-div-block" ><img loading="lazy" id="image-124-2544" alt="workforce" src="https://www.jeffco.edu/wp-content/uploads/2026/11/workforce-768x576.png" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2026/11/workforce-768x576.png 768w, https://www.jeffco.edu/wp-content/uploads/2026/11/workforce-300x225.png 300w" sizes="(max-width: 768px) 100vw, 768px" /><div id="div_block-79-2544" class="ct-div-block" ><h3 id="headline-80-2544" class="ct-headline">Workforce Training</h3><div id="text_block-82-2544" class="ct-text-block" >Fast-track your career with hands-on technical training and in-demand industry certifications built to get you ahead in the workforce now.</div><div id="div_block-83-2544" class="ct-div-block" ><a id="link_text-85-2544" class="ct-link-text" href="https://www.jeffco.edu/wes/"   >Explore Workforce Training</a></div></div></div></div><div id="div_block-96-2544" class="ct-div-block" ><div id="div_block-97-2544" class="ct-div-block" ><img loading="lazy" id="image-122-2544" alt="ats biomed high school" src="https://www.jeffco.edu/wp-content/uploads/2026/11/ATS-biomed-high-school-768x576.png" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2026/11/ATS-biomed-high-school-768x576.png 768w, https://www.jeffco.edu/wp-content/uploads/2026/11/ATS-biomed-high-school-300x225.png 300w" sizes="(max-width: 768px) 100vw, 768px" /><div id="div_block-99-2544" class="ct-div-block" ><h3 id="headline-100-2544" class="ct-headline">High School Offerings</h3><div id="text_block-102-2544" class="ct-text-block" >Jump-start your future today by earning college credits early or building real-world technology skills while still enrolled in high school.</div><div id="div_block-103-2544" class="ct-div-block" ><a id="link_text-105-2544" class="ct-link-text" href="https://www.jeffco.edu/high-school-programs/"   >Explore High School Offerings</a></div></div></div></div><div id="div_block-86-2544" class="ct-div-block" ><div id="div_block-87-2544" class="ct-div-block" ><img loading="lazy" id="image-123-2544" alt="adult ed vet tech" src="https://www.jeffco.edu/wp-content/uploads/2026/11/adult-ed-vet-tech.png" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2026/11/adult-ed-vet-tech.png 1200w, https://www.jeffco.edu/wp-content/uploads/2026/11/adult-ed-vet-tech-300x225.png 300w, https://www.jeffco.edu/wp-content/uploads/2026/11/adult-ed-vet-tech-1024x768.png 1024w, https://www.jeffco.edu/wp-content/uploads/2026/11/adult-ed-vet-tech-768x576.png 768w" sizes="(max-width: 1200px) 100vw, 1200px" /><div id="div_block-89-2544" class="ct-div-block" ><h3 id="headline-90-2544" class="ct-headline">Adult Education and Literacy</h3><div id="text_block-92-2544" class="ct-text-block" >Unlock great new possibilities with free support to earn your high school equivalency, build core skills, and achieve your full potential.</div><div id="div_block-93-2544" class="ct-div-block" ><a id="link_text-95-2544" class="ct-link-text" href="https://www.jeffco.edu/ael/"   >Explore Adult Education</a></div></div></div></div></div></div></section><section id="section-204-2544" class=" ct-section" ><div class="ct-section-inner-wrap"><div id="div_block-225-2544" class="ct-div-block" ><div id="code_block-274-2544" class="ct-code-block" ><hr/></div></div><div id="div_block-226-2544" class="ct-div-block" ><div id="new_columns-276-2544" class="ct-new-columns" ><div id="div_block-277-2544" class="ct-div-block" ><div id="div_block-227-2544" class="ct-div-block" ><img  id="image-282-2544" alt="Jefferson College White Viking Helmet" src="https://www.jeffco.edu/wp-content/uploads/2024/08/helmet.png" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2024/08/helmet.png 378w, https://www.jeffco.edu/wp-content/uploads/2024/08/helmet-300x284.png 300w" sizes="(max-width: 378px) 100vw, 378px" /></div><div id="div_block-228-2544" class="ct-div-block" ><h3 id="headline-241-2544" class="ct-headline">Ready to get started?</h3></div></div><div id="div_block-278-2544" class="ct-div-block" ><div id="div_block-229-2544" class="ct-div-block" ><a id="link_button-242-2544" class="ct-link-button" href="https://www.jeffco.edu/getting-started/"   >Learn how to apply</a></div></div></div></div></div></section><section id="section-283-2544" class=" ct-section" ><div class="ct-section-inner-wrap"><div id="new_columns-284-2544" class="ct-new-columns" ><div id="div_block-285-2544" class="ct-div-block" ><div id="div_block-291-2544" class="ct-div-block" ><div id="div_block-292-2544" class="ct-div-block" ><a id="div_block-293-2544" class="ct-link hoverStat" href="http://" target="_self"  ><h3 id="headline-294-2544" class="ct-headline">27,000+</h3><div id="text_block-296-2544" class="ct-text-block" >Graduates Since 1966<br></div></a><a id="div_block-306-2544" class="ct-link hoverStat" href="http://" target="_self"  ><h3 id="headline-307-2544" class="ct-headlin