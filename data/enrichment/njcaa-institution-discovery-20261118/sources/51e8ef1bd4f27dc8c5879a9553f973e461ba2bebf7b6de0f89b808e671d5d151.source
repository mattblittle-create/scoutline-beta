.js?ver=1.4.4"></script> <script defer id="hoverIntent-js" src="https://www.jeffco.edu/wp-includes/js/hoverIntent.min.js?ver=1.10.2"></script> <script defer id="megamenu-js" src="https://www.jeffco.edu/wp-content/plugins/megamenu/js/maxmegamenu.min.js?ver=3.10.10"></script> <script defer id="searchwp-forms-js-extra" src="data:text/javascript;base64,"></script> <script defer id="searchwp-forms-js" src="https://www.jeffco.edu/wp-content/plugins/searchwp/assets/js/frontend/search-forms.min.js?ver=4.6.1.1"></script> <script defer id="ct-footer-js" src="data:text/javascript;base64,"></script><script defer src="data:text/javascript;base64,"></script> <script defer id="ct_code_block_js_1222" src="data:text/javascript;base64,"></script> <style type="text/css" id="ct_code_block_css_274">hr {
  border: none;
  color: #fff;
  background-color: transparent;
  height: 1px;
  width: 2vw;
}</style> <script defer id="ct_code_block_js_1145" src="data:text/javascript;base64,"></script> <style type="text/css" id="ct_code_block_css_1473">.mz-events {
    width:100%;
   min-width:100%;
  }

  .mz-events__heading {
    margin: 0 0 .75rem;
  }

  .mz-events .eventNew {
    display: flex;
    text-decoration: none;
    justify-content:flex-start;
    margin-bottom: .75rem;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .08);
    transition: box-shadow .18s ease, transform .18s ease;
    min-height:140px
  }

  .mz-events a.eventNew:hover,
  .mz-events a.eventNew:focus-visible {
    box-shadow: 0 4px 16px rgba(0, 0, 0, .16);
    transform: translateY(-1px);
  }

  .mz-events a.eventNew:focus-visible {
    outline: 2px solid #c8102e;
    outline-offset: 2px;
  }

  .mz-events .eventDate {
    aspect-ratio: 1/1;
    background: #c8102e;
    color: #fff;
    padding: 1rem;
    justify-content: center;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    text-align: center;
  }

  .mz-events .eventDate .month {
    font-weight: bold;
    font-size: 1.75rem;
    line-height: 1;
  }

  .mz-events .eventDate .day {
    font-weight: bold;
    font-size: 2.75rem;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .mz-events .eventDetail {
    color: #000;
    padding: 1rem 1.5rem;
    min-width: 0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-content:center;
    justify-items:center;
  }

  .mz-events .eventDetail h3 {
    margin: 0 0 .35rem;
    font-size: 1.0625rem;
    line-height: 1.25;
  }

  .mz-events .eventDetail p {
    margin: 0 0 .35rem;
    font-size: .9375rem;
  }

  .mz-events .eventTime {
    font-weight: 600;
    color: #c8102e;
  }

  .mz-events .eventWhere {
    color: #444;
  }

  .mz-events .eventDesc {
    color: #555;
  }

  .mz-events__empty {
    margin: 0;
    padding: 1rem;
    background: #f6f6f6;
    color: #333;
  }

  @media (max-width: 380px) {
    .mz-events .eventDate .month {
      font-size: 1.25rem;
    }

    .mz-events .eventDate .day {
      font-size: 2rem;
    }

    .mz-events .eventDetail {
      padding: .85rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mz-events .eventNew {
      transition: none;
    }
  }</style> <script defer id="ct_code_block_js_162" src="data:text/javascript;base64,"></script> </body></html>