.jeffco.edu/wp-content/uploads/2025/11/A47A0486-scaled.jpg" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2025/11/A47A0486-scaled.jpg 2560w, https://www.jeffco.edu/wp-content/uploads/2025/11/A47A0486-300x200.jpg 300w, https://www.jeffco.edu/wp-content/uploads/2025/11/A47A0486-1024x683.jpg 1024w, https://www.jeffco.edu/wp-content/uploads/2025/11/A47A0486-768x512.jpg 768w, https://www.jeffco.edu/wp-content/uploads/2025/11/A47A0486-1536x1024.jpg 1536w, https://www.jeffco.edu/wp-content/uploads/2025/11/A47A0486-2048x1365.jpg 2048w" sizes="(max-width: 2560px) 100vw, 2560px" /></div></div></div><div id="code_block-1145-2544" class="ct-code-block" ></div></div></section><section id="section-500-2544" class=" ct-section" ><div class="ct-section-inner-wrap"><h2 id="headline-502-2544" class="ct-headline">What's Happening</h2><div id="div_block-501-2544" class="ct-div-block" ><div id="div_block-543-2544" class="ct-div-block home-event-container" ><div id="_dynamic_list-583-2544" class="oxy-dynamic-list"><div id="div_block-584-2544-1" class="ct-div-block home-event-post" data-id="div_block-584-2544"><a id="link-599-2544-1" class="ct-link" href="https://www.jeffco.edu/news/president-announces-retirement/" target="_self" data-id="link-599-2544"><img id="image-590-2544-1" alt="dena mccaffrey news" src="https://www.jeffco.edu/wp-content/uploads/2026/11/Dena-McCaffrey-News.jpg" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2026/11/Dena-McCaffrey-News.jpg 1000w, https://www.jeffco.edu/wp-content/uploads/2026/11/Dena-McCaffrey-News-300x300.jpg 300w, https://www.jeffco.edu/wp-content/uploads/2026/11/Dena-McCaffrey-News-150x150.jpg 150w, https://www.jeffco.edu/wp-content/uploads/2026/11/Dena-McCaffrey-News-768x768.jpg 768w" sizes="(max-width: 1000px) 100vw, 1000px" data-id="image-590-2544"><div id="div_block-606-2544-1" class="ct-div-block event-post-text" data-id="div_block-606-2544"><div id="code_block-631-2544-1" class="ct-code-block" data-id="code_block-631-2544"></div><h3 id="headline-1041-2544-1" class="ct-headline" data-id="headline-1041-2544"><span id="span-1047-2544-1" class="ct-span" data-id="span-1047-2544">President Dr. Dena McCaffrey Announces Retirement at the Close of the 2027-28 School Year</span></h3><div id="text_block-644-2544-1" class="ct-text-block" data-id="text_block-644-2544"><span id="span-646-2544-1" class="ct-span" data-id="span-646-2544">After nearly twenty years serving Jefferson College, President Dr. Dena McCaffrey announced her decision to retire at the end of her current contract, which expires on June 30, 2028. At [&hellip;]</span></div><a id="link_text-609-2544-1" class="ct-link-text post-link" href="https://www.jeffco.edu/news/president-announces-retirement/" target="_self" data-id="link_text-609-2544">Read the story<br></a></div></a></div><div id="div_block-584-2544-2" class="ct-div-block home-event-post" data-id="div_block-584-2544"><a id="link-599-2544-2" class="ct-link" href="https://www.jeffco.edu/news/bot-vacancies/" target="_self" data-id="link-599-2544"><img id="image-590-2544-2" alt="Jefferson College Seal" src="https://www.jeffco.edu/wp-content/uploads/2026/11/College-Seal-News.jpg" class="ct-image" srcset="https://www.jeffco.edu/wp-content/uploads/2026/11/College-Seal-News.jpg 1000w, https://www.jeffco.edu/wp-content/uploads/2026/11/College-Seal-News-300x300.jpg 300w, https://www.jeffco.edu/wp-content/uploads/2026/11/College-Seal-News-150x150.jpg 150w, https://www.jeffco.edu/wp-content/uploads/2026/11/College-Seal-News-768x768.jpg 768w" sizes="(max-width: 1000px) 100vw, 1000px" data-id="image-590-2544"><div id="div_block-606-2544-2" class="ct-div-block event-post-text" data-id="div_block-606-2544"><div id="code_block-631-2544-2" class="ct-code-block" data-id="code_block-631-2544"></div><h3 id="headline-1041-2544-2" class="ct-headline" data-id="headline-1041-2544"><span id="span-1047-2544-2" class="ct-span" data-id="span-1047-2544">Notice of Vacancies on Board of Trustees</span></h3><div id="text_block-644-2544-2" class="ct-text-block" data-id="text_block-644-2544"><span id="span-646-2544-2" class="ct-span" data-id="span-646-2544">Notice is hereby given to the residents of The Community College District of Jefferson County, Missouri, that two (2) positions on the Board of Trustees will be vacant and will [&hellip;]</span></div><a id="link_text-609-2544-2" class="ct-link-text post-link" href="https://www.jeffco.edu/news/bot-vacancies/" target="_self" data-id="link_text-609-2544">Read the story<br></a></div></a></div><div class="oxy-repeater-pages-wrap"><div class="oxy-repeater-pages"> <span aria-current="page" class="page-numbers current">1</span> <a class="page-numbers" href="https://www.jeffco.edu/page/2/">2</a> <a class="page-numbers" href="https://www.jeffco.edu/page/3/">3</a> <span class="page-numbers dots">&hellip;</span> <a class="page-numbers" href="https://www.jeffco.edu/page/19/">19</a> <a class="next page-numbers" href="https://www.jeffco.edu/page/2/">Next &raquo;</a></div></div></div><div id="div_block-674-2544" class="ct-div-block" ><div id="div_block-675-2544" class="ct-div-block" ><div id="code_block-1473-2544" class="ct-code-block" ><div class="mz-events"><div class="eventNew"><div class="eventDate"> <span class="month">NOV</span> <span class="day">18</span></div><div class="eventDetail"><h3>Evan and Stacey (PACE Visiting Artist Exhibition)</h3><p class="eventTime">Wed · 7:00 am - 3:30 pm</p><p class="eventWhere">Fine Arts (FA) - FA Art Gallery</p><p class="eventDesc"></p></div></div><div class="eventNew"><div class="eventDate"> <span class="month">NOV</span> <span class="day">18</span></div><div class="eventDetail"><h3>CMU Tuition Scholarship Recipient Ceremony</h3><p class="eventTime">Wed · 11:30 am - 2:30 pm</p><p class="eventWhere">Student Center (SC) - 002A - Viking Room</p><p class="eventDesc"></p></div></div><div class="eventNew"><div class="eventDate"> <span class="month">NOV</span> <span class="day">18</span></div><div class="eventDetail"><h3>Baseball Practices</h3><p class="eventTime">Wed · 12:00 pm - 3:00 pm</p><p class="eventWhere">Field House (FH) - Baseball Field Area</p><p class="eventDesc"></p></div></div><div class="eventNew"><div class="eventDate"> <span class="month">NOV</span> <span class="day">18</span></div><div class="eventDetail"><h3>Softball Practices</h3><p class="eventTime">Wed · 2:30 pm - 5:00 pm</p><p class="eventWhere">Field House (FH) - Softball Field Area</p><p class="eventDesc"></p></div></div></div><style></style></div><div id="_dynamic_list-923-2544" class="oxy-dynamic-list"><div id="div_block-924-2544-1" class="ct-div-block" data-id="div_block-924-2544"><div id="code_block-963-2544-1" class="ct-code-block" data-id="code_block-963-2544"></div><div id="div_block-940-2544-1" class="ct-div-block event-post-text-right" data-id="div_block-940-2544"><h3 id="headline-1025-2544-1" class="ct-headline" data-id="headline-1025-2544"><span id="span-1033-2544-1" class="ct-span" data-id="span-1033-2544"><a href="https://www.jeffco.edu/news/president-announces-retirement/">President Dr. Dena McCaffrey Announces Retirement at the Close of the 2027-28 School Year</a></span></h3><div id="code_block-988-2544-1" class="ct-code-block" data-id="code_block-988-2544"></div><div id="code_block-984-2544-1" class="ct-code-block" data-id="code_block-984-2544"></div></div></div><div id="div_block-924-2544-2" class="ct-div-block" data-id="div_block-924-2544"><div id="code_block-963-2544-2" class="ct-code-block" data-id="code_block-963-2544"></div><div id="div_block-940-2544-2" class="ct-div-block event-post-text-right" data-id="div_block-940-2544"><h3 id="headline-1025-2544-2" class="ct-headline" data-id="headline-1025-2544"><span id="span-1033-2544-2" class="ct-span" data-id="span-1033-2544"><a href="https://www.jeffco.edu/news/bot-vacancies/">Notice of Vacancies on Board of Trustees</a></span></h3><div id="code_block-988-2544-2" class="ct-code-block" data-id="co