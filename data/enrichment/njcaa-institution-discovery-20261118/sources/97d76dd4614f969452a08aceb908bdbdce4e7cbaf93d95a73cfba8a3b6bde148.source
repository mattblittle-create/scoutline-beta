                <li>Baseball / Softball</li>
                <li>Basketball</li>
                <li>Soccer</li>
                <li>Track &amp; Cross Country</li>
                <li>Volleyball</li>
                <li>Wrestling</li>
                <li>Co-ed spirit squad</li>
        
            </ul>
        
        </div>
