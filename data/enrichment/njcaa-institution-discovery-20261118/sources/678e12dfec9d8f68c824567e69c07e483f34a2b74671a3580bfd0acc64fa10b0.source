<script>
  function initVimeoPlayer(){
   const iframe = document.getElementById('bg-video-frame');
    if (!iframe){
     console.log("Video iframe not found");
      return;
    }
    
    const player = new Vimeo.Player(iframe);
    
    player.ready().then(function(){
      let playCount = 0;
      const maxLoops = 2;

      player.on('ended', function() {
        playCount++;
        if(playCount < maxLoops){
          player.setCurrentTime(0).then(function(){
            player.play();
          });
        } else {
          player.setCurrentTime(0).then(function(){
         	player.pause();    
          });
        }
      }); 
    });
  }
</script>
<script src="https://player.vimeo.com/api/player.js" onload="initVimeoPlayer()"></script>
<script type="text/javascript">
  const counterSpeed = 200;
  const statCounters = document.querySelectorAll('.stat-value');
  
  const statcounterObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        if (!entry.target.classList.contains('seen')) {
          setTimeout(function(){
           entry.target.classList.add('seen');
            entry.target.parentElement.classList.add('seen');
            const animate = () => {
             const value = +entry.target.getAttribute('data-targetvalue');
             const data = +entry.target.innerText;
              
              const time = value / counterSpeed;
              if (data < value) {
               entry.target.innerText = Math.ceil(data + time);
                setTimeout(animate, 10);
              } else {
               entry.target.innerText = value; 
              }
            }
            animate();
          }, 500);
        }
      }
    })
  }, {
    threshold: 1
  });
  
  for (let i = 0; i < statCounters.length; i++){
   const elements = statCounters[i];
    statcounterObserver.observe(elements);
  }
</script>

