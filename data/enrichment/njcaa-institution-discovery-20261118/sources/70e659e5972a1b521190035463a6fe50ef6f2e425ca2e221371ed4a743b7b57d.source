<a class="kb-button kt-button button kb-btn84_f59bd5-b8 kt-btn-size-standard kt-btn-width-type-fixed wp-block-button__link button-style-secondary kb-btn-global-inherit kt-btn-has-text-true kt-btn-has-svg-false wp-block-kadence-singlebtn kb-preset--theme-secondary" href="https://www.morainevalley.edu/admissions/apply-now/"><span class="kt-btn-inner-text">Admissions</span></a>

<a class="kb-button kt-button button kb-btn84_700be7-83 kt-btn-size-standard kt-btn-width-type-fixed wp-block-button__link button-style-secondary kb-btn-global-inherit kt-btn-has-text-true kt-btn-has-svg-false wp-block-kadence-singlebtn kb-preset--theme-secondary" href="https://www.morainevalley.edu/tuition-and-fees/scholarships/"><span class="kt-btn-inner-text">Scholarships</span></a></div>
</div></div>

</div></div>


<p class="wp-block-paragraph"></p>
</div><!-- .entry-content -->
