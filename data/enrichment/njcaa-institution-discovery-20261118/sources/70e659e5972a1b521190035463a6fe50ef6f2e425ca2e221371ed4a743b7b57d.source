<meta name="msapplication-TileImage" content="https://www.morainevalley.edu/wp-content/uploads/cropped-MVCC-site-icon-270x270.png" />
<style id="wp-custom-css">
:root {
	--tec-color-link-accent: #013d76;
	--tec-color-button-primary: #013d76;
	--tec-color-accent-primary: #013d76;
}
.tribe-common .tribe-common-c-svgicon--messages-not-found .tribe-common-c-svgicon__svg-stroke {
	stroke: #ffffff;
}
.full-height-card:hover .kt-image-overlay-wrap.kt-over-image-zoomin .kt-block-intrisic > img,
.full-height-card:focus-within .kt-image-overlay-wrap.kt-over-image-zoomin .kt-block-intrisic > img {
    transform: scale(1.05);
}
.yoast-breadcrumbs a {
	color: #fff;
}

.breadcrumb_last {
	color: #fff;
}


/* DK Temp */
.kb-dynamic-list .kb-dynamic-list-item:nth-child(n+2) {
    display: none;
}
/* 1:1 image ratio for this Query Card */
.one-to-one-ratio .kb-is-ratio-image {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
}

.one-to-one-ratio .kb-is-ratio-image img.kb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.programs-table {
	border: 1px solid #A6D0C1;
	border-radius: 12px;
	overflow: hidden;
	box-sizing: border-box;
}

/* Let the container control the outside border */
.programs-table .kb-table tr:first-child > * {
	border-top: 0;
}

.programs-table .kb-table tr:last-child > * {
	border-bottom: 0;
}

.programs-table .kb-table tr > *:first-child {
	border-left: 0;
}

.programs-table .kb-table tr > *:last-child {
	border-right: 0;
}

/* fix for the arrow hovers on last two items */
.hover-white {
	color: #000;
}

.custom-hoverbox-homepage-cta:hover .kt-svg-icon-wrap,
.custom-hoverbox-homepage-cta:hover .kt-svg-icon-wrap svg {
    color: #fff !important;
    fill: #fff !important;
}
</style>
<style id="core-block-supports-inline-css">
.wp-elements-1 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-9);}
/*# sourceURL=core-block-supports-inline-css */
</style>

</head>

