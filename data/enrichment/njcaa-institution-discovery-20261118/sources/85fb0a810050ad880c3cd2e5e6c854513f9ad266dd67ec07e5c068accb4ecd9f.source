        <div class="layout-notification">
              <div class="callout" data-closable>
      <div class="region region-notification">
      <div id="block-emergencynotificationsviafetch" class="block-emergencynotificationsviafetch block block--emergency-notifications-via-fetch">
  
    
      <div class="block__content">
      


<style>
#block-emergencynotificationsviafetch {
  display: none;
}
</style>
<style>
.notification {
  background-color: inherit;
  color: inherit;
  padding: inherit;
}
.notification div div {
  background-color: #a6192e;
  color: #fff;
  padding: 0.35em 1em;
}
</style>
<style>
#emergency-notification-fetched .region-content {
  display: block;
  margin: 0;
}
</style>

<style>
@-webkit-keyframes alertPulse {
    0% {background-color: #9A2727; opacity: 1;}
    50% {opacity: red; opacity: 0.82; }
    100% {opacity: #9A2727; opacity: 1;}
}
.alertPulse-css {
  animation: alertPulse 1.1s ease-out;
  animation-iteration-count: 4;
  opacity: 1;
  background: gray;
}
</style>

<div class="rave">

        <div id="emergency-notification-fetched"></div>

           <script type='text/javascript'>
            /** Constants for PHSC-configuration **/

              /**
               * The id that matches what we set in the above twig 
               */
              const target_div_id = 'emergency-notification-fetched';
              
              /**
               * The endpoint (view with contextual filter argument).
               * Please include trailing slash!
               */
              const url_of_the_view_to_fetch = '//phsc.edu/emergency-notifications/subdomain';

              /**
               * We need to bust the varnish cache, so let's generate a random
               * set of chars, and use that in the GET request.
               */
              // Define the characters possible in the string
              const randomInt = Math.floor(Math.random() * 10000) + 1;
              const randomString = randomInt.toString();

              // Create a query param from the random string
              const bustVarnishQueryParam = '?bustvarnish=' + randomString;

            /** Variables for the fetch (don't change these, please) **/
              let urlToFetch = url_of_the_view_to_fetch + bustVarnishQueryParam;
              let subdomain = '';

              const targetDiv = document.getElementById( target_div_id );
              const parentDiv = document.getElementById('block-emergencynotificationsviafetch');
              //const classListOfParent = targetDiv.parentElement.classList;
              //const classArray = Array.from( classListOfParent );  // convert DOMTokenList to Array so I can search within it.
              //const subdomainClass = classArray.find( classString => classString.includes( 'subdomain--' ) );

              //subdomain = subdomainClass.replace( "subdomain--", "" );
              //urlToFetch = url_of_the_view_to_fetch + subdomain; // the endpoint (view with contextual filter argument: subdomain)

              const frag = document.createDocumentFragment();  // Fragments don't affect the DOM.  Use this to build the text (may not be needed for just text/markup.)

              const fetchConfig = {
                headers:
                {
                  cache: "no-store",
                  'cache-control': "no-cache",
                  pragma: "no-cache",
                }
              }

            /** The Fetch **/
              fetch( urlToFetch, fetchConfig )
                .then( response => response.text() )
                .then( (response) => {
                  let div = document.createElement('div');
                  div.innerHTML = response;
                  frag.appendChild(div);
                  targetDiv.appendChild(frag);
                  parentDiv.style.display = 'block';
                  parentDiv.classList.add('alertPulse-css');
                })
                .catch( function(error) {
                  console.log(error);
                });

           </script> 


</div>




      
