                </button>
                <button class="two-up-inset-carousel-arrow-next">
                    <img src="https://eac.edu/wp-content/themes/redirecttheme/dist/assets/images/carousel-right-arrow.svg" alt="">
                </button>
            </div>
            </section> 

            <section class="two-up-text-links" style="background-color: ">
