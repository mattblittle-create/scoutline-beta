<div id="eac-cookie-banner" class="eac-cookie-banner" hidden>
	<div class="eac-cookie-banner__inner">
		<p class="eac-cookie-banner__text">
			By clicking &ldquo;Accept all cookies&rdquo;, you agree to the storing of cookies on your device to enhance site navigation, analyze site usage, and assist in our marketing efforts.
		</p>
		<button type="button" class="eac-button purple-light" id="eac-cookie-accept">
			Accept all cookies
		</button>
	</div>
</div>

<style>
	.eac-cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 9999;
		background:#510C76;
		color: #fff;
		box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
	}
	.eac-cookie-banner__inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}
	.eac-cookie-banner__text {
		margin: 0 !important;
		font-size: 15px !important;
		line-height: 1.6 !important;
		flex: 1;
		color: #fff;
	}
	.eac-cookie-banner #eac-cookie-accept {
		flex-shrink: 0;
		margin-bottom: 0;
		white-space: nowrap;
	}
	@media screen and (max-width: 768px) {
		.eac-cookie-banner__inner {
			flex-direction: column;
			align-items: stretch;
			padding: 1rem;
			gap: 0.875rem;
		}
		.eac-cookie-banner__text {
			font-size: 14px !important;
		}
		.eac-cookie-banner #eac-cookie-accept {
			width: 100%;
		}
	}
</style>

<script>
	(function () {
		var STORAGE_KEY = 'eac_cookie_accepted';
		var banner = document.getElementById('eac-cookie-banner');
		var acceptBtn = document.getElementById('eac-cookie-accept');

		if (!banner || !acceptBtn) return;

		// Show banner only if user hasn't accepted yet
		try {
			if (localStorage.getItem(STORAGE_KEY) !== 'true') {
				banner.hidden = false;
			}
		} catch (e) {
			// localStorage unavailable (private browsing, etc.) — show banner anyway
			banner.hidden = false;
		}

		acceptBtn.addEventListener('click', function () {
			try {
				localStorage.setItem(STORAGE_KEY, 'true');
			} catch (e) {
				// fail silently — at least hide for this session
			}
			banner.hidden = true;
		});
	})();
</script>
