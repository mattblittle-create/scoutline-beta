	<!-- / Navigation - Google Tag Manager - Head Script #61 -->
  
  <!-- Navigation - Translate assets #260 -->
  <script>
document.addEventListener("DOMContentLoaded", function () {

    var host = window.location.hostname.toLowerCase();
    var pageURL = window.location.href;

    // T4 Preview: map preview URL to correct public site
    if (host.includes("terminalfour.net")) {

        if (
            document.title.toLowerCase().includes("pgcc online") ||
            document.body.innerHTML.toLowerCase().includes("pgcconline.com")
        ) {
            pageURL = "https://www.pgcconline.com/";
        }
        else if (
            document.title.toLowerCase().includes("performing arts") ||
            document.body.classList.contains("arts")
        ) {
            pageURL = "https://www.pgcc.edu/arts/";
        }
        else {
            pageURL = "https://www.pgcc.edu/";
        }
    }

    var isGoogleTranslated =
        host === "translate.googleusercontent.com" ||
        host.endsWith(".translate.goog");

    if (isGoogleTranslated) {
        return;
    }

    var dropdown = document.querySelector(".translate__dropdown");

    if (!dropdown) {
        return;
    }

    var encodedPageURL = encodeURIComponent(pageURL);

    var languages = [
        ["es", "Spanish"],
        ["fr", "French"],
        ["ko", "Korean"],
        ["vi", "Vietnamese"],
        ["ru", "Russian"],
        ["de", "German"],
        ["pl", "Polish"],
        ["ar", "Arabic"],
        ["zh-CN", "Chinese"],
        ["it", "Italian"],
        ["pt", "Portuguese"]
    ];

    dropdown.innerHTML = "";

    languages.forEach(function (language) {

        var li = document.createElement("li");
        var link = document.createElement("a");

        link.href =
            "https://translate.google.com/translate?hl=&sl=auto&tl=" +
            language[0] +
            "&u=" +
            encodedPageURL;

        link.textContent = language[1];

        li.appendChild(link);
        dropdown.appendChild(li);
    });

});
</script>

  <!-- / Navigation - Translate assets #260 -->
  
