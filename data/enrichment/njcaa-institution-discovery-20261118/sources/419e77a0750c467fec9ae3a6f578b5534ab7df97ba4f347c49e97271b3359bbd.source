    <script>
      function testCSS(property, value) {
        return window.CSS && window.CSS.supports && window.CSS.supports(property, value);
      }

      if (!testCSS('object-fit', 'cover')) {
        var vw = document.querySelectorAll('.video-wrapper video');
        if (vw.length) {
          vw[0].classList.add('no-of');
        }
      }

      // NEW: pause / play behaviour
      document.addEventListener('DOMContentLoaded', function () {
        var video = document.getElementById('heroHeroVideo');
        var toggle = document.querySelector('.hero-video-toggle');
        if (!video || !toggle) return;

        toggle.addEventListener('click', function () {
          var icon = toggle.querySelector('.hero-video-toggle-icon');

          if (video.paused) {
            video.play();
            toggle.setAttribute('aria-label', 'Pause background video');
            toggle.setAttribute('aria-pressed', 'false');
            if (icon) icon.textContent = '❚❚';
          } else {
            video.pause();
            toggle.setAttribute('aria-label', 'Play background video');
            toggle.setAttribute('aria-pressed', 'true');
            if (icon) icon.textContent = '▶';
          }
        });
      });
    </script>

