<!-- OmniAlert - Assets -->

<style>
  .OmniMessage {
    padding: 40px 14% 40px 5%;
    font-size: 18px;
  }

  .close {
    right: 32px;
    top: 32px;
    width: 17px;
    height: 17px;
  }

  .close:before,
  .close:after {
    position: absolute;
    left: 90%;
    content: ' ';
    height: 21px;
    width: 5px;
    background-color: #ffffff;
    margin-top: 75px;
  }

  .close:before {
    transform: rotate(45deg);
  }

  .close:after {
    transform: rotate(-45deg);
  }

  .closenotice {
    right: 32px;
    top: 32px;
    width: 17px;
    height: 17px;
  }

  .closenotice:before,
  .closenotice:after {
    position: absolute;
    left: 90%;
    content: ' ';
    height: 21px;
    width: 5px;
    background-color: #002C77;
    margin-top: 75px;
  }

  .closenotice:before {
    transform: rotate(45deg);
  }

  .closenotice:after {
    transform: rotate(-45deg);
  }

  .omninotice:hover {
    color: white !important;
  }
</style>

<script type="text/javascript" src="https://widgets.omnilert.net/c23174dea27afd7d8d19acd8fa907f50-12847" ></script>

<script type="text/javascript">
  $(document).ready(function () {
    // $(".SmartBoard_Table tr:first").hide();

    var OmniMessage = $(".SmartBoard_Table tr").eq(1).text();

    if (OmniMessage) {
      $(".SmartBoard_Table").hide();

      var OmniHTMLEmer =
        "<div class='OmniMessage'>" +
          "<h3 style='color:#002C77 !important;font-size:24px'>" + OmniMessage + "</h3>" +
          "<a href='https://publish.smartsheet.com/bd7f2654459b4eac9c0a124a9589ea74' class='omninotice'>LEARN MORE</a>" +
        "</div>";

      var OmniHTMLNote =
        "<a id='OmniAlertClose' href='#' class='closenotice'></a>" +
        "<div class='OmniMessage'>" +
          "<h3 style='color:#002C77;font-size:24px'>" + OmniMessage + "</h3>" +
          "<a href='https://publish.smartsheet.com/bd7f2654459b4eac9c0a124a9589ea74' class='omninotice'>LEARN MORE</a>" +
        "</div>";

      var OmniHTMLWar =
        "<a id='OmniAlertClose' href='#' class='close'></a>" +
        "<div class='OmniMessage'>" +
          "<h3 style='color:#002C77;font-size:24px'>" + OmniMessage + "</h3>" +
          "<a href='https://publish.smartsheet.com/bd7f2654459b4eac9c0a124a9589ea74' class='omninotice'>LEARN MORE</a>" +
        "</div>";

      var OmniSubject = $(".SmartBoard_Subject").text().toLowerCase();

      if (OmniSubject.includes("emergency")) {
        $(".emergencynotice").html(OmniHTMLEmer);
        $(".emergencynotice").css({ "background-color": "#FB7C1D" });
      } else if (OmniSubject.includes("notice")) {
        $(".emergencynotice").html(OmniHTMLNote);
        $(".emergencynotice").css({ "background-color": "#FFFFFF" });
      } else if (OmniSubject.includes("warning")) {
        $(".emergencynotice").html(OmniHTMLWar);
        $(".emergencynotice").css({ "background-color": "#54b4e4" });
      }
    }

    $(document).on("click", "#OmniAlertClose", function (e) {
      e.preventDefault();
      $(".emergencynotice").hide();
    });
  });
</script>


<!-- End OmniAlert - Assets -->

