<button type="button" id="report-bug-btn" class="report-bug-btn" aria-label="Report a bug on this page">
  Report a Bug
</button>

<style>
:root {
  /* Easy-tweak knobs — change these, not the JS below.
     Defaults to the site's --red-primary/--white so it matches the refresh
     palette out of the box, but the values are hardcoded here (not var()-linked
     to _refresh/style.css) so this button keeps working even if that stylesheet
     isn't loaded on a given page. */
  --report-bug-bg: #c60f13;
  --report-bug-bg-hover: #9e0c0f;
  --report-bug-text: #ffffff;
  --report-bug-font-size: 0.9rem;
  --report-bug-padding: 0.85rem 0.6rem;
  --report-bug-radius: 6px;
  --report-bug-top: 60%;
  --report-bug-z: 999;
}

.report-bug-btn {
  position: fixed;
  top: var(--report-bug-top);
  right: 0;
  transform: translateY(-50%);
  z-index: var(--report-bug-z);
  background-color: var(--report-bug-bg);
  color: var(--report-bug-text);
  font-size: var(--report-bug-font-size);
  font-family: inherit;
  line-height: 1.2;
  padding: var(--report-bug-padding);
  border: none;
  /* Rounded only on the side facing into the page, so it reads as a tab
     clipped to the edge rather than a floating pill. */
  border-radius: var(--report-bug-radius) 0 0 var(--report-bug-radius);
  cursor: pointer;
  box-shadow: -2px 2px 6px rgba(0, 0, 0, 0.25);
  writing-mode: vertical-rl;
  text-orientation: mixed;
  letter-spacing: 0.02em;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.report-bug-btn:hover {
  background-color: var(--report-bug-bg-hover);
  /* Slide out slightly toward the content on hover — the "peek tray" cue. */
  transform: translateY(-50%) translateX(-4px);
}

.report-bug-btn:focus-visible {
  outline: 3px solid #ffbf47;
  outline-offset: 2px;
  transform: translateY(-50%) translateX(-4px);
}

/* Phones: anchor from the bottom, just above the right-edge stack (chat FAB 56px
   + 12px gap + back-to-top 44px, both in _refresh/style.css / bottom-scripts.vm),
   instead of a % from the top. A % collides with that stack on short screens
   (iPhone SE, 667px tall). Same --chat-fab-bottom fallback chain as .to-top, so
   the tab tracks the stack if the FAB moves. */
@media (max-width: 39.9375em) {
  .report-bug-btn {
    top: auto;
    bottom: calc(var(--chat-fab-bottom, calc(var(--sticky-cta-height, 5rem) + 1rem)) + 56px + 12px + 44px + 16px);
    transform: none;
    font-size: 0.8rem;
    padding: 0.7rem 0.5rem;
  }
  .report-bug-btn:hover,
  .report-bug-btn:focus-visible {
    transform: translateX(-4px);
  }
}
</style>

<script>
(function () {
  "use strict";

  // Base form URL only — no query string here. buildFeedbackUrl() below appends
  // the real page_url/user_agent/screen_size/viewport params via URLSearchParams.
  // Fillout's dashboard shows an example URL with "?page_url=xxxxx&..." placeholders
  // tacked on for reference — don't paste that part; it collides with the params
  // we add below and causes duplicate query keys.
  var FORM_URL = "https://forms.fillout.com/t/r71t8wwmQmus";

  var POPUP_NAME = "reportBugPopup";
  var POPUP_FEATURES = "width=500,height=700,resizable=yes,scrollbars=yes,status=no,toolbar=no,menubar=no,location=no";

  function buildFeedbackUrl() {
    var params = new URLSearchParams();
    params.set("page_url", window.location.href);
    params.set("user_agent", navigator.userAgent);
    params.set("screen_size", screen.width + "x" + screen.height);
    params.set("viewport", window.innerWidth + "x" + window.innerHeight);
    return FORM_URL + "?" + params.toString();
  }

  function openFeedbackForm() {
    var url = buildFeedbackUrl();
    var popup = null;

    try {
      popup = window.open(url, POPUP_NAME, POPUP_FEATURES);
    } catch (e) {
      popup = null;
    }

    if (!popup) {
      window.open(url, "_blank");
      return;
    }

    popup.focus();
  }

  function init() {
    var btn = document.getElementById("report-bug-btn");
    if (!btn) {
      return;
    }
    btn.addEventListener("click", openFeedbackForm);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>


		
   <!-- Google Translate Integration with improved reliability -->
	<script>
		// @ts-nocheck
		var googleTranslateRetryCount = 0;
		var googleTranslateMaxRetries = 3;
		var googleTranslateInitialized = false;

		function googleTranslateElementInit() {
			if (googleTranslateInitialized) return;

			var element = document.getElementById("google_translate_element");
			if (!element) {
				console.warn("Google Translate: Element not found");
				return;
			}

			try {
				new google.translate.TranslateElement(
					{ pageLanguage: "en", includedLanguages: "en,es,pl", autoDisplay: false },
					"google_translate_element",
				);

				googleTranslateInitialized = true;

				// Mark as loaded once widget appears
				function checkLoaded() {
					var translateElements = document.querySelectorAll("#google_translate_element");
					translateElements.forEach(function (el) {
						if (
							el &&
							(el.querySelector(".goog-te-combo") || el.querySelector(".goog-te-gadget"))
						) {
							el.classList.add("loaded");
						}
					});
				}

				// Check at multiple intervals to handle varying load times
				[50, 150, 300, 500, 1000].forEach(function (delay) {
					setTimeout(checkLoaded, delay);
				});
			} catch (e) {
				console.warn("Google Translate initialization error:", e);
			}
		}

		// Load Google Translate script with error handling and retry logic
		function loadGoogleTranslateScript() {
			if (googleTranslateInitialized) return;

			var existingScript = document.getElementById("google-translate-script");
			if (existingScript) {
				existingScript.remove(); // Remove failed script to allow retry
			}

			var script = document.createElement("script");
			script.id = "google-translate-script";
			script.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
			script.async = true;

			script.onerror = function () {
				console.warn(
					"Google Translate script failed to load (attempt " +
						(googleTranslateRetryCount + 1) +
						")",
				);
				if (googleTranslateRetryCount < googleTranslateMaxRetries) {
					googleTranslateRetryCount++;
					// Exponential backoff: 1s, 2s, 4s
					setTimeout(loadGoogleTranslateScript, Math.pow(2, googleTranslateRetryCount) * 1000);
				}
			};

			document.head.appendChild(script);
		}

		// Start loading when DOM is ready
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", loadGoogleTranslateScript);
		} else {
			loadGoogleTranslateScript();
		}
	</script>
	<script>
		// @ts-nocheck
		$(".translation-links a").click(function () {
			var lang = $(this).data("lang");
			var $frame = $(".goog-te-menu-frame:first");
			if (!$frame.size()) {
				alert("Error: Could not find Google translate frame.");
				return false;
			}
			$frame
				.contents()
				.find(".goog-te-menu2-item span.text:contains(" + lang + ")")
				.get(0)
				.click();
			return false;
		});
	</script>
	<script>
		// @ts-nocheck
		jQuery(document).ready(function () {
