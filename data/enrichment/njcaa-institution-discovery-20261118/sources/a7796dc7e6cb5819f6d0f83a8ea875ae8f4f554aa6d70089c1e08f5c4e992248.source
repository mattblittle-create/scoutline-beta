	<style>
	/* Mainstay/AdmitHub webchat widget restyle: FAB instead of pill button.
	   Must stay inline (not in _refresh/style.css) because the widget's shadow-root
	   style-piercing scanner only reads document.querySelectorAll("style") in the light DOM -
	   it never reads <link rel="stylesheet"> files. See wip/css-triage-log.md for details. */
	/* --chat-fab-bottom is set on <html> by _refresh/script.js (alignChatFabToHeroCta)
	   on single-slide home heroes, to bottom-align this FAB with the hero's Apply Now
	   button. It has to travel as a custom property rather than a descendant selector:
	   this rule is copied INTO the widget's shadow root, where there is no <body>
	   ancestor to match on - but inherited custom properties do cross the boundary. */
	.activation-button {
	  position: fixed !important;
	  bottom: var(--chat-fab-bottom, calc(var(--sticky-cta-height, 5rem) + 1rem)) !important;
	  right: 1rem !important;
	}
	.activation-button .button-text {
	  display: inline-block !important;
	  max-width: 0 !important;
	  opacity: 0 !important;
	  overflow: hidden !important;
	  white-space: nowrap !important;
	}
	.activation-button .popup-button {
	  width: 56px !important;
	  height: 56px !important;
	  min-width: 56px !important;
	  padding: 0 !important;
	  gap: 0 !important;
	  border-radius: 50% !important;
	  justify-content: center !important;
	  overflow: hidden !important;
	}
	/* Desktop only: on hover, slide out into the full pill with label.
	   Touch devices never match (hover: hover), so mobile just stays the collapsed circle. */
	@media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
	  .activation-button .popup-button {
	    transition: width 0.25s ease, border-radius 0.25s ease, padding 0.25s ease, gap 0.25s ease;
	  }
	  .activation-button .button-text {
	    transition: opacity 0.2s ease, max-width 0.25s ease;
	  }
	  .activation-button:hover .popup-button {
	    width: 220px !important;
	    border-radius: 28px !important;
	    padding: 0 1.25rem !important;
	    gap: 0.5rem !important;
	    justify-content: flex-start !important;
	  }
	  .activation-button:hover .button-text {
	    max-width: 200px !important;
	    opacity: 1 !important;
	  }
	}
	</style>
