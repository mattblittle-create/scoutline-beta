<link rel='stylesheet' id='block-acf-dccc-latest-news-block-css' href='https://www.dccc.edu/wp-content/themes/wp-dccc/css/blocks/dccc-latest-news-block.css?ver=6.8.11' media='all' />
<style id="dccc-acfdccc-latest-news-block-style-inline-css">
@media (min-width:1024px){.dccc-page-template-with-left-right-sidebar .block-dccc-latest-news .latest-news-wrapper .news-container{grid-template-columns:repeat(2,1fr)}}.block-dccc-latest-news{line-height:150%}.block-dccc-latest-news.style_1{background:#fff}.block-dccc-latest-news.style_1 .news-container__item{background:#f3f5f6}.block-dccc-latest-news.style_2{background:#f3f5f6}.block-dccc-latest-news.style_2 .news-container__item{background:#fff}.block-dccc-latest-news .latest-news-wrapper .news-container{display:grid;grid-template-columns:repeat(1,1fr);gap:10px;margin:24px 0}@media (min-width:640px){.block-dccc-latest-news .latest-news-wrapper .news-container{gap:20px;margin:48px 0;grid-template-columns:repeat(2,1fr)}}@media (min-width:1024px){.block-dccc-latest-news .latest-news-wrapper .news-container{grid-template-columns:repeat(3,1fr)}}.block-dccc-latest-news .latest-news-wrapper .news-container__item{display:flex;flex-direction:column;padding:12px;overflow:hidden;position:relative;justify-content:space-between;row-gap:8px;border-radius:2px;border:1px solid #e7e8ec}.block-dccc-latest-news .latest-news-wrapper .news-container__item:first-child{background:#003e72}.block-dccc-latest-news .latest-news-wrapper .news-container__item:first-child .info__item{color:#fff}.block-dccc-latest-news .latest-news-wrapper .news-container__item:first-child .permalink:not([data-userway-s6-styled=true]) .permalink__title{color:#fff}.block-dccc-latest-news .latest-news-wrapper .news-container__item:first-child .info__item::before{filter:brightness(0) saturate(100%) invert(1) sepia(1) hue-rotate(0) saturate(100%) brightness(1.5)}@media (min-width:640px){.block-dccc-latest-news .latest-news-wrapper .news-container__item{padding:24px;row-gap:16px}}.block-dccc-latest-news .latest-news-wrapper .news-container__item .permalink{display:flex;flex-direction:column;row-gap:12px}.block-dccc-latest-news .latest-news-wrapper .news-container__item .permalink__img{height:280px}.block-dccc-latest-news .latest-news-wrapper .news-container__item .permalink__img img{width:100%;height:100%;object-fit:cover;object-position:center;margin:0;border-radius:2px}.block-dccc-latest-news .latest-news-wrapper .news-container__item .permalink__title{overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3}.block-dccc-latest-news .latest-news-wrapper .news-container__item .permalink:not([data-userway-s6-styled=true]) .permalink__title{color:initial}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info{display:inline-flex;width:100%;white-space:nowrap}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item{display:inline-flex;align-items:center;font-weight:400;font-size:14px;line-height:150%}@media (min-width:640px){.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item{font-size:18px;line-height:28px}}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item img,.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item p{margin:0}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item.date{margin-right:8px}@media (min-width:640px){.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item.date{margin-right:16px}}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item.date::before{content:"";background-image:url(/wp-content/themes/wp-dccc/img/publish_time.svg);width:20px;height:20px;background-position:center;background-repeat:no-repeat;background-size:contain;margin-right:8px}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item.category{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex-grow:1}.block-dccc-latest-news .latest-news-wrapper .news-container__item .info__item.category::before{content:"";display:inline-block;background-image:url(/wp-content/themes/wp-dccc/img/category.svg);width:20px;height:20px;background-position:center;background-repeat:no-repeat;background-size:contain;margin-right:8px;margin-bottom:-3px}.block-dccc-latest-news .latest-news-wrapper .all-news{display:flex;align-items:center;justify-content:center}.block-dccc-latest-news .latest-news-wrapper .all-news .dccc-button::after{content:"";width:24px;height:24px;background-image:url(/wp-content/themes/wp-dccc/img/goto.svg);background-position:center}.block-dccc-latest-news .latest-news-wrapper .all-news .dccc-button[data-userway-s6-styled=true]::after{background-color:#fff}
