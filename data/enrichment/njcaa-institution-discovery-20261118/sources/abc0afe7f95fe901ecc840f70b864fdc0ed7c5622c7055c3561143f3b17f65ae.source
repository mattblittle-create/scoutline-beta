nter}.block-dccc-latest-posts .latest-posts-wrapper .all-posts .dccc-button[data-userway-s6-styled=true]::after{background-color:#fff}@media (max-width:639px){.block-dccc-latest-posts .latest-posts-wrapper .latest-posts-container__item{flex-direction:column;align-items:stretch;row-gap:12px;padding:12px}.block-dccc-latest-posts .latest-posts-wrapper .latest-posts-container__item .post-permalink{flex-direction:column;align-items:stretch;row-gap:8px}.block-dccc-latest-posts .latest-posts-wrapper .latest-posts-container__item .post-permalink__img{width:100%;height:180px}}
