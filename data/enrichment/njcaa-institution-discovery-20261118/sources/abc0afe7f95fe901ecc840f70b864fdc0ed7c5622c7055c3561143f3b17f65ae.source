.block-dccc-blue-banner{position:relative;color:#fff;background-color:#003e72;background-position:center;background-repeat:no-repeat;background-size:cover;overflow:hidden}.block-dccc-blue-banner.media-bg::before{content:"";position:absolute;top:0;left:0;width:100%;height:100%;background-color:rgba(0,62,114,.7);z-index:1}.block-dccc-blue-banner.gray-bg{background-color:#f3f5f6;color:#0f1844}.block-dccc-blue-banner.gray-bg .container h2,.block-dccc-blue-banner.gray-bg .container p{color:#0f1844}.block-dccc-blue-banner video{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);min-width:100%;min-height:100%;object-fit:cover}.block-dccc-blue-banner .container{position:relative;padding-top:20px;padding-bottom:20px;display:flex;align-items:center;justify-content:center;flex-direction:column;row-gap:16px;max-width:700px;z-index:5}@media (min-width:768px){.block-dccc-blue-banner .container{padding-top:40px;padding-bottom:40px}}.block-dccc-blue-banner .container h2,.block-dccc-blue-banner .container p{margin:0;padding:0}.block-dccc-blue-banner .container h2{text-align:center}.block-dccc-blue-banner .container p{font-weight:600;text-align:center}.block-dccc-blue-banner .container .dccc-button{margin-top:16px}.block-dccc-blue-banner .container .dccc-button::after{display:block;content:"";background-image:url(/wp-content/themes/wp-dccc/img/icons/icon-banner-go-to-link.svg);width:16px;height:16px}
