:focus{outline:1.5px solid #696969!important}.dccc-category-interaction-panel-block .container .grid{margin-left:0;margin-right:0}.dccc-category-interaction-panel-block .title_h2{word-spacing:normal;letter-spacing:normal}.dccc-category-interaction-panel-block__list{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;margin-top:24px;padding:0}@media (min-width:768px){.dccc-category-interaction-panel-block__list{margin-top:48px}}@media (max-width:992px){.dccc-category-interaction-panel-block__list{grid-template-columns:repeat(2,1fr);gap:20px}}@media (max-width:767px){.dccc-category-interaction-panel-block__list{grid-template-columns:repeat(1,1fr)}}.dccc-category-interaction-panel-block-item{display:flex;flex-flow:column nowrap;max-width:100%;width:100%;height:375px;position:relative;border-radius:2px;overflow:hidden}.dccc-category-interaction-panel-block-item:before{content:"";position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(0deg,rgba(15,24,68,.7),rgba(15,24,68,.7));transition:opacity .3s ease-in-out}.dccc-category-interaction-panel-block-item__image{max-width:100%;width:100%;max-height:100%;height:100%;margin-bottom:0;object-fit:cover;object-position:center}.dccc-category-interaction-panel-block-item__description{font-family:Figtree,sans-serif;font-style:normal;font-weight:700;font-size:24px;line-height:36px;color:#fff;position:absolute;right:0;bottom:0;left:0;padding:24px;background:0 0;transition:background .3s ease-in-out}@media (max-width:767px){.dccc-category-interaction-panel-block-item__description{padding:12px}}.dccc-category-interaction-panel-block-item:active:before,.dccc-category-interaction-panel-block-item:focus:before,.dccc-category-interaction-panel-block-item:hover:before{opacity:0}.dccc-category-interaction-panel-block-item:active .dccc-category-interaction-panel-block-item__description,.dccc-category-interaction-panel-block-item:focus .dccc-category-interaction-panel-block-item__description,.dccc-category-interaction-panel-block-item:hover .dccc-category-interaction-panel-block-item__description{background:#0f1844}
