<style id="wp-custom-css">
*:focus {
  /* outline: 2px solid #003E72!important;
  box-shadow: 0 0 10px rgba(250, 202, 35, 0.3); */
	outline: 2px solid #000000!important;
}

.slick-list {
	padding: 2px!important;
}

.slick-slide {
	margin-right: 5px;
}


.dccc-image-with-navigation-links-block-item__link:hover {
	color: #4b5273;
}


.dccc-contact-us-block__form .wpcf7-not-valid-tip {
	color: red!important;
}

.gfield_select {
	  padding: 8px !important;
	  line-height: 150% !important;
}


.gform_wrapper .gfield {
  margin-bottom: 20px;
}

.gform_wrapper .gfield .gform-field-label {
  font-family: 'Figtree', sans-serif !important;
  font-weight: 600 !important;
  font-size: 18px !important;
  line-height: 27px !important;
  color: #0F1844 !important;
  margin-bottom: 8px !important;
  display: block !important;
}

.gform_wrapper .gfield .gform-field-label--type-inline {
  display: inline-block !important;
  margin-left: 8px !important;
}

.gform_wrapper .gfield .gform-field-label--type-sub {
  font-size: 16px !important;
  line-height: 24px !important;
  margin-bottom: 4px !important;
}

.gform_wrapper .name_first,
.gform_wrapper .name_last,
.gform_wrapper .name_middle,
.gform_wrapper .name_prefix,
.gform_wrapper .name_suffix {
  position: relative !important;
  margin-bottom: 16px !important;
}

.gform_wrapper .name_first input,
.gform_wrapper .name_last input,
.gform_wrapper .name_middle input,
.gform_wrapper .name_prefix input,
.gform_wrapper .name_suffix input {
  width: 100% !important;
}

.gform_wrapper .gform-grid-col {
  margin-bottom: 16px !important;
}

.gform_wrapper .gform-grid-col--size-auto {
  flex: 1 !important;
}

.gform_wrapper .ginput_container input[type="text"],
.gform_wrapper .ginput_container input[type="email"],
.gform_wrapper .ginput_container input[type="tel"],
.gform_wrapper .ginput_container input[type="url"],
.gform_wrapper .ginput_container input[type="password"],
.gform_wrapper .ginput_container input[type="search"],
.gform_wrapper .ginput_container input[type="number"],
.gform_wrapper .ginput_container input[type="date"],
.gform_wrapper .ginput_container textarea {
  border: 1px solid #A5A5A5 !important;
  background: #FFFFFF !important;
  border-radius: 2px !important;
  //padding: 12px !important;
  width: 100% !important;
  font-family: 'Figtree', sans-serif !important;
}

.gform_wrapper .ginput_container input[type="text"]::placeholder,
.gform_wrapper .ginput_container input[type="email"]::placeholder,
.gform_wrapper .ginput_container input[type="tel"]::placeholder,
.gform_wrapper .ginput_container input[type="url"]::placeholder,
.gform_wrapper .ginput_container input[type="password"]::placeholder,
.gform_wrapper .ginput_container input[type="search"]::placeholder,
.gform_wrapper .ginput_container input[type="number"]::placeholder,
.gform_wrapper .ginput_container input[type="date"]::placeholder,
.gform_wrapper .ginput_container select::placeholder,
.gform_wrapper .ginput_container textarea::placeholder {
  font-family: 'Figtree', sans-serif !important;
  font-weight: 500 !important;
  font-size: 18px !important;
  line-height: 27px !important;
  color: #4B5273 !important;
}

.gform_wrapper .ginput_container input[type="text"]:focus,
.gform_wrapper .ginput_container input[type="email"]:focus,
.gform_wrapper .ginput_container input[type="tel"]:focus,
.gform_wrapper .ginput_container input[type="url"]:focus,
.gform_wrapper .ginput_container input[type="password"]:focus,
.gform_wrapper .ginput_container input[type="search"]:focus,
.gform_wrapper .ginput_container input[type="number"]:focus,
.gform_wrapper .ginput_container input[type="date"]:focus,
.gform_wrapper .ginput_container select:focus,
.gform_wrapper .ginput_container textarea:focus {
  outline: none !important;
  border-color: #0F1844 !important;
}

.gform_wrapper .ginput_container textarea {
  width: 466px !important;
  height: 51px !important;
  resize: vertical !important;
  min-height: 51px !important;
}

.gform_wrapper .gfield--type-radio .gfield_radio {
  margin: 0 !important;
  padding: 0 !important;
}

.gform_wrapper .gfield--type-radio .gfield_radio .gchoice {
  margin-bottom: 12px;
  display: flex !important;
  align-items: center !important;
}

.gform_wrapper .gfield--type-radio .gfield_radio .gchoice input[type="radio"] {
  margin: 0 !important;
  appearance: none !important;
  width: 20px !important;
  height: 20px !important;
  border: 2px solid #A5A5A5 !important;
  border-radius: 50% !important;
  position: relative !important;
}

.gform_wrapper .gfield--type-radio .gfield_radio .gchoice input[type="radio"]:checked {
  border-color: #0F1844 !important;
}

.gform_wrapper .gfield--type-radio .gfield_radio .gchoice input[type="radio"]:checked:after {
  content: '';
  position: absolute !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  width: 10px !important;
  height: 10px !important;
  background: #0F1844 !important;
  border-radius: 50% !important;
}

.gform_wrapper .gfield--type-radio .gfield_radio .gchoice label {
  margin-left: 8px !important;
  cursor: pointer !important;
}

.gform_wrapper .ginput_container_consent,
.gform_wrapper .gfield--type-checkbox {
  display: flex;
  align-items: flex-start !important;
}

.gform_wrapper .ginput_container_consent input[type="checkbox"],
.gform_wrapper .gfield--type-checkbox input[type="checkbox"] {
  appearance: none !important;
  width: 20px !important;
  height: 20px !important;
  border: 2px solid #A5A5A5 !important;
  border-radius: 2px !important;
  margin: 0 !important;
  //position: relative !important;
  flex-shrink: 0 !important;
}

.gform_wrapper .ginput_container_consent input[type="checkbox"]:checked,
.gform_wrapper .gfield--type-checkbox input[type="checkbox"]:checked {
  border-color: #0F1844 !important;
  //background: #0F1844 !important;
}

.gform_wrapper .ginput_container_consent input[type="checkbox"]:checked:after,
.gform_wrapper .gfield--type-checkbox input[type="checkbox"]:checked:after {
  content: '';
  position: absolute;
  top: 2px !important;
  left: 6px !important;
  width: 5px !important;
  height: 10px !important;
  border: solid #FFFFFF !important;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg) !important;
}

.gform_wrapper .ginput_container_consent label,
.gform_wrapper .gfield--type-checkbox label {
  margin-left: 8px;
  cursor: pointer;
}

.ginput_container {
	min-width: 100% !important;
}
.gform_wrapper .gform_footer {
  margin-top: 24px;
}

.gform_wrapper .gform_footer .gform_button,
.gform_wrapper .gform_footer input[type="submit"] {
  font-family: 'Figtree', sans-serif !important;
  font-weight: 600 !important;
  font-size: 18px !important;
  line-height: 26px !important;
  color: #0F1844 !important;
  background: #FACA23 !important;
  padding: 10px 20px !important;
  border: none;
  border-radius: 2px;
  cursor: pointer !important;
  display: inline-block !important;
  width: auto !important;
  transition: background-color 0.3s ease !important;
}

.gform_wrapper .gform_footer .gform_button:hover,
.gform_wrapper .gform_footer input[type="submit"]:hover {
  background: #e1b51f !important;
}

.gform_wrapper .gform_footer .gform_button:focus,
.gform_wrapper .gform_footer input[type="submit"]:focus {
  outline: none !important;
  box-shadow: 0 0 0 2px rgba(250, 202, 35, 0.5) !important;
}

.gform_wrapper .gfield_error input,
.gform_wrapper .gfield_error select,
.gform_wrapper .gfield_error textarea {
  border-color: #FF4D4F !important;
}

.gform_wrapper .gfield_error .validation_message {
  color: #FF4D4F !important;
  font-size: 14px !important;
  margin-top: 4px !important;
}

.gform_wrapper .gfield_required { 
  color: #FF4D4F !important;
  margin-left: 4px !important;
}

.gform_wrapper .ginput_complex {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 16px !important;
}

.gform_wrapper .ginput_complex > span {
  flex: 1 !important;
  min-width: 250px !important;
}

@media screen and (max-width: 768px) {
  .gform_wrapper .ginput_container textarea {
    width: 100% !important;
  }
  
  .gform_wrapper .ginput_complex > span {
    min-width: 100% !important;
  }
}
.gform_title {
	display: none !important;
}
.gfield_required_text {
	font-size: 0 !important;
}
.gfield_required_text:before {
		content: '*' !important;
    font-size: 25px;
    margin-left: -4px;
    height: 6px;
    display: inline-block;
    margin-top: -10px;
}

.otgs-development-site-front-end {
	display: none;
}

.gfield-choice-input:before {
	color: #0F1844 !important;
}
</style>
<link rel='stylesheet' id='block-acf-dccc-hero-block-css' href='https://www.dccc.edu/wp-content/themes/wp-dccc/css/blocks/dccc-hero-block.css?ver=6.8.11' media='all' />
<style id="dccc-acfdccc-hero-block-style-inline-css">
.dccc-hero-block{padding-top:0!important;padding-bottom:0!important;position:relative;overflow:hidden;background-repeat:no-repeat;background-position:center;background-size:cover;color:#f3f5f6}.dccc-hero-block .container{padding:0 30px!important}.dccc-hero-block.has-video-background{background-image:none!important}.dccc-hero-block.has-image-background .hero-overlay,.dccc-hero-block.has-video-background .hero-overlay{position:absolute;top:0;left:0;width:100vw;height:100%;background-color:#003e72;z-index:1;left:50%;transform:translateX(-50%)}.dccc-hero-block .hero-background-video{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;overflow:hidden}.dccc-hero-block .hero-background-video::before{content:"";position:absolute;top:0;left:0;width:100%;height:100%;background-color:rgba(0,62,114,.7);z-index:1}.dccc-hero-block .hero-background-video video{position:absolute;top:50%;left:50%;min-width:100%;min-height:100%;width:auto;height:auto;transform:translateX(-50%) translateY(-50%);object-fit:cover}.dccc-hero-block .container{position:relative;z-index:2}.dccc-hero-block .grid{display:flex}.dccc-hero-block .hero-content{padding-top:calc(2rem + 9vw);padding-bottom:calc(2rem + 9vw)}@media (min-width:1200px){.dccc-hero-block .hero-content{padding-top:8.75rem}}@media (min-width:1200px){.dccc-hero-block .hero-content{padding-bottom:8.75rem}}.dccc-hero-block .hero-content__align-left .hero-content-inner{align-items:flex-start}.dccc-hero-block .hero-content__align-middle .hero-content-inner{align-items:center}.dccc-hero-block .hero-content__align-right .hero-content-inner{align-items:flex-end}.dccc-hero-block .hero-content-inner{display:flex;flex-direction:column;width:100%}.dccc-hero-block .hero-content__align-left .hero-title{text-align:left}.dccc-hero-block .hero-content__align-middle .hero-title{text-align:center}.dccc-hero-block .hero-content__align-right .hero-title{text-align:right}.dccc-hero-block .hero-title{width:100%;font-weight:800;margin-bottom:0;font-size:calc(1.5rem + 3vw);line-height:calc(1.6875rem + 5.25vw)}@media (min-width:1200px){.dccc-hero-block .hero-title{font-size:3.75rem}}@media (min-width:1200px){.dccc-hero-block .hero-title{line-height:5.625rem}}.dccc-hero-block .hero-text{margin-top:16px;font-style:normal;font-weight:500;line-height:28px;max-width:750px;max-height:112px;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;font-size:1.125rem}.hero-content__align-left .dccc-hero-block .hero-text{text-align:left;margin-left:0;margin-right:auto}.hero-content__align-middle .dccc-hero-block .hero-text{text-align:center;margin-left:auto;margin-right:auto}.hero-content__align-right .dccc-hero-block .hero-text{text-align:right;margin-left:auto;margin-right:0}.dccc-hero-block .button-list{display:flex;flex-direction:row;flex-wrap:nowrap;justify-content:flex-start;align-content:stretch;width:100%;margin-top:30px}.dccc-hero-block .button-list .dccc-button{margin-right:1.25rem}.dccc-hero-block .button-list .dccc-button:last-child{margin-right:0}.dccc-hero-block .button-list.button-list__align-left{justify-content:flex-start}.dccc-hero-block .button-list.button-list__align-left .dccc-button{margin-right:1.25rem}.dccc-hero-block .button-list.button-list__align-left .dccc-button:last-child{margin-right:0}.dccc-hero-block .button-list.button-list__align-middle{justify-content:center}.dccc-hero-block .button-list.button-list__align-middle .dccc-button:first-child{margin-left:0}.dccc-hero-block .button-list.button-list__align-middle .dccc-button:last-child{margin-right:0}.dccc-hero-block .button-list.button-list__align-right{justify-content:flex-end}.dccc-hero-block .button-list.button-list__align-right .dccc-button{margin-left:1.25rem;margin-right:0}.dccc-hero-block .button-list.button-list__align-right .dccc-button:first-child{margin-left:0}.dccc-hero-block .hero-image{display:flex;align-items:center;overflow:hidden;padding:0;margin:0;position:relative}.dccc-hero-block .hero-image.col-sm-6{width:calc(50% + 15px)}.dccc-hero-block .hero-image.col-sm-6:first-child{margin-left:-15px}.dccc-hero-block .hero-image.col-sm-6:last-child{margin-right:-15px;right:-15px}.dccc-hero-block .hero-image img{display:block;height:100%;min-width:100%;width:auto;margin:0;object-position:center;max-height:570px}.dccc-hero-block.dccc-hero-block--white .hero-text,.dccc-hero-block.dccc-hero-block--white .hero-title{color:#0f1844}.dccc-hero-block.dccc-hero-block--blue{background-color:#003e72;color:#fff}.dccc-hero-block.dccc-hero-block--light{background-color:#f3f5f6;color:#0f1844}@media (max-width:767px){.dccc-hero-block .hero-image{margin-top:0!important}.dccc-hero-block .hero-image.col-sm-6{width:100%;margin:0 -15px}.dccc-hero-block .container{padding:0 15px!important}.dccc-hero-block .hero-content{padding:30px}.dccc-hero-block .hero-text{max-height:none;-webkit-line-clamp:none}.dccc-hero-block .hero-content-inner{align-items:center!important}.dccc-hero-block .hero-text,.dccc-hero-block .hero-title{text-align:center!important}.dccc-hero-block .button-list{justify-content:center!important}}
