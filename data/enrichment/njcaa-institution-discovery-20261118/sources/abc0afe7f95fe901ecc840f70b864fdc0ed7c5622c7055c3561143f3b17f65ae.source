<link rel='stylesheet' id='block-acf-dccc-accordion-block-css' href='https://www.dccc.edu/wp-content/themes/wp-dccc/css/blocks/dccc-accordion-block.css?ver=6.8.11' media='all' />
<style id="dccc-acfdccc-accordion-block-style-inline-css">
.dccc-accordion-block.style_1{background-color:#fff}.dccc-accordion-block.style_1 .dccc-accordion-block__item{background:#f3f5f6}.dccc-accordion-block.style_1 .dccc-accordion-block-item__content{background:#f3f5f6}.dccc-accordion-block.style_2{background-color:#f3f5f6}.dccc-accordion-block.style_2 .dccc-accordion-block__item{background:#fff}.dccc-accordion-block.style_2 .dccc-accordion-block-item__content{background:#fff}.dccc-accordion-block .container [class*=col-]{padding:0}.dccc-accordion-block__title{margin-bottom:24px}@media (min-width:768px){.dccc-accordion-block__title{margin-bottom:48px}}.dccc-accordion-block--two-col .dccc-accordion-block__list[class*=col-]{display:grid;grid-template-columns:repeat(2,1fr);gap:4px 20px;grid-auto-rows:-webkit-min-content;grid-auto-rows:min-content;align-items:start}@media (max-width:767px){.dccc-accordion-block--two-col .dccc-accordion-block__list[class*=col-]{grid-template-columns:repeat(1,1fr)}}.dccc-accordion-block .active .acc-item-title{padding:31px 76px 16px 32px}.dccc-accordion-block .dccc-accordion-block-item{background:#f3f5f6;max-width:100%;width:100%;border:1px solid #e7e8ec;border-radius:2px;margin-bottom:20px}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item{border-radius:0}}.dccc-accordion-block .dccc-accordion-block-item__title.active .acc-item-title::after{transform:rotate(0)}.dccc-accordion-block .dccc-accordion-block-item__title--static .acc-item-title{cursor:default;padding-right:32px}.dccc-accordion-block .dccc-accordion-block-item__title--static .acc-item-title::after{display:none}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item__title--static .acc-item-title{padding-right:15px}}.dccc-accordion-block .dccc-accordion-block-item .acc-item-title{max-width:100%;width:100%;box-sizing:border-box;display:flex;flex-direction:row;justify-content:space-between;align-items:flex-start;padding:31px 76px 31px 32px;color:#0f1844;position:relative;margin:0;border:0;background:0 0;text-align:left;white-space:normal;overflow-wrap:anywhere;cursor:pointer;-webkit-appearance:none;appearance:none;font-weight:700}.dccc-accordion-block .dccc-accordion-block-item .acc-item-title__text{flex:1 1 auto;min-width:0}@media (max-width:768px){.dccc-accordion-block .dccc-accordion-block-item .acc-item-title{font-size:16px;line-height:24px}}@media (min-width:768px) and (max-width:1140px){.dccc-accordion-block .dccc-accordion-block-item .acc-item-title{font-size:18px;line-height:27px}}@media (min-width:1140px) and (max-width:1920px){.dccc-accordion-block .dccc-accordion-block-item .acc-item-title{font-size:20px;line-height:30px}}@media (min-width:1920px){.dccc-accordion-block .dccc-accordion-block-item .acc-item-title{font-size:24px;line-height:36px}}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item .acc-item-title{padding:15px 45px 15px 15px}}.dccc-accordion-block .dccc-accordion-block-item .acc-item-title:after{content:"";position:absolute;top:32px;right:32px;width:24px;height:30px;background:url(/wp-content/themes/wp-dccc/css/blocks/../../img/icons/icon-accordion-arrow.svg) center/contain no-repeat;transform:rotate(180deg);transition:all .3s ease-in-out}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item .acc-item-title:after{top:15px;right:15px}}.dccc-accordion-block .dccc-accordion-block-item .acc-item-title.active{border-bottom:0}.dccc-accordion-block .dccc-accordion-block-item .acc-item-title.active:after{transform:rotate(0)}.dccc-accordion-block .dccc-accordion-block-item .acc-item-title:focus,.dccc-accordion-block .dccc-accordion-block-item .acc-item-title:focus-visible{outline:0!important;box-shadow:none!important}.dccc-accordion-block .dccc-accordion-block-item__content{padding:0 76px 31px 32px;background:#f3f5f6;font-style:normal;font-weight:500;font-size:18px;line-height:26px;color:#0f1844;display:flex;flex-direction:column;gap:20px;box-sizing:border-box;display:none}.dccc-accordion-block .dccc-accordion-block-item__content:focus,.dccc-accordion-block .dccc-accordion-block-item__content:focus-visible{outline:0!important;box-shadow:none!important}.dccc-accordion-block .dccc-accordion-block-item__content>*{width:100%}.dccc-accordion-block .dccc-accordion-block-item__content p{margin-bottom:16px}.dccc-accordion-block .dccc-accordion-block-item__content p:last-child{margin-bottom:0}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item__content{padding:0 15px 15px}}.dccc-accordion-block .dccc-accordion-block-item__buttons{display:flex;flex-direction:row;flex-wrap:wrap;gap:16px}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item__buttons{flex-direction:column}}.dccc-accordion-block .dccc-accordion-block-item__buttons:last-child{margin-bottom:0}.dccc-accordion-block .dccc-accordion-block-item__button{display:inline-flex;align-items:center;justify-content:center;max-width:-webkit-fit-content;max-width:fit-content;min-width:150px;padding:10px 16px;border:1px solid #faca23;background:#faca23;border-radius:2px;font-family:Figtree,sans-serif;font-style:normal;font-weight:600;font-size:18px;line-height:26px;color:#0f1844;text-decoration:none;transition:all .3s linear;gap:8px}.dccc-accordion-block .dccc-accordion-block-item__button:hover{opacity:.9}.dccc-accordion-block .dccc-accordion-block-item__button--blue{border:1px solid #003e72;background:#003e72;color:#fff}.dccc-accordion-block .dccc-accordion-block-item__button--white{border:1px solid #fff;background:#fff;color:#0f1844}.dccc-accordion-block .dccc-accordion-block-item__button .button-icon{display:flex;align-items:center;justify-content:center}.dccc-accordion-block .dccc-accordion-block-item__button .button-icon img{width:20px;height:20px;object-fit:contain}.dccc-accordion-block .dccc-accordion-block-item__button .button-icon--left{margin-right:4px}.dccc-accordion-block .dccc-accordion-block-item__button .button-icon--right{margin-left:4px}.dccc-accordion-block .dccc-accordion-block-item__button .button-text{text-align:center}.dccc-accordion-block .dccc-accordion-block-item__image:last-child:last-child{margin-bottom:0}.dccc-accordion-block .dccc-accordion-block-item__image:last-child img{max-width:100%;width:100%;height:300px;object-fit:cover;object-position:center}.dccc-accordion-block .dccc-accordion-block-item__image__table-wrapper{width:100%;background:#f3f5f6;padding:0;overflow-x:auto;-webkit-overflow-scrolling:touch}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item__image__table-wrapper{padding:15px;margin:0 -15px;width:calc(100% + 30px)}}.dccc-accordion-block .dccc-accordion-block-item__image__table-wrapper::-webkit-scrollbar{height:6px}.dccc-accordion-block .dccc-accordion-block-item__image__table-wrapper::-webkit-scrollbar-track{background:#e7e8ec;border-radius:3px}.dccc-accordion-block .dccc-accordion-block-item__image__table-wrapper::-webkit-scrollbar-thumb{background:#003e72;border-radius:3px}.dccc-accordion-block .dccc-accordion-block-item__image__table-wrapper:last-child{margin-bottom:0}.dccc-accordion-block .dccc-accordion-block-item__image__table{min-width:600px;width:100%;border-collapse:collapse;background:#fff}.dccc-accordion-block .dccc-accordion-block-item__image__table td,.dccc-accordion-block .dccc-accordion-block-item__image__table th{min-width:80px}.dccc-accordion-block .dccc-accordion-block-item__image__table th{border:1px solid #e7e8ec;text-align:left}.dccc-accordion-block .dccc-accordion-block-item__image__table td{border:1px solid #e7e8ec}.dccc-accordion-block .dccc-accordion-block-item__image__table thead{background:#003e72}.dccc-accordion-block .dccc-accordion-block-item__image__table thead th{font-family:Figtree,"Roboto Condensed",sans-serif;font-style:normal;font-weight:700;font-size:18px;line-height:28px;color:#faca23;padding:16px 24px;white-space:nowrap}.dccc-accordion-block .dccc-accordion-block-item__image__table tbody td,.dccc-accordion-block .dccc-accordion-block-item__image__table tbody th{color:#0f1844;font-weight:400;padding:16px 24px;background:#f3f5f6}.dccc-accordion-block .dccc-accordion-block-item__image__table tbody tr:nth-child(odd) td,.dccc-accordion-block .dccc-accordion-block-item__image__table tbody tr:nth-child(odd) th{background:#fff}@media (max-width:767px){.dccc-accordion-block .dccc-accordion-block-item__image__table tbody td,.dccc-accordion-block .dccc-accordion-block-item__image__table tbody th{padding:12px 16px;font-size:14px}}.dccc-accordion-block.is-keyboard-nav .dccc-accordion-block-item .acc-item-title:focus,.dccc-accordion-block.is-keyboard-nav .dccc-accordion-block-item .acc-item-title:focus-visible{outline:3px solid #faca23!important;outline-offset:-3px;border-radius:2px}.dccc-accordion-block.is-keyboard-nav .dccc-accordion-block-item .dccc-accordion-block-item__content:focus,.dccc-accordion-block.is-keyboard-nav .dccc-accordion-block-item .dccc-accordion-block-item__content:focus-visible{outline:2px solid #faca23!important;outline-offset:-2px;box-shadow:inset 0 0 0 1px #003e72;border-radius:2px}.dccc-accordion-block:not(.is-keyboard-nav) .dccc-accordion-block-item .acc-item-title:focus,.dccc-accordion-block:not(.is-keyboard-nav) .dccc-accordion-block-item .acc-item-title:focus-visible{outline:0!important;box-shadow:none!important}.dccc-accordion-block:not(.is-keyboard-nav) .dccc-accordion-block-item .dccc-accordion-block-item__content:focus,.dccc-accordion-block:not(.is-keyboard-nav) .dccc-accordion-block-item .dccc-accordion-block-item__content:focus-visible{outline:0!important;box-shadow:none!important}
/*# sourceURL=https://www.dccc.edu/wp-content/themes/wp-dccc/css/blocks/dccc-accordion-block.css */
</style>
<style id="dccc-acfdccc-fixed-flame-style-inline-css">
.dccc-fixed-flame{position:fixed;top:0;right:0;width:40%;height:100vh;z-index:-1;pointer-events:none}.dccc-fixed-flame .flame-container{width:100%;height:100%;position:relative;display:flex;justify-content:flex-end;align-items:center;padding-right:40px}.dccc-fixed-flame svg{width:auto;height:80%}.dccc-fixed-flame svg path{transition:fill .3s ease}.dccc-fixed-flame--left{left:0;right:auto}.dccc-fixed-flame--left .flame-container{justify-content:flex-start;padding-right:0;padding-left:40px}@media (max-width:768px){.dccc-fixed-flame{display:none}}.dccc-fixed-flame svg path{transition:fill .3s ease,opacity .3s ease;will-change:fill,opacity}
/*# sourceURL=https://www.dccc.edu/wp-content/themes/wp-dccc/css/blocks/dccc-parallax-effect.css */
</style>

</head>

