<style id="dccc-blue-banner-carousel-style-inline-css">
.dccc-blue-banner-carousel {
	width: 100%;
}

.dccc-blue-banner-carousel__slides {
	position: relative;
	width: 100%;
	touch-action: pan-y;
}

.dccc-blue-banner-carousel__slides > .block-dccc-blue-banner[hidden] {
	display: none;
}

.dccc-blue-banner-carousel__navigation {
	display: flex;
	min-height: 48px;
	align-items: center;
	justify-content: center;
	gap: 10px;
	padding: 8px 16px;
	background: #faca23;
}

.dccc-blue-banner-carousel__dot {
	display: inline-flex;
	width: 20px;
	height: 20px;
	align-items: center;
	justify-content: center;
	padding: 0;
	border: 2px solid #0f1844;
	border-radius: 50%;
	background: transparent;
	cursor: pointer;
}

.dccc-blue-banner-carousel__dot span {
	display: block;
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: #0f1844;
}

.dccc-blue-banner-carousel__dot.is-active {
	background: #0f1844;
}

.dccc-blue-banner-carousel__dot.is-active span {
	background: #faca23;
}

.dccc-blue-banner-carousel__dot:focus-visible {
	outline: 3px solid #fff;
	outline-offset: 3px;
	box-shadow: 0 0 0 5px #0f1844;
}

/*# sourceURL=https://www.dccc.edu/wp-content/themes/wp-dccc/blocks/dccc-blue-banner-carousel/blocks/build/blue-banner-carousel/style.css */
</style>

