            <!-- ko if: url != "" -->
            <a class="c-nav__url c-nav__url--level-1" data-bind="text: title, attr: { href: url, target: open_in_new_window ? '_blank' : '' }"></a>
            <!-- /ko -->
            <!-- /ko -->
            <ul class="c-nav__level-2" data-bind="foreach: items">
                <li class="c-nav__item c-nav__item--level-2" data-bind="css: { 'c-nav__separator': separator }">
                    <!-- ko if: separator -->
                    <span data-bind="text: title"></span>
                    <!-- /ko -->
                    <!-- ko ifnot: separator -->
                    <a class="c-nav__url c-nav__url--level-2" data-bind="text: title, attr: { href: url, target: open_in_new_window ? '_blank' : '' }"></a>
                    <!-- /ko -->
                </li>
            </ul>
        </li>
        <!-- /ko -->

        <!-- ko if: items === null || items.length === 0 -->
        <li class="c-nav__item c-nav__item--level-1" data-bind="css: class_name">
            <!-- ko if: url === "" -->
            <a class="c-nav__url c-nav__url--level-1" data-bind="html: title"></a>
            <!-- /ko -->
            <!-- ko if: url != "" -->
            <a class="c-nav__url c-nav__url--level-1" data-bind="html: title, attr: { href: url }"></a>
            <!-- /ko -->
            <!-- ko if: class_name === "sport-home" -->
            <div class="c-nav__ad">
            </div>
            <!-- /ko -->
        </li>
        <!-- /ko -->
    </ul>
    <ul class="w-nav__social" data-bind="foreach: data">
        <!-- ko if: items === null -->
        <!-- ko if: $parent.sport.facebook -->
        <li class="c-nav__social">
            <a class="c-nav__url c-nav__url--level-1" data-bind="attr: { href: $parent.sport.facebook }, css: class_name">
                <i class="icon-facebook_v2"></i>
                <span class="accessible-hide">Facebook</span>
            </a>
        </li>
        <!-- /ko -->
        <!-- ko if: $parent.sport.twitter -->
        <li class="c-nav__social">
            <a class="c-nav__url c-nav__url--level-1" data-bind="attr: { href: 'https://twitter.com/' + $parent.sport.twitter }, css: class_name">
                <i class="icon-twitter"></i>
                <span class="accessible-hide">Twitter</span>
            </a>
        </li>
        <!-- /ko -->
        <!-- ko if: $parent.sport.instagram -->
        <li class="c-nav__social">
            <a class="c-nav__url c-nav__url--level-1" data-bind="attr: { href: 'https://instagram.com/' + $parent.sport.instagram }, css: class_name">
                <i class="icon-instagram"></i>
                <span class="accessible-hide">Instagram</span>
            </a>
        </li>
        <!-- /ko -->
        <!-- /ko -->


    </ul>
</div>
<!-- /ko -->

<!-- ko if: name() === 'nav-sport-mobile' -->
<div class="c-nav__sport-menu--mobile flex flex-align-center" data-bind="css: { 'open': isMenuOpen }">
    <div class="c-nav__sport-menu--sport-home flex flex-align-center">
        <!-- ko switch -->
        <!-- ko case: ko.observable().matchMedia("(min-width: 821px)") -->
        <a data-bind="text: sport.title, attr: { href: '/index.aspx?path=' + sport.shortname }"></a>
        <!-- /ko -->

        <!-- ko case: $else -->
        <a data-bind="text: sport.abbreviation, attr: { href: '/index.aspx?path=' + sport.shortname }"></a>
        <!-- /ko -->
        <!-- /ko -->
    </div>
    <ul class="c-nav__sport-menu--top-level">
        <!-- ko foreach: data -->
        <!-- ko if: $index() >= 1 && $index() < 3 && ko.observable().matchMedia("(min-width: 821px)") -->
        <li>
            <a data-bind="attr: {href: url}, text: title"></a>
        </li>
        <!-- /ko -->
        <!-- /ko -->
        <li class="more flex">
            <a href="javascript:void(0);" class="sidearm-sport-more-links" data-bind="click: toggleMenu">More Links +</a>
        </li>
    </ul>
    <div class="c-nav__sport-menu--flyout-menu" data-bind="css: { 'opened': isMenuOpen }">
        <ul class="c-nav__flyout-menu-level-1" data-bind="foreach: data">
            <!-- ko if: $index() >= 3 && ko.observable().matchMedia("(min-width: 821px)") -->
            <!-- ko if: class_name != "sport-home" -->
            <li class="c-nav__item c-nav__item--level-1" data-bind="css: class_name">
                <!-- ko if: url === "" || url === "#" -->
                <a class="c-nav__url c-nav__url--level-1" data-bind="css: { 'opened': isItemOpen }, text: title,  enter: toggleMenuItem, click: toggleMenuItem" tabindex="-1"></a>
                <!-- ko if: items && items.length > 0 -->
                <i class="icn icon-down-dir"></i>
                <!-- /ko -->
                <ul class="c-nav__flyout-menu-level-2" data-bind="css: { 'opened': isItemOpen }, foreach: items">
                    <li class="c-nav__item c-nav__item--level-2" data-bind="css: { 'c-nav__separator': separator }">
                        <!-- ko ifnot: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title, attr: { href: url , target: open_in_new_window ? '_blank' : '' }, click: function() { return true; }, clickBubble: false" tabindex="-1"></a>
                        <!-- /ko -->
                        <!-- ko if: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title" tabindex="-1"></a>
                        <!-- /ko -->
                    </li>
                </ul>
                <!-- /ko -->
                <!-- ko if: url != "" && url != "#" -->
                <a class="c-nav__url c-nav__url--level-1" data-bind="text: title, attr: { href: url },click: function() { return true; }, clickBubble: false" tabindex="-1"></a>
                <!-- ko if: items && items.length > 0 -->
                <i class="icn icon-down-dir"></i>
                <!-- /ko -->
                <ul class="c-nav__flyout-menu-level-2" data-bind="css: { 'opened': isItemOpen }, foreach: items">
                    <li class="c-nav__item c-nav__item--level-2" data-bind="css: { 'c-nav__separator': separator }">
                        <!-- ko ifnot: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title, attr: { href: url , target: open_in_new_window ? '_blank' : '' }, click: function() { return true; }, clickBubble: false" tabindex="-1"></a>
                        <!-- /ko -->
                        <!-- ko if: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title" tabindex="-1"></a>
                        <!-- /ko -->
                    </li>
                </ul>
                <!-- /ko -->
            </li>
            <!-- /ko -->
            <!-- /ko -->
            <!-- ko if: ko.observable().matchMedia("(max-width: 820px)") -->
            <!-- ko if: class_name != "sport-home" -->
            <li class="c-nav__item c-nav__item--level-1" data-bind="css: class_name">
                <!-- ko if: url === "" || url === "#" -->
                <a class="c-nav__url c-nav__url--level-1" data-bind="css: { 'opened': isItemOpen }, text: title,  enter: toggleMenuItem, click: toggleMenuItem" tabindex="-1"></a>
                <!-- ko if: items && items.length > 0 -->
                <i class="icn icon-down-dir"></i>
                <!-- /ko -->
                <ul class="c-nav__flyout-menu-level-2" data-bind="css: { 'opened': isItemOpen }, foreach: items">
                    <li class="c-nav__item c-nav__item--level-2" data-bind="css: { 'c-nav__separator': separator }">
                        <!-- ko ifnot: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title, attr: { href: url , target: open_in_new_window ? '_blank' : '' }, click: function() { return true; }, clickBubble: false" tabindex="-1"></a>
                        <!-- /ko -->
                        <!-- ko if: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title" tabindex="-1"></a>
                        <!-- /ko -->
                    </li>
                </ul>
                <!-- /ko -->
                <!-- ko if: url != "" && url != "#" -->
                <a class="c-nav__url c-nav__url--level-1" data-bind="text: title, attr: { href: url },click: function() { return true; }, clickBubble: false" tabindex="-1"></a>
                <!-- ko if: items && items.length > 0 -->
                <i class="icn icon-down-dir"></i>
                <!-- /ko -->
                <ul class="c-nav__flyout-menu-level-2" data-bind="css: { 'opened': isItemOpen }, foreach: items">
                    <li class="c-nav__item c-nav__item--level-2" data-bind="css: { 'c-nav__separator': separator }">
                        <!-- ko ifnot: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title, attr: { href: url , target: open_in_new_window ? '_blank' : '' }, click: function() { return true; }, clickBubble: false" tabindex="-1"></a>
                        <!-- /ko -->
                        <!-- ko if: separator -->
                        <a class="c-nav__url c-nav__url--level-2" data-bind="text: title" tabindex="-1"></a>
                        <!-- /ko -->
                    </li>
                </ul>
                <!-- /ko -->
            </li>
            <!-- /ko -->
            <!-- /ko -->
        </ul>
    </div>
</div>
<!-- /ko --></script><script type='text/html' id='template-stories'><!-- ko if: name() === 'stories-component-cover' -->
<div class="w-stories--cover">
    <div class="component c-stories c-stories--cover" data-bind="afterBind: {foreach:data, callback:slick}" data-slick-options="{autoplay:true, autoplaySpeed:8000, fade: true, appendArrows: '.c-stories--cover__arrows'}">
        <div class="c-stories__item">
            <div class="w-stories__media-as-bg">
                <!-- ko switch-->
                    <!-- ko case: ko.observable().matchMedia("(min-width: 1280px)") -->
                    <div class="c-stories__media-as-bg" data-bind="showcasePlayer:showcase, appendButton:true, style: { backgroundImage: 'url(' + image_source + ')' }"></div>
                    <!-- /ko -->
                    <!-- ko case: $else -->
                    <div class="c-stories__media" data-bind="showcasePlayer: showcase, appendButton:true">
                        <picture class="c-stories__picture" data-bind="html5Picture: { 'images': [
                            { 'breakpoint': 768, 'image': image_source + '?width=1128&height=635&mode=crop&scale=both&format=jpg&quality=80' },
                            { 'breakpoint': 540, 'image': image_source + '?width=768&height=432&mode=crop&scale=both&format=jpg&quality=80' },
                            { 'breakpoint': 0, 'image': image_source + '?width=540&height=304&mode=crop&scale=both&format=jpg&quality=80' }
                        ]}, alt: image_alt_text"></picture>
                    </div>
                    <!-- /ko -->
                <!-- /ko -->
            </div>

            <div class="w-stories__title">
                <div class="c-stories__title">
                    <a class="c-stories__url" data-bind="text: title, attr: {href:url}"></a>
                </div>
            </div>
            <div class="w-stories__count">
                <div class="c-stories__count">
                    <div class="c-stories__count--current">
                        <!-- ko if: $index() < 9 -->
                        <span>0</span>
                        <!-- /ko -->
                        <span data-bind="text: $index() + 1"></span>
                    </div>
                    <div class="c-stories__count--amoung">
                        <!-- ko if: $parent.data().length < 10 -->
                        <span>0</span>
                        <!-- /ko -->
                        <span data-bind="text: $parent.data().length"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="c-stories--cover__arrows"></div>
</div>
<!-- /ko -->
</script><script type='text/html' id='template-events'><!-- ko if: data().length -->
<div class="w-events">
    <div class="w-events--list">
        <div class="c-events c-events--list" data-bind="afterBind: {foreach:data, callback:slick}" data-slick-options="{slidesToShow:3, slidesToScroll:3, autoplay:true, autoplaySpeed:5000, arrows: false, responsive:[
            {
                breakpoint:1340,
                settings: {slidesToShow:4, slidesToScroll:4, arrows: true}
            },
            {
                breakpoint:1124,
                settings: {slidesToShow:3, slidesToScroll:3, arrows: true}
            },
            {
                breakpoint:864,
                settings: {slidesToShow:2, slidesToScroll:2, arrows: true}
            },
            {
                breakpoint:606,
                settings: {slidesToShow:1, slidesToScroll:1, arrows: true}
            }
        ]}">
            <div class="c-events__item" data-bind="css: {'open': selected()}">

                <div class="c-events__item--inner">
                    <div class="c-events__item--info">
                        <div class="c-events__sport-date">
                            <!-- ko if: ko.observable().matchMedia("(min-width: 1340px)") -->
                            <span class="c-events__sport" data-bind="text: sport.title"></span>
                            <!-- /ko -->
                            <!-- ko if: ko.observable().matchMedia("(max-width: 1339px)") -->
                            <span class="c-events__sport" data-bind="text: sport.abbreviation"></span>
                            <!-- /ko -->
                            <span class="c-events__sport-date__separator">/</span>
                            <span class="c-events__date" data-bind="formatDate:date, format:'MMM DD'"></span>
                        </div>

                        <div class="c-events__time">
                            <span data-bind="text: time"></span>
                        </div>

                        <div class="c-events__logos">
                            <div class="c-events__logos-awayteam">
                                <!-- ko if: locationIndicator === 'A' -->
                                <div class="logo">
                                    <img src="/images/assets/csn-coyote-event-logo.png" alt="College of Southern Nevada" />
                                </div>
                                <!-- /ko -->
                                <!-- ko if: locationIndicator != 'A' -->
                                <!-- ko if: opponent.image === null || opponent.image === "" -->
                                <img class="no-logo" src="/images/assets/no-opponent-event-logo.png" data-bind="attr: { alt: opponent.title }" />
                                <!-- /ko -->
                                <!-- ko if: opponent.image != null && opponent.image != "" -->
                                <img data-bind="attr: { src: opponent.image + '?width=100&height=100', alt: opponent.title }" />
                                <!-- /ko -->
                                <!-- /ko -->
                            </div>

                            <div class="c-events__location-indicator__upper" data-bind="css: { 'vs': locationIndicator != 'A', 'at': locationIndicator === 'A' }">
                                <span data-bind="text: atVs"></span>
                            </div>
                            <div class="c-events__logos-hometeam">
                                <!-- ko if: locationIndicator === 'H' || locationIndicator === 'N' -->
                                <div class="logo">
                                    <img src="/images/assets/csn-coyote-event-logo.png" alt="College of Southern Nevada" />
                                </div>
                                <!-- /ko -->
                                <!-- ko if: locationIndicator != 'H' && locationIndicator != 'N' -->
                                <!-- ko if: opponent.image === null || opponent.image === "" -->
                                <img class="no-logo" src="/images/assets/no-opponent-event-logo.png" data-bind="attr: { alt: opponent.title }" />
                                <!-- /ko -->
                                <!-- ko if: opponent.image != null && opponent.image != "" -->
                                <img data-bind="attr: { src: opponent.image + '?width=100&height=100', alt: opponent.title }" />
                                <!-- /ko -->
                                <!-- /ko -->
                            </div>
                        </div>

                        <div class="c-events__overlay" data-bind="
                event: {
                    keyup: function(data, event) {
                        if(event.key == 'Escape') {
                            closeGame();
                            var toggleButton = $(event.target).closest('.c-events__item').find('.c-events__toggle');
                              if (toggleButton.length) {
                                  toggleButton.focus();
                              }
                        }
                    }
                }
                ">
                            <div class="c-events__overlay--inner">
                                <div class="c-events__opponent">
                                    <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span>
                                </div>
                                <div class="c-events__location">
                                    <span data-bind="text: location"></span>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="c-events--cards-boxy__ctas">
                        <ul class="c-events__media-links c-events__media-links--icons">
                            <!-- ko if: type === 'upcoming' -->
                            <!-- ko if: media.audio -->
                            <li>
                                <a data-bind="attr: { 'aria-label':'Audio for ' + sport.title + ' ' + atVs() + ' ' + opponent.title + ' on ' + moment(date).format('MMMM D, YYYY') + ' at ' + time, href: media.audio }">
                                    <i class="icon-radio"></i>
                                    <span>Audio</span>
                                </a>
                            </li>
                            <!-- /ko -->
                            <!-- ko if: media.video -->
                            <li>
                                <a data-bind="attr: { 'aria-label':'Video for ' + sport.title + ' ' + atVs() + ' ' + opponent.title + ' on ' + moment(date).format('MMMM D, YYYY') + ' at ' + time, href: media.video }">
                                    <i class="icon-video"></i>
                                    <span>Video</span>
                                </a>
                            </li>
                            <!-- /ko -->
                            <!-- ko if: media.stats -->
                            <li>
                                <a data-bind="attr: { 'aria-label':'Stats for ' + sport.title + ' ' + atVs() + ' ' + opponent.title + ' on ' + moment(date).format('MMMM D, YYYY') + ' at ' + time, href: media.stats }">
                                    <i class="icon-stats"></i>
                                    <span>Stats</span>
                                </a>
                            </li>
                            <!-- /ko -->
                            <!-- /ko -->
                        </ul>
                        <button class="c-events__toggle" type="button" data-bind="click: toggleGame,
                attr: {
                    'aria-expanded': selected() ? 'true' : 'false'
                },
                event: {
                    keyup: function(data, event) {
                        if(event.key == 'Enter') {
                            toggleGame()
                        }
                        if(event.key == 'Escape') {
                            closeGame();
                        }
                    }
                }
                ">
                            <i class="icon-plus"></i>
                            <span>Toggle Event Card</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="w-events__header">
        <h2 class="s-events__header--text">
            <span>Next</span>
            <span>Events</span>
        </h2>
        <div class="s-events__header--link">
            <a href="/calendar.aspx"><span>Composite Calendar</span><i class="icon-right-dir"></i></a>
        </div>
        <div class="s-events__controls">
            <button type="button" data-role="none" class="slick-prev" aria-label="previous">Previous</button>
            <button type="button" data-role="none" class="slick-next" aria-label="next">Next</button>
        </div>
    </div>
</div>
<!-- /ko -->
<!-- ko ifnot: data().length -->
<div class="w-events">
    <div class="w-events--list w-events__no-data">
        <div class="c-events c-events--list-1 c-events__no-data">
            <div class="c-events__no-upcoming text-center">No Upcoming Events</div>
        </div>
    </div>
    <div class="w-events__header">
        <h2 class="s-events__header--text">
            <span>Next</span>
            <span>Events</span>
        </h2>
        <div class="s-events__header--link">
            <a href="/calendar.aspx"><span>Composite Calendar</span><i class="icon-right-dir"></i></a>
        </div>
        <div class="s-events__controls"></div>
    </div>
</div>
<!-- /ko --></script><script type='text/html' id='template-content-stream'><div class="c-contentstream__container">
    <div data-bind="afterBind: { foreach: data, callback: packery }">

        <!-- ko if: type === 'tweet' -->
        <div class="c-contentstream__item c-contentstream__twitter" data-bind="with: data">
            <article class="c-contentstream__item--inner" data-bind="attr: { 'aria-label': 'Tweet ' + ($index() + 1) }">

                <div class="c-contentstream__twitter__body" data-bind="html:text"></div>

                <ul class="c-contentstream__twitter--actions">
                    <li class="c-contentstream__twitter--actions-reply c-contentstream__twitter--actions-item">
                        <a class="c-contentstream__twitter--actions-link" target="_blank" data-bind="attr: { 'aria-label': 'Tweet ' + ($index() + 1) + ': Reply to this tweet', href: 'https://twitter.com/intent/tweet?in_reply_to=' + id }">
                            <i class="icon-twitter-reply c-contentstream__twitter--icon"></i>
                            <span class="c-contentstream__twitter--icon-reply c-contentstream__twitter--icon-text">Reply to this tweet</span>
                        </a>
                    </li>
                    <li class="c-contentstream__twitter--actions-retweet c-contentstream__twitter--actions-item">
                        <a class="c-contentstream__twitter--actions-link" target="_blank" data-bind="attr: { 'aria-label': 'Tweet ' + ($index() + 1) + ': Retweet this tweet', href: 'https://twitter.com/intent/retweet?tweet_id=' + id }">
                            <i class="icon-twitter-retweet c-contentstream__twitter--icon"></i>
                            <span class="c-contentstream__twitter--icon-retweet c-contentstream__twitter--icon-text">Retweet this tweet</span>
                        </a>
                    </li>
                    <li class="c-contentstream__twitter--actions-favorite c-contentstream__twitter--actions-item">
                        <a class="c-contentstream__twitter--actions-link" target="_blank" data-bind="attr: { 'aria-label': 'Tweet ' + ($index() + 1) + ': Favorite this tweet', href: 'https://twitter.com/intent/favorite?tweet_id=' + id }">
                            <i class="icon-twitter-favorite c-contentstream__twitter--icon"></i>
                            <span class="c-contentstream__twitter--icon-favorite c-contentstream__twitter--icon-text">Favorite this tweet</span>
                        </a>
                    </li>
                </ul>

                <!-- ko if: media -->
                <button class="c-contentstream__social__media--tigger c-contentstream__twitter__media--tigger__opener" type="button">
        <i class="icon-picture"></i><span>Show Photo</span>
    </button>
                <div class="c-contentstream__twitter__overlay">
                    <div class="c-contentstream__twitter__media">
                        <img data-bind="attr: { src: media, alt: 'Tweet Photo from ' + user.name }" />
                    </div>
                    <button class="c-contentstream__social__media--tigger c-contentstream__twitter__media--tigger__close" type="button">
            <i class="icon-cancel"></i><span>Close Photo</span>
        </button>
                </div>
                <!-- /ko -->

                <div class="c-contentstream__twitter__header">
                    <div class="c-contentstream__twitter__brand--icon">
                        <i class="icon-twitter"></i>
                    </div>
                    <a class="c-contentstream__twitter__user-screenname" target="_blank" data-bind="text:'@' + user.screen_name, attr: {href: 'https://twitter.com/' + user.screen_name}"></a>
                </div>
            </article>
        </div>
        <!-- /ko -->

        <!-- ko if: type === 'instagram' -->
        <div class="c-contentstream__item c-contentstream__instagram" data-bind="with: data">
            <div class="c-contentstream__item-inner">
                <a class="c-contentstream__instagram-item__link" target="_blank" data-bind="attr: {href:link}">
                    <!-- ko if: caption -->
                    <img class="c-contentstream__instagram__image" data-bind="attr: { src: images.standard_resolution.url, alt: caption.text }" />
                    <!-- /ko -->

                    <!-- ko ifnot: caption -->
                    <img class="c-contentstream__instagram__image" data-bind="attr: { src: images.standard_resolution.url, alt: 'No Instagram caption available' }" />
                    <!-- /ko -->
                    <div class="c-contentstream__instagram--overlay">
                        <!-- ko if: likes -->
                        <!-- ko if: likes.count > 0 -->
                        <div class="c-contentstream__instagram--likes">
                            <i class="icon-heart"></i>
                            <span data-bind="text: likes.count"></span>
                        </div>
                        <!-- /ko -->
                        <!-- /ko -->
                        <!-- ko if: comments -->
                        <!-- ko if: comments.count > 0 -->
                        <div class="c-contentstream__instagram--comments">
                            <i class="icon-comment"></i>
                            <span data-bind="text: comments.count"></span>
                        </div>
                        <!-- /ko -->
                        <!-- /ko -->
                    </div>
                </a>
            </div>
        </div>
        <!-- /ko -->

        <!-- ko if: type === 'facebook' -->
        <div class="c-contentstream__item c-contentstream__facebook" data-bind="with: data">

            <div class="c-contentstream__item--inner">
                <div class="c-contentstream__facebook__body" data-bind="text: message"></div>

                <div class="c-contentstream__facebook--actions__like" data-bind="html:page.likeButton"></div>

                <!-- ko if: full_picture -->
                <button class="c-contentstream__social__media--tigger c-contentstream__facebook__media--tigger__opener" type="button">
                        <i class="icon-picture"></i><span>Show Photo</span>
                    </button>
                <div class="c-contentstream__facebook__overlay">
                    <div class="c-contentstream__facebook__media">
                        <img class="c-contentstream__facebook__image" data-bind="attr: { src: full_picture, alt: 'Post Photo from ' + from.Value }">
                    </div>
                    <button class="c-contentstream__social__media--tigger c-contentstream__facebook__media--tigger__close" type="button">
                            <i class="icon-cancel"></i><span>Close Photo</span>
                        </button>
