                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- ko if: stats -->
                                <a class="c-nav__url c-nav__url--level-2 c-nav__schedule-roster-news stats" data-bind="attr: { href: stats.url }">Stats</a>
                                <!-- /ko -->
                                <!-- ko if: social_media_links -->
                                <!-- ko foreach: social_media_links -->
                                <a class="c-nav__url c-nav__url--level-2 c-nav__social" data-bind="text: title, attr: { href: url }, css: class_name"></a>
                                <!-- /ko -->
                                <!-- /ko -->
