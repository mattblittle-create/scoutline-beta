<script type="text/javascript">
    if (typeof airgap !== 'undefined') {
        window.airgap.ready((airgap) => {
            airgap.addEventListener('consent-change', ({ detail: { consent, oldConsent } }) => {
                if (
                    oldConsent.purposes['Functional'] == false &&
                    consent.purposes['Functional'] == true
                ) {
                    airgap.setConsent(window.airgapScriptLoadEvent, {
                        Functional: false,
                    });
                }
            });
        }); 
    }

    document.addEventListener("DOMContentLoaded", function () {
        if ('airgap' in window && 'transcend' in window) {
            const cpraButton = document.getElementById('cpra_button');
            cpraButton.onclick = (e) => {
                e.preventDefault();
                transcend.showConsentManager({ viewState: 'AcceptAllRejectAllToggle' });
            };

            window.airgap.ready(async (airgap) => {
                //await airgap.sync();
                let userConsent = airgap.getConsent();
                console.info('airgap --> userConsent', userConsent);                
            });
        }
    });
</script>

                            </div>
                        </div>
                    </footer>

                
<script type="text/javascript">window.accessibility_focus_outline_style = 'solid'; window.accessibility_focus_outline_color = '#FF5500'; window.accessibility_focus_outline_width = '5px'; window.accessibility_light_mode = 'true'.toLowerCase();</script></form>

                <script>
                    require(['jquery', 'config', 'jquery-ui', 'headroom', 'jquery-headroom', ], function($) {

                        /* Hot fix for undefinted property of 'msie; */
                        jQuery.browser = {};
                        (function() {
                            jQuery.browser.msie = false;
                            jQuery.browser.version = 0;
                            if (navigator.userAgent.match(/MSIE ([0-9]+)\./)) {
                                jQuery.browser.msie = true;
                                jQuery.browser.version = RegExp.$1;
                            }
                        })();

                    });

                    $(function() {

                        $(document).on("keypress", "#search-container .search-input input[type='text']", function(e) {
                        
                            if (e.keyCode == 13) {
                                e.preventDefault();
                                window.location = '/searchresults.aspx?cx=016306950182310286156%3Aorq5uknesxk&q=' + $("#search-container").find(".search-input input[type='text']").val() + '&sa=Search&cof=FORID%3A11#1141';
                                return false;
                            }
                        
                        }).on("click", "#search-container .search-button input[type='submit']", function(e) {
                        
                            e.preventDefault();
                            window.location = '/searchresults.aspx?cx=016306950182310286156%3Aorq5uknesxk&q=' + $("#search-container").find(".search-input input[type='text']").val() + '&sa=Search&cof=FORID%3A11#1141';
                            return false;
                        
                        }).on("click", "#search-btn", function() {
                            
                            $(this).siblings("#search-container").toggleClass("active");
                            $(this).toggleClass("active");

                        }).on("focusin focusout", "#search_input, #search_button", function(e) {
    
                            if (e.type === "focusin") {
                        
                                $("#search-container").addClass("active");
                                $("#search-btn").addClass("active");
                        
                            } else if (e.type === "focusout") {
                        
                                $("#search-container").removeClass("active");
                                $("#search-btn").removeClass("active");
                                
                            }
                        
                        });

                        $(document).on("click", "button.sidearm-accessible-pause", function(e) {
                    
                            var $this = $(this),
                                label = $.trim($this.attr("data-label")),
                                selector = $.trim($this.attr("data-slick")),
                                $slick = $(selector),
                                paused = $this.hasClass("sidearm-paused");
                            
                            e.preventDefault();
                            
                            console.log("label", label);
                            console.log("selector", selector);
                            console.log("$slick", $slick);
                            
                            if (selector !== "" && $slick.length) {
                                
                                if (paused) {
                                    
                                    $slick.slick("slickPlay");
                                    $this.text("Pause").attr("aria-label", "Pause " + label + " Rotator").removeClass("sidearm-paused");
                                    
                                } else {
                                    
                                    $slick.slick("slickPause");
                                    $this.text("Play").attr("aria-label", "Play " + label + " Rotator").addClass("sidearm-paused");
                                    
                                }
                            
                            }
                            
                        }).on("click", ".w-nav-standard .menu-toggle", function(e) {

                            var $nav = $(".c-nav-flyout .c-nav__flyout-menu");

                            if ($nav.hasClass("opened")) {
                            
                                $(".c-nav-flyout .c-nav__flyout-menu .c-nav__url--level-1").attr("tabindex", "0");
                            
                            } else {
                                
                                $(".c-nav-flyout .c-nav__flyout-menu .c-nav__url--level-1").attr("tabindex", "1");

                            }

                        }).on("keyup keydown", ".c-nav-flyout .c-nav__flyout-menu .c-nav__url--level-1", function(e) {

                            var $this = $(this),
                                key = e.which,
                                type = e.type,
                                $level2 = $this.closest(".c-nav__item--level-1").find(".c-nav__flyout-menu--level-2");
                                
                            if (key == 32 || key == 13) {

                                if ($level2.length) {
                                    
                                    if (type == "keydown") {

                                        var $level2links = $level2.find(".c-nav__url--level-2");

                                        if ($level2.hasClass("opened")) {
                                            
                                            $level2.removeClass("opened");          
                                            $level2links.attr("tabindex", "-1");

                                        } else {

                                            $level2.addClass("opened");
                                            $level2links.attr("tabindex", "0");
                                        
                                        }
                                    
                                    }

                                }

                            }

                        }).on("focusin", ".c-nav-flyout .c-nav__flyout-menu .c-nav__url--level-1", function (e) {

                            var $this = $(this),
                                type = e.type,
                                $level2 = $(".c-nav__item--level-1 .c-nav__flyout-menu--level-2"),
                                $level2links = $level2.find(".c-nav__url--level-2");

                            //if ($level2.length && $level2links.length) {

                                $level2.removeClass("opened");          
                                $level2links.attr("tabindex", "-1");

                            //}

                            
                        }).on("focusin", "#top-stories-pause button, .c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--sport-home a", function (e) {

                            if ( $(".c-nav__flyout-menu").hasClass("opened") ) {

                                var $level2 = $(".c-nav__item--level-1 .c-nav__flyout-menu--level-2"),
                                    $level2links = $level2.find(".c-nav__url--level-2");
                                
                                $(".w-nav-standard .menu-toggle").click();

                                $level2.removeClass("opened");          
                                $level2links.attr("tabindex", "-1");

                            }

                        }).on("keydown", ".sidearm-sport-more-links", function(e) {

                            var $this = $(this),
                                key = e.which,
                                type = e.type,
                                $level2 = $(".c-nav__sport-menu--flyout-menu");
                                
                            if (key == 32 || key == 13) {

                                if ($level2.hasClass("opened")) {
                                
                                    $level2.removeClass("opened");
                                
                                } else {

                                    $level2.addClass("opened");

                                }

                                $this.click();

                            }

                        }).on("focusin", ".sidearm-sport-more-links, main a, main button, main input, main select", function(e) {

                            $(".c-nav__sport-menu--flyout-menu").removeClass("opened");

                        }).on("click", ".sidearm-sport-more-links", function(e) {

                            var $this = $(this),
                                key = e.which,
                                type = e.type,
                                $level2 = $(".c-nav__sport-menu--flyout-menu");
                                
                            if ($level2.length) {

                                if ($level2.hasClass("opened")) {

                                    $(".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu .c-nav__url--level-1").attr("tabindex", "0");
                                    $(".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu .c-nav__url--level-2").attr("tabindex", "-1");

                                } else {

                                    $(".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu a").attr("tabindex", "-1");

                                }

                            }

                        }).on("keydown", ".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu .c-nav__url--level-1.sidearm-haspopup", function(e) {

                            var $this = $(this),
                                key = e.which,
                                type = e.type,
                                $level2 = $this.closest("li").find("ul").first();
                            
                            console.log("$level2.length", $level2.length);

                            if ($level2.length) {
                                
                                if (key == 32 || key == 13) {

                                    if ($level2.hasClass("opened")) {

                                        $this.removeClass("opened");
                                        $level2.removeClass("opened");
                                        $level2.find("a").attr("tabindex", "-1");
                                    
                                    } else {
                                        
                                        $this.addClass("opened");
                                        $level2.addClass("opened");
                                        $level2.find("a").attr("tabindex", "0");

                                    }

                                    //$this.click();

                                }

                            }

                        }).on("focusin", ".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu .c-nav__url--level-1.sidearm-haspopup, main a, main button, main input, main select", function(e) {

                            var $this = $(".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu .c-nav__url--level-1.sidearm-haspopup"),
                                $level2 = $this.closest("li").find("ul");

                            $this.removeClass("opened");
                            $level2.removeClass("opened");
                            $level2.find("a").attr("tabindex", "-1");

                        });

                        var infiniteLoop = setInterval(function(){

                            $("#search-container:not(.active) #search_input").attr("tabindex", "-1");
                            $("#search-container:not(.active) #search_button").attr("tabindex", "-1");

                            $("#search-container.active #search_input").attr("tabindex", "0");
                            $("#search-container.active #search_button").attr("tabindex", "0");


                            $(".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu:not(.opened) .c-nav__url--level-1").attr("tabindex", "-1");
                            $(".c-nav-sport .c-nav__sport-menu--mobile .c-nav__sport-menu--flyout-menu-level-2:not(.opened) .c-nav__url--level-2").attr("tabindex", "-1");

                        }, 250);

                    });

                </script>

            <script type='text/html' id='template-promotions'><!-- ko ifnot: isInitializing() -->

    <!-- ko switch -->

        <!-- ko case: ad.location.type === 'single' -->
