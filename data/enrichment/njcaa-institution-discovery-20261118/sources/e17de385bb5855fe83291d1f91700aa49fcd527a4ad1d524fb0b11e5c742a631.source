</div></script><script type='text/html' id='template-navigation'><!-- ko if: name() === 'main-nav' -->
<div class="w-nav-standard" data-bind="css: { 'opened': isMenuOpen }">
    <div class="w-nav-standard__inner">
        <div class="w-menu__toggle">
            <a href="/index.aspx">
                <img src="/images/assets/csn-coyote-logo.png" alt="College of Southern Nevada Coyote's - Go to Homepage">
            </a>
        </div>

        <ul class="c-nav__level-1 flex" data-bind="foreach: data">
            <li data-bind="css: class_name" class="c-nav__item c-nav__item--level-1">
