                                <!-- ko if: separator -->
                                <span data-bind="text: title"></span>
                                <!-- /ko -->

                                <!-- ko ifnot: separator -->
                                <a class="c-nav__url c-nav__url--level-2" target="_blank" data-bind="text: title, attr: { href: url, target: open_in_new_window ? '_blank' : '' }"></a>

                                <!-- ko if: schedule_roster_news_links -->
