                                <picture data-bind="html5Picture: ad.picture"></picture>
                            </a>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->
                <!-- /ko -->

                <!-- ko if: url != "" -->
                <a class="c-nav__url c-nav__url--level-1" data-bind="html: title, attr: { href: url, target: open_in_new_window ? '_blank' : '' }"></a>
                <!-- /ko -->
            </li>
        </ul>
        <div class="w-navigation__icons">
            <ads-component params="{ name:'navigation-social-6469f0' }"></ads-component>
            <button id="search-btn" type="button">
                <span>Search</span>
                <i class="icon-search"></i>
            </button>
            <div id="search-container" role="search">
                <div class="search-container__inner">
                    <div class="search-input">
                        <input aria-label="Search Text" type="text" id="search_input" name="earch_input" placeholder="Search" tabindex="-1" />
                    </div>
                    <div class="search-button">
                        <input aria-label="Search Submit" type="submit" id="search_button" name="search_button" value="GO" tabindex="-1" />
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
