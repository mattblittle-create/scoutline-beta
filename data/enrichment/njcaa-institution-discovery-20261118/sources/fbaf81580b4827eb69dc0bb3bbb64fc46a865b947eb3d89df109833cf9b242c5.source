<style>
.is-expanded-menu #header {
--cnvs-header-bg: rgba(var(--cnvs-invert-contrast-rgb), .7);
}
.comp-sched {
    max-width: 100%;
    margin: 0;
    padding: 0;
}
.comp-sched-day {
    padding-left: 0 !important;
    padding-right: 0 !important;
}
.comp-sched-date {
    padding-left: 0 !important;
}
.comp-sched-lcc {
    font-weight: bold !important;
    text-transform: uppercase;
}
table .home .comp-sched-opponent {
    font-weight: bold !important;
}
table .home .comp-sched-opponent:before, table .homeconf .comp-sched-opponent:before {
    content: 'VS';
    color: #fff;
    background-color: #da1a32;
    padding: 0px 3px;
    margin-right: 5px;
    border-radius: 3px;
    font-size: .8rem;
}
table .away .comp-sched-opponent:before, table .awayconf .comp-sched-opponent:before {
    content: 'AT';
    color: #fff;
    background-color: #58595b;
    padding-top: 0px;
    padding-right: 3px;
    padding-left: 3px;
    margin-right: 5px;
    border-radius: 3px;
    font-size: .8rem;
}
.home, .homeconf, .away, .awayconf {
    background-size: 20px 20px;
    background-repeat: no-repeat;
}
.home {
    background-image: url("images/corner-home.png");
}
.homeconf {
    background-image: url("images/corner-homeconf.png");
}
.awayconf {
    background-image: url("images/corner-awayconf.png");
}
.comp-sched tr, .comp-sched th, .comp-sched td {
    display: inline-block;
    overflow: hidden !important;
    font-size: .9rem;
    width: auto !important;
}
.comp-sched tr {
    margin: .5%;
    float: left !important;
    overflow: hidden;
    padding-top: 10px;
    padding-left: 70px;
    border: 1px solid #bbb;
    background-color: #fff;
}
.comp-sched td, .comp-sched th {
    display: inline-block;
    vertical-align: top;
    padding-top: 0px;
    padding-right: 5px;
    line-height: 1;
    border: 0!important;
}
.comp-sched .comp-sched-opponent {
    display: block;
    margin-bottom: 7px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 1em;
    font-weight: normal !important;
}
.comp-sched-opponent {
    margin-right: 25px !important;
}
.comp-sched .comp-sched-opponent .comp-sched-img {
    max-HEIGHT: 50px !important;
    max-width: 50px !important;
    object-fit: contain !important;
    margin-right: 10px;
}
.comp-sched .comp-sched-opponent .comp-sched-img {
    display: block;
    width: 50px;
    float: left;
    margin-left: -60px;
    margin-bottom: auto;
    margin-top: -35px;
    position: absolute;
}
.comp-sched-opponent img {
    width: 50px;
    HEIGHT: 50px;
    object-fit: contain !important;
}
#eventstable tr {
    width: 99% !important;
}

@media only screen and (max-width: 991.98px) {
.slider-caption h1, .slider-caption .h1, .slider-caption h2, .slider-caption .h2 {
    font-size: 2rem!important;
}
.slider-caption p {
    font-size: 1rem!important;
}
}
}

@media only screen and (max-width: 575.98px) {
#eventstable tr {
    width: 99% !important;
}
}

@media (min-width: 576px) and (max-width: 991.98px) {
#eventstable tr {
    width: 49% !important;
}
}

@media (min-width: 992px) and (max-width: 1400px) {
#eventstable tr {
    width: 32.3333% !important;
}
}

@media only screen and (min-width: 1400px) {
#eventstable tr {
    width: 24% !important;
}
}
</style>
