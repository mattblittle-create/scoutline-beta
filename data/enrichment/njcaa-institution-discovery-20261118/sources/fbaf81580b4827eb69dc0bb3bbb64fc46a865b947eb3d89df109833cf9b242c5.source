<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.owl-nav').forEach(function (nav) {
    const prevButton = nav.querySelector('.owl-prev');
    const nextButton = nav.querySelector('.owl-next');

    if (prevButton) {
      // Remove invalid ARIA role
      prevButton.removeAttribute('role');

      // Add accessible name
      prevButton.setAttribute('aria-label', 'Previous slide');

      // Hide icon from screen readers
      const icon = prevButton.querySelector('i');
      if (icon) {
        icon.setAttribute('aria-hidden', 'true');
      }
    }

    if (nextButton) {
      nextButton.removeAttribute('role');
      nextButton.setAttribute('aria-label', 'Next slide');

      const icon = nextButton.querySelector('i');
      if (icon) {
        icon.setAttribute('aria-hidden', 'true');
      }
    }
  });
});
</script> 
<!-- InstanceBeginEditable name="footerscripts" --><script>
document.addEventListener('DOMContentLoaded', function() {
    const table = document.getElementById('eventstable');
    if (!table) return;

    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Set forward limit to May 31
    let limitYear = today.getFullYear();
    if (today.getMonth() > 4) { 
        // If today is June (5) or later, use May of NEXT year
        limitYear++;
    }
    const forwardLimit = new Date(limitYear, 4, 31); // May = month 4
    forwardLimit.setHours(23, 59, 59, 999);

    function getEventDate(row) {
        const dateCell = row.querySelector('.comp-sched-date');
        if (!dateCell) return null;

        const dateText = dateCell.textContent.trim(); // format: MM/DD
        const [monthStr, dayStr] = dateText.split('/');
        const month = parseInt(monthStr, 10) - 1; // JS months 0–11
        const day = parseInt(dayStr, 10);

        if (isNaN(month) || isNaN(day)) return null;

        // Default year = current year
        let eventYear = today.getFullYear();
        let eventDate = new Date(eventYear, month, day);
        eventDate.setHours(0, 0, 0, 0);

        // If event already passed, roll to next year
        if (eventDate < today) {
            eventYear++;
            eventDate = new Date(eventYear, month, day);
            eventDate.setHours(0, 0, 0, 0);
        }

        return eventDate;
    }

    const validRows = rows
        .map(row => ({ row, date: getEventDate(row) }))
        .filter(item => item.date && item.date >= today && item.date <= forwardLimit)
        .sort((a, b) => a.date - b.date);

    tbody.innerHTML = '';
    validRows.forEach(item => tbody.appendChild(item.row));
});
</script> 
<script>
document.addEventListener("DOMContentLoaded", function () {
  const rows = document.querySelectorAll("#eventstable tr");

  rows.forEach(function(row, index) {
    // Keep first 12 rows (index 0–11), remove the rest
    if (index >= 12) {
      row.remove();
    }
  });
});
</script> 
<!-- InstanceEndEditable -->
