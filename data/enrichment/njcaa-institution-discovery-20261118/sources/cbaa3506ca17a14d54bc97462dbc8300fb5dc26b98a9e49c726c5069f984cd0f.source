    <!-- Merger Info Section -->
    <section id="merger">
      <div class="row blue-gradient-bg">
        <div class="container">
          <div class="row">
            <div class="col-md-12">
              
              <style type="text/css">.gradient-button .btn-white, .gradient-button .btn-white:focus, .gradient-button .btn-white:visited {
    color: #071689 !important;
    background-color: rgb(255, 255, 255) !important;
    border-color: rgb(255, 255, 255) !important;
    margin: 15px 0 30px 0 !important;
	}
    .gradient-button .btn-white:hover {
        color: rgb(255, 255, 255) !important;
        background-color: rgb(7, 22, 137) !important;
        border-color: rgb(255, 255, 255) !important;
    }</style>
<div class="main-section-heading text-center" style="padding-top: 80px;">
	<div class="heading-primary">Proposed Merger</div>

	<div class="heading-divider" style="border-top: 2px solid #fff;">&nbsp;</div>

	<div class="heading-secondary">Learn more and view FAQ</div>
</div>

<div class="row" style="padding: 40px;">
	<div class="col-md-4 text-center" style="padding: 10px 50px 40px 0;"><img alt="DCTC and Inver Hills Logos" class="img-responsive center-block" height="198" src="/sites/DCTC/assets/Image/logos/BOTH_Logos_Members_White.png" width="500" /></div>

	<div class="col-md-8">
		<p>In Summer 2027, Inver Hills Community College plans to merge with Dakota County Technical College and become Minnesota Valley College.*</p>

		<p><small><em>* Pending approval from the Higher Learning Commission, Minnesota State Board of Trustees, and the U.S. Department of Education.</em></small></p>

		<div class="gradient-button">
			<p><span class="visible-xs"><a class="btn btn-lg btn-white" href="/go/merger/" role="button"><i class="fa-regular fa-circle-info fa-padding-after"></i>View FAQ</a></span></p>

			<p><span class="hidden-xs"><a class="btn btn-lg btn-white" href="/go/merger/" role="button"><i class="fa-regular fa-circle-info fa-padding-after"></i>See frequently asked questions and learn more</a></span></p>
		</div>
	</div>
</div>
<!-- /.row -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission Section for Desktops -->
    <section id="mission" class="container-fluid content-section text-center">
      <div class="row">
        <div class="container">
          <div class="row">
            <div class="col-md-12">
              <div class="main-section-heading">
                <div class="heading-secondary">Our Mission Is</div>
                <div class="heading-divider"></div>
                <div class="heading-primary">Education for Employment</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="container">
          <div class="row">
            <div class="col-md-4">
              <img src="/themes/dctc_2014/images/homepage/icon-affordability.png" class="img-responsive center-block" alt="Affordability">
              <h2>Affordability</h2>
              <p>DCTC credits are about 1/3 the cost of a private 2-year school.</p>
              <p>DCTC annual tuition is only <strong>$6,600</strong><br />
                <em>(based on 30 credits per year)</em>
              </p>
            </div>
            <div class="col-md-4">
              <img src="/themes/dctc_2014/images/homepage/icon-alumni-success.png" class="img-responsive center-block" alt="Alumni Success">
              <h2>Alumni Success</h2>
              <p>Employers seek out DCTC graduates.</p>
              <p><strong>97%</strong> of employers would hire a DCTC graduate again.</p>
            </div>
            <div class="col-md-4">
              <img src="/themes/dctc_2014/images/homepage/icon-flexibility.png" class="img-responsive center-block" alt="Flexibility">
              <h2>Flexibility</h2>
              <p>DCTC offers day, evening, weekend and online courses in <a href="/about-us/location-maps/">Rosemount</a> to accommodate your busy schedule. <a href="/academics/short-term-programs/">Short-term programs</a> can be completed in as little as six-weeks.</p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- President's Message Section -->
    <section id="welcome-back" class="content-section">
      <div class="row blue-gradient-bg">
        <div class="container" style="padding: 30px;">
          <div class="row">
            <div class="col-md-5">
              <div class="embed-responsive embed-responsive-16by9">
                <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/-CEAKK5WVPM" title="President's Message" allowfullscreen></iframe>
              </div>
            </div>
            
            <div class="col-md-7">
              <h2>Welcome to Dakota County Technical College</h2>
              <h3>
                <ul class="fa-ul">
                  <li style="margin-bottom: 10px !important;"><span class="fa-li"><i class="fa-regular fa-square-check"></i></span><a href="/academics/programs-majors/">Explore Degrees &amp; Programs</a></li>
                  <li style="margin-bottom: 10px !important;"><span class="fa-li"><i class="fa-regular fa-square-check"></i></span><a href="/admissions/">Apply for Admission</a></li>
                  <li style="margin-bottom: 10px !important;"><span class="fa-li"><i class="fa-regular fa-square-check"></i></span><a href="/admissions/visit-dctc/">Visit our Campus</a></li>
