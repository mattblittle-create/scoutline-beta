    <h1 class="homepage-h1">Start Your Education Journey at DCTC</h1>
    
    <!-- Hero Image -->
    <div class="container-fluid hero-image">
      <div class="row-fluid">			
                
        <div class="mura-region"><div class="mura-region-local"><div class="mura-object mura-twelve mura-sm mura-object-label-top" data-object="collection" data-objectid="1353FBB7-616A-4B00-9FEECCDF1D41B417" data-instanceid="B12EF54C-DA1D-4DCB-941ECEDEBD9031C8" style="" data-viewalllink="" data-objectname="Collection" data-layout="homepage_images" data-render="server" data-class="mura-twelve&#x20;mura-sm&#x20;mura-object-label-top" data-items="" data-displaylist="Date,Title,Image,Summary,Credits" data-nextn="20" data-modalimages="NO" data-stylesupport="&#x7b;&#x7d;" data-imageheight="AUTO" data-maxitems="4" data-scrollpages="NO" data-applypermfilter="NO" data-objecticonclass="mi-th-list" data-async="false" data-queue="YES" data-sourcetype="localindex" data-viewalllabel="" data-imagesize="small" data-imagewidth="AUTO" data-nextnid="08C40B38-E16B-61DD-A80D656DF4389F07" data-source="08C40B38-E16B-61DD-A80D656DF4389F07" data-cssstyles=""><div class="mura-object-content" style=""><a href="/admissions/visit-dctc/">
