ut-constrained"><h2 class="wp-block-heading has-text-align-center has-custom-river-gold-color has-text-color has-link-color has-xx-large-font-size wp-elements-18" id="h-pay-for-college"><a href="https://irsc.edu/admissions/financial-aid/">Pay for College</a></h2></div><div class="wp-block-group irsc-river-link-row river-visit has-global-padding is-content-justification-center is-layout-constrained wp-block-group-is-layout-constrained"><h2 class="wp-block-heading has-text-align-center has-custom-river-gold-color has-text-color has-link-color has-xx-large-font-size wp-elements-19" id="h-visit-campus"><a href="https://irsc.edu/about/campuses/">Visit Campus</a></h2></div></div></div><style>.irsc-recognition{--logo-blue:#003da5;--logo-yellow:#fedb00;--logo-dark:#062551;--logo-gap:24px;--logo-speed:38s;width:100%;max-width:1200px;min-width:0;margin-inline:auto;padding:72px 0;color:var(--logo-dark)}.irsc-recognition,.irsc-recognition *{box-sizing:border-box}.irsc-recognition__header{padding-inline:20px;margin-bottom:6px}.irsc-recognition__title{margin:0;color:var(--logo-dark);font-family:"Trebuchet MS",sans-serif;font-size:clamp(1.6rem,3vw,2.4rem);line-height:1.15}.irsc-recognition__title:after{content:"";display:block;width:64px;height:4px;margin-top:12px;background:var(--logo-yellow);border-radius:4px}.irsc-recognition__viewport{width:100%;min-width:0;overflow-x:auto;padding-block:48px;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:#aabbd4 transparent}.irsc-recognition__viewport:focus-visible{outline:3px solid var(--logo-blue);outline-offset:-3px}.irsc-recognition__track{display:flex;width:max-content}.irsc-recognition__group{display:flex;flex:0 0 auto;align-items:center;gap:var(--logo-gap);list-style:none;margin:0;padding:0 var(--logo-gap) 0 0}.irsc-recognition__card{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;flex:0 0 164px;width:164px;height:164px;margin:0;padding:15px;background:#fff;border:1px solid #e1e7ef;border-radius:14px;box-shadow:0 4px 12px rgba(6,37,81,.04);transform-origin:center;transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}.irsc-recognition__card:after{content:"";position:absolute;inset:auto 22% 0;height:4px;background:var(--logo-yellow);border-radius:4px 4px 0 0;transform:scaleX(0);transition:transform .3s ease;pointer-events:none}.irsc-recognition__card:hover,.irsc-recognition__card:focus-within{z-index:5;transform:translateY(-10px) scale(1.18);border-color:var(--logo-blue);box-shadow:0 15px 28px rgba(6,37,81,.16)}.irsc-recognition__card:hover:after,.irsc-recognition__card:focus-within:after{transform:scaleX(1)}.irsc-recognition__card>a{display:flex;align-items:center;justify-content:center;width:100%;height:100%;min-width:0;min-height:0;border-radius:6px;text-decoration:none}.irsc-recognition__card>a:focus-visible{outline:3px solid var(--logo-blue);outline-offset:3px}.irsc-recognition__card img{display:block;width:100%;height:100%;max-width:100%;min-height:0;object-fit:contain}.irsc-recognition.is-ready .irsc-recognition__viewport{overflow:hidden;-webkit-mask-image:linear-gradient(to right,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(to right,transparent,#000 4%,#000 96%,transparent)}.irsc-recognition.is-ready .irsc-recognition__track{animation:irscRecognitionScroll var(--logo-speed) linear infinite}.irsc-recognition__viewport:hover .irsc-recognition__track,.irsc-recognition__viewport:focus-within .irsc-recognition__track{animation-play-state:paused}@keyframes irscRecognitionScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}@media (max-width:600px){.irsc-recognition{--logo-gap:20px;padding-block:48px}.irsc-recognition__header{padding-inline:16px}.irsc-recognition__viewport{padding-block:40px}.irsc-recognition__card{flex-basis:140px;width:140px;height:140px;padding:12px;border-radius:12px}}@media (prefers-reduced-motion:reduce){.irsc-recognition.is-ready .irsc-recognition__viewport{overflow-x:auto;-webkit-mask-image:none;mask-image:none}.irsc-recognition.is-ready .irsc-recognition__track{animation:none;transform:none}.irsc-recognition__group[aria-hidden=true]{display:none}.irsc-recognition__card,.irsc-recognition__card:after{transition:none}.irsc-recognition__card:hover,.irsc-recognition__card:focus-within{transform:none}}</style><section class="irsc-recognition"
