            </div><button type="button" class="play-pause pause" title="play/pause"><span class="fa fa-pause"></span><span class="sr-only">Pause Video</span></button><div data-bs-video="/images_documents/contentassets/hero-videos/hero-vid-nov-26.mp4" data-bs-type="video/mp4" data-bs-image="/_resources/images/triton-campus-1.jpg" class="video-container"><video id="homeVideoHeader" muted="" loop="" playsinline="" autoplay="">
                  <source src="/images_documents/contentassets/hero-videos/hero-vid-nov-26.mp4" type="video/mp4"></video></div>
