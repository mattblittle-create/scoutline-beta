  <script src="_files/plugins/splidejs/core/dist/js/splide.min.js"></script>
<script src="_files/plugins/splidejs/grid/dist/js/splide-extension-grid.min.js"></script>
<script src="_files/plugins/splidejs/video/dist/js/splide-extension-video.min.js"></script>
<script defer="defer" src="_files/js/site.js"></script>
<script defer="defer" src="_files/js/overrides.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sliderEl = document.getElementById('homepageSlider');
    const realSlides = sliderEl ? sliderEl.querySelectorAll('.splide__slide').length : 0;

    let homepageSlider = new Splide('#homepageSlider', {
        cover: false,
        autoHeight: false,
        type: realSlides > 1 ? 'loop' : 'slide',
        perPage: 1,
        autoplay: realSlides > 1,
        interval: 5000,
        arrows: realSlides > 1,
        drag: realSlides > 1,
        video: {
            loop: true,
            mute: true,
            autoplay: true,
            playerOptions: {
                youtube: {
                    controls: 0,
                    disablekb: 1
                },
                htmlVideo: {
                    controls: false,
                    playsInline: true,
                    muted: true
                }
            }
        }
    });

    homepageSlider.on('mounted', function() {
        const slider = document.getElementById('homepageSlider');

        // Hide <video> elements until they have a decoded frame so the slide's
        // poster image shows through instead of a black flash. Also strip the
        // wrapper's default black background.
        const style = document.createElement('style');
        style.textContent = '#homepageSlider .splide__video__wrapper{background:transparent!important}#homepageSlider video:not([data-ready]){opacity:0}#homepageSlider video[data-ready]{opacity:1;transition:opacity .15s}';
        document.head.appendChild(style);

        // Keep all play buttons visible at all times (extension tries to hide them)
        new MutationObserver(function() {
            slider.querySelectorAll('.splide__video__play').forEach(function(btn) {
                if (btn.style.display === 'none') {
                    btn.style.display = 'flex';
                }
            });
        }).observe(slider, { attributes: true, attributeFilter: ['style'], subtree: true });

        // Watch for <video> elements and hook them once
        new MutationObserver(function() {
            slider.querySelectorAll('video').forEach(function(videoEl) {
                // iOS autoplay insurance: the extension sets muted/playsInline as
                // properties, but iOS also inspects the HTML attributes. Set them
                // explicitly here (idempotent).
                videoEl.setAttribute('playsinline', '');
                videoEl.setAttribute('webkit-playsinline', '');
                videoEl.setAttribute('muted', '');

                if (videoEl.dataset.customHooked) return;
                videoEl.dataset.customHooked = 'true';

                const slide = videoEl.closest('.splide__slide');
                const btn = slide ? slide.querySelector('.splide__video__play') : null;

                // Show the slide's poster image in place of the video's default
                // black frame while it's loading the first frame.
                const posterImg = slide ? slide.querySelector('img') : null;
                if (posterImg) {
                    videoEl.poster = posterImg.currentSrc || posterImg.src;
                }

                // Reveal the video once it has a decoded frame (see CSS above).
                function markReady() { videoEl.setAttribute('data-ready', ''); }
                if (videoEl.readyState >= 2) {
                    markReady();
                } else {
                    videoEl.addEventListener('loadeddata', markReady, { once: true });
                }

                let hasPlayed = false;

                videoEl.addEventListener('play', function() {
                    hasPlayed = true;
                    if (btn) {
                        btn.classList.add('is-video-playing');
                        btn.setAttribute('aria-label', 'Pause Video');
                    }
                });
                videoEl.addEventListener('pause', function() {
                    if (btn) {
                        btn.classList.remove('is-video-playing');
                        btn.setAttribute('aria-label', 'Play Video');
                    }
                });

                // The extension's UI registers a click listener on the slide itself
                // (this.parent), so ANY click inside the slide triggers the
                // extension's onClick &#8594; state-machine toggle, which collides with
                // our direct pause/play. Stop propagation so only our handler runs.
                function togglePlay(e) {
                    if (e && e.stopPropagation) e.stopPropagation();
                    if (videoEl.paused) {
                        videoEl.play().catch(function() {});
                    } else {
                        videoEl.pause();
                    }
                }
                videoEl.style.cursor = 'pointer';
                videoEl.addEventListener('click', togglePlay);
                if (btn) btn.addEventListener('click', togglePlay);

                // iOS autoplay safety net: if the extension's initial play() was
                // rejected (can happen on mobile even with correct properties),
                // retry once after the attributes are set.
                setTimeout(function() {
                    if (!hasPlayed && videoEl.paused && slide && slide.classList.contains('is-active')) {
                        videoEl.play().catch(function() {});
                    }
                }, 250);
            });
        }).observe(slider, { childList: true, subtree: true });
    });

    function getRealActiveSlide() {
        const activePagBtn = document.querySelector('#homepageSlider .splide__pagination__page.is-active');
        if (activePagBtn) {
            const slideId = activePagBtn.getAttribute('aria-controls');
            if (slideId) {
                const slide = document.getElementById(slideId);
                if (slide) return slide;
            }
        }
        return document.querySelector('#homepageSlider .splide__slide:not(.splide__slide--clone).is-active') ||
               document.querySelector('#homepageSlider .splide__slide.is-active');
    }

    function updateSliderHeight() {
        const slider = document.getElementById('homepageSlider');
        const slideList = slider ? slider.querySelector('.splide__list') : null;
        const activeSlide = getRealActiveSlide();
        if (!activeSlide) return;
        let measuredHeight = activeSlide.offsetHeight;
        if (activeSlide.classList.contains('splide__slide--has-video')) {
            const poster = activeSlide.querySelector('img');
            if (poster && poster.naturalWidth && poster.naturalHeight) {
                let slideWidth = activeSlide.clientWidth;
                measuredHeight = Math.round(slideWidth * (poster.naturalHeight / poster.naturalWidth));
            }
        } else {
            const img = activeSlide.querySelector('img');
            if (img && img.naturalWidth && img.naturalHeight) {
                let slideWidth = activeSlide.clientWidth;
                let calculatedHeight = Math.round(slideWidth * (img.naturalHeight / img.naturalWidth));
                if (calculatedHeight < measuredHeight) measuredHeight = calculatedHeight;
            }
        }
        slider.removeAttribute('style');
        if (slideList) {
            slideList.style.setProperty('height', measuredHeight + 'px', 'important');
            slider.style.setProperty('height', measuredHeight + 'px', 'important');
        }
    }

    homepageSlider.on('mounted moved', updateSliderHeight);
    document.querySelectorAll('#homepageSlider img').forEach(function(img) {
        img.addEventListener('load', updateSliderHeight);
    });
    window.addEventListener('resize', updateSliderHeight);

    homepageSlider.mount(window.splide.Extensions);
});
</script>


