<p class="font_9 wixui-rich-text__text" style="font-size:21px; text-align:center;"><span style="font-size:21px;" class="wixui-rich-text__text"><span style="color:#FFFFFF;" class="wixui-rich-text__text">or by email at <a data-auto-recognition="true" href="mailto:Chris.Harris@BSCC.edu" class="wixui-rich-text__text">Chris.Harris@BSCC.edu</a>. Thank you!</span></span></p></div><!--/$--><!--$--><div id="comp-jlh4nchg" class="ih2JY1 comp-jlh4nchg wixui-image cs40a3"><a data-testid="linkElement" href="https://www.acccathletics.com/landing/index" target="_blank" class="BprtEa"><img loading="lazy" sizes="134px" srcSet="https://static.wixstatic.com/media/2272a5_55abd0949c5a4a089895619ca0ea0e3a~mv2.png/v1/fill/w_134,h_43,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Untitled%20design-68.png 1x, https://static.wixstatic.com/media/2272a5_55abd0949c5a4a089895619ca0ea0e3a~mv2.png/v1/fill/w_268,h_86,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Untitled%20design-68.png 2x" id="img_comp-jlh4nchg" src="https://static.wixstatic.com/media/2272a5_55abd0949c5a4a089895619ca0ea0e3a~mv2.png/v1/fill/w_134,h_43,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Untitled%20design-68.png" alt="Untitled design-68.png" style="object-fit:cover" class="klqGPG sFiSiq" width="134" height="43"/></a></div><!--/$--><!--$--><div id="SITE_STRUCTURE_WRichText_1" class="UwkEpO _v6ohL AWXfZq PO9MfV SITE_STRUCTURE_WRichText_1 wixui-rich-text" data-testid="richTextElement"><p class="font_9 wixui-rich-text__text" style="line-height:normal; text-align:center; font-size:13px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span class="color_36 wixui-rich-text__text">&copy; 2022 BEVILL STATE COMMUNITY COLLEGE. </span></span></p></div><!--/$--><!--$--><div id="comp-jlh4oi8p" class="ih2JY1 comp-jlh4oi8p wixui-image cs40a3"><a data-testid="linkElement" href="https://www.njcaa.org/landing/index" target="_blank" class="BprtEa"><img loading="lazy" sizes="71px" srcSet="https://static.wixstatic.com/media/402d47_9785904a0c2b4c909fe863f8ce3c9103~mv2.png/v1/fill/w_71,h_67,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/NJCAA_Current_logo.png 1x, https://static.wixstatic.com/media/402d47_9785904a0c2b4c909fe863f8ce3c9103~mv2.png/v1/fill/w_142,h_134,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/NJCAA_Current_logo.png 2x" id="img_comp-jlh4oi8p" src="https://static.wixstatic.com/media/402d47_9785904a0c2b4c909fe863f8ce3c9103~mv2.png/v1/fill/w_71,h_67,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/NJCAA_Current_logo.png" alt="National Junior College Athletics Association Logo" style="object-fit:cover" class="klqGPG sFiSiq" width="71" height="67"/></a></div><!--/$--></div></div></div></div></footer></div></div><div id="SCROLL_TO_BOTTOM" class="qe3oTb ignore-focus SCROLL_TO_BOTTOM" role="region" tabindex="-1" aria-label="bottom of page"><span class="TvbeET">bottom of page</span></div></div></div>

<script id="wix-skip-played-animations">
    window.__pageRevealPromise && window.__pageRevealPromise.then(function() {
        requestAnimationFrame(function() {
            try {
                var stored = sessionStorage.getItem('wix-motion-played-animations');
                if (stored) {
                    var played = JSON.parse(stored);
                    for (var compId in played) {
                        if (played[compId]) {
                            var el = document.getElementById(compId);
                            if (el) {
                                el.dataset.motionEnter = 'done';
                            }
                        }
                    }
                }
            } catch (e) {}
        });
    });
</script>

