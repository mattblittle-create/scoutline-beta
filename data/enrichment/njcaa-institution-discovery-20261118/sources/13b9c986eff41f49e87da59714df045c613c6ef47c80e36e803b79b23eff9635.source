<style>
span.visuallyhidden {
    position: absolute;
    left: -99999px;
    height: 1px;
    width: 1px;
}
.active .slide {
  display: block !important;
  visibility: hidden;
  transition: left .6s ease-out;
}

.active .slide.current {
  visibility: visible;
  left: 0;
}

.active .slide.next {
  left: 100%;
}

.active .slide.prev {
  left: -100%;
}

.active .slide.next.in-transition,
.active .slide.prev.in-transition {
  visibility:visible;
}

  .carousel, .slide {
    width: 100%;
    padding:0;
    margin: 0;
    #overflow: hidden;
  }
  .carousel {
    position: relative;
  }
  .carousel ul {
    margin:0 63px 0 0;
    padding: 0;
  }
  .slide {
    height: 100%;
    background-size: cover;
    position: relative;
    margin-bottom:1em;
    border:1px solid #333;
  }
  .slide h3 {
    display:inline-block;
    font-weight: bold;
    font-size: 1.25em;
    margin:0;
    padding: .5em 1em;
    background-color: rgba(255,255,255,.8);
    float:left;
    position: absolute;
    bottom: 0;
    border-radius: 0 .5em 0 0;
  }
  .slide p {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    margin:0;
    clear:both;
    padding: 5px;
    background-color: rgba(255,255,255,.8);
  }
  .slide a {
    display:block;
    text-align: left;
  }

.carousel.active {
  height: 100%;
  border: 1px solid #333;
  position:relative;
}

.active .slide {
  border: none;
  display: none;
  position:absolute;
  top:0;
  left:0;
  z-index:200;
}

.slide.current {
  display:block;
  z-index: 500;
}

.btn-prev,
.btn-next,
.slidenav button {
  position:absolute;
  z-index: 700;
  bottom: 0; /* 50% */
  margin-top: -2.5em;
  border:0;
  background: rgba(255,255,255,.6);
  line-height: 1;
  padding: 6px 5px 0;
  transition: padding .4s ease-out;
}

.btn-next:hover,
.btn-next:focus,
.btn-prev:hover,
.btn-prev:focus {
  #padding-left: 20px;
  #padding-right: 20px;
  background-color: gold;
  color: #050;
}
.slidenav button:hover,
.slidenav button:focus {
  #font-size: 3em;
  #border: 2px dotted #fff;
  background: gold;
}

.btn-prev {
  right: 73px;
  border-radius: .25em 0 0 .25em;
}

.btn-next {
  right:0;
  border-radius: 0 .25em .25em 0;
}

.carousel.with-slidenav {
  padding-bottom: 2.5em;
  overflow: hidden;
  background: #222 url(/img/seal275.png) repeat-x center;
}
.carousel.with-slidenav .slide {
  border-bottom: 1px solid #333;
}

.slidenav {
  #position: absolute;
  #bottom: -2.25em;
  #left: 0;
  #right: 0;
  z-index: 999;
  float: right;
}

.slidenav li {
  display:inline-block;
  margin: 0 .5em;
}

.slidenav button {
  line-height: .5;
  height: .77em;
  font-weight: bold;
  color: #000;
  font-size: 2.2em;
  padding: 13px 9px 28px;
  margin: 0;
}

.slidenav button.current {
  border-radius: .5em;
  background-color: #fff;
  color: #333;
}

.slidenav button.current:hover,
.slidenav button.current:focus {
  border: 2px dotted #036;
}
.slidenav li:nth-child( n+2 ) {
    display: none;
}
[data-action="start"] {
  font-size: 1.8em !important;
  padding: 15px 6px 26px !important;
  background: #ff9f9f !important;
}
[data-action="stop"]{
