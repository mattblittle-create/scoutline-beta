}
.future-pioneer a:hover, .future-pioneer a:focus, .future-pioneer .pod-unit:hover *, .future-pioneer .pod-unit:focus *, .future-pioneer .pod-unit:hover, .future-pioneer .pod-unit:focus   { 
  background: transparent !important;
