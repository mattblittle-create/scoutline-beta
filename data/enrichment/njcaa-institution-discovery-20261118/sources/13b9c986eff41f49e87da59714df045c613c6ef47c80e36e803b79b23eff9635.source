}
.future-pioneer a span { border-bottom: 1px dotted #ccc; } .future-pioneer a:hover span,.future-pioneer a:focus span { border-bottom: 1px solid gold; }
.future-pioneer a:hover img, .future-pioneer a:focus img { 
  border: 4px solid gold !important;
}
.future-pioneer p { 
  padding: 10px 20px;
}



