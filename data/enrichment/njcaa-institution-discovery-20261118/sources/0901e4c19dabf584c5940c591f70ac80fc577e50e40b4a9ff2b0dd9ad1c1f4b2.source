<!-- Popup Modal -->
<div class="saved-classes-popup" id="savedClassesPopup">
    <div class="popup-container">
        <div class="popup-header">
            <div class="popup-header__actions">
                <h2>Saved Classes</h2>
                <div class="btn btn--fill-light">
                    <button type="button" id="toggleSendForm" class="popup-send-email-btn">Email saved
                        classes</button>
                </div>
            </div>
            <button class="popup-close" id="closePopup" aria-label="Close popup"><i
                    class="fa-solid fa-plus"></i></button>
        </div>
        <div class="popup-body">
            <div class="course-list">
            </div>
            <div class="popup-send-form">
                <h2 class="popup-send-form__title">Receive saved courses in email</h2>
                <div class="popup-send-field">
                    <label for="popupSendName" class="sr-only">Your name</label>
                    <input type="text" id="popupSendName" class="popup-send-input" placeholder="Your name" autocomplete="name" />
                    <span class="popup-field-error" id="popupSendNameError"></span>
                </div>
                <div class="popup-send-field">
                    <label for="popupSendEmail" class="sr-only">Your email</label>
                    <input type="email" id="popupSendEmail" class="popup-send-input" placeholder="Your email" autocomplete="email" />
                    <span class="popup-field-error" id="popupSendEmailError"></span>
                </div>
                <label class="popup-gdpr-label">
                    <input type="checkbox" id="popupGdprConsent" name="gdpr-consent" value="1" />
                    <span>I agree to BCC holding information about me in accordance with its <a
                            href="/privacy-policy-cookies/" style="text-decoration: underline">privacy
                            policy</a>.</span>
                </label>
                <span class="popup-field-error" id="popupGdprError"></span>
                <button type="button" id="popupSendBtn" class="popup-send-btn">Send</button>
                <div class="popup-send-message" id="popupSendMessage" role="alert"></div>
            </div>
        </div>
    </div>
</div>
