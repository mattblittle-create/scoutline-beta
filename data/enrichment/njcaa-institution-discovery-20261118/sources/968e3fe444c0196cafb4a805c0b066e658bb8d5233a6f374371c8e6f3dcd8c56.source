 data-id="ab7d1a8" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><div class="elementor-element elementor-element-de0b89d e-transform elementor-widget elementor-widget-text-editor" data-id="de0b89d" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_transform_scale_effect&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:1.3000000000000000444089209850062616169452667236328125,&quot;sizes&quot;:[]},&quot;_transform_scale_effect_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;_transform_scale_effect_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]}}" data-widget_type="text-editor.default"><h2 style="text-align: center;"><span style="color: #ffffff;">YOU&#8217;LL LOVE BEING A PIRATE!</span></h2></div><div class="elementor-element elementor-element-36946ae elementor-widget elementor-widget-text-editor" data-id="36946ae" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><p style="text-align: center;"><span style="color: #ffffff;">We care about our students’ plans for their lives. We make sure they&#8217;re getting their education, their way. Join the Pirate crew and see for yourself.</span></p></div><div class="elementor-element elementor-element-a9ebce8 elementor-align-center elementor-widget elementor-widget-the7_button_widget" data-id="a9ebce8" data-element_type="widget" data-e-type="widget" data-widget_type="the7_button_widget.default"><div class="elementor-widget-container"><div class="elementor-button-wrapper"><a href="https://www.ncmissouri.edu/admissions/" title="Admissions" class="box-button elementor-button elementor-size-md">Explore Admissions</a></div></div></div></div></div><div class="elementor-column elementor-col-25 elementor-top-column elementor-element elementor-element-e85f9ae elementor-hidden-mobile" data-id="e85f9ae" data-el