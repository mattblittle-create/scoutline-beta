 padding-left: 25px;
}
/*Color the search icon white*/
svg.e-fas-search{
 fill: #ffffff!important;
}
input:focus{
 font-weight: bold;
 text-decoration: underline;
 border-radius:3px;
 border-color: #cf202e !important;
 color: #ffffff;
}
.eael-advanced-search-button:focus{
 color: #ffffff;
 background-color: #cf202e;
 text-decoration: underline;
}
.eael-advanced-search-button:hover{
 color: #ffffff;
 background-color: #cf202e;
 text-decoration: underline;
 border-color: #000000 !important;
 border-width: 2px !important;
}
a {
font-weight: bold;
}
a:onlick {
font-weight: bold;
text-decoration: none;
}
a:focus {
font-weight: bold;
 text-decoration: underline;
 outline: .5px solid #999999;
 border-radius:3px;
}
a:hover {
font-weight: bold;
text-decoration: underline;
}
#page .skip-link:focus {
 z-index: 9999;
 font-weight: bold;
 color: #CF202e;
 outline: .5px solid #999999;
 border-radius:3px;
 text-decoration: underline;
 padding: 5px 10px;
 margin:2px;
}  .elementor-share-btn__text {
 overflow: auto !important;
}
.elementor-share-btn__title{
 overflow: auto !important;
}
 ul.elementor-icon-list-items {
 list-style: none !important;
}  /*Responsive Menu Pro*/
.rmp-menu-subarrow {
.rmp-menu-subarrow {
 height: auto !important;
}
.rmp-menu-item-link {
 height: auto !important;
}
button.rmp_menu_trigger  {
 overflow: auto !important;
}
#rmp-menu-wrap-3204 .rmp-menu-item-link {
 padding-right: 1em;
}
#rmp-menu-title-3204 {
 font-size: 1em;
} 
/* Lock the responsive menu toggle/header bar to the true top */
.rmp-container, #responsive-menu-container {
 top: 0 !important;
 transform: none !important;
}
/*Gravity Form*/
.gform-theme.gform-theme--framework.gform_wrapper .button:where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)), .gform-theme.gform-theme--framework.gform_wrapper .gform-theme-button:where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)), .gform-theme.gform-theme--framework.gform_wrapper :where(:not(.mce-splitbtn))>button:not([id*=mceu_]):not(.mce-open):where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)), .gform-theme.gform-theme--framework.gform_wrapper button.button:where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)), .gform-theme.gform-theme--framework.gform_wrapper input:is([type=submit],[type=button],[type=reset]).button:where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)), .gform-theme.gform-theme--framework.gform_wrapper input:is([type=submit],[type=button],[type=reset]):where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)), .gform-theme.gform-theme--framework.gform_wrapper input[type=submit].button.gform_button:where(:not(.gform-theme-no-framework):not(.gform-theme__disable):not(.gform-theme__disable *):not(.gform-theme__disable-framework):not(.gform-theme__disable-framework *)) {
 --gf-local-bg-color: #cf202e;
}
.gform_wrapper .ginput_complex label {
 font-size: var(--the7-text-small-font-size);
 color: #000000;
}
.gform_wrapper .gfield_required {
 font-weight: bold;
}
.gform_legacy_markup_wrapper .gform_fileupload_multifile .gform_drop_area {
 color: #000000 !important;
}  /* Highlight text inputs and textarea on focus */
body .gform_wrapper .gform_body input[type=text]:focus,
body .gform_wrapper .gform_body input[type=email]:focus,
body .gform_wrapper .gform_body textarea:focus {
 outline: 2px solid #0073aa; /* Change color here */
 background-color: #f5f5ff !important; /* Optional: light background */
}
/* Highlight select dropdowns on focus */
body .gform_wrapper .gform_body select:focus {
 outline: 2px solid #0073aa;
}
/* Inject into the root component container of Gravity Forms 3.1.1 */
:root, 
.gform-theme--framework.gform-theme--orbital, 
.gform-theme--framework[class*="gform-theme"] {
 --gf-icon-font-size: 25px !important;
 --gf-ctrl-btn-size: 30px !important;
}
/* Hard-override the inner glyph elements and balance the alignment */
.gform-theme--framework.gform-theme--orbital .gfield_input_datepicker_icon_container button,
.gform-theme--framework.gform-theme--orbital button[class*="datepicker"] {
 --gf-ctrl-btn-icon-font-size: 28px !important;
 font-size: 25px !important;
 line-height: 1 !important; 
 /* Physical vertical adjustment properties */
 transform: translateY(-1px) !important;
 /* FIX: Stop the overlap by pulling it inside and constraining the box width */
 width: 32px !important; /* Slightly narrower than the height so it doesn't push right */
 position: relative !important;
 right: 22px !important; /* Safely nudges it away from the right border line */
}
/* Force the wrapper container to keep its spacing clean */
.gform-theme--framework.gform-theme--orbital .gfield_input_datepicker_icon_container {
 width: auto !important;
 margin-left: -5px !important; /* Pulls the icon spacing back toward the center */
}  /*Element451*/
