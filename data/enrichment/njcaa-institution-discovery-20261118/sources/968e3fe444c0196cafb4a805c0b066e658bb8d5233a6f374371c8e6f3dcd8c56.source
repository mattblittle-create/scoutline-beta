2c" data-element_type="section" data-e-type="section" id="contentum" data-settings="{&quot;stretch_section&quot;:&quot;section-stretched&quot;,&quot;background_background&quot;:&quot;classic&quot;}"><div class="elementor-container elementor-column-gap-default"><div class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-46b7aa4" data-id="46b7aa4" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><div class="elementor-element elementor-element-7fbdfa5 elementor-widget elementor-widget-theme-page-title elementor-page-title elementor-widget-heading" data-id="7fbdfa5" data-element_type="widget" data-e-type="widget" data-widget_type="theme-page-title.default"><h1 class="elementor-heading-title elementor-size-default">North Central Missouri College</h1></div></div></div></div></section><section data-particle_enable="false" data-particle-mobile-disabled="false" class="elementor-section elementor-top-section elementor-element elementor-element-f30f350 elementor-section-stretched elementor-section-content-middle elementor-section-boxed elementor-section-height-default elementor-section-height-default" data-id="f30f350" data-element_type="section" data-e-type="section" data-settings="{&quot;stretch_section&quot;:&quot;section-stretched&quot;,&quot;background_background&quot;:&quot;classic&quot;}"><div class="elementor-container elementor-column-gap-default"><div class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-ad6b424" data-id="ad6b424" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><div class="elementor-element elementor-element-3d06d4a the7-inline-image-yes elementor-widget elementor-widget-image" data-id="3d06d4a" data-element_type="widget" data-e-type="widget" data-widget_type="image.default"> <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src="https://imagedelivery.net/cGuQTRvJtMHZSA3y0Q-yUQ/eb2315ea-ff55-4e76-f1ba-00eeeed63200/format=webp,quality=85,width=600" class="lazyload" decoding="async" title="" alt="Centennial logo" loading="lazy"><noscript><img decoding="async" src="https://imagedelivery.net/cGuQTRvJtMHZSA3y0Q-yUQ/eb2315ea-ff55-4e76-f1ba-00eeeed63200/format=webp,quality=85,width=600" title="" alt="Centennial logo" loading="lazy"></noscript></div><div class="elementor-element elementor-element-438b076 elementor-widget elementor-widget-text-editor" data-id="438b076" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><p>Since 1925, NCMC has continued to exemplify the values of higher education traditionally important to the citizens it serves and has been the home to many generations of students, faculty, staff, and alumni. Join us for our <a title="Centennial Celebration" href="https://www.ncmissouri.edu/centennial/#contentum">Centennial Celebration</a>.</p></div></div></div></div></section><section data-particle_enable="false" data-particle-mobile-disabled="false" class="elementor-section elementor-top-section elementor-element elementor-element-517ac90 elementor-section-stretched elementor-section-content-middle elementor-section-boxed elementor-section-height-default elementor-section-height-default" data-id="517ac90" data-element_type="section" data-e-type="section" data-settings="{&quot;stretch_section&quot;:&quot;section-stretched&quot;,&quot;background_background&quot;:&quot;classic&quot;}"><div class="elementor-container elementor-column-gap-default"><div class="elementor-column elementor-col-33 elementor-top-column elementor-element elementor-element-dc86cc3" data-id="dc86cc3" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><div class="elementor-element elementor-element-8964c80 elementor-hidden-mobile elementor-hidden-tablet elementor-widget elementor-widg