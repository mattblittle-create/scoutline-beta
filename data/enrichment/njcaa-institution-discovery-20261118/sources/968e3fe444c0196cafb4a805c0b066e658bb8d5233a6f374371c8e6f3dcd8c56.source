 flex-direction: row;
 overflow: hidden;
}
.rmp-submenu-animate-on {
 animation: none 100ms;
}
/**
 * WooCommerce Mini Cart Styles
 */
.rmp-woocommerce-mini-cart {
 display: inline-block;
 position: relative;
}
.rmp-woocommerce-mini-cart.rmp-woocommerce-mini-cart--header {
 margin-left: 10px;
}
.rmp-mini-cart-link svg {
 max-width: 30px;
 max-height: 30px;
}
.rmp-mini-cart-link {
 display: inline-flex;
 align-items: center;
 text-decoration: none;
 color: #ffffff;
 position: relative;
 transition: color 0.3s;
}
.rmp-mini-cart-link:hover {
 color: #ffffff;
}
.rmp-mini-cart-link .rmp-font-icon {
 font-size: 20px;
}
.rmp-mini-cart-link .rmp-mini-cart-custom-icon {
 height: 20px;
 width: auto;
 display: block;
}
.rmp-mini-cart-link .rmp-mini-cart-svg-icon {
 height: 20px;
 width: 20px;
 display: block;
}
.rmp-mini-cart-count {
 position: absolute;
 top: -5px;
 right: -5px;
 background: #000000;
 color: #ffffff;
 font-size: 10px;
 line-height: 1;
 padding: 2px 4px;
 border-radius: 50%;
}
.rmp-mini-cart-count.rmp-mini-cart-count--square {
 border-radius: 0;
}
.rmp-mini-cart-items {
 list-style: none;
 margin: 0;
 padding: 0;
}
.rmp-mini-cart-item {
 display: flex;
 align-items: flex-start;
 margin-bottom: 12px;
}
.rmp-mini-cart-item-thumbnail {
 margin-right: 10px;
}
.rmp-mini-cart-item-thumbnail img {
 width: 50px;
 height: auto;
 display: block;
}
.rmp-mini-cart-item-details {
 flex: 1;
 font-size: 13px;
 text-align: right;
}
.rmp-mini-cart-item-name {
 display: block;
 margin-bottom: 4px;
 font-weight: 600;
}
.rmp-mini-cart-item-price, .rmp-mini-cart-item-quantity {
 display: inline-block;
 margin-right: 6px;
 color: #666;
}
.rmp-mini-cart-item-remove {
 margin-left: 8px;
}
.rmp-mini-cart-item-remove .remove {
 text-decoration: none;
 font-size: 16px;
}
.rmp-mini-cart-total {
 margin-top: 20px;
 margin-bottom: 14px;
 text-align: right;
}
.rmp-mini-cart-total-label {
 display: block;
 font-size: 12px;
 color: #888;
}
.rmp-mini-cart-total-amount {
 display: block;
 font-size: 16px;
 font-weight: 600;
 color: #7b3cff;
}
/* Dropdown Styles */
.rmp-mini-cart-dropdown {
 display: none;
 position: absolute;
 top: 100%;
 right: 0;
 width: 300px;
 background: #ffffff;
 color: #000000;
 box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
 z-index: 1000;
 padding: 15px;
 border-radius: 4px;
 /* Ensure it doesn't go off screen on mobile */
}
.rmp-woocommerce-mini-cart:hover .rmp-mini-cart-dropdown {
 display: block;
}
@media screen and (max-width: 768px) {
 .rmp-mini-cart-dropdown {
 right: -50px;
 /* Adjust as needed */
 width: 280px;
 }
}
/* Drawer Styles */
.rmp-mini-cart-drawer {
 position: fixed;
 top: 0;
 right: 0;
 width: 350px;
 height: 100%;
 background: #ffffff;
 color: #000000;
 box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
 z-index: 999999;
 transform: translateX(100%);
 transition: transform 0.3s ease-in-out;
 display: flex;
 flex-direction: column;
 max-width: 100%;
}
.rmp-mini-cart-drawer.rmp-mini-cart-drawer-open {
 transform: translateX(0);
}
.rmp-mini-cart-drawer-header {
 padding: 15px;
 border-bottom: 1px solid rgba(0, 0, 0, 0.1);
 display: flex;
 justify-content: space-between;
 align-items: center;
}
.rmp-mini-cart-drawer-title {
 font-weight: bold;
 font-size: 18px;
}
.rmp-mini-cart-drawer-close {
 background: none;
 border: none;
 font-size: 24px;
 cursor: pointer;
 padding: 0;
 line-height: 1;
}
.rmp-mini-cart-drawer-content {
 padding: 15px;
 overflow-y: auto;
 flex: 1;
}
.rmp-mini-cart-overlay {
 position: fixed;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 background: rgba(0, 0, 0, 0.5);
 z-index: 999998;
 opacity: 0;
 visibility: hidden;
 transition: opacity 0.3s;
}
.rmp-mini-cart-overlay.rmp-mini-cart-overlay-open {
 opacity: 1;
 visibility: visible;
}
body.rmp-mini-cart-drawer-active {
 overflow: hidden;
}
.rmp-mini-cart-empty {
 text-align: center;
}
/* Custom Cart Buttons */
.rmp-cart-actions {
 display: flex;
 gap: 10px;
 margin-bottom: 0px;
}
.rmp-cart-actions a {
 flex: 1;
 text-align: center;
 padding: 10px;
 background: #333333 !important;
 color: #ffffff !important;
 text-decoration: none;
 border-radius: 4px;
 transition: all 0.2s;
}
.rmp-cart-actions a:hover {
 background: #555555 !important;
 color: #ffffff !important;
}
.rmp-cart-actions a.rmp-checkout-button {
 background: #d32f2f !important;
 color: #ffffff !important;
}
.rmp-cart-actions a.rmp-checkout-button:hover {
 background: #b71c1c !important;
 color: #ffffff !important;
}
/* Hide Desktop Cart on Mobile */
.rmp-woocommerce-mini-cart--desktop {
 display: none !important;
}
@media screen and (min-width: 8001px) {
 .rmp-woocommerce-mini-cart--desktop {
 display: inline-block !important;
 vertical-align: middle;
 line-height: 12px;
 }
}
/*  Menu Trigger Boring Animation */
.rmp-menu-trigger-boring .responsive-menu-pro-inner {
 transition-property: none;
}
.rmp-menu-trigger-boring .responsive-menu-pro-inner::after, .rmp-menu-trigger-boring .responsive-menu-pro-inner::before {
 transition-property: none;
}
.rmp-menu-trigger-boring.is-active .responsive-menu-pro-inner {
 transform: rotate(45deg);
}
.rmp-menu-trigger-boring.is-active .responsive-menu-pro-inner:before {
 top: 0;
 opacity: 0;
}
.rmp-menu-trigger-boring.is-active .responsive-menu-pro-inner:after {
 bottom: 0;
 transform: rotate(-90deg);
}
/*  Menu Trigger Spin Animation */
.rmp-menu-trigger-spin .responsive-menu-pro-inner {
 transition-duration: 0.3s;
 transition-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19);
}
.rmp-menu-trigger-spin .responsive-menu-pro-inner::before {
 transition: top 0.1s 0.34s ease-in, opacity 0.1s ease-in;
}
.rmp-menu-trigger-spin .responsive-menu-pro-inner::after {
 transition: bottom 0.1s 0.34s ease-in, transform 0.3s cubic-bezier(0.55, 0.055, 0.675, 0.19);
}
.rmp-menu-trigger-spin.is-active .responsive-menu-pro-inner {
 transform: rotate(225deg);
 transition-delay: 0.14s;
 transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
}
.rmp-menu-trigger-spin.is-active .responsive-menu-pro-inner::before {
 top: 0;
 opacity: 0;
 transition: top 0.1s ease-out, opacity 0.1s 0.14s ease-out;
}
.rmp-menu-trigger-spin.is-active .responsive-menu-pro-inner::after {
 bottom: 0;
 transform: rotate(-90deg);
 transition: bottom 0.1s ease-out, transform 0.3s 0.14s cubic-bezier(0.215, 0.61, 0.355, 1);
}
/*  Menu Trigger Spin Reverse Animation */
.rmp-menu-trigger-spin-r .responsive-menu-pro-inner {
