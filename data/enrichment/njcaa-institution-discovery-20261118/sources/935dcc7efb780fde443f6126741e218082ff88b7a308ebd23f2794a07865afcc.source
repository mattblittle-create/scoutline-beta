<script>
	function hideEmptyEventCarousels() {
		document.querySelectorAll('.CardCarousel').forEach(function (carousel) {
			const wrapper = carousel.querySelector('.swiper-wrapper');
			const section = carousel.closest('section.Section');

			if (wrapper && section && !wrapper.querySelector('.swiper-slide')) {
				section.style.display = 'none';
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', hideEmptyEventCarousels);
	} else {
		hideEmptyEventCarousels();
	}
</script>         <div id="ou-hidden" style="display:none;"><!-- com.omniupdate.ob --><a id="de" href="https://a.cms.omniupdate.com/11/?skin=cod&amp;account=main&amp;site=www-2025&amp;action=de&amp;path=/index.pcf" style="text-decoration:none;" >©</a><!-- /com.omniupdate.ob --></div><script>
