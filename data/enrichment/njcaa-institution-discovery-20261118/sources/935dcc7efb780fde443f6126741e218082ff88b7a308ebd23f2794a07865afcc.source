height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><!-- End Google Tag Manager (noscript) -->      <link rel="stylesheet" href="/_resources/css/transfers.css"><script type="text/javascript">const programs = [{"name": "Accountancy","description": "Learn accounting principles, bookkeeping, payroll, QuickBooks, tax prep, and auditing with COD's comprehensive accounting program.","url": "/academics/areas/accountancy/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-51-900x600.jpg", "alt": "student taking notes in class"}}, {"name": "American Sign Language Interpreting","description": "Learn ASL and interpreting at College of DuPage. Gain skills, cultural insight, and start your journey as an ASL interpreter.","url": "/academics/areas/american-sign-language-interpreting/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-33-900x600.jpg", "alt": "three students in class listening to lecture"}}, {"name": "Animation/Motion Graphics","description": "Starting with the basics of drawing and cartooning and continuing on to advanced techniques of 3-D computer modeling, compositing and animating, this degree is designed to prepare students interested in animation or motion graphics for gaming, film or TV.","url": "/academics/areas/mptv/animation.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-mptv-animation-student-drawing.jpg", "alt": "student drawing on an ipad"}}, {"name": "Anthropology","description": "Explore the cultural, physical and prehistorical aspects of human beings.","url": "/academics/areas/anthropology/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/campus-bic-exterior-walking-900x600.jpg", "alt": "students walking into campus"}}, {"name": "Application Technical Support Specialist","description": "The College of DuPage Application and Technical Support Specialist program prepares students for careers supporting computer users, business applications and technology environments.","url": "/academics/areas/cis/application-technical-support.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-21-900x600.jpg", "alt": "female student wearing headphones working on laptop"}}, {"name": "Arabic","description": "Explore the study of Arabic by learning how to speak, understand, read and write in the Arabic language.","url": "/academics/areas/languages/arabic.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Architectural Technology","description": "The Architecture program prepares students with creative, technical, and critical thinking skills for careers and advanced study in architecture and related fields.","url": "/academics/areas/architecture/architectural-technology.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-architectural-technology-classroom-drafting-computer-900x600.jpg", "alt": "student looking at an architectural draft"}}, {"name": "Art","description": "The Art program provides a foundation for students wishing to pursue a degree in visual arts.","url": "/academics/areas/art/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-art-drawing-2-900x600.jpg", "alt": "student drawing"}}, {"name": "Artificial Intelligence","description": "Artificial Intelligence (AI) is transforming nearly every industry. Students gain the knowledge and practical experience needed to understand how AI works, and how it can be applied to solve real-world challenges.","url": "/academics/areas/cis/artificial-intelligence.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-23-900x600.jpg", "alt": "student working on a laptop"}}, {"name": "Astronomy","description": "The Astronomy program provides students with the foundation and direction for a successful career in astronomy. Students can follow the Astronomy Transfer Pathway and earn an Associate in Science degree.","url": "/academics/areas/earth-science/astronomy.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-astronomy-900x600.jpg", "alt": "stars and planets in outer space"}}, {"name": "Automotive Service Technology","description": "The Automotive Service Technology program prepares students to diagnose, service, and repair today’s cars and light trucks.","url": "/academics/areas/automotive/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-automotive-student-car-900x600.jpg", "alt": "student working on a car"}}, {"name": "Aviation Management","description": "Take flight with COD's Aviation Management program—designed for those ready to pursue a career in aviation.","url": "/academics/areas/aviation/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-aviation-student-flying-900x600.jpg", "alt": "aviation student flying a plane"}}, {"name": "Baking and Pastry Arts","description": "Food artists can unleash their creativity through the Baking and Pastry Arts. This degree features courses that build on the foundations of basic baking and continue to the most advanced pastry techniques. Students work in a fully equipped commercial bake shop and learn from highly skilled instructors.","url": "/academics/areas/culinary/baking-pastry-arts/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person", "online"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/programs-baking-pastry-student-cake-900x600.jpg", "alt": "baking and pastry student decorating a cake"}}, {"name": "Biology","description": "Biology includes botany, optometry, and wildlife biology, integrating with physics and chemistry.","url": "/academics/areas/biology/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-biology-student-syringe-900x600.jpg", "alt": "Biology student working in a lab on a microscope"}}, {"name": "Business","description": "Learn the fundamentals of business through the Business Transfer Pathway, complete your general education requirements or take business classes in accounting, management and the global economy.","url": "/academics/areas/business/business.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-45-900x600.jpg", "alt": "student in class working on a laptop"}}, {"name": "Central Sterile Processing Distribution Technician","description": "This 12-credit certificate teaches you the essential knowledge, hands-on skills, and professional standards needed to work in sterile processing and hospital supply distribution.","url": "/academics/areas/central-processing-distribution/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-central-sterile-students-faculty-900x600.jpg", "alt": "students wearing blue protective gear working on equipment with faculty"}}, {"name": "Certified Nursing Assistant","description": "The Certified Nursing Assistant program prepares students for employment as entry-level certified nurse assistants (CNA) through a combination of classroom and clinical education.","url": "/academics/areas/cna/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-certified-nursing-assistant-900x600.jpg", "alt": "male and female students working together with a medical sling"}}, {"name": "Chemistry","description": "The Chemistry program offers courses for liberal arts, health science, engineering, and chemistry majors, including organic chemistry, and biochemistry.","url": "/academics/areas/chemistry/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-chemistry-student-lab-900x600.jpg", "alt": "chemistry student working in the lab"}}, {"name": "Chinese","description": "Dive into the language and culture of China by studying the Chinese language. Gain knowledge of Chinese culture and learn history, values, philosophical and religious beliefs and aesthetic traditions.","url": "/academics/areas/languages/chinese.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Clinical Laboratory Science","description": "College of DuPage offers a two-year Associate in Science degree transfer program in clinical laboratory science. After completing an Associate in Science degree at COD, you can then transfer to an affiliated institution as a junior to complete a Bachelor of Science degree.","url": "/academics/areas/clinical-laboratory-science/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-stock-clinical-lab-scientist-900x600.jpg", "alt": "female student looking through a microscope"}}, {"name": "Computed Tomography","description": "The Computed Tomography Certificate program is an advanced, 2-semester certificate program. Students must hold active national certification and registration from the American Registry of Radiologic Technologists (ARRT) in Radiography and maintain a current license in medical radiation technology from the Illinois Emergency Management Agency (IEMA), Department of Nuclear Safety.","url": "/academics/areas/computed-tomography/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-computed-tomography-student-computer-900x600.jpg", "alt": "man looking at compjuter monitors"}}, {"name": "Computer and Information Science","description": "The Computer and Information Science (CIS) program gives students a variety of options to prepare for a career in information technology (IT).","url": "/academics/areas/cis/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-23-900x600.jpg", "alt": "student working on a laptop"}}, {"name": "Computer and Information Technology","description": "The CIT program offers degrees and certificates to prepare students to transfer to a four-year college or pursue a career in computer systems and networking.","url": "/academics/areas/cit/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-6-900x600.jpg", "alt": "two students working on their computers"}}, {"name": "Construction Management","description": "The Construction Management program prepares students with hands-on and classroom learning in construction, design, and business.","url": "/academics/areas/architecture/construction-management.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-construction-management-site-visit-900x600.jpg", "alt": "construction management students visiting a construction site"}}, {"name": "Cosmetology","description": "The Cosmetology program provides professional level skills in the field of personal beauty. Gain knowledge and skills in a broad range of disciplines including aesthetics, business, chemical processes, hair design, nail technology, safety, salon operations and sanitation.","url": "/academics/areas/cosmetology/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-cosmetology-makeup-900x600.jpg", "alt": "student putting makeup on another student"}}, {"name": "Creative Writing","description": "Creative Writing at College of DuPage is a series of classes designed to help writers develop their creative range and hone their voice and technique. Creative Writing classes focus on the craft of writing, cover a diverse array of genres and explore a multitude of writing techniques.","url": "/academics/areas/english/creative-writing/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-55-900x600.jpg", "alt": "students listening to a lecture"}}, {"name": "Criminal and Justice Studies","description": "COD offers Criminal and Justice Studies programs in homeland security, and forensic investigation, plus options to transfer and explore current events.","url": "/academics/areas/justice-studies/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-justice-studies-student-investigation-900x600.jpg", "alt": "man taking a picture of an investigation"}}, {"name": "Culinary Arts","description": "If you have a passion for food, the Culinary Arts program is both exciting and challenging. Curriculum incorporates industry trends to provide students education and experience they need to be successful. The program averages 16 students per class, enabling one-on-one support and guidance.","url": "/academics/areas/culinary/culinary-arts/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/programs-culinary-student-cookie-900x600.jpg", "alt": "culinary student decorating a cookie"}}, {"name": "Culinology and Food Science","description": "Blending food science, food technology and the culinary arts, Culinology is an emerging discipline that prepares students for work in the research and development sector of the food industry. Research chefs and test kitchens rely on culinology in creating safer, more consistent food products.","url": "/academics/areas/culinary/culinology/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/programs-culinary-student-serve-chicken-900x600.jpg", "alt": "culinary student serving chicken"}}, {"name": "Cybersecurity and Defense","description": "The Center for Cyber Defense Education at COD fosters collaboration and innovation in security technologies, information security, and digital forensics.","url": "/academics/areas/cyber-defense/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-7-900x600.jpg", "alt": "female student on a laptop"}}, {"name": "Dance","description": "College of DuPage's Dance program encompasses a curriculum that stresses discipline, endurance and awareness of body mechanics creating a versatile, multi-faceted dancer.","url": "/academics/areas/dance/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-dance-spring-showcase-2019-900x600.jpg", "alt": "group of people dancing on stage"}}, {"name": "Data Analytics","description": "College of DuPage's Data Analytics programs provide hands-on experience with the tools and technologies employers use today, including Excel, Power BI, SQL, Tableau and Python.","url": "/academics/areas/cis/data-analytics.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-1-900x600.jpg", "alt": "male student working on a laptop"}}, {"name": "Dental Hygiene","description": "The Dental Hygiene program teaches students how to provide comprehensive oral health care services in a variety of clinical and professional settings from private practices, hospitals and health departments to colleges, dental-related businesses and health maintenance organizations.","url": "/academics/areas/dental/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-dental-hygiene-student-dummy-900x600.jpg", "alt": "dental hygiene student working with mannequin on xrays"}}, {"name": "Digital Broadcast Journalism","description": "The Motion Picture/Television program specializes in preparing students for employment and/or transfer in the field of broadcast journalism.","url": "/academics/areas/mptv/digital-broadcast-journalism.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-mptv-broadcasting-student-900x600.jpg", "alt": "student standing behind an anchor desk"}}, {"name": "Early Childhood Education and Care","description": "The ECEC program offers a combination of classroom instruction and supervised, hands-on experience that prepares students for direct entry into the field of Early Childhood Education and Care in positions such as child care director, assistant director, preschool teacher, child care teacher, infant-toddler caregiver, Head Start teacher, elementary or special education aide, and before or after school teacher.","url": "/academics/areas/early-childhood/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["education"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-47-900x600.jpg", "alt": "students in class"}}, {"name": "Economics","description": "When you study economics at College of DuPage, you will learn how to interpret data to make informed decisions, maximize profit, demonstrate growth in data and apply concepts to real life.","url": "/academics/areas/economics/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-22-900x600.jpg", "alt": "students in class"}}, {"name": "Electro-Mechanical Technology","description": "Study robotics and industrial automation at COD in the Electro-Mechanical Technology program. This high-quality program emphasizes hands-on learning and exposes students to the latest equipment in state-of-the-art facilities.","url": "/academics/areas/electro-mechanical/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-electro-mechanical-900x600.jpg", "alt": "students working on electronics equipment"}}, {"name": "Electronics Technology","description": "Step into the future, start your career or expand it by immersing yourself in COD’s Electronics Technology program. This inexpensive, high-quality program exposes students to innovative equipment in state-of-the-art facilities.","url": "/academics/areas/electronics-technology/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-electronics-technology-900x600.jpg", "alt": "student working with a screwdriver on an electrical box"}}, {"name": "Emergency Medical Technician","description": "College of DuPage offers an Emergency Medical Technician certificate program each semester. Students interested in completing this ten-credit-hour course are encouraged to enroll early as classes fill up quickly.","url": "/academics/areas/fire/emt/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-fire-science-student-equipment-900x600.jpg", "alt": "firefighter working with equipment "}}, {"name": "Engineering","description": "College of DuPage offers multiple Associate in Engineering Science (AES) degrees designed to be equivalent to the first two years at an engineering university. Students can pursue any field of engineering through coursework in civil, mechanical, electrical, and computer engineering.","url": "/academics/areas/engineering/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-25-900x600.jpg", "alt": "students in class"}}, {"name": "Eye Care Assistant","description": "Students earning the Eye Care Assistant Certificate program at College of DuPage will gain the skills for entry-level positions as ophthalmic and optometric assistants under the supervision of licensed eye care professionals.","url": "/academics/areas/eye-care-assistant/index.html","filters": {"program_type": ["certificate"],"program_format": ["hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-eye-care-assistant-stock-900x600.jpg", "alt": "eye care tech using a machine to check a woman's eyes"}}, {"name": "Fashion Studies","description": "The Fashion Studies program teaches creative design, merchandising, entrepreneurship, applying knowledge to the retail, wholesale and business sides of fashion.","url": "/academics/areas/fashion/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-fashion-studies-student-catwalk.jpg", "alt": "fashion student walking the runway during a fashion show"}}, {"name": "Film/Video","description": "Students who dream of working in movies should start with the Film/Video degree to prepare them to work on several types of single-camera production.","url": "/academics/areas/mptv/film.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-mptv-film-video-green-screen-900x600.jpg", "alt": "male student working with a camera"}}, {"name": "Film","description": "At College of DuPage, film students choose to study film analysis, film production or both through a series of cross-listed course offerings between the English and Motion Picture/Television departments.","url": "/academics/areas/english/film.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/campus-exterior-walking-20-900x600.jpg", "alt": "students walking into campus"}}, {"name": "Fire Science","description": "COD offers two-year degrees in Fire Science Technology and Emergency Medical Services, along with certificates for fire, EMTs and paramedics to advance careers.","url": "/academics/areas/fire/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-fire-science-student-equipment-900x600.jpg", "alt": "firefighter working with equipment"}}, {"name": "French","description": "The French program at College of DuPage provides you with a strong linguistic and cultural background, and prepares you to live and work in a multicultural world.","url": "/academics/areas/languages/french.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Game Development","description": "Turn your passion for gaming into a career with College of DuPage's Game Development degree and specialized certificates. Students can build skills in game design, programming, 3D modeling, animation and narrative design.","url": "/academics/areas/cis/game-development.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-11-900x600.jpg", "alt": "two students working on their computers"}}, {"name": "Geography","description": "With a focus on geography, you will gain knowledge beyond examining a map and learning about a state capital. You will explore the interactions between people and places that make our world and interesting and exciting place.","url": "/academics/areas/geography/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-5-900x600.jpg", "alt": "female student in class talking"}}, {"name": "Geology","description": "Geology is the study of Earth, its material composition and the processes that affect its surface and interior. To better understand how our planet evolved in the past and how it will change in the future, students in the Geology program examine the dynamic transformations our planet experiences today.","url": "/academics/areas/earth-science/geology.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-8-900x600.jpg", "alt": "students in class listening to a lecture"}}, {"name": "German","description": "More people speak German as their native language than any other language in Europe. 83 million inhabitants make it the most populous European nation.","url": "/academics/areas/languages/german.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Graphic Design","description": "The Graphic Design, Advertising, Web, and Illustration program is for high school grads, career changers, and those seeking to enhance their artistic skills.","url": "/academics/areas/graphic-design/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-graphic-design-3-900x600.jpg", "alt": "student drawing"}}, {"name": "Health Care Office Assistant","description": "Become a valued member of the health care team in two semesters or less with a short-term certificate as a health care office assistant at College of DuPage.","url": "/academics/areas/health-care-office/index.html","filters": {"program_type": ["certificate"],"program_format": ["online"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-health-care-office-assistant-900x600.jpg", "alt": "female medical worker at computer"}}, {"name": "Healthcare Management","description": "The ADN program at College of DuPage prepares students for nursing careers in various healthcare settings, with a two-year curriculum and transfer opportunities.","url": "/academics/areas/healthcare-management/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/stock-healthcare-management-900x600.jpg", "alt": "healthcare team talking around a laptop"}}, {"name": "Hearing Instrument Dispensing","description": "The Hearing Instrument Dispensary program prepares students for a career as a hearing health care provider and hearing instrument specialist.","url": "/academics/areas/hearing-instrument-dispensing/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-hearing-instrument-dispensary-900x600.jpg", "alt": "woman wearing headphones taking a hearing test from a female technician"}}, {"name": "Heating, Ventilation, Air Conditioning and Refrigeration","description": "The Heating, Ventilation, Air Conditioning and Refrigeration (HVACR) program at College of DuPage provides both a general technical background in HVACR and also allows for specialization in many areas of the industry.","url": "/academics/areas/hvacr/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-hvacr-lab-2-900x600.jpg", "alt": "student working with hvacr equipment"}}, {"name": "History","description": "History courses at COD help students understand global changes and their role in the world, forming a vital foundation for any college education and future.","url": "/academics/areas/history/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-52-900x600.jpg", "alt": "students in class listening to a lecture"}}, {"name": "Horticulture","description": "The Horticulture program provides fundamental and advanced education and practice to prepare graduates for successful entry into the workforce. Students develop knowledge and skills in a range of topics including horticulture and horticulture business, horticultural mathematics, landscaping and landscaping design, floral design, plant propagation, plant taxonomy, soils and fertilizers and sustainable urban agriculture.","url": "/academics/areas/horticulture/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-horticulture-small-engine-2-900x600.jpg", "alt": "horticulture students working with faculty on a machine"}}, {"name": "Hospitality Management","description": "Start your career in the hospitality industry and work in restaurants, hotels, resorts, bed and breakfasts, time shares, condos, retirement communities, convention and visitor bureaus, destination marketing organizations, and event planning companies. If you are friendly and energetic, creative, self-motivated, a problem solver and a hands-on participant, then you may be right for a career within this industry.","url": "/academics/areas/hospitality-management-tourism/hospitality-management.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-8-900x600.jpg", "alt": "students in class at their desks"}}, {"name": "Human Services","description": "The Human Services program offers hands-on training for students eager to help others in areas like addictions, aging, corrections, and family support.","url": "/academics/areas/human-services/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-group-study-4-900x600.jpg", "alt": "three students at a roundtable talking"}}, {"name": "Humanities","description": "The Humanities program teaches students a better understanding of people's expressions, ideas and cultures. Courses are designed to teach students various viewpoints regarding the human condition from different perspectives of disciplines.","url": "/academics/areas/humanities/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-library-15-900x600.jpg", "alt": "female student smiling while working on her laptop"}}, {"name": "Hydrology","description": "Hydrology is the study of water on Earth. This discipline of the Earth Sciences focuses on the hydrologic cycle, watersheds, stream flow, flooding, and groundwater. Students of hydrology investigate the impacts of population growth, urbanization, weather, and climate upon these dynamic hydrologic processes and upon water resource sustainability.","url": "/academics/areas/earth-science/hydrology.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-hydrology-stock-woman-test-tube-water-900x600.jpg", "alt": "female student examining water in a test tube"}}, {"name": "Integrated Engineering Technology","description": "Integrated Engineering Technology (InET) is a multi-disciplinary program designed to meet the needs of manufacturing, electro-mechanics and electronics industries.","url": "/academics/areas/integrated-engineering/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/campus-exterior-walking-21-900x600.jpg", "alt": "students walking into campus"}}, {"name": "Interior Design","description": "Interior Design at College of DuPage offers students a variety of learning opportunities that match current industry trends and standards.","url": "/academics/areas/interior-design/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-32-900x600.jpg", "alt": "student on her laptop"}}, {"name": "Italian","description": "COD offers Italian courses in a variety of formats to meet the needs of its diverse student population. It also offers the opportunity to live and study abroad in Siena, Italy.","url": "/academics/areas/languages/italian.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Japanese","description": "Experience Japanese culture by learning the language. Communicate, read non-verbal cues, and develop awareness of yourself and others.","url": "/academics/areas/languages/japanese.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Korean","description": "COD offers Korean courses in the traditional format where classes meet weekly and student have the opportunity to interact with an instructor and their peers.","url": "/academics/areas/languages/korean.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Legal Studies","description": "The Legal Studies program at College of DuPage (formerly Paralegal Studies) provides students with the knowledge, training, skills, values and attitude they need to become highly competent, ethical paralegals who will make a positive contribution to the advancement of the paralegal profession.","url": "/academics/areas/legal-studies/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-1-900x600.jpg", "alt": "students in class at their desks"}}, {"name": "Library and Information Technology","description": "The Library and Information Technology program at College of DuPage provides fundamental and advanced education and practice that will enable you to enter the workforce as library technical assistants.","url": "/academics/areas/library-technology/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-library-2-900x600.jpg", "alt": "students working in the library"}}, {"name": "Literature","description": "Literature at College of DuPage is a series of classes that explore literary texts from a broad range of cultures, geographies and time periods.","url": "/academics/areas/english/literature.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/campus-exterior-walking-20-900x600.jpg", "alt": "students walking into campus"}}, {"name": "Long-Term Care Administration","description": "The Long-Term Care Administration program at College of DuPage prepares students for administrative responsibilities in a variety of long-term care settings: nursing homes, assisted living facilities, home health services, and other organizations serving the elderly and disabled.","url": "/academics/areas/long-term-care/index.html","filters": {"program_type": ["certificate"],"program_format": ["online"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-long-term-care-900x600.jpg", "alt": "older woman in wheel chair with female medical assistant"}}, {"name": "Magnetic Resonance Imaging (MRI) Technology","description": "The Magnetic Resonance Imaging (MRI) program at College of DuPage provides students with educational experiences and practical skills required to function as a successful MRI technologist.","url": "/academics/areas/mri/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-mri-900x600.jpg", "alt": "female medical worker at a computer looking at medical images"}}, {"name": "Mammography","description": "The Mammography program is a one-semester, seven-credit post-radiography advanced certificate program. The program has limited enrollment and is offered once a year during the fall semester, with a summer application deadline.","url": "/academics/areas/mammography/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-mammography-900x600.jpg", "alt": "female medical worker at a mammography console"}}, {"name": "Management","description": "Become a manager or supervisor in small to medium-sized businesses or start your own business through the Management program.","url": "/academics/areas/business/management.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-15-900x600.jpg", "alt": "female student in class listening to lecture"}}, {"name": "Manufacturing Technology","description": "The Manufacturing Technology program emphasizes basic engineering principles, technical skills, and identifying and resolving production problems in product manufacturing.","url": "/academics/areas/manufacturing/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/manufacturing-lab-tec-interior-900x600-center-center.jpg", "alt": "students working in the manufacturing lab"}}, {"name": "Marketing","description": "College of DuPage offers a Marketing, Associate in Applied Science degree and several certificates in marketing, consumer marketing and digital and social media.","url": "/academics/areas/business/marketing.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-8-900x600.jpg", "alt": "students in class"}}, {"name": "Mass Communication","description": "Mass communication courses teach students topics including the use of mass media in society, news reporting, writing and introduction to broadcasting.","url": "/academics/areas/mass-communication/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-5-900x600.jpg", "alt": "student talking in class"}}, {"name": "Mathematics","description": "From algebra to engineering, College of DuPage offers a wide range of math courses to support your academic and career goals.","url": "/academics/areas/math/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-8-900x600.jpg", "alt": "students in class at their desks"}}, {"name": "Medical Assistant","description": "The Medical Assistant program offers a certificate or degree, preparing students for administrative and clinical roles with experience in medical offices.","url": "/academics/areas/medical-assistant/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-medical-assistant-900x600.jpg", "alt": "female medical assistant weighing a female patient"}}, {"name": "Medical Billing","description": "The Medical Billing certificate equips students with skills in billing processes, claims, and appeals, preparing them for the exam and a career in the field.","url": "/academics/areas/medical-billing/index.html","filters": {"program_type": ["certificate"],"program_format": ["online", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-medical-billing-900x600.jpg", "alt": "health insurance form with pen, calculator and glasses in frame"}}, {"name": "Meeting and Events Planning","description": "The Meeting and Events Planning Associate in Applied Science degree is designed for students interested in pursuing a career in the Meetings, Expositions, Events and Conventions (MEEC) industry.","url": "/academics/areas/hospitality-management-tourism/meeting-event-planning.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-8-900x600.jpg", "alt": "students in class at their desks"}}, {"name": "Meteorology","description": "The College of DuPage experience is nothing like any other meteorology program in the nation. Here you can begin learning real meteorology right away and have more courses to choose from than anywhere else. Whether you are interested in forecasting, severe weather or more traditional atmospheric sciences, COD will allow students of all ages a chance to delve into how the atmosphere works from the start of their academic career.","url": "/academics/areas/earth-science/meteorology.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-meteorology-staff-computer-900x600.jpg", "alt": "meteorology faculty member pointing to a map"}}, {"name": "Music","description": "The Music program offers opportunities for students to study music appreciation, theory, literature, world and American music, business and digital recording.","url": "/academics/areas/music/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-music-student-trombone-900x600.jpg", "alt": "student playing an instrument"}}, {"name": "Non-Invasive Electrocardiography (EKG)","description": "The Non-Invasive Electrocardiography certificate program is an intensive three-semester curriculum with coursework in basic and advanced EKG.","url": "/academics/areas/ekg/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-non-invasive-ekg-900x600.jpg", "alt": "female attendant manning a workstation while a male subject runs on treadmill"}}, {"name": "Nuclear Medicine","description": "In Nuclear Medicine, students learn to produce high-quality diagnostic images, deliver patient care, administer radiopharmaceuticals, and analyze studies.","url": "/academics/areas/nuclear-medicine/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-nuclear-medicine-900x600.jpg", "alt": "patient getting a scan by a medical unit and attendant"}}, {"name": "Nursing","description": "The ADN program at College of DuPage prepares students for nursing careers in various healthcare settings, with a two-year curriculum and transfer opportunities.","url": "/academics/areas/nursing/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-nursing-faculty-3-900x600.jpg", "alt": "nursing student working with faculty member on a dummy"}}, {"name": "Oceanography","description": "Investigate and explore Earth’s final frontier through oceanography. Oceanography teaches students about the physical properties and phenomena of Earth's largest water reservoir.","url": "/academics/areas/earth-science/oceanography.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-meteorology-staff-computer-900x600.jpg", "alt": "faculty member pointing to a weather map"}}, {"name": "Office Technology Information","description": "The Office Technology Information (OFTI) program provides fundamental and advanced education and practice in a wide range of skills to prepare students for successful careers as administrative support professionals.","url": "/academics/areas/ofti/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-17-900x600.jpg", "alt": "students in class"}}, {"name": "Ophthalmic Technician","description": "The certified Ophthalmic Technician program is intended for students who want to advance their career in the field of eye care in 19 specific content areas. Emphasis is placed on fundamental and advanced clinical procedures to assist optometrists and ophthalmologists in the acquisition, preparation and application of various types of equipment required for patient care.","url": "/academics/areas/ophthalmic-technician/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-ophthalmic-tech-stock-900x600.jpg", "alt": "technician checking a patient's eyes"}}, {"name": "Patient Care Technician","description": "Operating Room Patient Care Technician students will focus on the role of the operating room patient care technician team, scope of practice, and specific duties of the operating room patient care technician.","url": "/academics/areas/patient-care-technician/index.html","filters": {"program_type": ["certificate"],"program_format": ["hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-patient-care-900x600.jpg", "alt": "female medical working tending to a man in a hospital bed"}}, {"name": "Philosophy and Religious Studies","description": "Offerings in the Philosophy/Religious Studies program provide students with introductory and specialized courses that explore the development of humankind's ideas and value systems.","url": "/academics/areas/philosophy/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-49-900x600.jpg", "alt": "female student listening to a lecture while taking notes"}}, {"name": "Phlebotomy","description": "The Phlebotomy certificate program at COD is a two-semester course with classes in phlebotomy and EKG, followed by hands-on clinical experience.","url": "/academics/areas/phlebotomy/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-phlebotomy-student-classroom-900x600.jpg", "alt": "phlebotomy student practicing drawing blood in a classroom"}}, {"name": "Photography","description": "Photography students learn everything from basic skills and work flow to advanced digital imaging, printing and business practices and portfolio preparation. Photography faculty are all practicing professional photographers that share a real-world perspective with students.","url": "/academics/areas/photography/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-photography-student-900x600.jpg", "alt": "female photography student taking a photo"}}, {"name": "Physical Education, Fitness, and Sport Studies","description": "The Physical Education, Fitness, and Sports Studies program prepares you for careers in teaching, coaching, personal training, exercise science, and more.","url": "/academics/areas/physical-education/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["education"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-physical-education-fitness-center-900x600.jpg", "alt": "student working out in the fitness center"}}, {"name": "Physical Therapist Assistant","description": "Designed for students who plan to enter a professional practice, the Physical Therapist Assistant (PTA) program at College of DuPage teaches students how to relieve pain in patients and improve strength and mobility so they can reach their maximum physical potential while also learning to live within the limits of their disabilities.","url": "/academics/areas/physical-therapist/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-physical-therapy-students-volunteers-900x600.jpg", "alt": "student working with physical therapist volunteers"}}, {"name": "Physician Coding","description": "The Physician Coding certificate prepares students for a career as a medical coders. Interpret documentation and apply coding necessary for reimbursement.","url": "/academics/areas/physician-coding/index.html","filters": {"program_type": ["certificate"],"program_format": ["online", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-physician-coding-900x600.jpg", "alt": "female medical worker at computer"}}, {"name": "Physics","description": "College of DuPage provides physics instruction using the best in educational technology and research. Physics students study laws of motion, forces, energy and momentum and learn how physics work in society and in the modern era. Take physics courses at COD and easily transfer your credits to four-year schools in the region.","url": "/academics/areas/physics/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["stem"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-29-900x600.jpg", "alt": "student studying on a laptop"}}, {"name": "Political Science","description": "Federal, state and local governments employ almost 16 million people. A political science background is typical for positions such as administrative assistant, budget officer, immigration inspector or intelligence research specialist.","url": "/academics/areas/political-science/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-9-900x600.jpg", "alt": "female student working on laptop"}}, {"name": "Pre-Architecture","description": "The Pre-Architecture program focuses on the theory, history and principles of architecture.","url": "/academics/areas/architecture/pre-architecture.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "hybrid"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-prearchitecture-classroom-900x600.jpg", "alt": "students working on models in pre-architecture class"}}, {"name": "Psychology","description": "The Psychology program teaches students how to apply psychological principles to every day life through the study of human and animal behavior.","url": "/academics/areas/psychology/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/campus-exterior-walking-3-900x600.jpg", "alt": "students walking outside of campus"}}, {"name": "Radiation Therapy","description": "The Diagnostic Medical Imaging Radiation Therapy Technology program at College of DuPage is a one-year advanced certificate program available to graduates of an accredited Radiography or Nuclear Medicine program.","url": "/academics/areas/radiation-therapy/index.html","filters": {"program_type": ["certificate"],"program_format": ["online", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-radiation-therapy-900x600.jpg", "alt": "male attendant working a radiation machine with female laying on table"}}, {"name": "Radiography","description": "Students learn about human anatomy and patient positioning for the purpose of producing x-ray images of the human body.","url": "/academics/areas/radiography/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-radiography-900x600.jpg", "alt": "person in white coat holding an x-ray"}}, {"name": "Respiratory Care","description": "COD offers combined CRT and RRT education for Respiratory Care Practitioners in a full-time, two-year program leading to an Associate in Applied Science degree.","url": "/academics/areas/respiratory-care/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-respiratory-care-900x600.jpg", "alt": "female medical working tending to medical equipment"}}, {"name": "Restaurant Management","description": "The College of DuPage Restaurant Management program provides opportunities for students to learn necessary skills for a management career in the food and beverage industry. Learn business law, food and beverage management, supervision and customer service through a variety of hospitality courses.","url": "/academics/areas/hospitality-management-tourism/restaurant-management.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-restaurant-management-wait-staff-900x600.jpg", "alt": "waiter serving patrons"}}, {"name": "Russian","description": "COD offers Russian courses in the traditional format where classes meet weekly and student have the opportunity to interact with an instructor and their peers.","url": "/academics/areas/languages/russian.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Sociology","description": "Take a sociology course at COD or follow the Sociology Transfer Pathway to earn your Associate in Arts and transfer to a four-year university,","url": "/academics/areas/sociology/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["social-and-behavioral-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-14-900x600.jpg", "alt": "male students in class listening to lecture"}}, {"name": "Software Development","description": "Learn to design, build, test and maintain the software that powers today's technology. College of DuPage's Software Development program offers hands-on training with specialization options.","url": "/academics/areas/cis/software-development.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-25-900x600.jpg", "alt": "female student working on a laptop"}}, {"name": "Sonography","description": "The Sonography programs at COD are designed to prepare students for entry-level positions in sonography.","url": "/academics/areas/sonography/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-sonography-900x600.jpg", "alt": "female student working at a sonography console"}}, {"name": "Spanish","description": "COD offers Spanish courses in a variety of formats to meet the needs of its diverse student population. It also offers the opportunity to live and study abroad in Madrid, Spain or San Jose, Costa Rica.","url": "/academics/areas/languages/spanish.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-9-900x600.jpg", "alt": "group of students sitting outside on a laptop working on a project"}}, {"name": "Speech Communication","description": "A student of speech obtains a broad-based liberal arts education with the additional advantage of superior communication skills development, thus turning the student into a highly desirable employment candidate with a leg up on others.","url": "/academics/areas/speech-communication/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-outside-tables-2-900x600.jpg", "alt": "students sitting outside talking"}}, {"name": "Speech Language Pathology Assistant","description": "College of DuPage offers a Speech Language Pathologist Assistant, Associate in Applied Science degree, designed to be completed in two years.","url": "/academics/areas/slpa/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-slpa-900x600.jpg", "alt": "female speech therapist working with a young boy"}}, {"name": "Still Deciding/Undecided","description": "The Undecided Transfer Pathway is designed for students who plan to complete an Associate of Arts (A.A.) degree and transfer to a four-year institution but are still exploring their major.","url": "/academics/areas/still-deciding-undecided.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["still-deciding-undecided"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-22-900x600.jpg", "alt": "students in a classroom at their desks on computers"}}, {"name": "Surgical First Assistant","description": "The Surgical First Assistant program educates and trains students to safely and expeditiously assist in surgical operations. Students will gain experience with surgical procedure exposure, hemostasis, closure and other intraoperative surgical functions that help a surgeon carry out a safe surgical procedure.","url": "/academics/areas/surgical-assistant/index.html","filters": {"program_type": ["certificate"],"program_format": ["in-person", "online"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-surgical-first-assistant-900x600.jpg", "alt": "surgical assistant holding instruments"}}, {"name": "Surgical Technology","description": "Surgical technologists (ST's) are integral members of the surgical team who work closely with surgeons, anesthesiologists, registered nurses and other surgical personnel.","url": "/academics/areas/surgical-tech/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["health-sciences"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-surgical-tech-900x600.jpg", "alt": "surgery in progress with hands in rubber gloves and instruments"}}, {"name": "Teacher Preparation","description": "The Teacher Preparation program at College of DuPage meets the needs of students planning to teach in elementary, secondary or special education settings.","url": "/academics/areas/teacher-prep/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["education"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-interaction-library-2-900x600.jpg", "alt": "two female students interacting in library while also on computers"}}, {"name": "Television Production","description": "The Television Production program is for students who want to work in a broadcast studio setting, creating exciting and informative talk shows, new magazine shows and TV news productions.","url": "/academics/areas/mptv/television.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-mptv-television-production-camera-student-900x600.jpg", "alt": "student standing in front of camera in control room"}}, {"name": "Theater","description": "Theater is for students planning to transfer, those seeking theater electives for general education, and community members interested in performances.","url": "/academics/areas/theater/index.html","filters": {"program_type": ["associate-degree"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["fine-and-applied-arts"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-theater-addams-family-900x600.jpg", "alt": "theater cast acting on stage"}}, {"name": "Travel and Tourism","description": "A career in travel means working for one of America's top employers today - worldwide career opportunities abound! Some of the many interesting careers available in this $580 billion industry, including working for an airline, cruise line, or for a tour operator, convention organization, hotel or resort.","url": "/academics/areas/hospitality-management-tourism/travel-tourism.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["culinary-and-hospitality"]},"image": {"src": "https://cod.edu/_resources/img/900x600/classroom-gen-ed-8-900x600.jpg", "alt": "students in a classroom"}}, {"name": "Web Development","description": "Turn your ideas into interactive websites and web applications. College of DuPage's Web Development AAS program prepares students with the programming and technology skills used to build today's web.","url": "/academics/areas/cis/web-development.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["business-and-information-technology"]},"image": {"src": "https://cod.edu/_resources/img/900x600/student-experience-study-laptop-14-900x600.jpg", "alt": "female student working on a laptop"}}, {"name": "Welding Technology","description": "At College of DuPage, the Welding program is designed for people interested in learning welding or upgrading their skills in the various processes.","url": "/academics/areas/welding/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online"],"program_area": ["career-and-technical"]},"image": {"src": "https://cod.edu/_resources/img/900x600/program-welding-students-lab-900x600.jpg", "alt": "students welding"}}, {"name": "Writing Studies ","description": "Writing Studies is a multifaceted program that prepares you for academic, public, and professional writing. Courses range from workplace writing, technical writing, and digital writing, to the advanced study of writing, such as professional writing and community writing, professional editing and writing center theory, and argumentative writing and advanced composition.","url": "/academics/areas/english/writing-studies/index.html","filters": {"program_type": ["associate-degree", "certificate"],"program_format": ["in-person", "online", "hybrid"],"program_area": ["liberal-arts-and-communication"]},"image": {"src": "https://cod.edu/_resources/img/900x600/campus-exterior-walking-20-900x600.jpg", "alt": "students walking outside"}}]</script><meta name="facebook-domain-verification" content="d6b9t5c02t9m0azrl3sb0kocb5re14">	
      
