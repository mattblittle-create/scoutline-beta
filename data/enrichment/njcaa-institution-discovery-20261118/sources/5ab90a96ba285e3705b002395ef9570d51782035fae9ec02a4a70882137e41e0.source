        <script type="text/javascript" src="https://surry.edu/assets/js/surry.js" defer></script>

                <script type="text/javascript" src="https://cdn.weglot.com/weglot.min.js"></script>
        <script>
            Weglot.initialize({
                api_key: 'wg_5c45202b97e5cd2d286f9e5c1efb07576',
                switchers: [
                    {
                        // Desktop: full language name, no flags (we use our own globe icon)
                        style: { full_name: true, with_name: true, is_dropdown: true, with_flags: false },
                        location: { target: '#weglot-switcher', sibling: null }
                    },
                    {
                        // Mobile: language code only (e.g. "EN"), no flags
                        style: { full_name: false, with_name: true, is_dropdown: true, with_flags: false },
                        location: { target: '#weglot-switcher-mobile', sibling: null }
                    }
                ]
            });

            Weglot.on('switchersReady', function () {
                var desktopTarget = document.getElementById('weglot-switcher');
                var mobileTarget  = document.getElementById('weglot-switcher-mobile');

                // Fallback: if Weglot ignored location.target and appended to <body>,
                // manually relocate orphaned switchers into their containers.
                var desktopHas = desktopTarget && desktopTarget.querySelector('.weglot-container');
                var mobileHas  = mobileTarget && mobileTarget.querySelector('.weglot-container');
                var orphans    = document.querySelectorAll('body > .weglot-container');

                orphans.forEach(function (orphan) {
                    if (!desktopHas && desktopTarget) {
                        desktopTarget.appendChild(orphan);
                        desktopHas = true;
                    } else if (!mobileHas && mobileTarget) {
                        mobileTarget.appendChild(orphan);
                        mobileHas = true;
                    }
                });

                // Prepend globe icon to desktop container
                if (desktopTarget && !desktopTarget.querySelector('.fa-globe')) {
                    var globe = document.createElement('span');
                    globe.className = 'fa-globe me-2';
                    desktopTarget.insertBefore(globe, desktopTarget.firstChild);
                }

                // Prepend globe icon to tablet switcher (768px–1199px)
                if (mobileTarget && !mobileTarget.querySelector('.fa-globe')) {
                    var mobileGlobe = document.createElement('span');
                    mobileGlobe.className = 'fa-globe me-2';
                    mobileTarget.insertBefore(mobileGlobe, mobileTarget.firstChild);
                }

                // Wire mobile globe trigger to open Weglot dropdown
                var mobileTrigger = document.getElementById('weglot-mobile-trigger');
                if (mobileTrigger && mobileTarget) {
                    mobileTrigger.addEventListener('click', function (e) {
                        e.preventDefault();
                        // Make the hidden mobile container visible as a dropdown
                        mobileTarget.classList.add('weglot-globe-active');
                        mobileTarget.style.display = 'flex';
                        var wgCurrent = mobileTarget.querySelector('.wgcurrent');
                        if (wgCurrent) wgCurrent.click();
                    });

                    // Close dropdown when clicking outside
                    document.addEventListener('click', function (e) {
                        if (!mobileTrigger.contains(e.target) && !mobileTarget.contains(e.target)) {
                            mobileTarget.classList.remove('weglot-globe-active');
                            mobileTarget.style.display = '';
                        }
                    });
                }

            });
        </script>

                
