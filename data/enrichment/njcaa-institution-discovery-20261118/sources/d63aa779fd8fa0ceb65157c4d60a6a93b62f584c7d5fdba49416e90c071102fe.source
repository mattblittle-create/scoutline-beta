<div class="news eds_subCollection_latestArticles eds_subCollection_news eds_news_BlogOne eds_template_List_Article_Homepage eds_styleSwitchCriteria_module-504">
<!--ArticleRepeat:Before:-->

<div class="article_rss_wrapper">
	<a class="article_rss" href="/Main/About-Parkland/Newsroom/Parkland-News/mid/1721/ctl/rss" target="_blank"><span></span>RSS</a>
</div>

<div class="edn__articleListWrapper edn_504_article_list_wrapper"><!--ArticleTemplate-->
<div class="article even item_0">
	
  	<div class="content">

  	
		<div class="in_article_image" >
			<div class="image_wrapper no_text">
				<a href="https://www.parkland.edu/Main/About-Parkland/Newsroom/Parkland-News/Parkland-College-Community-Education-Relaunches-CDL-Truck-Driver-Training-Program?ArtMID=1721&ArticleID=1408" target="_self">
					<img alt="Parkland College Community Education Relaunches CDL Truck Driver Training Program" src="/Portals/3/EasyDNNNews/1408/images/CDL-Relaunch-200-200-c-L-97.jpg" />
				</a>
			</div>
		</div>
		
  	<div class="article_content">
		<h3 class="title"><a href="https://www.parkland.edu/Main/About-Parkland/Newsroom/Parkland-News/Parkland-College-Community-Education-Relaunches-CDL-Truck-Driver-Training-Program?ArtMID=1721&ArticleID=1408" target="_self">Parkland College Community Education Relaunches CDL Truck Driver Training Program</a></h3>

			<div class="summary"><p>Parkland College will partner with Road Runner Driving School</p></div>
	    </div>
	</div>
</div>
<!--ArticleTemplate-->
<div class="article odd item_1">
	
  	<div class="content">

  	
