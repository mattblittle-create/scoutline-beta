</style>
<style id="tribe-overlay-card-style-inline-css">
:root{--overlay-card-overlay-bg-color:var(--color-blue-dark);--overlay-card-text-color:var(--color-white);--overlay-card-hover-text-color:var(--color-white);--overlay-card-transition:0.6s ease-in-out;--overlay-card-transition-slow:1s ease-in-out}.b-overlay-card{aspect-ratio:3/4;border-radius:var(--border-radius-s);display:flex;flex-direction:column;height:100%;overflow:hidden;position:relative;width:100%}.b-overlay-card:focus-within .b-overlay-card__media:after{opacity:0}.b-overlay-card:focus-within .b-overlay-card__overlay{height:100%}.b-overlay-card:focus-within .b-overlay-card__description{max-height:450px;opacity:1;transition:max-height var(--overlay-card-transition-slow),opacity var(--overlay-card-transition-slow)}.b-overlay-card:focus-within .b-overlay-card__cta-btn{background-color:var(--color-white)}.b-overlay-card:focus-within .b-overlay-card__title{background-size:100% var(--text-decoration-thickness);color:var(--overlay-card-hover-text-color)}.b-overlay-card:focus-within .b-overlay-card__description_inner{color:var(--overlay-card-hover-text-color)}.b-overlay-card:focus-visible{box-shadow:0 0 0 3px var(--focus-contrast-dark),0 0 0 5px var(--focus-contrast-light);outline:0}@media (hover:hover){.b-overlay-card:hover .b-overlay-card__media:after{opacity:0}.b-overlay-card:hover .b-overlay-card__overlay{height:100%}.b-overlay-card:hover .b-overlay-card__description{max-height:450px;opacity:1;transition:max-height var(--overlay-card-transition-slow),opacity var(--overlay-card-transition-slow)}.b-overlay-card:hover .b-overlay-card__cta-btn{background-color:var(--color-white)}.b-overlay-card:hover .b-overlay-card__title{background-size:100% var(--text-decoration-thickness);color:var(--overlay-card-hover-text-color)}.b-overlay-card:hover .b-overlay-card__description_inner{color:var(--overlay-card-hover-text-color)}}.b-overlay-card.active .b-overlay-card__media:after{opacity:0}.b-overlay-card.active .b-overlay-card__overlay{height:100%}.b-overlay-card.active .b-overlay-card__description{max-height:450px;opacity:1;transition:max-height var(--overlay-card-transition-slow),opacity var(--overlay-card-transition-slow)}.b-overlay-card.active .b-overlay-card__cta-btn{background-color:var(--color-white)}.b-overlay-card.active .b-overlay-card__title{background-size:100% var(--text-decoration-thickness);color:var(--overlay-card-hover-text-color)}.b-overlay-card.active .b-overlay-card__description_inner{color:var(--overlay-card-hover-text-color)}.b-overlay-card__media{height:100%;left:0;overflow:hidden;position:absolute;top:0;width:100%;z-index:1}.b-overlay-card__media img{display:block;height:100%;object-fit:cover;transition:var(--transition);width:100%}.b-overlay-card__media:after{background:linear-gradient(180deg,transparent 71.03%,rgba(0,0,0,.8) 87.48%);bottom:0;content:"";height:100%;left:0;position:absolute;transition:opacity var(--overlay-card-transition);width:100%;z-index:2}.b-overlay-card__content{bottom:0;display:flex;flex-direction:column;left:0;overflow-wrap:normal;padding:var(--spacer-40) calc(var(--spacer-30) + var(--spacer-20) + 27px) var(--spacer-40) var(--spacer-40);position:absolute;right:0;transition:padding var(--overlay-card-transition);word-break:normal;z-index:2}.b-overlay-card__title{font-family:var(--font-family-headings);font-size:var(--font-size-30);font-weight:var(--font-weight-semibold);font-weight:600;letter-spacing:0;margin-top:0;transition:var(--overlay-card-transition)}.b-overlay-card__description,.b-overlay-card__title{color:var(--overlay-card-text-color);line-height:1.4}.b-overlay-card__description{font-family:var(--font-family-body);font-family:var(--font-family-headings);font-size:var(--font-size-20);font-weight:var(--font-weight-medium);font-weight:var(--font-weight-regular);max-height:0;overflow:hidden;transition:max-height var(--overlay-card-transition)}.b-overlay-card__description *{color:var(--overlay-card-text-color)}.b-overlay-card__description_inner{padding-block:var(--spacer-10);transition:color var(--overlay-card-transition)}.b-overlay-card__cta{bottom:calc(var(--spacer-40) + 2px);position:absolute;right:var(--spacer-30);z-index:2}.b-overlay-card__cta-btn{align-items:center;background-color:var(--color-green);border-radius:50%;display:flex;height:27px;justify-content:center;width:27px}.b-overlay-card__cta-btn,.b-overlay-card__cta-btn:before{transition:background-color var(--overlay-card-transition)}.b-overlay-card__cta-btn:before{background-color:var(--color-black);content:"";display:block;height:14px;-webkit-mask:var(--icon-chevron-right) center no-repeat;mask:var(--icon-chevron-right) center no-repeat;-webkit-mask-size:contain;mask-size:contain;width:14px}.b-overlay-card__overlay{background-color:var(--overlay-card-overlay-bg-color);bottom:0;height:0;left:0;position:absolute;transition:height var(--overlay-card-transition);width:100%;z-index:1}.b-overlay-card__link-overlay{display:block;font-size:0;height:100%;left:0;position:absolute;top:0;width:100%;z-index:2}.b-overlay-card:has(:is(.b-overlay-card__link-overlay):focus-visible) .b-overlay-card__cta-btn{outline:1px solid #fff;outline-offset:1px;transition:none}.b-overlay-card.is-card-theme--dark-blue{--overlay-card-overlay-bg-color:var(--color-blue-dark)}.b-overlay-card.is-card-theme--navy{--overlay-card-overlay-bg-color:var(--color-black)}.b-overlay-card.is-card-theme--green{--overlay-card-overlay-bg-color:var(--color-green);--overlay-card-hover-text-color:var(--color-black)}.b-overlay-card.is-card-theme--blue-x-light{--overlay-card-overlay-bg-color:var(--color-blue-x-light);--overlay-card-hover-text-color:var(--color-black)}

