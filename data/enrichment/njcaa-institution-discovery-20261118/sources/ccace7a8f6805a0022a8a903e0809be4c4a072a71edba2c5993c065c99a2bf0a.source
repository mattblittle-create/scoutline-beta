<section class="wp-block-group p-stats alignfull is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained" style="margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)">
<div class="wp-block-group is-animated-on-scroll-25 tribe-animation-type-fade-in tribe-animation-direction-bottom aligngrid is-layout-flow wp-block-group-is-layout-flow" style="margin-top:0;margin-bottom:var(--wp--preset--spacing--50);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;--tribe-animation-speed:0.6s;--tribe-animation-offset:50px;--tribe-animation-delay:0s;--tribe-animation-easing:var(--easing--ease-out-sine)">
<h2 class="wp-block-heading has-text-align-center is-style-default has-balanced-text" style="margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0">Making an&nbsp;<span class="has-heading-highlight">impact</span></h2>



<p class="has-text-align-center is-style-large is-style-large--42 wp-block-paragraph" style="margin-top:var(--wp--preset--spacing--20);margin-bottom:0">We focus on having a positive impact on our students’ lives.<br>In turn, our graduates positively impact the community.</p>
</div>



<div class="wp-block-group aligngrid is-layout-grid wp-container-core-group-is-layout-16fe9c0a wp-block-group-is-layout-grid">
<div class="wp-block-group is-animated-on-scroll-25 tribe-animation-type-fade-in tribe-animation-direction-bottom has-global-padding is-layout-constrained wp-container-core-group-is-layout-0a9160c1 wp-block-group-is-layout-constrained" style="padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);--tribe-animation-speed:0.6s;--tribe-animation-offset:50px;--tribe-animation-delay:0s;--tribe-animation-easing:var(--easing--ease-out-sine)">
<h3 class="wp-block-heading has-text-align-center is-style-xx-large is-style-x-large has-dark-blue-color has-text-color has-link-color wp-elements-7 is-style-x-large--43" style="margin-top:0">10,131</h3>



<p class="has-text-align-center is-style-overline has-balanced-text is-style-overline--44 wp-block-paragraph" style="margin-top:0;margin-bottom:0"><strong>students enrolled in 2025-26</strong></p>
