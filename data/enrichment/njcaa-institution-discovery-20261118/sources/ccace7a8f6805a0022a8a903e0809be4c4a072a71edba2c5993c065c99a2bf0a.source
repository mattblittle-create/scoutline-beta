<style id="wp-block-cover-inline-css">
.wp-block-cover{overflow:hidden;position:relative}.wp-block-cover .wp-block-cover__static-image{height:100%;left:0;object-fit:cover;object-position:center;opacity:0;pointer-events:none;position:absolute;top:0;transition:opacity .5s ease-in-out;width:100%;z-index:3}.wp-block-cover.is-viewport-height{height:var(--cover-viewport-height,auto);min-height:0!important}.wp-block-cover.has-delayed-video .wp-block-cover__static-image{opacity:1;pointer-events:auto}.wp-block-cover.has-delayed-video.video-loaded .wp-block-cover__static-image{opacity:0;pointer-events:none}.wp-block-cover.has-delayed-video:not(.video-loaded) .wp-block-cover__video-control{display:none}@media (max-width:600px){.wp-block-cover:has(.wp-block-cover__static-image) .wp-block-cover__embed-background,.wp-block-cover:has(.wp-block-cover__static-image) video{display:none}.wp-block-cover:has(.wp-block-cover__static-image) .wp-block-cover__static-image{opacity:1!important;pointer-events:auto}.wp-block-cover:has(.wp-block-cover__static-image) .wp-block-cover__video-control{display:none}}.wp-block-cover video{position:relative;z-index:0}:is(.wp-block-cover video)+.wp-block-cover__background{z-index:3}.wp-block-cover .wp-block-cover__embed-background{z-index:0}:is(.wp-block-cover .wp-block-cover__embed-background)+.wp-block-cover__background{z-index:3}:is(.wp-block-cover .wp-block-cover__embed-background) iframe:not(.components-sandbox){max-height:none;max-width:none;transform:scale(1.2)}.wp-block-cover .wp-block-cover__inner-container{position:relative;z-index:5}.wp-block-cover .wp-block-cover__video-control{align-items:center;background:none;border:0;bottom:27px;color:var(--color-white);cursor:pointer;display:flex;height:40px;justify-content:center;padding:0;position:absolute;right:var(--wp--style--root--padding-left);transition:var(--transition);width:40px;z-index:4}@media (min-width:1260px){.wp-block-cover .wp-block-cover__video-control{bottom:80px;height:48px;right:48px;width:48px}}:is(.wp-block-cover .wp-block-cover__video-control):hover{color:var(--color-yellow)}:is(.wp-block-cover .wp-block-cover__video-control) svg{height:auto;width:100%}:is(.wp-block-cover .wp-block-cover__video-control) .play-icon{display:none}.is-paused:is(.wp-block-cover .wp-block-cover__video-control) .pause-icon{display:none}.is-paused:is(.wp-block-cover .wp-block-cover__video-control) .play-icon{display:block}

