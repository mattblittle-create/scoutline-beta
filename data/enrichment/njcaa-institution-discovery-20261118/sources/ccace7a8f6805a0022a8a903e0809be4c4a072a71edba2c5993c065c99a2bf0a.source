<style id="tribe-masthead-search-style-inline-css">
.masthead-search__icon,.masthead-search__overlay-form-submit{align-items:center;background-color:initial;border:0;border-radius:0;cursor:pointer;display:flex;justify-content:center;padding:0;transition:var(--transition)}.masthead-search__icon{color:var(--masthead-navigation-text-color);height:32px;width:32px}@media (max-width:1259px){.masthead-search__icon{height:20px;width:20px}.mobile-menu-shown .masthead-search__icon{display:none}}.masthead-search__icon:focus-visible,.masthead-search__icon:hover{color:var(--masthead-navigation-accent-color)}.masthead-search__overlay-form-submit{color:var(--color-black);height:32px;width:30px}.masthead-search__overlay-form-submit:focus-visible,.masthead-search__overlay-form-submit:hover{color:var(--masthead-navigation-accent-color)}.masthead-search__close{align-items:center;align-self:flex-end;background:none;border:0;color:var(--color-black);cursor:pointer;display:none;gap:8px;justify-content:flex-end;margin-bottom:var(--spacer-60);padding:0}.masthead-search__close:focus-visible{box-shadow:0 0 0 3px var(--focus-contrast-dark),0 0 0 5px var(--focus-contrast-light);outline:0}@media (max-width:1259px){.mobile-search-shown .masthead-search__close{display:flex}}.masthead-search__overlay{background:var(--color-white);display:none;padding:var(--spacer-20) 0}@media (min-width:1260px){.masthead-search__overlay{box-shadow:var(--masthead-navigation-shadow);left:0;padding:var(--spacer-60) var(--wp--style--root--padding-left);position:absolute;top:100%;visibility:hidden;width:100%;z-index:-1}.active .masthead-search__overlay{display:flex;visibility:visible;z-index:10}}@media (max-width:1259px){.mobile-search-shown .masthead-search__overlay{display:flex;flex-direction:column;height:100dvh;left:0;overflow-y:auto;padding:var(--spacer-30) var(--spacer-30) var(--spacer-40);position:fixed;top:0;width:100%;z-index:20}.logged-in :is(.mobile-search-shown .masthead-search__overlay){top:var(--spacer-wpadmin)}@media (max-width:600px){.logged-in :is(.mobile-search-shown .masthead-search__overlay){top:var(--admin-bar-scroll-offset,0)}}}.masthead-search__overlay-form{display:grid;grid-template-columns:1fr auto;margin:0 auto;max-width:var(--grid-wide-width);width:100%;grid-gap:var(--spacer-20);border:1px solid var(--color-black);border-radius:2px;padding:var(--spacer-20)}@media (max-width:1259px){.mobile-search-shown .masthead-search__overlay-form{align-self:flex-start;margin:0 auto}}.masthead-search__overlay-form-input{background-color:initial;border:0}.masthead-search__overlay-form-input::-moz-placeholder{color:var(--color-neutral-70)}.masthead-search__overlay-form-input::placeholder{color:var(--color-neutral-70)}.masthead-search__overlay-form-input:focus-visible{outline:0}#masthead-search-input,.masthead-search__close-label{font-family:var(--font-family-headings)}.masthead-search__close-label{font-size:var(--font-size-30);font-weight:500}.masthead-search__close-icon{display:block;height:22px;position:relative;width:22px}.masthead-search__close-bar{background-color:currentcolor;border-radius:2px;display:block;height:2px;left:0;position:absolute;top:calc(50% - 1px);width:100%}.masthead-search__close-bar:first-child{transform:rotate(-45deg)}.masthead-search__close-bar:nth-child(2){transform:rotate(45deg)}

/*# sourceURL=https://clevelandcc.edu/wp-content/themes/core/dist/blocks/tribe/masthead-search/style-index.css */
</style>
<style id="tribe-menu-toggle-style-inline-css">
.c-menu-toggle{display:block}@media (min-width:1260px){.c-menu-toggle{display:none}}.c-menu-toggle__toggle{align-items:center;background-color:initial;border:0;border-radius:0;cursor:pointer;display:flex;height:32px;justify-content:center;padding:0;width:32px}.mobile-menu-shown .c-menu-toggle__toggle{width:auto}.c-menu-toggle__toggle:focus-visible{box-shadow:0 0 0 3px var(--focus-contrast-dark),0 0 0 5px var(--focus-contrast-light);outline:0}.c-menu-toggle__close-label{color:var(--masthead-navigation-text-color);display:none;font-size:var(--font-size-30);font-weight:500;margin-right:var(--spacer-10)}.mobile-menu-shown .c-menu-toggle__close-label{display:block}.c-menu-toggle__inner{display:block;height:16px;position:relative;width:24px}.c-menu-toggle__bar{background-color:var(--masthead-navigation-text-color);border-radius:2px;display:block;height:1px;position:absolute;right:0;transition:var(--transition)}.c-menu-toggle__bar:first-child{top:-1px;width:100%}.c-menu-toggle__bar:nth-child(2){top:7px;width:58%}.c-menu-toggle__bar:nth-child(3){top:15px;width:79%}.mobile-menu-shown .c-menu-toggle__bar{right:0;top:calc(50% - 1px)!important;width:100%!important}:is(.mobile-menu-shown .c-menu-toggle__bar):first-child{transform:rotate(-45deg)}:is(.mobile-menu-shown .c-menu-toggle__bar):nth-child(2){transform:scale(0)}:is(.mobile-menu-shown .c-menu-toggle__bar):nth-child(3){transform:rotate(45deg)}

/*# sourceURL=https://clevelandcc.edu/wp-content/themes/core/dist/blocks/tribe/menu-toggle/style-index.css */
</style>
