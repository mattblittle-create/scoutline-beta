						<style>
						.ecc-games-widget {
							width: 100%;
							box-sizing: border-box;
							background-color: #f8f8f8;
							/* border-left: 2px solid var(--light-grey); */
							/* border-right: 2px solid var(--light-grey); */
							border-bottom: 2px solid var(--light-grey);
						}
						
						.ecc-games-widget *,
						.ecc-games-widget *::before,
						.ecc-games-widget *::after {
							box-sizing: inherit;
						}
						
						/* Tabs */
						.ecc-games-tabs {
							display: flex;
							background: #2260A7;
							
						}
						
						.ecc-games-tab {
							flex: 1 1 50%;
							padding: 0.85em 1em;
							background: transparent;
							border: 0;
							color: #80AFE5;
							font-size: 1rem;
							font-weight: 600;
							letter-spacing: 0.02em;
							cursor: pointer;
							text-decoration: none;
							transition: background-color 0.2s ease;
						}
						
						.ecc-games-tab:hover,
						.ecc-games-tab:focus-visible {
							background: var(--aqua);
							color: var(--true-blue);
							outline: none;
						}
						
						.ecc-games-tab.is-active {
							color: #fff;
							background: var(--true-blue);
							text-decoration: underline;
							text-underline-offset: 4px;
						}
						
						/* Panels */
						.ecc-games-panel {
							display: none;
							padding-top: 1.5rem;
							padding: 10px;
						}
						
						.ecc-games-panel.is-active {
							display: block;
						}
						
						.ecc-games-empty {
							padding: 2rem 1rem;
							text-align: center;
							color: #666;
						}
						
						/* Carousel */
						.ecc-carousel {
							display: flex;
							align-items: stretch;
							/* gap: 0.75rem; */
						}
						
						.ecc-carousel__viewport {
							flex: 1 1 auto;
							overflow-x: auto;
							overflow-y: hidden;
							scrollbar-width: none;
							-ms-overflow-style: none;
						}
						
						.ecc-carousel__viewport::-webkit-scrollbar {
							display: none;
						}
						
						.ecc-carousel__track {
							display: flex;
							gap: 10px;
							max-width: 1000px;
						}
						
						.ecc-carousel__nav {
							flex: 0 0 2.75rem;
							display: flex;
							flex-direction: column;
						}
						
						.ecc-carousel__btn {
							flex: 1 1 50%;
							width: 40px;
							border: 0;
							background: var(--true-blue);
							color: #fff;
							font-size: 1.1rem;
							line-height: 1;
							cursor: pointer;
							display: flex;
							align-items: center;
							justify-content: center;
							transition: background-color 0.2s ease;
						}
						
						.ecc-carousel__btn:hover,
						.ecc-carousel__btn:focus-visible {
							background: var(--aqua);
							outline: none;
						}
						
						.ecc-carousel__btn--prev {
							border-radius: 4px 4px 0 0;
						}
						
						.ecc-carousel__btn--next {
							border-radius: 0 0 4px 4px;
						}
						
						/* Game card - 3 visible at a time, equal width/height */
						.ecc-game-card {
							flex: 0 0 calc((100% - 2rem) / 3);
							display: flex;
							flex-direction: column;
							justify-content: space-between;
							/* min-height: 200px; */
							background: #fff;
							border: 1px solid #e0e0e0;
							border-radius: 6px;
							padding: 1rem;
						}
						
						.ecc-game-card__sport {
							font-size: 0.75rem;
							text-transform: uppercase;
							letter-spacing: 0.05em;
							color: var(--true-blue);
							font-weight: 700;
							margin-bottom: 4px;
						}
						
						.ecc-game-card__date {
							font-weight: 600;
							margin-bottom: 4px;
						}
						
						.ecc-game-card__opponent {
							font-size: 16px;
							line-height: 18px;
							font-weight: 400;
							margin-bottom: 4px;
						}
						
						.ecc-game-card__location {
							font-size: 0.9rem;
							color: #555;
							margin-bottom: 4px;
						}
						
						.ecc-game-card__time {
							font-size: 0.95rem;
						}
						
						/* Responsive: fewer cards per view on smaller screens */
						@media (max-width: 900px) {
							.ecc-game-card {
								flex-basis: calc((100% - 1rem) / 2);
							}
						}
						
						@media (max-width: 600px) {
							.ecc-game-card {
								flex-basis: 100%;
							}
						
							.ecc-carousel {
								flex-direction: column;
							}
						
							.ecc-carousel__nav {
								flex: 0 0 auto;
								flex-direction: row;
								width: 100%;
								height: 44px;
								margin-top: 10px;
								gap: 10px;
							}
						
							.ecc-carousel__btn {
								width: auto;
							}
						
							.ecc-carousel__btn--prev {
								border-radius: 4px 0 0 4px;
							}
						
							.ecc-carousel__btn--next {
								border-radius: 0 4px 4px 0;
							}
						}
						</style>
						
						
						
						
												
						<script>
						(function() {
							document.querySelectorAll('.ecc-games-widget').forEach(function(root) {
								var tabs = root.querySelectorAll('.ecc-games-tab');
								var panels = root.querySelectorAll('.ecc-games-panel');
						
								tabs.forEach(function(tab) {
									tab.addEventListener('click', function() {
										var target = tab.getAttribute('data-tab');
						
										tabs.forEach(function(t) {
											var active = t === tab;
											t.classList.toggle('is-active', active);
											t.setAttribute('aria-selected', active ? 'true' : 'false');
										});
						
										panels.forEach(function(p) {
											p.classList.toggle('is-active', p.getAttribute('data-panel') === target);
										});
									});
								});
						
								root.querySelectorAll('.ecc-carousel').forEach(function(carousel) {
									var viewport = carousel.querySelector('.ecc-carousel__viewport');
									var prevBtn = carousel.querySelector('.ecc-carousel__btn--prev');
									var nextBtn = carousel.querySelector('.ecc-carousel__btn--next');
						
									if (!viewport) {
										return;
									}
						
									function scrollAmount() {
										var card = viewport.querySelector('.ecc-game-card');
										if (!card) {
											return viewport.clientWidth;
										}
										var track = card.parentElement;
										var gap = parseFloat(window.getComputedStyle(track).columnGap) || 0;
										return card.getBoundingClientRect().width + gap;
									}
						
									if (prevBtn) {
										prevBtn.addEventListener('click', function() {
											viewport.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
										});
									}
									if (nextBtn) {
										nextBtn.addEventListener('click', function() {
											viewport.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
										});
									}
								});
							});
						})();
						</script>








