<style>
article.page {
	grid-template-columns: 1fr;
}
.entry-content {
	margin-top: 0;
}
.content #secondary {
	display: none;
}

@media (max-width: 720px) {
	.content #secondary {
		display: block;
	}
}
</style>




<style>

/*   Recent Posts   */

.recent-posts-section {
	--shadow-card: 0 3px 3px rgba(0, 0, 0, 0.06);
	--shadow-card-hover: 0 8px 8px rgba(0, 0, 0, 0.1);
	--transition-base: 0.3s ease;
	
	padding: 40px 0px;
	margin: 0 auto;
	box-sizing: border-box;
}

.recent-posts-section *,
.recent-posts-section *::before,
.recent-posts-section *::after {
	box-sizing: border-box;
}

.recent-posts-section .section-title {
	font-size: clamp(1.75rem, 4vw, 2.25rem);
	font-weight: 700;
	color: #333333;
	letter-spacing: -0.02em;
	margin: 0;
}

/*   Posts Grid - Responsive Layout   */
.recent-posts-section .posts-grid {
	display: grid;
	gap: 10px;
	grid-template-columns: 1fr;
	list-style: none;
	padding: 0;
	margin: 0;
}

/* Hide 4th and 5th posts by default (mobile) */
.recent-posts-section .post-card:nth-child(4),
.recent-posts-section .post-card:nth-child(5) {
	display: none;
}

/* Tablet: 3 columns, still hide 4th and 5th */
@media (min-width: 600px) {
	.recent-posts-section .posts-grid {
		grid-template-columns: repeat(3, 1fr);
	}
}

/* Desktop: 4 columns, show 4th post, hide 5th */
@media (min-width: 900px) {
	.recent-posts-section .posts-grid {
		grid-template-columns: repeat(4, 1fr);
	}
	
	.recent-posts-section .post-card:nth-child(4) {
		display: flex;
	}
	
	.recent-posts-section .post-card:nth-child(5) {
		display: none;
	}
}

/* Large Desktop: 5 columns, show all posts */
@media (min-width: 1200px) {
	.recent-posts-section .posts-grid {
		grid-template-columns: repeat(5, 1fr);
	}
	
	.recent-posts-section .post-card:nth-child(5) {
		display: flex;
	}
}

/*   Post Card   */

.recent-posts-section .post-card {
	display: flex;
	flex-direction: column;
	background-color: #f8f8f8;
	overflow: hidden;
	box-shadow: var(--shadow-card);
	transition: 
		transform var(--transition-base),
		box-shadow var(--transition-base),
		background-color var(--transition-base);
	height: 100%;
}

.recent-posts-section .post-card:hover {
	transform: translateY(-4px);
	box-shadow: var(--shadow-card-hover);
	background-color: #f8f8f8;
}

/* Image Container */
.recent-posts-section .post-card-image-link {
	display: block;
	position: relative;
	aspect-ratio: 16 / 10;
	overflow: hidden;
	background-color: var(--light-grey);
}

.recent-posts-section .post-card-image {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.4s ease;
}

/* Content Area */
.recent-posts-section .post-card-content {
	display: flex;
	flex-direction: column;
	flex-grow: 1;
	padding: 20px;
}

.recent-posts-section .post-card-title-link {
	display: block;
	margin-bottom: 12px;
	text-decoration: none;
}

.recent-posts-section .post-card-title {
	font-size: 16px;
	font-weight: 600;
	line-height: 1.35;
	color: #333333;
	transition: color var(--transition-base);
	display: -webkit-box;
	-webkit-line-clamp: 3;
	-webkit-box-orient: vertical;
	overflow: hidden;
	margin: 0;
}

.recent-posts-section .post-card-title-link:hover .post-card-title,
.recent-posts-section .post-card-title-link:focus .post-card-title {
	color: var(--true-blue);
}

.recent-posts-section .post-card-excerpt {
	font-size: 14px;
	line-height: 1.6;
	color: #444444;
	flex-grow: 1;
	display: -webkit-box;
	-webkit-line-clamp: 3;
	-webkit-box-orient: vertical;
	overflow: hidden;
	margin: 0;
}

.recent-posts-section .post-card-meta {
	margin-top: 16px;
	padding-top: 12px;
	border-top: 1px solid rgba(0, 0, 0, 0.08);
	font-size: 0.8125rem;
	color: #444444;
	display: flex;
	align-items: center;
	gap: 8px;
}

.recent-posts-section .post-card-date {
	display: flex;
	align-items: center;
	gap: 4px;
}

.recent-posts-section .post-card-date svg {
	width: 14px;
	height: 14px;
	opacity: 0.7;
}

/*   Mobile Adjustments   */

@media (max-width: 599px) {
	.recent-posts-section {
		padding: 40px 16px;
	}

	.recent-posts-section .posts-grid {
		gap: 16px;
	}

	.recent-posts-section .post-card-content {
		padding: 16px;
	}

	.recent-posts-section .post-card-title {
		font-size: 1rem;
	}
}

/*   Focus States for Accessibility  */
.recent-posts-section .post-card-image-link:focus,
.recent-posts-section .post-card-title-link:focus {
	outline: 2px solid var(--true-blue);
	outline-offset: 2px;
}

.recent-posts-section .post-card-image-link:focus-visible,
.recent-posts-section .post-card-title-link:focus-visible {
	outline: 2px solid var(--true-blue);
	outline-offset: 2px;
}
</style>
















<main id="primary" class="site-main">
	
	<div class="content-container">

			
		<div class="content">
		
			<article id="post-9" class="post-9 page type-page status-publish hentry">
		
				<div class="post-entry-container">
			
										<div class="screen-reader-text">
						<h1>East Central College Athletics</h1>
