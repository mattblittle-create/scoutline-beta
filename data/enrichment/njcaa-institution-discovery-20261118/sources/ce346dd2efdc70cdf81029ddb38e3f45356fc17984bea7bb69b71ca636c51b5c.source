				<sr7-module data-alias="slider-4" data-id="114" id="SR7_114_1" data-version="6.8.1">
					<sr7-adjuster></sr7-adjuster>
					<sr7-content>
						<sr7-slide id="SR7_114_1-167" data-key="167">
							<sr7-bg id="SR7_114_1-167-slidebg" class="sr7-layer"><noscript><img decoding="async" src="https://www.camdencc.edu/wp-content/uploads/Registration-Days.jpg" alt="Homepage slide background image of Mascot laying on the ground" title="Registration-Days"></noscript></sr7-bg>
							<sr7-txt id="SR7_114_1-167-6" class="sr7-layer">November 11th, 12th, 16th, 17th and 30th</sr7-txt>
							<sr7-txt id="SR7_114_1-167-75" class="sr7-layer">Registration Days</sr7-txt>
							<sr7-txt id="SR7_114_1-167-78" class="sr7-layer">Choose Your Schedule</sr7-txt>
						</sr7-slide>
						<sr7-slide id="SR7_114_1-154" data-key="154">
							<sr7-bg id="SR7_114_1-154-slidebg" class="sr7-layer"><noscript><img decoding="async" src="https://www.camdencc.edu/wp-content/uploads/spring-background-slider.jpg" alt="null" title="spring-background-slider"></noscript></sr7-bg>
							<sr7-txt id="SR7_114_1-154-75" class="sr7-layer">Spring Registration is Open!</sr7-txt>
							<sr7-txt id="SR7_114_1-154-76" class="sr7-layer">Register Today. Get the Classes You Need.</sr7-txt>
							<sr7-txt id="SR7_114_1-154-78" class="sr7-layer">REGISTER TODAY</sr7-txt>
						</sr7-slide>
						<sr7-slide id="SR7_114_1-96" data-key="96">
							<sr7-bg id="SR7_114_1-96-slidebg" class="sr7-layer"><noscript><img decoding="async" src="https://www.camdencc.edu/wp-content/uploads/winter-slide-right.jpg" alt="null" title="winter-slide-right"></noscript></sr7-bg>
							<sr7-txt id="SR7_114_1-96-10" class="sr7-layer">WINTER INTERSESSION<br />
REGISTRATION<br />
IS OPEN!</sr7-txt>
							<sr7-txt id="SR7_114_1-96-48" class="sr7-layer">REGISTER TODAY</sr7-txt>
						</sr7-slide>
						<sr7-slide id="SR7_114_1-83" data-key="83">
							<sr7-bg id="SR7_114_1-83-slidebg" class="sr7-layer"><noscript><img decoding="async" src="https://www.camdencc.edu/wp-content/uploads/BG_credit-for-prior-learning.jpg" alt="" title="BG_credit-for-prior-learning"></noscript></sr7-bg>
							<sr7-txt id="SR7_114_1-83-49" class="sr7-layer">Turn Your Experience Into College Credit<br />
</sr7-txt>
							<sr7-txt id="SR7_114_1-83-74" class="sr7-layer">CREDIT FOR <br />
PRIOR LEARNING</sr7-txt>
							<sr7-txt id="SR7_114_1-83-77" class="sr7-layer">LEARN MORE</sr7-txt>
						</sr7-slide>
