<div id="mod-custom847" class="mod-custom custom">
    <h2 class="eventsHeader">Upcoming Events at SWCC <a href="https://calendar.swcciowa.edu/" class="calendarLink"> [ View full calendar ]</a></h2>
<div id="localist-widget-68185973" class="localist-widget">&nbsp;</div>
