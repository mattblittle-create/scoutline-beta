<div id="mod-custom818" class="mod-custom custom">
    <style>
	.weAreOneBanner {

		text-align: center;
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: 1fr;
		position: relative;
	}

	.weAreOneBanner p {
		color: #fff;
		white-space: nowrap;
		font-size: 4vw;
		margin: 0 auto;
		padding: 0;
		font-family: 'AvenirNextLTW01-HeavyIt_721290';
		text-shadow: 0 0 20px rgba(0, 0, 0, .75);
		position: relative;
		line-height: 7vw
	}

	.weAreOneBanner p a.button.autoWidth {
		margin: 0 auto;
		padding: 0 1em;
		font-family: 'AvenirNextLTW01-HeavyIt_721290';
		display: inline-block;
		text-shadow: 0 0 20px rgba(0, 0, 0, .5);
	}

	.weAreOneBanner .bannerBackground {
		width: 100%;
		grid-row: 1 / 2;
		grid-column: 1 / 2;
	}

	.bannerConent {
		grid-row: 1 / 2;
		grid-column: 1 / 2;
		align-content: center
	}

	@media only screen and (min-width: 1024px) {
		.weAreOneBanner p {
			font-size: 4.5vw;
			line-height: 6vw;
		}
	}

	@media only screen and (min-width: 1440px) {
		.weAreOneBanner p {
			font-size: 3.5rem;
			line-height: 5.5rem;
		}

		.weAreOneBanner p a.button.autoWidth {
			padding: 0 .5em;
		}
	}
</style></div>

