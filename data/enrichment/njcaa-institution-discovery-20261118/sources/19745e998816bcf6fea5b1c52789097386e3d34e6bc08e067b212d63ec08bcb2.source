	}

	.localist-widget-hl .event-card {
		margin-bottom: 0;
	}

	.localist-widget-hl .event-list .event-card {
		height: auto !important;
	}

	.localist-widget-hl .event-list .event-overview .content {
		display: none;
	}

	.localist-widget-hl span.start-time.location {
		display: none;
	}

	.localist-widget-hl .event-card .event-short-date {
		background: #cf102d;
	}

	.localist-widget-hl .event-title {
		padding: .75em;
		text-overflow: unset;
		white-space: unset;
		z-index: 1;
		line-height: 1.4em;
		font-size: .8125rem;
		font-family: 'Avenir Next LT W01 Bold';
	}

	.localist-widget-hl .event-card img {
		display: block;
		height: 100%;
		width: 100%;
		object-fit: cover;
	}

	.localist-widget-hl .event-list li {
		margin-bottom: unset;
	}

	.slick-dotted.slick-slider {
		margin-bottom: 0;
	}

	.slick-prev,
	.slick-next {
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: block;
		width: 2rem;
		height: 2rem;
		padding: 0;
		-webkit-transform: translate(0, -50%);
		-ms-transform: translate(0, -50%);
		transform: translate(0, -50%);
		cursor: pointer;
		border: none;
		outline: none;
		background: transparent;
		z-index: 2;
	}

	.localist-widget-hl .slick-prev {
		left: 1rem;
	}

	.localist-widget-hl .slick-next {
		right: 1rem;
	}

	.localist-widget-hl .slick-prev::before,
	.slick-next::before {
		color: #ffffff;
		font-size: 2rem;
		text-shadow: 0 0 10px rgba(0, 0, 0, .7);
	}

	.slick-dots li button:before {
		font-family: "Avenir Next LT W01 Bold";
		font-size: 1.6rem;
		line-height: 20px;
		position: absolute;
		top: 0;
		left: 0;
		width: 20px;
		height: 20px;
		content: '•';
		text-align: center;
		opacity: .25;
		color: black;

	}

	.moduletable.upcomingEvents .calendarLink {
		font-size: 1rem;
		color: -webkit-link;
		!important;
		font-family: AvenirNextLTW01-Condens_721299, Arial, Helvetica, sans-serif !important;
		font-size: 1.2rem;
		font-weight: normal;
      text-decoration: underline;
	}

	.moduletable.upcomingEvents {
		margin-bottom: 4rem;

	}

	.eventsHeader {
		text-align: center;
	}
</style>
<script type="text/javascript">
	jQuery(document).ready(function($) {
		// add periods to a.m and p.m.



		$('.localist-widget .event-list').slick({

			dots: true,
			infinite: false,
			speed: 300,
			slidesToShow: 6,
			slidesToScroll: 6,
			responsive: [{
					breakpoint: 1920,
					settings: {
						slidesToShow: 5,
						slidesToScroll: 5,
						infinite: true,
						dots: true
					}
				},
				{
					breakpoint: 1440,
					settings: {
						slidesToShow: 4,
						slidesToScroll: 4,
						infinite: true,
						dots: true
					}
				},
				{
					breakpoint: 1024,
					settings: {
						slidesToShow: 3,
						slidesToScroll: 3,
						infinite: true,
						dots: true
					}
				},
				{
					breakpoint: 600,
					settings: {
						slidesToShow: 2,
						slidesToScroll: 2
					}
				}

				,
				{
					breakpoint: 480,
					settings: {
						slidesToShow: 1,
						slidesToScroll: 1
					}
				}

				// You can unslick at a given breakpoint now by adding:
				// settings: "unslick"
				// instead of a settings object
			]
		});


		$('.localist-widget .event-date time').each(function() {
			theText = $(this).text();
			theText = theText.replace(':00', '');
			theText = theText.replace(/(\d+) pm/gi, '$1 p.m.');
			theText = theText.replace(/(\d+) am/gi, '$1 a.m.');
			//console.log(theText);
			$(this).text(theText);
		});

	});
</script></div>
