    <section class="pt-0 mt-0" style="background-image: url(''); background-repeat: repeat;">
      <div class="container mt-0 pt-0">
        <div class="row align-items-md-center mb-5">
          <div class="col-12 col-md-6">
            <h2 class="display-3 fw-bold mb-3 p-0">Why Choose LCC?</h2>
            <p class="text-muted">LCC is an open enrollment institution, which means that as long as a student completes high school successfully or obtains the equivalent to a high school diploma, they will be accepted as a student.</p>
            <div class="row justify-content-center grid-border">
              <div class="col-6 text-center">
                <div class="counter fw-semibold color mt-1">25</div>
                <div class="whylcc">Academic Programs</div>
              </div>
              <div class="col-6 text-center">
                <div class="counter ls-1 fw-semibold color mt-1">6</div>
                <div class="whylcc">Technical Certificates</div>
              </div>
              <div class="col-6 text-center">
                <div class="counter ls-1 fw-semibold color mt-2">14:1</div>
                <div class="whylcc">Student to Faculty Ratio</div>
              </div>
              <div class="col-6 text-center">
                <div class="counter ls-1 fw-semibold color mt-2">3-Day</div>
                <div class="whylcc">Weekend Every Weekend</div>
              </div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-light"> <img src="admissions/assets/slider/excellence-sm.jpg" alt="Featured image 1" class="card-img-top">
              <div class="card-body">
                <div class="card-title fw-semibold color text-uppercase mb-0 whylccsub">Excellence in Education</div>
                <p class="card-text">Explore our <a href="academics/index.html">academic programs</a> &amp; technical certificates.</p>
              </div>
            </div>
            <div class="card shadow-sm border-light mt-4"> <img src="admissions/assets/slider/housing-sm.jpg" alt="Featured image 2" class="card-img-top">
              <div class="card-body">
                <div class="card-title fw-semibold color text-uppercase mb-0 whylccsub">Safe Student Housing</div>
                <p class="card-text">The <a href="https://www.thecardinalvillas.com/" target="_blank">Cardinal Villas</a> are the recommended student housing community at the LCC Main Campus.</p>
              </div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6 ps-sm-3 mt-3 mt-sm-0">
            <div class="card shadow-sm border-light"> <img src="admissions/assets/slider/0G7A0820.jpg" alt="Featured image 3" class="card-img-top">
              <div class="card-body">
                <div class="card-title fw-semibold color text-uppercase mb-0 whylccsub">Affordability</div>
                <p class="card-text">At LCC, we strive to make college affordable for everyone. In fact, most first-time, full-time students qualify for <a href="financialaid/index.html">financial aid</a>!</p>
              </div>
            </div>
            <a href="admissions/index.html" class="button button-large button-border button-rounded text-end mt-4">Admissions<i class="bi-arrow-right-circle-fill"></i></a> </div>
        </div>
      </div>
    </section>
    <section id="events" class="bg-dark target-element">
      <div class="content-wrap">
        <div class="container">
          <div class="fancy-title title-center title-border dark">
            <h2>Events Calendar</h2>
          </div>
          <div class="row col-mb-80">
            <div class="sidebar sticky-sidebar-wrap col-lg-8 order-lg-first pb-3 pb-md-6">
              <div class="sidebar-widgets-wrap">
                <div class="sticky-sidebar">
                  <div class="row p-0 m-0 mb-3 rounded-0">
                    <div class="col-md-6 bg-white p-3"><img src="pr/press/2026/11/Student-Exhibit.webp" alt="Student Exhibit" ></div>
                    <div class="col-md-6 bg-white p-3">
                      <div class="entry-title">
                        <h3 class="text-transform-none ls-0 fs-3"><a href="pr/press/2026/11/Student-Exhibit.pdf">Art + Graphic Design Exhibit</a> </h3>
                      </div>
                      <div class="entry-meta no-separator my-2">
                        <ul>
                          <li><span class="fw-normal"><i class="uil-calendar-alt"></i>November 12-December 3</span></li>
                        </ul>
                      </div>
                      <div class="entry-content m-0 p-0">
                        <p>Explore artwork and graphic design created by Labette Community College students. On display November 16 – December 3 in the LCC Hendershot Gallery, located on the second floor of the Main Building.</p>
                        <p> Join us December 2 at 5:30 PM for the closing reception and Latzer Award Presentation.</p>
                      </div>
                    </div>
                  </div>
                  <div class="row p-0 m-0 mb-3 rounded-0">
                    <div class="col-md-6 bg-white p-3"> <a href="ssc/aep/index.html"><img src="pr/press/2026/09/Adult-Education-web.webp" alt="Adult Education" ></a> </div>
                    <div class="col-md-6 bg-white p-3">
                      <div class="entry-title">
