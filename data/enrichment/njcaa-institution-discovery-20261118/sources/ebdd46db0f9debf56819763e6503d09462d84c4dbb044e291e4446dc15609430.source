<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.owl-nav').forEach(function (nav) {
    const prevButton = nav.querySelector('.owl-prev');
    const nextButton = nav.querySelector('.owl-next');

    if (prevButton) {
      // Remove invalid ARIA role
      prevButton.removeAttribute('role');

      // Add accessible name
      prevButton.setAttribute('aria-label', 'Previous slide');

      // Hide icon from screen readers
      const icon = prevButton.querySelector('i');
      if (icon) {
        icon.setAttribute('aria-hidden', 'true');
      }
    }

    if (nextButton) {
      nextButton.removeAttribute('role');
      nextButton.setAttribute('aria-label', 'Next slide');

      const icon = nextButton.querySelector('i');
      if (icon) {
        icon.setAttribute('aria-hidden', 'true');
      }
    }
  });
});
</script> 
<script>
$(document).ready(function() {
    $('#oc-posts').owlCarousel({
        // your existing carousel settings
    });

    $('#oc-posts .owl-prev').attr('aria-label', 'Previous news stories');
    $('#oc-posts .owl-next').attr('aria-label', 'Next news stories');
});
</script> 
<script>
document.addEventListener('DOMContentLoaded', function() {
    const table = document.getElementById('eventTable');
    if (!table) return;

    const rows = table.getElementsByTagName('tr');
    const today = new Date();
    today.setHours(0, 0, 0, 0); // Normalize today

    const sevenDaysLater = new Date(today);
    sevenDaysLater.setDate(today.getDate() + 30);

    // Month name to number mapping
    const monthMap = {
        'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5,
        'Jul': 6, 'Aug': 7, 'Sept': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11
    };

    // Start from the second row (skip header)
    for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        const dateCell = row.querySelector('.event-date');

        if (dateCell) {
            const day = parseInt(dateCell.textContent.trim());
            const monthSpan = dateCell.querySelector('.event-month');
            const monthAbbr = monthSpan ? monthSpan.textContent.trim() : '';
            const month = monthMap[monthAbbr];

            // Create event date using current year
            let eventDate = new Date(today.getFullYear(), month, day);
            eventDate.setHours(0, 0, 0, 0);

            // If the event date has already passed this year, roll it to next year
            if (eventDate < today) {
                eventDate = new Date(today.getFullYear() + 1, month, day);
            }

            // Show only events in the next 54 days
            if (eventDate >= today && eventDate <= sevenDaysLater) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        }
    }
});
</script> 
<script>
document.addEventListener("DOMContentLoaded", function () {
    const items = document.querySelectorAll(".event-item");
    const today = new Date();

    items.forEach(item => {
        const startDate = new Date(item.dataset.start);
        const endDate = new Date(item.dataset.end);

        // Set end date to end of day
        endDate.setHours(23, 59, 59, 999);

        if (today < startDate || today > endDate) {
            item.style.display = "none";
        }
		if (today < startDate || today > endDate) {
    		item.remove();
		}
    });
});
</script> 
