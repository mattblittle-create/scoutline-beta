<script type="49deeb03a9c50ce1737d1857-text/javascript">
	document.addEventListener('DOMContentLoaded', function () {
		document.querySelectorAll('.set-title').forEach(title => {
			title.addEventListener('click', function () {
				// Let accordion toggle finish expanding
				setTimeout(() => {
					const parentSet = this.closest('.set');
					const slider = parentSet.querySelector('.media-carousel');

					if (slider && $(slider).hasClass('slick-initialized')) {
						$(slider).slick('setPosition');
					}
				}, 200); // wait for accordion animation (adjust as needed)
			});
		});
	});
</script>
