xt-center pathways__heading-wrapper d-flex flex-column py-3 px-2"><h3 class="typography__h4 text-white my-auto">Arts & Culture</h3></div></a></div><div> <a href="https://www.kcc.edu/academics/programs/business-and-communication/" class="links__no-underline pathways__link" title="Business & Communication"> <img data-src="assets/img/pathways_business-and-communications.jpg" src="assets/img/placeholder_square.jpg" class="img-fluid" height="340" width="340" alt="" /><div class="text-center pathways__heading-wrapper d-flex flex-column py-3 px-2"><h3 class="typography__h4 text-white my-auto">Business & Communication</h3></div></a></div><div> <a href="https://www.kcc.edu/academics/programs/general/" class="links__no-underline pathways__link" title="General/Exploration"> <img data-src="assets/img/pathways_general-exploration.jpg" src="assets/img/placeholder_square.jpg" class="img-fluid" height="340" width="340" alt="" /><div class="text-center pathways__heading-wrapper d-flex flex-column py-3 px-2"><h3 class="typography__h4 text-white my-auto">General/Exploration</h3></div></a></div><div> <a href="https://www.kcc.edu/academics/programs/helping-professions/" class="links__no-underline pathways__link" title="Helping Professions"> <img data-src="assets/img/pathways_helping-professions-opt2.jpg" src="assets/img/placeholder_square.jpg" class="img-fluid" height="340" width="340" alt="" /><div class="text-center pathways__heading-wrapper d-flex flex-column py-3 px-2"><h3 class="typography__h4 text-white my-auto">Helping Professions</h3></div></a></div><div> <a href="https://www.kcc.edu/academics/programs/medical-professions/" class="links__no-underline pathways__link" title="Medical Professions"> <img data-src="assets/img/pathways_medical-professions.jpg" src="assets/img/placeholder_square.jpg" class="img-fluid" height="340" width="340" alt="" /><div class="text-center pathways__heading-wrapper d-flex flex-column py-3 px-2"><h3 class="typography__h4 text-white my-auto">Medical Pro