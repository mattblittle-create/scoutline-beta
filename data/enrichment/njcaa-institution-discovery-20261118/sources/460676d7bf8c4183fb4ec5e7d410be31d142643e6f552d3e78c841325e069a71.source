                  <td id="countdown-static-text" class="font-600 font-size-lg text-white" style="padding: 20px; text-align: center; vertical-align: middle; width: 50%; box-sizing: border-box; border: none;">
                     
                     <h1><span style="color:#FFFFFF;"><a style="color:#FFFFFF;" href="https://www.stchas.edu/lightthetree" title="Light The Tree Link">Light The Tree At SCC</a></span></h1>
                     </td>
                  	
                  <!-- Column 2: Countdown Timer Widget / Action Button Area -->
                  
                  <td style="padding: 20px; text-align: center; vertical-align: middle; width: 50%; box-sizing: border-box; border: none;">
                     <!-- Main layout container with ARIA tags to control link descriptions natively -->
                     <a id="scc-registration-action" href="https://www.stchas.edu/lightthetree" title="Light The Tree" class="scc-countdown-link" aria-describedby="countdown-static-text" style="display: inline-block; text-decoration: none; color: #ffffff !important; width: 100%; max-width: 400px; box-sizing: border-box;">
                        
                        <div id="nifty-countdown-1791468945282" aria-live="off" style="background: #3b7e80 !important; color: #ffffff; font-weight:800; !important; padding: 12px; border-radius: 10px; text-align: center; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);"></div>
                        </a>
                     </td>
                  
                  </tr>
               </table>
         </div>
         
         <script>
(function() { 
    var targetDate = new Date('2026-11-21T01:00').getTime(); 
    var container = document.getElementById('nifty-countdown-1791468945282'); 
    var linkWrapper = document.getElementById('scc-registration-action');
    var staticTextCell = document.getElementById('visual-headline');
    var sraAnnouncer = document.getElementById('countdown-status-announcer');
    
    function updateCountdown() { 
        var now = new Date().getTime(); 
        var distance = targetDate - now; 
        
        if (distance < 0) { 
            // 1. Transition the visual timer area into an active button design
            container.style.boxShadow = '0 4px 10px rgba(0,0,0,0.2)';
            container.style.background = '#5c061f';
            container.style.padding = '15px 35px';
            container.style.borderRadius = '4px';
            container.innerHTML = 'Register For Classes Today'; 
            
            // 2. Set programmatic attributes to announce registration is active
            linkWrapper.removeAttribute('aria-describedby');
            
            if (staticTextCell) {
                staticTextCell.innerHTML = 'Registration Is Now Open!';
            }
            
            // 3. Trigger assertive audio announcement for screen readers
            if (sraAnnouncer && sraAnnouncer.innerHTML === '') {
                sraAnnouncer.innerHTML = 'Light The Tree At SCC';
            }
            
            clearInterval(countdownInterval); 
            return; 
        } 
        
        var days = Math.floor(distance / (1000 * 60 * 60 * 24)); 
        var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)); 
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)); 
        var seconds = Math.floor((distance % (1000 * 60)) / 1000); 
        
        // Formats data with label strings for text tracking readers
        linkWrapper.setAttribute('aria-label', 'Time remaining until registration opens: ' + days + ' days, ' + hours + ' hours, ' + minutes + ' minutes, ' + seconds + ' seconds.');
        
        var html = ''; 
        html += '<div style="display: flex; gap: 20px; justify-content: center; align-items: center;" aria-hidden="true">'; 
        html += '<div style="text-align: center;"><div style="font-size: 48px; color: #ffffff !important; font-weight: bold;">' + String(days).padStart(2, '0') + '</div><div style="font-size: 14px; font-weight: 700; color: #FFFFFF !important; margin-top: 5px; opacity: 1.0;">DAYS</div></div>'; 
        html += '<div style="text-align: center;"><div style="font-size: 48px; color: #ffffff !important; font-weight: bold;">' + String(hours).padStart(2, '0') + '</div><div style="font-size: 14px; font-weight: 700; color: #FFFFFF !important; margin-top: 5px; opacity: 1.0;">HOURS</div></div>'; 
        html += '<div style="text-align: center;"><div style="font-size: 48px; color: #ffffff !important; font-weight: bold;">' + String(minutes).padStart(2, '0') + '</div><div style="font-size: 14px; font-weight: 700; color: #FFFFFF !important; margin-top: 5px; opacity: 1.0;">MINUTES</div></div>'; 
        html += '<div style="text-align: center;"><div style="font-size: 48px; color: #ffffff !important; font-weight: bold;">' + String(seconds).padStart(2, '0') + '</div><div style="font-size: 14px; font-weight: 700; color: #FFFFFF !important; margin-top: 5px; opacity: 1.0;">SECONDS</div></div>';
        html += '</div>'; 
        
        container.innerHTML = html;
    } 
    
    updateCountdown(); 
    var countdownInterval = setInterval(updateCountdown, 1000); 
})();
</script>
         
         
