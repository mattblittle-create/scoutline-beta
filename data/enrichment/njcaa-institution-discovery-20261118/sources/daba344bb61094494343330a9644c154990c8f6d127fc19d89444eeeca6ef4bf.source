<script>
	function moveSkipLinkFirst() {
		var skipLink = document.querySelector('.skip-link[href="#main-content"]');

		if (skipLink && document.body.firstElementChild !== skipLink) {
			document.body.prepend(skipLink);
		}
	}

	document.addEventListener('DOMContentLoaded', moveSkipLinkFirst);
	window.addEventListener('load', moveSkipLinkFirst);
</script>
<script>
	function labelChatbotLandmark() {
		var chatbot = document.getElementById('edsights-chatbot');

		if (chatbot) {
			chatbot.setAttribute('role', 'complementary');
			chatbot.setAttribute('aria-label', 'Site assistant');
			return true;
		}

		return false;
	}

	document.addEventListener('DOMContentLoaded', function () {
		if (labelChatbotLandmark()) {
			return;
		}

		var chatObserver = new MutationObserver(function () {
			if (labelChatbotLandmark()) {
				chatObserver.disconnect();
			}
		});

		chatObserver.observe(document.body, {
			childList: true,
			subtree: true
		});
	});
</script>
<script>
	(function () {
		function addShareThisLandmark() {
			var shareImage = document.querySelector(
				'img[src*="platform-cdn.sharethis.com"]'
			);

			if (!shareImage) {
				return false;
			}

			var shareWidget = shareImage.closest(
				'.st-sticky-share-buttons, [id^="st-"]'
			);

			if (!shareWidget) {
				return false;
			}

			shareWidget.setAttribute('role', 'region');
			shareWidget.setAttribute('aria-label', 'Share this page');

			return true;
		}

		if (addShareThisLandmark()) {
			return;
		}

		var observer = new MutationObserver(function () {
			if (addShareThisLandmark()) {
				observer.disconnect();
			}
		});

		observer.observe(document.body, {
			childList: true,
			subtree: true
		});
	}());
</script>      <div id="ou-hidden" style="display:none;"><a id="de" rel="nofollow" href="https://a.cms.omniupdate.com/11/?skin=oucampus&amp;account=colbycc&amp;site=www&amp;action=de&amp;path=/index.pcf">©</a></div><script>
