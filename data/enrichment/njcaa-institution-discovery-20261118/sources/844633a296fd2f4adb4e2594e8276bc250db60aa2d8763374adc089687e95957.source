<h2 id="h-meet-our-alumni" class="wp-block-heading"><strong>MEET OUR ALUMNI</strong></h2>



<style>
    section.slick-carousel .carousel-slide-container {
        grid-template-rows: 240px 1fr;
    }

    section.slick-carousel .carousel-slide_image {
        background-position: top;
    }
    
    @media (max-width: 992px) {
