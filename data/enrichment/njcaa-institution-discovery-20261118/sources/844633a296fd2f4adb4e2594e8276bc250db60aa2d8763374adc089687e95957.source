    font-size: 12px; }*/
*/
    
 .notification-container {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
}

.notification-bar-high,
.notification-bar-low {
    left: 0;
    right: 0;
    width: 100%;
    position: fixed;
/*    z-index: 999;
*/    text-align: center;
    color:white;
    pointer-events:auto;
}

.notification-bar-high {
    bottom: 0;
    background: #daa520;
    padding: 0.5rem 0;
}

.notification-bar-low {
    bottom: 0;
    background: rgba(25, 79, 144, 0.9);
}
    
@media only screen and (max-width: 767px) {
  .notification-bar-high h2, .notification-bar-low h2 {
    max-width: 85%;
    display: table;
    margin: auto;
    padding: 0 10vw;
    font-size: 20px; }
  .notification-bar-high h3, .notification-bar-low h3 {
    max-width: 85%;
    display: table;
    margin: auto;
    padding: 0 10vw;
    font-size: 18px; } }
@media only screen and (min-width: 768px) {
  .notification-bar-high h2, .notification-bar-low h2 {
    padding: 0 5vw;
    display: block; }
  .notification-bar-high h3, .notification-bar-low h3 {
    padding: 0 5vw;
    display: block; } }
.notification-bar-wrap {
  position: relative;
  max-width: 95%;
  margin: auto; }

.notification-bar-low {
  border-top: 1px solid #fff; }

.notification-bar-high-close, .notification-bar-low-close {
  display: inline;
  float: right;
  background: url(images/close-bar.png);
  background-repeat: no-repeat;
  width: 21px;
  height: 21px;
  display: inline-block;
  text-indent: -9999px;
  cursor: pointer;
  position: absolute;
  right: 25px;
  top: 0; }

.notification-bar-high {
  padding: 3vh 0; }

.notification-bar-low {
  padding: 1vh 0; }
</style>
<ul></ul></div>
</div>
	
	
