<!-- Emergency alert content -->
<style>
:root {
  --low-bar-height: 120px;
  --high-bar-height: 220px;
}

body {
  padding-bottom: 0;
}

body:has(.notification-bar-low) {
  padding-bottom: var(--low-bar-height);
}

body:has(.notification-bar-high) {
  padding-bottom: var(--high-bar-height);
}

body:has(.notification-bar-low):has(.notification-bar-high) {
  padding-bottom: calc(var(--low-bar-height) + var(--high-bar-height));
}

.notification-bar-low,
.notification-bar-high {
  position: fixed;
  left: 0;
  right: 0;
  width: 100%;
  text-align: center;
  overflow-y: auto;
  box-sizing: border-box;
}

.notification-bar-low {
  bottom: 0;
  z-index: 1000;
  height: var(--low-bar-height);
  background: rgba(25, 79, 144, 0.9);
  color: white;
}

.notification-bar-high {
  bottom: 0;
  z-index: 1001;
  height: var(--high-bar-height);
  background: #efce1a;
}

/* only move high up when low also exists */
body:has(.notification-bar-low) .notification-bar-high {
  bottom: var(--low-bar-height);
}

.notification-bar-wrap {
  padding: 10px 40px;
  box-sizing: border-box;
}

.notification-bar-low h3,
.notification-bar-low p {
  margin: 0;
}
    body:has(.notification-bar-low) .botpress--button-container--f1ib9x {
  position: fixed !important;
  bottom: var(--low-bar-height) !important;
  z-index: 9999 !important;
}
</style>

