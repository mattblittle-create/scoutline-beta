	}
	@media (max-width: 1199px) {
		#testimonials {
			max-width: 96%;
			margin: 6rem auto 4rem;
		}
	}
	@media (max-width: 991.9px) {
		.owl-prev:hover:before, .owl-next:hover:before, .owl-prev:active:before, .owl-next:active:before,
		.owl-prev:focus-visible:before, .owl-next:focus-visible:before {background: #0752f4;}
		.owl-prev span, .owl-next span {bottom: 12px;}
		.owl-prev span, .owl-next span {
			bottom: 13px;
		}
	}
	@media (max-width: 450px) {
		#testimonials {
		    margin: 4.5rem auto 3.7rem;
		}
	}
	blockquote .end-quote {
   position: relative;
    width: 1em;
    height: 1em;
    display: inline-block;
	}
	.owl-prev:hover:before, .owl-next:hover:before {
    background: orange;
	}
</style>
