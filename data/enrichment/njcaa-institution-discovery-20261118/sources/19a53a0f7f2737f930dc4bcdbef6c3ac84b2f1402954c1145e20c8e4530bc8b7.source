            font-size: 5rem;
        }
        #testimonials .quote {
            grid-template-columns: 1fr 10fr;
        }
        #testimonials .quotemark img {
            max-width: 100%;
            padding-right: 2vw;
        }
        #testimonials p.cite {
            font-size: 3.3vw;
			font-size: clamp(16px, 0.8258rem + 1.885vw, 20px);
        }

        .owl-prev span, .owl-next span {
            width: 40px;
            height: 40px;
            line-height: 4rem;
            bottom: 13px;
        }
    }
	.owl-prev:hover:before, .owl-next:hover:before {
		background: orange;
		/*background: #011e62;*/
	}
	@media (min-width: 1640px) {
			
		#testimonials blockquote {
			font-size: 3.3rem;
		}
		#testimonials p.cite {font-size: 2.5rem;}
