                Business            </span></a>
        </div>
    </div>
</section>
<script>
    jQuery('.programs-degrees a').on('click', function(e) {
        e.preventDefault();
        let $this = jQuery(this);
        let $degreeLinks = jQuery('.programs-degrees a');
        $degreeLinks.removeClass('active');
        $this.addClass('active');
        let $featuredProgram = jQuery('#featured-programs');
        $featuredProgram.removeAttr('class').attr('class', $this.attr('data-degree')); //.css('background-image', 'url(' + $this.attr('data-url') + ')');
        let $programsExploreBtn = jQuery('.programs-explore');
        $programsExploreBtn.find('#degree-title').html($this.attr('data-title'));
        $programsExploreBtn.attr('href', ($this.attr('href')));
    });
</script>	</div>
