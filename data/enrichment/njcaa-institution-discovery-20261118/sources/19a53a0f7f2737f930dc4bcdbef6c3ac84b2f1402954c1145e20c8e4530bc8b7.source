    color: white;
    text-decoration: none;
    font-size: 3.5rem;
			font-size: 3rem;
}
		a.dotted:before {
    content: '';
    border: solid;
    border-width: 0 3px 3px 0;
    display: block;
    left: -29px;
    top: 9px;
    background-color: transparent;
    position: absolute;
    height: 10px;
    width: 10px;
    padding: 1px;
    transform: rotate(-45deg);
