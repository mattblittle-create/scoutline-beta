        padding: 0.5rem 2.1rem 0rem 2.5rem;
        font-size: 2.8rem;
    }

    #meet-mike .btn .bi {
        padding-left: .8rem;
        position: relative;
        transition: all .4s;
    }

    .btn:hover,
    .btn:focus {
        background: #0473CD
    }

    #meet-mike .btn:hover .bi,
    #meet-mike .btn:focus .bi {
        /*    color: orange;*/
        /*    left: .5rem;*/
    }

    /*
.mike-inner h2::after {
    background-color: #184bad;
    content: "";
    display: block;
    height: 0.5rem;
    position: absolute;
    bottom: -1.5rem;
    width: 3rem;
}*/

        @media (min-width: 1640px) {
            .containers {
                max-width: 1500px;
                margin: 0 auto;
                position: relative;
            }
        }

    @media (max-width: 1339px) {

        .mike-inner {

            max-width: 44%;
        }

        .mike-inner h2 {
            font-size: 3vw;
        }

        .mike-inner p {
            font-size: 1.4vw;
            padding-right: 11%;
        }

        .mike-inner {
            top: 50%;
        }
    }

    @media (max-width: 1023px) {
        #meet-mike {
            background: #ebebe9
        }

        .mike-inner {
            position: static;
            transform: none;
            text-align: center;
            margin: 0 auto;
            padding: 0;
            max-width: 100%;
            width: 760px;
            padding: 4rem 0 2rem;
        }

        .mike-inner h2 {
            font-size: 2rem;
        }

        .mike-inner p {
            font-size: 1rem;
            padding-right: 0;
            width: 550px;
            max-width: 100%;
            margin: 0 auto;
        }

        #meet-mike .btn {
            margin-top: 2rem;
            font-size: 2rem;
            letter-spacing: 1px;
            padding: 1rem 2rem .7rem;
        }
    }

    @media (max-width: 1023px) {
        .mike-inner {
            padding: 4rem 0 2.5rem;
        }

        #meet-mike .containers {
            border-bottom: 15px solid #16335e;
        }
    }

    @media (min-width: 601px) {
        .visible-xs {
            display: none;
        }

    }

    @media (max-width: 600px) {
        #meet-mike .containers {
            border-bottom: 20px solid #25437a
        }

        .visible-xs {
            display: block;
        }

        .visible-sm {
            display: none;
        }

        #meet-mike .visible-xs {
            padding-top: 2vw;
            border-top: 3px solid #092161;
            border-bottom: 14px solid #193360;
        }

        .mike-inner h2 {
            font-size: 1.5rem;
        }

        .mike-inner {
            padding: 10vw 0;
        }

        .mike-inner p {
            padding: 0 1.5rem;
            font-size: .95rem;
        }

    }

    #meet-mike h1 {
        line-height: 0.9;
        color: #011e62;
        font-size: 9rem;
        font-size: 7rem;
        font-weight: bold;
        text-transform: uppercase;
        margin: 0;
        padding: 0;
        margin-bottom: 1.3rem;
    }
    

    @media (min-width: 1200px) {
        #meet-mike h1 {
            font-size: 7rem;
        }
    }
    
    @media (max-width: 1310px) {
        #meet-mike h1 {
            font-size: 5.5rem; 
        }
    }

    @media (max-width: 1199.9px) {
        #meet-mike h1 {
            font-size: 5.5rem;        
            margin-top: 6vw;
        }
        #meet-mike .btn {margin-bottom: 4vw;}
    }

    @media (max-width: 450px) {
        #meet-mike h1 {
            font-size: 4.5rem;
        }

        #meet-mike a.programs-explore {
            margin-top: 2.5rem;
        }
    }
    @media (max-width: 600px) {
        #meet-mike .btn {margin-bottom: 1vw;}
    }
</style>
