                <ul>
                                        <li><a href="Https://www.highlands.edu/areas-of-study/business-administration-program/" class="active" aria-controls="#BusadminBtn" data-title="Business" data-degree="Busadmin">Business Administration</a></li>
                                        <li><a href="Https://www.highlands.edu/academic-programs/engineering-pathway/" class="" aria-controls="#EngineeringBtn" data-title="Engineering" data-degree="Engineering">Engineering</a></li>
                                        <li><a href="Https://www.highlands.edu/academic-programs/film-and-digital-entertainment-pathway/" class="" aria-controls="#FilmBtn" data-title="Film &amp; DE" data-degree="Film">Film & Digital Entertainment</a></li>
