(function($) {		
	
	// Make the Ajax call here
    jQuery.ajax({
        url: 'https://sites.highlands.edu/ghctoday/wp-json/wp/v2/posts?per_page=4&_embed&exclude[0]=13359',
        type: 'get',
        dataType: 'json',
        success: function( _response ){
            // The Ajax request is a success. _response is a JSON object
			//console.dir(_response)
//            jQuery('.fl-node-61805370c29bb .col-md-9>.row').empty();
            
            var $articlesTotal = '';
            var $rightArticles = '';
            var $rightArticlesTotal = '';
            
            var updateDate = function ($date) {
                const isoDate = $date;
                const dateObject = new Date(isoDate); 
                const date = dateObject.toLocaleString('en-US', {month: 'long', day: 'numeric', year: 'numeric'});
                return date;
            }
                
            jQuery(_response).each(function (i) {
               var link = this.link;
                var title = this.title.rendered;
                var date = updateDate(this.date);
                //var excerpt = this.excerpt.rendered;
                var image = this._embedded["wp:featuredmedia"];
                var image_alt = image[0].alt_text;
                if (image[0].media_details.sizes.large !== undefined && i == 0) {
                    image = image[0].media_details.sizes.large;
                } else if (image[0].media_details.sizes.medium !== undefined && i != 0) {
                    image = image[0].media_details.sizes.medium;
                } else {
                    image = image[0].media_details.sizes.full;
                }
                var image_src = image.source_url;
                var image_height = image.height;
                var image_width = image.width;
                   
                if (i == 0) {
                    let $article = `<article class="" style="">
						<div class="article-img"><a href="${this.link}"><img src="${image_src}" class="img-responsive" alt="${image_alt}"></a></div>
                            <div class="news-text">
								<h1><a href="${this.link}">${title}</a></h1>
                                <h2>${date}</h2>
                            </div>
                        </article>`
                    $articlesTotal = $article;
                } else {
                    let $article = `<article class="" style="">
						<div class="article-img"><a href="${this.link}"><img src="${image_src}" class="img-responsive" alt="${image_alt}"></a></div>
                        <div class="news-text">
							<h1><a href="${this.link}">${title}</a></h1>
                            <h2>${date}</h2>
                        </div>
                    </article>`
                    $rightArticles += $article;
                }
            });
            $rightArticlesTotal = `<div class="articles-right" style="">
                    ${$rightArticles}
                    <a id="exploreBtn" href="https://ghctoday.highlands.edu/" class="visit-ghctoday btn"><span class="fa fa-arrow-right" style="margin-right: 1rem;"></span>Visit GHCToday</a>
                </div>`

            $articlesTotal += $rightArticlesTotal;

            jQuery('#news .news-content').append($articlesTotal);
        },
        error: function(jqXhr, json, errorThrown){
            // In case of Ajax error too, display the result
            var error = jqXhr.responseText;
            console.dir(error);
        }
    });
})( jQuery );
