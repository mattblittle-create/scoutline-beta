<style>
    #aspen {
        background: #00497c;
        color: white;
        font-family: Hind, sans-serif;
        position: relative;
    }
    @media (min-width: 768px) {
        #aspen-container {
            display: grid;
            grid-template-columns: 1.6fr 3fr 1.55fr;
        }

        #aspen-logo {
            background: url(https://www.highlands.edu/wp-content/uploads/2024/09/aspen.webp) no-repeat;
            background-size: contain;
            background-position: top right;
        }

        .aspen-inner {
            position: absolute;
            top: 50%;
            transform: translate(-13%, -50%);
            width: 53%;
        }

        #aspen img {
            margin-left: 8%;
        }
    }

    #aspen a {
        color: white;
    }

    #aspen img {
        max-width: 50%;
        padding: 0.7vw 0 .5vw;
    }


    #aspen {
        font-size: 1.6vw;
        line-height: 1.3;
    }

    #aspen b {
        font-weight: bold;
    }

    #aspen p {
        font-size: 1.2vw;
        margin-top: 1.2vw;
        text-align: center;
    }

    #aspen h1 {
        text-align: center;
        font-size: 1.7vw;
        color: white;
    }
    .aspen-inner a {
        text-decoration: underline;
        text-decoration-color: orange;
        text-underline-offset: 3px;
    }
    #aspen a {transition: color .4s;}
    #aspen a:hover, #aspen a:focus-visible, #aspen a:active {
        color: #92d6ff;
        text-decoration-color: #92d6ff;
    }
    .aspen-img-mob {display: none;}
    @media (min-width: 768px) and (max-width: 1200px) {
        .aspen-inner {
            position: absolute;
            top: 50%;
            transform: translate(-17.5%, -50%);
            width: 63%;
        }
        #aspen img {
            max-width: 59%;
        }
        #aspen h1 {font-size: 1.7vw;}
        #aspen {
            font-size: 1.9vw;
        }
        #aspen p {
            font-size: 1.5vw;
            margin-top: 0.8vw;
        }
    }
    @media (min-width: 768px) and (max-width: 991.9px) {
        #footer-heritage {display: none;}
    }
    @media (max-width: 767.9px) {
        .aspen-img-mob {display: block;}
        .aspen-img-desk {display: none;}
        #aspen img {
            width: 61vw;
            max-width: 300px;
            margin: 0 auto;
            display: block;
            padding: 4vw;
        }
        #aspen {
            font-size: 5vw;
        }
        .aspen-inner {
            max-width: 420px;
            max-width: 75vw;
            margin: 0rem auto;
            line-height: 1.5;
            margin-top: 2vw;
        }
        #aspen p {
            font-size: 4.6vw;
            font-weight: bold;
            margin-top: 3vw;
            text-align: center;
        }
        #aspen h1 {
            font-size: 4.5vw;
            line-height: 1.5;
        }
        #aspen-container {
            padding-top: 10vw;
            padding-bottom: 14vw;
        }
        div#aspen-container:before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            border: 2px solid #2467a5;
            margin: 1.4rem;
        }
        #footer .footer-copyright p {font-size: 14px;}
    }
</style>
