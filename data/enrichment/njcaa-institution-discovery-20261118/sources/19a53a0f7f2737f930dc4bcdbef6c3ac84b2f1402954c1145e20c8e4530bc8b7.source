<style type="text/css" id="sns_styles">html {
  scroll-behavior: smooth;
}
#news .news-content article:first-of-type .article-img {
    margin-bottom: .5rem;
}
.fa-brands, .fab {
    font-family: "Font Awesome 6 Brands" !important;
}
.article-img>a {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16 / 11;
    overflow: hidden;
	display: block;
}
.article-img>img {
	border-radius: 10px;
}
#aspen {margin-top: 3rem;}

section#featured-programs p {
	text-shadow: .02em .02em 0.2em #000000a8, 0.02em .02em 0em #000000a8, 0.02em .02em 0.2em #000000a8;
	font-size: 2.2rem;
    max-width: 350px;
}
section#featured-programs .programs-degrees a, section#featured-programs h1 {
	text-shadow: .02em .02em 0.2em #000000a8, 0.02em .02em 0em #000000a8, 0.02em .02em 0.2em #000000a8;
}
#aspen {    margin-top: 0 !important;}
@media (min-width: 1200px) {
	section#featured-programs h1 {
    	font-size: 7rem;
	}
	section#featured-programs .programs-degrees a {
		font-size: 3.5rem;
	}
}
@media (max-width: 1199.9px) {
    section#featured-programs h1 {
        font-size: 5.5rem;
    }
}
@media (max-width: 450px) {
	section#featured-programs {    
		padding-top: 7rem;
    	padding-bottom: 6.5rem;
	}
	section#featured-programs h1 {font-size: 4.5rem;}
	section#featured-programs p {
		font-size: 1.7rem;
        max-width: 270px;
	}
	section#featured-programs .programs-inner a {font-size: 2rem;}
	section#featured-programs .programs-inner a:before {top: 6px;}
	section#featured-programs .programs-degrees a {
        font-size: 2.5rem;
    }
	section#featured-programs .programs-inner a {
        margin-bottom: 8rem;
    }
	section#featured-programs a.programs-explore {
        margin-top: 2.5rem;
    }
}


#featured-programs {
	margin-bottom: 0;
}

#featured-programs .fa {
	font-family: "FontAwesome";
}
#featured-programs:before {
    background: linear-gradient(90deg, #000, hsla(0, 0%, 100%, 0)), linear-gradient(90deg, #000, hsla(0, 0%, 100%, 0));
}
#featured-programs .featured-programs-wrapper {
    max-width: 87%;
}

@media (min-width: 1640px) {
#featured-programs .featured-programs-wrapper {
    max-width: 1500px;
}
}
@media (max-width: 1200px) {
#featured-programs .featured-programs-wrapper {
    max-width: 100%;
    margin: 0 2rem;
}
}
@media (max-width: 991.9px) {
    #featured-programs {
        margin-top: 0 !important;
	}
}
.owl-prev, .owl-next {position: relative;}
.owl-prev span, .owl-next span {
    font-size: 8rem;
    line-height: 20rem;
    color: white;
}
.owl-prev:before, .owl-next:before {
	    content: '';
    width: 60px;
    height: 60px;
    background: #0752f4;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
    border-radius: 50%;	
}

	#sp451-element-events-root ._sp451--events__link a span:before, #meet-mike .fa-arrow-right:before {    
		content: 'f061';
    font-family: "Font Awesome 5 Free";
    margin-right: 1rem;
		font-weight: 900;
	}
#meet-mike .btn {
font-weight: 400 !important;
	
    letter-spacing: 1px;
}
.btn.programs-explore:hover, .btn.programs-explore:focus-visible {
	background: darkblue;
    color: white;
}

#news a:focus {
	border: 1px solid #0752f4;
}
.fa, .fa-brands, .fa-classic, .fa-regular, .fa-solid, .fab, .far, .fas {
    --_fa-family: var(--fa-family, var(--fa-style-family, "Font Awesome 6 Free"));
}</style><script type="application/ld+json">
