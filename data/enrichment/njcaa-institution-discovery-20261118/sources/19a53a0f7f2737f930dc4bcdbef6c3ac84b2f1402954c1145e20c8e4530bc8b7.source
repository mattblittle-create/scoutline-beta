        height: 100px;
        width: 100px;
        position: relative;
        border-radius: 50%;
        border: 8px solid orange;
    background: blue;
        display: block;
		margin: 0 auto;
    }

    .play:hover {
        border-color: white;
    }

    .play-inner {
        display: block;
        box-sizing: border-box;
        width: 0;
        height: 74px;
        border-color: transparent transparent transparent #fff;
        transition: 100ms all ease;
        cursor: pointer;
        text-align: center;
        position: absolute;
        top: 50%;
        left: 54%;
        transform: translate(-50%, -50%) scale(0.55);
        border-style: solid;
        border-width: 37px 0 37px 60px;
