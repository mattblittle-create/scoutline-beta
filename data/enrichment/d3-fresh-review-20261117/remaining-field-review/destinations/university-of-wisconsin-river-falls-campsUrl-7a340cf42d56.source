	<script>
        $(document).ready(function () {
			$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C').carousel({ interval: 5000 });
			$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C').on('slide', function() {
				var to_slide = $('.carousel-inner .item.active').attr('id');
				$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C .carousel-indicators').children().removeClass('active');
				$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C .carousel-indicators [data-slide-to=' + to_slide + ']').addClass('active');
			});
			
			$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C .carousel-indicators li').click(function(e){
				e.stopPropagation();
				var goTo = $(this).data('slide-to');
				$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C .carousel-inner .item').each(function(index){
					if($(this).data('id') == goTo){
						goTo = index;
						return false;
					}
				});		
				$('#mySlideshowCarousel-1DA6B162-CB81-BED5-69EB-4E2CF416872C').carousel(goTo); 
			});
        });
    </script>

