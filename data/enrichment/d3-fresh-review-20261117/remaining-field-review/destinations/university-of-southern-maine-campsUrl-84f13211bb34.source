	line-height: 35px;
	font-weight: 700;
	display: flex;
	flex-wrap:nowrap;
	flex-direction:row;
	justify-content:flex-start;
	align-content:space-between;
	   }

.footerNav a:link, .footerNav a:visited { 
	color:#f5a800; 
	text-decoration: none;
	   }
	   
.footerNav a:hover, .footerNav a:active { 
	color:#fff;
	text-decoration: none;
	   }

.socialCTA a { 
