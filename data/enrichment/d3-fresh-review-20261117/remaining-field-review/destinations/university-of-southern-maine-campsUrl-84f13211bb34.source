	   }

.leftColumn {
	display: flex;
	flex:50%; 
	flex-direction:column;
	justify-content: flex-start;
	   }
	
.logoColumn { 
	display: flex;
	flex:50%;
	flex-direction:column; 
	justify-content:center;
	align-items:center;
	align-content:center;
	   }
	
.footerNav { 
	color:#f5a800;
