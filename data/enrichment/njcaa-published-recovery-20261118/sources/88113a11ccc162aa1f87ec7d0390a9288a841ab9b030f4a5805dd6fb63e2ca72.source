				<style id="cacc-dark-theme-styles" type="text/css">/* CACC consolidated dark theme — replace the entire previous footer block.
   Site-specific selectors checked against CACC templates, October 27, 2026.
   No image inversion, universal text recoloring, or layout changes to content. */
html.cacc-dark-mode { color-scheme:dark; background:#101820; }
body.cacc-dark-mode {
 --cacc-bg:#101820; --cacc-panel:#1b2836; --cacc-raised:#283c50;
 --cacc-text:#e8edf2; --cacc-muted:#b9c7d5; --cacc-link:#a9d6ff;
 --cacc-border:#60768c; --cacc-gold:#ffbd00;
 /* Only the body text token is remapped. Brand colors retain their meaning. */
 --body:var(--cacc-text);
 background-color:var(--cacc-bg)!important; color:var(--cacc-text)!important;
}
body.cacc-dark-mode main,
body.cacc-dark-mode .page-wrapper { background-color:var(--cacc-bg)!important;color:var(--cacc-text)!important; }
body.cacc-dark-mode .bg-white,
body.cacc-dark-mode .bg-light,
body.cacc-dark-mode .bg-grey,
body.cacc-dark-mode .bg-gray,
