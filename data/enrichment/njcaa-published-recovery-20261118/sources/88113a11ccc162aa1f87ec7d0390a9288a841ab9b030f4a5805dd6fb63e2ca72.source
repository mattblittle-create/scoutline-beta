/* Place the appearance item BEFORE Menu: CACC mobile CSS keeps the last li visible. */
#cacc-header-theme-item {display:flex!important;align-items:stretch;list-style:none;margin:0!important;padding:0!important;border:0!important;}
#cacc-header-theme-toggle {display:flex;align-items:center;justify-content:center;width:44px;min-height:55px;height:100%;padding:0;border:0;border-left:1px solid #60768c;border-radius:0;background:#fff;color:#15385b;font-size:23px;cursor:pointer;}
#cacc-header-theme-toggle .cacc-theme-icon {color:inherit!important;}
#cacc-header-theme-toggle:focus-visible {outline:3px solid #b07800!important;outline-offset:-4px;}
body.cacc-dark-mode #cacc-header-theme-toggle {background:#283c50;color:#ffbd00;}
/* Preserve room for the logo on narrow phones and compact desktop headers. */
@media(max-width:359px){.header-wrapper .logo{width:175px;}}
@media(min-width:880px) and (max-width:1199px){.nav-wrapper ul li:nth-child(-n+3) a{padding-left:12px;padding-right:12px;}.nav-wrapper ul a{padding-left:10px;padding-right:10px;}.header-wrapper .btn-toggle-offcanvas{padding-left:15px;padding-right:15px;}}
