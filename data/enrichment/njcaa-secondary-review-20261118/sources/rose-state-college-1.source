            <script>
                require(['jquery', 'headroom', 'jquery-headroom', 'jquery-ui'], function($){
                    $(function(){
                        $('html').headroom({ offset: 48 });

                        $('.s-stickybar').headroom({ offset: 100 });

                        $.getScript("https://s3.amazonaws.com/assets.sidearmsports.com/common/js/jquery.scoreboard.js").done(function(){
                            $(".c-sticky__ticker").scoreboard({
                                "width":750, // container width
                                "height":84, // container height
                                "btns": "https://s3.amazonaws.com/assets.sidearmsports.com/common/images/scoreboard_buttons_white",
                                "bx": 0, // button left offset
                                "by": 36, // button top offset
                                "tx": 48, // ticker left offset
                                "ty": 0, // ticker top offset
                                "th": 84, // ticker height
                                "tw": 750 // ticker width
