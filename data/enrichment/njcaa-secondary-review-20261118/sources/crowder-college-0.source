<script>	
	$(window).on("load", function() {
		checkHeight();
		
		if($(window).outerWidth() > 990) {
			collapseMenu();
		}
		else {
			$('nav.navbar').attr("style","");
		}
		
		window.addEventListener("resize", checkHeight);
		
		const footerEl = document.querySelector('#siteFooter');
		const contentEl = document.querySelector('.fr-main');
		
		myObserver.observe(footerEl);
		myObserver.observe(contentEl);
	});
	
	const myObserver = new ResizeObserver(entries => {
		entries.forEach(entry => {
			checkHeight();
		});
	});
	
	/*** CHECKING IF MENU ITEMS NEED COLLAPSED ***/
    /*** ONLY ON PAGE LOAD ***/
    function collapseMenu(navWidth) {		
        var logoWidth = $('a.navbar-brand img').outerWidth();
		var itemNumber = 0;
		
        /** IF NO LOGO, SET TO 0 **/
        if (isNaN(logoWidth)) {logoWidth = 0;}

        if($("#fr-navbar").hasClass("fixedWidthNavbar")) {
           var windowWidth = 1080;
        }  
        else {
           var windowWidth = $(window).innerWidth();
        }

        var navWidth = 0;

        $("ul.nav li").each(function(index) {
            navWidth = navWidth + $(this).width();
			
			if(((navWidth + logoWidth + 120) > windowWidth) && !$(this).hasClass('socialDropdownIcons')) {
				$(this).addClass("overflowItem");
			}
			else if (!$(this).hasClass('socialDropdownIcons') && !$(this).hasClass('midlogo') && !$(this).width() == 0){
				itemNumber = itemNumber + 1;
				$(this).addClass("visibleMenuItem" + itemNumber);
			}
        });

        var totalWidth = navWidth + logoWidth + 120;

        if(totalWidth > windowWidth) {
            $(".overflowItem").hide();
			$("#earlyHamb").show();
			$("#earlyHamb").attr("tabindex","0")
			$(".overflowItem").appendTo(".overflowMenu");
			
			
			
			if ($('ul.nav').hasClass('navbar-right')) {
				$('ul.nav').attr('style','margin-right:50px;');
			}
        }
        else {
            $("#earlyHamb").hide();
        }
		
		$('nav.navbar').attr("style","");
    }
	
	/*** ADJUSTING PAGE HEIGHT AND CHECKING FOR FIXED FOOTER NEEDS ***/
	function checkHeight() {
		var footerHeight = $('.tr-site-footer').outerHeight();
		var pageHeight = $('.fr-wrapper').outerHeight();
		var windowHeight = $(window).innerHeight();
		var windowWidth = $(window).outerWidth();
		var socialHeight = $('.SocialWrapper.fixedWidth').outerHeight();
		var tempStyle = '';

		if ($("body").hasClass("leftnav") && $("body").hasClass("content-fixed")) {
				/* IF SITE IS FIXED WIDTH AND LEFT NAV - ALL SCENARIOS */
				$(".fr-body .fr-main").attr("style","min-height:calc(100vh - " + (footerHeight) + "px);");
			}
		else if ($(".contentSection.sectionPage").length < 1) {
			/* PAGE IS NOT A CONTAINER TYPE (expand page full screen height) */
			$("section.contentSection").css("min-height",""); /* reset min-height */
			tempStyle = $("section.contentSection").attr("style"); /* keep any other styles applied */

			if($("body").hasClass("no-offset")) {
				/* NOT OFFSET NAV */
				$("section.contentSection").attr("style","min-height:calc(100vh - " + (footerHeight + 75) + "px);" + tempStyle);
			}
			else {
				/* WITH OFFSET NAV */
				if($("body").hasClass("windowed")) {
					/* WINDOWED (Fixed width nav) - extra EXTRA spacing */
					$("section.contentSection").attr("style","min-height:calc(100vh - " + (footerHeight + 75 + 25) + "px);" + tempStyle);
				}
				else {
					/* NOT WINDOWED - no extra spacing */
					$("section.contentSection").attr("style","min-height:calc(100vh - " + (footerHeight) + "px);" + tempStyle);
				}
			}
		}
		else {
			/* PAGE IS A CONTAINER TYPE W/ SECTIONS */
			if (($("body").hasClass("siteWithNewLeftNav") || $("body").hasClass("fullscreen")) && $("body").hasClass("content-fixed") && $("body").hasClass("no-offset")) {
				/* THEME COMBINATIONS: top bar w left nav, fixed -- top logo center, fixed -- top full width, fixed */
				$(".fr-body .fr-main").attr("style","min-height:calc(100vh - " + (footerHeight + 75) + "px);");
			}
			
			else {
				/* THEME COMBINATIONS: top bar w left nav, full -- top full width, full -- top full width, full, offset -- logo center, full, offset -- top logo center, full // top logo center, fixed, offset -- top full width, fixed, offset -- top fixed width, fixed -- top fixed width, fixed, offset */
				$(".fr-body .fr-main").attr("style","min-height:calc(100vh - " + (footerHeight) + "px);");
			}

			/* CHECK IF WE NEED FIXED FOOTER */
			if (pageHeight + footerHeight < windowHeight) {
				$('.tr-site-footer').addClass('fixedFooter');
				/* IF SOCIAL IS IN FOOTER */
				if (socialHeight != null && (windowWidth > 992 && windowWidth < 1226)) {
					$("body.content-fixed .fr-main").css("bottom","");
					$("body.content-fixed .fr-main").css("position","");
					tempStyle = $('body.content-fixed .fr-main').attr("style");

					$('.SocialWrapper.fixedWidth').attr('style','bottom:'+footerHeight+'px;');
					$('body.content-fixed .fr-main').attr('style','position:static;' + tempStyle);
				}
			}
			else {
				$('.tr-site-footer').removeClass('fixedFooter');
			}
		}
    }	
	
	$("#earlyHamb").on('click',function(){
		$(".overflowItem").show();
		
		if($(this).hasClass("overflowOpen")) {
			$(this).removeClass("overflowOpen");
			$(".overflowMenu").slideUp();
		}
		else {
			$(this).addClass("overflowOpen");
			$(".overflowMenu").slideDown();
		}
	});
	
	$('#earlyHamb').keypress(function (e) {
	 var key = e.which;
	 if(key == 13 || key == 32)  // the enter + space key codes
	  {
		$(".overflowItem").show();
		
		if($(this).hasClass("overflowOpen")) {
			$(this).removeClass("overflowOpen");
			$(".overflowMenu").slideUp();
		}
		else {
			$(this).addClass("overflowOpen");
			$(".overflowMenu").slideDown();
		}
	  }
	});  
	
	var headerHeight = $('#fr-navbar').outerHeight();
	$(function() {
		if (window.location.hash) {
		   var hash = window.location.hash;
			
		   if ($(hash).length) {
			  $('html, body').animate({
				 scrollTop: $(hash).offset().top - headerHeight
			  }, 10);
		   }
		}
	});
	
	$(document).ready(function() {
		$('[data-toggle="popover"]').each(function () {
			var button = $(this);
			button.popover({container: 'body'}).on('shown.bs.popover', function() {
				button.data('bs.popover').tip().find('[data-dismiss="popover"]').on('click', function () {
					button.popover('toggle');
				});
			});
		});

		$('[data-toggle="popover"]').click(function(e) {
			$('[data-toggle="popover"]').not(this).popover('hide');
			var tTitle = $(this).data("original-title");
              $('.popover-title').html(tTitle + '<button id="popovercloseid" type="button" class="close">&times;</button>');
              $(this).popover();

          });

      $(document).click(function(e) {
         if(e.target.id=="popovercloseid" )
         {
              $('[data-toggle="popover"]').popover('hide');
         }

      });
		
		$('.navbar a, .tr-leftnav a').on("click",function(e) {
			if($(this).attr("href") == "https://www.crowderbaseballcamps.com/#") {
				e.preventDefault();
			}
		});
    });
	
	$(function () {
		$('.main-nav a:not(.dropdown-toggle)').bind('click', function(event) {
			var $anchor = $(this);
		$('html, body').stop().animate({
			scrollTop: $($anchor.attr('href')).offset().top + 350
		}, 4500, 'easeInOutQuart');
		event.preventDefault();
		});
	});
	

</script>
</body>
</html>

