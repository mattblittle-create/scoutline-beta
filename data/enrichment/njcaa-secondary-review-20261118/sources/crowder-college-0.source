	<script>
        $(document).ready(function () {
			$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8').carousel({ interval: 5000 });
			$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8').on('slide', function() {
				var to_slide = $('.carousel-inner .item.active').attr('id');
				$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8 .carousel-indicators').children().removeClass('active');
				$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8 .carousel-indicators [data-slide-to=' + to_slide + ']').addClass('active');
			});
			
			$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8 .carousel-indicators li').click(function(e){
				e.stopPropagation();
				var goTo = $(this).data('slide-to');
				$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8 .carousel-inner .item').each(function(index){
					if($(this).data('id') == goTo){
						goTo = index;
						return false;
					}
				});		
				$('#mySlideshowCarousel-8E872862-DDD6-0980-72A6-183F8D6A07A8').carousel(goTo); 
			});
        });
    </script>

