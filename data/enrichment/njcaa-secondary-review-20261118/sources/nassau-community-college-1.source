                                    <!-- /ko -->
                                    <!-- ko if: isCouponAvailable -->
                                    <li class="sidearm-form-field sidearm-form-field-text">
                                        <label class="sidearm-form-field-label" for="coupon-code">Coupon Code</label>
                                        <div class="sidearm-form-field-coupon">
                                            <div class="coupon-inputs">
                                                <input id="coupon-code" class="sidearm-form-field-input" data-bind="value: couponCodeText, disable: couponCodeApplied || isSubmitting">
                                                <button class="sidearm-form-button sidearm-form-button-submit" data-bind="text: couponCodeApplied() ? 'Clear' : 'Apply', click: couponCodeApplied() ? clearCoupon : applyCoupon, enable: isOpenForSubmission, css: { 'sidearm-form-button-submitting' : isSubmitting }">
                                                </button>
                                            </div>
                                            <div class="sidearm-form-coupon-message" data-bind="css: { 'sidearm-form-coupon-error' : couponCodeMessageHasError }, visible: couponCodeMessage">
                                                <span data-bind="text: couponCodeMessage"></span>
                                                <span data-bind="formatCurrency: discountTotal, visible: discountTotal"></span>
                                            </div>
                                        </div>
                                    </li>
                                    <!-- /ko -->
                                    <!-- ko if: isPaymentEnabled -->
                                        <li class="sidearm-form-field sidearm-form-payment-amount-container">
                                            <div class="sidearm-form-payment-amount">Amount Due: <span data-bind="formatCurrency: paymentTotal"></span></div>
                                        </li>
                                    <!-- /ko -->
                                    <li class="sidearm-form-field sidearm-form-buttons">
                                        <button class="sidearm-form-button sidearm-form-button-submit" data-bind="text: submitButtonText, click: submitForm, disable: isSubmitting, enable: isOpenForSubmission, css: { 'sidearm-form-button-submitting' : isSubmitting }">
                                        </button>
                                    <br><br>
                                    <p class="sidearm-form-recaptcha-disclaimer">This site is protected by reCAPTCHA and the 
                                            <a href="https://policies.google.com/privacy">Google Privacy Policy</a> and
                                            <a href="https://policies.google.com/terms">Google Terms of Service</a> apply.
                                    </p>
                                    </li>
                                </ol>


                            </fieldset>
            
                        <!-- /ko -->

                    <!-- /ko -->
                <!-- /ko -->

                <!-- ko if: shouldShowThankYou -->
                    <div data-bind="html: thankYouText"></div>
                <!-- /ko -->

                <!-- ko if: shouldShowError -->
                    <div data-bind="html: errorText"></div>
                <!-- /ko -->
				
				<script src="//cdnjs.cloudflare.com/ajax/libs/require.js/2.2.0/require.min.js" type="text/javascript"></script>
				<script src='/components/js/config.js'></script>
                
				<script src='https://www.google.com/recaptcha/api.js?onload=onloadRecaptchaCallbackv2&render=explicit'></script>
                <script src="https://www.google.com/recaptcha/api.js?onload=onloadRecaptchaCallbackv2&render=explicit" async="" defer="">
                </script>
                <script src="https://www.google.com/recaptcha/api.js?render=6Lc8MZoUAAAAAM62lHHFbc2suq4sN7ubpuaDH8Kh"></script>
				<script>
                    var recaptcha_loaded = false;
                    var onloadRecaptchaCallbackv2 = function () {
                        recaptcha_loaded = true;
                    };

                    require(['knockout', 'jquery', 'pikaday', 'moment', 'validation', 'visible', 'switch-case'], function (ko, $, Pikaday, moment) {
						var Form = function () {
							var self = this;

							self.shouldShowForm = ko.observable(true);
							self.shouldShowThankYou = ko.observable(false);
                            self.shouldShowError = ko.observable(false);

							self.isLoading = ko.observable(true);
							self.isSubmitting = ko.observable(false);
                            self.isValidationEnabled = ko.observable(false);
                            self.isOpenForSubmission = true;

							self.id = ko.observable();
							self.title = ko.observable();
							self.description = ko.observable();
							self.fields = ko.observableArray([]);
							self.submitButtonText = "Submit Form";
							self.thankYouText = ko.observable();
							self.errorText = ko.observable();
							self.isPaymentEnabled = false;
							self.isCouponAvailable = false;

                            self.requiredAbbr = "<abbr class=\"sidearm-abbr-required\" title=\"required\">*</abbr>";     
							$.getJSON("/services/responsive-sb_output.ashx", { form: 3, type: "get_form" }, function (data) {

                                self.id = data.id;
                                self.title = data.title;
                                self.description = data.description != null ? data.description : ' ';

								var _fields = ko.utils.arrayMap(data.fields, function (field) {
									return new Field(field, self);
								});
								self.fields.push.apply(self.fields, _fields);

								self.isPaymentEnabled = data.payment_enabled;

                                if (self.isPaymentEnabled) {
                                    self.submitButtonText = "Continue to Payment";
                                    self.isCouponAvailable = data.coupons_available;
                                    self.paymentFormType = data.payment_form_type;

                                    self.couponCodeText = ko.observable("");
                                    self.couponAmount = ko.observable(0);
                                    self.couponType = ko.observable("");
                                    self.couponCodeApplied = ko.observable(false);
                                    self.couponCodeMessage = ko.observable("");
                                    self.couponCodeMessageHasError = ko.observable(false);

                                    self.formTotal = ko.computed(function() {
                                        var total = 0;
                                        ko.utils.arrayForEach(self.fields(), function (field) {
                                            if (field.is_payment_field) {
                                                if (self.paymentFormType == "multiple") {
                                                    switch (field.type) {
                                                        case "T": case "N":
                                                            total += (!isNaN(field.finalValue())) ? Number(field.finalValue()) : 0;
                                                            break;
                                                        case "Q":
                                                            total += field.payment_amount * ((!isNaN(field.finalValue()["value"])) ? Number(field.finalValue()["value"]) : 0);
                                                            break;
                                                        case "S": case "R": case "C": case "Y":
                                                            if (!isNaN(field.finalValue().length)) {
                                                                ko.utils.arrayForEach(field.finalValue(), function (option) {
                                                                    total += option.payment_amount;
                                                                });
                                                            } else if (!isNaN(field.finalValue()["payment_amount"])) {
                                                                total += field.finalValue()["payment_amount"];
                                                            }
                                                            break;
                                                        default:
                                                            total += field.payment_amount;
                                                    }
                                                } else {
                                                    total += (field.type == "Q")
                                                        ? field.payment_amount * field.finalValue()["value"]
                                                        : field.finalValue();
                                                }
                                            }
                                        });
                                        return total;
                                    });

                                    self.discountTotal = ko.computed(function() {
                                        var total = 0;
                                        if (self.couponAmount() > 0) {
                                            if (self.couponType() == "d") {
                                                total = self.couponAmount();
                                            } else {
                                                total = self.formTotal() * (self.couponAmount() / 100);
                                            }
                                        }
                                        return total;
                                    });

                                    self.paymentTotal = ko.computed(function () {
                                        return self.formTotal() - self.discountTotal();
                                    });

                                    self.applyCoupon = function() {
                                        self.isSubmitting(true);
                                        return $.getJSON("/services/responsive-sb_output.ashx", {
                                            form: self.id, 
                                            type: "verify_coupon",
                                            coupon_code: self.couponCodeText()
                                        }, function(coupon_data) {
                                            self.isSubmitting(false);
                                            if (coupon_data !== null) {
                                                self.couponAmount(coupon_data.amount);
                                                self.couponType(coupon_data.type);
                                                self.couponCodeMessage("coupon applied:");
                                                self.couponCodeMessageHasError(false);
                                                self.couponCodeApplied(true);
                                            } else {
                                                self.couponAmount(0);
                                                self.couponType("");
                                                if (self.couponCodeText() == "") {
                                                    self.couponCodeMessage("");
                                                } else {
                                                    self.couponCodeMessage("coupon is invalid");
                                                    self.couponCodeMessageHasError(true);
                                                }
                                            }
                                        });
                                    }

                                    self.clearCoupon = function() {
                                        self.couponCodeApplied(false);
                                        self.couponAmount(0);
                                        self.couponType("");
                                        self.couponCodeText("");
                                        self.couponCodeMessage("");
                                    }
                                }

								self.isLoading(false);
								
								$('.sidearm-form-fieldset').show();

                                if (view_model.isPaymentEnabled) {
                                    $(window).scroll(function () {
                                        var container_not_visible = !$(".sidearm-form-payment-amount-container").visible();
                                        $(".sidearm-form-payment-amount").toggleClass("sticky", container_not_visible);
                                    });
                                }

                                toggleConditionalFields();
                            });

                            self.submitForm = function () {
                                var submitted_time = new Date();
                                var elasped_time = (submitted_time - 1795013015890.66) * .001;
                                if (elasped_time < 1.5) {
                                    self.isSubmitting(true)
                                    self.shouldShowForm(false);
                                    return;
                                }
                                self.isSubmitting(true);
                                self.isValidationEnabled(true);

                                var errors = ko.validation.group(self.fields());
                                if (errors().length > 0) {

                                    $("#submit_error_message").text("There are errors with your form submission. Please correct the fields noted below.");

                                    var fieldset_position = $(".sidearm-form-fieldset:first-of-type").offset().top;
                                    if (fieldset_position < $(window).scrollTop()) {
                                        $("html, body").animate({ scrollTop: fieldset_position - 70 }, 250);
                                    }

                                    self.isSubmitting(false);
                                    errors.showAllMessages();
                                    return false;
                                
                                } else {

                                    $("#submit_error_message").text("");

                                }

                                var _fields = ko.utils.arrayMap(self.fields(), function (field) {
                                    var value = field.finalValue();
                                    var price = field.is_payment_field && typeof value !== "object" && !isNaN(value) ? value : 0;
                                    if (field.type == "Q") {
                                        price = field.is_payment_field && value && !isNaN(value.value) ? field.payment_amount * value.value : 0;
                                    }
                                    if (typeof value === "string") {
                                        value = value.replace(/\n/g, '<br >');
                                    }
                                    return { id: field.id, value: value, type: field.type, price: price }
                                });

                                var _post = {
                                    form: self.id,
                                    fields: JSON.stringify(_fields)
                                };

                                if (self.isPaymentEnabled) {
                                    _post["payment_enabled"] = true;
                                    _post["payment_amount"] = self.formTotal();
                                    _post["coupon_code"] = self.couponCodeApplied() ? self.couponCodeText() : "";
                                }
                                grecaptcha.execute('6Lc8MZoUAAAAAM62lHHFbc2suq4sN7ubpuaDH8Kh', { action: 'submit' }).then(function(token) {
                                    _post["captcha"] = token;
                                    $.post("/services/responsive-sb_output.ashx", _post)
                                                            .done(function(response) {
                                        if (self.isPaymentEnabled)
                                        {
                                            location.href = response.redirect;
                                        }
                                        else
                                        {
                                            self.shouldShowForm(false);
                                            self.shouldShowThankYou(true);
                                            self.shouldShowError(false);

                                            var thanks_message = response.message || "Thank you, your form submission has been received.";

                                            self.thankYouText(thanks_message);
                                        }
                                    }).fail(function(response) {
                                        self.shouldShowForm(false);
                                        self.shouldShowThankYou(false);
                                        self.shouldShowError(true);

                                        self.errorText("<p>An error occurred while processing this submission. Please try again or contact the site administrator for help.</p>");

                                    }).always(function() {
                                        if (!self.isPaymentEnabled)
                                        {
                                            $('html, body').animate({ scrollTop: $('.sidearm-form').offset().top }, 250);
                                        }
                                    });
                                 });
                                
							};
						};

						var Field = function (data) {
                            var self = this;
                            
							self.id = data.id;
							self.type = data.type;
							self.title = data.title;
							self.required = data.required;
                            self.size = data.size;
							self.max_length = data.max_length;
							self.show_current_date = data.show_current_date;
							self.is_email_field = data.is_email_field;
							self.options = ko.observableArray([]);
							self.default_value = data.default_value;
                            self.max_quantity = data.max_quantity;
                            self.is_conditional_field = data.is_conditional_field;
                            self.conditions = ko.observableArray([]);
							self.is_payment_field = data.is_payment_field;
                            self.payment_amount = data.payment_amount;
                            self.is_visible = ko.observable(true);
                            self.show_other_answer = ko.observable(false);
							
							var _options = ko.utils.arrayMap(data.options, function (option) {
								return new Option(option);
							});
                            self.options.push.apply(self.options, _options);

                            var _conditions = ko.utils.arrayMap(data.conditions, function (condition) {
                                return new Condition(condition);
                            });
                            self.conditions.push.apply(self.conditions, _conditions);

							var _singleValueTypes = ['T','N','Y','5','Q','R','O','S','A','D','H','L'];
							var _multiValueTypes = ['Z','B','C','P','M'];
							
                            self.value = ko.observable().extend({
                                required: {
                                    onlyIf: function () { return view_model.isValidationEnabled() && self.required && self.is_visible() && ($.inArray(self.type, _singleValueTypes) > -1); }
                                },
                                pattern: {
                                    onlyIf: function() { return self.type == 'N'; },
                                    message: 'Please enter only numbers.',
                                    params: /^[0-9]*$/
                                },
                                email: self.is_email_field
                            });
                            self.values = ko.observableArray().extend({
                                required: {
                                    onlyIf: function () { return view_model.isValidationEnabled() && self.required && self.is_visible() && ($.inArray(self.type, _multiValueTypes) > -1); }
                                },
                                validation: {
                                    validator: function (valArr) {
                                        return valArr.every(function (val) {
                                            return val.value != "";
                                        });
                                    },
                                    message: 'Must enter other value',
                                    onlyIf: function () {
                                        return self.required;
                                    }
                                }
                            });

                            switch (self.type) {
                                case "T": case "N": case "H":
                                    if (self.payment_amount || self.default_value) {
                                        self.value(self.payment_amount || self.default_value);
                                    }
                            }

                            ko.utils.arrayForEach(self.options(), function (option) {
                                if (option.selected) self.values.push(option);
                            });

                            self.finalValue = ko.computed(function () {
                                return determineFinalValue(self);
                            });

                            self.show_other_answer.subscribe(function () {
                                if (self.show_other_answer()) {
                                    ko.utils.arrayForEach(self.values(), function (value) {
                                        if (value.show_other_answer) {
                                            value.value = ""
                                            self.values.valueHasMutated();
                                        }
                                    })
                                }
                            });

                            self.value.subscribe(function () {
                                toggleConditionalFields();
                            });

                            self.finalValue.subscribe(function (value) {
                                // Determine if the "Other Answer" textbox should be displayed
                                if (typeof value !== "string") {
                                    if (Array.isArray(value)) {
                                        var show_other_answer = false;
                                        ko.utils.arrayForEach(value, function (option) {
                                            if (option.show_other_answer) show_other_answer = true;
                                        });
                                        self.show_other_answer(show_other_answer);
                                    } else {
                                        self.show_other_answer(value.show_other_answer);
                                    }
                                }
                            });

						    self.applyOtherAnswer = function () {
						        return determineFinalValue(self);
						    };
                        };

                        var Option = function (data) {
                            var self = this;

                            self.id = data.id;
                            self.title = data.title;
                            self.value = data.value || data.title;
                            self.selected = data.selected;
                            self.show_other_answer = data.show_other_answer;
                            self.payment_amount = data.payment_amount;

                            if (data.title == "Select...") {
                                self.value = "";
                            }
                        }

                        var Condition = function (data) {
                            var self = this;

                            self.id = data.id;
                            self.field = data.field;
                            self.logic = data.logic;
                            self.value = data.value;
                        }

                        //

                        ko.bindingHandlers.pikaday = {
                            init: function (element, valueAccessor, allBindings) {
                                var format = ko.unwrap(allBindings.get("format")) || "YYYY-MM-DD",
                                    minDate = ko.unwrap(allBindings.get("minDate")) || null,
                                    maxDate = ko.unwrap(allBindings.get("maxDate")) || null,
                                    disableWeekends = ko.unwrap(allBindings.get("disableWeekends")) || null,
                                    showDefaultDate = allBindings.get("showDefaultDate") || false;

                                valueAccessor().pikstore = new Pikaday({
                                    field: element,
                                    format: format,
                                    minDate: minDate,
                                    maxDate: maxDate,
                                    disableWeekends: disableWeekends,
                                    setDefaultDate: showDefaultDate,
                                    defaultDate: new Date(),
                                    onSelect: function (d) { valueAccessor()(d); },
                                    onClose: function () {
                                        var el = element;
                                        var moment_val = moment(el.value);
                                        if (el.value == "" || !moment_val.isValid()) {
                                            valueAccessor()(null);
                                        }
                                    }
                                });

                                if (showDefaultDate) {
                                    valueAccessor().pikstore.setDate(new Date());
                                }
                            },
                            update: function (element, valueAccessor, allBindings) {
                                var valueUnwrapped = ko.unwrap(valueAccessor());
                                valueAccessor().pikstore.setDate(valueUnwrapped);
                            }
                        };

                        ko.bindingHandlers.formatCurrency = {
                            update: function (element, valueAccessor) {
                                var value = ko.unwrap(valueAccessor());
                                if (value === null || isNaN(value))
                                    $(element).text("N/A");
                                else
                                    $(element).text("$" + parseFloat(value).toFixed(2));
                            }
                        };

                        //

                        function toggleConditionalFields() {
                            // Loop through each conditional field and toggle it based on it's display conditions
                            ko.utils.arrayForEach(view_model.fields(), function (field) {
                                if (field.is_conditional_field) {
                                    toggleConditionalField(field);
                                }
                            });
                        }

                        function toggleConditionalField(field) {
                            var show_field = false;
                            ko.utils.arrayForEach(field.conditions(), function (condition) {
                                var matched_field = ko.utils.arrayFirst(view_model.fields(), function (field) {
                                    return field.id === condition.field;
                                });
                                if (matched_field != null) {
                                    if (condition.value == "any") {
                                        show_field = true;
                                    } else {
                                        var matched_option = ko.utils.arrayFirst(matched_field.options(), function (option) {
                                            return option.id.toString() === condition.value;
                                        });
                                        if (matched_option != null) {
                                            if (!isNaN(matched_field.finalValue().length)) {
                                                ko.utils.arrayForEach(matched_field.finalValue(), function (option) {
                                                    if (option.id === matched_option.id) {
                                                        show_field = true;
                                                    }
                                                });
                                            } else if (!isNaN(matched_field.finalValue()["id"])) {
                                                show_field = (matched_field.finalValue()["id"] === matched_option.id);
                                            } else {
                                                show_field = false;
                                            }
                                        }
                                    }
                                }
                                if (condition.logic == "Is Not") {
                                    show_field = !show_field;
                                }
                            });

                            field.is_visible(show_field);

                            if (!show_field) {
                                field.value("").values([]);
                            }
                        }

                        function determineFinalValue(field) {
                            var value = field.value() || field.values();
                           
                            if (field.show_other_answer() && typeof value !== "string") {
                                if (Array.isArray(value)) {
                                    ko.utils.arrayForEach(value, function (option) {
                                        if (option.show_other_answer) {
                                            var other_value = $('#field-other-' + field.id).val();
                                            option.value = other_value;
                                            field.values.valueHasMutated();
                                        }
                                    });
                                } else {
                                    var other_value = $('#field-other-' + field.id).val();
                                    if (other_value !== "") value.value = other_value;
                                }
                            }

                            return value;
                        }

                        ko.validation.init({ insertMessages: false, errorElementClass: 'validation-error', grouping: { deep: true } });

                        var view_model = new Form();
                        ko.applyBindings(view_model, $('.sidearm-form')[0]);
                    });
                </script>
            
			
