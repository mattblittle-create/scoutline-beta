				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Kerri Ann McTiernan","value":1},{"label":"J.P. Brazel","value":268},{"label":"Juliet Burns","value":262},{"label":"Nicholas O'Malley","value":259},{"label":"Jhaleel Oswald","value":264},{"label":"Caitlin Zowak","value":224},{"label":"Eduard Garcia","value":169},{"label":"Brian Mangan","value":258},{"label":"Rick Morales","value":7},{"label":"Veronica Vigorito","value":235},{"label":"Curtis Guilliam","value":5},{"label":"Darwin Tavarez","value":55},{"label":"Nicole Chaplik","value":116},{"label":"Larry Minor","value":8},{"label":"Sean Monaghan","value":30},{"label":"Adam Docar","value":240},{"label":"A.J. Wynder","value":11},{"label":"Sharif Fordham","value":34},{"label":"DeWitt Jones","value":35},{"label":"Josh Broderick","value":208},{"label":"Bryant Lassiter","value":251},{"label":"Claude Ellis","value":276},{"label":"Laurie Kolodny","value":32},{"label":"Erica Groover","value":175},{"label":"Bria Green","value":176},{"label":"Oscar Mercado","value":267},{"label":"Jim Muller","value":278},{"label":"HC TBA","value":147},{"label":"Jhaleel Oswald","value":153},{"label":"Theron Grinage","value":94},{"label":"Andrew Hodge","value":193},{"label":"Luis Sorto","value":221},{"label":"Liam Oswald","value":246},{"label":"Nana White","value":244},{"label":"Mark Campbell","value":225},{"label":"Robert Thomas","value":263},{"label":"Kevin Smithwick","value":271},{"label":"Amanni Stewart","value":272},{"label":"John Jordan","value":162},{"label":"JP Brazel","value":266},{"label":"Jack Dellipizzi","value":275},{"label":"Ron Kraemer","value":281},{"label":"Dan Fisher","value":18},{"label":"Damiano Diliberti","value":157},{"label":"John Paul Hughes","value":155},{"label":"Jordan Russolillo","value":156},{"label":"Christian Turizo","value":254},{"label":"Thomas Anson","value":223},{"label":"Dan Bernstein","value":250},{"label":"Hailey Hnis","value":273},{"label":"Madison Hnis","value":274},{"label":"Eugenia Bradshaw","value":252},{"label":"Terry Daly","value":256},{"label":"Jim Muller","value":278},{"label":"Nick O'Malley","value":179},{"label":"Jason Siriban","value":211},{"label":"Jonathan Mootoo","value":247},{"label":"Christopher Harkins","value":219},{"label":"Rachel Foley","value":230},{"label":"Jason Siriban","value":211},{"label":"Jonathan Mootoo","value":247},{"label":"Vougar Oroudjov","value":212},{"label":"Aeriell Clem","value":280},{"label":"Mac Maldarelli","value":53},{"label":"Mason .","value":279},{"label":"Vougar Oroudjov","value":212},{"label":"Aeriell Clem","value":280},{"label":"Mac Maldarelli","value":53},{"label":"Mason .","value":279}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

