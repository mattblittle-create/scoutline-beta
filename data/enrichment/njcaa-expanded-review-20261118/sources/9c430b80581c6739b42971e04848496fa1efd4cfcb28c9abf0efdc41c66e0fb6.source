              <div class="field__item"><a href="/student-experience/athletics/e-sports">E-sports</a></div>
          </div>
  
        </div>
            
              <div class="links-block__cta">
          
        </div>
            </div>
</div>
          </div>
  
      </div>
          </div>
</div>
              <div class="field__item">



  <div class="carousel-text paragraph">
                  <h2 class="carousel-text__sec-heading paragraph__header">
          Intramural Sports
        </h2>
      
              <div class="carousel-text__intro paragraph__intro">
          Enjoy the thrill of competition without the pressure of Intercollegiate Athletics. No experience is necessary, and all are welcome to join any of the pick-up games. For the fall schedule, please check out The Q and the posted signs on campus.
        </div>
      
