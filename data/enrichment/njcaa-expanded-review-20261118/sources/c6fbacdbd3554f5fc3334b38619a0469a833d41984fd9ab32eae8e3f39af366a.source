			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Scott Schumacher","value":1},{"label":"Debbie Watson","value":3},{"label":"Erica Thurman","value":36},{"label":"Joe Alberico","value":4},{"label":"Dusty Hart","value":5},{"label":"Greg Evans","value":62},{"label":"Chase Van Dyk","value":63},{"label":"Ryan Mahon","value":11},{"label":"Danny Palmer","value":64},{"label":"Chuck Parsons","value":15},{"label":"Andy Felton","value":13},{"label":"Kenneth Braimer","value":51},{"label":"Steven Palmer","value":67},{"label":"Nathan Jackson","value":68},{"label":"Scott Schumacher","value":35},{"label":"Anthony Maxwell","value":42},{"label":"Everett Nelson","value":65},{"label":"Jeff Jenkins","value":24},{"label":"Bela Raimondi","value":61},{"label":"Gregg Whitis","value":58},{"label":"Maddie Jackson","value":60},{"label":"Sarah Barland Flisowski","value":9},{"label":"Amanda Logback","value":10},{"label":"Sarah Barland Flisowski","value":9},{"label":"Amanda Logback","value":10},{"label":"Gary Belt","value":44},{"label":"Michael Fluty","value":72},{"label":"Gary Belt","value":45},{"label":"Michael Fluty","value":72},{"label":"Michael McBride","value":30},{"label":"Rudy Roediger","value":31},{"label":"Alexandria Jackson","value":26},{"label":"Marco Gonzalez Salazar","value":73},{"label":"Jami Ingram","value":23},{"label":"Brittany Arredondo","value":69},{"label":"Jesse Parker","value":53},{"label":"Jesse Parker","value":53},{"label":"Kyle Murto","value":33},{"label":"Ryan Lucich","value":34},{"label":"Patrick Daley","value":59},{"label":"Gene Kirkpatrick","value":46},{"label":"Michael Garcia","value":55},{"label":"Kelly Killfoil","value":57},{"label":"Sarah Burke","value":70},{"label":"Carnell Simmons","value":71}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

    </main>
