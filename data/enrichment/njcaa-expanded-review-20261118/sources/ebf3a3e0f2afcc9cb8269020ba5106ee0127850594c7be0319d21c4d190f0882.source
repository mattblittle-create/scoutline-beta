                        </a>
                        <a class="btn btn-outline-secondary " data-view="grid"  href="/sports/bsb/headlines-featured?view=grid">
                            <span class="fas fa-th-large" aria-hidden="true"></span>
                            <span class="sr-only">Grid View</span>
                        </a>
