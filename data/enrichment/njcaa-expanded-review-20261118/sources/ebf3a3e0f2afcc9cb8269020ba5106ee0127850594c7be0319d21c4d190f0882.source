                    <div class="story-filter-groups">    <div class="stories mb-3 row">
                                                                                   
                                
                        
            <div class="col-12 ">
                    <div class="my-3 card d-flex flex-row justify-content-center align-items-center ">
                                                                                                <div class="card-header border-0 d-none d-sm-block">
                                                <img src="/sports/bsb/2025-26/95ab539c-3648-4085-9b88-b127445c8712.png?max_width=567&useS3=true" alt="Patrick & Henry Community College baseball graphic with a white background and royal blue and yellow accents. The P&H Patriots logo appears at the top above the headline, “Patriots Place Three on Region 10 Postseason Teams.” The bottom section recognizes three student-athletes: Hunter DePriest, listed as RHP/OF from Alleghany, Virginia; Toby Wilson, listed as RHP from Asheville, North Carolina; and Josh Hall, Jr., listed as INF/RHP from Lynchburg, Virginia." class="img-fluid img-mh-6 img-mw-8" />
                                        </div>
                                                                                <div class="card-body w-100">
                                                                            <h5 class="card-title p-0 m-0"><a href="/sports/bsb/2025-26/releases/20260507jpx70v">Patriots Place Three on Region 10 Postseason Teams</a></h5>
                                    
                                                                        <p class="card-text text-muted"><small>May 07, 2026</small></p>
                                                                        
                                                                    
                        </div>
                    </div>
            </div>                                                                                    
                                
                        
            <div class="col-12 ">
                    <div class="my-3 card d-flex flex-row justify-content-center align-items-center ">
                                                                                                <div class="card-header border-0 d-none d-sm-block">
                                                <img src="/sports/bsb/2025-26/e42dbe65-0070-4472-ac70-bf635c594b37.jpg?max_width=567&useS3=true" alt="Graphic showing the final score from Patrick & Henry Community College baseball’s game against Guilford Tech. The design features a blue and yellow background with multiple Patriot logos and a game-action photo of Patriots players celebrating near home plate. On the right side, a scoreboard graphic reads “Final” with Patrick & Henry Community College listed with 0 runs, 7 hits, and 1 error, while Guilford Tech is listed with 1 run, 6 hits, and 0 errors. The Guilford Tech Titans logo appears in the bottom right corner, and a Region 10 logo appears on the left side." class="img-fluid img-mh-6 img-mw-8" />
                                        </div>
                                                                                <div class="card-body w-100">
                                                                            <h5 class="card-title p-0 m-0"><a href="/sports/bsb/2025-26/releases/20260428v8nnn4">Patriots Drop Heartbreaker in Pitcher&rsquo;s Duel on Sophomore Day</a></h5>
                                    
                                                                        <p class="card-text text-muted"><small>April 28, 2026</small></p>
                                                                        
                                                                    
                        </div>
                    </div>
            </div>                                                                                    
                                
                        
            <div class="col-12 ">
                    <div class="my-3 card d-flex flex-row justify-content-center align-items-center ">
                                                                                                <div class="card-header border-0 d-none d-sm-block">
                                                <img src="/sports/bsb/2025-26/IMG_6355.JPG?max_width=567&useS3=true" alt="Final score graphic for a Patrick & Henry Community College baseball game against Guilford Technical Community College. The image shows a group of Patrick & Henry baseball players in black jerseys and gray pants gathered in a huddle on the field with hands raised together. On the right side of the graphic, a scoreboard displays the final result: P&HCC scored 2 runs on 3 hits with 1 error, while Guilford Tech scored 16 runs on 20 hits with 1 error. Team logos for Patrick & Henry and Guilford Tech appear above the score, with blue and yellow graphic accents and a Region 10 logo." class="img-fluid img-mh-6 img-mw-8" />
                                        </div>
                                                                                <div class="card-body w-100">
                                                                            <h5 class="card-title p-0 m-0"><a href="/sports/bsb/2025-26/releases/20260422qhjoy4">Patriots Fall to Guilford Tech in Midweek Region 10 Matchup</a></h5>
                                    
                                                                        <p class="card-text text-muted"><small>April 22, 2026</small></p>
                                                                        
                                                                    
                        </div>
                    </div>
            </div>                                                                                    
                                
                        
            <div class="col-12 ">
                    <div class="my-3 card d-flex flex-row justify-content-center align-items-center ">
                                                                                                <div class="card-header border-0 d-none d-sm-block">
                                                <img src="/sports/bsb/2025-26/229282b2-c31f-43fe-baf8-1104a0e160a8.jpg?max_width=567&useS3=true" alt="Final score graphic for a Patrick & Henry Community College baseball game against Catawba Valley Community College. Scoreboard shows Catawba Valley with 13 runs, 16 hits, and 1 error, while Patrick & Henry has 5 runs, 11 hits, and 1 error. On the right side, two Patrick & Henry team members in blue apparel walk side by side with one player placing an arm around the other. Blue and yellow team branding fills the background, with a Region 10 logo in the bottom left corner." class="img-fluid img-mh-6 img-mw-8" />
