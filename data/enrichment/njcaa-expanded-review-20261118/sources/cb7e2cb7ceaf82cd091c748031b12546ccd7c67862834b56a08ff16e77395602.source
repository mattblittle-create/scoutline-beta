<script>

function getParameterByName( name )
{
	name = name.replace(/[\[]/,"\\\[").replace(/[\]]/,"\\\]");
	var regexS = "[\\?&]"+name+"=([^&#]*)";
	var regex = new RegExp( regexS );
	var results = regex.exec( window.location.href );
	if (results == null)
		return "";

    return decodeURIComponent(results[1].replace(/\+/g, " "));
}

function failed() {
	alert("Game Not Found");
}

function body_onload() {
	var gg = getParameterByName("g");
	var hk = getParameterByName("hk");
	var dg = getParameterByName("dg");
	if (gg != "" || hk != "") {
		g_isFirstLoad = true;
		_game = new FBGame(gg, dg, dg, hk, "", 
			(game) => {
				console.log("game", game);
				var url = "https://sites.iscoresports.com/central/scorecast/" + game.guid + "?legacy=true&sport=baseball";
				document.location.href = url;
			},
			() => {
				failed();
			}
		);
	} else {
		failed();
	}
}

</script>

</head>

<body onload='body_onload()' bgcolor='#000000' style="overflow:hidden">

	Loading...

</body>
</html>
