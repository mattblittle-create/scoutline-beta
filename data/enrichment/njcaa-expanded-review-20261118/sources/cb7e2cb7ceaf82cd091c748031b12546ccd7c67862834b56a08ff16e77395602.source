<style>
a:link {
COLOR: #fff2bb;
}
a:visited {
COLOR: #fff2bb;
}
a:hover {
COLOR: #fff2bb;
}
a:active {
COLOR: #fff2bb;
}

.pbp-container a:link{color:#FFFFFF}
.pbp-container a:visited{color:#FFFFFF}
.pbp-container a:hover{color:#FFFFFF}
.pbp-container a:active{color:#FFFFFF}

.login_inptx { border:inset 1px black;background-color:#b6cec1;color:black; }
.login_inpt_label { font-family:arial;font-weight:bold;color:#DDDDDD;font-size:11pt; }
.login_instructions{ font-family:arial;font-weight:normal;color:#DDDDDD;font-size:11pt; }

.gameList{color:#ffffff;font-size:12pt;font-family:Arial;font-weight:bold}
.gameListItem{cursor:pointer;cursor:hand}

.statusYellowText{color:#f5c70e;font-size:16pt;font-family:Arial;font-weight:normal}

.boxscore_header{font-family:Arial;font-size:17pt;font-weight:bold;color:#AAAAAA;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#888888;}
.boxscore_row{font-family:Arial;font-size:17pt;font-weight:bold;color:#DDDDDD}
.boxscore_runs{font-family:Arial;font-size:17pt;font-weight:bold;color:#f5c70e}


.pbp-container{}
.even{background-color:#000000;font-family:Arial;font-size:10pt;color:#FFFFFF}
.odd{background-color:#222222;font-family:Arial;font-size:10pt;color:#FFFFFF}
.pbp-section{font-family:Arial;font-size:9pt;font-weight:bold}

.pbp-header{font-size:9pt;font-family:Arial;padding-bottom:3;padding-top:7;color:#AAAAAA;background-color:#333333;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#AAAAAA;border-top-style:solid;border-top-width:1px;border-top-color:#AAAAAA}
.pbp-header-font{font-size:9pt;font-family:Arial;color:#AAAAAA;background-color:#333333;}

.pbp-header a:link{color:#AAAAAA}
.pbp-header a:visited{color:#AAAAAA}
.pbp-header a:hover{color:#AAAAAA}
.pbp-header a:active{color:#AAAAAA}

.playerCell{background-color:#462c16;font-size:10pt}
.headerCell{background-color:#10182F;font-size:10pt}
.rowCell{border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#222222;border-top-style:solid;border-top-width:1px;border-top-color:#444444}

.fielder{width:120;text-align:center;background-color:#446644;overflow:hidden;height:17;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#222222;border-top-style:solid;border-top-width:1px;border-top-color:#AAAAAA;}
.runner{width:120;text-align:center;background-color:#aa7600;overflow:hidden;height:17;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#222222;border-top-style:solid;border-top-width:1px;border-top-color:#AAAAAA;}

.playerinfo{font-family:Arial;font-size:10pt;color:#FFFFFF}
.prevatbat{font-family:Arial;font-size:8pt;color:#FFFFFF}
.roster{font-family:Arial;font-size:10pt;color:#FFFFFF}
.roster_teamname{font-family:Arial;font-size:10pt;color:#f5c70e}

.game_teamname{text-align:left;font-family:Arial;font-size:16pt;color:#FFFFFF;text-align:left}
.game_score{text-align:left;font-family:Arial;font-size:16pt;color:#f5c70e;text-align:right}
.game_date{text-align:left;font-family:Arial;font-size:13pt;color:#FFFFFF;text-align:left}
.game_inning{text-align:left;font-family:Arial;font-size:10pt;color:#FFFFFF;text-align:center}

.tooltip {
	display:none;
	background:transparent url(http://static.iscorecast.com/iscorecast/baseball_2/images/black_arrow.png);
	font-size:12px;
	height:35px;
	width:80px;
	padding:12px;
	color:#fff;	
	font-family:Arial;
}
</style>


