                              <section class="col-md-8 col-lg-9" aria-label="Content">
                                   <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title></title>
<style type="text/css">:root {
  --sgsc-blue:#0057B8;      /* PMS 2935 */
  --sgsc-burgundy:#76232F;  /* PMS 188 */
  --ink:#1f2933;
  --muted:#687386;
  --line:#dbe1e8;
  --paper:#ffffff;
  --page:#f4f6f8;
}

* { box-sizing:border-box; }

body {
  margin:0;
  background:var(--page);
  color:var(--ink);
  font-family:Arial, Helvetica, sans-serif;
  line-height:1.45;
}

.roster-wrap {
  max-width:1200px;
  margin:0 auto;
  padding:24px 20px 56px;
}





.section-title {
  margin:34px 0 16px;
  display:flex;
  align-items:center;
  gap:14px;
  color:var(--sgsc-blue);
  font-size:1.35rem;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.section-title::after {
  content:"";
  height:3px;
  flex:1;
  background:linear-gradient(90deg,var(--sgsc-burgundy),transparent);
}

.roster-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
}

.player-card {
  display:grid;
  grid-template-columns:76px 1fr;
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:0 3px 12px rgba(22,35,52,.05);
  min-height:126px;
}

.number {
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--sgsc-blue);
  color:#fff;
  font-size:1.9rem;
  font-weight:900;
  border-bottom:7px solid var(--sgsc-burgundy);
}

.info {
  padding:16px 18px;
}

.topline {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:14px;
  padding-bottom:10px;
  margin-bottom:10px;
  border-bottom:1px solid var(--line);
}

.topline h2 {
  margin:0;
  color:var(--sgsc-blue);
  font-size:1.28rem;
  line-height:1.1;
}

.class {
  flex:0 0 auto;
  display:inline-block;
  padding:4px 8px;
  background:rgba(118,35,47,.09);
  color:var(--sgsc-burgundy);
  font-size:.76rem;
  font-weight:800;
  text-transform:uppercase;
}

.details {
  display:grid;
  grid-template-columns:.7fr 1.5fr;
  gap:14px;
}

.details span {
  display:block;
  margin-bottom:2px;
  color:var(--muted);
  font-size:.67rem;
  font-weight:800;
  letter-spacing:.07em;
  text-transform:uppercase;
}

.staff-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}

.staff-card {
  background:#fff;
  border:1px solid var(--line);
  border-top:6px solid var(--sgsc-burgundy);
  padding:18px;
  box-shadow:0 3px 10px rgba(22,35,52,.04);
}

.staff-card h3 {
  margin:0;
  color:var(--sgsc-blue);
  font-size:1.12rem;
}

.staff-card p {
  margin:5px 0 0;
  color:var(--sgsc-burgundy);
  font-weight:800;
  text-transform:uppercase;
  font-size:.8rem;
}

@media (max-width:860px) {
  .roster-grid { grid-template-columns:1fr; }
}

@media (max-width:650px) {
  .staff-grid { grid-template-columns:1fr; }
  .details { grid-template-columns:1fr; }
}

@media (max-width:460px) {
  .roster-wrap { padding:0 12px 40px; }
  .player-card { grid-template-columns:60px 1fr; }
  .number { font-size:1.4rem; }
  .info { padding:14px; }
  .topline { display:block; }
  .class { margin-top:7px; }
}
</style>
<main class="roster-wrap">
