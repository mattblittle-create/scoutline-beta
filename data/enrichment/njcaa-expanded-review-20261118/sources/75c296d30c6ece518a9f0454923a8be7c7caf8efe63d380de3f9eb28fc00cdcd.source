    <style type="text/css">
      /* PAGE OVERLAY */
.em-header_page .em-header_page-overlay {
    display: none;
}

/* PAGE TITLE */
.em-header_page .em-header_page-title {
    display:block; 
    width: 100%;
    background-color: rgb(0,0,0,.4);
    color: #fff;
    padding: 5px 10px;
    font-size: 2em;
}

/* IMAGE FOR EVENT PLACEMENT */
.em-card .em-card_image img {
    object-fit: cover;
}

/* SLIDER DOTS POSITION */
@media (min-width: 20em) and (max-width: 47.99em) {
.featured_section_component .em-featured_carousel .em-featured_item_wrapper .em-carousel--slideposition {
    bottom: -26.25rem;
    margin: 1rem 0;
}

.em-header_page .em-header_page-title {
    width: 100%;
}

}

/* COVER PAGE BACKGROUND  THIS IS NO GOOD
.em-header_page {
    background-image: none;
}
*/

/* SIZING OF COVER PHOTO */
 .channel-cover-photo  {
  width: 100%;
  height: 50vh;
  background-size: cover; 
  background-position: top center;
  margin-bottom: 40px;
  padding-bottom: 250px;
}

/* CTA */
.em-event_banner-overlay { 
   background-image: none !important;
}

/* EVENTS FILTER */
.featured_section_component {
    margin-bottom: 0rem; 
}

.em-filter-wrapper .em-filter {
    margin-top:0rem;
}

/* FOOTER BG */
.em-footer .em-footer_container {
    background: none;
}

/* FEATURED EVENT AREA */
/* CSS Code for the Featured Slider for the laptop screen size */
@media (min-width: 48em) {

.featured_section_component .em-featured_carousel {
    width: 100%;
    height: 25rem;
}

.featured_section_component .em-featured_carousel .em-item>*, .featured_section_component .em-featured_carousel .item-freeform>* {
    padding-top: 12rem;
}

.featured_section_component .em-featured_carousel .em-featured_item_wrapper .em-slider {
    margin-top: -12rem;
    width: 50%;
    height: 50%;
}

.em-card.em-card--carousel .em-card_text {
    bottom: 7.5rem;
}

.featured_section_component .em-featured_carousel .em-item {
    border-radius: 12px;
}

.featured_section_component .em-featured_carousel .em-featured_item_wrapper .em-carousel--slideposition {
    bottom: .01rem;
}

.em-card_image  img{
    top: 80px;
}

.em-header_page .em-header_page-title {
    width: 70%;
}

}
.em-event_banner .em-event_banner-overlay {
    background-color: rgba(0, 47, 110, 1);
}

/* END CSS Code for the Featured Slider for the laptop screen size */
    </style>
  

  


  
