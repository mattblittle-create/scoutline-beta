}
.b0zuzws4i-modal__title {
  position: relative;
  padding-left: 24px;
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1;
}
.b0zuzws4i-modal__title::after {
  content: '';
  display: block;
  width: 48px;
  height: 2px;
  background-color: black;
  margin-top: 8px;
}
.b0zuzws4i-modal__text a {
  color: black;
}
.b0zuzws4i-modal__learn {
  color: black;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5rem;
}
.b0zuzws4i-modal__learn a {
  color: black;
}
.b0zuzws4i-modal__browsers {
  padding-top: 12px;
  margin: 0 -6px;
}
.b0zuzws4i-modal__browsers-button {
  flex: 1 0 auto;
  text-decoration: none;
  border-radius: 6px;
  background: whitesmoke;
  border-radius: 35px;
  padding: 12px;
  margin: 0 6px;
  border: 1px solid #d9d9d9;
  transition: .25s;
}
.b0zuzws4i-modal__browsers-button img {
  width: 36px;
