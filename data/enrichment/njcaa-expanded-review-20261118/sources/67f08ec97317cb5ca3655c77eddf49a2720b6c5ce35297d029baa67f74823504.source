  font-size: 14px;
  color: #2a2b2c;
  font-weight: 400;
}
.b0zuzws4i-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.b0zuzws4i-modal__browsers--text:last-child {
  padding-top: 4px;
}
.b0zuzws4i-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
  display: block;
  padding: 0 16px;
  color: black;
