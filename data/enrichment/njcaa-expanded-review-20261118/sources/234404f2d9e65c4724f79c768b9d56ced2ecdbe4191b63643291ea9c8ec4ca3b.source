<style>
  /* Match the site’s Phone breakpoint; retain desktop and tablet placement. */
  @media (max-width: 809.98px) {
    #webchat .minimizable-web-chat > .maximize,
    #webchat .minimizable-web-chat > .popup,
    #webchat .minimizable-web-chat > .chat-box {
      translate: 10px 30px;
    }
  }
</style>
