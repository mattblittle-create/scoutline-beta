												 <!-- JAVA SCRIPT TO CONTROL ANCHOR SCROLLING AND POSITION --><script>// <![CDATA[
function expandAndScrollTo(hash) {
  const target = document.querySelector(hash);
  if (!target) return;

  const panel = target.closest('.accordionPanel');

  if (panel) {
    // Inside accordion &#8211; use -310 offset
    const buttonId = panel.getAttribute('aria-labelledby');
    const toggleButton = document.getElementById(buttonId);

    if (toggleButton) {
      document.querySelectorAll('.accordionPanel[role="region"]').forEach(p => {
        const btnId = p.getAttribute('aria-labelledby');
        const btn = document.getElementById(btnId);
        if (btn && btn !== toggleButton) {
          btn.setAttribute('aria-expanded', 'false');
          p.hidden = true;
          p.style.display = 'none';
        }
      });

      toggleButton.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      panel.style.display = 'block';

      setTimeout(() => {
        smoothScrollWithOffset(target, -310);
      }, 50);
    } else {
      smoothScrollWithOffset(target, -310);
    }
  } else {
    // Outside accordion &#8212; check for special #news case
    if (hash === '#news') {
      smoothScrollWithOffset(target, -120);
    } else {
      smoothScrollWithOffset(target, 10);
    }
  }
}


// EASE-OUT SCROLL FUNCTION
function smoothScrollWithOffset(el, yOffset) {
  const targetY = el.getBoundingClientRect().top + window.pageYOffset + yOffset;
  const startY = window.scrollY;
  const distance = targetY - startY;
  const duration = 1050;
  let startTime = null;

  function easeOut(t) {
    return 1 - Math.pow(1 - t, 2); // Eases out
  }

  function animateScroll(currentTime) {
    if (!startTime) startTime = currentTime;
    const time = currentTime - startTime;
    const progress = Math.min(time / duration, 1);
    const easedProgress = easeOut(progress);
    window.scrollTo(0, startY + distance * easedProgress);
    if (progress < 1) requestAnimationFrame(animateScroll);
  }

  requestAnimationFrame(animateScroll);
}

// On page load with hash
document.addEventListener('DOMContentLoaded', function () {
  if (window.location.hash) {
    // Defer to prevent browser's native jump
    setTimeout(() => {
      window.scrollTo(0, 0); // Cancel browser jump
      expandAndScrollTo(window.location.hash);
    }, 1);
  }
});


// On in-page anchor clicks
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
  anchor.addEventListener('click', function (e) {
    const hash = this.getAttribute('href');
    const target = document.querySelector(hash);
    if (target) {
      e.preventDefault();
      history.pushState(null, '', hash);
      expandAndScrollTo(hash);
    }
  });
});
// ]]></script>
					</div>
