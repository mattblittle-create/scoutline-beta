			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Jess Brinkerhoff","value":98},{"label":"Mary Hart","value":72},{"label":"Chelsey  Warburton","value":104},{"label":"Ben Jones","value":68},{"label":"Miranda Milovich","value":126},{"label":"Jose Briseno","value":157},{"label":"Haylie Ramone","value":167},{"label":"Austin Preston","value":175},{"label":"Michael Kourianos","value":181},{"label":"Cheyanne Slaughter","value":151},{"label":"Kirk Haney","value":51},{"label":"Jose Briseno","value":109},{"label":"Hunter Gatti","value":168},{"label":"Easton Ralphs","value":82},{"label":"Jael Vaughn ","value":172},{"label":"Lee Ralphs","value":173},{"label":"Bruce Palmbaum","value":153},{"label":"Asel Rasnakawewa","value":170},{"label":"Hayden Poll","value":156},{"label":"Mark Jespersen","value":150},{"label":"Brady Ramone","value":132},{"label":"Katelyn Groves","value":129},{"label":"Anthony Ricci","value":162},{"label":"Brandi  Johansen","value":36},{"label":"Taylor Loveland","value":130},{"label":"Tanehsa Stout","value":148},{"label":"Shaylee Nicholson","value":164},{"label":"Delainee Hill","value":171},{"label":"Chelsey Warburton","value":67},{"label":"Morgan  Warburton-Nelson","value":29},{"label":"Dave Paur","value":73},{"label":"Tracy Brady","value":133},{"label":"Rachel Pace","value":163},{"label":"Alyssa  Fitch","value":103},{"label":"Kylee Atkinson","value":169},{"label":"Tanner Hallock","value":125},{"label":"Raberta Johnson","value":166},{"label":"Jeanette Haas","value":158},{"label":"Talon Jennings","value":161},{"label":"Courtney White","value":174},{"label":"Eric Hansen","value":179},{"label":"Bruce Bean","value":177},{"label":"Jerry Lynn Nielsen","value":178},{"label":"Landon Rigby","value":176},{"label":"Terry Johnson","value":180},{"label":"Michael Kourianos","value":182}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

                    </main>

