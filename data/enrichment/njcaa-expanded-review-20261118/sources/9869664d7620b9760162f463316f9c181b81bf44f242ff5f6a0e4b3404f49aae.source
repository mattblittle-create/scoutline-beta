.sidearm-story-template-header h1 {
	font-family: 'Saira', sans-serif!important;
	padding: 0px 0px 0px;
font-size: 65px;	
font-weight: 700;}
.sidearm-story-template-header h2 {
	/* font-family: 'Saira', sans-serif!important; */
font-family: 'Montserrat', sans-serif !important;
	padding: 15px 0px 0px;
	font-size: 25px;/* 30px */
	font-weight: normal;}
