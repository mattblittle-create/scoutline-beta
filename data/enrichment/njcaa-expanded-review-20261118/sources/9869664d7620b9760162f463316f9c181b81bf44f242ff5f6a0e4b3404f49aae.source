  border-radius: 2px;
  line-height: 1.875;
  font-size: 1rem;
  max-height: 100%;
  max-width: 700px;
}
.bqakw2lm2__body {
  padding: 24px;
}
.bqakw2lm2-modal__title {
  position: relative;
  padding-left: 24px;
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1;
}
.bqakw2lm2-modal__title::after {
  content: '';
  display: block;
