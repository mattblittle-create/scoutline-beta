	font-weight: bold;}

.sidearm-story-template-text,
.sidearm-story-template-text,
.sidearm-common-bio-full {
font-family: 'Saira', sans-serif;
font-size: 18px;
line-height: calc(1.0em + 0.5vw);}

.sidearm-story-template-text a,
.sidearm-common-bio-full a {
	font-weight: bold;}


blockquote {
margin: 4em 3em;}

.quotation{
  font-size: 36px;
  //margin: 0 auto;
  quotes: "\201C""\201D""\2018""\2019";
  padding: 0px 20px;
  line-height: 1.4;}

.quotation:before {
  content: open-quote;
  display: inline;
  height: 0;
  line-height: 0;
  left: -10px;
  position: relative;
  top: 30px;
  color: #ccc;
  font-size: 3em;
}
.quotation::after {
  content: close-quote;
  display: inline;
  height: 0;
  line-height: 0;
  left: 10px;
  position: relative;
  top: 35px;
  color: #ccc;
  font-size: 3em;
}
.byline{
  margin:0;
padding-left: 20px;
  text-align: left;
  font-size: 1.0em;
  font-style: italic;
}




