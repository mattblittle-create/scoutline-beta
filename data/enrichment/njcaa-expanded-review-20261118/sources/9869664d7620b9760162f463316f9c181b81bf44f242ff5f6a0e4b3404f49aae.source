.sidearm-form .sidearm-form-button.sidearm-form-button-submit {
background-color: #FF0000;
color: white;
font-weight: bold;
text-transform: uppercase; 
border-radius: 6px!important;
border-color: #FF0000;
}



/* ----------------------------------------------
    PAGE: HALL OF FAME
---------------------------------------------- */
.sidearm-hall-of-fame-member a {
color: #0344DC;
font-weight: bold;
}







