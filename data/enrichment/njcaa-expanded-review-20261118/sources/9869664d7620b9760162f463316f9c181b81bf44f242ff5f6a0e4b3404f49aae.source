  background-color: black;
  margin-top: 8px;
}
.bqakw2lm2-modal__text a {
  color: black;
}
.bqakw2lm2-modal__learn {
  color: black;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5rem;
}
.bqakw2lm2-modal__learn a {
  color: black;
}
.bqakw2lm2-modal__browsers {
  padding-top: 12px;
  margin: 0 -6px;
}
.bqakw2lm2-modal__browsers-button {
  flex: 1 0 auto;
  text-decoration: none;
  border-radius: 6px;
  background: whitesmoke;
  border-radius: 35px;
  padding: 12px;
  margin: 0 6px;
  border: 1px solid #d9d9d9;
