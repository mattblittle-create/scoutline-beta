}
.bqakw2lm2-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.bqakw2lm2-modal__browsers--text:last-child {
  padding-top: 4px;
}
.bqakw2lm2-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
