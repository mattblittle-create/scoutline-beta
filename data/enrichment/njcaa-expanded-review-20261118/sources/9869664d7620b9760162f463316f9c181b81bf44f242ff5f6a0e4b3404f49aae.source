MASTER FOOTER

================================================= */
.main-footer .footer-search button[type="submit"] {
	-webkit-appearance: none;
	-moz-appearance: none;
	-ms-appearance: none;
	-o-appearance: none;
	border: none;
	outline: none;
	background: none;
