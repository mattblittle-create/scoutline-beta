			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Michael Landers","value":31},{"label":"Brittany Leerskov","value":32},{"label":"Mike Montfort","value":33},{"label":"Whoa Dill","value":2},{"label":"Brett Minnich","value":1071},{"label":"Hunter Jenkins","value":1102},{"label":"Troy Potts","value":1103},{"label":"Beau Martin","value":1105},{"label":"Karsen Anderson","value":1109},{"label":"Xavian  Jimenez","value":1104},{"label":"Michael  Holaday","value":1125},{"label":"Dustin Velazquez","value":8},{"label":"Samuel Ortiz","value":1083},{"label":"Andrew Mitchell","value":1084},{"label":"Jacob Manchester","value":9},{"label":"John Pelletier","value":10},{"label":"Kristopher Collins","value":1099},{"label":"Jamichael Morgan","value":1101},{"label":"Jacques Guillot","value":15},{"label":"Patrick  Hall","value":1098},{"label":"Devlin Isadore","value":1106},{"label":"Will Kendrick","value":1107},{"label":"Cooper Leusch","value":1108},{"label":"Paul Davenport","value":1072},{"label":"Esmie Gonzales","value":1076},{"label":"Jessica Karenke-Burke","value":24},{"label":"Wesley Tunnell","value":26},{"label":"Lauren Davila","value":1068},{"label":"Phil Nickel","value":1100},{"label":"Alyssa Carrillo","value":1110},{"label":"John Gaines","value":1050},{"label":"Braden Herrmann","value":1096},{"label":"MiaRaye Daboh","value":1095},{"label":"Jillian Brannon","value":1111},{"label":"Julia  Lopez","value":1113},{"label":"Young Min Im","value":1114},{"label":"Wisdom Adele","value":1115},{"label":"Eelie Macias","value":1116},{"label":"Regina Barrozo","value":1117},{"label":"Eireen Whittington","value":1118},{"label":"Skye  Davis","value":1119},{"label":"Jaynell Melton","value":1120},{"label":"Kevin  Pineda","value":1121},{"label":"Hailey Devore","value":1122},{"label":"Payton Ferguson","value":1123}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

    </main>
