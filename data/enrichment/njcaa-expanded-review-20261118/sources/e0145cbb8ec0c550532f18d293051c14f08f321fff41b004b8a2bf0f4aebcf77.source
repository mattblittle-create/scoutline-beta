<style type="text/css">
  .wpm_6310_team_style_8 {
    text-align: center;
    overflow: hidden;
    transition: all 0.3s ease 0s;
    -webkit-border-radius: 5%;
    -o-border-radius: 5%;
    -moz-border-radius: 5%;
    -ms-border-radius: 5%;
    border-radius: 5%;
    border-style: solid;
    border-width: 0px;
    border-color: rgba(168, 3, 0, 1);
    box-shadow: 0 0 px px rgba(0, 0, 0, 1);
    -moz-box-shadow: 0 0 px px rgba(0, 0, 0, 1);
    -o-box-shadow: 0 0 px px rgba(0, 0, 0, 1);
    -webkit-box-shadow: 0 0 px px rgba(0, 0, 0, 1);
    -ms-box-shadow: 0 0 px px rgba(0, 0, 0, 1);
    width: 100%;
    float: left;
    position: relative;
  }
  .wpm_6310_team_style_8_pic {
    position: relative;
    overflow: hidden;
    float: left;
    width: 100%;
  }
  .wpm_6310_team_style_8img {
    width: 100%;
    height: auto;
    float: left;
  }
  .wpm_6310_team_style_8_team_content {
    height: 100%;
    position: absolute;
    top: 0;
    left: -100%;
    right: 0;
    bottom: 0;
    padding: 30px 0;
    background: rgba(0, 0, 0, 0.6);
    transition: all 0.20s ease 0s;
    width: 100%;
    display: flex;
    align-items: center;
  }
  .wpm_6310_team_style_8_team_content_cell {
    display: table-cell;
    vertical-align: middle;
    float: left;
    padding: 0 15px;
    width: 100%;
  }
  .wpm_6310_team_style_8:hover .wpm_6310_team_style_8_team_content {
    left: 0;
  }
  .wpm_6310_team_style_8_team_content .wpm_6310_team_style_8_title {
    font-size: 22px;
    color: rgb(255, 255, 255);
    font-weight: 600;
    text-transform: uppercase;
    font-family: Shanti;
    line-height: 32px;
    float: left;
    width: 100%;
    margin-top: 0px;
    margin-bottom: 0px;
  }
  .wpm_6310_team_style_8_team_content .wpm_6310_team_style_8_designation {
    font-size: 16px;
    color: rgb(222, 222, 222);
    font-weight: 200;
    text-transform: uppercase;
    font-family: Shanti;
    line-height: 20px;
    display: block;
    float: left;
    width: 100%;
    margin-top: 0px;
    margin-bottom: 10px;
  }
  .wpm_6310_team_style_8_social {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    float: left;
    width: 100%;
    margin-top: 0px;
    margin-bottom: 0px;
  }
  .wpm_6310_team_style_8_social li {
    display: inline-block;
    margin: 0 5px 0 0;
  }
  .wpm_6310_team_style_8_social li:last-child {
    margin-right: 0px;
  }
  .wpm_6310_team_style_8_social li a {
    display: inline-block;
    font-size: 18px;
    border-radius: 1%;
    -moz-border-radius: 1%;
    -webkit-border-radius: 1%;
    -o-border-radius: 1%;
    -ms-border-radius: 1%;
    text-align: center;
  }
  .wpm_6310_team_style_8_team_display {
    width: 100%;
    position: absolute;
    bottom: 0;
    text-align: right;
    padding: 30px 0;
    float: left;
    background: rgba(0, 0, 0, 0.6);
    transform: translateX(0);
    transition: all 0.20s ease 0s;
  }
  .wpm_6310_team_style_8:hover .wpm_6310_team_style_8_team_display {
    transform: translateX(100%);
  }
  .wpm_6310_team_style_8_team_display .wpm_6310_team_style_8_title {
    font-size: 22px;
    color: rgb(255, 255, 255);
    font-weight: 600;
    text-transform: uppercase;
    font-family: Shanti;
    line-height: 32px;
    margin-left: 15px;
    margin-right: 15px;
  }
  .wpm_6310_team_style_8_team_display .wpm_6310_team_style_8_designation {
    font-size: 16px;
    color: rgb(222, 222, 222);
    font-weight: 200;
    text-transform: uppercase;
    font-family: Shanti;
    line-height: 20px;
    margin-bottom: 0;
    margin-left: 15px;
    margin-right: 15px;
  }
</style>

<style type="text/css">
.wpm_6310_modal_template_before, .wpm_6310_modal_template_after{
  position: absolute;
  cursor: pointer;
  z-index: 99999999;
  border-radius: 50%;
}
.wpm_6310_modal_template_before{
  content: url('/wp-content/plugins/team-showcase-supreme/assets/images/prev.png');
  left: -50px;
  top: calc(50% - 30px);
}
.wpm_6310_modal_template_after{
  content: url('/wp-content/plugins/team-showcase-supreme/assets/images/next.png');
  right: -50px;
  top: calc(50% - 30px);
}
.wpm_6310_team_style_8{
  height: 100%;
}
.wpm-6310-no-carousel {
  width: calc(100% + 30px);
  margin-left: -15px;
}
.wpm-6310-item-8{
    width: 100% !important;
}
.wpm-6310-owl-stage{
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  min-width: 10317px;
  -webkit-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
}
.wpm-6310-owl-item{
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  height: auto !important;
}
  .wpm-6310-tooltip:hover:after {
  display: -webkit-flex;
  display: flex;
  -webkit-justify-content: center;
  justify-content: center;
  background: rgba(0, 119, 181, 1);
  border-radius: 5px;
  color: #fff;
  content: attr(tooltip-href);
  margin: -85px 5px 0;
  font-size: 14px;
  line-height: 25px;
  padding: 8px 10px;
  position: absolute;
  z-index: 999;
  min-width: 140px;
}
.wpm_main_template{
  position: relative;
  z-index: 0;
}
.wpm_main_template *, .wpm_6310_modal * {
  box-sizing: border-box !important;
  word-break: break-word !important; 
}
.wpm-6310-row img, .wpm-6310-owl-item img{
  float: unset;
  width: 100% !important;}
.wpm_main_template, .wpm_main_template a{
  box-shadow: none !important;
}
.wpm-6310-row{
  width: 100%;
  clear: both;
  text-align: center;
  font-size: 0;
  display: flex;
  flex-wrap: wrap;
}
.wpm_main_template_8 .wpm-6310-row{
  justify-content: center !important;
}
.wpm-6310-img-responsive{
