@keyframes slideup_1 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateY(50px) scale(.95);
      transform: translateY(50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateY(0) scale(1);
      transform: translateY(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_2 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateY(-50px) scale(.95);
      transform: translateY(-50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateY(0) scale(1);
      transform: translateY(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_3 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateX(50px) scale(.95);
      transform: translateX(50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateX(0) scale(1);
      transform: translateX(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_4 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateX(-50px) scale(.95);
      transform: translateX(-50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateX(0) scale(1);
      transform: translateX(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_5 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateX(50px) translateY(50px) scale(.95);
      transform: translateX(50px) translateY(50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateX(0) translateY(0) scale(1);
      transform: translateX(0) translateY(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_6 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateX(50px) translateY(-50px) scale(.95);
      transform: translateX(50px) translateY(-50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateX(0) translateY(0) scale(1);
      transform: translateX(0) translateY(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_7 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateX(-50px) translateY(50px) scale(.95);
      transform: translateX(-50px) translateY(50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateX(0) translateY(0) scale(1);
      transform: translateX(0) translateY(0) scale(1);
      opacity: 1;
   }
 }
 @keyframes slideup_8 {
   0% {
      transform: scale(.5);
      -webkit-transform: translateX(-50px) translateY(-50px) scale(.95);
      transform: translateX(-50px)translateY(-50px) scale(.95);
      opacity: 0;
   }
   70% {
      -webkit-transform: translateX(0) translateY(0) scale(1);
      transform: translateX(0) translateY(0) scale(1);
      opacity: 1;
   }
 }
