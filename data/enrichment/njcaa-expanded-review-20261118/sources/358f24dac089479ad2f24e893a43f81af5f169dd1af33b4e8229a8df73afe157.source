                            'c-navigation__item c-navigation__item--level-1': true
                        }">
                <!-- ko if: url === "" || url === "#" -->
                    <button class="c-navigation__url c-navigation__url--level-1" data-bind="
                      html: class_name === 'additional-links' ? 'More +' : title,
                      click: function(data, event) {
                          let currentTarget = event.currentTarget;
                          let menuItems = document.querySelectorAll('.c-navigation__url--level-1');
                          menuItems.forEach((element) => {
                              if(!currentTarget.isSameNode(element)) {
                                  let navdata = ko.dataFor(element);
                                  navdata.closeMenuItem();
                              }
                          });
                          toggleMenuItem();
                      },
                      css: {'is-toggled':isItemOpen()},
                      attr: {
                          'aria-expanded': isItemOpen() ? 'true' : 'false',
                          href: url != '' && url != '#' ? url : null,
                          'aria-controls': (typeof title === 'function' ? title() : title).replace(/[^a-zA-Z0-9_]/g, '_')
                      }" tabindex="0"></button>
                      <!-- /ko -->
 
                      <!-- ko if: url !== "" && url !== "#" -->
                      <a class="c-navigation__url c-navigation__url--level-1" data-bind="
                        html: title,
                        css: {
                            'is-toggled':isItemOpen()
                        },
                        attr: {
                            href: url
                        }" tabindex="0"></a>
                      <!-- /ko -->

                        <!-- ko if: items && items.length -->
                            <ul class="c-navigation__level-2" data-bind="
                                fastForEach: items,
                                css: {'is-open': isItemOpen()},
                            attr: {
                              'aria-hidden' : isItemOpen() ? 'false' : 'true',
                              'id': (typeof title === 'function' ? title() : title).replace(/[^a-zA-Z0-9_]/g, '_')
                            },
                                onEscape: closeMenuItem">
                                <li class="c-navigation__item c-navigation__item--level-2" data-bind="css: { 'c-navigation__separator': separator }">
                                    <!-- ko if: separator -->
                                        <span data-bind="text: title"></span>
                                    <!-- /ko -->

                                    <!-- ko ifnot: separator -->
                                        <a class="c-navigation__url c-navigation__url--level-2" data-bind="
                                            html: title,
                                            attr: {
                                                href: url,
                                                target: open_in_new_window ? '_blank' : '',
                                                tabindex: $parent.isItemOpen() ? 0 : -1
                                            },
                                            event: {
                                                focus: function() { $parent.openMenuItem(); },
                                                blur:  function() { $parent.closeMenuItem(); },
                                            keyup: function(data, event) {
                                                if(event.key == 'Escape') {
                                                    $parent.closeMenuItem();
                                                    let parentElement = event.currentTarget.closest('.c-navigation__item--level-1');
                                                    let focusableElement = parentElement.querySelector('.c-navigation__url--level-1');
                                                    focusableElement.focus();
                                                }
                                            }
                                            },
                                            css: class_name"></a>
                                    <!-- /ko -->
                                </li>
                            </ul>
                        <!-- /ko -->
                    </li>
                </ul>
            <!-- /ko -->
            <!-- ko case: $else -->
                <ul class="c-navigation__sport-links flex flex-align-center flex-justify-between">
                    <li class="c-navigation__sport flex flex-align-center">
                        <!-- ko switch -->
                            <!-- ko case: mediumUp -->
                                <a class="c-navigation__sport-link c-navigation__url" data-bind="text: sport.title, attr: { href: data()[0].url != '#' ? data()[0].url : '/index.aspx?path=' + sport.shortname }"></a>
                            <!-- /ko -->
                            <!-- ko case: $else -->
                                <a class="c-navigation__sport-link c-navigation__url" data-bind="text: sport.abbreviation, attr: { href: data()[0].url != '#' ? data()[0].url : '/index.aspx?path=' + sport.shortname }"></a>
                            <!-- /ko -->
                        <!-- /ko -->
                    </li>

                    <li class="c-navigation__item--sport-links c-navigation__additional">
                        <button type="button" class="c-navigation__toggle c-navigation__toggle--sport" data-bind="click: toggleMenu, attr: {
                        'aria-expanded': isMenuOpen() ? 'true' : 'false',
                        'aria-controls': 'additional-menu-overlay',
                      }, css: {'is-toggled': isMenuOpen()}" aria-label="Toggle sport navigation menu">
                            <i class="sf-plus"></i>
                        </button>
                    </li>
                </ul>

                <div class="c-navigation__offcanvas" data-bind="
                    css: {
                        'is-open': isMenuOpen()
                    },
                    attr: {
                        'id': 'additional-menu-overlay',
                        'aria-hidden': isMenuOpen() ? 'false' : 'true',},
                    onEscape: closeMenu">
                    <ul class="c-navigation__level-1" data-bind="fastForEach: data">
                        <!-- ko if: class_name != 'sport-home' -->
                            <li class="c-navigation__item c-navigation__item--level-1" data-bind="css: { 'c-navigation__parent' : items && items.length > 0, 'is-open': isItemOpen() }">
                                <!-- ko if: url != "" && url != "#" -->
                                    <a class="c-navigation__url c-navigation__url--level-1" data-bind="
                                        html: title,
                                        attr: {
                                            href: url,
                                            target: open_in_new_window ? '_blank' : '',
                                            tabindex: $parent.isMenuOpen() ? 0 : -1
                                        },
                                        event: {
                                            focus: function() { $parent.openMenu(); },
                                            blur:  function() { $parent.closeMenu(); },
                                                                    keyup: function(data, event) {
                                                                        if(event.key == 'Escape') {
                                                                            $parent.closeMenu();
                                                                            document.querySelector('.c-navigation__toggle--sport').focus();
                                                                        }
                                                                    }
                                                                    },"></a>
                                <!-- /ko -->

                                <!-- ko if: url === "" || url === "#" -->
                                    <button type="button" class="c-navigation__url c-navigation__url--level-1" href="javascript:void(0)" data-bind="
                                        html: title,
                                        click: toggleMenuItem,
                                        css: {
                                            'is-open': isItemOpen()
                                        },
                                        attr: {
                                            'aria-controls': (typeof title === 'function' ? title() : title).replace(/[^a-zA-Z0-9_]/g, '_'),
                                            'aria-expanded': isItemOpen() ? 'true' : 'false',
                                            tabindex: $parent.isMenuOpen() ? 0 : -1
                                        },
                                        event: {
                                            focus: function() { $parent.openMenu(); },
                                            blur:  function() { $parent.closeMenu(); },
                                                                    keyup: function(data, event) {
                                                                        if(event.key == 'Escape') {
                                                                            $parent.closeMenu();
                                                                            document.querySelector('.c-navigation__toggle--sport').focus();
                                                                        }
                                                                    }
                                                                    },"></button>
                                <!-- /ko -->

                                <!-- ko if: items && items.length -->
                                    <div class="c-navigation__level-2" data-bind="css: isItemOpen() ? 'is-open' : '', attr: {'aria-hidden': isItemOpen() ? 'false' : 'true', 'id': (typeof title === 'function' ? title() : title).replace(/[^a-zA-Z0-9_]/g, '_')},">
                                        <ul class="" data-bind="fastForEach: items">
                                            <li class="c-navigation__item c-navigation__item--level-2" data-bind="css: {'c-navigation__separator': separator}">
                                                <!-- ko if: separator -->
                                                    <span data-bind="text: title"></span>
                                                <!-- /ko -->

                                                <!-- ko ifnot: separator -->
                                                    <a class="c-navigation__url c-navigation__url--level-2" data-bind="
                                                        html: title,
                                                        attr: {
                                                            href: url,
                                                            target: open_in_new_window ? '_blank' : '',
                                                            tabindex: $parent.isItemOpen() ? 0 : -1
                                                        },
                                                        event: {
                                                            focus: function() { $parents[1].openMenu(); $parent.openMenuItem(); },
                                                            blur:  function() { $parents[1].closeMenu(); $parent.closeMenuItem(); },
                                                            keyup: function(data, event) {
                                                                if (event.key === 'Escape') {
                                                                    const level2Item = event.currentTarget;
                                                                    const level1Item = level2Item.closest('.c-navigation__item--level-1');
                                                                    const level1Button = level1Item?.querySelector('.c-navigation__url--level-1');
                                                            
                                                                    if (level1Button) {
                                                                        level1Button.focus();
                                                                    }
                                                            
                                                                    $parent.closeMenuItem();
                                                                    setTimeout(() => {
                                                                    $parents[1].isMenuOpen(true);
                                                                    }, 100);
                                                                }
                                                            }
                                                                    }"></a>
                                                <!-- /ko -->
                                            </li>
                                        </ul>
                                    </div>
                                <!-- /ko -->
                            </li>
                        <!-- /ko -->
                    </ul>
                </div>
            <!-- /ko -->
        <!-- /ko -->
    </div>
<!-- /ko -->
</script><script type='text/html' id='template-events'><div class="component c-scoreboard c-scoreboard--slider flex">

    <div class="c-scoreboard__list flex-item-1" role="region" aria-roledescription="carousel" aria-label="scoreboard-carousel" data-bind="afterBind: { foreach:data, callback:slick }" data-slick-options="{
            autoplay: true,
            autoplaySpeed: 4000,
            slidesToShow: 4,
            infinite: false,
            responsive: [
                {
                    breakpoint: 1281,
                    settings: {
                        slidesToShow: 3
                    }
                },
                {
                    breakpoint: 1025,
                    settings: {
                        slidesToShow: 2
                    }
                }
            ]
        }">

        <div class="c-scoreboard__item" data-bind="css: { 'is-open': selected() }">

            <div class="c-scoreboard__header flex flex-align-center">
                <div class="c-scoreboard__date" data-bind="formatDate:date, format:'ddd. MMM D'"></div>
                <!-- ko if: type === 'upcoming' && (time || isLive()) -->
                    <div class="c-scoreboard__time">
                        <!-- ko if: isLive() -->
                            <span>Live</span>
                        <!-- /ko -->
                        <!-- ko if: !isLive() -->
                            <span data-bind="text: time"></span>
                        <!-- /ko -->
                    </div>
                <!-- /ko -->
            </div>

            <div class="c-scoreboard__body flex flex-column flex-justify-center">
                <div class="c-scoreboard__opponent flex flex-align-center">
                    <div class="c-scoreboard__opponent-logo flex-center">
                        <!-- ko if: opponent.image -->
                            <img class="c-scoreboard__opponent-logo-image" data-bind="attr: { src: opponent.image + '?width=25', alt: opponent.title }" />
                        <!-- /ko -->
                        <!-- ko ifnot: opponent.image -->
                            <img class="c-scoreboard__opponent-logo-image c-scoreboard__logo--default" data-bind="attr: { src: $component.bucket + '/images/responsive/cal_logo_default.png', alt: opponent.title }" />
                        <!-- /ko -->
                    </div>
                    <div class="c-scoreboard__opponent-name" data-bind="text: opponent.title"></div>
                </div>
                <div class="c-scoreboard__team flex flex-align-center">
                    <div class="c-scoreboard__team-logo flex-center">
                        <img class="c-scoreboard__team-logo-image" alt="Heartland Hawks" data-bind="attr: { src: $component.bucket + '/images/responsive/cal_logo.png' }" />
                    </div>
                    <div class="c-scoreboard__team-sport" data-bind="text: sport.title"></div>
                </div>
            </div>

            <!-- ko if: media.audio || media.video || media.stats || media.tickets -->
                <button type="button" class="c-scoreboard__toggle" data-bind="click: toggleGame, css: {'is-toggled': selected()},
                attr: {
                    'aria-expanded': selected() ? 'true' : 'false'
                },
                event: {
                    keyup: function(data, event) {
                        if(event.key == 'Enter') {
                            toggleGame()
                        }
                        if(event.key == 'Escape') {
                            closeGame();
                        }
                    }
                }
                " aria-label="Toggle game links">
                    <i class="sf-plus-circle"></i>
                </button>

                <div class="c-scoreboard__overlay" data-bind="css: {'is-open': selected()},
                event: {
                    keyup: function(data, event) {
                        if(event.key == 'Escape') {
                            closeGame();
                            var toggleButton = $(event.target).closest('.c-scoreboard__item').find('.c-scoreboard__toggle');
                              if (toggleButton.length) {
                                  toggleButton.focus();
                              }
                        }
                    }
                }
                ">
                    <ul class="c-scoreboard__media reset-list flex flex-align-center">
                        <!-- ko if: media.audio -->
                            <li class="c-scoreboard__media-item">
                                <a class="c-scoreboard__media-link" data-bind="attr: { href: media.audio },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                    <i class="sf-audio-double"></i>
                                    <span class="accessible-hide">
                                        Live audio for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                    </span>
                                </a>
                            </li>
                        <!-- /ko -->
                        <!-- ko if: media.video -->
                            <li class="c-scoreboard__media-item">
                                <a class="c-scoreboard__media-link" data-bind="attr: { href: media.video },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                    <i class="sf-monitor"></i>
                                    <span class="accessible-hide">
                                        Live video for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                    </span>
                                </a>
                            </li>
                            <!-- /ko -->
                        <!-- ko if: media.stats -->
                            <li class="c-scoreboard__media-item">
                                <a class="c-scoreboard__media-link" data-bind="attr: { href: media.stats },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                    <i class="sf-stats-2"></i>
                                    <span class="accessible-hide">
                                        Live stats for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                    </span>
                                </a>
                            </li>
                        <!-- /ko -->
                        <!-- ko if: media.tickets -->
                            <li class="c-scoreboard__media-item">
                                <a class="c-scoreboard__media-link" data-bind="attr: { href: media.tickets },
                                event: { 
                                    focus: function() { openGame(); }, 
                                    blur:  function() { closeGame(); } 
                                }">
                                    <i class="sf-tickets-2"></i>
                                    <span class="accessible-hide">
                                        Buy tickets for <span data-bind="text: sport.title"></span> <span data-bind="text: atVs"></span> <span data-bind="text: opponent.title"></span> on <span data-bind="formatDate:date, format:'MMMM D, YYYY'"></span> at <span data-bind="text: time"></span>
                                    </span>
                                </a>
                            </li>
                        <!-- /ko -->
                    </ul>
                </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- ko if: ko.observable().matchMedia('(min-width:1280px)') -->
        <div class="c-scoreboard__aside flex flex-column flex-justify-center">
            <div class="c-scoreboard__filter">
                <select class="c-scoreboard__filter-select" aria-label="Filter games by sport" data-bind="options: sports, value: selectedSport, optionsText: 'title', optionsAfterRender: function(item, value){
                        if(item.innerHTML == 'Choose Sport'){

                        }
                    }"></select>
            </div>
            <a class="c-scoreboard__calendar" href="/calendar.aspx" aria-label="Composite calendar">
                <span>Composite Calendar</span>
            </a>
        </div>
    <!-- /ko -->
</div>
</script><script type='text/html' id='template-countdown'><!-- ko if: data().length -->
<div class="countdown-container" data-bind="foreach: data">
	<div class="countdown-details ">
		<div class="countdown-game-details ">
			<div class="countdown-details-promo">
				<!-- ko if: ad -->
					<div class="ad" data-bind="css: ad.css_class">
						<a data-bind="attr: { href: ad.link }, target: open_in_new_window ? '_blank' : ''">
							<picture data-bind="html5Picture: ad.picture"></picture>
						</a>
					</div>
				<!-- /ko -->
			</div>
			<div class="title flex flex-align-center flex-justify-between hide-on-medium-down">
				<div class="c-countdown__header-text" data-bind="text: title"></div>
			</div>		
		</div>
		<div class="countdown-details-countdown">
			<div class="countdown-details-countdown-time flex flex-align-center flex-justify-around">
				<div class="timeWrapper">
					<div class="time" data-bind="text: days"></div>
					<div class="label">Days</div>
				</div>
				<div class="timeWrapper">
					<div class="time" data-bind="text: hours"></div>
					<div class="label">Hrs</div>
				</div>
				<div class="timeWrapper">
					<div class="time" data-bind="text: mins"></div>
					<div class="label">Mins</div>
				</div>
				<div class="timeWrapper"> 
					<div class="time" data-bind="text: secs"></div>
					<div class="label">Secs</div>
				</div>
			</div>
			<div class="opponent">
				<span class="logo">
					<img src="/images/logos/site/site.png?width=70" alt="Heartland" />
				</span>
				<span class="vsat" data-bind="text: game.atVs"></span>
				<span class="logo">
					<!-- ko if: game.opponent.image === null || game.opponent.image === "" -->
						<img class="no-logo" src="/images/logos/site/site.png?width=60" alt="Heartland" />
					<!-- /ko -->
					<!-- ko if: game.opponent.image != null && game.opponent.image != "" -->
						<img data-bind="attr: { src: game.opponent.image + '?width=60', alt: game.opponent.title }" />
					<!-- /ko -->
				</span>
			</div>	
			<div class="game-media">
				<!-- ko if: game.media  -->
					<!-- ko if: game.media.tickets  -->
                        <a data-bind="attr: {href: game.media.tickets}"><i class="sf-tickets"></i></a>
					<!-- /ko -->
				<!-- /ko -->
				
			</div>
		</div>
	</div>
</div>
<!-- /ko --></script><script type='text/html' id='template-stories'><!-- ko if: name() === 'featured' -->
    <div class="component c-stories c-stories--featured" data-bind="foreach: data">
        <div class="c-stories__item">
            <div class="c-stories__media-container relative">
                <div class="c-stories__media relative" data-bind="showcasePlayer: showcase, appendButton:true">
                    <!-- ko if: image_source -->
                        <picture class="c-stories__picture" data-bind="html5PictureLazyLoad: { 'images': [
                                { 'breakpoint': 768, 'image': image_source + '?width=1056&height=594&mode=crop&quality=90&format=jpg' },
                                { 'breakpoint': 540, 'image': image_source + '?width=768&height=432&mode=crop&quality=90&format=jpg' },
                                { 'breakpoint': 0, 'image': image_source + '?width=540&height=304&mode=crop&quality=90&format=jpg' }
                            ]}, alt: image_alt_text"></picture>
                    <!-- /ko -->
                    <!-- ko ifnot: image_source -->
                        <picture class="c-stories__picture" data-bind="html5Picture: { 'images': [
                                { 'breakpoint': 0, 'image': $component.bucket + '/images/responsive/mainstory_default.jpg' }
                            ]}, alt: image_alt_text"></picture>
                    <!-- /ko -->
                </div>
            </div>

            <div class="c-stories__details">
                <div class="c-stories__title">
                    <a class="c-stories__url" data-bind="text: title, attr: {href:url}"></a>
                </div>
                <div class="c-stories__meta flex-center">
                    <div class="c-stories__date" data-bind="formatDate:date, format:'MMMM D, YYYY'"></div>
                    <div class="c-stories__sport" data-bind="text: sport.title"></div>
                </div>
            </div>
        </div>
    </div>
<!-- /ko -->
<!-- ko if: name() === 'list' -->
    <div class="component c-stories c-stories--list" data-bind="fastForEach: data">
        <div class="c-stories__item">
            <div class="c-stories__title">
                <a class="c-stories__url" data-bind="text: title, attr: {href:url}"></a>
            </div>
            <!-- ko if: ko.observable().matchMedia('(min-width: 1280px)') -->
                <div class="c-stories__meta flex flex-align-center">
                    <div class="c-stories__date" data-bind="formatDate:date, format:'MMMM D, YYYY'"></div>
                    <div class="c-stories__sport" data-bind="text: sport.title"></div>
                </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- ko if: ko.observable().matchMedia('(min-width: 1280px)') -->
        <div class="c-stories__more">
            <a class="c-stories__more-url" href="/archives.aspx" data-bind="attr: { href: (window.associated_sport ? '/archives.aspx?path=' + window.associated_sport.shortname : '/archives.aspx') }">More Stories</a>
        </div>
    <!-- /ko -->
<!-- /ko -->
</script><script type='text/html' id='template-youtube'><!-- ko switch-->
    <!-- ko case: ko.observable().matchMedia('(min-width: 1280px)') -->
        <div class="component c-videos c-videos--featured">
            <div class="c-videos__featured flex flex-column" data-bind="with: selectedVideo">
                <div class="c-videos__featured-player-container relative" data-bind="showcasePlayer: showcase, modal: true,  videoContainer: '.c-videos__featured-player'">
                    <div class="c-videos__featured-player relative">
                        <img class="c-videos__featured-player-image" data-bind="attr: {src: images.maxres, alt: title}" />
                        <button type="button" class="c-videos__play-btn" data-bind="click: showcase().playVideo, attr: {'aria-label': 'Play video ' + title}">
                            <i class="sf-play"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="c-videos__list" role="region" aria-label="videos-slider" data-bind="afterBind: { foreach: chunk(data, 3), callback: slick }" data-slick-options="{
                    appendArrows: '.c-videos__footer__arrows',
                    infinite: false,
                }">

                <div class="c-videos__panel" data-bind="fastForEach: $data">
                    <div class="c-videos__item flex" data-bind="click: $component.switchVideo, css: {'is-active': $parent.selectedVideo && $parent.selectedVideo().id === id}">
                        <div class="c-videos__media-container relative">
                            <div class="c-videos__media relative" data-bind="click: $component.switchVideo">
                                <img class="c-videos__image" data-bind="attr: {src: images.medium, alt: title}" />
                                <button type="button" class="c-videos__play-btn" data-bind="click: $component.switchVideo, attr: {'aria-label': 'Play video ' + title}">Play Video</button>
                            </div>
                        </div>

                        <div class="c-videos__details flex flex-column flex-justify-center">
                            <div class="c-videos__title" data-bind="text: title"></div>
                            <button type="button" class="c-videos__details-play-btn flex flex-align-center" data-bind="click: $component.switchVideo, attr: {'aria-label': 'Play video ' + title}">
                                <span>Watch Now</span>
                                <i class="sf-play"></i>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="c-videos__footer flex flex-align-center">
            <div class="c-videos__footer__details" data-bind="with: selectedVideo">
                <div class="c-videos__footer__title" data-bind="text: title"></div>
                <div class="c-videos__footer__meta">
                    <div class="c-videos__footer__date" data-bind="formatDate:date, format:'MMM D, YYYY'"></div>
                    <div class="c-videos__footer__duration">
                        Time: <span data-bind="formatDate: duration, duration:true"></span>
                    </div>
                </div>
            </div>
            <div class="c-videos__footer__arrows flex"></div>
        </div>
    <!-- /ko -->
    <!-- ko case: $else -->
        <div class="component c-videos c-videos--featured">
            <div class="c-videos__featured flex flex-column" data-bind="with: selectedVideo">
                <div class="c-videos__featured-player-container relative" data-bind="showcasePlayer: showcase, modal: true,  videoContainer: '.c-videos__featured-player'">
                    <div class="c-videos__featured-player relative">
                        <img class="c-videos__featured-player-image" data-bind="attr: {src: images.medium, alt: title}" />
                        <button type="button" class="c-videos__play-btn" data-bind="click: showcase().playVideo, attr: {'aria-label': 'Play video ' + title}">
                            <i class="sf-play"></i>
                        </button>
                    </div>
                </div>
                <div class="c-videos__featured-details">
                    <div class="c-videos__featured-title" data-bind="text: title"></div>
                    <div class="c-videos__featured-meta">
                        <div class="c-videos__featured-date" data-bind="formatDate:date, format:'MMM D, YYYY'"></div>
                        <div class="c-videos__featured-duration">
                            Time: <span data-bind="formatDate: duration, duration:true"></span>
                        </div>
                    </div>
                </div>
            </div>

            <ul class="c-videos__list reset-list" data-bind="fastForEach: data">
                <li class="c-videos__item flex" data-bind="click: $component.switchVideo, css: {'is-active': $parent.selectedVideo && $parent.selectedVideo().id === id}">
                    <div class="c-videos__media-container relative">
                        <div class="c-videos__media relative" data-bind="click: $component.switchVideo">
                            <img class="c-videos__image" data-bind="attr: {src: images.medium, alt: title}" />
                            <button type="button" class="c-videos__play-btn" data-bind="click: $component.switchVideo, attr: {'aria-label': 'Play video ' + title}">Play Video</button>
                        </div>
                    </div>

                    <div class="c-videos__details flex flex-column flex-justify-center">
                        <div class="c-videos__title" data-bind="text: title"></div>
                        <button type="button" class="c-videos__details-play-btn flex flex-align-center" data-bind="click: $component.switchVideo, attr: {'aria-label': 'Play video ' + title}">
                            <span>Watch Now</span>
                            <i class="sf-play"></i>
                        </button>
                    </div>
                </li>
            </ul>
        </div>
