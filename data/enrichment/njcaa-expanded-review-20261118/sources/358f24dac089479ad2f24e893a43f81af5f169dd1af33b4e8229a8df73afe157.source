            <!-- /ko -->
            <!-- ko case: $else -->
                <!-- ko if: ko.observable().matchMedia('(min-width:768px)') -->
                    <button type="button" class="c-navigation__toggle c-navigation__toggle--sports" data-bind="click: function() {
