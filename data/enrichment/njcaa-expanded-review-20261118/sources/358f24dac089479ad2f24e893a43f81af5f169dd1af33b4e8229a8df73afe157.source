                            <input class="c-poll__choices-input" type="radio" data-bind="attr: { 'name': 'poll-' + $parent.id, 'id': 'poll-answer-' + id }, value: id, checked: $parent.value" />
                            <label class="c-poll__choices-label" data-bind="attr: { 'for': 'poll-answer-' + id }, text: answer"></label>
                        </li>
                    </ul>
                <!-- /ko -->

                <!-- ko if: showResults -->
                    <ul class="c-poll__results reset-list" data-bind="fastForEach: results">
                        <li class="c-poll__results-item flex">
                            <span class="c-poll__results-answer" data-bind="text: answer_short + ':'"></span>
                            <span data-bind="text: percentage"></span>%
                        </li>
                    </ul>
                <!-- /ko -->
            </fieldset>

            <!-- ko if: showAnswers -->
                <div class="c-poll__vote-btn-container">
                    <button class="c-poll__vote-btn" data-bind="css: { 'is-enabled' : value }, click: submitVote, disable: isSubmitting, enable: value"><span>Vote Now</span></button>
                </div>
            <!-- /ko -->
        </div>
    </div>
<!-- /ko -->
</script><script type='text/html' id='template-awards'><div class="component c-awards flex" data-bind="fastForEach: data">
