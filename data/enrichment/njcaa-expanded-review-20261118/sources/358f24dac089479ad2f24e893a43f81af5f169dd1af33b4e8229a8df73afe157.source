<!-- ko if: name() === 'sports-nav' -->
    <div class="component c-navigation c-navigation--sport" data-bind="css: ko.observable().matchMedia('(min-width:1280px)')() ? 'c-navigation--desktop' : 'c-navigation--mobile'">
