                        <div class="main-header__calendar">
                          <button class="main-header__calendar-toggle" data-bind="
                      click: function(){
                          $('.main-header__calendar-toggle').attr('aria-expanded', function (i, attr) { return attr == 'true' ? 'false' : 'true' });
                          window.toggleCalendar();
                          var data = ko.dataFor($('.c-navigation--main')[0]);
                          data.closeMenu();
                          if ($('.c-navigation--sport').length) {
                              var datasport = ko.dataFor($('.c-navigation--sport')[0]);
                              datasport.closeMenu();   
                          }
                      }" aria-label="Toggle sports calendar">
                            <span class="sidearm-icon reset-icon sf-calendar-minimal calendar-open"></span>
                            <span class="sidearm-icon reset-icon sf-close-minimal calendar-close"></span>
                          </button>
                          <div class="main-header__calendar-overlay">
                            <section class="s-schedule" aria-labelledby="h2_schedule" data-bind="
                      onEscape: function(){
                          window.toggleCalendar();
                          document.querySelector('.main-header__calendar-toggle').focus();
                      }">
