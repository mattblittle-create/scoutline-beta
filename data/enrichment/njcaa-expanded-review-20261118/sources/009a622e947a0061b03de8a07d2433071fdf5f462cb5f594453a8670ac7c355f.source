  margin: 0 -6px;
}
.bx3tanzhq-modal__browsers-button {
  flex: 1 0 auto;
  text-decoration: none;
  border-radius: 6px;
  background: whitesmoke;
  border-radius: 35px;
  padding: 12px;
  margin: 0 6px;
  border: 1px solid #d9d9d9;
  transition: .25s;
}
.bx3tanzhq-modal__browsers-button img {
