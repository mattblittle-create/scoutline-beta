  line-height: 1;
  padding: 0 12px;
}
.btkech1v2-modal__browsers--text {
  font-size: 14px;
  color: #2a2b2c;
  font-weight: 400;
}
.btkech1v2-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.btkech1v2-modal__browsers--text:last-child {
  padding-top: 4px;
}
.btkech1v2-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
  display: block;
  padding: 0 16px;
  color: black;
  width: 100%;
  margin-top: 8px;
  transition: .25s;
  line-height: 28px;
  height: 28px;
  font-size: 14px;
}
.btkech1v2-banner__consent:hover {
  background-color: black;
  color: white;
}

