                require(['jquery'], function ($) {
                    $main_nav_social = $('.main-navigation-social');
                    var social_ads_observer = new MutationObserver(function () {
                        if ($main_nav_social.find('.ad').length) {
                            $main_nav_social.css('display', 'block');

                            $main_nav_social.find('.main-navigation-social__toggle').click(function (e) {
                                $main_nav_social.toggleClass('is-open');
                            }).on('blur', function (e) {
                                $main_nav_social.removeClass('is-open');
                            });

                            $main_nav_social.find('.ad a').on('focus blur', function (e) {
                                console.log(e);
                                if (e.type === 'focus') {
                                    $main_nav_social.addClass('is-open');
                                }

                                if (e.type === 'blur') {
                                    $main_nav_social.removeClass('is-open');
                                }
                            });
                        }
                    });

                    social_ads_observer.observe($main_nav_social.find('ads-component')[0], { childList: true, subtree: true });
                });
                

