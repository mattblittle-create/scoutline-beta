                                                                <h4 class="sidearm-roster-player-extra-heading">Headlines</h4>
                                                            
									                        <ul class="flex flex-column medium-flex-row row" data-bind="foreach: stories">
										                        <li class="x-small-12 medium-4 columns sidearm-roster-player-extra-story">
											                        <!-- ko if: image -->
											                        <div class="sidearm-roster-player-stories-media hide-on-small-down">
												                        <img data-bind="attr: { src: image + '?width=400&height=200&mode=crop' }" alt="">
											                        </div>
											                        <!-- /ko -->
											                        <span data-bind="formatDate: date, format: 'MMM. D'"></span>
											                        <p class="sidearm-roster-player-stories-headline">
												                        <a data-bind="click: function() { return true; }, clickBubble: false, text: headline, attr: { href: url }"></a>
											                        </p>
										                        </li>
									                        </ul>
								                        </div>
							                        </div>
							
						                        <!-- /ko -->

						                        <!-- ko if: stats() && stories() -->

							                        <div class="sidearm-roster-player-extra-stats-stories flex flex-wrap row">

								                        <div class="sidearm-roster-player-extra-stats x-small-12 large-8 columns">
									                        <ul class="flex" data-bind="foreach: stats">
										                        <li data-bind="click: $parent.selectStatCategory, clickBubble: false, css: { 'sidearm-roster-player-extra-stats-tabs-selected' : selected }">
											                        <span class="hide-on-medium" data-bind="text: title_short"></span>
											                        <span class="hide-on-small-down" data-bind="text: title"></span>
										                        </li>
									                        </ul>

									                        <!-- ko foreach: stats -->
