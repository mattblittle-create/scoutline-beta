        <script>
            async function makeWidget() {

                // Wait for widget to finish loading
                while (!weplayed.hasOwnProperty("widget")) {
                    await new Promise(resolve => setTimeout(resolve, 1000));
                }

                // Fake it if local
                if ("" != "") {
                    weplayed.widget('sidearm-roster-player-moments', { "page": "" + location.pathname });
                }
                else {
                    weplayed.widget("sidearm-roster-player-moments");
                }

                var target = document.querySelector('#sidearm-roster-player-moments');

                // Load weplayed tab if it contains content
                var observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (mutation) {
                        if (document.querySelector('.weplayed-section-list') != null) {
                            document.querySelector('.sidearm-roster-player-moments-tab').style.display = 'inline-block';
                            observer.disconnect();
                        }
                    });
                });

                var config = { childList: true }
                observer.observe(target, config);
            }
        </script>
        <script id="weplayed-script" src="https://media.weplayed.com/widget/v1/widget.js" defer="" onload="makeWidget()"></script>
        <script>
            require(['knockout', 'jquery', 'models/showcase-player', 'analytics', 'vue', 'jquery-ui', 'showcaseplayerembed', 'binding-handlers', '/common/js/career.js'], function(ko, $, ShowcasePlayer, Analytics, Vue) {
                var global_sport_id = 1;
                var path = 'baseball';
                var year = '2026';
                var rp_id = '3077';
                var player_id = 2044;
                
                var excluded_career_sports = [19, 20, 52, 106, 107, 72, 73];
                if (excluded_career_sports.indexOf(global_sport_id) != -1) {
                    $("#career-stats").hide();
                }

                var ga_click_event_elements = document.querySelectorAll('.sidearm-ga-event-click');
                if (ga_click_event_elements && ga_click_event_elements.length) {
                    ga_click_event_elements.forEach(function(element) {
                        element.addEventListener('click', function() { Analytics.trackEvent(element.dataset.gaCategory, 'click', element.dataset.gaLabel); }, true);
                    });
                }

                $("#all_roster_players_button").on("click", function (e) {
                    e.preventDefault();
                    window.location = "/roster.aspx?rp_id=" + $('#ctl00_cplhMainContent_ctl04_all_roster_players').val();
                });

                $('.sidearm-responsive-tabs').tabs({
                    activate: function(event, ui) {
                        var $tab = $(ui.newPanel);

                        $tab.find("img.lazy:not(.loaded)").lazyload();
                        var lazyLoopCounter = 0,
                            lazyLoopStop = 100,
                            lazyLoop = setInterval(function(){
                                if (lazyLoopCounter >= lazyLoopStop) {
                                    clearInterval(lazyLoop);
                                } else {
                                    if ($tab.find("img.lazy:not(.loaded)").length) {
                                        
                                        $tab.find("img.lazy:not(.loaded)").each(function( index ) {
                                            var $this = $(this),
                                                src = $.trim($this.attr("src")),
                                                original = $.trim($this.attr("data-original"));
                                            if (src != original) {
                                                $this.lazyload();
                                            } else {
                                                $this.addClass("loaded");
                                            }
                                        });
                                    } else {
                                        clearInterval(lazyLoop);
                                    }
                                }
                            }, 1);

                        if ($tab.data("tab-activated"))
                            return;

                        $tab.attr("data-tab-activated", true);

                        if ($tab.data("tab-content") == "related")
                            get_player_related();
                        
                        else if ($tab.data("tab-content") == "stats")
                            get_player_stats(null, '2026');
                        
                    }
                });

                function get_player_related() {
                    var _related = new Related();
                    ko.applyBindings(_related, $(".sidearm-roster-player-related-container")[0]);
                }

                

                var vm_stats = {
                    isLoading: ko.observable(true),
                    stats: ko.observable(),
                    season: ko.observable(),
                    career_stats: ko.observableArray([]),
                    career_stats_table_html: ko.observable('')
                };

                ko.applyBindings(vm_stats, $(".sidearm-roster-player-stats-container")[0]);

                function get_player_stats(_params, season) {
                    if (_params == null) {
                        _params = { type: 'stats', rp_id: 3077, path: 'baseball', year: 2026, player_id: 0 };
                    }

                    vm_stats.isLoading(true);

                    path = getSportShortname(global_sport_id);

                    $.getJSON("/services/responsive-roster-bio.ashx", { type: 'career-stats', rp_id: rp_id, path: path }, function (response) {
                        if (response) {
                            vm_stats.career_stats_table_html(create_tables(response, path, global_sport_id));
                        } else {
                            vm_stats.career_stats_table_html('There are no statistics available for this player.');
                        }
                        vm_stats.isLoading(false);
                    });

                    $.getJSON("/services/responsive-roster-bio.ashx", _params, function (response) {
                        vm_stats.isLoading(false);
                        if (response) {
                            response["season"] = season;
                            vm_stats.stats(response);
                        }
                    }
                    );
                }

                

                $(document).on("focusin focusout", ".sidearm-link-dropdown a", function (e) {

                    if (e.type === "focusin") {

                        $(this).closest(".sidearm-link-dropdown").addClass("open");

                    } else if (e.type === "focusout") {

                        $(this).closest(".sidearm-link-dropdown").removeClass("open");

                    }

                }).on("click", function (e) {

                    var $this = $(e.target);

                    if (e.target.className.indexOf("sidearm-link-dropdown") > -1) {

                        e.preventDefault();

                        if ($this.closest(".sidearm-link-dropdown").hasClass("open")) {

                            $this.closest(".sidearm-link-dropdown").removeClass("open");

                        } else {

                            var width = $this.closest(".sidearm-link-dropdown").outerWidth();

                            $this.closest(".sidearm-link-dropdown").find("ul").css({
                                'width': width + 'px'
                            });

                            $this.closest(".sidearm-link-dropdown").addClass("open");

                        }

                    }

                    if ($this.hasClass("sidearm-link-dropdown-link")) {

                        e.preventDefault();

                        $this.closest(".sidearm-link-dropdown").find("a").removeClass("selected");

                        $this.addClass("selected");

                    }

                    if ($this.hasClass("sidearm-link-dropdown-link-stats-season")) {

                        e.preventDefault();

                        var _params = $.parseJSON($.trim($this.attr("data-params"))),
                            season = $.trim($this.text());

                        get_player_stats(_params, season);

                        if (typeof _params.year !== "undefined") {

                            $this.closest(".sidearm-link-dropdown").find(".sidearm-link-dropdown-selected").text($.trim($this.text()));

                            $(".sidearm-link-dropdown-link-stats-season").removeClass("selected");
                            $this.addClass("selected");

                        }

                    }

                });

                var Related = function () {
                    var self = this;

                    self.isLoading = ko.observable(true);
                    self.stories = ko.observableArray([]);
                    self.pressclips = ko.observableArray([]);
                    self.videos = ko.observableArray([]);
                    self.photos = ko.observableArray([]);

                    $.getJSON("/services/responsive-roster-bio.ashx", { type: 'related', rp_id: 3077, player_id: 2044 }, function (response) {
                        self.isLoading(false);
                        if (response.videos != null && response.videos.length > 0) {
                            response.videos.map(function (_video) {
                                if (_video.id)
                                    _video.showcase = new ShowcasePlayer({ Archive: _video.id });
                            });
                        }

                        if (response.stories)
                            self.stories(response.stories);
                        if (response.pressclips)
                            self.pressclips(response.pressclips);
                        if (response.videos)
                            self.videos(response.videos);
                        if (response.photos)
                            self.photos(response.photos);
                    });
                }

                
            });

        </script>

        

        
                    </main>

