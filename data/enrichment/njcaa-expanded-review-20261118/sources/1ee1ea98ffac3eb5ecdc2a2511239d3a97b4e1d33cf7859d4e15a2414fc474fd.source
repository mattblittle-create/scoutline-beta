<script>
    var obj = {"start":0,"count":2,"name":"","sport_id":null,"count_breakpoints":"[{\"breakpoint\":1025,\"count\":2,\"name\":\"awards--standard\"},{\"breakpoint\":0,\"count\":2,\"name\":\"awards--slider\"}]","css_class":"","pinned_id":"","extra":{},"context":null,"dummy":false,"type":"awards","id":"b834bf4b-3625-4a3d-b690-4bf5ca51a1a2","data":[{"id":65,"aow_type_id":1,"aow_type_title":"Athlete Spotlight","firstname":"Lejla","lastname":"Drndar","gender":"","hometown":null,"highschool":"Taft High School","major":null,"previous_team":null,"sport_title":"Women's Soccer","external_link":null,"sport":{"id":12,"title":"Women's Soccer","abbreviation":"WSOC","shortname":"wsoc","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":null,"gender":null,"youtube":null,"facebook":null,"twitter":null,"instagram":null,"pinterest":null,"tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"position_long":"","position_short":"","short_highlights":"Lejla Drndar<br >\r\nLejla quickly established herself as a leader on the team and was named a captain. She led by example at every practice and game, and her effort was always on display. She is also doing really well in the classroom. Lejla was named to the 2nd Team All-Conference (Skyway). She will be someone I will heavily count on for next season to keep the girls together and to keep the team atmosphere positive. <br >\r\n ","academic_year":"Fr.","academic_year_full":"Freshman","jersey_number":"15","use_bio_photo":false,"image":"/images/2026/11/4/1B7A6591.JPG","background_image":null,"url":"/awards.aspx?aow=65","date":"2026-11-04T00:00:00"},{"id":66,"aow_type_id":1,"aow_type_title":"Athlete Spotlight","firstname":"Claudio","lastname":"Joffre","gender":"","hometown":null,"highschool":"Barron Collier High School, Florida ","major":null,"previous_team":null,"sport_title":"Men's Soccer","external_link":null,"sport":{"id":6,"title":"Men's Soccer","abbreviation":"MSOC","shortname":"msoc","short_title":"","global_sport_id":null,"non_sport":false,"show_at_vs":false,"global_sport_shortname":null,"gender":null,"youtube":null,"facebook":null,"twitter":null,"instagram":null,"pinterest":null,"tickets":null,"global_sport_name_slug":null,"url":null,"ranking":null,"game_synonym":null},"position_long":"","position_short":"","short_highlights":"Claudio Joffre<br >\r\n <br >\r\nClaudio has worked unbelievably hard in his time so far at Oakton. That hard work has paid off with some incredible performances this year and recognition as the Skyway Conference Goalkeeper of the Year. He's proven himself a great goalkeeper and a great teammate. I'm very proud of what Claudio has accomplished thus far in his collegiate career and can wait to see what's in store for him in the future. <br >\r\n ","academic_year":"So.","academic_year_full":"Sophomore","jersey_number":"99","use_bio_photo":false,"image":"/images/2026/11/4/1B7A7132_copy.jpg","background_image":null,"url":"/awards.aspx?aow=66","date":"2026-11-04T00:00:00"}],"mode":"web"};
