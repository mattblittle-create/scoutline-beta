                        <script>
                            require(['jquery', 'slick'], function () {
                                $(window).on('load', function() {
                                    let slider = document.querySelector('.sidearm-roster-player-header-action-photos');
                                    let sliderPause = document.querySelector('.sidearm-roster-player-header-background .slick-play-pause');

                                    $(slider).slick({ arrows: false, dots: false, fade: true, autoplay: true, autoplaySpeed: 5000, pauseOnHover: false });

                                    sliderPause.addEventListener('click', e => {
                                        e.preventDefault();
                                        if (sliderPause.classList.contains("slick-pause")) {
                                            $(slider).slick('slickPause');
                                            sliderPause.classList.remove('slick-pause');
                                            sliderPause.classList.add('slick-play');
                                            sliderPause.innerHTML = 'Play';
                                        } else {
                                            $(slider).slick('slickPlay');
                                            sliderPause.classList.remove('slick-play');
                                            sliderPause.classList.add('slick-pause');
                                            sliderPause.innerHTML = 'Pause';
                                        }
                                    });
                                });
                            });
                        </script>
                    

                
                
