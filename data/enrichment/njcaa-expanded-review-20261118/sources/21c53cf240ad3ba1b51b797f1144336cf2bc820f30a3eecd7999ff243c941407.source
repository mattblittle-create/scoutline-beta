  font-weight: 400;
}
.bw4kzhqdj-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.bw4kzhqdj-modal__browsers--text:last-child {
  padding-top: 4px;
}
.bw4kzhqdj-banner__consent {
  -webkit-appearance: none;
  background-color: whitesmoke;
  border: 1px solid #d9d9d9;
  display: block;
  padding: 0 16px;
  color: black;
  width: 100%;
  margin-top: 8px;
