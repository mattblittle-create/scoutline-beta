<a class="c-events__link" data-bind="attr: { href: window.associated_sport ? '/schedule.aspx?path=' + window.associated_sport.shortname : '/calendar.aspx' }">
    <span>Calendar +</span>
</a></script><script type='text/html' id='template-awards'><!-- ko if: name() === 'award-list' -->
    <!-- ko if: data().length > 0 -->
        <div class="component c-awards c-awards--standard flex" data-bind="fastForEach: data">
            <!-- ko if: $index() === 0 -->
                <div class="c-awards__item flex flex-align-center" data-bind="style: { backgroundImage: 'url(' + image + '?width=1920&height=1080&mode=crop&scale=both&format=jpg&quality=80)' }">
                    <div class="c-awards__details text-right flex flex-column flex-justify-end flex-align-end">
                        <div class="c-awards__sport" data-bind="text: sport.title"></div>
                        <a class="c-awards__name" data-bind="attr: { href: url }">
                            <div class="c-awards__name-first" data-bind="text: firstname"></div>
                            <div class="c-awards__name-last" data-bind="text: lastname"></div>
                        </a>
                    </div>
                </div>
            <!-- /ko -->

            <!-- ko if: $index() === 1 -->
                <div class="c-awards__item flex flex-align-center" data-bind="style: { backgroundImage: 'url(' + image + '?width=1920&height=1080&mode=crop&scale=both&format=jpg&quality=80)' }">
                    <div class="c-awards__details text-left flex flex-column flex-justify-end flex-align-start">
                        <div class="c-awards__sport" data-bind="text: sport.title"></div>
                        <a class="c-awards__name" data-bind="attr: { href: url }">
                            <div class="c-awards__name-first" data-bind="text: firstname"></div>
                            <div class="c-awards__name-last" data-bind="text: lastname"></div>
                        </a>
                    </div>
                </div>
            <!-- /ko -->
            
            <!-- ko if: $index() === 0 -->
                <div class="c-awards__logo-container flex flex-column flex-align-center flex-justify-center text-center">
                    <img class="c-awards__logo" data-bind="attr: {src: $component.bucket + '/images/responsive_2020/main-logo.svg'}" alt="" />
                    <span class="c-awards__logo-text-container flex flex-column">
                        <span class="c-awards__logo-text top">Bobcats</span>
                        <span class="c-awards__logo-text bottom">of the month</span>
                    </span>
                </div>
            <!-- /ko -->
        </div>
    <!-- /ko -->
<!-- /ko -->

<!-- ko if: name() === 'award-slider' -->
    <!-- ko if: data().length > 0 -->
        <div class="component c-awards c-awards--slider" data-bind="afterBind: {foreach: data, callback: slick}" data-slick-options="{arrows: true, infinite: false, slidesToShow: 1, slidesToScroll: 1}">
            <div class="c-awards__item flex flex-column flex-align-center" data-bind="style: { backgroundImage: 'url(' + image + '?width=1920&height=1080&mode=crop&scale=both&format=jpg&quality=80)' }">
                <div class="c-awards__details text-right flex flex-column flex-justify-end flex-align-end">
                    <div class="c-awards__sport" data-bind="text: sport.title"></div>
                    <a class="c-awards__name" data-bind="attr: { href: url }">
                        <div class="c-awards__name-first" data-bind="text: firstname"></div>
                        <div class="c-awards__name-last" data-bind="text: lastname"></div>
                    </a>
                </div>
            </div>
        </div>
        <div class="c-awards__logo-container flex flex-column flex-align-center flex-justify-center text-center">
            <img class="c-awards__logo" data-bind="attr: {src: $component.bucket + '/images/responsive_2020/main-logo.svg'}" alt="" />
            <span class="c-awards__logo-text-container flex flex-column">
                <span class="c-awards__logo-text top">Bobcats</span>
                <span class="c-awards__logo-text bottom">of the month</span>
            </span>
        </div>
    <!-- /ko -->
<!-- /ko --></script><script type='text/html' id='template-content-stream'><div class="component c-contentstream">
    <a class="sidearm-skip-link" href="#CHANGE-THIS-TO-LINK-TO-NEXT-SECTION-ID-OR-FOOTER">Skip Content Stream</a>
    <div class="c-contentstream__top">
        <ul class="c-contentstream__filter reset-list flex">
            <!-- ko foreach: displayTypes -->
                <li class="c-contentstream__filter-item" data-bind="css: 'c-contentstream__filter-item--' + type">
                    <button type="button" data-bind="click: $parent.filterStream, css: { 'is-active': type == $parent.selectedDisplayType().type }, attr: { 'aria-label': $data.type == $parent.selectedDisplayType().type ? $data.type : $data.type + ' filter', 'aria-pressed': type == $parent.selectedDisplayType().type ? 'true' : 'false' }" class="c-contentstream__filter-button is-active">
                        <!-- ko if: type === 'All' -->
                            <span aria-hidden="true" class="sf-grid sidearm-icon"></span>
                            <span>All</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Twitter' -->
                            <span aria-hidden="true" class="sf-twitter sidearm-icon"></span>
                            <span>Twitter</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Instagram' -->
                            <span aria-hidden="true" class="sf-instagram sidearm-icon"></span>
                            <span>Instagram</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Facebook' -->
                            <span aria-hidden="true" class="sf-facebook-square sidearm-icon"></span>
                            <span>Facebook</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Headlines' -->
                            <span aria-hidden="true" class="sf-newspaper sidearm-icon"></span>
                            <span>Stories</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'YouTube' -->
                            <span aria-hidden="true" class="sf-youtube sidearm-icon"></span>
                            <span>Youtube</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Videos' -->
                            <span aria-hidden="true" class="sf-play sidearm-icon"></span>
                            <span>All Access</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Galleries' -->
                            <span aria-hidden="true" aria-hidden="true" class="sf-picture sidearm-icon"></span>
                            <span>Photos</span>
                        <!-- /ko -->
                        <!-- ko if: type === 'Podcasts' -->
                            <span aria-hidden="true" class="sf-microphone sidearm-icon"></span>
                            <span>Podcasts</span>
                        <!-- /ko -->
                    </button>
                </li>
            <!-- /ko -->
        </ul>
    </div>
    <div class="c-contentstream__stream" data-bind="afterBind: { foreach: data, callback: packery }">
        <!-- ko if: type === 'tweet' -->
            <div class="c-contentstream__item c-contentstream__item--twitter" data-bind="with: data">
                <div class="c-contentstream__item-inner">
                    <!-- ko if: media -->
                        <span class="sidearm-icon top sf-twitter"></span>
                        <div class="c-contentstream__media">
                            <img class="c-contentstream__media-image" data-bind="attr: { 'src': media, alt: '' }" />
                        </div>
                    <!-- /ko -->
                    <div class="c-contentstream__user flex flex-align-center">
                        <div class="c-contentstream__user-image-container">
                            <img class="c-contentstream__user-image" data-bind="attr: {'src': user.image, alt: user.name + '\'s profile'}" />
                        </div>
                        <div class="c-contentstream__user-name" data-bind="text: user.name"></div>
                        <!-- ko if: !media -->
                            <span class="sidearm-icon inner sf-twitter"></span>
                        <!-- /ko -->
                    </div>
                    <div class="c-contentstream__body">
                        <div class="c-contentstream__text" data-bind="html: text"></div>
                    </div>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'facebook' -->
            <div class="c-contentstream__item c-contentstream__item--facebook" data-bind="with: data">
                <div class="c-contentstream__item-inner">
                    <!-- ko if: full_picture -->
                        <span class="sidearm-icon top sf-facebook-square"></span>
                        <div class="c-contentstream__media">
                            <img class="c-contentstream__media-image" data-bind="attr: { 'src': full_picture, alt: 'facebook post' }" />
                        </div>
                    <!-- /ko -->
                    <div class="c-contentstream__user flex flex-align-center">
                        <div class="c-contentstream__user-image-container">
                            <img class="c-contentstream__user-image" data-bind="attr:{ 'src': page.picture, alt: page.name + ' profile' }" />
                        </div>
                        <div class="c-contentstream__user-name" data-bind="text: page.name"></div>
                        <!-- ko if: !full_picture -->
                            <span class="sidearm-icon inner sf-facebook-square"></span>
                        <!-- /ko -->
                    </div>
                    <div class="c-contentstream__body">
                        <!-- ko if: message -->
                            <div class="c-contentstream__text" data-bind="html: message"></div>
                        <!-- /ko -->
                        <!-- ko if: !message && description -->
                            <div class="c-contentstream__text" data-bind="html: description"></div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'instagram' -->
            <div class="c-contentstream__item c-contentstream__item--instagram" data-bind="with: data">
                <div class="c-contentstream__item-inner">
                    <a class="c-contentstream__media" data-bind="attr: { href: link }" target="_blank">
                        <span class="sidearm-icon top sf-instagram"></span>
                        <img class="c-contentstream__media-image" data-bind="attr: { 'src': images.standard_resolution.url, alt: caption ? caption.text : 'No Instagram caption available'}" />
                        <div class="c-contentstream__user flex flex-align-center">
                            <div class="c-contentstream__user-image-container">
                                <img class="c-contentstream__user-image" data-bind="attr: { 'src': user.profile_picture, alt: user.full_name + ' profile' }">
                            </div>
                            <div class="c-contentstream__user-name" data-bind="text: user.full_name"></div>
                        </div>
                    </a>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'youtube' -->
            <div class="c-contentstream__item c-contentstream__item--video" data-bind="with: data">
                <div class="c-contentstream__item-inner">
                    <div class="c-contentstream__media aspect" data-bind="showcasePlayer: showcase, modal: true, videoContainer: $('.showcase-modal__player')">
                        <div class="showcase-modal" data-bind="clickBubble: false">
                            <div class="showcase-modal__inner">
                                <div class="showcase-modal__player"></div>
                                <button type="button" class="showcase-modal__close" data-bind="click: showcase().closeVideo" aria-label="Close video modal">
                                    <span aria-hidden="true" class="sf-close sidearm-icon"></span>
                                </button>
                            </div>
                        </div>
                        <img class="c-contentstream__media-image" data-bind="attr:{ src: images.maxres ? images.maxres : images.medium, alt:title}" />
                        <button class="c-contentstream__media-play" type="button" data-bind="click: showcase().playVideo, attr: {'aria-label': 'Play video ' + title}"></button>
                    </div>
                    <div class="c-contentstream__body">
                        <div class="c-contentstream__title" data-bind="text: title"></div>
                        <div class="c-contentstream__views" data-bind="text: views + ' views'"></div>
                    </div>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'allaccess' -->
            <div class="c-contentstream__item c-contentstream__item--video" data-bind="with:data">
                <div class="c-contentstream__item-inner">
                    <div class="c-contentstream__media aspect" data-bind="showcasePlayer: showcase, modal: true, videoContainer: $('.showcase-modal__player')">
                        <div class="showcase-modal" data-bind="clickBubble: false">
                            <div class="showcase-modal__inner">
                                <div class="showcase-modal__player"></div>
                                <button type="button" class="showcase-modal__close" data-bind="click: showcase().closeVideo" aria-label="Close video modal">
                                    <span aria-hidden="true" class="sf-close sidearm-icon"></span>
                                </button>
                            </div>
                        </div>
                        <img class="c-contentstream__media-image" data-bind="attr: {'src': poster, alt: title}" />
                        <button class="c-contentstream__media-play" type="button" data-bind="click: showcase().playVideo, attr: {'aria-label': 'Play video ' + title}"></button>
                    </div>
                    <div class="c-contentstream__body">
                        <div class="c-contentstream__title" data-bind="text: title"></div>
                        <div class="c-contentstream__views" data-bind="text: views + ' views'"></div>
                    </div>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'gallery' -->
            <div class="c-contentstream__item c-contentstream__item--gallery" data-bind="with: data">
                <div class="c-contentstream__item-inner">
                    <a class="c-contentstream__link" data-bind="attr: { href: url }">
                        <div class="c-contentstream__media relative">
                            <img class="c-contentstream__media-image" data-bind="attr: { 'src': images.medium.url, alt: title }">
                        </div>
                    </a>
                    <div class="c-contentstream__body">
                        <div class="c-contentstream__title" data-bind="text: title"></div>
                        <div class="c-contentstream__sport" data-bind="text: sport.title"></div>
                    </div>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'podcast' -->
            <div class="c-contentstream__item c-contentstream__item--podcast" data-bind="with: data">
                <div class="c-contentstream__item-inner">
                    <!-- ko if: image -->
                        <div class="c-contentstream__media relative">
                            <img class="c-contentstream__media-image" data-bind="attr: { 'src': image + '?width=540&height=304&mode=crop&scale=both&format=jpg&quality=80', alt: title }">
                        </div>
                    <!-- /ko -->
                    <div class="c-contentstream__body">
                        <div class="c-contentstream__title">
                            <a class="c-contentstream__url" data-bind="text: title, attr: { href: url }"></a>
                        </div>
                        <div class="c-contentstream__sport" data-bind="text: sport.title"></div>
                        <div class="c-contentstream__date" data-bind="formatDate: publish_date, format: 'MMM D, YYYY'"></div>
                    </div>
                </div>
            </div>
        <!-- /ko -->
        <!-- ko if: type === 'story' -->
            <div class="c-contentstream__item c-contentstream__item--story" data-bind="with: data, css: { 'c-contentstream__item--featured' : featured }">
                <div class="c-contentstream__item-inner relative">
                    <!-- ko if: image_source -->
                        <div class="c-contentstream__media aspect">
                            <img class="c-contentstream__media-image" data-bind="attr: { 'src': image_source + '?width=540&height=304&mode=crop&scale=both&format=jpg&quality=80', alt: image_alt_text }" />
                        </div>
                    <!-- /ko -->
                    <div class="c-contentstream__body">
                        <div class="c-contentstream__title">
                            <a class="c-contentstream__url" data-bind="text: title, attr: { href: url }"></a>
                        </div>
                        <div class="c-contentstream__sport" data-bind="text: sport.title"></div>
                        <div class="c-contentstream__date" data-bind="formatDate: date, format: 'MMM D, YYYY'"></div>
                    </div>
                </div>
            </div>
        <!-- /ko -->
    </div>
    <!-- ko if: moreToLoad -->
        <div class="load-more__container text-center">
            <button class="load-more__button" data-bind="click: loadMore">
                <span data-bind="text: isLoadingMore() ? 'Loading...' : 'Load More'"></span>
            </button>
        </div>
    <!-- /ko -->
</div></script><script type='text/html' id='template-youtube'><div class="component c-videos c-videos--grid">
