}
.blq0bn0tb-modal__browsers--text span {
  font-size: 16px;
  color: black;
  font-weight: 700;
}
.blq0bn0tb-modal__browsers--text:last-child {
  padding-top: 4px;
}
.blq0bn0tb-banner__consent {
  -webkit-appearance: none;
