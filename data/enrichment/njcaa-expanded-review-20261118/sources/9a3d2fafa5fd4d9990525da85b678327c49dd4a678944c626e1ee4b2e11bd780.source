}
.blq0bn0tb-modal__title::after {
  content: '';
  display: block;
  width: 48px;
  height: 2px;
  background-color: black;
  margin-top: 8px;
}
.blq0bn0tb-modal__text a {
  color: black;
}
.blq0bn0tb-modal__learn {
  color: black;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5rem;
}
.blq0bn0tb-modal__learn a {
  color: black;
}
.blq0bn0tb-modal__browsers {
  padding-top: 12px;
  margin: 0 -6px;
}
.blq0bn0tb-modal__browsers-button {
  flex: 1 0 auto;
  text-decoration: none;
  border-radius: 6px;
  background: whitesmoke;
  border-radius: 35px;
  padding: 12px;
  margin: 0 6px;
  border: 1px solid #d9d9d9;
  transition: .25s;
}
.blq0bn0tb-modal__browsers-button img {
  width: 36px;
  height: 36px;
}
.blq0bn0tb-modal__browsers-button:hover {
  background: #d9d9d9;
}
