			<main class="main-content-placeholder" id="main-content">
				
    

    <div data-bind="stopBindings: true">
        <div id="vue-archives">
            <vue-archives>
        </vue-archives></div>
    </div>
    
    <script type="text/x-template" id="vue-archives-template">
        <article class="sidearm-archives sidearm-common">
            <div v-reapplyKnockout class="sidearm-common-promotion">
                <ads-component params="{name : 'archives-above-header-1'}" ></ads-component>
            </div>
            <h2>Story Archives</h2>
            <header class="sidearm-archives-header sidearm-common-header flex row flex-column large-flex-row noprint">
                <ul class="sidearm-archives-select-list sidearm-common-header-select-list flex flex-column medium-flex-row flex-item-1">
                    <li class="sidearm-archives-select-filter flex flex-item-1">
                        <label class="hide" for="vue-archives-input">Search...</label>
                        <input class="flex-item-1" id="vue-archives-input" v-on:keydown.enter.prevent="reset_page(); get_stories()" v-model="query" placeholder="Search...">
                    </li>
                    <li class="sidearm-archives-select-filter flex flex-item-1">
                        <label class="hide" for="vue-archives-sports">Sports Dropdown</label>
                        <select class="sidearm-common-header-remove-right-radius" id="vue-archives-sports" v-model="sport">
                            <option value="0">All Sports </option>
                            <option v-for="sport in sports" v-bind:value="sport.shortname">{{ sport.title }}</option>
                        </select>
                    </li>
                    <li class="sidearm-archives-select-filter flex flex-item-1">
                        <label class="hide" for="vue-archives-seasons">Season Dropdown</label>
                        <select class="sidearm-common-header-remove-right-radius" id="vue-archives-seasons"  v-model="season">
                            <option value="0">All Seasons</option>
                            <option v-for="season in seasons" v-bind:value="season">{{ season }}</option>
                        </select>
                    </li>
                    <li class="sidearm-archives-select-submit flex flex-item-1">
                        <button @click="reset_page(); get_stories()" type="button" class="btn-search sidearm-common-header-remove-left-radius"
                            aria-label="Go filter archives list by search, sport, or season filters">Go</button>
                    </li>
                </ul>
            </header>
    
            <div v-reapplyKnockout class="sidearm-common-promotion">
                <ads-component params="{name : 'archives-below-header-1'}" ></ads-component>
            </div>

            <div v-if="loading_stories" class="sidearm-archives-searching text-center text-italic">
                <span>Please Wait... Loading Search Results.</span>
    
                <div class="sidearm-progress-bar">
                    <div></div>
                    <div></div>
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            </div>
  
            <table v-if="!loading_stories" class="sidearm-table collapse-on-medium">
                <caption class="hide">Story Archives</caption>
                <thead class="sidearm-primary">
                    <tr>
                        <th class="text-left text-uppercase" scope="col">Posted</th>
                        <th class="text-left text-uppercase" scope="col">Headline</th>
                        <th class="sidearm-archives-sports-categories text-left text-uppercase" scope="col">Category</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="stories" v-for="(story, index) in stories" :key="`search-item-${index}`">
                        <td class="text-no-wrap" v-html="story.story_postdate"></td>
                        <th scope="row">
                            <a v-bind:href="story.story_path" v-html="story.story_headline"></a>
                        </th>
                        <td class="sidearm-archives-sports-categories hide-on-medium-down" v-html="story.sports_cats">
                        </td>
                        <td class="sidearm-archives-summary hide-on-large">
                            {{ cleanHTML(story.story_summary) }}
                        </td>
                    </tr>
                </tbody>
            </table>
            <div v-if="page_count > 1" class="sidearm-pager" role="navigation" aria-label="Archives Pagination">
                <a v-if="previous_page > 0" @click="go_to_previous" href="javascript:void(0);"
                    class="sidearm-pager-button sidearm-pager-button-text sidearm-pager-button-previous">Previous</a>
                <ul class="sidearm-pager-list" role="list">
                    <li v-for="(item, index) in get_pages" :key="`pagination-item-${item}`">
                        <button class="sidearm-pager-button sidearm-pager-button-number sidearm-pager-button-number-' + item" type="button" :class="{ 'sidearm-pager-active' : current_page === item }" @click="current_page != item ? go_to_page(item) : null">{{item}}</button>
                    </li>
                </ul>
                <a v-if="next_page <= page_count" @click="go_to_next" href="javascript:void(0);"
                    class="sidearm-pager-button sidearm-pager-button-text sidearm-pager-button-next">Next</a>
            </div>
    
            <div v-reapplyKnockout class="sidearm-common-promotion">
                <ads-component params="{name : 'archives-below-content-1'}" ></ads-component>
            </div>
        </article>
    </script>

    <script>
        require([ 'vue','knockout','moment','analytics'], function (Vue, ko, moment, Analytics) {
            Vue.config.devtools = true;
            var sport_obj = {"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_title":"","global_sport_id":1,"non_sport":false,"show_at_vs":false,"global_sport_shortname":null,"gender":"m","youtube":"","facebook":"","twitter":"Oakton_Baseball","instagram":"","pinterest":"","tickets":"","global_sport_name_slug":"baseball","url":null,"ranking":null,"game_synonym":null};
            var query_page = 1;
            var season = 0;
            Vue.component('vue-archives', {
                template: '#vue-archives-template',
                data: () => ({
                    current_page: query_page != 1 ? query_page : 1,
                    page_size: 30,
                    first_page: 1,
                    query: '',
                    max_page_count: 5,
                    loading_stories: true,
                    loading_trending: true,
                    loading_mostpopular: true,
                    story_count: 0,
                    stories: [],
                    trending: [],
                    sports: [],
                    seasons: [],
                    sport: sport_obj != null ? sport_obj.shortname : 0,
                    season: season != "" || season != null ? season : 0,
                }),
                methods: {
                    cleanHTML(_text) {
                        var text = _text;
                        if (!text) return "";
                        var cleanHTML = text.replace(/(<script(\s|\S)*?<\/script>)|(<style(\s|\S)*?<\/style>)|(<!--(\s|\S)*?-->)|(<\/?(\s|\S)*?>)/g, "");
                        return cleanHTML;
                    },
                    reset_page() {
                        this.current_page = 1;
                        this.push_state();
                    },
                    push_state() {
                        let params = [];
                        if (this.season) {
                            params.push({ key: "season", value: this.season });
                        }
                        if (this.sport) {
                            params.push({ key: "path", value: this.sport });
                        }
                        if (this.query) {
                            params.push({ key: "q", value: this.query });
                        }
                        if (this.current_page && this.current_page != 1) {
                            params.push({ key: "page", value: this.current_page });
                        }
                        history.pushState({}, "", window.location.href.split('?')[0] + (params.length > 0 ? "?" : "") + params.map(x => {
                            return x.key + "=" + x.value;
                        }).join("&"));
                    },
                    get_stories() {
                        this.stories = [];
                        this.loading_stories = true;
                        document.body.scrollTop = 0; // For Safari
                        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera

                        $.get("/services/archives.ashx/stories", { 
                            index: this.current_page,
                            page_size: this.page_size,
                            sport: this.sport,
                            season: this.season,
                            search: this.query
                        }, function (response) {})
                        .then(function (response) {
                            this.story_count = response.data && response.data[0] ? response.data[0].row_count : 0;
                            this.stories = response.data;
                            this.loading_stories = false;
                        }.bind(this));
                    },
                    get_sports() {
                        this.sports = [];
                        $.get("/services/archives.ashx/setup_sports_dropdown", {
                        }, function (response) { })
                            .then(function (response) {
                                this.sports = response.data;
                            }.bind(this));
                    },
                    get_seasons() {
                        this.sports = [];
                        $.get("/services/archives.ashx/setup_seasons_dropdown", {
                        }, function (response) { })
                            .then(function (response) {
                                this.seasons = response.data;
                            }.bind(this));
                    },
                    go_to_page(page) {
                        if (page >= this.first_page && page <= this.last_page) {
                            this.set_current_page(page);
                            this.push_state();
                        }
                    },
                    go_to_previous() {
                        var previous = this.previous_page;
                        if (previous != null && previous > 0) {
                            this.set_current_page(previous);
                            this.push_state();
                        }
                    },
                    go_to_next() {
                        var next = this.next_page;
                        if (next != null || next <= this.page_count) {
                            this.set_current_page(next);
                            this.push_state();
                        }
                    },
                    set_current_page(page) {
                        if (page < this.first_page)
                            page = this.first_page;

                        if (page > this.last_page)
                            page = this.last_page;


                        Analytics.trackEvent('Archives Pagination', 'click', 'Page ' + page );
                        Analytics.trackPageView(window.location.pathname + '?page=' + page);
                        this.current_page = page;
                        this.get_stories();
                    },
                    init() {  
                        this.get_sports();
                        this.get_seasons();
                        this.get_stories();
                    }
                },
                computed: {
                    last_page() {
                        return this.page_count;
                    },
                    page_count() {
                        return Math.ceil(this.story_count / this.page_size);
                    },
                    previous_page() {
                        return this.current_page - 1;
                    },
                    next_page() {
                        return this.current_page + 1;
                    },
                    get_pages() {
                        if (this.page_count <= this.max_page_count) {
                            var pages = [];
                            for (var i = this.first_page; i <= this.last_page; i++)
                            pages.push(i);
                            
                            return pages;
                        }

                        return this.generate_max_page;
                    },
                    generate_max_page() {
                        var current = this.current_page;
                        var page_count = this.page_count;
                        var first = this.first_page;

                        var upper_limit = current + parseInt((this.max_page_count - 1) / 2);
                        var down_limit = current - parseInt((this.max_page_count - 1) / 2);

                        while (upper_limit > page_count) {
                            upper_limit--;
                            if (down_limit > first)
                                down_limit--;
                        }

                        while (down_limit < first) {
                            down_limit++;
                            if (upper_limit < page_count)
                                upper_limit++;
                        }

                        var pages = [];
                        for (var i = down_limit; i <= upper_limit; i++) {
                            pages.push(i);
                        }
                        return pages;
                    }
                },
                created() {
                    this.init();

                    var self = this;

                    window.onpopstate = function (event) {
                        const page_query_param = parseInt((new URLSearchParams(window.location.search)).get('page'));
                        self.set_current_page(page_query_param);
                    };
                },
            });
            Vue.directive('reapplyKnockout', {
                inserted: function (el) {
                    var intervalCounter = 0;
                    var interval = setInterval(function () {
                        if (intervalCounter < 50) {
                            if (ko.dataFor(document.getElementsByTagName('body')[0])) {
                                clearInterval(interval);
                                ko.applyBindings({}, el);
                            }
                            intervalCounter++;
                        } else {
                            clearInterval(interval);
                        }
                    }, 100);
                }
            });
            Vue.component('sidearm-loading', {
                template: `
                <div class="sidearm-progress-bar">
                    <div></div>
                    <div></div>
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
                `
            });

            var instance = new Vue({
                el: '#vue-archives',
            });
        });
</script>

			</main>

            <footer class="main-footer" aria-labelledby="main-footer__label">
