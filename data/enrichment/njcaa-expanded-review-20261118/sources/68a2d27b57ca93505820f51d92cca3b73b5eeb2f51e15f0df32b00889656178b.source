			<main class="main-content-placeholder" id="main-content">
				
    

    <div data-bind="stopBindings: true">
        <div id="vue-archives">
            <vue-archives>
        </vue-archives></div>
    </div>

    <script type="text/x-template" id="vue-archives-template">
        <div class="vue-archives vue-archives-template-1">
            <header class="vue-archives-header flex">
                <div class="vue-archives-input flex flex-item-1">
                    <label class="hide" for="vue-archives-input">What are you Looking for?</label>
                    <input class="flex-item-1" id="vue-archives-input" v-on:keydown.enter.prevent="get_stories" v-model="query" placeholder="What are you looking for?">
                    <button aria-label="Search" type="button"  @click="get_stories">
                        <span aria-hidden="true" class="sf-search-3"></span>
                    </button>
                </div>
                <div class="vue-archives-inputs">
                    <button @click="show_modal" class="vue-archives-inputs--button" type="button">
                        <span>Filter</span>
                        <span v-if="modal_active" class="sf-close-minimal"></span>
                        <span v-if="!modal_active" class="sf-settings-2-minimal"></span>
                    </button>
                    <div v-if="modal_active" class="vue-archives-inputs--modal">
                        <div class="vue-archives-select vue-archives-select--sports flex">
                            <label class="hide" for="vue-archives-sports">What are you Looking for?</label>
                            <div class="vue-archives-select-wrapper">
                                <select class="flex-item-1" id="vue-archives-sports" v-model="sport">
                                    <option value="0">All Sports </option>
                                    <option v-for="sport in sports" v-bind:value="sport.shortname">{{ sport.title }}</option>
                                </select>
                            </div>
                        </div>

                        <div class="vue-archives-select vue-archives-select--seasons flex">
                            <label class="hide" for="vue-archives-seasons">What are you Looking for?</label>
                            <div class="vue-archives-select-wrapper">
                                <select class="flex-item-1" id="vue-archives-seasons"  v-model="season">
                                    <option value="0">All Seasons</option>
                                    <option v-for="season in seasons" v-bind:value="season">{{ season }}</option>
                                </select>
                            </div>
                        </div>  
                        
                        <button class="vue-archives-select--button" @click="reload_content" type="button" aria-label="Apply filters to display archives by text, sport, or season">
                            <span v-if="content_loaded">Apply Filters</span>
                            <span v-if="!content_loaded"><sidearm-loading-circle :pixel="32"></sidearm-loading-circle></span>
                        </button>
                        <button class="vue-archives-select--button vue-archives-select--button-reset" @click="reset_filters" v-if="dropdowns_changed" type="button">Clear Filters</button>
                    </div>  
                </div>       
            </header>
            <div class="vue-archives-content">
                <div class="vue-archives-list">
                    <span class="vue-archives-loading" v-if="loading_stories">
                        <sidearm-loading-circle :pixel="64"></sidearm-loading-circle>
                    </span>
                    <div class="vue-archives-stories" v-if="!loading_stories">
                        <h2 class="vue-archives-stories--header"> Story Archives {{ current_page > 1 ? ' - Page ' + current_page : null }}</h2>
                        <ul v-if="stories.length">
                            <li class="vue-archives-item flex" v-for="(story, index) in stories" :key="`search-item-${index}`">
                                <div class="vue-archives-item--image">
                                    <img v-if="story.story_image" :src="story.story_image + '?width=640&height=360&mode=crop&scale=both&Anchor=topcenter'" :alt="story.image_alt_text ? story.image_alt_text : (story.story_headline ? story.story_headline : '')">
                                </div>
                                <div class="vue-archives-item--content">
                                    <div class="vue-archives-item--headline">
                                        <a v-if="story.story_headline" v-bind:href="story.story_path"  v-html="story.story_headline"></a>
                                    </div>
                                    <div v-if="story.story_summary" class="vue-archives-item--summary" v-html="story.story_summary"></div>
                                    <div class="vue-archives-item--metadata ">
                                        <span>Date: {{ moment(story.story_postdate).format('MMMM D, YYYY') }}</span>
                                        <span>Category: {{ story.sports_cats }}</span>
                                    </div>
                                </div>
                            </li>
                        </ul>
                        <div class="vue-archives-no-content" v-if="!stories.length">
                            No results for this search keyword. Please try another keyword.
                        </div>              
                    </div>
                    <div class="vue-archives-pagination flex" v-if="page_count > 1" role="navigation" aria-label="Archives Pagination">
                        <button class="vue-archives-pagination--arrow sidearm-pager-button sidearm-pager-button-text sidearm-pager-button-previous" type="button" v-if="previous_page > 0" @click="go_to_previous">Previous</button>
                        <ul class="vue-archives-pagination--list">
                            <li v-for="(item, index) in get_pages" :key="`pagination-item-${item}`">
                                <button class="vue-archives-pagination--pager" type="button" :class="{ 'page-button-clickable': current_page != item, 'page-button-active' : current_page === item }" @click="current_page != item ? go_to_page(item) : null">{{item}}</button>
                            </li>
                        </ul>
                        <button class="vue-archives-pagination--arrow sidearm-pager-button sidearm-pager-button-text sidearm-pager-button-next" type="button" v-if="next_page <= page_count" @click="go_to_next" >Next</button>
                    </div>
                </div>
            </div> 
            
        </div>
    </script>

    <script>
        require([ 'vue','knockout','moment','analytics'], function (Vue, ko, moment, Analytics) {
            Vue.config.devtools = true;
            var sport_obj = {"id":1,"title":"Baseball","abbreviation":"BASE","shortname":"baseball","short_title":"Baseball","global_sport_id":1,"non_sport":false,"show_at_vs":false,"global_sport_shortname":null,"gender":"m","youtube":"","facebook":"","twitter":"","instagram":"","pinterest":"","tickets":"","global_sport_name_slug":"baseball","url":null,"ranking":null,"game_synonym":null};
            var query_page = 1;
            var season = 0;
            Vue.component('vue-archives', {
                template: '#vue-archives-template',
                data: () => ({
                    current_page: query_page != 1 ? query_page : 1,
                    page_size: 20,
                    first_page: 1,
                    query: '',
                    max_page_count: 5,
                    loading_stories: true,
                    loading_trending: true,
                    loading_mostpopular: true,
                    modal_active: false,
                    story_count: 0,
                    stories: [],
                    trending: [],
                    quicklinks: [],
                    sports: [],
                    seasons: [],
                    sport: sport_obj != null ? sport_obj.shortname : 0,
                    filtered: false,
                    sport_title: null,
                    season: season != "" || season != null ? season : 0,
                }),
                methods: {
                    cleanHTML(_text) {
                        var text = _text;
                        if (!text) return "";
                        var cleanHTML = text.replace(/(<script(\s|\S)*?<\/script>)|(<style(\s|\S)*?<\/style>)|(<!--(\s|\S)*?-->)|(<\/?(\s|\S)*?>)/g, "");
                        return cleanHTML;
                    },
                    show_modal() {
                        if (this.modal_active)
                            return this.modal_active = false;

                        this.modal_active = true;
                    },
                    reset_filters() {
                        this.sport = 0;
                        this.sport_title = null;
                        this.season = 0;
                        this.reload_content();
                        this.filtered = false;
                    },
                    insertParam(key, value) {
                        if (history.pushState) {
                            let searchParams = new URLSearchParams(window.location.search);
                            searchParams.set(key, value);
                            let newurl = window.location.protocol + "//" + window.location.host + window.location.pathname + '?' + searchParams.toString();
                            window.history.pushState({ path: newurl }, '', newurl);
                        }
                    },
                    get_stories() {
                        this.stories = [];
                        this.loading_stories = true;
                        document.body.scrollTop = 0; // For Safari
                        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera

                        if(this.query || this.sport || this.season) {
                            this.insertParam("search", this.query);
                            this.insertParam("sport", this.sport)
                            this.insertParam("season", this.season)
                        }

                        $.get("/services/archives.ashx/stories", { 
                            index: this.current_page,
                            page_size: this.page_size,
                            sport: this.sport,
                            season: this.season,
                            search: this.query
                        }, function (response) {})
                        .then(function (response) {
                            this.story_count = response.data && response.data[0] ? response.data[0].row_count : 0;
                            this.stories = response.data;
                            this.loading_stories = false;
                        }.bind(this));
                    },
                    get_sports() {
                        this.sports = [];
                        $.get("/services/archives.ashx/setup_sports_dropdown", {
                        }, function (response) { })
                            .then(function (response) {
                                this.sports = response.data;
                            }.bind(this));
                    },
                    get_seasons() {
                        this.sports = [];
                        $.get("/services/archives.ashx/setup_seasons_dropdown", {
                        }, function (response) { })
                            .then(function (response) {
                                this.seasons = response.data;
                            }.bind(this));
                    },
                    get_trending() {
                        this.trending = [];
                        this.loading_trending = true;
                        $.get("/services/analytics.ashx", {
                            take:8,
                            detailed: 1,
                            sport_shortnames: this.sport != 0 ? this.sport : 'all'
                        }, function (response) { })
                            .then(function (response) {
                                if (response && response.data)
                                    this.trending = response.data;
                                    this.loading_trending = false;
                            }.bind(this));
                    },
                    get_quicklinks() {
                        $.get("/services/navigation.ashx", { section: 'Archives Page' }, function (response) { })
                            .done(function (response) {
                            var data = response.nav;
                            this.quicklinks = data;
                        }.bind(this));
                    },
                    reload_content() {   
                        this.get_stories();
                        this.filtered = true;
                        this.get_trending();
                    },
                    go_to_page(page) {
                        if (page >= this.first_page && page <= this.last_page) {
                            this.set_current_page(page);
                        }
                    },
                    go_to_previous() {
                        var previous = this.previous_page;
                        if (previous != null && previous > 0) {
                            this.set_current_page(previous);
                        }
                    },
                    go_to_next() {
                        var next = this.next_page;
                        if (next != null || next <= this.page_count) {
                            this.set_current_page(next);
                        }
                    },
                    set_current_page(page) {
                        if (page < this.first_page)
                            page = this.first_page;

                        if (page > this.last_page)
                            page = this.last_page;
                        
                        Analytics.trackEvent('Archives Pagination', 'click', 'Page ' + page );
                        Analytics.trackPageView(window.location.pathname + '?page=' + page);
                        this.current_page = page;
                        this.get_stories();
                    },
                    init() {  
                        this.get_sports();
                        this.get_seasons();
                        this.get_stories();
                        this.get_trending();
                        this.get_quicklinks();
                    }
                },
                computed: {
                    last_page() {
                        return this.page_count;
                    },
                    dropdowns_changed() {
                        if (this.sport != null || this.season > 0)
                            return true;

                        return false;
                    },
                    content_loaded() {
                        if (!this.loading_trending && !this.loading_stories) {
                            return true;
                        }
                        else {
                            return false;
                        }
                    },
                    page_count() {
                        return Math.ceil(this.story_count / this.page_size);
                    },
                    previous_page() {
                        return this.current_page - 1;
                    },
                    next_page() {
                        return this.current_page + 1;
                    },
                    get_pages() {
                        if (this.page_count <= this.max_page_count) {
                            var pages = [];
                            for (var i = this.first_page; i <= this.last_page; i++)
                            pages.push(i);
                            
                            return pages;
                        }

                        return this.generate_max_page;
                    },
                    generate_max_page() {
                        var current = this.current_page;
                        var page_count = this.page_count;
                        var first = this.first_page;

                        var upper_limit = current + parseInt((this.max_page_count - 1) / 2);
                        var down_limit = current - parseInt((this.max_page_count - 1) / 2);

                        while (upper_limit > page_count) {
                            upper_limit--;
                            if (down_limit > first)
                                down_limit--;
                        }

                        while (down_limit < first) {
                            down_limit++;
                            if (upper_limit < page_count)
                                upper_limit++;
                        }

                        var pages = [];
                        for (var i = down_limit; i <= upper_limit; i++) {
                            pages.push(i);
                        }
                        return pages;
                    }
                },
                created() {
                    var query_strings = new URLSearchParams(window.location.search);
                    if (query_strings.has('search') || query_strings.has('sport') || query_strings.has('season')) {
                        this.query = query_strings.get('search');
                        this.sport = query_strings.get('sport');
                        this.season = query_strings.get('season');
                    }

                    this.init();
                }
            });
            Vue.directive('reapplyKnockout', {
                inserted: function (el) {
                    var intervalCounter = 0;
                    var interval = setInterval(function () {
                        if (intervalCounter < 50) {
                            if (ko.dataFor(document.getElementsByTagName('body')[0])) {
                                clearInterval(interval);
                                ko.applyBindings({}, el);
                            }
                            intervalCounter++;
                        } else {
                            clearInterval(interval);
                        }
                    }, 100);
                }
            });
            Vue.component('tabs', {
                template: `
                    <div class="vue-archives-tabs">
                        <ul class="vue-archives-tabs--list">
                            <li v-for="tab in tabs" :class="{ 'is-active': tab.isActive }">
                                <button type="button" @click="selectTab(tab)">{{ tab.name }}</button>
                            </li>
                        </ul>
                        <div class="vue-archives-tabs--panel">
                            <slot></slot>
                        </div>
                    </div>
                `,
                data() {
                    return { tabs: [] };
                },
                created() {
                    this.tabs = this.$children;
                },
                methods: {
                    selectTab(selectedTab) {
                        this.tabs.forEach(tab => {
                            tab.isActive = (tab.name == selectedTab.name);
                        });
                    }
                }
            });
            Vue.component('tab', {
                template: `<div v-show="isActive"><slot></slot></div>`,
                props: {
                    name: { required: true },
                    selected: { default: false }
                },
                data() {
                    return {
                        isActive: false
                    };
                },
                computed: {
                },
                mounted() {
                    this.isActive = this.selected;
                }
            });

            Vue.component('sidearm-loading-circle', {
                template: `
                <svg class="spinner" :width="pixel + 'px'" :height="pixel + 'px'" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" stroke-linecap="round" cx="33" cy="33" r="30"></circle>
                    </svg><svg class="spinner" width="32px" height="32px" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" stroke-linecap="round" cx="255" cy="255" r="255"></circle>
                </svg>
                `,
                props: {
                    pixel: {
                        type: Number,
                        required: true
                    }
                }
            });

            var instance = new Vue({
                el: '#vue-archives',
            });
        });
    </script>

