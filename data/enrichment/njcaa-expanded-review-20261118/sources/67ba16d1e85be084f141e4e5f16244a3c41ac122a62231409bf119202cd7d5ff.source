			<script>
				require(['jquery', 'jquery-ui'], function ($) {
					require(['sidearm-responsive'], function () {
                        $(window).on('load', function() {
							$(window).sidearmResponsive();

							var staff = [{"label":"Troy Tucker","value":1},{"label":"Brennan  McCarthy","value":255},{"label":"Adrian Yaguez","value":2},{"label":"Sheri Bollinger","value":5},{"label":"Ben Master","value":346},{"label":"Maria Popek LAT, ATC","value":99},{"label":"Samuel S.  Chen ","value":234},{"label":"Karen Mattes","value":235},{"label":"Maria Popek LAT, ATC","value":99},{"label":"Sydney Wright LAT, ATC","value":319},{"label":"Gene  Smith ","value":273},{"label":"Morgan Labuda","value":354},{"label":"Lucas Skelley","value":355},{"label":"Ben Master","value":346},{"label":"Caleb  Brennan","value":331},{"label":"Scott  Cullen ","value":290},{"label":"Andrew  Trumbore","value":291},{"label":"Brennan  McCarthy","value":255},{"label":"Caleb  Brennan","value":331},{"label":"Brennan McCarthy ","value":44},{"label":"Dr. Todd VanNortwick","value":281},{"label":"Andrew Miller ","value":329},{"label":"Caleb Brennan","value":330},{"label":"Jason Bogden","value":129},{"label":"Jah-Seer Aulder","value":351},{"label":"Carly Gallagher","value":297},{"label":"Kelsey Gallagher","value":308},{"label":"Jason Bogden","value":129},{"label":"Victoria Keenan","value":353},{"label":"Adrian  Yaguez","value":16},{"label":"Jeremy Gigliotti","value":277},{"label":"Albert Ozelis","value":266},{"label":"Eric  Kutteroff","value":271},{"label":"Richard Sechler","value":272},{"label":"Bobby Thomas","value":278},{"label":"Paul Frank","value":279},{"label":"Mario Barrantes","value":187},{"label":"Derek Filipkowski ","value":323},{"label":"Drake  Brackett","value":284},{"label":"Zach O'Toole","value":301},{"label":"Johnsi Fajardo","value":348},{"label":"Rachael  Aquila","value":227},{"label":"Frankie Santiago ","value":275},{"label":"Xander McDonald","value":347},{"label":"Jayden Perez","value":350},{"label":"Rachael Aquila","value":336},{"label":"Frankie  Santiago","value":280},{"label":"Dennis Sierra","value":349},{"label":"Dennis Sierra","value":349},{"label":"Brennan McCarthy","value":325},{"label":"Brennan McCarthy","value":326}];

							$('#ctl00_cplhMainContent_txt_keyword_search').autocomplete({
								appendTo: '.sidearm-staff-select-search',
								source: staff,
								select: function(event, ui) {                           
									event.preventDefault(); 
									$(this).val(ui.item.label);   
									$(this).data('ui-autocomplete').search();
								},
								focus: function(event, ui) { 
									event.preventDefault(); 
									$(this).val(ui.item.label);
								}
							}).on("keypress", function(e) {
								if (e.keyCode == 13) {
									e.preventDefault();
									searchStaff();
								}
							});

							$('#ctl00_cplhMainContent_btn_keyword_search').click(function(e) {
								e.preventDefault();                        
								searchStaff(); 
							});

							function searchStaff() {
								var _list = $('#ctl00_cplhMainContent_txt_keyword_search').data('ui-autocomplete').menu.element[0];

								if (_list.children) {
									var _matches = [];
									$.each(_list.children, function(index, _item) {
										_matches.push(_item.innerText);
									});

									var _staff = staff.filter(function(_member) {
										if ($.inArray(_member.label, _matches) > -1)
											return _member;
									});

									if (_staff.length === 0) return;

									var $members = $('.sidearm-staff-member');
									$members.addClass('hide');

									var $categories = $('.sidearm-staff-category');
									$categories.addClass('hide');

									$.each(_staff, function(index, member) {
										var $search = $members.filter('[data-member-id=' + member.value + ']');
										$search.removeClass('hide');

										$.each($search, function(index, search) {
											var _category = $(search).data("category-id");
											$categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
										});
									}); 
								}
							}

							$('#ctl00_cplhMainContent_btn_filter_categories').click(function(e) {
                                e.preventDefault();
                                filterStaffByCategory();
                            });

                            function filterStaffByCategory(){
                                var _category = $('#ctl00_cplhMainContent_ddl_filter_categories').val();
                                var $members = $('.sidearm-staff-member');
                                var $categories = $('.sidearm-staff-category');

                                if(_category === ""){
                                    $members.removeClass('hide');
                                    $categories.removeClass('hide');
                                    return;
                                }

                                $members.addClass('hide');
                                $categories.addClass('hide');

                                $members.filter('[data-category-id=' + _category + ']').removeClass('hide');
                                $categories.filter('[data-category-id=' + _category + ']').removeClass('hide');
                            }
						});
					});
				});
            </script>

		

