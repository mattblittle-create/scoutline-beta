    <section class="s-media" aria-labelledby="#media_section" id="s-media">
        <h2 class="hide" id="media_section">Content Stream</h2>
        <div class="row no-pad">
            

<script>

    var component = {"type":"content-stream","id":"981068c1-fb90-4fd2-8745-b727991b7a18","data":[{"type":"story","featured":false,"pinned_id":null,"data":{"links":null,"id":4369,"headline":"The Bru Cru End Their Strong Season With a Loss to No. 3 Midland","sub_headline":null,"byline":"Spencer Porter","teaser":"<p><b>Grand Junction, Colorado-</b> The defending champs were unable to go on another postseason run as No. 9 seed Salt Lake (39-18) were eliminated from the JUCO World Series with a 9-3 loss to No. 3 seed Midland College. </p>\r\n\r\n<p>Midland sprinkled in runs throughout the game as they scored in five different innings. The Chaparrals homered three times. Salt Lake also hit three blasts. <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/aj-thomas/3544\" rel=\"smarttag\" rev=\"3544\">AJ Thomas</a></dfn> and <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/willy-roberts/3551\" rel=\"smarttag\" rev=\"3551\">Willy Roberts</a></dfn> hit back-to-back home runs in the seventh inning and <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/kade-gambill/3220\" rel=\"smarttag\" rev=\"3220\">Kade Gambill</a></dfn> hit a solo home run to lead off the ninth. <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/tyler-west/3543\" rel=\"smarttag\" rev=\"3543\">Tyler West</a></dfn> had another multi-hit game. </p>\r\n\r\n<p>The Bru Cru played Midland College on February 9th and lost 19-9. Salt Lake Baseball won the Region 18 Championship and the West District Championship before making their second straight JUCO World Series appearance. </p>\r\n\r\n<p><b>FOLLOW THE BRUINS!</b><br />\r\n<i>Follow along during the 2025-26 season on social media (Twitter: </i><a href=\"https://twitter.com/SLCCBruins\"><i>@slccbruins</i></a><i> | Instagram:</i><a href=\"https://www.instagram.com/utahwbb/\"><i> </i></a><a href=\"https://www.instagram.com/slccbruins/\"><i>@slccbruins</i></a><i> |Facebook:</i><a href=\"https://www.facebook.com/UTAHWBB\"><i> </i></a><a href=\"http://www.facebook.com/bruin.athletics\"><i>www.facebook.com/bruin.athletics</i></a></p>\r\n","url":"/news/2026/5/25/baseball-the-bru-cru-end-their-strong-season-with-a-loss-to-no-3-midland.aspx","pregame_story":null,"date":"2026-05-24T22:29:00","school":{"id":2,"title":"Salt Lake Community College","short_display":"Salt Lake Community College","schedule_display":"Salt Lake Community College","abbreviation":"SLCC","shortname":"slcc","mascot":null,"facebook_page":null,"twitter_username":null,"instagram_username":null,"snapchat_username":null,"edu_website":"http://www.slcc.edu/","athletics_website":"http://www.slccbruins.com","location":"Taylorsville, UT","gallery_id":null,"primary_background":"#000","primary_text":"#fff","safe_text_black":"#fff","safe_text_white":"#000","youtube_username":null,"school_active":true,"ncaa_id":56785,"statcrew_team_id":null,"image":{"id":88,"filename":"r10.png","path":"/images/logos","title":"Salt Lake Community CollegeLogo","alt_text":null,"url":"/images/logos/r10.png"},"links":null,"member_type":"F"},"sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_display":"","global_sport_id":1,"global_sport_shortname":"baseball","global_sport_gender":"m","youtube_playlist_id":"","twitter_name":"","facebook_page":"","instagram_user_name":"","show_on_scoreboard":true},"image":{"id":5963,"filename":"Media_Day_Trio.jpg","path":"/images/2026/3/11/","title":"Bru Cru Trio Media Day","alt_text":null,"url":"/images/2026/3/11//Media_Day_Trio.jpg"},"video":null}},{"type":"story","featured":false,"pinned_id":null,"data":{"links":null,"id":4368,"headline":"The Bru Cru Drop First JUCO World Series Game","sub_headline":null,"byline":"Spencer Porter","teaser":"<p><b>Grand Junction, Colorado-</b> No. 9 seed Salt Lake (39-17) lost 13-3 in five innings to No. 2 seed Blinn College (46-12).  </p>\r\n\r\n<p>The Bruins scored the first three runs of the game as LF <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/lute-chavez/3545\" rel=\"smarttag\" rev=\"3545\">Lute Chavez</a></dfn> hit a three-run home run. Blinn wasted no time and hit a solo home and a grand slam in the bottom of the first to take the lead once and for all. Blinn College hit three home runs in the game and had ten hits compared to Salt Lakes five. CF <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/tyler-west/3543\" rel=\"smarttag\" rev=\"3543\">Tyler West</a></dfn> and C <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/aj-thomas/3544\" rel=\"smarttag\" rev=\"3544\">AJ Thomas</a></dfn> both had two hits for Salt Lake. </p>\r\n","url":"/news/2026/5/25/baseball-the-bru-cru-drop-first-juco-world-series-game.aspx","pregame_story":null,"date":"2026-05-23T22:51:00","school":{"id":2,"title":"Salt Lake Community College","short_display":"Salt Lake Community College","schedule_display":"Salt Lake Community College","abbreviation":"SLCC","shortname":"slcc","mascot":null,"facebook_page":null,"twitter_username":null,"instagram_username":null,"snapchat_username":null,"edu_website":"http://www.slcc.edu/","athletics_website":"http://www.slccbruins.com","location":"Taylorsville, UT","gallery_id":null,"primary_background":"#000","primary_text":"#fff","safe_text_black":"#fff","safe_text_white":"#000","youtube_username":null,"school_active":true,"ncaa_id":56785,"statcrew_team_id":null,"image":{"id":88,"filename":"r10.png","path":"/images/logos","title":"Salt Lake Community CollegeLogo","alt_text":null,"url":"/images/logos/r10.png"},"links":null,"member_type":"F"},"sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_display":"","global_sport_id":1,"global_sport_shortname":"baseball","global_sport_gender":"m","youtube_playlist_id":"","twitter_name":"","facebook_page":"","instagram_user_name":"","show_on_scoreboard":true},"image":{"id":5962,"filename":"West_and_Martin.jpg","path":"/images/2026/3/7/","title":"Bru Cru West and Martin","alt_text":null,"url":"/images/2026/3/7//West_and_Martin.jpg"},"video":null}},{"type":"story","featured":false,"pinned_id":null,"data":{"links":null,"id":4367,"headline":"The Bru Cru Punch Their Ticket to the JUCO World Series For the Second Straight Year","sub_headline":"Salt Lake Defeat Central Arizona to Become 2026 West District Champs","byline":"Spencer Porter","teaser":"<p><b>Beatrice, Nebraska-</b> The 2025 JUCO World Series Champs are headed back to Grand Junction as the Bruins became the West District Champions for the second straight season. </p>\r\n\r\n<p>Salt Lake lost to Central Arizona 6-4 to force a winner take all game. The Bruins took charge in their second game against the Vaqueros and won 8-1.</p>\r\n\r\n<p>Salt Lake scored three runs in the bottom of the first off a three-run homer from <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/drew-smith/3547\" rel=\"smarttag\" rev=\"3547\">Drew Smith</a></dfn>. After sac-fly's from <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/gage-wareham/3219\" rel=\"smarttag\" rev=\"3219\">Gage Wareham</a></dfn> and from <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/tyler-west/3543\" rel=\"smarttag\" rev=\"3543\">Tyler West</a></dfn>, the Bruins led 5-0 after four innings. <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/kaden-hodson/3552\" rel=\"smarttag\" rev=\"3552\">Kaden Hodson</a></dfn> hit another blast and his two-run homer gave the Bruins a 7-1 lead after seven innings of play. In the eighth inning Wareham brought in the final run of the game with a fielder's choice RBI. RHP <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/nolan-tillitt/3562\" rel=\"smarttag\" rev=\"3562\">Nolan Tillitt</a></dfn> got the start and pitched well for the Bruins as he allowed one run in 4.2 innings. </p>\r\n","url":"/news/2026/5/17/baseball-the-bru-cru-punch-their-ticket-to-the-juco-world-series-for-the-second-straight-year.aspx","pregame_story":null,"date":"2026-05-16T16:57:00","school":{"id":2,"title":"Salt Lake Community College","short_display":"Salt Lake Community College","schedule_display":"Salt Lake Community College","abbreviation":"SLCC","shortname":"slcc","mascot":null,"facebook_page":null,"twitter_username":null,"instagram_username":null,"snapchat_username":null,"edu_website":"http://www.slcc.edu/","athletics_website":"http://www.slccbruins.com","location":"Taylorsville, UT","gallery_id":null,"primary_background":"#000","primary_text":"#fff","safe_text_black":"#fff","safe_text_white":"#000","youtube_username":null,"school_active":true,"ncaa_id":56785,"statcrew_team_id":null,"image":{"id":88,"filename":"r10.png","path":"/images/logos","title":"Salt Lake Community CollegeLogo","alt_text":null,"url":"/images/logos/r10.png"},"links":null,"member_type":"F"},"sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_display":"","global_sport_id":1,"global_sport_shortname":"baseball","global_sport_gender":"m","youtube_playlist_id":"","twitter_name":"","facebook_page":"","instagram_user_name":"","show_on_scoreboard":true},"image":{"id":5961,"filename":"Media_Day_Trio.jpg","path":"/images/2026/3/11/","title":"Bru Cru Trio Media Day","alt_text":null,"url":"/images/2026/3/11//Media_Day_Trio.jpg"},"video":null}},{"type":"story","featured":false,"pinned_id":null,"data":{"links":null,"id":4366,"headline":"The Bru Cru Score Four Runs in the Ninth, Win in Extras","sub_headline":null,"byline":"Spencer Porter","teaser":"<p><b>Beatrice, Nebraska-</b> 1B <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/kaden-hodson/3552\" rel=\"smarttag\" rev=\"3552\">Kaden Hodson</a></dfn> hit a grand slam with two outs in the ninth to tie the game and Salt Lake defeated Southeast Community College 7-6 in ten innings. LHP <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/mason-green/3546\" rel=\"smarttag\" rev=\"3546\">Mason Green</a></dfn> pitched 5.1 scoreless innings in relief and earned the win. Green recorded five strikeouts. 2B <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/gage-wareham/3219\" rel=\"smarttag\" rev=\"3219\">Gage Wareham</a></dfn> hit the game-winning RBI in the top of the tenth. </p>\r\n","url":"/news/2026/5/16/baseball-the-bru-cru-score-four-runs-in-the-ninth-win-in-extras.aspx","pregame_story":null,"date":"2026-05-15T22:06:00","school":{"id":2,"title":"Salt Lake Community College","short_display":"Salt Lake Community College","schedule_display":"Salt Lake Community College","abbreviation":"SLCC","shortname":"slcc","mascot":null,"facebook_page":null,"twitter_username":null,"instagram_username":null,"snapchat_username":null,"edu_website":"http://www.slcc.edu/","athletics_website":"http://www.slccbruins.com","location":"Taylorsville, UT","gallery_id":null,"primary_background":"#000","primary_text":"#fff","safe_text_black":"#fff","safe_text_white":"#000","youtube_username":null,"school_active":true,"ncaa_id":56785,"statcrew_team_id":null,"image":{"id":88,"filename":"r10.png","path":"/images/logos","title":"Salt Lake Community CollegeLogo","alt_text":null,"url":"/images/logos/r10.png"},"links":null,"member_type":"F"},"sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_display":"","global_sport_id":1,"global_sport_shortname":"baseball","global_sport_gender":"m","youtube_playlist_id":"","twitter_name":"","facebook_page":"","instagram_user_name":"","show_on_scoreboard":true},"image":{"id":5960,"filename":"Hodson_Player_of_the_Week.jpg","path":"/images/2026/3/31/","title":"Hodson Player of the Week","alt_text":null,"url":"/images/2026/3/31//Hodson_Player_of_the_Week.jpg"},"video":null}},{"type":"story","featured":false,"pinned_id":null,"data":{"links":null,"id":4365,"headline":"The Bru Cru Begin the District Tournament with Win","sub_headline":null,"byline":"Spencer Porter","teaser":"<p><b>Beatrice, Nebraska</b> The Bru Cru started off the 2026 West District with a 12-8 win over Northeastern Junior College. </p>\r\n\r\n<p>Salt Lake plated five runs in the fourth and fifth innings. The Bruins added two big insurance runs in the bottom of the eighth. Salt Lake had 14 hits and CF <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/tyler-west/3543\" rel=\"smarttag\" rev=\"3543\">Tyler West</a></dfn> had five of them. West and 2B <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/gage-wareham/3219\" rel=\"smarttag\" rev=\"3219\">Gage Wareham</a></dfn> both recorded three RBI. 1B <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/kaden-hodson/3552\" rel=\"smarttag\" rev=\"3552\">Kaden Hodson</a></dfn> and OF <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/willy-roberts/3551\" rel=\"smarttag\" rev=\"3551\">Willy Roberts</a></dfn> both homered in the win. Hodson went 3-5 with three runs scored. RHP <dfn><a href=\"http://www.slccbruins.com/sports/baseball/roster/case-beames/3548\" rel=\"smarttag\" rev=\"3548\">Case Beames</a></dfn> got the win for Salt Lake. </p>\r\n\r\n<p>Southeast Community College beat Central Arizona 9-1, so Salt Lake will play Southeast tomorrow. </p>\r\n","url":"/news/2026/5/15/baseball-the-bru-cru-begin-the-district-tournament-with-win.aspx","pregame_story":null,"date":"2026-05-14T20:30:00","school":{"id":2,"title":"Salt Lake Community College","short_display":"Salt Lake Community College","schedule_display":"Salt Lake Community College","abbreviation":"SLCC","shortname":"slcc","mascot":null,"facebook_page":null,"twitter_username":null,"instagram_username":null,"snapchat_username":null,"edu_website":"http://www.slcc.edu/","athletics_website":"http://www.slccbruins.com","location":"Taylorsville, UT","gallery_id":null,"primary_background":"#000","primary_text":"#fff","safe_text_black":"#fff","safe_text_white":"#000","youtube_username":null,"school_active":true,"ncaa_id":56785,"statcrew_team_id":null,"image":{"id":88,"filename":"r10.png","path":"/images/logos","title":"Salt Lake Community CollegeLogo","alt_text":null,"url":"/images/logos/r10.png"},"links":null,"member_type":"F"},"sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_display":"","global_sport_id":1,"global_sport_shortname":"baseball","global_sport_gender":"m","youtube_playlist_id":"","twitter_name":"","facebook_page":"","instagram_user_name":"","show_on_scoreboard":true},"image":{"id":5959,"filename":"West_and_Martin.jpg","path":"/images/2026/3/7/","title":"Bru Cru West and Martin","alt_text":null,"url":"/images/2026/3/7//West_and_Martin.jpg"},"video":null}},{"type":"story","featured":false,"pinned_id":null,"data":{"links":null,"id":4357,"headline":"2026 All Region Baseball Team Announced","sub_headline":null,"byline":"Conference Media Relations","teaser":null,"url":"/news/2026/5/11/2026-all-region-baseball-team-announced.aspx","pregame_story":null,"date":"2026-05-11T12:00:43","school":null,"sport":{"id":1,"title":"Baseball","abbreviation":"BB","shortname":"baseball","short_display":"","global_sport_id":1,"global_sport_shortname":"baseball","global_sport_gender":"m","youtube_playlist_id":"","twitter_name":"","facebook_page":"","instagram_user_name":"","show_on_scoreboard":true},"image":{"id":1031,"filename":"SWAC.png","path":"/images/logos","title":"Scenic West Athletic ConferenceLogo","alt_text":null,"url":"/images/logos/SWAC.png"},"video":null}}],"start":0,"count":6,"name":"","count_breakpoints":null,"sport_id":1,"school_id":0,"css_class":"","extra":null,"context":null,"dummy":false,"mode":"web"};
