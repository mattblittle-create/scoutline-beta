<script>
    $("#ctl00_cplhMainContent_ctl00_all_time_opponents_ddl").change(function () {
        if ($(this).val() != "")
            window.location = $(this).val();
    });

    $(".sidearm-opponent-history-landing button.sidearm-pager-button").click(function () {
        var page = parseInt($(this).attr('data-page'));
        var query_string = (page > 1 && page <= 5) ? '?p=' + page : '';
        window.location = '/sports/baseball/opponent-history' + query_string;
    });
</script>
    <script>
        require(["sidearm-responsive"], function () {
            $(window).sidearmResponsive();
        })
    </script>

