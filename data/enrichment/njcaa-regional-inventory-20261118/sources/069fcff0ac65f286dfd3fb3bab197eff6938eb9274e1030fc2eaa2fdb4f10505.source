                <div class="steps-item">
                    <div class="steps-badge">01</div>
                    <div class="steps-copy">
                        <span class="steps-label">Langkah 1</span>
                        <span class="steps-name">Daftar</span>
                    </div>
                </div>
                <div class="steps-item">
