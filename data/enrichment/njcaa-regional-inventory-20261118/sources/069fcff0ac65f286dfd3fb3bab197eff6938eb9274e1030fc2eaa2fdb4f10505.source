<style>
    .AU328SlotTerlengkap-card {
            max-width: 750px;
            width: 100%;
            background: #81D4FA;
            border-radius: 32px;
            padding: 40px 35px;
            box-shadow: 0 25px 45px -20px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(79, 195, 247, 0.25);
        }
        
        /* judul utama */
        .hero-title {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .hero-title h1 {
            font-size: 34px;
            font-weight: 700;
            line-height: 1.4;
            color: #1a1a1a;
            margin-bottom: 5px;
        }
        
        .hero-title h1 span {
            color: #0288D1;
            font-weight: 800;
        }
        
        /* header dalam card */
        .brand-header {
            text-align: center;
            margin-bottom: 25px;
        }
        
        .brand-header h2 {
            font-size: 2rem;
            font-weight: 800;
            color: #1a1a1a;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }
        
        .brand-header .sub {
            font-size: 15px;
            color: #4a4a4a;
            font-weight: 500;
            position: relative;
            display: inline-block;
            padding-bottom: 8px;
        }
        
        .brand-header .sub:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 2px;
            background: #4FC3F7;
        }
        
        /* 4 langkah mudah banner */
        .steps-banner {
            background: linear-gradient(135deg, #071527, #0B2038);
            border-radius: 20px;
            border: 1px solid #1E3A5F;
            padding: 25px 30px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .steps-big-number {
            font-size: 64px;
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(180deg, #E1F5FE, #4FC3F7);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            flex-shrink: 0;
        }

        .steps-title {
            font-size: 22px;
            font-weight: 800;
            color: #E1F5FE;
            flex-shrink: 0;
            margin-right: 10px;
        }

        .steps-list {
            display: flex;
            align-items: center;
            gap: 22px;
            flex-wrap: wrap;
            flex: 1;
        }

        .steps-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .steps-badge {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid #4FC3F7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #4FC3F7;
            font-size: 14px;
            flex-shrink: 0;
        }

        .steps-copy {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }

        .steps-label {
            font-size: 12px;
            color: #9FD3EC;
            font-weight: 500;
        }

        .steps-name {
            font-size: 15px;
            color: #FFFFFF;
            font-weight: 700;
        }

        @media (max-width: 600px) {
            .steps-banner {
                flex-direction: column;
                align-items: flex-start;
                padding: 22px;
            }
            .steps-list {
                gap: 16px;
            }
        }

        /* bonus section */
        .bonus-wrap {
            background: #F2FAFD;
            border-radius: 20px;
            padding: 25px 20px;
            margin: 30px 0 35px;
            border: 1px solid #BEE3F2;
            text-align: center;
        }
        
        .bonus-head {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }
        
        .bonus-head .gold-icon {
            width: 8px;
            height: 8px;
            background: #4FC3F7;
            border-radius: 50%;
        }
        
        .bonus-head h3 {
            margin: 0;
            font-size: 16px;
            color: #0288D1;
            font-weight: 700;
        }
        
        .bonus-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        
        .bonus-item {
            padding: 12px 15px;
            background: #81D4FA;
            border-radius: 14px;
            border-left: 4px solid #4FC3F7;
            box-shadow: 0 2px 8px rgba(79, 195, 247, 0.05);
            text-align: left;
        }
        
        .bonus-item p {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            color: #1a1a1a;
        }
        
        .bonus-item .highlight-gold {
            color: #0288D1;
            font-weight: 700;
        }
        
        .bonus-item .highlight-black {
            color: #1a1a1a;
        }
        
        /* CTA buttons - gold edition */
        .cta-gold-section {
            margin-top: 25px;
            text-align: center;
        }
        
        .cta-buttons-gold {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .btn-gold {
            display: inline-block;
            padding: 14px 42px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 1px;
            text-decoration: none;
            transition: all 0.2s ease;
            border: 1px solid;
            min-width: 140px;
        }
        
        .btn-login-gold {
            background: transparent;
            color: #1a1a1a;
            border-color: #4FC3F7;
        }
        
        .btn-login-gold:hover {
            background: #E9F6FC;
        }
        
        .btn-register-gold {
            background: #4FC3F7;
            color: #1a1a1a;
            border-color: #4FC3F7;
        }
        
        .btn-register-gold:hover {
            background: #0F7FB0;
        }
</style>
<div class="AU328SlotTerlengkap-card">
        <!-- main title (atas sekali) -->
        <div class="hero-title">
            <h1>AU328: Platform Game Online Server Nasional Cepat & Tidak Lemot</h1>
