// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_NEON")
  directUrl = env("DIRECT_URL")
}

model User {
  id                             String                                 @id @default(cuid())
  email                          String                                 @unique
  passwordHash                   String?
  name                           String?
  role                           String?
  workPhone                      String?
  phonePrivate                   Boolean                                @default(true)
  program                        String?
  photoUrl                       String?
  slug                           String?                                @unique
  createdAt                      DateTime                               @default(now())
  updatedAt                      DateTime                               @updatedAt
  emailPrivate                   Boolean                                @default(true)
  collegeId                      String?
  workPhoneExt                   String?
  adminAuditLogsActing           AdminAuditLog[]                        @relation("AdminAuditActingUser")
  adminProfile                   AdminUser?
  chatConversationParticipants   ChatConversationParticipant[]
  chatMessagesSent               ChatMessage[]                          @relation("ChatMessageSender")
  coachInvitesAccepted           CoachInvite[]                          @relation("CoachInviteAcceptedBy")
  coachInvitesCreated            CoachInvite[]                          @relation("CoachInviteCreatedBy")
  coachJoinRequestsDecided       CoachJoinRequest[]                     @relation("CoachJoinRequestDecidedBy")
  coachJoinRequestsCreated       CoachJoinRequest[]                     @relation("CoachJoinRequestCreatedBy")
  coachNotesAuthored             CoachNote[]
  coachPlayerRatings             CoachPlayerRating[]
  coachProfile                   CoachProfile?
  programProfileEdits            College[]                              @relation("CollegeProgramProfileUpdatedBy")
  notifications                  Notification[]
  parentProfile                  ParentProfile?
  payoutsReceived                Payout[]                               @relation("PayoutPayeeUser")
  Player                         Player?
  PlayerProfile                  PlayerProfile?
  notificationPreference         NotificationPreference?
  programVerificationSubmissions CollegeProgramVerificationSubmission[] @relation("ProgramVerificationSubmittedBy")
  programVerificationReviews     CollegeProgramVerificationSubmission[] @relation("ProgramVerificationReviewedBy")
  profileChangeLogsActed         ProfileChangeLog[]
  profileViewEvents              ProfileViewEvent[]
  publicProfileCaches            PublicProfileCache[]
  recruitingBoardAdded           RecruitingBoardEntry[]
  recruitingListsCreated         RecruitingList[]                       @relation("RecruitingListsCreated")
  recruitingListAccess           RecruitingListAccess[]
  referralsMade                  Referral[]                             @relation("ReferralReferrerUser")
  teamInvitesAccepted            TeamInvite[]                           @relation("TeamInviteAcceptedBy")
  teamInvitesCreated             TeamInvite[]                           @relation("TeamInviteCreatedBy")
  teamMemberships                TeamMembership[]
  college                        College?                               @relation(fields: [collegeId], references: [id])
}

model VerificationToken {
  id         String       @id
  email      String
  tokenHash  String
  purpose    TokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([tokenHash, purpose])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
}

model AdminUser {
  id                   String          @id @default(cuid())
  userId               String          @unique
  isActive             Boolean         @default(true)
  twoFactorRequired    Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  auditLogs            AdminAuditLog[] @relation("AdminAuditAdminUser")
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                AdminUserRole[]
  createdDiscountCodes DiscountCode[]  @relation("DiscountCodeCreatedByAdmin")
  updatedFeatureFlags  FeatureFlag[]   @relation("FeatureFlagUpdatedByAdmin")
}

model AdminUserRole {
  id          String    @id @default(cuid())
  adminUserId String
  role        AdminRole
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, role])
  @@index([role])
}

model AdminAuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  actingUserId String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  ip           String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime   @default(now())
  actingUser   User?      @relation("AdminAuditActingUser", fields: [actingUserId], references: [id])
  adminUser    AdminUser? @relation("AdminAuditAdminUser", fields: [adminUserId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model FeatureFlag {
  id                   String     @id @default(cuid())
  key                  String     @unique
  description          String?
  enabled              Boolean    @default(false)
  config               Json?
  updatedByAdminUserId String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  updatedByAdminUser   AdminUser? @relation("FeatureFlagUpdatedByAdmin", fields: [updatedByAdminUserId], references: [id])
}

model ParentProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  playerLinks ParentPlayerLink[]
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ParentPlayerLink {
  id              String        @id @default(cuid())
  parentProfileId String
  playerProfileId String
  relationship    String?
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([parentProfileId, playerProfileId])
  @@index([parentProfileId])
}

model CoachProfile {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  coachAccountType         CoachAccountType?
  coachBillingStatus       CoachBillingStatus?
  recruitingServiceName    String?
  recruitingServiceWebsite String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  recruitingTargets        Json?
  coachBio                 String?
  staffTitle               String?
  isProgramAdmin           Boolean              @default(false)
  contactEmail             String?
  coachInstagramUrl        String?
  coachXUrl                String?
  billingProfile           CoachBillingProfile?
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coachAccountType])
  @@index([coachBillingStatus])
}

model RecruitingList {
  id              String                 @id @default(cuid())
  collegeId       String
  name            String
  description     String?
  createdByUserId String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  college         College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdByUser   User                   @relation("RecruitingListsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  access          RecruitingListAccess[]
  members         RecruitingListMember[]

  @@unique([collegeId, name])
  @@index([collegeId, createdAt])
  @@index([createdByUserId])
}

model RecruitingListMember {
  id              String         @id @default(cuid())
  listId          String
  playerProfileId String
  label           String?
  createdAt       DateTime       @default(now())
  list            RecruitingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  playerProfile   PlayerProfile  @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([listId, playerProfileId])
  @@index([listId, createdAt])
  @@index([playerProfileId])
}

model RecruitingListAccess {
  id          String         @id @default(cuid())
  listId      String
  coachUserId String
  canEdit     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  coachUser   User           @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  list        RecruitingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, coachUserId])
  @@index([coachUserId])
}

model Player {
  userId             String       @unique
  gradYear           Int?
  primaryPos         String?
  secondaryPos       String?
  throws             String?
  bats               String?
  heightIn           Int?
  weightLb           Int?
  hsName             String?
  travelTeam         String?
  hometown           String?
  state              String?
  gpa                Decimal?     @db.Decimal(4, 2)
  act                Int?
  sat                Int?
  ncaaId             String?
  plan               Plan         @default(REDSHIRT)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  heightFt           Int?
  pitcherHand        PitcherHand?
  age                Int?
  dob                DateTime?
  dobPrivate         Boolean?     @default(true)
  gender             Gender?
  id                 Int          @id @default(autoincrement())
  committedProgram   String?
  committedProgramId String?
  isCommitted        Boolean      @default(false)
  publicEnabled      Boolean      @default(true)
  publicVisibility   Visibility   @default(PUBLIC)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlayerProfile {
  id                      String                 @id @default(cuid())
  email                   String                 @unique
  schemaVersion           Int
  updatedAt               DateTime               @updatedAt
  createdAt               DateTime               @default(now())
  data                    Json
  userId                  String?                @unique
  billingConflictFlag     Boolean                @default(false)
  hasActivePlayerBilling  Boolean                @default(false)
  hasActiveTeamBilling    Boolean                @default(false)
  ownerTeamId             String?
  ownershipMode           OwnershipMode          @default(PLAYER_PRIMARY)
  profileState            ProfileState           @default(PLAYER_OWNED_ACTIVE)
  playerBillingCadence    String                 @default("monthly")
  playerBillingStatus     String                 @default("Active")
  playerPlanTier          Plan                   @default(REDSHIRT)
  playerCancelEffectiveAt DateTime?
  playerCancelRequestedAt DateTime?
  coachInvites            CoachInvite[]
  coachNotes              CoachNote[]
  coachPlayerRatings      CoachPlayerRating[]
  parentLinks             ParentPlayerLink[]
  playerBillingProfile    PlayerBillingProfile?
  playerInvoices          PlayerInvoice[]
  ownerTeam               Team?                  @relation(fields: [ownerTeamId], references: [id])
  user                    User?                  @relation(fields: [userId], references: [id])
  changeLogs              ProfileChangeLog[]
  viewEvents              ProfileViewEvent[]
  recruitingBoardEntries  RecruitingBoardEntry[]
  RecruitingListMember    RecruitingListMember[]
  savedColleges           CollegeSavedSchool[]
  teamMemberships         TeamMembership[]
  teamSnapshots           TeamProfileSnapshot[]

  @@index([email])
  @@index([ownerTeamId])
  @@index([playerPlanTier])
}

model PublicProfileCache {
  slug      String   @id
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Team {
  id                String                @id @default(cuid())
  name              String
  slug              String                @unique
  teamType          TeamType
  city              String?
  state             String?
  logoUrl           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  websiteUrl        String?
  billingMode       TeamBillingMode       @default(NORMAL)
  sponsorName       String?
  sponsorNote       String?
  billingCadence    String                @default("monthly")
  billingStatus     String                @default("Active")
  planTier          Plan                  @default(TEAM)
  cancelEffectiveAt DateTime?
  cancelRequestedAt DateTime?
  contactEmail      String?
  instagramUrl      String?
  phone             String?
  phoneExt          String?
  phonePrivate      Boolean               @default(true)
  xUrl              String?
  coachNotes        CoachNote[]
  ownerProfiles     PlayerProfile[]
  profileViewEvents ProfileViewEvent[]
  billingProfile    TeamBillingProfile?
  invites           TeamInvite[]
  invoices          TeamInvoice[]
  memberships       TeamMembership[]
  joinLinks         TeamJoinLink[]
  snapshots         TeamProfileSnapshot[]
}

model TeamMembership {
  id                  String         @id @default(cuid())
  userId              String?
  teamId              String
  role                TeamRole
  season              String?
  isPrimaryForProfile Boolean        @default(false)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime       @default(now())
  isActive            Boolean        @default(true)
  playerProfileId     String?
  playerProfile       PlayerProfile? @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team                Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerProfileId, role, season])
  @@unique([userId, teamId, role, season])
  @@index([teamId, role])
  @@index([userId, role])
  @@index([playerProfileId, role])
  @@index([teamId, isActive])
}

model TeamJoinLink {
  id        String   @id @default(cuid())
  teamId    String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model CoachJoinLink {
  id        String   @id @default(cuid())
  collegeId String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model TeamInvite {
  id              String       @id @default(cuid())
  teamId          String
  invitedEmail    String
  parentEmail     String?
  tokenHash       String       @unique
  status          InviteStatus @default(PENDING)
  createdByUserId String?
  acceptedUserId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  acceptedAt      DateTime?
  expiresAt       DateTime?
  acceptedUser    User?        @relation("TeamInviteAcceptedBy", fields: [acceptedUserId], references: [id])
  createdByUser   User?        @relation("TeamInviteCreatedBy", fields: [createdByUserId], references: [id])
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([invitedEmail, status])
}

model CoachInvite {
  id              String            @id @default(cuid())
  collegeId       String
  invitedEmail    String
  tokenHash       String            @unique
  status          CoachInviteStatus @default(PENDING)
  canEditLists    Boolean           @default(false)
  createdByUserId String?
  acceptedUserId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  acceptedAt      DateTime?
  expiresAt       DateTime?
  playerProfileId String?
  staffRole       StaffRole         @default(ASSISTANT)
  staffTitle      String?
  acceptedUser    User?             @relation("CoachInviteAcceptedBy", fields: [acceptedUserId], references: [id])
  college         College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdByUser   User?             @relation("CoachInviteCreatedBy", fields: [createdByUserId], references: [id])
  PlayerProfile   PlayerProfile?    @relation(fields: [playerProfileId], references: [id])

  @@index([collegeId, status])
  @@index([invitedEmail, status])
  @@index([createdByUserId])
  @@index([acceptedUserId])
}

model CoachJoinRequest {
  id                String            @id @default(cuid())
  collegeId         String
  requestedByUserId String
  decidedByUserId   String?
  requestedRole     StaffRole         @default(ASSISTANT)
  proofUrl          String?
  notes             String?
  status            JoinRequestStatus @default(PENDING)
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  college           College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  decidedByUser     User?             @relation("CoachJoinRequestDecidedBy", fields: [decidedByUserId], references: [id])
  requestedByUser   User              @relation("CoachJoinRequestCreatedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([collegeId, status])
  @@index([requestedByUserId, status])
  @@index([status, createdAt])
}

model TeamBillingProfile {
  id                 String   @id @default(cuid())
  teamId             String   @unique
  provider           String   @default("VALOR")
  providerCustomerId String?
  providerPaymentRef String?
  paymentType        String?
  last4              String?
  brand              String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model TeamInvoice {
  id               String            @id @default(cuid())
  teamId           String
  status           InvoiceStatus     @default(UPCOMING)
  periodStart      DateTime
  periodEnd        DateTime
  amountCents      Int
  currency         String            @default("USD")
  externalId       String?
  hostedUrl        String?
  createdAt        DateTime          @default(now())
  paidAt           DateTime?
  commissionEvents CommissionEvent[]
  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, periodStart])
  @@index([teamId, status])
}

model PlayerBillingProfile {
  id                 String        @id @default(cuid())
  playerProfileId    String        @unique
  provider           String        @default("VALOR")
  providerCustomerId String?
  providerPaymentRef String?
  paymentType        String?
  last4              String?
  brand              String?
  updatedAt          DateTime      @updatedAt
  createdAt          DateTime      @default(now())
  playerProfile      PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerProfileId])
}

model PlayerInvoice {
  id                     String               @id @default(cuid())
  playerProfileId        String
  status                 InvoiceStatus        @default(UPCOMING)
  cadence                String               @default("monthly")
  periodStart            DateTime
  periodEnd              DateTime
  invoiceDate            DateTime
  dueDate                DateTime
  amountCents            Int
  cardFeeCents           Int                  @default(0)
  amountPaidCents        Int                  @default(0)
  externalId             String?
  hostedUrl              String?
  processorTransactionId String?
  processorResponseCode  String?
  processorReceiptUrl    String?
  failedAttemptCount     Int                  @default(0)
  lastFailedAt           DateTime?
  nextRetryAt            DateTime?
  failureReason          String?
  paidAt                 DateTime?
  createdAt              DateTime             @default(now())
  commissionEvents       CommissionEvent[]
  billingTransactions    BillingTransaction[]
  playerProfile          PlayerProfile        @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerProfileId, invoiceDate])
  @@index([playerProfileId, status])
  @@index([playerProfileId, periodStart])
}

model BillingTransaction {
  id String @id @default(cuid())

  invoiceId       String?
  playerProfileId String?

  provider String @default("VALOR")

  transactionType   String
  transactionStatus String

  providerTransactionId String?
  providerReference     String?

  amountCents  Int
  cardFeeCents Int @default(0)

  approvalCode    String?
  responseCode    String?
  responseMessage String?
  receiptUrl      String?

  rawPayload Json?

  createdAt DateTime @default(now())

  playerInvoice PlayerInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([playerProfileId])
  @@index([providerTransactionId])
  @@index([providerReference])
  @@index([transactionType])
  @@index([transactionStatus])
}

model BillingAuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("SYSTEM")
  actorId    String?
  targetType String
  targetId   String
  eventType  String
  message    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([eventType])
  @@index([createdAt])
}

model CoachBillingProfile {
  id                 String       @id @default(cuid())
  coachProfileId     String       @unique
  provider           String       @default("VALOR")
  providerCustomerId String?
  providerPaymentRef String?
  paymentType        String?
  last4              String?
  brand              String?
  updatedAt          DateTime     @updatedAt
  createdAt          DateTime     @default(now())
  coachProfile       CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@index([coachProfileId])
}

model College {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  slug String @unique

  // General school info
  websiteUrl      String?
  admissionsUrl   String?
  academicsUrl    String?
  majorsUrl       String?
  applicationUrl  String?
  financialAidUrl String?

  city    String?
  state   String?
  zipCode String?
  region  CollegeRegion?

  latitude  Float?
  longitude Float?

  control    CollegeControl?
  schoolType CollegeSchoolType @default(FOUR_YEAR)

  /**
   * Canonical tuition fields (stored in cents)
   * Examples:
   * - $24,500 => 2450000
   * - $52,999 => 5299900
   */
  tuitionInStateCents       Int?
  tuitionOutOfStateCents    Int?
  tuitionInternationalCents Int?

  /**
   * Legacy tuition fields
   * Keep temporarily for backward compatibility/migration.
   * Can be removed later once all imports/UI/API use cents fields.
   */
  tuitionInState       Int?
  tuitionOutOfState    Int?
  tuitionInternational Int?

  tuitionYear Int?

  enrollmentTotal     Int?
  enrollmentUndergrad Int?

  acceptanceRate Decimal? @db.Decimal(5, 2)
  graduationRate Decimal? @db.Decimal(5, 2)

  dataSourceUrl      String?
  lastVerifiedAt     DateTime?
  verificationStatus CollegeVerificationStatus @default(UNVERIFIED)

  // Existing athletics / coach-program fields
  conference                    String?
  division                      String?
  logoUrl                       String?
  programWebsiteUrl             String?
  programProfileUpdatedAt       DateTime?
  programProfileUpdatedByUserId String?
  programBio                    String?
  programInstagramUrl           String?
  programXUrl                   String?
  recruitingQuestionnaireUrl    String?

  // Relations
  academicAreas                  CollegeAcademicArea[]
  baseballProgram                CollegeBaseballProgram?
  coachInvites                   CoachInvite[]
  coachJoinRequests              CoachJoinRequest[]
  joinLinks                      CoachJoinLink[]
  coachNotes                     CoachNote[]
  coachPlayerRatings             CoachPlayerRating[]
  programProfileUpdatedByUser    User?                                  @relation("CollegeProgramProfileUpdatedBy", fields: [programProfileUpdatedByUserId], references: [id])
  programVerificationSubmissions CollegeProgramVerificationSubmission[]
  profileViewEvents              ProfileViewEvent[]
  recruitingBoardEntries         RecruitingBoardEntry[]
  recruitingLists                RecruitingList[]
  savedByPlayers                 CollegeSavedSchool[]
  coaches                        User[]

  @@index([name])
  @@index([state])
  @@index([region])
  @@index([control])
  @@index([schoolType])
  @@index([programProfileUpdatedByUserId])
}

enum VerificationSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_APPROVED
}

model TeamProfileSnapshot {
  id              String        @id @default(cuid())
  teamId          String
  playerProfileId String
  snapshot        Json
  createdAt       DateTime      @default(now())
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([playerProfileId])
}

model ProfileChangeLog {
  id              String           @id @default(cuid())
  playerProfileId String
  actorUserId     String?
  actorRole       ProfileActorRole
  changeSummary   String
  diff            Json?
  changedAt       DateTime         @default(now())
  actorUser       User?            @relation(fields: [actorUserId], references: [id])
  playerProfile   PlayerProfile    @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerProfileId])
  @@index([actorUserId])
}

model CoachNote {
  id              String        @id @default(cuid())
  playerProfileId String
  coachUserId     String
  teamId          String?
  collegeId       String?
  noteText        String
  sharedWithOrg   Boolean       @default(true)
  createdAt       DateTime      @default(now())
  coachUser       User          @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  college         College?      @relation(fields: [collegeId], references: [id])
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team            Team?         @relation(fields: [teamId], references: [id])

  @@index([playerProfileId])
  @@index([coachUserId])
  @@index([teamId])
  @@index([collegeId])
}

model CoachPlayerRating {
  id              String        @id @default(cuid())
  collegeId       String
  coachUserId     String
  playerProfileId String
  rating          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  coachUser       User          @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  college         College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([collegeId, coachUserId, playerProfileId])
  @@index([collegeId, playerProfileId])
  @@index([coachUserId])
}

model ProfileViewEvent {
  id              String            @id @default(cuid())
  playerProfileId String
  viewerUserId    String?
  viewerType      ProfileViewerType
  source          ProfileViewSource
  teamId          String?
  collegeId       String?
  ipHash          String?
  userAgentHash   String?
  viewedAt        DateTime          @default(now())
  countedInWeekly Boolean           @default(false)
  notifiedPlayer  Boolean           @default(false)
  college         College?          @relation(fields: [collegeId], references: [id])
  playerProfile   PlayerProfile     @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team            Team?             @relation(fields: [teamId], references: [id])
  viewerUser      User?             @relation(fields: [viewerUserId], references: [id])

  @@index([playerProfileId, viewedAt])
  @@index([viewerUserId])
  @@index([teamId])
  @@index([collegeId])
}

model RecruitingBoardEntry {
  id              String        @id @default(cuid())
  collegeId       String
  playerProfileId String
  addedByCoachId  String
  label           String?
  createdAt       DateTime      @default(now())
  notifiedPlayer  Boolean       @default(false)
  addedByCoach    User          @relation(fields: [addedByCoachId], references: [id], onDelete: Cascade)
  college         College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([collegeId, playerProfileId])
  @@index([collegeId])
  @@index([playerProfileId])
  @@index([addedByCoachId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  instantChatMessages Boolean @default(true)
  digestChatMessages  Boolean @default(false)

  instantProgramSaves Boolean @default(true)
  instantNewMatches   Boolean @default(true)

  instantStaffActivity Boolean @default(true)

  weeklyDigest Boolean @default(true)

  verificationReminders Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id            String                        @id @default(cuid())
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  lastMessageAt DateTime?
  subject       String?
  participants  ChatConversationParticipant[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@index([updatedAt])
}

model ChatConversationParticipant {
  id             String              @id @default(cuid())
  conversationId String
  userId         String
  role           ChatParticipantRole
  joinedAt       DateTime            @default(now())
  lastReadAt     DateTime?
  archivedAt     DateTime?
  muted          Boolean             @default(false)
  conversation   ChatConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
  @@index([conversationId, joinedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String
  createdAt      DateTime         @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User             @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

enum ChatParticipantRole {
  PLAYER
  COACH
  TEAM_ADMIN
  PARENT
  SCOUTLINE_ADMIN
}

model DiscountCode {
  id                   String                @id @default(cuid())
  code                 String                @unique
  type                 DiscountType
  value                Int
  appliesTo            DiscountAppliesTo     @default(BOTH)
  plansAllowedJson     String                @default("[]")
  cadence              String?
  durationType         DiscountDurationType  @default(ONCE)
  durationMonths       Int?
  expiresAt            DateTime?
  maxRedemptions       Int?
  isActive             Boolean               @default(true)
  oncePerTarget        Boolean               @default(false)
  allowedTargetIdsJson String                @default("[]")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdByAdminUserId String?
  applications         DiscountApplication[]
  createdByAdminUser   AdminUser?            @relation("DiscountCodeCreatedByAdmin", fields: [createdByAdminUserId], references: [id])
}

model DiscountApplication {
  id             String             @id @default(cuid())
  discountCodeId String
  targetType     DiscountTargetType
  targetId       String
  planTier       String
  cadence        String
  status         DiscountAppStatus  @default(ACTIVE)
  appliedAt      DateTime           @default(now())
  endsAt         DateTime?
  revokedAt      DateTime?
  metadata       Json?
  discountCode   DiscountCode       @relation(fields: [discountCodeId], references: [id])

  @@index([targetType, targetId, status])
  @@index([discountCodeId, status])
}

model Referral {
  id             String             @id @default(cuid())
  referrerUserId String?
  targetType     DiscountTargetType
  targetId       String
  sourceType     ReferralSourceType @default(MANUAL)
  sourceCode     String?
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  metadata       Json?
  commissions    CommissionEvent[]
  referrerUser   User?              @relation("ReferralReferrerUser", fields: [referrerUserId], references: [id])

  @@unique([targetType, targetId])
  @@index([referrerUserId])
  @@index([targetType, targetId])
  @@index([sourceType])
}

model CommissionEvent {
  id                    String           @id @default(cuid())
  referralId            String
  planTier              String
  cadence               String
  billedAmountCents     Int              @default(0)
  commissionAmountCents Int              @default(0)
  earnedAt              DateTime         @default(now())
  eligibleAt            DateTime?
  status                CommissionStatus @default(PENDING)
  teamInvoiceId         String?
  playerInvoiceId       String?
  discountApplicationId String?
  payoutId              String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  metadata              Json?
  note                  String?
  payout                Payout?          @relation(fields: [payoutId], references: [id])
  playerInvoice         PlayerInvoice?   @relation(fields: [playerInvoiceId], references: [id])
  referral              Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  teamInvoice           TeamInvoice?     @relation(fields: [teamInvoiceId], references: [id])

  @@index([status, eligibleAt])
  @@index([payoutId])
  @@index([teamInvoiceId])
  @@index([playerInvoiceId])
  @@index([referralId, earnedAt])
}

model Payout {
  id               String            @id @default(cuid())
  payeeUserId      String?
  status           PayoutStatus      @default(DRAFT)
  amountCents      Int               @default(0)
  method           String?
  note             String?
  sentAt           DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  commissionEvents CommissionEvent[]
  payeeUser        User?             @relation("PayoutPayeeUser", fields: [payeeUserId], references: [id])

  @@index([status])
  @@index([payeeUserId])
}

