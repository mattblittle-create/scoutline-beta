model CollegeBaseballProgram {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collegeId String  @unique
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  nickname String?
  logoUrl  String?

  baseballWebsiteUrl  String?
  rosterUrl           String?
  scheduleUrl         String?
  campsUrl            String?
  questionnaireUrl    String?
  generalContactUrl   String?
  generalContactEmail String?

  division   CollegeAthleticDivision?
  conference String?

  currentRosterSize Int?
  averageGpa        Decimal? @db.Decimal(4, 2)

  // Roster composition / opportunity signals
  graduatingSeniors        Int?
  graduatingPitchers       Int?
  graduatingCatchers       Int?
  graduatingInfielders     Int?
  graduatingOutfielders    Int?
  returningPitchers        Int?
  returningPositionPlayers Int?
  rosterFreshmen           Int?
  rosterSophomores         Int?
  rosterJuniors            Int?
  rosterSeniors            Int?
  portalTransfersIn        Int?
  portalTransfersOut       Int?

  scholarshipNotes   String?
  scholarshipInfoUrl String?

  transferHeavy Boolean @default(false)
  jucoFriendly  Boolean @default(false)

  // Program intelligence signals used for opportunity scoring.
  headCoachTenureYears     Int?
  recentWinPercentage      Decimal? @db.Decimal(5, 2)
  rosterTurnoverLevel      String?
  recruitingAggressiveness String?
  regionalRecruitingBias   String?
  conferenceStrength       String?
  draftHistoryNotes        String?
  playerDevelopmentNotes   String?

  dataSourceUrl      String?
  lastVerifiedAt     DateTime?
  verificationStatus CollegeBaseballVerificationStatus @default(UNVERIFIED)

  coaches        CollegeBaseballCoach[]
  rosterNeeds    CollegeBaseballRosterNeed[]
  metricAverages CollegeBaseballMetricAverage[]

  @@index([division])
  @@index([conference])
  @@index([transferHeavy])
  @@index([jucoFriendly])
}

model CollegeProgramVerificationSubmission {
  id String @id @default(cuid())

  collegeId         String
  submittedByUserId String
  reviewedByUserId  String?

  status VerificationSubmissionStatus @default(PENDING)

  submittedData Json
  adminNotes    String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  college         College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  submittedByUser User    @relation("ProgramVerificationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedByUser  User?   @relation("ProgramVerificationReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([collegeId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([createdAt])
}

model CollegeBaseballCoach {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programId String
  program   CollegeBaseballProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  name       String
  title      String?
  email      String?
  phone      String?
  bioUrl     String?
  contactUrl String?

  isHeadCoach Boolean @default(false)

  @@index([programId])
  @@index([isHeadCoach])
}

model CollegeBaseballRosterNeed {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programId String
  program   CollegeBaseballProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  gradYear Int
  position String

  needLevel CollegeRosterNeedLevel @default(UNKNOWN)
  notes     String?

  sourceUrl      String?
  lastVerifiedAt DateTime?

  @@unique([programId, gradYear, position])
  @@index([programId])
  @@index([gradYear])
  @@index([position])
  @@index([needLevel])
}

model CollegeBaseballMetricAverage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programId String
  program   CollegeBaseballProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  position    String
  metricKey   String
  metricLabel String?

  averageValue Decimal? @db.Decimal(8, 2)
  minValue     Decimal? @db.Decimal(8, 2)
  maxValue     Decimal? @db.Decimal(8, 2)
  unit         String?

  sampleSize     Int?
  sourceUrl      String?
  lastVerifiedAt DateTime?

  @@unique([programId, position, metricKey])
  @@index([programId])
  @@index([position])
  @@index([metricKey])
}

model BaseballMetricBenchmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scope     BenchmarkScope
  sourceKey String

  position    String
  metricKey   String
  metricLabel String?

  averageValue Decimal? @db.Decimal(8, 2)
  minValue     Decimal? @db.Decimal(8, 2)
  maxValue     Decimal? @db.Decimal(8, 2)
  unit         String?

  sampleSize Int?
  sourceUrl  String?
  sourceNote String?
  verifiedAt DateTime?

  @@unique([scope, sourceKey, position, metricKey])
  @@index([scope, sourceKey])
  @@index([position])
  @@index([metricKey])
}

enum BenchmarkScope {
  SCHOOL
  CONFERENCE
  DIVISION
  GLOBAL
}
